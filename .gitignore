node_modules/
site/dist/
site/.astro/
.DS_Store
*.log
/tmp/

# Written by scripts/build.py out of data/, on every build including CI.
# Committing them would mean two sources of truth, and the stale one always wins.
site/public/index.json
site/public/index-quiet.json
site/public/regions.json
site/public/providers.json
site/public/p/

# The sharded gazetteer — 8,191 files, written by build.py from data/gazetteer.json
site/public/g/
site/src/data/places-full.json
site/src/data/collections-full.json
site/public/s/
data/surnames.json
site/public/surnames.json
site/public/surnames.csv

# Everything under site/public that the build writes. `site/public` is Astro's
# static root, so generated artefacts land beside the one file that is real
# (styles.css) and get swept up by `git add -A`. Adding an ignore rule does not
# untrack what is already tracked — that mistake shipped a 64 MB surnames.json
# twice, once into data/ and once into here.
site/public/archives-wikidata.json
site/public/archives-osm.json
site/public/cemeteries-wikidata.json
site/public/churches-wikidata.json
site/public/libraries-wikidata.json
site/public/rs/
site/public/a/
site/public/cemeteries-osm.json
site/public/c/
site/public/t/
site/public/it/
site/public/ee/
site/public/world-archives.json
site/public/country-points.json
.harvest-published

# The raw waypoint harvest state. 73 MB at 5% of the run and heading for
# 1.5 GB — GitHub refuses at 100 MB. Only scripts/match-fs-volumes.py reads
# it, and the build reads that script's output instead, so CI never needs
# it. It is resume scaffolding, regenerable by re-running the harvest.
data/fs-waypoints.json
data/fs-volumes-world.json
data/surname-timeline.json

# Generated by scripts/build.py into src/data so the build can import it
# without publishing it. 106 MB — over GitHub's hard 100 MB limit — and
# regenerated by `npm run data`, so CI makes its own. It lived in public/
# and was ignored there; moving it must not start tracking it.
site/src/data/surnames.json
data/.exonym-scan.json
data/.italy-surnames-scan.json
.supervisor.log
.matcher.log
.ita3
.exo3
.mat3
.sup2_seen
.mat2_seen
.exo2_done
.ita2_done
.exo_done
.ita_done
.matched-stamp

# Scratch files written by the monitors that watch the harvest and CI.
# They are per-session bookkeeping — "have I already reported this line" —
# and several leaked into the repo before this pattern existed.
.ci[A-Za-z0-9]
.m[A-Za-z0-9]
.s[A-Za-z0-9]
.d[A-Za-z0-9]
.e[A-Za-z0-9]

# The Danish name zip, 1.3 MB, refetched by scripts/harvest-denmark-surnames.py
data/.denmark-names-2020.zip

# Per-name scan state for the harvesters that ask a form one question at a
# time — «have I already asked about this name». Regenerable, and the
# Croatian one was committed by the publish loop's `git add -A data/`
# before this rule existed.
data/.croatia-surnames-scan.json
data/*.partial
data/**/*.partial

# Held-back harvest output. The script regenerates it; the README beside
# it says why it is not in data/frequencies/ yet.
data/_pending/*.json
