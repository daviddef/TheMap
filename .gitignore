# Written by scripts/build.py out of data/, on every build including CI.
# Committing them would mean two sources of truth, and the stale one always wins.
site/public/index.json
site/public/index-quiet.json
# The rest of the index, in five-degree cells the map fetches for the viewport
# it is showing — index.json carries only the twelve biggest places per cell.
# 169 files, written by the same build as index.json, so committing them would
# be the same two-sources-of-truth problem one directory along.
site/public/pi/
site/public/regions.json
site/public/providers.json
site/public/p/

# The sharded gazetteer — 8,191 files, written by build.py from data/gazetteer.json
site/public/g/
# The era flags, one small SVG per flag, written by build.py from
# flag-eras.json and era-flags.json — both of which are themselves
# generated and ignored. 314 files, 120 KB, rebuilt by CI like every
# other derived directory here; committing them would be committing the
# same bytes twice.
site/public/fl/
site/src/data/places-full.json
site/src/data/collections-full.json
site/public/s/
data/surnames.json
site/public/surnames.json
site/public/surnames.csv
# AND THE GZIPPED ONES, which were tracked while their plain twins were not.
# build.py writes all four on every run, CI included, so none of them ever
# needed committing — but these two were, and they are 28 MB a pair. Twelve
# commits have touched them, which is roughly 330 MB of a 685 MB .git spent on
# versions of a download that is regenerated before every deploy. Untracked
# now, which stops the growth; the history already written can only be removed
# by a rewrite, and that is David's call, not a cleanup to slip into a commit.
site/public/surnames.json.gz
site/public/surnames.csv.gz

# Everything under site/public that the build writes. `site/public` is Astro's
# static root, so generated artefacts land beside the one file that is real
# (styles.css) and get swept up by `git add -A`. Adding an ignore rule does not
# untrack what is already tracked — that mistake shipped a 64 MB surnames.json
# twice, once into data/ and once into here.
site/public/archives-wikidata.json
site/public/archives-osm.json
site/public/cemeteries-wikidata.json
site/public/churches-wikidata.json
site/public/libraries-wikidata.json
site/public/rs/
site/public/a/
site/public/cemeteries-osm.json
site/public/c/
site/public/t/
site/public/it/
site/public/ee/
site/public/world-archives.json
site/public/country-points.json
.harvest-published

# The raw waypoint harvest state. 73 MB at 5% of the run and heading for
# 1.5 GB — GitHub refuses at 100 MB. Only scripts/match-fs-volumes.py reads
# it, and the build reads that script's output instead, so CI never needs
# it. It is resume scaffolding, regenerable by re-running the harvest.
data/fs-waypoints.json
data/fs-volumes-world.json
data/surname-timeline.json

# Generated by scripts/build.py into src/data so the build can import it
# without publishing it. 106 MB — over GitHub's hard 100 MB limit — and
# regenerated by `npm run data`, so CI makes its own. It lived in public/
# and was ignored there; moving it must not start tracking it.
site/src/data/surnames.json
data/.exonym-scan.json
data/.italy-surnames-scan.json
.supervisor.log
.matcher.log
.ita3
.exo3
.mat3
.sup2_seen
.mat2_seen
.exo2_done
.ita2_done
.exo_done
.ita_done
.matched-stamp

# Scratch files written by the monitors that watch the harvest and CI.
# They are per-session bookkeeping — "have I already reported this line" —
# and several leaked into the repo before this pattern existed.
.ci[A-Za-z0-9]
.m[A-Za-z0-9]
.s[A-Za-z0-9]
.d[A-Za-z0-9]
.e[A-Za-z0-9]

# The Danish name zip, 1.3 MB, refetched by scripts/harvest-denmark-surnames.py
data/.denmark-names-2020.zip

# Per-name scan state for the harvesters that ask a form one question at a
# time — «have I already asked about this name». Regenerable, and the
# Croatian one was committed by the publish loop's `git add -A data/`
# before this rule existed.
data/.croatia-surnames-scan.json
data/*.partial
data/**/*.partial

# Held-back harvest output (see data/_pending/README.md).
data/_pending/*.json

# The Belgian name zip, refetched by scripts/harvest-belgium-surnames.py
data/.belgium-names-2026.zip

# Belgian surnames at commune grain, sharded by scripts/build.py from
# data/belgium-by-municipality.json on every build, CI included.
site/public/bs/

# Playwright writes its run output here. Results of a test are not a record
# of anything the atlas knows.
site/test-results/

# Survey working files: the reading queue and the rendered page text that
# produced it. Regenerated by scripts/survey-providers.py and
# scripts/render-pages.mjs, and _rendered.json carries whole pages of other
# people's sites, which is not something this repository should hold.
data/_rendered.json
data/_survey-review.json
data/_survey-review-rendered.json
data/_unplaced-context.json

# Generated by scripts/build-eras.py on every data build, CI included — the
# feed the Flag History timeline pages fetch. Derived from index.json and
# regions.json, both of which are themselves generated.
site/public/eras.json

# THE HARVEST ARTEFACT, NOW A RELEASE ASSET RATHER THAN A COMMIT.
# 2,545,054 FamilySearch volumes over 15,411 places, made by
# scripts/match-fs-volumes.py from data/fs-waypoints.json — which is 740 MB and
# is not here, so nothing in a checkout or on a runner can rebuild this file.
# Sixteen committed versions cost 431 MB of a 686 MB .git, because gzip does not
# delta-compress and each version paid full price.
#   github.com/daviddef/TheMap/releases/tag/harvest-data
# The deploy downloads it; build.py FAILS without it. Re-upload after a harvest
# — or after ANY local re-run of match-fs-volumes.py, because its two committed
# siblings then describe a run this file does not:
#   gh release upload harvest-data data/fs-volumes-world.json.gz --clobber
# Forgetting it shipped «52,964 places · 2,780,922 record volumes» on 7 October,
# every new place drawn and its books missing, through a green deploy. The three
# files now carry a shared `run` stamp and check-data.py refuses the mismatch.
# --clobber deletes before it uploads, so the asset 404s for about two minutes;
# the deploy's fetch retries through that window rather than going red.
data/fs-volumes-world.json.gz
site/public/flag-eras.json
# Derived from flag-eras.json by scripts/derive-era-moves.py — the migro
# tags turned into movements the map can draw.
site/public/era-moves.json
site/public/flag-index.json
data/unplaced-placed.json

# The OHM boundary cache is 20MB and fully regenerable by
# scripts/fetch-ohm-boundaries.py. The derived, reviewable outputs
# (era-ground.json, era-gaps.json) are committed; the cache is not.
data/ohm/boundaries.json

# Worktrees the desktop app creates for isolated agent sessions.
.claude/worktrees/

__pycache__/
