   "events": "all",
   "role": "person",
   "note": "Do not confuse with 'patrinus', the godfather. In a baptism, 'ex patre Joanne' gives the father's first name, and the surname usually stands once for the family.",
   "src": [
    "fswiki"
   ]
  },
