{
  "name": "record-atlas",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "python3 ../scripts/build-surnames.py && python3 ../scripts/build.py",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "check": "python3 ../scripts/check-data.py && npm run test",
    "dev": "npm run data && astro dev --port 4330",
    "dev:fast": "NODE_OPTIONS=--max-old-space-size=10240 astro dev --port 4331",
    "build": "npm run data && npm run check && NODE_OPTIONS=--max-old-space-size=10240 astro build && npm run check:built",
    "preview": "astro preview --port 4330",
    "check:built": "python3 ../scripts/check-built.py"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#81746764e2f89d84bed9c44853bf7f9b2ec6a8f3",
    "astro": "^5.18.2"
  }
}
