---
/* THE EIGHT ARCHIVES THIS ATLAS WAS GENERALISED OUT OF.
 *
 * Record Atlas answers "who holds the paper for this place" for everybody.
 * It exists because that question was first answered for one family, eight
 * times over, and the shelf turned out to be the part that generalises.
 * Showing them is not decoration: it is the only demonstration on the site
 * of what the method looks like when it is finished — every claim carrying
 * how sure it is and what it rests on.
 *
 * Deliberately at the FOOT of the page and deliberately plain. Somebody who
 * came to find a parish register should find it first; this is for the
 * reader who has already got what they came for and is wondering whether
 * the same thing could be done for their own family.
 */
import showcase from "../data/archives-showcase.json";
const { u } = Astro.props;
---
<section class="showcase">
  <h2>Eight families, the same method</h2>
  <p class="lead">{showcase.lead}</p>

  <div class="cards">
    {showcase.archives.map((a) => (
      <a class="card" href={a.url} style={`--edge:${a.accent}`}>
        <span class="nm">{a.name}</span>
        <span class="where">{a.where}</span>
        <span class="what">{a.what}</span>
        <span class="names">{a.names.join(" · ")}</span>
      </a>
    ))}
  </div>

  <p class="offer">Each of these began as somebody's shoebox of certificates and
  half-remembered stories. If you would like your own family put together this
  way — the records found, the claims tested, and the whole thing published so
  it outlives the shoebox — <a href={u("/about/")}>there is more about how this
  work is done</a>.</p>
</section>

<style>
  .showcase { margin-top: 64px; padding-top: 30px; border-top: 1px solid var(--rule); }
  .showcase h2 { font-family: var(--serif); font-size: 26px; font-weight: 500;
                 margin: 0 0 8px; }
  .lead { font-family: var(--sans); font-size: 14px; line-height: 1.6;
          color: var(--ink-2); max-width: 74ch; margin: 0 0 20px; }
  .cards { display: grid; gap: 12px;
           grid-template-columns: repeat(auto-fill, minmax(268px, 1fr)); }
  .card { display: block; text-decoration: none; background: var(--panel);
          border: 1px solid var(--rule); border-left: 3px solid var(--edge);
          border-radius: 3px; padding: 14px 16px 15px; }
  .card:hover { border-color: var(--rule-strong); border-left-color: var(--edge); }
  .nm { display: block; font-family: var(--serif); font-size: 17px;
        color: var(--edge); margin-bottom: 3px; }
  .where { display: block; font-family: var(--sans); font-size: 10.5px;
           font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
           color: var(--ink-3); margin-bottom: 8px; }
  .what { display: block; font-family: var(--sans); font-size: 13px;
          line-height: 1.55; color: var(--ink-2); margin-bottom: 8px; }
  .names { display: block; font-family: var(--mono); font-size: 11px;
           line-height: 1.6; color: var(--ink-3); }
  .offer { font-family: var(--sans); font-size: 13.5px; line-height: 1.65;
           color: var(--ink-2); max-width: 74ch; margin: 22px 0 0; }
  @media (max-width: 640px) { .cards { grid-template-columns: 1fr; } }
</style>
