---
/* THE COUNTRY DIRECTORY, ONCE, AS CARDS.

   David: «i think places should be country mini cards rather than just text,
   showing the metrics? same as in surname» — and «keep sorting controls».

   The same countries were being described three ways: a sortable table on
   /countries/, a text grid on /places/, and nothing at all on /surnames/. This
   is the one of them, used by all three, so the numbers cannot disagree.

   SORTING SURVIVED THE MOVE TO CARDS, which was the condition. A table sorts
   by reordering rows; this reorders the cards themselves, which is the same
   operation on a different box. It is kept because the page's whole argument
   is about UNEVENNESS — «where this map reaches, and how unevenly» — and you
   cannot see unevenness in an alphabetical list. Sorting by places answers
   «where is this thickest»; sorting by names answers «whose register have we
   never touched», which is the question David asked for.
*/
import { u } from "../lib/url.js";
/* `showFind` false where the PAGE already has a search box. /places/ had two —
   «Find a place» at the top and «Find a country» inside the directory — which
   is one box too many on one page, and the reason a country typed into the
   first one came back as a stray line of text instead of filtering the cards
   it was standing above. That page drives this grid through window.raCountryFilter
   instead. */
const { list, totals, showFind = true } = Astro.props;
---

{showFind && (
  <form class="ccfind k-search" role="search" onsubmit="return false">
    <label class="vh" for="ccq">Find a country</label>
    <input id="ccq" type="search" autocomplete="off"
           placeholder="Find a country: Uruguay, Eswatini, Cabo Verde" />
    <span class="ccn" id="ccq-n" role="status" aria-live="polite"></span>
  </form>
)}

<div class="ccsort" role="group" aria-label="Sort the countries">
  <span class="cclab">Sort by</span>
  <button type="button" class="sortby on" data-k="name" data-kind="text"
          aria-sort="ascending">A to Z</button>
  <button type="button" class="sortby" data-k="places">Places</button>
  <button type="button" class="sortby" data-k="arch">Archives</button>
  <button type="button" class="sortby" data-k="cols">Collections</button>
  <button type="button" class="sortby" data-k="walked">Walked</button>
  <button type="button" class="sortby" data-k="reg">Names in a register</button>
</div>

<ul class="ccgrid" id="ccgrid">
  {list.map((c) => (
    <li class="cccard" data-name={c.name} data-places={c.places}
        data-arch={c.arch} data-cols={c.cols} data-reg={c.reg} data-walked={c.walked}
        data-state={c.names}>
      <a class="cchead" href={u(`/country/${c.cc.toLowerCase()}/`)}>
        {c.flag ? (
          <svg class="ccflag" viewBox="0 0 300 200" role="img"
               aria-label={`Flag of ${c.name}`} set:html={c.flag.flag} />
        ) : <span class="ccflag ccflag-ph" aria-hidden="true">{c.cc}</span>}
        <span class="ccname">{c.name}</span>
      </a>
      <ul class="ccpills">
        <li class="k-pill"><b>{c.places ? c.places.toLocaleString() : "0"}</b> places</li>
        <li class="k-pill is-plain"><b>{c.arch ? c.arch.toLocaleString() : "0"}</b> archives</li>
        <li class="k-pill is-plain"><b>{c.cols ? c.cols.toLocaleString() : "0"}</b> collections</li>
      </ul>
      {/* WHICH OF THE THREE STATES THIS IS, because the number alone would be read as a fact about the country. Croatia's 141 against
          Denmark's 290,156 is a fact about our harvest. A country with nothing is the point of the page, so it is marked, not left empty. */}
      <p class="ccnames">
        {c.names === "register" && <span class="k-pill is-plain"><b>{c.reg.toLocaleString()}</b> {c.reg === 1 ? "name" : "names"} in its register</span>}
        {c.names === "archive" && <span class="k-pill is-plain">{c.arc.toLocaleString()} {c.arc === 1 ? "name" : "names"} from a family archive</span>}
        {c.names === "none" && <span class="k-pill is-plain">no names yet</span>}
      </p>
      <p class="cccov">
        {c.cols ? <span title="Share of this country's collections catalogued under a town, county or province, not the country as a whole">{c.reach}% reach a place</span> : <span class="ccnil">no collections</span>}
        {" · "}{c.walked ? <span>{c.walked.toLocaleString()} walked</span> : <span class="ccnil">none walked</span>}
        {c.nat ? <>{" · "}<span>national archive named</span></> : null}
      </p>
      <p class="ccgo"><a class="k-pill is-plain" href={u(`/country/${c.cc.toLowerCase()}/`)}>Places</a>
        <a class="k-pill is-plain" href={u(`/providers/?q=${encodeURIComponent(c.name)}`)}>{c.arch ? `${c.arch.toLocaleString()} ${c.arch === 1 ? "source" : "sources"}` : "Sources"}</a>
        {c.flag && <a class="k-pill is-plain" href={u("/" + c.flag.url)} title={`${c.name} in the flags atlas: who held this ground, and when`}>Flags</a>}</p>
    </li>
  ))}
</ul>

<p class="cap ccfoot">{totals.withRegister} countries have a national register
  harvested, {totals.archiveOnly} are named only by a family archive, and
  <b>{totals.noNames} have no names at all</b>, which is a gap in this map,
  not a gap in the record.</p>

<script is:inline>
  /* Sort and filter the cards in place. No fetch: everything is already in
     the DOM as data- attributes, and 152 nodes reorder faster than a frame. */
  (function () {
    var grid = document.getElementById("ccgrid");
    if (!grid) return;
    var cards = [].slice.call(grid.children);
    var q = document.getElementById("ccq");
    var out = document.getElementById("ccq-n");
    function filterBoxValue() { return q ? q.value : ""; }

    function fold(v) {
      return (v || "").normalize("NFKD").replace(/[̀-ͯ]/g, "").toLowerCase();
    }
    var hay = cards.map(function (c) { return fold(c.getAttribute("data-name")); });

    function filter() {
      var v = fold((filterBoxValue() || "").trim());
      var n = 0;
      cards.forEach(function (c, i) {
        var hit = !v || hay[i].indexOf(v) >= 0;
        c.hidden = !hit;
        if (hit) n++;
      });
      out.textContent = v ? n + " of " + cards.length : "";
    }
    if (q) {
      q.addEventListener("input", filter);
      /* Escape clears it, the same as every other search box on this site. */
      q.addEventListener("keydown", function (e) {
        if (e.key === "Escape") { q.value = ""; filter(); }
      });
    }
    /* THE PAGE'S OWN BOX CAN DRIVE THIS GRID. Returns how many cards are
       showing, so the caller can say «1 country» without counting twice. */
    window.raCountryFilter = function (text) {
      var v = fold((text || "").trim());
      var n = 0;
      cards.forEach(function (c, i) {
        var hit = !v || hay[i].indexOf(v) >= 0;
        c.hidden = !hit;
        if (hit) n++;
      });
      if (out) out.textContent = v ? n + " of " + cards.length : "";
      /* A filtered directory inside a shut <details> is a filter nobody can
         see working. */
      if (v && n) {
        var d = grid.closest && grid.closest("details");
        if (d) d.open = true;
      }
      return n;
    };

    grid.parentNode.querySelectorAll("button.sortby").forEach(function (b) {
      b.addEventListener("click", function () {
        var k = b.getAttribute("data-k");
        var text = b.getAttribute("data-kind") === "text";
        /* A NUMBER SORTS BIGGEST FIRST AND A NAME SORTS A TO Z, because that
           is what each is for: nobody wants the country with the fewest
           archives at the top, and nobody wants Zimbabwe. */
        var was = b.getAttribute("aria-sort");
        var desc = text ? was === "ascending" : was !== "descending";
        grid.parentNode.querySelectorAll("button.sortby").forEach(function (o) {
          o.removeAttribute("aria-sort"); o.classList.remove("on");
        });
        b.setAttribute("aria-sort", desc ? "descending" : "ascending");
        b.classList.add("on");
        var sorted = cards.slice().sort(function (x, y) {
          if (text) {
            var a = x.getAttribute("data-name"), c = y.getAttribute("data-name");
            return desc ? c.localeCompare(a) : a.localeCompare(c);
          }
          var n1 = +x.getAttribute("data-" + k) || 0;
          var n2 = +y.getAttribute("data-" + k) || 0;
          /* Ties keep alphabetical order rather than whatever the sort
             happened to do — 116 countries tie at zero, and a list that
             reshuffles them on every click reads as broken. */
          if (n1 === n2)
            return x.getAttribute("data-name").localeCompare(y.getAttribute("data-name"));
          return desc ? n2 - n1 : n1 - n2;
        });
        var frag = document.createDocumentFragment();
        sorted.forEach(function (c) { frag.appendChild(c); });
        grid.appendChild(frag);
      });
    });
  })();
</script>

<style>
  .ccfind { margin: 14px 0 0; }
  .ccfind input { flex: 1 1 auto; }
  .ccn { font-family: var(--mono); font-size: 12px; color: var(--ink-3); padding-right: 14px; }
  .ccsort { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 18px 0 0; }
  .cclab { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-right: 4px; }
  button.sortby { cursor: pointer; font: 600 13.5px/1 var(--sans); padding: 8px 14px; border-radius: 999px;
    border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink-2); transition: background .15s, border-color .15s; }
  button.sortby::after { content: " \2195"; opacity: .4; }
  button.sortby:hover { border-color: var(--hue, var(--accent)); color: var(--ink); }
  button.sortby.on { background: var(--hue-solid, var(--accent)); border-color: transparent; color: var(--on-hue); }

  .ccgrid { list-style: none; padding: 0; margin: 16px 0 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 16px; }
  .ccgrid [hidden] { display: none; }
  /* ONE COLOUR ALONG THE TOP, the page's. The flag itself carries each country's colours; edging 150 cards in 150 colours read as a rainbow
     (David: «way too rainbow, keep it calm»). */
  .cccard { --cc: var(--hue, var(--accent)); display: flex; flex-direction: column; gap: 10px; border: 1px solid var(--rule); border-top: 6px solid var(--cc);
    border-radius: 20px; padding: 16px 18px 16px; background: var(--panel); transition: transform .16s, box-shadow .16s; }
  .cccard:hover { transform: translateY(-3px); box-shadow: 0 18px 32px -20px color-mix(in srgb, var(--cc) 75%, #000); }
  .cchead { display: flex; align-items: center; gap: 14px; text-decoration: none; color: var(--ink); }
  .ccflag { flex: none; width: 56px; height: 37px; border-radius: 7px; display: block; box-shadow: 0 0 0 1px var(--rule), 0 6px 14px -8px rgba(0,0,0,.4); }
  .ccflag-ph { display: grid; place-items: center; font: 700 14px/1 var(--mono); letter-spacing: .04em; color: var(--ink-3); background: var(--ground); }
  .ccname { font-family: var(--serif); font-size: 24px; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
  .cchead:hover .ccname { color: var(--hue-ink, var(--accent)); }
  .ccpills { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .ccpills .k-pill { font-weight: 500; } .ccpills b { font-weight: 800; }
  .ccnames { margin: 0; } .ccnames:empty { display: none; }
  .cccov { margin: 0; font-size: 13px; line-height: 1.5; color: var(--ink-2); }
  .cccov .ccnil { color: var(--ink-3); }
  .ccgo { margin: auto 0 0; padding-top: 4px; display: flex; flex-wrap: wrap; gap: 6px; }
  .ccfoot { margin: 18px 0 0; }
  @media (prefers-reduced-motion: reduce) { .cccard:hover { transform: none; } }
</style>
