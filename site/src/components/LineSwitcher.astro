---
/* WHO YOU ARE LOOKING FOR, WHICH IS NOT THE SAME QUESTION AS WHERE.
 *
 * David: «if I'm researching multiple families… searching for Blažević in
 * Senj may be different progress than if I am doing Kosina in Senj. How could
 * we allow research for different families in our tracking?»
 *
 * This is the switch. Everything that marks, counts or colours progress reads
 * the active line through ProgressKit, so this one control changes the map
 * rings, the volume marks, the rollups and My research together.
 *
 * IT IS A BAR AND NOT A SETTING BURIED IN A MENU, because a reader who forgets
 * which line is open will record an afternoon of Kosina work against Blažević
 * and have no way of knowing. The cost of that mistake is a month; the cost of
 * a line of type at the top of the page is a line of type.
 *
 * `quiet` — SHOW ONLY ONCE THERE IS SOMETHING TO CHOOSE. The home page is
 * deliberately «the map and nothing else» for a reader arriving with a
 * surname, and a family selector offering one family is furniture. With
 * `quiet` the bar stays hidden until a second line exists, which is exactly
 * the moment it starts mattering. Place pages and My research pass nothing
 * and always show it, because that is where marks are actually made.
 *
 * IT RENDERS NOTHING UNTIL THE SCRIPT RUNS. Lines live in localStorage, which
 * the server has never seen and must never be guessed at — a server-rendered
 * default would flash the wrong family's name at a reader on every page load.
 *
 * `compact` — IN THE HEADER, NOT UNDER IT. David: «can you rather add the
 * researching dropdown to the header? not another rod.» He was right twice
 * over: a full-width bar of its own was a second horizontal rule doing what
 * the navigation already does, and it cost a row of a screen on the one page
 * that is meant to be «the map and nothing else». Compact renders the label
 * and the select inline in the top navigation and drops the running mark
 * count, which is a statistic rather than a control and lives on
 * /my-research/ where it can be read properly.
 */
const { quiet = false, compact = false, linkOnly = false } = Astro.props;
const uid = compact ? "ra-lines-c" : "ra-lines";
import { u } from "../lib/url.js";
---
{linkOnly ? <div class="ra-lines ra-lines-c ra-lines-lo"><a class="ra-lines-l" href={u("/my-research/")}>Researching</a></div> :
<div class:list={["ra-lines", compact && "ra-lines-c"]} id={uid}
     data-quiet={quiet ? "1" : null} hidden>
  {compact ? <a class="ra-lines-l" href={u("/my-research/")} title="Your research: every family you are tracking">Researching</a> : <label class="ra-lines-l" for={uid + "-sel"}>Researching</label>}
  <select id={uid + "-sel"} aria-label="Which family this progress belongs to"></select>
  {!compact && <button type="button" class="ra-line-ren">rename</button>}
  {!compact && <span class="ra-lines-n" role="status" aria-live="polite"></span>}
</div>}

{!linkOnly && <Fragment>
<script is:inline define:vars={{ uid }}>window.__raLineUid = uid;</script>
<script is:inline src={u("/js/line-switcher.js")}></script>
</Fragment>}

<style>
  .ra-lines { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline;
    margin: 0 0 14px; padding: 8px 11px; border: 1px solid var(--rule);
    border-left: 3px solid var(--accent); border-radius: 3px;
    background: var(--panel); font-family: var(--sans); font-size: 13px; }
  .ra-lines-l { font-family: var(--mono); font-size: 10.5px;
    text-transform: uppercase; letter-spacing: .07em; color: var(--ink-3); }
  .ra-lines select { font: inherit; font-weight: 600; padding: 3px 6px;
    border: 1px solid var(--rule-strong); border-radius: 3px;
    background: var(--bg); color: var(--ink); max-width: 20rem; }
  .ra-lines button { background: none; border: 0; padding: 0; cursor: pointer;
    font: inherit; font-size: 11.5px; color: var(--ink-3);
    text-decoration: underline; text-underline-offset: 2px; }
  .ra-lines button:hover { color: var(--accent); }
  .ra-lines-n { margin-left: auto; font-family: var(--mono); font-size: 10.5px;
    color: var(--ink-3); }

  /* ---- IN THE HEADER --------------------------------------------------
     Sized to sit on the navigation's baseline rather than to be a panel: no
     border, no background, no left rule, and the type scale the menu links
     already use. It is the same control, wearing the header's clothes. */
  .ra-lines-c { margin: 0; padding: 0; border: 0; background: none;
    gap: 6px; align-items: center; font-size: 12.5px; }
  .ra-lines-c .ra-lines-l { font-size: 9.5px; letter-spacing: .08em; }
  .ra-lines-c select { font-size: 12.5px; font-weight: 600; padding: 2px 4px;
    max-width: 11rem; }
  .ra-lines-c a.ra-lines-l { text-decoration: none; }
  a.ra-lines-warn::after { content: " \25CF"; color: var(--brick, #b5472f); }
  .ra-lines-c a.ra-lines-l:hover { color: var(--accent); text-decoration: underline; }
  /* THE NAVIGATION IS THE FIRST THING TO RUN OUT OF ROOM. Below this the
     menu already collapses to a burger, and a family selector wedged beside
     it would push the brand off the line. /my-research/ keeps the full bar,
     so switching and renaming stay reachable on a phone — which is why that
     page is the one place the wide bar was left in. */
  @media (max-width: 860px) { .ra-lines-c { display: none; } }
</style>

<style is:global>
  .ra-cb { position: relative; display: inline-block; min-width: 0; }
  .ra-cb-btn { display: inline-flex !important; align-items: center; gap: 8px; max-width: 20rem; padding: 4px 9px !important; border: 1px solid var(--rule-strong) !important; border-radius: 6px; background: var(--bg) !important; color: var(--ink) !important;
    font: 600 13px/1.3 var(--sans) !important; text-decoration: none !important; cursor: pointer; }
  .ra-cb-btn:hover, .ra-cb.is-open .ra-cb-btn { border-color: var(--accent) !important; }
  .ra-cb-lab { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .ra-cb-chev { color: var(--ink-3); font-size: 11px; }
  .ra-lines-c .ra-cb-btn { max-width: 11rem; font-size: 12.5px !important; padding: 2px 7px !important; }
  .ra-cb-pop { position: absolute; z-index: 3000; top: calc(100% + 6px); left: 0; width: min(340px, 92vw); background: var(--panel); border: 1px solid var(--rule-strong); border-radius: 12px; box-shadow: 0 14px 40px rgba(0,0,0,.28); padding: 8px; font-family: var(--sans); }
  .ra-cb-pop[hidden] { display: none; }
  .ra-cb-q { width: 100%; box-sizing: border-box; padding: 9px 11px; border: 1px solid var(--rule-strong); border-radius: 8px; background: var(--bg); color: var(--ink); font: 14px var(--sans); }
  .ra-cb-q:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .ra-cb-list { list-style: none; margin: 6px 0 0; padding: 0; max-height: min(52vh, 320px); overflow-y: auto; }
  .ra-cb-opt { display: grid; grid-template-columns: 16px minmax(0, 1fr) auto; gap: 6px; align-items: baseline; padding: 8px 8px; border-radius: 8px; cursor: pointer; font-size: 14px; color: var(--ink); }
  .ra-cb-grp { padding: 10px 10px 4px; font: 600 10.5px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); } .ra-cb-grp:first-child { padding-top: 4px; }
  .ra-cb-opt.is-at, .ra-cb-opt:hover { background: var(--accent-wash); } .ra-cb-opt.is-on b { color: var(--accent); }
  .ra-cb-tick { color: var(--accent); font-weight: 700; } .ra-cb-main span { color: var(--ink-2); }
  .ra-cb-n { font: 10.5px var(--mono); color: var(--ink-3); white-space: nowrap; }
  .ra-cb-none { padding: 10px 8px; font-size: 13.5px; color: var(--ink-2); }
  .ra-cb-new, .ra-cb-addbtn { display: block; margin-top: 6px; padding: 8px 10px !important; border: 1px dashed var(--accent) !important; border-radius: 8px; background: none !important; color: var(--accent) !important; font: 600 13.5px var(--sans) !important; text-decoration: none !important; cursor: pointer; width: 100%; text-align: left; }
  .ra-cb-add { margin-top: 6px; border-top: 1px solid var(--rule); padding-top: 6px; } .ra-cb-addbtn[hidden], .ra-cb-form[hidden] { display: none; }
  .ra-cb-form { display: grid; gap: 6px; } .ra-cb-form input { padding: 8px 10px; border: 1px solid var(--rule-strong); border-radius: 8px; background: var(--bg); color: var(--ink); font: 14px var(--sans); }
  .ra-cb-go { padding: 9px 12px !important; border: 0 !important; border-radius: 8px; background: var(--accent) !important; color: #fff !important; font: 600 14px var(--sans) !important; text-decoration: none !important; cursor: pointer; }
</style>
