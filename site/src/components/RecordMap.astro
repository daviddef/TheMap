  }
  /* Held as a promise, not just a variable. A visitor types faster than a
     fetch returns, and «libya» arriving before the country list did would
     find nothing and say so — which is the bug this layer exists to fix,
     reintroduced one line lower down. */
  var cptsReady = fetch(CPTS).then(function (r) { return r.json(); }).then(function (d) {
    cpts = d.countries || [];
    cpts.forEach(function (c) {
      var rich = c.p || c.v || c.c;
      var m = L.circleMarker([c.y, c.x], {
        radius: rich ? 7 : 5.5,
        color: "var(--accent)", weight: rich ? 1.8 : 1.2,
        opacity: rich ? .9 : .55,
        fillColor: "var(--accent)", fillOpacity: rich ? .18 : .07,
