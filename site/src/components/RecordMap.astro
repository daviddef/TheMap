  }).catch(function () { return []; });

  function openCountry(c) {
    searchHit = true;
    noteSearch();
    empty.hidden = true; panel.hidden = false;
    var h = ['<div class="at-h"><h3>' + esc(c.n) + "</h3>" +
             '<span class="at-n">the whole country</span>' +
             goIcons(BASE + "country/" + String(c.cc).toLowerCase() + "/",
                     T("Everything this map holds for") + " " + c.n,
                     c.cc, c.n) + "</div>"];
    h.push('<p class="at-sub">' +
           (c.p ? c.p.toLocaleString() + " place" + (c.p === 1 ? "" : "s") + " drawn, " +
                  c.v.toLocaleString() + " volume" + (c.v === 1 ? "" : "s") + " walked"
                : "<b>No place in this country has been walked.</b>") +
           (c.c ? " · " + c.c + " collection" + (c.c === 1 ? "" : "s") + " cover it" : "") +
           "</p>");

    if (c.fs) {
      h.push('<div class="at-sec"><div class="lab">Where to start</div>');
      h.push('<ul class="at-films"><li><a href="https://www.familysearch.org/en/wiki/' +
             esc(c.fs) + '_Genealogy" target="_blank" rel="noopener">FamilySearch ' +
             "Research Wiki — " + esc(c.n) + " &#8599;</a> " +
