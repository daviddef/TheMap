  }
  catSummary();
  /* `change`, not `click`: these are checkboxes now, so the keyboard works
     for free and a click on the label reaches the input by itself. */
  document.getElementById("ra-cats").addEventListener("change", function (ev) {
    var b = ev.target.closest(".ra-opt[data-cat]"); if (!b) return;
    var c = b.getAttribute("data-cat");
    off[c] = !ev.target.checked;
    b.classList.toggle("on", !off[c]);
    catSummary();
    setQ("off", Object.keys(off).filter(function (k) { return off[k]; }).join(","));
    apply();
  });

  /* ---- what kind of record ------------------------------------------------ */
  /* The bit for each kind comes from index.json rather than being written out
     here. Two copies of a derived constant is exactly how the shard keys came
     to disagree between build and client, and that cost 10,962 surnames their
     own spelling — so the client reads the mapping it is given. */
  var KBIT = idx.kinds || {};
  var KLAB = idx.kindLabels || {};
  var KORDER = Object.keys(KBIT);
  var kindOn = {};
  (Q.get("kind") || "").split(",").filter(Boolean).forEach(function (k) {
    if (KBIT[k]) kindOn[k] = true;
  });
  function kindMask() {
    var m = 0;
    for (var k in kindOn) { if (kindOn[k]) m |= KBIT[k]; }
    return m;
  }
  var kbox = document.getElementById("ra-kinds");
  function drawKinds() {
  if (KORDER.length) {
    kbox.innerHTML = KORDER.map(function (k) {
      var n = COUNTS.kind[k] || 0;
      return optionHTML("kind", k, KLAB[k] || k, n, null,
        (KLAB[k] || k) + " — " + nf(n) + (n === 1 ? " place" : " places") +
        (n ? "" : " on this map, so choosing it would empty the shelf"),
        !!kindOn[k], n === 0);
    }).join("") +
      '<span class="at-cat at-hollow-key" title="A collection is sorted by what ' +
      'its title says it is. About one in six says nothing either way, so it ' +
      'appears only when no kind is chosen — narrowing to a kind can therefore ' +
      'hide a register that simply is not described.">' +
      "<i></i>Read from the title";
  }
  }
  drawKinds();
  function kindSummary() {
    var n = KORDER.filter(function (k) { return kindOn[k]; });
    var kindFull = !n.length ? "What kind of record — every kind"
      : "What kind of record — " +
        n.map(function (k) { return KLAB[k] || k; }).join(", ");
    setSummary("ra-kindsum", "Kind", !n.length ? "All" : String(n.length), kindFull);
    sumBits.kinds = !n.length ? "All" : String(n.length);
    sumFull.kinds = kindFull;
    oneSummary();
  }
  kindSummary();
  /* The kind group no longer has a disclosure of its own — it is a heading
     inside the one Filters panel — so a preset kind opens THAT instead. */
  if (Object.keys(kindOn).length) {
    var _lw = document.getElementById("ra-layersw");
    if (_lw) _lw.open = true;
  }
  kbox.addEventListener("change", function (ev) {
    var b = ev.target.closest(".ra-opt[data-kind]"); if (!b) return;
    var k = b.getAttribute("data-kind");
    kindOn[k] = ev.target.checked;
    if (!kindOn[k]) delete kindOn[k];
    b.classList.toggle("on", !!kindOn[k]);
    kindSummary();
    setQ("kind", KORDER.filter(function (x) { return kindOn[x]; }).join(","));
    apply();
  });

  /* ---- the year ---------------------------------------------------------- */
  var year = null, year2 = null;
  var yon = document.getElementById("ra-yon"), yin = document.getElementById("ra-year"),
      yout = document.getElementById("ra-yout");
  var yin2 = document.getElementById("ra-year2");
  /* «years=1780,1920» is the new state. A bare «year=1863» from an older link
     still works and becomes a range of one, because a link somebody sent
     somebody else should not stop opening. */
  var qr = (Q.get("years") || "").split(",").map(function (x) { return parseInt(x, 10); });
  var qy = parseInt(Q.get("year"), 10);
  if (qr.length === 2 && qr[0] >= 1500 && qr[1] <= 2026 && qr[0] <= qr[1]) {
    year = qr[0]; year2 = qr[1]; yon.checked = true;
    yin.value = year; yin2.value = year2;
  } else if (qy >= 1500 && qy <= 2026) {
    year = year2 = qy; yon.checked = true; yin.value = qy; yin2.value = qy;
  }
  function paintTrack() {
    var lo = Math.min(+yin.value, +yin2.value), hi = Math.max(+yin.value, +yin2.value);
    var a = (lo - 1500) / (2026 - 1500) * 100, b = (hi - 1500) / (2026 - 1500) * 100;
    var t = document.getElementById("ra-track");
    t.style.left = a + "%";
    t.style.width = Math.max(b - a, 0.5) + "%";
    t.style.opacity = year ? "1" : ".25";
  }
  function yearUI() {
    yin.disabled = yin2.disabled = !year;
    /* COLLAPSED UNTIL IT IS DOING SOMETHING. Off, the scrubber was still a
       full-width strip across the foot of the map holding an inert slider
       and the words «any year» — a lot of map given to a control that was
       switched off. David asked for just the pill. It keeps the word «Year»
       with the checkbox, because a lone unlabelled tickbox sitting on a map
       is a puzzle, and one word is cheaper than the puzzle. */
    var strip = document.getElementById("ra-time");
    if (strip) strip.classList.toggle("on", !!year);
    yout.textContent = year
      ? (year === year2 ? String(year) : year + "\u2013" + year2)
      : "any year";
    paintTrack();
    /* The hint was a whole line of static prose under the slider. It is the
       control's own tooltip now, which is where a sentence that only matters
       once belongs. */
    document.getElementById("ra-ylab").title = year
      ? "Showing only what can answer for " + (year === year2 ? year : year + "–" + year2) +
        ". Every panel now says whose archive those years belonged to."
      /* THIS IS THE STRING THAT WINS. There is a title on the label in the
         markup too, and yearUI() overwrites it on first run — so editing the
         static one changes nothing a reader will ever see. Both now say the
         same thing, and this is the one to change. */
      : "Turn this on and the map keeps only the places that can answer for a range of years, the volume lists narrow to it, and every panel says whose archive those years belonged to.";
    setQ("years", year ? year + "," + year2 : "");
    setQ("year", "");
    paintRegions();
    apply();
    var at = Q.get("at");
    if (at && cache[at]) {
      /* RE-RENDERED AND LEFT DEAD. Moving the year rebuilds the panel's
         innerHTML, which throws away the era band's wiring, the flag icon,
         the checklist and the ring — everything open() does after render().
         The panel looked right and nothing in it worked until the reader
         picked the place again. */
      panel.innerHTML = render(cache[at]);
      bandsInit(panel);
      paintIcoFlags(panel);
      buildCheck(cache[at], drawHood(cache[at]));
    }
  }
  yon.addEventListener("change", function () {
    readRange();
    yearUI();
  });

  /* ---- the years, running ------------------------------------------------
     Stepped on a timer rather than an animation frame: each step redraws
     every region polygon and re-filters 21,302 markers, which is far too
     much for 60fps and does not want to be smooth anyway. A decade every
     900ms is about reading speed — long enough to see a border move,
     short enough that five centuries take under a minute.

     It stops at the end rather than looping, and any touch of the sliders
     or the checkbox stops it, because a control that keeps moving under
     somebody trying to use it is worse than no control. */
  var playT = null, playBtn = document.getElementById("ra-play");
  var PLAY_SPAN = 50, PLAY_STEP = 10, PLAY_MS = 900;
  function stopPlay() {
    if (!playT) return;
    clearInterval(playT); playT = null;
    playBtn.innerHTML = "&#9654;";
    playBtn.setAttribute("aria-pressed", "false");
    playBtn.title = "Play the years — watch the jurisdictions change and the records follow";
  }
  function startPlay() {
    if (playT) return stopPlay();
    if (!yon.checked) { yon.checked = true; readRange(); }
    year = 1500; year2 = year + PLAY_SPAN;
    yin.value = year; yin2.value = year2;
    playBtn.innerHTML = "&#9632;";
    playBtn.setAttribute("aria-pressed", "true");
    playBtn.title = "Stop";
    yearUI();
    playT = setInterval(function () {
      if (year2 >= 2026) { stopPlay(); return; }
      year = Math.min(year + PLAY_STEP, 2026 - PLAY_SPAN);
      year2 = Math.min(year + PLAY_SPAN, 2026);
      yin.value = year; yin2.value = year2;
      yearUI();
    }, PLAY_MS);
  }
  /* Re-bucketing on every zoom, because a grid sized for zoom 2 is
     nonsense at zoom 5. Not on pan: the cells are absolute, so panning
     shows the same cells from a different angle. */
  map.on("zoomend", function () { drawClusters(lastVisible); });

  playBtn.addEventListener("click", startPlay);

  /* The examples on the opening panel actually run a search, rather than
     being decoration a reader has to retype. */
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest(".ra-try");
    if (!a) return;
    e.preventDefault();
    qbox.value = a.getAttribute("data-q") || "";
    qbox.dispatchEvent(new Event("input", { bubbles: true }));
    qbox.focus();
  });

  /* ---- keys, for people who are here for an hour -------------------------
     A researcher works down a list of parishes, and every one of them
     meant reaching for the mouse to clear the box. Four keys, all of them
     the ones already in muscle memory from everywhere else, and none of
     them stealing a keystroke from somebody typing into a field. */
  document.addEventListener("keydown", function (e) {
    var t = e.target || {};
    var typing = t.tagName === "INPUT" || t.tagName === "TEXTAREA"
              || t.isContentEditable;
    if (e.key === "Escape") {
      if (typing && t === qbox && qbox.value) { qbox.value = ""; apply(); return; }
      stopPlay();
      /* On a phone the result is a sheet over the map, and Escape is the
         other way out of it. On a desktop the panel is a column that is
         not covering anything, so closing it would just throw the answer
         away — hence the width test. */
      if (!panel.hidden && window.innerWidth <= 700) closeSheet();
      return;
    }
    if (typing || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === "/") { e.preventDefault(); qbox.focus(); qbox.select(); }
    else if (e.key === "y") { e.preventDefault(); yon.click(); }
    else if (e.key === "p") { e.preventDefault(); startPlay(); }
  });
  yon.addEventListener("change", stopPlay);
  yin.addEventListener("input", stopPlay);
  yin2.addEventListener("input", stopPlay);
  /* Either handle may be dragged past the other; the range is whichever way
     round they end up. Forbidding it would mean a handle that sticks, which
     is the more annoying of the two behaviours. */
  function readRange() {
    if (!yon.checked) { year = year2 = null; return; }
    var a = parseInt(yin.value, 10), b = parseInt(yin2.value, 10);
    year = Math.min(a, b); year2 = Math.max(a, b);
  }

  [yin, yin2].forEach(function (el) {
  el.addEventListener("input", function () {
    if (!yon.checked) return;
    readRange();
    yout.textContent = year === year2 ? String(year) : year + "\u2013" + year2;
    paintTrack();
    clearTimeout(yin._t);
    yin._t = setTimeout(yearUI, 120);
  });
  });
  /* «Take me there.» A townland, a district or an undrawn settlement is a real
     coordinate this map knows and could not previously be asked to show. */
  document.addEventListener("click", function (ev) {
    var g = ev.target.closest && ev.target.closest(".ra-goto");
    if (!g) return;
    ev.preventDefault();
    var y = parseFloat(g.getAttribute("data-y")), x = parseFloat(g.getAttribute("data-x"));
    if (isNaN(y) || isNaN(x)) return;
    if (gmark) { map.removeLayer(gmark); gmark = null; }
    gmark = L.circleMarker([y, x], {
      radius: 9, color: "var(--accent)", weight: 2, opacity: .9,
      fillColor: "#8E6FA8", fillOpacity: .35, dashArray: "3 3"
    }).addTo(map).bindTooltip(g.getAttribute("data-n"), { permanent: false });
    /* A place the gazetteer knows and the shelf does not is still the place
       that was asked for, and gets the same ring. */
    markHit({ y: y, x: x }, fold(qbox.value.trim()));
    map.setView([y, x], Math.max(map.getZoom(), 11));
    document.querySelector(".at-map").scrollIntoView({ block: "center", behavior: "smooth" });
  });

  document.addEventListener("click", function (ev) {
    var cy = ev.target.closest && ev.target.closest(".ra-clearyear");
    if (cy) {
      ev.preventDefault();
      yon.checked = false; year = 0; yearUI();
      return;
    }
    if (!ev.target.classList || !ev.target.classList.contains("ra-setyear")) return;
    ev.preventDefault();
    yon.checked = true; year = parseInt(yin.value, 10); yearUI();
    yin.scrollIntoView({ block: "center", behavior: "smooth" });
  });

  /* EVERY COUNTRY ON EARTH IS THE RIGHT ANSWER TO NOTHING IN PARTICULAR.
     This layer draws all 237 of them so that clicking anywhere gives
     something back, which is right when nobody has asked a question. It
     was not filtered by the search, so typing a surname left two hundred
     country dots standing across Africa and Asia next to eight lit
     outlines — and a reader looking at a map of dots after typing a name
     reads the dots as the name. «0 of 21302 places shown» was printed at
     the bottom of a map covered in markers.

     So: no question, every country. A surname, only the countries that
     surname is attested in. Any other search, only countries whose name
     matches what was typed — «libya» should still find Libya. */
  function syncCountryDots() {
    /* The country list is fetched and can land before the search box is
       wired; `var qbox` is hoisted but undefined until then, and reading
       .value off it throws. This layer's whole reason for existing is a
       race exactly like that one. */
    if (!cmarks.length || !qbox) return;
    var t = fold(qbox.value.trim());
    cmarks.forEach(function (m) {
      var keep;
      if (litCC) keep = litCC[m._cc] === 1;
      else if (!t) keep = true;
      else keep = m._n.indexOf(t) > -1;
      if (keep) { if (!countryLayer.hasLayer(m)) m.addTo(countryLayer); }
      else if (countryLayer.hasLayer(m)) countryLayer.removeLayer(m);
    });
  }

  /* ---- find, filter, count ----------------------------------------------- */
  var qbox = document.getElementById("ra-q"), count = document.getElementById("ra-count");
  qbox.value = Q.get("q") || "";
  /* A year the place cannot answer for is a place that is not an answer. The
     index carries no spans, so this uses the volume count as a cheap proxy and
     the panel does the exact test — except that the exact test is the one that
     matters, so spans ride in the index after all. See build.py. */
  /* ---- A SURNAME AND A PLACE, ASKED TOGETHER -----------------------------
     «Blazevic Istria» is the question everybody actually has, and this map
     could only be asked one half of it at a time: type both and it matched
     nothing, because no place is called that and no register holds a name
     with a space in it.

     The split is only attempted when the WHOLE query matches no place, so
     nothing that works today changes — «Nova Gorica» is still one place,
     not a Nova in Gorica. Then the query is cut at each space and the first
     cut whose right-hand side names places on this map wins; the left-hand
     side is carried off to the surname register.

     `qPlace` is what the map filters on. `qName` is what the panel goes and
     looks up. If the register does not attest the name, the panel says so
     and still shows the places — «we hold no register for this name» and
     «nobody of this name lived there» are different statements and only the
     first one is ours to make. */
  var qPlace = null, qName = null;
  /* DID THE SEARCH ACTUALLY FIND ANYTHING. The remembered-searches list used
     «is a panel showing» and that is not the same question: a search that
     finds nothing still shows a panel, because saying «nothing here, and
     here is why» is the honest answer. So «zzzzqq» went into the list of
     things that worked. Set only by the three paths that produce a real
     answer — places framed, countries lit for a surname, a country opened —
     and cleared at the start of every new query. */
  var searchHit = false;
  /* TWO CLOCKS, BECAUSE THE ANSWERS ARRIVE ON TWO. A place match is decided
     inside apply(), 140ms after the last keystroke, so a timer is the only
     way to tell it apart from somebody still typing. A surname match is
     decided after fetching a shard, which lands well after any reasonable
     timer — «Blazevic» was found, and forgotten, because the timer had
     already been and gone. So: the timer catches the fast answers, and the
     slow ones report themselves when they arrive, as long as the reader has
     stopped typing. */
  var lastTyped = 0;
  function noteSearch() {
    if (Date.now() - lastTyped < 1100) return;
    var v = qbox.value.trim();
    if (v.length >= 2 && searchHit) recentAdd(v);
  }
  function nameMatch(p, t) {
    return fold(p.n).indexOf(t) > -1 || !!(p.q && wordHit(p.q, t));
  }
  function splitQuery(t) {
    qPlace = qName = null;
    if (!t || t.indexOf(" ") < 0) return;
    if (markers.some(function (m) { return nameMatch(m._p, t); })) return;
    var w = t.split(/\s+/).filter(Boolean);
    for (var i = 1; i < w.length; i++) {
      var left = w.slice(0, i).join(" "), right = w.slice(i).join(" ");
      if (left.length < 3 || right.length < 3) continue;
      if (markers.some(function (m) { return nameMatch(m._p, right); })) {
        qPlace = right; qName = left; return;
      }
    }
  }

  /* Set by ?hub=, and the reason «Show these on the map» now shows THESE.
     It used to fitBounds to the hub's countries and change nothing else, so
     the map flew to the Balkans with every other place on earth still drawn
     on it — an answer that looks like an answer and is not one. */
  var hubCCs = null;

  function keep(p) {
    if (hubCCs && !hubCCs[p.cc]) return false;
    if (off[RANK[p.a]]) return false;
    var t = qPlace || fold(qbox.value.trim());
    /* `q` now holds only the forms that are NOT the place's own name, so the
       name itself is folded here rather than shipped 2,128 times. */
    /* THE BLOB IS MATCHED ON WHOLE WORDS. `q` holds a place's other names
       AND the country it stands in — Kyiv's reads "kyiv, soviet ukraine,
       union". Searching «Krain», the German name of Carniola, therefore
       selected every Ukrainian place on the map, and the map fitted its
       bounds to Kyiv, Odesa and Stalin and flew to the middle of Ukraine
       with an empty panel. Found by patching L.Map.fitBounds on the live
       site and reading the stack, after three wrong guesses about which
       corpus was matching.
       The place's own name is still matched loosely, so typing part of a
       name still finds it. It is the blob, which carries the country, that
       has to respect word boundaries. */
    if (t && fold(p.n).indexOf(t) < 0 && !(p.q && wordHit(p.q, t))) return false;
    if (year && p.s && (p.s[0] > year2 || p.s[1] < year)) return false;
    /* ANY of the chosen kinds, not all of them: somebody after church records
       and censuses wants both sorts of place, not only the places holding
       both. A place with no kind at all is hidden once a kind is chosen,
       which is honest — nothing about it says it holds that kind. */
    var km = kindMask();
    if (km && !((p.k || 0) & km)) return false;
    return true;
  }
  /* `noFrame` is for the one caller that is not a visitor doing something:
     the quiet dots arriving a second after the map drew. They have to be
     filtered in like every other marker — they obey the year and the kind
     boxes too — but the visitor may already be typing, and re-framing the
     map on a wider set of matches would move the ground under them for a
     reason they did not ask for. Every other caller frames. */
  /* ---- CLUSTERS, BECAUSE 21,302 DOTS AT WORLD ZOOM IS A SMEAR ----------
     Canvas made drawing them all fast and did nothing for reading them:
     zoomed out, Europe is one grey mass and the eye cannot find where the
     collection actually is. This is a grid, not a clustering library —
     buckets sized in degrees by zoom, one circle per bucket, labelled
     with what it stands for.

     It swaps rather than overlays: below the threshold the individual
     markers come off the map entirely, because a bubble drawn on top of
     the dots it summarises is just more ink. Above it the bubbles go and
     the real dots come back, which is where clicking a place has to work.

     THE COUNT IS PLACES, NOT VOLUMES, and the tooltip says both. A bubble
     over Croatia reading "1,177" that silently meant books would be the
     map lying at the one zoom where nobody can check it. */
  /* THE CELL IS SEVENTY PIXELS, NOT SO-MANY DEGREES. The first version cut
     the world into degree-wide squares and at the opening zoom that gave
     639 bubbles for 21,473 places — a finer smear on top of the old one,
     which is worse than no clustering because it also hides the colours.
     Measured, not guessed: `recordAtlas.state()` reports the count, which
     is most of why that handle exists.
     A cell in projected pixels is the same size on screen at every zoom, so
     the map holds roughly ninety bubbles whatever the reader does, and
     zooming in genuinely divides them instead of merely redrawing. */
  var clusterLayer = L.layerGroup(), CLUSTER_TO = 6, CLUSTER_PX = 70,
      lastVisible = [];
  function show(layer, want) {
    var has = map.hasLayer(layer);
    if (want && !has) layer.addTo(map);
    else if (!want && has) map.removeLayer(layer);
  }
  function drawClusters(visible) {
    clusterLayer.clearLayers();
    var z = map.getZoom();
    var bubbles = !!(on.shelf && z < CLUSTER_TO && visible.length);
    show(clusterLayer, bubbles);
    show(shelfLayer, on.shelf && !bubbles);
    if (!bubbles) return false;
    /* Read the token rather than hard-coding the teal: Leaflet paints these
       into a canvas, where a CSS variable would come out as nothing, and
       dark mode moves --accent from #1F5C6B to #6FB6C6. */
    var ink = getComputedStyle(document.documentElement)
      .getPropertyValue("--accent").trim() || "#1F5C6B";
    var cells = {}, top = 1;
    visible.forEach(function (m) {
      var p = m._p, pt = map.latLngToLayerPoint(m.getLatLng());
      var k = Math.floor(pt.x / CLUSTER_PX) + ":" + Math.floor(pt.y / CLUSTER_PX);
      var c = cells[k] || (cells[k] = { n: 0, v: 0, y: 0, x: 0 });
      c.n++; c.v += p.v || 0; c.y += pt.y; c.x += pt.x;
      if (c.n > top) top = c.n;
    });
    Object.keys(cells).forEach(function (k) {
      var c = cells[k];
      var at = map.layerPointToLatLng(L.point(c.x / c.n, c.y / c.n));
      L.circleMarker(at, {
        radius: 7 + 22 * Math.sqrt(c.n / top),
        color: "#fff", weight: 1, opacity: 0.9,
        fillColor: ink, fillOpacity: 0.62
      })
        .bindTooltip(c.n.toLocaleString() + (c.n === 1 ? " place" : " places") +
          (c.v ? " \u00b7 " + c.v.toLocaleString() + " volumes" : ""),
          { sticky: true })
        .on("click", function (e) {
          map.setView(e.latlng, Math.min(map.getZoom() + 3, CLUSTER_TO + 1));
        })
        .addTo(clusterLayer);
    });
    return true;
  }

  function apply(noFrame) {
    var t = fold(qbox.value.trim());
    searchHit = false;
    /* The lighting belongs to the query that produced it, and nothing else. */
    if (litFor !== null && litFor !== t) { clearLit(); syncCountryDots(); }
    /* THE STRIP BELONGS TO THE SEARCH THAT BUILT IT. Typing runs a search per
       keystroke: at «de» 1,640 places matched and filled the strip, and by
       «defranceski» NO place matched — so the branch that would have rebuilt
       it never ran, and the strip sat there offering Aberdeen and Adelaide
       under a heading that said «1,640 places match "de"» while the box read
       defranceski. Cleared at the top of every search, and rebuilt below only
       if this search has matches of its own. */
    if (t !== lastHitFor) { hitLayer.clearLayers(); lastHitFor = null; clearHood(); }
    splitQuery(t);
    if (qPlace) t = qPlace;
    syncCountryDots();
    var shown = 0, vis = [];
    markers.forEach(function (m) {
      var ok = keep(m._p);
      if (ok) { if (!shelfLayer.hasLayer(m)) m.addTo(shelfLayer); shown++; vis.push(m); }
      else if (shelfLayer.hasLayer(m)) shelfLayer.removeLayer(m);
    });
    lastVisible = vis;
    drawClusters(vis);
    var aShown = 0;
    archMarkers.forEach(function (m) {
      /* Same blob, same fix: an archive's _q carries the town and country
         it stands in, so «Krain» matched every archive in Ukraine too. */
      var ok = !t || wordHit(m._q, t);
      if (ok) { if (!archiveLayer.hasLayer(m)) m.addTo(archiveLayer); aShown++; }
      else if (archiveLayer.hasLayer(m)) archiveLayer.removeLayer(m);
    });
    /* A YEAR THAT EMPTIES THE MAP SHOULD SAY SO LOUDLY. Set to 2004 this hides
       everything, because almost nothing is open for 2004 — privacy windows
       close births for a century and deaths for fifty years. That is a correct
       answer and it looks exactly like a broken map, which is why the count
       line now says which it is and offers the way out. */
    /* TOTAL_PLACES, not markers.length. markers holds the loud half until the
       quiet fetch lands about a second later, so this line spent that second
       saying «15780 of 15780 places shown» — which does not merely undercount,
       it states that the atlas holds 15,780 places when it holds 21,473. That
       is the precise mistake the comment at TOTAL_PLACES was written to stop,
       made in the one line a reader actually reads. */
    /* SILENT WHEN NOTHING IS FILTERED. «21,754 of 21,754 places shown» under
       an unfiltered map answers a question nobody asked and repeats the count
       already in the dek above it — the third of the three David counted. The
       moment a filter, a year or the archive layer narrows anything it speaks
       again, which is the whole reason it exists: «0 of 21,302 places shown»
       is the answer to a filter and must never be silent. */
    var narrowed = shown !== TOTAL_PLACES || year || on.archives;
    /* THE ELEMENT KEEPS REPORTING EVEN WHEN IT STOPS SPEAKING. Two tests read
       this line: one waits for it to fill as the signal that the map is up,
       and one parses «X of Y» to prove the quiet half landed before the total
       was stated — that second one guards a real past bug where the
       denominator was the loud half and the line misstated the size of the
       atlas. Going silent at rest would have deleted both guards along with
       the duplicate sentence, so the numbers move to attributes: machine
       readable, announced to nobody, and true the moment apply() has run. */
    count.setAttribute("data-shown", shown);
    count.setAttribute("data-total", TOTAL_PLACES);
    count.setAttribute("data-ready", "1");
    count.innerHTML = !narrowed ? "" :
      esc(shown.toLocaleString() + " of " +
          TOTAL_PLACES.toLocaleString() + " places shown") +
      (year ? esc(", able to answer for " + year) : "") +
      (on.archives ? esc(", and " + aShown.toLocaleString() + " of " +
                          archives.length.toLocaleString() + " archives") : "");
    if (year && !shown) {
      count.innerHTML = '<b>Nothing on this map can answer for ' + (year === year2 ? year : year + '\u2013' + year2) + '.</b> ' +
        "Records close for a lifetime — a century for births, fifty years for " +
        'deaths — so a recent year empties it. <a href="#" class="ra-clearyear">' +
        "Clear the year</a> to see all " + TOTAL_PLACES.toLocaleString() + " places.";
    }

    if (!t) {
      /* Clearing the box clears the map with it. Anything drawn to answer a
         search is an answer to a question nobody is asking any more. */
      if (gmark) { map.removeLayer(gmark); gmark = null; }
      ctryLayer.clearLayers();
      communeLayer.clearLayers();
      litCC = null;
      return;
    }
    if (noFrame) return;
    var vis = markers.filter(function (m) { return shelfLayer.hasLayer(m); });
    var avis = archMarkers.filter(function (m) { return archiveLayer.hasLayer(m); });
    var frame = vis.concat(on.archives ? avis : []);
    if (frame.length) {
      searchHit = true;
      noteSearch();
      map.fitBounds(L.latLngBounds(frame.map(function (m) { return m.getLatLng(); })),
                    { padding: [40, 40], maxZoom: 11 });
      /* Both halves were asked, so both get answered, in one panel. */
      if (qName) { both(vis, qName, qbox.value.trim()); return; }
      if (vis.length === 1) { markHit(vis[0]._p, t); open(vis[0]._p); return; }
      /* EVERY MATCH GETS THE RING, NOT JUST A LONE ONE. David: «why if i
         search senj am i not getting the pulsing red markers?» Because
         markHit() was only reached when exactly one place matched — so the
         clearer the search, the better it was marked, and five Senjs spread
         across two counties got nothing at all. That is backwards: a handful
         of matches is exactly when the reader needs to be shown where they
         are. Capped, because ringing forty dots marks nothing. */
      if (vis.length > 1 && vis.length <= 12) markHits(vis, t);
      /* SEVERAL PLACES MATCHED, SO THE MAP IS THE ANSWER — BUT THE PANEL
         MUST NOT STILL BE ANSWERING THE LAST QUESTION. This branch framed
         the matches and fell through without touching the panel, so the
         panel kept whatever the previous search had put there. Typing
         «Kranj» moved the map to Carniola while the panel went on
         describing the surname Kosina from the search before it. I misread
         that as a broken search twice today before noticing the panel and
         the map were answering different questions.
         One line saying what was framed, and which places they are. */
      if (vis.length > 1) {
        empty.hidden = true; panel.hidden = false; retireVisit();
        var some = vis.slice(0, 12);
        var hh = ['<div class="at-h"><h3>' + esc(qbox.value.trim()) + "</h3>" +
                  '<span class="at-n">' + vis.length.toLocaleString() +
                  " places</span></div>"];
        hh.push('<p class="at-what"><b>' + vis.length.toLocaleString() +
                " places match, and the map is framed on them.</b> Click a dot for " +
                "what stands there, or narrow the name.</p>");
        hh.push('<ul class="at-films">');
        some.forEach(function (m) {
          var p = m._p;
          hh.push('<li><a href="' + BASE + "place/" + esc(p.i) + '/">' + esc(p.n) +
                  "</a>" + (p.c ? ' <span class="ra-who">' + p.c +
                  " collection" + (p.c === 1 ? "" : "s") + "</span>" : "") + "</li>");
        });
        hh.push("</ul>");
        if (vis.length > some.length)
          hh.push('<p class="cap">and ' + (vis.length - some.length).toLocaleString() +
                  " more on the map.</p>");
        panel.innerHTML = hh.join("");
        return;
      }
    }

    /* «NO PLACES OF THAT NAME» WHEN THE YEAR IS WHAT HID IT. David searched
       Crikvenica and was told this map had nothing, while his own archive
       shows six volumes for it. It has all six. The year slider was on 2004
       and Crikvenica's registers run 1798 to 1943, so the filter removed the
       marker — correctly — and the search then reported the place as absent,
       which is a different and untrue thing.
       A filter hiding something is not the same as the something not being
       there, and this panel is the only place that can say which. */
    if (year) {
      var hidden = markers.filter(function (m) {
        var p = m._p;
        if (shelfLayer.hasLayer(m)) return false;
        var q = fold(p.n) + " " + (p.q || "");
        return wordHit(q, t);
      });
      if (hidden.length) {
        var one = hidden[0]._p;
        empty.hidden = true; panel.hidden = false;
        var hh = ['<div class="at-h"><h3>' + esc(one.n) + "</h3></div>"];
        hh.push('<div class="ra-juris" style="border-left-color:#E8792B">' +
                '<div class="lab">Hidden by the year, not missing</div>');
        hh.push("<p><b>" + esc(one.n) + "</b> is on this map with <b>" +
                ((one.v || 0) || (one.c || 0)).toLocaleString() + " volume" +
                (((one.v || 0) || (one.c || 0)) === 1 ? "" : "s") + "</b>" +
                (one.s ? ", covering " + one.s[0] + "–" + one.s[1] : "") +
                " — and <b>nothing here covers " + (year === year2 ? year : year + "\u2013" + year2) + "</b>, so the year " +
                "filter has taken it off the map.</p>");
        hh.push('<p><a href="#" class="ra-clearyear"><b>Clear the year</b></a>' +
                " and it comes back" +
                (hidden.length > 1 ? ", with " + (hidden.length - 1) + " other " +
                 (hidden.length === 2 ? "place" : "places") + " this is hiding" : "") +
                '. Or go straight to <a href="' + BASE + "place/" + esc(one.i) +
                '/">everything recorded at ' + esc(one.n) + "</a>.</p>");
        hh.push("</div>");
        panel.innerHTML = hh.join("");
        return;
      }
    }
    /* THE HONEST EMPTY RESULT. Somebody typing "Ireland" has asked a real
       question, and a blank map answers it with a falsehood. There is no Irish
       shelf here YET — but there are providers that cover Ireland and archives
       standing in Dublin, and the difference between "we have not walked this"
       and "there is nothing here" has to be said out loud every single time or
       the map quietly implies a completeness it does not have. */
    if (!shown) elsewhere(qbox.value.trim());
  }

  /* THE ANSWER TO «A NAME, IN A PLACE».
     The map is already framed on the places by the time this runs; this
     writes the panel. The one thing it must not do is imply that an
     attestation is a presence: the Croatian register saying 11,163 people
     carry a name is a fact about Croatia, not about the four villages the
     map happens to be showing. So the two statements are kept apart, and
     the places that DO sit in an attested country are marked as such and
     the others are not. */
  async function both(vis, name, raw) {
    var mine = ++searchTok;
    var list = await surnames(name);
    if (mine !== searchTok) return;
    var r = list[0];
    /* MATCHED ON THE COUNTRY CODE, not on the country's name turning up in
       the place's search blob. The first version did the latter and was
       wrong every single time: `q` carries only the names a place used to
       have, so Gračišće's is the one word "gallignana" and it matched
       nothing at all. The panel then told a reader that Blažević is not
       attested where Gračišće stands — which is Croatia, which the same
       paragraph went on to list. `cc` is back on the index row for this. */
    var attested = {}, ccs = [];
    if (r) r.countries.forEach(function (c) {
      if (!c.cc) return;
      attested[String(c.cc).toUpperCase()] = c; ccs.push(c);
    });
    var inAttested = function (p) {
      return p.cc ? attested[String(p.cc).toUpperCase()] || null : null;
    };
    var hit = vis.filter(function (m) { return !!inAttested(m._p); });

    empty.hidden = true; panel.hidden = false;
    /* The heading is the register's own spelling where there is one —
       «Blažević», not the folded «blazevic» the matcher works in, which is
       what the first version printed across the top of the panel. Failing
       that, the words the reader actually typed. */
    var typed = raw.split(/\s+/);
    var asked = typed.slice(0, Math.max(1, typed.length -
                  qPlace.split(/\s+/).length)).join(" ");
    var title = r ? r.n : asked;
    var h = ['<div class="at-h"><h3>' + esc(title) + "</h3>" +
             '<span class="at-n">' + vis.length.toLocaleString() +
             (vis.length === 1 ? " place" : " places") + "</span></div>"];
    h.push('<p class="at-sub">' + esc(raw) + " — read as the name <b>" + esc(asked) +
           "</b> and the place <b>" + esc(vis[0]._p.n) + "</b>.</p>");

    if (!r) {
      h.push('<p class="at-what"><b>No register here attests ' + esc(asked) + '.</b> ' +
             "That is a statement about this atlas and not about the name — the " +
             "registers it holds cover some countries and not others, and a name " +
             "absent from them may be perfectly common where your people lived. " +
             "The places below are the other half of what you asked.</p>");
    } else if (!ccs.length) {
      h.push('<p class="at-what"><b>' + esc(r.n) + " is held here with no country " +
             "attached,</b> so it cannot be lined up against these places.</p>");
    } else if (hit.length) {
      /* «1 of these 1 places stands» is what arithmetic says and not what
         a person would. One place gets a sentence about that place. */
      h.push('<p class="at-what"><b>' +
             (vis.length === 1
               ? esc(vis[0]._p.n) + " stands in a country where " + esc(r.n) +
                 " is attested."
               : hit.length.toLocaleString() + " of these " +
                 vis.length.toLocaleString() + " places " +
                 (hit.length === 1 ? "stands" : "stand") + " in a country where " +
                 esc(r.n) + " is attested.") +
             "</b> Attested means a register counted the " +
             "name in that country. It does not mean anybody of the name lived in " +
             "these particular villages — that is what the records are for, and " +
             "they are listed on each place below.</p>");
    } else {
      h.push('<p class="at-what"><b>None of these places is in a country where ' +
             esc(r.n) + " is attested here.</b> That is worth knowing and it is not " +
             "a verdict: it can equally mean this atlas holds no register for that " +
             "country. The name is attested in " +
             ccs.slice(0, 6).map(function (c) { return esc(CNAME[c.cc]); }).join(", ") +
             (ccs.length > 6 ? " and " + (ccs.length - 6) + " more" : "") + ".</p>");
    }

    h.push('<ul class="at-films">');
    vis.slice(0, 14).forEach(function (m) {
      var pl = m._p, a = inAttested(pl);
      h.push('<li><a href="' + BASE + "place/" + esc(pl.i) + '/">' + esc(pl.n) + "</a>" +
             (pl.c ? ' <span class="ra-who">' + pl.c + " collection" +
              (pl.c === 1 ? "" : "s") + "</span>" : "") +
             (a ? ' <span class="ra-crossed">' + esc(CNAME[a.cc]) +
              (a.n ? " · " + a.n.toLocaleString() + " of the name" : "") +
              "</span>" : "") + "</li>");
    });
    h.push("</ul>");
    if (vis.length > 14)
      h.push('<p class="cap">and ' + (vis.length - 14).toLocaleString() +
             " more on the map.</p>");
    if (r) h.push(renderSurnames([r], r.n));
    panel.innerHTML = h.join("");
    if (r) showCountries(r.countries, function () { return mine !== searchTok; },
                         originCC(r));
  }

  /* THE PLACE YOU ASKED FOR, IN A COLOUR NOTHING ELSE USES.
     A search framed the map on Gračišće and then drew it as one more small
     grey dot among grey dots — «i cant differentiate the country icons from
     the one i searched». Every other colour on this map means «what it
     costs to look», so the answer cannot be another of those.

     IT WAS AMBER, AND AMBER WAS NOT FREE. This comment used to say «amber,
     which the access scale does not use»; the scale's `mixed` is #E8792B and
     the ring was #E8912B, so it collided with an access state and with the
     amber archive triangles around it. Magenta is the colour the scale has
     never used — see the note on .ra-hit in the stylesheet below. It pulses,
     which nothing else does.

     A ring around the dot rather than a replacement for it, so the dot's own
     colour — the thing the legend is about — is still readable underneath.

     A DOM marker rather than a canvas one, because the canvas renderer
     cannot animate and the whole point is that it moves. */
  function markHits(list, term) {
    hitLayer.clearLayers();
    lastHitFor = term;
    list.forEach(function (m) {
      var p = m._p || m;
      if (p.y == null) return;
      L.marker([p.y, p.x], {
        interactive: false, keyboard: false,
        icon: L.divIcon({ className: "ra-hit", iconSize: [34, 34],
                          iconAnchor: [17, 17], html: "<i></i><b></b>" })
      }).addTo(hitLayer);
    });
    if (!map.hasLayer(hitLayer)) hitLayer.addTo(map);
  }

  function markHit(p, term) {
    hitLayer.clearLayers();
    lastHitFor = term;
    L.marker([p.y, p.x], {
      interactive: false, keyboard: false,
      icon: L.divIcon({ className: "ra-hit", iconSize: [34, 34],
                        iconAnchor: [17, 17], html: "<i></i><b></b>" })
    }).addTo(hitLayer);
    if (!map.hasLayer(hitLayer)) hitLayer.addTo(map);
  }

  /* SURNAMES. A place is not the only thing somebody arrives holding: very
     often all they have is a name on a certificate and no idea which country
     to start in. This answers that — the spellings the name also takes, the
     countries it is attested in, and from there the collections and archives
     that reach those countries.

     «Attested in» means the name appears in a dataset held here. It never
     means the name exists there and nowhere else, and the panel says so. */
  var scache = {};
  async function surnames(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in scache)) {
      try { scache[key] = await (await fetch(SURN + key + ".json")).json(); }
      catch (e) { scache[key] = []; }
    }
    var hit = [];
    scache[key].forEach(function (r) {
      var q = fold(r.n);
      var m = q === f ? 0 : q.indexOf(f) === 0 ? 1 : null;
      if (m === null) {
        for (var i = 0; i < r.variants.length; i++) {
          var fv = fold(r.variants[i].n);
          if (fv === f) { m = 2; break; }
          if (fv.indexOf(f) === 0 && m === null) m = 3;
        }
      }
      if (m !== null) hit.push([m, r]);
    });
    hit.sort(function (a, b) {
      return a[0] - b[0] || (b[1].countries.length - a[1].countries.length);
    });
    /* ONE CARD PER CLUSTER. Searching «Llerena» returned LLERENA, LARENA and
       LERENA as three separate panels saying much the same thing, because
       each is a hit in its own right. They are one family of spellings: if a
       name is already listed as a variant of something shown above it, it is
       not news. The best-ranked one wins and carries the rest. */
    var shown = [], claimed = {};
    hit.forEach(function (x) {
      var r = x[1];
      if (claimed[fold(r.n)]) return;
      shown.push(r);
      claimed[fold(r.n)] = true;
      r.variants.forEach(function (v) { claimed[fold(v.n)] = true; });
    });
    return shown.slice(0, 4);
  }

  function renderSurnames(list, term) {
    var h = [];
    var same = list.length && fold(list[0].n) === fold(term);
    list.forEach(function (r) {
      h.push('<div class="ra-surn"><div class="lab">The name</div>');
      /* Suppressed when the panel's own heading is already this name —
         see the canon note where the heading is built. */
      if (!(same && fold(r.n) === fold(term)))
        h.push("<p><b>" + esc(r.n) + "</b></p>");

      /* AND SOMEWHERE TO GO. The panel named a surname and stopped,
         while the atlas holds a page for it — variants, where it is
         borne, when it was being born, and which archives to write to.
         `pg` is set by build.py for the 23,926 names that have one;
         without the flag this would 404 for thirty-nine names in forty,
         because most surnames in a 946,575-name corpus have nothing to
         put on a page. */
      /* WHAT WIKIDATA SAYS THE NAME IS. David: «why would we not be showing
         the proper origin of the surname?» — and we were, on the surname page
         and nowhere else, because the file is 13 MB and this panel is client
         side. It rides in the shard now (see build.py).

         NEVER IN THIS MAP'S VOICE. The label says who said it and the id is
         shown, because the whole reason origin was kept out is that everywhere
         else serves etymology with no source behind it. «Named after tailor —
         Wikidata Q15080511» is a citation; «Taylor means a cutter of cloth» is
         a claim this atlas has no standing to make.

         And the caveat travels with the language, in the page's own words: a
         name's language is not where a family is from. */
      if (r.ctx) {
        var c = r.ctx, oh = ['<div class="ra-orig">'];
        if (c.after && c.after.length)
          oh.push('<p class="ra-orig-l"><b>' + esc(T("Named after") + " " +
                  c.after.join(" · ")) + "</b> <span class=\"ra-who\">" +
                  esc(T("what the name is from")) + "</span></p>");
        if (c.kind && c.kind.length)
          oh.push('<p class="ra-orig-l"><b>' + esc(c.kind.join(" · ")) +
                  "</b> <span class=\"ra-who\">" + esc(T("kind of surname")) +
                  "</span></p>");
        if (c.lang && c.lang.length)
          oh.push('<p class="ra-orig-l"><b>' + esc(c.lang.join(" · ")) +
                  "</b> <span class=\"ra-who\">" +
                  esc(T("the language of the name")) + "</span></p>" +
                  '<p class="cap ra-orig-c">' + esc(T("Which is not where a " +
                  "family is from. A Polish surname can be borne by people " +
                  "whose forebears never saw Poland, and often is.")) + "</p>");
        oh.push('<p class="ra-orig-s">' +
                (c.wiki ? '<a href="' + esc(c.wiki) + '" target="_blank" ' +
                          'rel="noopener">' + esc(T("Read about it on Wikipedia")) +
                          " \u2197</a> \u00b7 " : "") +
                esc(T("said by")) + ' <a href="https://www.wikidata.org/wiki/' +
                esc(c.q) + '" target="_blank" rel="noopener">Wikidata ' +
                esc(c.q) + "</a></p>");
        oh.push("</div>");
        h.push(oh.join(""));
      }

      /* AND WHAT WIKTIONARY SAYS, WHICH IS WIDER AND SHARE-ALIKE.
         Wikidata's structured fields reach a tenth of the corpus and that is
         its ceiling; the standard printed authority is not openly licensed.
         Wiktionary is CC BY-SA 4.0 and covers far more.

         THE SAME RULE AS ABOVE, AND FOR THE SAME REASON. Only what a named
         source says, never in this map's voice, with the citation attached —
         here the page and the revision it was read at, because Wiktionary
         changes under you in a way a Wikidata id does not. Nothing is taken
         from the Etymology or Statistics sections: those are prose, and the
         `from=` of the surname template is a field.

         AND UNDER THE LANGUAGE THAT SAID IT. Taylor is «from occupations» in
         its English section and «from English» in its French one. Printed as
         one list those two true statements read as a name from occupations
         AND from English, which is a third thing neither of them says. */
      /* AN ABSENT ENTRY IS AN ANSWER AND WAS BEING RENDERED AS SILENCE.
         David, more than once: «i still dont see anything about the origin of
         the name?» — because Wiktionary has no page for Defrančeski, so the
         whole block was omitted and the panel simply skipped from the
         timeline to the spelling list. A reader cannot tell that apart from
         the atlas not looking. It holds 78,628 surnames, 25,987 of them with
         an etymology; saying which of those a name missed out on is a fact
         about the source, and it stops somebody asking a fourth time. */
      if (!r.wk) {
        h.push('<div class="ra-orig ra-orig-none"><p class="ra-orig-l">' +
               esc(T("Wiktionary has no entry for this name.")) +
               ' <span class="ra-who">' + esc(T("It holds 78,628 surnames and "
               + "25,987 of those say what the name is from. This one is not "
               + "among them \u2014 which is the dictionary's gap, not a "
               + "judgement about the name.")) + "</span></p></div>");
      }
      if (r.wk) {
        var w = r.wk, wh = ['<div class="ra-orig ra-orig-wk">'];
        (w.etymon || []).forEach(function (e) {
          wh.push('<p class="ra-orig-l"><b>' +
                  esc(T("From") + " " + e.lang + " " + e.word) + "</b>" +
                  (e.gloss ? ' <i>&#8220;' + esc(e.gloss) + "&#8221;</i>" : "") +
                  (e.in ? ' <span class="ra-who">' +
                          esc(T("in the") + " " + e.in + " " + T("entry")) +
                          "</span>" : "") + "</p>");
        });
        Object.keys(w.from || {}).forEach(function (lg) {
          wh.push('<p class="ra-orig-l"><span class="ra-tag">' +
                  esc(T("origin")) + "</span> <b>" +
                  esc(w.from[lg].join(" \u00b7 ")) +
                  "</b> <span class=\"ra-who\">" +
                  esc(T("what the") + " " + lg + " " + T("entry says it is from")) +
                  "</span></p>");
        });
        if (w.langs && w.langs.length)
          wh.push('<p class="ra-orig-l"><b>' + esc(w.langs.join(" \u00b7 ")) +
                  "</b> <span class=\"ra-who\">" +
                  esc(T("recorded as a surname in these languages")) +
                  "</span></p>");
        /* The caveat is the same one the Wikidata block carries and is worth
           repeating here rather than assumed read: a name's language is not
           a family's country. */
        wh.push('<p class="cap ra-orig-c">' + esc(T("A language here is the " +
                "language of the NAME, not a country a family came from.")) +
                "</p>");
        wh.push('<p class="ra-orig-s">' + esc(T("said by")) +
                ' <a href="' + esc(w.cite) + '" target="_blank" rel="noopener">' +
                esc(T("Wiktionary")) + " \u2197</a> \u00b7 " +
                esc(T("CC BY-SA 4.0")) + "</p>");
        wh.push("</div>");
        h.push(wh.join(""));
      }

      /* WHERE THE NAME WAS, AND WHEN. David: «finding a name almost does
         nothing — i thought we had dates the name was at a certain place… we
         could draw that on a timeline, and start to align our place search
         with the location search». The decades ride in the shard now; this is
         the drawing, and it borrows the place panel's furniture on purpose —
         a flag per country, a band per row, the same navy the visit ring uses.

         RUNS, NOT A SINGLE SPAN. De Franceschi in Italy is 1550 and then
         1840–1970: printed as «1550s–1970s» that invents four centuries of
         continuous presence out of two data points. Decades more than fifty
         years apart start a new run, so the gap is visible as a gap.

         The counts are not here and not in the shard — see build.py. */
      /* AND THE COUNTRIES WITH RECORDS BUT NO DATES SAY SO, RATHER THAN
         BEING LEFT OFF. David, on Blazevic opening in Croatia at 1910 when
         the family research goes far earlier: «No dates record should say
         that».

         The band has exactly one source — Wikidata people notable enough for
         an encyclopaedia — and counted across the corpus that is not one
         name's problem. Of the 205,400 names carrying both a band and record
         evidence, 140,578 have evidence in a country the band DOES NOT DRAW,
         and 79,469 open at 1900 or later in a country they are attested in.
         A band that silently omits Croatia does not read as «no dates here»;
         it reads as «not here», which is a claim this atlas does not hold and
         would not make in words.

         So the country gets its row, and the row says what is true: the
         records name it, and nobody has put a date on it. No date is invented
         and none is implied — the strip is the same hatching the ground band
         uses for an era no archive holds, which a reader of this map has
         already met meaning exactly «this is known to be empty, not missing». */
      /* TWO SERIES, NOT ONE MERGED CLAIM. `tl` is Wikidata's notable people;
         `tla` is a count of ordinary people from the eight family archives,
         which is where the earlier dates live — Blažević in Croatia opens at
         1910 in the first and at the 1790s in the second. They have opposite
         biases and the reader can only weigh them if the band says which row
         came from where, so each country can carry a row of each. */
      var tlHas = r.tl || {}, tlaHas = r.tla || {};
      var undated = (r.countries || []).filter(function (c) {
        return ["register", "archive", "curated"].indexOf(c.how) > -1 &&
               !tlHas[c.cc] && !tlaHas[c.cc];
      }).map(function (c) { return c.cc; });
      undated = undated.filter(function (cc, i) { return undated.indexOf(cc) === i; })
                       .sort(function (a, b) {
                         /* By country NAME. Ordering an undated list by how
                            many rows produced it would rank countries by how
                            much of this atlas has been built, which is a fact
                            about us and not about the name. */
                         var A = CNAME[a] || a, B = CNAME[b] || b;
                         return A < B ? -1 : A > B ? 1 : 0;
                       });
      if (r.tl || r.tla || undated.length) {
        var cc0 = Object.keys(r.tl || {});
        var lo = 9999, hi = 0;
        /* THE SCALE SPANS BOTH SERIES. Sized on Wikidata alone, an archive row
           starting in the 1790s against a band that opens at 1880 computes a
           negative left and is clamped to zero — every early decade, which is
           the entire reason the archives were opened, piled against the edge
           saying nothing. */
        function stretch(src) {
          Object.keys(src || {}).forEach(function (cc) {
            src[cc].forEach(function (d) { if (d < lo) lo = d; if (d > hi) hi = d; });
          });
        }
        stretch(r.tl); stretch(r.tla);
        var span = Math.max(1, hi - lo);
        var rows = cc0.map(function (cc) {
          return { cc: cc, ds: r.tl[cc], first: r.tl[cc][0], src: "wd" };
        });
        Object.keys(r.tla || {}).forEach(function (cc) {
          rows.push({ cc: cc, ds: r.tla[cc], first: r.tla[cc][0], src: "ar" });
        });
        rows.sort(function (a, b) { return a.first - b.first; });
        /* Dated rows first, in the order the evidence puts them; the undated
           ones after, because they cannot be placed on the scale and sorting
           them into it would put them somewhere they do not belong. */
        rows = rows.concat(undated.map(function (cc) {
          return { cc: cc, ds: null };
        }));

        /* THE SAME BAND THE GROUND GETS, AND FOR THE SAME REASON.
           David, with a place answer and a name answer side by side: «search
           by place vs name, completely different look and feel. can we align
           names to places please? the timelines the maps, the volumes, the
           right pane».

           He is looking at «Who held this ground» — proportional blocks in
           each regime's own colour, the years written inside them, an axis
           underneath — against a name timeline that was a 7px beige rule with
           tick marks on it. Same question, «when was this here», answered in
           two visual languages.

           So this is the band's markup, not a cousin of it: .ra-tl-band of
           .ra-tl-seg, flex-grow by duration, --seg for the colour, the years
           inside the segment, .ra-tl-axis at the foot. One row per country
           instead of one row for the ground, and a RUN is a segment while a
           GAP is a bare spacer — so a name absent from a country for a
           century reads as absence and not as a thinner line.

           THE COLOUR IS THE COUNTRY'S OWN, the way the band's is the regime's.
           flag-index.json has carried a colour for all 210 countries from the
           start; this is the second thing to use it. */
        var wh = ['<div class="ra-tw"><p class="at-lab">' +
                  esc(T("Where the name was, and when")) + "</p>"];
        /* FIRST ATTESTED, ON THE PAGE AND NOT ONLY IN THE MAP'S HEAD.
           David: «first attested and origin should both show». They are two
           different claims from two different sources and the panel was
           making one of them silently — the earliest dated country decided
           where the map flew and was never written down, so a reader saw the
           map move and could not say why.
           ORIGIN is what Wiktionary's entry says the name is FROM, printed
           below with the language that said it. FIRST ATTESTED is the
           earliest year this atlas holds a record of the name anywhere, and
           they can disagree: Falco is Italian by etymology and first attested
           in Germany in 1590, because Wikidata's notables are thin before
           1900 and biased to whoever writes encyclopaedias. Both are true and
           neither is the other, so both are labelled for what they are. */
        /* ORIGIN FIRST, because it is the answer to the question a reader
           asked; first-attested follows as the record behind part of it.
           Both are shown because they disagree often enough to matter —
           Falco is Italian and first attested in Germany. */
        var og = r.or;
        if (og) {
          var CONF = { 3: T("strong"), 2: T("fair"), 1: T("a lead") };
          var why = [];
          if (og.s != null && og.t)
            why.push(Math.round(og.s * 100) + "% " +
                     T("of the") + " " + og.t[1].toLocaleString() + " " +
                     T("a state counted, across") + " " + og.t[2] + " " +
                     T("national registers this atlas holds"));
          if (og.f)
            why.push(T("earliest record held") + ": " +
                     (CNAME[og.f[0]] || og.f[0]) + " " + og.f[1] + "s" +
                     (og.f[2] === "a" ? " (" + T("our own archives") + ")" : ""));
          if (og.p) why.push(T("a place of the name is there too"));
          /* THE TWO THIN KINDS HAVE TO SAY WHICH THIN KIND THEY ARE. Without
             these a lever-1 row prints «origin Denmark — a lead» and nothing
             else: a bare country with a confidence badge and no working,
             which is exactly what every other row here refuses to be.
             `r` — a national register NAMES the name and gives no number, so
             the country is evidenced and the strength is not.
             `v` — borrowed from a spelling variant that has one. Only
             spelling variants are ever inherited, never phonetic ones, and
             the row names the variant so a reader can go and disagree. */
          if (og.r)
            why.push(T("the national register of") + " " +
                     (CNAME[og.cc] || og.cc) + " " +
                     T("names it, without saying how many"));
          if (og.v)
            why.push(T("taken from") + " " + og.v + ", " +
                     T("a spelling of the same name"));
          wh.push('<p class="ra-first"><span class="ra-tag">' +
            esc(T("origin")) + "</span> <b>" + esc(CNAME[og.cc] || og.cc) +
            '</b> <span class="ra-conf ra-conf-' + og.c + '">' +
            esc(CONF[og.c]) + "</span>" +
            (why.length ? '<br><span class="ra-who">' + esc(why.join(" \u00b7 ")) +
              " \u2014 " + esc(T("worked out from this atlas's own data, not "
              + "looked up")) + "</span>" : "") + "</p>");
        }
        var fa = firstAttested(r);
        if (fa && !(og && og.f && og.f[0] === fa.cc && og.f[1] === fa.year)) {
          wh.push('<p class="ra-first"><span class="ra-tag">' +
            esc(T("first attested")) + "</span> <b>" +
            esc(CNAME[fa.cc] || fa.cc) + "</b> " + esc(fa.year + "s") +
            ' <span class="ra-who">' +
            esc(fa.src === "tla"
                  ? T("the earliest year a record in this project's own family "
                      + "archives carries the name")
                  : T("the earliest birth year Wikidata gives for somebody "
                      + "notable of the name \u2014 thin before 1900")) +
            "</span></p>");
        }
        rows.slice(0, 14).forEach(function (row) {
          var f0 = CC2FLAG && CC2FLAG[row.cc];
          /* NO DATES IS A FINDING, AND IT IS WRITTEN OUT. The row exists
             because a register or an archive names this surname in this
             country; what nothing here knows is WHEN. Hatched across the
             whole width — the ground band's own mark for «known to be empty,
             not missing» — with the sentence beside it, so the strip cannot
             be mistaken for a span. */
          if (!row.ds) {
            wh.push('<div class="ra-tw-r">' +
                    '<span class="ra-tw-f">' +
                    (f0 && f0.flag ? '<svg viewBox="0 0 300 200" aria-hidden="true">' +
                                     f0.flag + "</svg>" : "") + "</span>" +
                    '<a class="ra-tw-c" href="' + BASE + "country/" +
                    row.cc.toLowerCase() + '/">' + esc(CNAME[row.cc] || row.cc) +
                    "</a>" +
                    '<span class="ra-tw-band"><span class="ra-tl-seg-bare ' +
                    'ra-tw-none"><span class="ra-tl-y">' +
                    esc(T("in the records, no dates recorded")) +
                    "</span></span></span></div>");
            return;
          }
          /* group decades into runs, breaking on a gap of more than 50 years */
          var runs = [], cur = [row.ds[0]];
          for (var i = 1; i < row.ds.length; i++) {
            if (row.ds[i] - row.ds[i - 1] > 50) { runs.push(cur); cur = []; }
            cur.push(row.ds[i]);
          }
          runs.push(cur);
          var f = CC2FLAG && CC2FLAG[row.cc];
          var tint = (f && f.color) || "var(--accent)";
          var isAr = row.src === "ar";
          wh.push('<div class="ra-tw-r">' +
                  '<span class="ra-tw-f">' +
                  (f && f.flag ? '<svg viewBox="0 0 300 200" aria-hidden="true">' +
                                 f.flag + "</svg>" : "") + "</span>" +
                  '<a class="ra-tw-c" href="' + BASE + "country/" +
                  row.cc.toLowerCase() + '/">' + esc(CNAME[row.cc] || row.cc) +
                  "</a>" +
                  '<span class="ra-tw-src' + (isAr ? " ra-tw-src-ar" : "") +
                  '" title="' + esc(isAr
                     ? T("Counted in a family archive held here")
                     : T("People notable enough for an encyclopaedia")) + '">' +
                  (isAr ? esc(T("archive")) : esc(T("notable"))) + "</span>" +
                  '<span class="ra-tw-band">');
          /* PLACED ON THE SCALE, NOT GROWN INTO IT. The first version used
             flex-grow, the way the ground band does, and it broke in a way
             worth recording: flex-grow only shares out FREE space, and once
             six rows of labels have taken their natural widths there is none
             left. Latvia's single 1920s decade rendered as nothing at all,
             Croatia's was pushed off the right edge, and the proportions —
             the entire content of the drawing — quietly stopped being true.

             The ground band gets away with it because it is ONE row of
             consecutive eras with no gaps. These are several rows that have
             to line up with each other: the same decade must sit at the same
             x on Germany's row and on Latvia's, or reading down the stack
             says nothing. So each run is positioned on the shared 1880s–1990s
             scale by percentage. A gap is then simply the space nobody
             occupies, which is also what it means. */
          runs.forEach(function (g) {
            var a = g[0], b = g[g.length - 1];
            var L = ((a - lo) / span) * 100;
            var W = ((b - a) / span) * 100;
            var label = a === b ? a + "s" : a + "s\u2013" + b + "s";
            wh.push('<span class="ra-tl-seg ra-tw-seg' +
                    (isAr ? " ra-tw-seg-ar" : "") + '" style="--seg:' + tint +
                    /* The LAST decade sits at 100%, where a 52px minimum
                       hangs entirely past the clip — Blažević's Lithuanian
                       2000s rendered at x=1157 in a 1157px band, which is to
                       say nowhere. min() holds any segment back far enough to
                       show itself without moving the ones that fit. */
                    ";left:min(" + Math.max(0, Math.min(100, L)).toFixed(2) +
                    "%, 100% - 52px);width:" + Math.max(W, 0).toFixed(2) +
                    '%" title="' +
                    esc(label + " \u2014 " + (CNAME[row.cc] || row.cc)) + '">' +
                    '<span class="ra-tl-y">' + esc(label) + "</span></span>");
          });
          wh.push("</span></div>");
        });
        if (rows.length > 14)
          wh.push('<p class="cap">' + esc(T("and") + " " + (rows.length - 14) + " " +
                  T("more countries")) + "</p>");
        if (cc0.length)
          wh.push('<p class="ra-tw-axis"><span>' + lo + "s</span><span>" + hi +
                  "s</span></p>");
        /* The file's own warning, in its own words, because a row of ticks
           looks like a census and is nothing of the kind. */
        /* THE CAPTION NAMED ONE SOURCE AND THERE ARE NOW TWO, with different
           biases, and saying so is the whole reason they are drawn apart. */
        wh.push('<p class="cap ra-tw-c2">' + esc(T("Rows marked ") ) +
                '<b>' + esc(T("notable")) + "</b>" +
                esc(T(" are people notable enough for an encyclopaedia — not a " +
                      "census, and thin before 1900. Rows marked ")) +
                '<b>' + esc(T("archive")) + "</b>" +
                esc(T(" are counts of ordinary people from this project's own " +
                      "family archives, which reach further back and only where " +
                      "a family has been researched. Both are evidence that the " +
                      "name was borne in a place at a time; neither is how common " +
                      "it was.")) + "</p>");
        wh.push("</div>");
        h.push(wh.join(""));
      }

      /* `same` SUPPRESSES THE LINK, NOT THE BRANCH. Written as
         `if (r.pg && !same)`, a name that HAS a page and is the exact thing
         searched fell through to the else — which is the message for the
         thirty-nine names in forty that have none. Lerena has a page and was
         being told it did not. The condition on the branch is whether a page
         exists; whether to print a second link to it is a separate question,
         and it is no because the heading row above already carries it. */
      if (r.pg) {
        var slug = same ? "" : nameSlug(r.n);
        if (slug)
          h.push('<p class="ra-go"><a href="' + BASE + "surname/" + slug +
                 '/">Everything about ' + esc(r.n) + " &#8594;</a></p>");
      } else {
        /* AND THE THIRTY-NINE IN FORTY THAT HAVE NO PAGE NOW GO SOMEWHERE
           TOO. They used to stop here, which is where most searches land —
           the panel said what the register knew and then offered nothing to
           click. /surname/ answers for any name in the corpus off the same
           shard this panel just read, so there is a destination without
           900,000 pages of one line each. */
        h.push('<p class="ra-go"><a href="' + BASE + "surname/?q=" +
               encodeURIComponent(r.n) + '">What the registers say about ' +
               esc(r.n) + " &#8594;</a></p>");
      }

      /* Everything but the phonetic guess counts as evidence here, which
                 now includes the spelling tier: one systematic substitution
                 between two names that are both independently attested. */
      var cur = r.variants.filter(function (v) { return v.how !== "sounds"; });
      var snd = r.variants.filter(function (v) { return v.how === "sounds"; });
      /* NOT TWICE. The heading row now carries the attested spellings the way
         a place's does — «de Franceschi · 17 countries · also written De
         Franceski» — so printing them again four lines down is the «arent we
         showing the same thing 2 different ways» this panel has been told off
         for before. The by-sound row below stays: it is a different claim,
         labelled as a guess, and the heading deliberately never carries it. */
      if (cur.length && !same)
        h.push('<p class="ra-vars"><span class="ra-tag">also written</span> ' +
               cur.map(function (v) { return "<em>" + esc(v.n) + "</em>"; }).join(" · ") + "</p>");
      if (snd.length)
        h.push('<p class="ra-vars ra-weak"><span class="ra-tag">the same name by sound, ' +
               'not by a record</span> ' +
               snd.slice(0, 8).map(function (v) { return esc(v.n); }).join(" · ") + "</p>");

      /* THREE QUESTIONS, NOT ONE. «Attested in» was answering all of them at
         once and therefore none of them clearly: where a name is BORNE today,
         where a record NAMES it, and where it CAME FROM. They take different
         evidence and deserve different sentences. */
      /* THE SPELLINGS' COUNTRIES BELONG HERE TOO, AND WERE MISSING.
         David, on Defranceski: «poland is in reality the real name origin» —
         and the panel did not list Poland, while the flag cards did. Neither
         was lying. Poland is attested for DEFRANCESCHI, which is a `spelling`
         variant of Defranceski: the same name, one clerk's letter apart. The
         map has lit countries that way for a while (see VARIANT_OK below);
         this list was still reading the one record and so answered «where is
         this exact spelling attested» to a reader asking «where is my name».

         Sounds-alike variants stay out, here as everywhere. They are an
         algorithm's guess, and folding them in is how «attested» quietly
         becomes «rhymes with». Every country that arrives by a spelling is
         labelled with the spelling that brought it, so the claim on screen is
         the claim the data supports. */
      var VOK = { curated: 1, grammar: 1, spelling: 1 };
      var seenCC = {}, merged = [];
      r.countries.forEach(function (c) { seenCC[c.cc] = 1; merged.push(c); });
      (r.variants || []).forEach(function (v) {
        if (!VOK[v.how]) return;
        var fv = fold(v.n), rec = null;
        Object.keys(scache).forEach(function (k) {
          (scache[k] || []).forEach(function (x) {
            if (!rec && fold(x.n) === fv) rec = x; });
        });
        if (!rec) return;
        (rec.countries || []).forEach(function (c) {
          if (seenCC[c.cc]) return;
          seenCC[c.cc] = 1;
          merged.push({ cc: c.cc, how: c.how, by: c.by, n: c.n, via: v.n });
        });
      });

      var byHow = {};
      merged.forEach(function (c) { (byHow[c.how] = byHow[c.how] || []).push(c); });
      var linkCC = function (list, withN) {
        return list.map(function (c) {
          return '<a href="' + BASE + "country/" + c.cc.toLowerCase() + '/">' +
                 esc(CNAME[c.cc] || c.cc) + "</a>" +
                 (withN && c.n ? ' <span class="ra-who">' + c.n.toLocaleString() +
                                 "</span>" : "") +
                 /* «as Defranceschi» — without it the reader cannot tell which
                    spelling the country actually came from, and the list would
                    be making a slightly bigger claim than the data does. */
                 (c.via ? ' <span class="ra-who">as ' + esc(c.via) + "</span>" : "");
        }).join(" · ");
      };

      /* THE RESEARCHED CLAIM LEADS, NOT THE STATISTICAL ONE. «Borne in» came
         first and read as «born in», which it does not mean — and for D'Arcy
         it put «Poland 6» at the top of the panel, because Poland's is the
         only one of our six national registers with a D'Arcy in it, above 308
         surnames of actual D'Arcy research naming Britain, Ireland and
         Australia. A six-person head-count is not the headline fact about an
         Irish name. A document naming the family on the ground is. */
      var found = (byHow.archive || []).concat(byHow.curated || []);
      if (found.length) {
        h.push('<p class="ra-filed"><span class="ra-tag">found in records here</span> ' +
               linkCC(found, false) + "</p>");
        h.push('<p class="ra-note">A family archive or a catalogue names this surname ' +
               "on that ground — a document, not a head-count. Narrower evidence than " +
               "a register, usually much older, and the reason this map exists.</p>");
      }

      if (byHow.register) {
        h.push('<p class="ra-filed"><span class="ra-tag">counted in a national ' +
               'register</span> ' + linkCC(byHow.register, true) + "</p>");
        h.push('<p class="ra-note">How many people of that name a state counted — ' +
               "the closest thing here to «where the name is now». This map holds " +
               "registers for six countries only, so a small number in one of them " +
               "says more about which registers we have than about the name.</p>");
      }
      if (byHow.grammar || byHow.sounds) {
        h.push('<p class="ra-filed ra-weak"><span class="ra-tag">a form of the name</span> ' +
               linkCC((byHow.grammar || []).concat(byHow.sounds || []), false) + "</p>");
      }

      /* ORIGIN, and the only kind this map will assert. */
      if (r.places && r.places.length) {
        h.push('<p class="ra-filed"><span class="ra-tag">also a place</span> ' +
               r.places.map(function (pl) {
                 var how = pl.via === "name" ? ""
                   : pl.via === "variant" ? " — a spelling of the name"
                   : " — but only a phonetic neighbour, not a spelling";
                 return "<b>" + esc(pl.n) + "</b>" +
                        (pl.cc ? " <span class=\"ra-who\">" + esc(CNAME[pl.cc] || pl.cc) +
                                 (pl.pop ? ", pop. " + pl.pop.toLocaleString() : "") +
                                 esc(how) + "</span>" : "");
               }).join(" · ") + "</p>");
        h.push('<p class="ra-note"><b>This is as close to an origin as this map will ' +
               "go.</b> A surname that is also a place name often came from it — and " +
               "often did not: plenty are occupations or patronymics that happen to " +
               "collide, and plenty of places are named after a family rather than " +
               "the other way round. It is a fact with a source, which is more than " +
               "an etymology page offers.</p>");
      } else {
        h.push('<p class="ra-note">No place of this name is in the gazetteer, so this ' +
               "map says nothing about where the name came from. Search anywhere else " +
               "and you will be told an ORIGIN — that it is Latin, or Italian, or " +
               "means «joyful». That is etymology, it is usually unsourced, and it is " +
               "a different question from the one this map answers.</p>");
      }

      if (r.countries.length) {
        h.push('<p class="ra-note">Every one of these means the name appears in a ' +
               "dataset held here — never that it exists in those countries and " +
               "nowhere else. The blanks on this map are gaps in it, as always.</p>");
      } else {
        h.push('<p class="ra-note">No country attested yet. The name is known; where it ' +
               "is found is not, which is a gap in this map rather than in the world.</p>");
      }
      h.push("</div>");
    });
    return h.join("");
  }

  /* The worldwide gazetteer, fetched three letters at a time and kept.
     48,906 places and 212,101 names they have been written under — enough to
     answer "the name changed" for the whole earth, which is the one of the
     three problems that does not need a shelf to solve. */
  var gcache = {}, gmark = null;
  async function gazetteer(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in gcache)) {
      try { gcache[key] = await (await fetch(GAZ + key + ".json")).json(); }
      catch (e) { gcache[key] = []; }
    }
    var hit = [];
    gcache[key].forEach(function (r) {
      var fn = fold(r[0]);
      var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
      if (m === null) {
        /* r[5] is every form the place has ever been written in, folded and
           space-joined — not the curated display list, which is missing the
           very names people type. */
        var best = null;
        (r[5] || "").split(" ").forEach(function (fa) {
          var v = fa === f ? 3 : fa.indexOf(f) === 0 ? 4 : fa.indexOf(f) > -1 ? 5 : null;
          if (v !== null && (best === null || v < best)) best = v;
        });
        m = best;
      }
      if (m !== null) hit.push([m, r]);
    });
    /* An exact hit on the current name first, then a prefix, then an exact hit
       on a FORMER name — and the shard is already in population order, which
       is the right tie-break: somebody typing Czernowitz means Chernivtsi, not
       a suburb of Brno that kept the same name. */
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return hit.slice(0, 8).map(function (x) { return x[1]; });
  }

  /* Settlements inside a record region that hold no volumes here. They are
     not drawn — 8,352 grey dots would bury the 2,128 that carry something —
     but a reader holding a village name still gets the answer they came for,
     because the region knows whose archive held that ground. */
  var setcache = {};
  async function settlements(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in setcache)) {
      try { setcache[key] = await (await fetch(SETT + key + ".json")).json(); }
      catch (e) { setcache[key] = []; }
    }
    return setcache[key].filter(function (r) {
      return fold(r.n).indexOf(f) > -1;
    }).slice(0, 4);
  }

  /* Districts — the rung records are filed at, for the 17,320 of them no
     collection names. Undrawn on purpose; still the answer to "where is Kreis
     Bomst", which is a question this atlas should never have to refuse. */
  var dcache = {};
  async function districts(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in dcache)) {
      try { dcache[key] = await (await fetch(DIST + key + ".json")).json(); }
      catch (e) { dcache[key] = []; }
    }
    var hit = [];
    dcache[key].forEach(function (r) {
      var fn = fold(r.n);
      var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
      if (m !== null) hit.push([m, r]);
    });
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return hit.slice(0, 4).map(function (x) { return x[1]; });
  }

  /* WHERE A NAME IS FOUND, DRAWN. A surname search used to produce a list of
     country links and leave the map showing whatever it was showing — which
     is the one thing a map is for and the one thing this did not do. Outlines
     are fetched one country at a time from c/, so answering «Lerena» costs
     four small files and nothing at all for anyone who never searches a name. */
  var ccache = {}, ctryLayer = L.layerGroup();

  /* ---- A NAME AT THE GRAIN OF A TOWN -------------------------------------
     Shading a country is the most a national register supports, and for ten
     of the eleven registers here it is the honest maximum. Belgium counts
     every surname in each of its 565 communes, so for a Belgian name this
     map can do what the whole atlas is for: put the answer on the ground.

     Fetched only when a name has matched, from its own shards, so a search
     that has nothing to do with Belgium never pays for it. */
  var bcache = {}, communeLayer = L.layerGroup(), communeBox = null;
  /* The same three-character shard rule as the search corpus — see
     build.py, which tried four to split the Belgian «Van » names and put
     it back rather than keep two rules in step by hand. */
  async function communes(name) {
    var f = fold(name), key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return null;
    if (!(key in bcache)) {
      try { bcache[key] = await (await fetch(BSURN + key + ".json")).json(); }
      catch (e) { bcache[key] = null; }
    }
    var sh = bcache[key];
    if (!sh || !sh.n || !sh.n[f]) return null;
    var row = sh.n[f];
    /* [index, count] against the shard's own commune table, so each
       commune's name and coordinates are written once per file. */
    return [row[0].map(function (p) {
      var c = sh.c[p[0]];
      return [c[0], c[1], p[1], c[2]];
    }), row[1], row[2]];
  }

  function showCommunes(rec, label) {
    communeLayer.clearLayers();
    communeBox = null;
    if (!rec) return null;
    var rows = rec[0], total = rec[1], people = rec[2];
    if (!map.hasLayer(communeLayer)) communeLayer.addTo(map);
    var top = rows.reduce(function (a, r) { return Math.max(a, r[2]); }, 1);
    rows.forEach(function (r) {
      /* Sized like the shelf dots, so the two layers read as one map. A
         commune is a place a state counted people in, which is a firmer
         claim than anything else drawn here, and it is drawn solid. */
      L.circleMarker([r[0], r[1]], {
        radius: Math.min(3 + Math.sqrt(r[2]) * 0.9, 14),
        color: "#fff", weight: 0.8, opacity: .9,
        fillColor: "#1E8449", fillOpacity: .8
      }).bindTooltip(esc(r[3]) + " — " + r[2].toLocaleString() + " " +
                     esc(label), { sticky: true }).addTo(communeLayer);
    });
    communeBox = L.latLngBounds(rows.map(function (r) {
      return [r[0], r[1]];
    }));
    return { drawn: rows.length, total: total, people: people };
  }
  async function outline(cc) {
    var k = (cc || "").toLowerCase();
    if (!k) return null;
    if (!(k in ccache)) {
      try { ccache[k] = await (await fetch(CTRY + k + ".json")).json(); }
      catch (e) { ccache[k] = null; }
    }
    return ccache[k];
  }
  /* HOW THIS COUNTRY CAME TO BE LIT, drawn rather than merely listed. A name
     found in a national register of 1,575 people and a name found because
     somebody walked a parish archive are not the same claim, and the first cut
     of this shaded them identically — Spain and Croatia the same colour, the
     same weight, the same everything.
     A register is a solid outline: a state counted these people. An archive is
     a dashed one: one researcher found this name on this ground, which is a
     narrower and more human kind of evidence, and the map should not dress it
     up as a census. */
  var EVID = {
    register: { color: "#1E8449", dash: null,
                say: "a national register counted it" },
    archive:  { color: "#8E6FA8", dash: "5 4",
                say: "a family archive found it on this ground" },
    grammar:  { color: "#B08322", dash: "2 4",
                say: "a grammatical form of the name" },
    curated:  { color: "#3C5A8A", dash: null, say: "a curated link" },
    sounds:   { color: "#7C8A91", dash: "1 5", say: "a phonetic neighbour" }
  };

  /* WHERE THE NAME IS FIRST ATTESTED, WHICH IS NOT THE SAME AS WHERE IT CAME
     FROM, and the difference matters enough to name. David: «i want the map
     to start by zooming into the country of origin». Fitting to every
     attested country is what the map did, and for a name in ten of them it
     framed Argentina to Australia and dropped the reader in the Atlantic —
     the same failure the comment at fitBounds already describes for Peeters.

     THE ARCHIVE TIMELINE WINS OVER THE NOTABLE ONE. `tla` is this project's
     own family archives — ordinary people in parish registers — and `tl` is
     Wikidata's notable births, which are thin before 1900 and biased towards
     whichever country writes encyclopaedias. Defrančeski has only tla,
     {HR: [1920]}, and Croatia is the right answer. Falco has only tl and its
     earliest is DE 1590 for a name that is plainly Italian, which is exactly
     why this is labelled «first attested» everywhere it is shown and never
     «origin»: the atlas knows when a name turns up in a record it holds, and
     that is a different and smaller fact. */
  /* THE MAP OPENS ON THE ORIGIN. David: «I want you to default the map
     country to the origin country when we select a surname». The derived
     origin weighs the register share, the earliest record, the language the
     name is in and the spelling together — where first-attested was one of
     those on its own and put Falco in Germany on the strength of a single
     1590 birth. Falls back to first-attested for the 20% with no derived
     origin, and to the old fit-everything for the rest. */
  function originCC(r) {
    if (r && r.or && r.or.cc) return { cc: r.or.cc, from: "origin" };
    var fa = firstAttested(r);
    return fa ? { cc: fa.cc, from: "first" } : null;
  }

  function firstAttested(r) {
    var best = null;
    ["tla", "tl"].forEach(function (k) {
      if (best || !r || !r[k]) return;
      Object.keys(r[k]).forEach(function (cc) {
        var ds = (r[k][cc] || []).filter(function (d) { return +d; });
        if (!ds.length) return;
        var lo = Math.min.apply(null, ds);
        if (!best || lo < best.year) best = { cc: cc, year: lo, src: k };
      });
    });
    return best;
  }

  async function showCountries(list, stale, origin) {
    if (list && list.length) { searchHit = true; noteSearch(); retireVisit(); }
    litFor = fold(qbox.value.trim());
    /* THE FLAG CARDS FOLLOW THE SURNAME, NOT THE TEXT. David: «when I search
       Defranceski I don't see flags below, even though we know which countries
       a name is found in and we show it on the map.» Quite right — the cards
       were filtering on the typed string against country names, regions, hubs
       and crowns, and a surname is none of those, so a name search emptied a
       section the map had just answered. The countries lit here ARE the
       answer; the cards now take them directly. */
    drawFlagResForCountries((list || []).map(function (x) {
      return String(x.cc || x).toUpperCase(); }));
    /* Clears its own outlines and NOT the commune dots. It used to clear
       both, which was invisible until the dots started being drawn first
       — showCommunes ran, drew 60 towns, and this wiped them a
       millisecond later. Each layer is cleared by whoever fills it, and
       by the search that starts a new question. */
    ctryLayer.clearLayers();
    if (!list.length) return;
    /* TEN WAS AN ARBITRARY NUMBER AND IT CONTRADICTED THE CARDS. The flag
       cards below take this same list whole, so a name attested in sixteen
       countries got sixteen cards and ten outlines, and the six that lost the
       coin toss — Poland among them for Defranceski — looked like countries
       the atlas had never heard of. Whatever the evidence supports gets drawn;
       the cap that remains is there because each outline is a fetch. */
    var got = await Promise.all(list.slice(0, 40).map(function (x) {
      return outline(x.cc || x);
    }));
    if (stale && stale()) return;
    var box = null, originBox = null;
    got.forEach(function (c, i) {
      if (!c) return;
      var e = EVID[(list[i] || {}).how] || EVID.register;
      L.polygon(c.rings.map(function (r) {
        return r.map(function (p) { return [p[1], p[0]]; });
      }), { color: e.color, weight: e.dash ? 2.2 : 1.6, opacity: .9,
            dashArray: e.dash, fillColor: e.color, fillOpacity: .10,
            interactive: false })
        .addTo(ctryLayer);
      var b = L.latLngBounds([c.box[0], c.box[1]], [c.box[2], c.box[3]]);
      box = box ? box.extend(b) : b;
      if (origin && (list[i] || {}).cc === origin.cc) originBox = b;
    });
    if (!map.hasLayer(ctryLayer)) ctryLayer.addTo(map);
    if (!map.hasLayer(communeLayer)) communeLayer.addTo(map);
    /* THE SHARPEST ANSWER FRAMES THE MAP.
       Searching «Peeters» lit Spain, France, Poland and the United States,
       fitted the map to all four and landed the reader in the middle of
       the Atlantic — while 411 Belgian communes, the only place-level
       answer on the map, sat unframed off the edge. Country outlines are
       context; towns a state counted people in are the answer, so when
       there are towns they decide the view. */
    /* The earliest-attested country frames the map when there is one, because
       that is the ground a reader is actually asking about; the rest stay
       drawn and lit, so nothing is hidden, they are simply not what the view
       is centred on. Register towns still win over both — a town a state
       counted people in is a sharper answer than a whole country. */
    if (communeBox) map.fitBounds(communeBox, { padding: [40, 40], maxZoom: 9 });
    else if (origin && originBox) map.fitBounds(originBox, { padding: [30, 30], maxZoom: 6 });
    else if (box) map.fitBounds(box, { padding: [30, 30], maxZoom: 7 });
  }

  /* Irish townlands. Undrawn — 60,883 dots would bury Ireland — but a townland
     is the unit an Irish record actually names, and the county and civil parish
     that come back with it are the whole answer: «Glebe» is 213 different
     places and is not an address until you know which. */
  var tcache = {};
  async function townlands(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in tcache)) {
      try { tcache[key] = await (await fetch(TOWN + key + ".json")).json(); }
      catch (e) { tcache[key] = []; }
    }
    var hit = [];
    tcache[key].forEach(function (r) {
      var fn = fold(r.n);
      var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
      if (m !== null) hit.push([m, r]);
    });
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return { rows: hit.slice(0, 6).map(function (x) { return x[1]; }),
             total: hit.length };
  }

  /* THE LAST SEARCH TYPED IS THE ONE THAT WINS. Every fetch in here is async
     and a search runs on a 140 ms debounce, so «defranceski» and the earlier
     «defrance» are in flight together and whichever finishes last writes the
     panel. David's screenshot caught it exactly: the box read «defranceski»
     and the panel was headed «defrance», listing Defrance and Defrances —
     right answers to a question already superseded.
     Each run takes a ticket. If a newer one has started by the time this one
     has its data, it drops everything rather than painting over the answer. */
  var searchTok = 0;

  /* Italian comuni. Undrawn — the province is already a dot and it is the rung
     Antenati files by — but searchable under BOTH names, which is the whole
     point: somebody holding a record that says «Bozen» is holding a record
     about Bolzano and may not know it. */
  var mcache = {};
  async function comuni(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in mcache)) {
      try { mcache[key] = await (await fetch(COMU + key + ".json")).json(); }
      catch (e) { mcache[key] = []; }
    }
    var hit = [];
    mcache[key].forEach(function (r) {
      var forms = [r.n].concat(r.a || []);
      var best = null;
      forms.forEach(function (x) {
        var fx = fold(x);
        var m = fx === f ? 0 : fx.indexOf(f) === 0 ? 1 : fx.indexOf(f) > -1 ? 2 : null;
        if (m !== null && (best === null || m < best)) best = m;
      });
      if (best !== null) hit.push([best, r]);
    });
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return hit.slice(0, 5).map(function (x) { return x[1]; });
  }

  /* Estonian parishes and historic counties. Names only — the archive
     publishes no coordinates and this map will not invent any. */
  var ecache = {};
  async function estonia(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in ecache)) {
      try { ecache[key] = await (await fetch(ESTO + key + ".json")).json(); }
      catch (e) { ecache[key] = []; }
    }
    return ecache[key].filter(function (r) {
      return fold(r.n).indexOf(f) > -1;
    }).slice(0, 4);
  }

  /* Scotland's civil parishes. The unit every Scottish record is filed by —
     the old parish registers, the statutory registers and the censuses all
     use it — and until now typing one returned nothing at all. These carry
     coordinates, so a hit can say where it is rather than only that it
     exists. */
  var sccache = {};
  async function scotland(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in sccache)) {
      try { sccache[key] = await (await fetch(SCOT + key + ".json")).json(); }
      catch (e) { sccache[key] = []; }
    }
    return sccache[key].filter(function (r) {
      return fold(r.n).indexOf(f) > -1;
    }).slice(0, 4);
  }

  /* A RECORD NAMES THE GROUND BY ITS OWN NAME, NOT BY OURS.
     David's Blazevic research has a man from "Kranjska zupa sv. Martin kod
     Krainburg" — Carniola, the parish of St Martin near Kranj, whose German
     name is Krainburg. This atlas HAS that region, with eight eras from
     Inner Austria through the Illyrian Provinces to the Duchy of Carniola,
     and typing any of those words found nothing at all: the regions were
     drawn, shaded and clickable, and never searchable. A jurisdiction layer
     that cannot be reached by the name the record uses is a layer for
     people who already know the answer. */
  function regionsNamed(term) {
    var f = fold(term);
    if (f.length < 3) return [];
    var out = [];
    regions.regions.forEach(function (reg) {
      var names = [reg.label].concat(reg.alt || []);
      var best = null;
      names.forEach(function (n) {
        var fn = fold(n);
        var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
        if (m !== null && (best === null || m < best)) best = m;
      });
      if (best !== null) out.push([best, reg]);
    });
    out.sort(function (a, b) { return a[0] - b[0]; });
    return out.slice(0, 3).map(function (x) { return x[1]; });
  }

  /* A COUNTRY IS MATCHED ON WHOLE WORDS, NOT ON ANY RUN OF LETTERS INSIDE ONE.
     «Krain» is the German name of Carniola, and typing it flew the map to
     Ukraine — because "ukraine".indexOf("krain") is 1. The region's other
     names all worked, so the one that failed was the one hiding inside a
     larger word. A query matches a country when it begins the name or begins
     a word in it: "united" and "kingdom" both find the United Kingdom, and
     "krain" finds neither it nor Ukraine, and falls through to Carniola. */
  function wordHit(hay, needle) {
    if (!hay || !needle) return false;
    var i = hay.indexOf(needle);
    while (i > -1) {
      if (i === 0 || /[^a-z0-9]/.test(hay.charAt(i - 1))) return true;
      i = hay.indexOf(needle, i + 1);
    }
    return false;
  }

  /* `exact` — the reader CHOSE this name from the dropdown, so answer with it
     and not with everything that resembles it. */
  async function elsewhere(term, exact) {
    var mine = ++searchTok;
    /* THE THIRD TIME THIS EXACT BUG. David searched «blazevic», the panel
       said «No places of that name here yet» — correctly — and the right-hand
       pane went on offering a fifteen-item visit to St Blazey in Cornwall,
       parishes, cemeteries, numbered pins and all, left over from an earlier
       pick. retireVisit() was wired into the branches that answer with several
       places and with a country, and not into this one, which is the branch
       that answers when there is no place at all. Every path that stops
       describing a chosen place has to say so. */
    retireVisit();
    /* TYPING A COUNTRY'S NAME SHOULD OPEN THE COUNTRY. David typed «libya» and
       got «Qaṣr Lībiyā», a village whose name happens to contain it, and
       nothing at all about the country — while the country panel, with its
       research guide and its national archive, was one marker click away and
       unreachable by the one thing everybody does first, which is type.
       This runs before everything else: an exact country name is not an
       ambiguous query. */
    var fterm = fold(term);
    var hitCC = null;
    var list = await cptsReady;
    await warchReady;
    /* Awaited, not hoped for. 31 KB alongside the shards; without this the
       FIRST search after a cold load finds COVER still null and prints no
       volumes at all, while every search after it works — the kind of bug
       that never reproduces for the person who wrote it. */
    await coverReady;
    if (mine !== searchTok) return;
    for (var ci = 0; ci < list.length; ci++) {
      var cp = list[ci];
      if (fold(cp.n) === fterm || cp.cc.toLowerCase() === fterm) { hitCC = cp; break; }
    }
    if (hitCC) {
      if (gmark) { map.removeLayer(gmark); gmark = null; }
      ctryLayer.clearLayers();
      communeLayer.clearLayers();
      litCC = null;
      openCountry(hitCC);
      showCountries([{ cc: hitCC.cc, how: "register" }], function () {
        return mine !== searchTok;
      });
      return;
    }
    var stale = function () { return mine !== searchTok; };
    /* EVERY SEARCH STARTS FROM A CLEAN MAP. The gazetteer marker used to be
       removed only when a NEW gazetteer hit replaced it, so typing on past a
       match left the old one behind: «Lere» found a village in Nigeria and
       flew there, and «Lerena» — which matches no place at all — left the map
       in Nigeria with a marker on a village that has nothing to do with the
       name. The panel said «no places of that name here yet» while the map
       said otherwise, and the map is louder. */
    if (gmark) { map.removeLayer(gmark); gmark = null; }
    ctryLayer.clearLayers();
    communeLayer.clearLayers();
    litCC = null;
    var f = fold(term);
    var iso = Object.keys(CNAME).filter(function (k) {
      return wordHit(fold(CNAME[k]), f) || k.toLowerCase() === f;
    });
    var cover = provs.providers.filter(function (p) {
      if (iso.some(function (k) { return (p.countries || []).indexOf(k) > -1; })) return true;
      if (p.at && wordHit(fold(p.at.place), f)) return true;
      return wordHit(fold(p.name), f);
    });
    var hits = await gazetteer(term);
    var names = await surnames(term);
    /* PICKING «Lerena» SHOULD NOT ANSWER WITH LERENARD. David, on the new
       dropdown: «why if i now have "smart" search and i select the exact named
       record do you then still show me all the variation in names?» — because
       selecting ran the same fuzzy search that typing does, and that search
       exists precisely to cast wide when the reader does not yet know which
       spelling they want. Once they have said which, the casting is over: four
       cards for one choice is the search second-guessing the answer it was
       just given. Typing the name and pressing Enter still gets the wide
       list, which is the right behaviour for somebody who has not chosen. */
    if (exact) {
      var fe = fold(term);
      var only = names.filter(function (r) { return fold(r.n) === fe; });
      if (only.length) names = only;
    }
    /* Fetched here with the rest, because the panel is written once
       and a promise landing after it has nowhere to put its line. */
    var beRec = names.length ? await communes(names[0].n) : null;
    if (stale()) return;
    var setts = await settlements(term);
    var dists = await districts(term);
    var tlands = await townlands(term);
    var com = await comuni(term);
    var est = await estonia(term);
    var sct = await scotland(term);
    var regs = regionsNamed(term);
    if (stale()) return;
    /* If the typed word is an OLD name, say which one it matched and what the
       place is called now. "Pressburg → Bratislava" is the whole answer to the
       first of the three problems, and it works in any country on earth. */
    empty.hidden = true; panel.hidden = false;
    /* ONE HEADER, AND THE NAME AS ITS OWNER SPELLS IT.
       This echoed what was typed — «defranceski», lower case, because
       that is how it was keyed — and then renderSurnames printed «The
       name / Defranceski» directly underneath. Two headings for one
       answer, the first of them a transcript of the reader's own
       keystrokes. When the search is an exact surname the canonical
       spelling is the better title, and the card below drops its
       duplicate. */
    var canon = null;
    if (names.length && fold(names[0].n) === fold(term)) canon = names[0].n;
    /* THE SAME HEADING ROW A PLACE GETS. Senj's reads «Senj (Senj) · 10
       volumes · also written Segna · Segno · Senia · Zengg · Read more about
       Senj → · [page] [flag]». A name's read «de Franceschi» and nothing else,
       and then repeated the spellings and the page link further down the card
       as two more labelled rows. Same furniture, same line, same order —
       a count, the other spellings, the page, the icons. */
    var nrow = names.length ? names[0] : null;
    var h = ['<div class="at-h"><h3>' + esc(canon || term) + "</h3>"];
    if (nrow) {
      var nccs = (nrow.countries || []).length;
      if (nccs)
        h.push('<span class="at-n">' + nccs + " " +
               esc(T(nccs === 1 ? "country" : "countries")) + "</span>");
      /* Only the attested spellings, never the by-sound guesses: the place
         header lists names a record actually uses, and the phonetic
         neighbours stay where they are labelled as guesses. */
      var nalso = (nrow.variants || []).filter(function (v) {
        return v && fold(v.n || v) !== fold(nrow.n);
      }).map(function (v) { return v.n || v; }).slice(0, 6);
      if (nalso.length)
        h.push('<span class="at-also">' + esc(T("also written")) + " " +
               nalso.map(function (x) { return "<em>" + esc(x) + "</em>"; })
                    .join(" \u00b7 ") + "</span>");
      if (nrow.pg) {
        h.push('<a class="at-go" href="' + BASE + "surname/" +
               nameSlug(nrow.n) + '/">' + esc(T("Read more about") + " " + nrow.n) +
               " &rarr;</a>");
        /* The flag icon takes the country the band opens on — the earliest
           attestation — because that is the ground this name is first on. */
        var nflagcc = null;
        if (nrow.tl) {
          var tks = Object.keys(nrow.tl);
          tks.sort(function (a, b) { return nrow.tl[a][0] - nrow.tl[b][0]; });
          nflagcc = tks[0];
        }
        h.push(goIcons(BASE + "surname/" + nameSlug(nrow.n) + "/",
                       T("Everything about") + " " + nrow.n + " \u2014 its own page",
                       nflagcc, nrow.n));
      }
    }
    h.push("</div>");
    if (names.length) {
      h.push(renderSurnames(names, term));
      /* The strongest evidence for a country wins its outline. A name in both
         a register and an archive is drawn as a register — the stronger claim
         is the true one, and the panel lists both anyway. */
      var lit = [], seen = {};
      var STRONG = ["register", "curated", "archive", "grammar", "sounds"];
      function light(list) {
        (list || []).forEach(function (c) {
          var was = seen[c.cc];
          if (was === undefined) { seen[c.cc] = lit.length; lit.push({cc: c.cc, how: c.how}); }
          else if (STRONG.indexOf(c.how) < STRONG.indexOf(lit[was].how)) lit[was].how = c.how;
        });
      }
      /* Drawn before the outlines, because showCountries decides the
         view and needs to know whether there is anything sharper. */
      var be = showCommunes(beRec, names[0].n);
      names.forEach(function (r) { light(r.countries); });
      litCC = {};
      /* THE SPELLINGS COUNT TOO, AND THEY WERE NOT COUNTING.
         «One card per cluster» folds Blazevich and Blaževič into the
         Blažević card, which is right for the panel and was quietly wrong
         for the map: only the representative's countries were lit, so a
         search for a name showed where THAT spelling is counted and not
         where the name is. The clerk's choice of letter is exactly what a
         researcher does not know.
         Sounds-alike variants are left out. They are an algorithm's guess,
         the panel says so, and lighting a country on one would put a
         family in Poland because a machine thought two names rhymed. */
      var VARIANT_OK = { curated: 1, grammar: 1, spelling: 1 };
      var byName = {};
      names.forEach(function (r) { byName[fold(r.n)] = 1; });
      var extra = [];
      names.forEach(function (r) {
        (r.variants || []).forEach(function (v) {
          if (!VARIANT_OK[v.how]) return;
          var fv = fold(v.n);
          if (byName[fv]) return;
          byName[fv] = 1;
          extra.push(fv);
        });
      });
      if (extra.length) {
        var pool = [];
        Object.keys(scache).forEach(function (k) {
          (scache[k] || []).forEach(function (r) { pool.push(r); });
        });
        pool.forEach(function (r) {
          if (extra.indexOf(fold(r.n)) > -1) light(r.countries);
        });
      }
      lit.forEach(function (c) { litCC[c.cc] = 1; });
      syncCountryDots();
      showCountries(lit, stale);

      /* And where a state counted by town rather than by country, draw
         the towns. Belgium is the only one, and the panel says so — a
         reader seeing Belgium in dots and France in a wash must not read
         that as a fact about the name. */
      if (be) {
        h.push('<p class="ra-note"><b>' + esc(names[0].n) +
          " in Belgium, by commune.</b> " + be.people.toLocaleString() +
          " people in " + be.total + " of Belgium's 565 communes" +
          (be.drawn < be.total ? ", the " + be.drawn + " biggest drawn"
                               : "") +
          ". Statbel counts every surname in every commune, and no other " +
          "register here counts below the country — so this layer is " +
          "Belgium alone, and a country drawn as a wash is a gap in what " +
          "states publish, not in the name.</p>");
      }
    }
    /* A village inside a mapped region: no shelf, but a jurisdiction answer,
       which is the thing this map is actually for. */
    setts.forEach(function (r) {
      var reg = REGION[r.r];
      if (!reg) return;
      var e = year ? eraAt(reg, year) : null;
      h.push('<div class="ra-juris"><div class="lab">A place in a mapped region</div>');
      h.push('<p><a href="#" class="ra-goto" data-y="' + r.y + '" data-x="' + r.x +
             '" data-n="' + esc(r.n) + '"><b>' + esc(r.n) + "</b></a> — " +
             esc(CNAME[r.k] || r.k) +
             ', in <a href="' + BASE + "region/" + esc(r.r) + '/">' +
             esc(reg.label) + "</a>.</p>");
      if (e) {
        h.push('<p class="ra-filed">In ' + year + " this was <b>" + esc(e.polity) +
               "</b>" + (e.filedUnder.length ? ", and records of that period are filed under " +
               e.filedUnder.map(function (x) {
                 return PROV[x] ? esc(PROV[x].name) : esc(x); }).join(" · ") : "") + ".</p>");
      } else {
        h.push('<p class="ra-filed">No volumes here yet — but the ground is mapped. ' +
               '<a href="#" class="ra-setyear">Set a year</a> and this will say whose ' +
               "empire held it, and therefore whose archive holds the paper.</p>");
      }
      h.push("</div>");
    });
    /* An Estonian parish or historic county. */
    if (est.length) {
      h.push('<div class="ra-juris"><div class="lab">In the Estonian filing system</div>');
      est.forEach(function (r) {
        h.push("<p><b>" + esc(r.n) + "</b> — " +
               (r.k === "parish"
                 ? "a <b>kihelkond</b>, the parish Estonian church records are filed by"
                 : "a historic county of the Baltic governorates") + "</p>");
      });
      h.push('<p class="ra-note">Before 1866 the civil administration filed by MANOR ' +
             "rather than by parish, and the revision lists that name a whole household " +
             "at once are arranged that way — so an Estonian line has two filing systems " +
             "over it, and the first question about any record is which one it came out " +
             "of. Some of these counties are in LATVIA today: the governorate boundary " +
             "did not follow the modern one.</p>");
      h.push("</div>");
    }
    /* THE GROUND ITSELF, under whichever name the record used. */
    if (regs.length) {
      h.push('<div class="ra-juris"><div class="lab">Whose archive this ground was</div>');
      regs.forEach(function (reg) {
        var eras = (reg.eras || []).length;
        h.push("<p><b>" + esc(reg.label) + "</b>" +
               (reg.alt && reg.alt.length
                 ? ' <span class="ra-who">also written ' +
                   esc(reg.alt.slice(0, 4).join(", ")) + "</span>" : "") +
               " — " + eras + " era" + (eras === 1 ? "" : "s") +
               ' on this ground. <a href="' + esc(BASE) + "region/" +
               esc(reg.id) + '/">who held it, and when</a>' +
               ' · <a href="#" class="ra-setyear">set a year</a></p>');
      });
      h.push('<p class="ra-note">A record names the ground by the name it had at ' +
             "the time. Kranjska, Krain and Krainburg are all Carniola; Küstenland " +
             "is the Austrian Littoral. The era table says which archive held the " +
             "paper in the year you care about, which is a different question from " +
             "which country the ground is in now.</p>");
      h.push("</div>");
    }
    /* A Scottish civil parish. */
    if (sct.length) {
      h.push('<div class="ra-juris"><div class="lab">In the Scottish filing system</div>');
      sct.forEach(function (r) {
        h.push("<p><b>" + esc(r.n) + "</b> — a <b>civil parish</b>" +
               (r.c ? ", parish number " + esc(r.c) : "") +
               (r.y != null ? ' <a href="#" class="ra-goto" data-y="' + r.y +
                 '" data-x="' + r.x + '">show on the map</a>' : "") + "</p>");
      });
      h.push('<p class="ra-note">Scotland files by civil parish and by nothing else: ' +
             "the old parish registers before 1855, the statutory registers after it, " +
             "and every census in between. The parish number is the one ScotlandsPeople " +
             "indexes by, so it is the fastest thing to search with. Parish boundaries " +
             "were redrawn in 1891 and a name can sit in two counties either side of " +
             "that, which is why a search that finds nothing is worth trying under the " +
             "older county.</p>");
      h.push("</div>");
    }
    /* An Italian comune, found under either of its names. */
    if (com.length) {
      h.push('<div class="ra-juris"><div class="lab">An Italian comune</div>');
      com.forEach(function (r) {
        var other = (r.a || []).filter(function (x) { return fold(x) !== fold(r.n); });
        h.push("<p><b>" + esc(r.n) + "</b>" +
               (other.length ? " — officially also <b>" + other.map(esc).join(" · ") +
                               "</b>" : "") +
               (r.p ? '<br><span class="ra-who">Provincia di ' + esc(r.p) +
                      (r.r ? ", " + esc(r.r) : "") +
                      " — the province is the rung the state archives and Antenati " +
                      "file by</span>" : "") + "</p>");
      });
      h.push("</div>");
    }
    /* A townland. The county and civil parish are the answer, not the trimming:
       the civil parish is what Griffith's Valuation and the registration
       districts are arranged by, so it is the word to search next. */
    if (tlands.rows && tlands.rows.length) {
      h.push('<div class="ra-juris"><div class="lab">An Irish townland</div>');
      if (tlands.total > tlands.rows.length)
        h.push('<p class="at-sub">' + tlands.total + " townlands carry this name. " +
               "Which one it is depends on the county — that is what a townland " +
               "name alone cannot tell you.</p>");
      tlands.rows.forEach(function (r) {
        /* The civil parish is usually a place this map draws. Offering the
           name without the link made the reader search again for a word this
           panel had just handed them. */
        var cpp = r.cp ? byName[fold(r.cp)] : null;
        h.push('<p><a href="#" class="ra-goto" data-y="' + r.y + '" data-x="' + r.x +
               '" data-n="' + esc(r.n) + '"><b>' + esc(r.n) + "</b></a>" +
               (r.co ? " — County " + esc(r.co) : "") +
               (r.cp ? '<br><span class="ra-who">in the civil parish of ' +
                       (cpp ? '<a href="' + BASE + "place/" + esc(cpp) + '/"><b>' +
                              esc(r.cp) + "</b></a>" : "<b>" + esc(r.cp) + "</b>") +
                       (r.bar ? ", barony of " + esc(r.bar) : "") +
                       " — the unit Griffith's Valuation and the registration " +
                       "districts are arranged by</span>" : "") + "</p>");
      });
      h.push("</div>");
    }
    /* THE YEAR CONTROL REACHED THE SHELF AND NOT THE NAMES. Somebody who has
       typed a surname, lit four countries and then set 1863 is asking the
       question this atlas exists for — whose archive held that ground in that
       year — and the year control simply ignored them. Every record region
       inside a lit country now answers for the year set. */
    if (year && names.length) {
      var ccLit = {};
      names.forEach(function (r) {
        (r.countries || []).forEach(function (c) { ccLit[c.cc] = true; });
      });
      var eraRows = [];
      regions.regions.forEach(function (rg) {
        if (!(rg.countries || []).some(function (k) { return ccLit[k]; })) return;
        var e = eraAt(rg, year) || erasIn(rg, year, year2)[0];
        if (e) eraRows.push([rg, e]);
      });
      if (eraRows.length) {
        h.push('<div class="ra-juris"><div class="lab">In ' +
               (year === year2 ? year : year + "\u2013" + year2) +
               ", the ground these names sit on</div>");
        eraRows.slice(0, 8).forEach(function (pair) {
          var rg = pair[0], e = pair[1];
          h.push('<p><a href="' + BASE + "region/" + esc(rg.id) + '/">' +
                 esc(rg.label) + "</a> — <b>" + esc(e.polity) + "</b>" +
                 (e.filedUnder.length ? '<br><span class="ra-who">filed under ' +
                   e.filedUnder.map(function (x) {
                     return PROV[x] ? esc(PROV[x].name) : esc(x); }).join(" · ") +
                   "</span>" : "") + "</p>");
          if (e.note && e.note.indexOf("THE TRAP") === 0)
            h.push('<p class="ra-note">' + esc(e.note) + "</p>");
        });
        if (eraRows.length > 8)
          h.push('<p class="ra-who">…and ' + (eraRows.length - 8) +
                 " more regions in those countries.</p>");
        h.push("</div>");
      }
    }
    /* A district with nothing of its own. Saying which first-level division
       it sits in is not a consolation prize: adm1 is the rung a collection is
       filed at, so it is the word to search next. */
    if (dists.length) {
      h.push('<div class="ra-juris"><div class="lab">An administrative district</div>');
      dists.forEach(function (r) {
        var pp = r.p ? byName[fold(r.p)] : null;
        h.push('<p><a href="#" class="ra-goto" data-y="' + r.y + '" data-x="' + r.x +
               '" data-n="' + esc(r.n) + '"><b>' + esc(r.n) + "</b></a> — " +
               esc(CNAME[r.k] || r.k) +
               (r.p ? ", in " + (pp ? '<a href="' + BASE + "place/" + esc(pp) +
                                      '/">' + esc(r.p) + "</a>" : esc(r.p)) : "") +
               '<br><span class="ra-who">No collection here names this district. ' +
               (r.p ? "Try " + esc(r.p) + ", which is the level they are filed at."
                    : "Try the country.") + "</span></p>");
      });
      h.push("</div>");
    }
    if (hits.length) {
      var top = hits[0];
      gmark = L.circleMarker([top[1], top[2]], {
        radius: 9, color: "var(--accent)", weight: 2, opacity: .9,
        fillColor: "#8E6FA8", fillOpacity: .35, dashArray: "3 3"
      }).addTo(map);
      /* Only fly to a place when the place is what was asked for. A surname
         that happens to begin with the letters of a village is not a request
         to go to the village, and the map jumping there buries the answer. */
      if (!names.length || fold(top[0]) === f)
        map.setView([top[1], top[2]], Math.max(map.getZoom(), 8));
      h.push('<div class="ra-juris"><div class="lab">That name is a place</div>');
      /* TWO PLACES CAN SHARE A NAME AND OFTEN DO. Croatia has two Lovinacs,
         forty kilometres apart, and the panel printed them as two identical
         lines — «Lovinac — Croatia» twice, with nothing to say which was
         which. For somebody deciding which archive to write to that is worse
         than one row, because it looks like a bug and hides a real fork in
         the research. Only the ones that actually collide are marked. */
      var dupe = {};
      hits.slice(0, 5).forEach(function (r) {
        var k = fold(r[0]) + "|" + r[3];
        dupe[k] = (dupe[k] || 0) + 1;
      });
      hits.slice(0, 5).forEach(function (r) {
        var older = r[4].filter(function (a) { return fold(a) !== fold(r[0]); });
        /* «ALSO WRITTEN» IS A CLAIM ABOUT THE PLACE, NOT ABOUT THE SEARCH.
           David typed Mljet and the panel answered «Mljetvine — Bosnia and
           Herz., also written Mljet». Mljetvine is a hamlet 200km inland with
           an EMPTY alias list in the gazetteer: `a: []`, `q: "mljetvine"`.
           Nobody has ever written it Mljet. The panel made the alias up.

           This is how: the typed term used to be pushed to the front of the
           alias list whenever it was not already in it — the stated intent was
           «a form the curated list left out». But the only way a row can
           surface under a term that is NOT among its names is a substring
           match, and a substring is not a spelling. So the rule fired exactly
           when it had no evidence, and never when it did: a term that really
           IS an alias is already in the list, printed from the data.
           It printed a fabricated one for every prefix match, which is the one
           thing this atlas does not do.

           The typed word is now gone from this line entirely. What the row is
           written under comes from the gazetteer or is not said. Why the row
           surfaced is the reader's own word back at them, and it is said as
           that, below, where it cannot be mistaken for a finding. */
        var matchedOn = (fold(r[0]).indexOf(f) > -1 && fold(r[0]) !== f)
                        ? term : "";
        older = older.slice(0, 5);
        var where = dupe[fold(r[0]) + "|" + r[3]] > 1
          ? ' <span class="ra-who">' +
            esc(r[1].toFixed(2) + "\u00b0N " + r[2].toFixed(2) + "\u00b0E") +
            "</span>"
          : "";
        /* AN ISLAND SAYS SO. Without it «Mljet — Croatia» reads as a town,
           and the reader writes to a parish that does not exist. The volumes
           are filed under the villages on it — Babino Polje, Sobra, Goveđari,
           Polače — which are the markers the map has just flown to, so the
           row's job is to explain what they are looking at rather than to
           list them. `r[6]` is only present on rows built after islands were
           admitted; an older shard is six long and reads exactly as before. */
        var isIsland = r[6] === "isl";
        h.push("<p><b>" + esc(r[0]) + "</b> — " +
               (isIsland ? "an island, " : "") + esc(CNAME[r[3]] || r[3]) + where +
               (older.length ? '<br><span class="ra-who">also written ' +
                 older.map(esc).join(" · ") + "</span>" : "") +
               (matchedOn ? '<br><span class="ra-who">contains what you typed, ' +
                 "\u00ab" + esc(matchedOn) + "\u00bb \u2014 it is not another " +
                 "name for it</span>" : "") + "</p>");
      });
      h.push("</div>");
    }
    /* Only worth printing when it adds something. Typing "Ireland" and being
       told "Ireland" is noise; typing "HR" and being told "Croatia" is not. */
    var named = iso.map(function (k) { return CNAME[k]; })
                   .filter(function (n) { return fold(n) !== f; });
    if (named.length)
      h.push('<p class="at-also">' + named.map(esc).join(" · ") + "</p>");
    /* Widen the provider list to the country the gazetteer just landed in —
       somebody who typed Pressburg wants Slovakia's sources, and has not said
       the word "Slovakia" at any point. */
    names.forEach(function (r) {
      r.countries.forEach(function (c) { if (iso.indexOf(c.cc) < 0) iso.push(c.cc); });
      /* AND THE COUNTRIES THE TIMELINE NAMES. These are not always the same
         set: Taylor's band runs «United Kingdom 1570s–2000s» and the UK is not
         in its register-evidence list, so «Where to look» offered Ireland,
         America, Poland and Belgium and not one British archive — under a
         timeline that had just said the name was in Britain for four hundred
         years. If the panel is willing to draw a country on the band it has to
         be willing to say where to read there. */
      Object.keys(r.tl || {}).forEach(function (cc) {
        if (iso.indexOf(cc) < 0) iso.push(cc);
      });
    });
    if (hits.length || names.length) {
      hits.slice(0, 3).forEach(function (r) { if (iso.indexOf(r[3]) < 0) iso.push(r[3]); });
      cover = provs.providers.filter(function (p) {
        if (iso.some(function (k) { return (p.countries || []).indexOf(k) > -1; })) return true;
        if (p.at && fold(p.at.place).indexOf(f) > -1) return true;
        return fold(p.name).indexOf(f) > -1;
      });
    }
    /* A NAME ANSWER DOES NOT OWE A PLACE APOLOGY. David, looking at a surname
       card folded into one 327px column beside two columns of place regret:
       «isnt this about the name, not places, so i wouldnt have places here?»
       The paragraph below is the right thing to say to somebody who typed a
       PLACE this map holds but has never walked volume by volume. Said to
       somebody who typed a NAME it answers a question they did not ask, and
       takes two thirds of the panel to do it. The card above has already said
       where the name was and when; the only thing still worth adding is where
       to go and read — so say that, name it for the name, and stop. */
    if (names.length) {
      if (cover.length) {
        /* ORDERED, AND ORDERED BY SOMETHING A READER CAN SEE. Unsorted, this
           list opened on «Archives communales de Nice» for a name attested
           first in Italy — providers.json order, which is the order rows were
           added and means nothing to anybody reading it. Group by country in
           the order the name's own evidence ranks them, so the list runs
           Italy, Croatia, France, top to bottom, exactly as the timeline
           directly above it does; within a country, by name. */
        var rank = {}, ord = 0;
        /* First the countries the TIMELINE names, in the timeline's own order
           — earliest attestation first — so this opens on Italy for a name
           first seen in Italy in the 1550s, exactly as the band above it does.
           Then everything else the name is attested in, BY COUNTRY NAME. `iso`
           is in ISO-code order, which put Austria above Australia and
           Switzerland above Cuba, and reads — correctly — as not sorted. */
        var tl0 = (names[0] || {}).tl || {};
        Object.keys(tl0).sort(function (a, b) { return tl0[a][0] - tl0[b][0]; })
          .forEach(function (k) { if (rank[k] === undefined) rank[k] = ord++; });
        iso.slice().sort(function (a, b) {
          var A = CNAME[a] || a, B = CNAME[b] || b;
          return A < B ? -1 : A > B ? 1 : 0;
        }).forEach(function (k) { if (rank[k] === undefined) rank[k] = ord++; });
        /* THREE FROM EACH, NOT FOURTEEN FROM THE FIRST. Sorted and capped at
           fourteen rows, this listed fourteen Italian state archives beginning
           with A — Agrigento, Alessandria, Ancona, Arezzo — then "and 351
           more", and never reached Croatia or France at all. A name attested
           in seventeen countries wants a door into each of them, not the
           first page of one country's alphabet. So: three per country, the
           country's own full count on the rule above them, and that rule is
           the link that opens the rest. */
        var byCC = {}, order = [];
        cover.forEach(function (p) {
          var cc = (p.countries || []).filter(function (k) { return rank[k] !== undefined; })
                   .sort(function (a, b) { return rank[a] - rank[b]; })[0] || "";
          if (!byCC[cc]) { byCC[cc] = []; order.push(cc); }
          byCC[cc].push(p);
        });
        order.sort(function (a, b) {
          return (a === "" ? 9999 : rank[a]) - (b === "" ? 9999 : rank[b]);
        });
        /* A CEILING ON THE COUNTRIES, NOT ONLY ON EACH. Taylor is attested
           in thirty-six countries that have an archive here; three apiece is
           a hundred rows, which is a wall, not an answer. The band above
           stops at ten countries for the same reason. Twelve, then a count.
           Applied before the pane is built so the two agree on what is in
           the list and what is behind the country links. */
        var moreCC = 0, moreInCC = 0, shown = 0;
        if (order.length > 12) {
          order.slice(12).forEach(function (cc) { moreCC++; moreInCC += byCC[cc].length; });
          order = order.slice(0, 12);
        }
        order.forEach(function (cc) {
          /* A COUNTRY'S OWN ARCHIVE BEFORE A CROSS-BORDER ONE. Alphabetical
             alone opened Italy on ANNO — the Austrian newspaper archive,
             which carries IT because it covers the Austrian Littoral, and
             which is not what somebody looking for an Italian register should
             be handed first. Antenati is. Fewest countries wins. */
          byCC[cc] = byCC[cc].slice().sort(function (a, b) {
            var d = (a.countries || []).length - (b.countries || []).length;
            return d || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
          });
          shown += Math.min(3, byCC[cc].length);
        });
        /* AND THE LIST ITSELF MOVES TO THE RIGHT PANE, which is the other
           half of what David asked for. Senj's archives are in the pane,
           numbered, with those numbers on the map; Lerena's were a flat list
           at the foot of the panel, unnumbered and unpinned, below the fold.
           Same question, same answer, so: same place.

           The panel keeps what is about the NAME — what it is, where it was,
           whose flag flew there — and the pane keeps where to go and read.
           This line is the door between them, because the pane is shut by
           default and a reader should be told what is behind it rather than
           left to find the handle. */
        var totalCC = order.length + moreCC;
        h.push('<p class="at-sub at-sub-wide">' +
               '<b>' + (shown + moreInCC).toLocaleString() + " " +
               esc(T("archives reach the countries") + " " + (canon || term) + " " +
                   T("is attested in")) + "</b> \u2014 " +
               esc(T("listed in") + " ") +
               '<button type="button" class="ra-open-check">' +
               esc(T("Where to read")) + "</button>" +
               esc(", " + T("numbered, and numbered on the map") + ". " +
                   T("Grouped by country in the order the band above uses") +
                   (moreCC ? ", " + T("the first") + " 12 " + T("of") + " " + totalCC : "") +
                   ". " + T("These are the archives of those COUNTRIES, not of a " +
                            "place of that name.")) + "</p>");
        buildNameCheck(canon || term, byCC, order, rank);
        /* THE VOLUMES, WHICH A NAME CAN HAVE AFTER ALL. David: «why no volume
           data for the name work? we show it really well in the location
           work?» Senj prints «7 books catalogued for this place» and then the
           books themselves. A surname cannot have that list, because a volume
           belongs to a PLACE and no volume in this atlas is indexed by who is
           written inside it — the surname file says so in its own words: «a
           surname in a register's title is a book's subject, not a person».
           Printing a book list under a name would be the map claiming to know
           something it has never opened.

           What it CAN say is how much paper stands in each country the name
           is attested in, and — the part worth having — how much of that
           paper covers the decades the band above just drew. «Italy holds
           1.06M volumes, 41,000 of them in the 1840s–1970s» is a real answer
           to «where do I start», and every number in it is counted rather
           than inferred.

           A country with dated evidence gets the narrowed figure; one with
           none gets the total and is told plainly that it could not be
           narrowed, which is the same admission the band makes one section
           above rather than a different one. */
        if (COVER && names.length) {
          var vrows = [], vAny = false;
          order.forEach(function (cc) {
            if (!cc) return;
            var cv = COVER[cc];
            if (!cv || !cv.volumes) return;
            vAny = true;
            var decs = (names[0].tl || {})[cc] || null;
            var inDec = null;
            if (decs && cv.decades) {
              inDec = 0;
              decs.forEach(function (d) { inDec += (cv.decades[d] || 0); });
            }
            vrows.push({ cc: cc, v: cv.volumes, from: cv.from, to: cv.to,
                         places: cv.places, inDec: inDec, decs: decs });
          });
          if (vAny) {
            h.push('<div class="at-sec at-sec-wide"><div class="lab">' +
                   esc(T("The volumes that could hold") + " " + (canon || term)) +
                   "</div>");
            h.push('<p class="at-sub">' + esc(T("No volume in this atlas is " +
                   "indexed by who is written inside it, so this is what " +
                   "stands in each country the name is attested in — not a " +
                   "claim that the name is in any of it.")) + "</p>");
            h.push('<ul class="at-films ra-vol">');
            vrows.slice(0, 12).forEach(function (v) {
              var f = CC2FLAG && CC2FLAG[v.cc];
              h.push('<li><span class="ra-tw-f">' +
                     (f && f.flag ? '<svg viewBox="0 0 300 200" aria-hidden="true">' +
                                    f.flag + "</svg>" : "") + "</span>" +
                     '<a href="' + BASE + "country/" + v.cc.toLowerCase() + '/">' +
                     esc(CNAME[v.cc] || v.cc) + "</a> " +
                     '<b>' + v.v.toLocaleString() + "</b> " +
                     esc(T(v.v === 1 ? "volume" : "volumes")) +
                     ' <span class="ra-who">' + v.from + "\u2013" + v.to +
                     " \u00b7 " + v.places.toLocaleString() + " " +
                     esc(T(v.places === 1 ? "place" : "places")) + "</span>" +
                     (v.inDec !== null
                       ? '<span class="ra-ck-n">' +
                         esc(v.inDec.toLocaleString() + " " +
                             T("in the decades the band shows")) + "</span>"
                       : '<span class="ra-ck-n">' +
                         esc(T("no dates for the name here, so this cannot be narrowed")) +
                         "</span>") + "</li>");
            });
            h.push("</ul>");
            if (vrows.length > 12)
              h.push('<p class="at-sub">' + esc(T("and") + " " +
                     (vrows.length - 12) + " " + T("more countries")) + "</p>");
            h.push("</div>");
          }
        }
        /* AND THE FULL PER-COUNTRY BLOCKS A PLACE GETS. David: «surely we can
           do the same as we did with places and show sources and links FOR
           ALL COUNTRIES??» — yes, and countrySources() is the same function
           Senj's «THE SOURCES FOR CROATIA» block is built from, ranked
           national archive first, then diocesan, regional, library, and
           coloured by what it costs to see an image.

           A place calls it ONCE, for the ground it stands on. A name is
           attested in many countries and each of them is a real place to
           write to, so it is called for each, in the band's order — the
           country the name is oldest in first. The grid sets them side by
           side, which is what .at-body is for and what the place answer
           already does with its three source columns. */
        order.forEach(function (cc) {
          if (!cc) return;
          h.push(countrySources(cc, null,
                                T("The sources for") + " " + (CNAME[cc] || cc)));
        });
      } else {
        h.push('<p class="at-sub at-sub-wide">Nothing in this map reaches the countries ' +
               "this name is attested in yet — which is exactly the kind of gap worth " +
               "telling us about.</p>");
      }
      panel.innerHTML = h.join("");
      return;
    }
    /* IT IS A DIFFERENT SENTENCE WHEN THE PLACE WAS FOUND. «No places of that
       name here yet» sat directly under a box headed «That name is a place»
       listing two of them, which reads as the page contradicting itself. The
       shelf and the gazetteer answer different questions — does this map hold
       volumes here, and does this place exist — and only the first is «no». */
    h.push(hits.length
      ? '<p class="at-what"><b>The place is here. The volumes are not.</b> ' +
        "This map knows where it is and has nothing anybody has walked for it " +
        "— the shelf stands in 95 countries and only 46 of them have a place " +
        "somebody has read volume by volume. <b>That is a gap in this map, " +
        "not a gap in the record.</b></p>"
      : '<p class="at-what"><b>No places of that name here yet.</b> The shelf stands in ' +
        "95 countries, but only 46 of them have a place somebody has actually walked " +
        "volume by volume — the rest are districts, correctly placed and unread. " +
        "<b>That is a gap in this map, not a gap in the record.</b></p>");
    if (cover.length) {
      h.push('<div class="at-sec at-sec-wide"><div class="lab">But these reach it</div><ul class="at-films">');
      cover.slice(0, 14).forEach(function (p) {
        h.push('<li><a href="' + esc(p.url) + '" target="_blank" rel="noopener">' +
               esc(p.name) + " &#8599;</a> <span class=\"ra-who\">" +
               esc((ACC[p.access] || [0, p.access])[1]) + "</span>" +
               (p.at ? ' <span class="ra-who">' + esc(p.at.place) + "</span>" : "") + "</li>");
      });
      h.push("</ul>");
      if (cover.length > 14) h.push('<p class="at-sub">and ' + (cover.length - 14) + " more.</p>");
      h.push("</div>");
      h.push('<p class="at-sub">Switch on <b>The archives</b> above to see the ones that have ' +
             "a building.</p>");
    } else {
      h.push('<p class="at-sub">Nothing in this map reaches it either — which is exactly the ' +
             "kind of gap worth telling us about.</p>");
    }
    panel.innerHTML = h.join("");
  }
  /* ---- what you looked for last time -------------------------------------
     localStorage, because this is a convenience and not a record: it is
     per-browser, it never reaches us, and a reader who clears their site
     data has cleared it. Every read and write is wrapped, because private
     windows and blocked site data throw on access rather than returning
     empty, and a map that will not draw because it could not remember a
     search would be a poor trade. */
  /* ---- SMART SEARCH -------------------------------------------------------
     Places and surnames in one list, ranked, keyboard-driven.

     RANKED IN TIERS, NOT BY SCORE. An exact name wins outright — «Senj» is
     Senj, not one of five things containing those letters, which is what the
     old list offered. Then names that START with what was typed, then the
     alias index (so «Gallignana» finds Gračišće and «Breslau» finds Wrocław,
     which is the whole point of this atlas's place index), then anything
     containing it. Within a tier, the place with more volumes first — that is
     the one most likely to be meant, and it is the only signal here that is
     not about spelling. */
  var SUG_PLACES = 7, SUG_NAMES = 3, SUG_GAZ = 4;
  var sugBox, sugRows = [], sugIdx = -1, sugTerm = "";
  var sugNames = null, sugGaz = null;

  function sugPlaces(f) {
    var out = [];
    for (var i = 0; i < idx.places.length; i++) {
      var p = idx.places[i], n = fold(p.n), tier = null;
      if (n === f) tier = 0;
      else if (n.indexOf(f) === 0) tier = 1;
      else if (p.q) {
        var qi = p.q.indexOf(f);
        if (qi === 0 || (qi > 0 && /[\s,]/.test(p.q[qi - 1]))) tier = 2;
        else if (qi > -1) tier = 3;
      }
      if (tier !== null) out.push([tier, -(p.c || 0), p]);
    }
    out.sort(function (a, b) { return a[0] - b[0] || a[1] - b[1]; });
    return out.slice(0, SUG_PLACES).map(function (x) { return x[2]; });
  }

  /* THE DROPDOWN READ ONLY THE PLACES THE MAP DRAWS, which is 21,754 of the
     720,252 names this atlas can answer. David typed «Mlj» and was offered
     one surname; he typed «Brač» and was offered Bračevci, Bracciano,
     Bracebridge, Bracigliano, Braço do Norte, Bracadale — and «Murvica
     (Brač)», a village ON the island, while the island itself was missing.
     Both names work on Enter, because the gazetteer is consulted when the
     search actually runs. Neither could be SUGGESTED, so a reader typing four
     letters and watching the list concluded the map had never heard of them.
     A shelf you can only reach by guessing that it is there is not reachable.

     The gazetteer is a fetch, so it arrives the same way surnames already do:
     the list paints on drawn places first and grows when the shard lands. */
  function sugRender(places, names, gaz) {
    sugRows = [];
    var h = [];
    if (places.length || (gaz && gaz.length)) {
      h.push('<p class="ra-sug-h">' + esc(T("Places")) + "</p>");
      places.forEach(function (p) {
        var i = sugRows.length; sugRows.push({ kind: "place", p: p });
        h.push('<button type="button" role="option" aria-selected="false" ' +
               'class="ra-sug-r" data-i="' + i + '">' +
               '<span class="ra-sug-n">' + esc(p.n) + "</span>" +
               (p.cc ? '<span class="ra-sug-m">' + esc(CNAME[p.cc] || p.cc) + "</span>" : "") +
               (p.c ? '<span class="ra-sug-c">' + p.c + " " +
                      esc(T(p.c === 1 ? "volume" : "volumes")) + "</span>" : "") +
               "</button>");
      });
    }
    /* BELOW THE DRAWN PLACES, NEVER ABOVE THEM. A row here is a name the
       gazetteer holds and the shelf has not been walked for, so it must not
       outrank a place that actually carries volumes — and it says so on its
       face rather than looking like a place with a count of nothing. */
    (gaz || []).forEach(function (g) {
      var i = sugRows.length; sugRows.push({ kind: "gaz", g: g });
      h.push('<button type="button" role="option" aria-selected="false" ' +
             'class="ra-sug-r ra-sug-g" data-i="' + i + '">' +
             '<span class="ra-sug-n">' + esc(g[0]) + "</span>" +
             (g[3] ? '<span class="ra-sug-m">' + esc(CNAME[g[3]] || g[3]) +
                     "</span>" : "") +
             '<span class="ra-sug-c">' + (g[6] === "isl" ? "island · " : "") +
             "no volumes here</span></button>");
    });
    if (names && names.length) {
      h.push('<p class="ra-sug-h">' + esc(T("Names")) + "</p>");
      names.forEach(function (r) {
        var i = sugRows.length; sugRows.push({ kind: "name", r: r });
        h.push('<button type="button" role="option" aria-selected="false" ' +
               'class="ra-sug-r" data-i="' + i + '">' +
               '<span class="ra-sug-n">' + esc(r.n) + "</span>" +
               /* «occupational surname · English» beats «surname» when the
                  atlas knows it — it is the difference between four spellings
                  that look alike and one you can recognise. */
               '<span class="ra-sug-m">' + esc(
                  (r.ctx && r.ctx.kind && r.ctx.kind.length ? r.ctx.kind[0]
                                                            : T("surname")) +
                  (r.ctx && r.ctx.lang && r.ctx.lang.length
                     ? " \u00b7 " + r.ctx.lang[0] : "")) + "</span>" +
               '<span class="ra-sug-c">' + (r.countries || []).length + " " +
               esc(T((r.countries || []).length === 1 ? "country" : "countries")) +
               "</span></button>");
      });
    }
    if (!sugRows.length) { sugHide(); return; }
    sugBox.innerHTML = h.join("");
    sugBox.hidden = false;
    qbox.setAttribute("aria-expanded", "true");
    sugIdx = -1;
  }

  function sugHide() {
    if (!sugBox) return;
    sugBox.hidden = true; sugBox.innerHTML = "";
    sugRows = []; sugIdx = -1;
    qbox.setAttribute("aria-expanded", "false");
  }

  function sugMark(i) {
    var bs = sugBox.querySelectorAll(".ra-sug-r");
    [].forEach.call(bs, function (b, j) {
      b.classList.toggle("on", j === i);
      b.setAttribute("aria-selected", j === i ? "true" : "false");
      if (j === i) b.scrollIntoView({ block: "nearest" });
    });
    sugIdx = i;
  }

  function sugPick(i) {
    var row = sugRows[i];
    if (!row) return;
    sugHide();
    if (row.kind === "gaz") {
      /* No place page to open and no marker to light: this name is in the
         gazetteer and not on the shelf. apply() already handles it — it draws
         the «That name is a place» panel and flies there when the name
         matches exactly, which it now does, because the box carries the full
         name rather than the four letters that were typed. */
      qbox.value = row.g[0];
      setQ("q", row.g[0]);
      clearTimeout(qbox._t);
      apply();
      return;
    }
    if (row.kind === "place") {
      var p = row.p;
      /* The box keeps the name that was chosen, not the fragment typed — but
         without re-running the search, which would answer the question twice. */
      qbox.value = p.n;
      markHit(p, fold(p.n));
      open(p);
      map.setView([p.y, p.x], Math.max(map.getZoom(), 11));
    } else {
      qbox.value = row.r.n;
      elsewhere(row.r.n, true);
    }
  }

  function sugFor(raw) {
    var term = (raw || "").trim();
    var f = fold(term);
    sugTerm = term;
    if (f.length < 2 || !idx.places) { sugHide(); return; }
    sugNames = null; sugGaz = null;
    var places = sugPlaces(f);
    sugRender(places, null, null);
    /* DEDUPED AGAINST WHAT IS ALREADY ON THE LIST, by name and country. Many
       gazetteer rows ARE drawn places; offering «Senj» twice, once with its
       volumes and once saying it has none, would be the panel arguing with
       itself. */
    var gazSeen = {};
    places.forEach(function (p) { gazSeen[fold(p.n) + "|" + (p.cc || "")] = 1; });
    gazetteer(term).then(function (gs) {
      if (sugTerm !== term) return;
      var gkeep = (gs || []).filter(function (g) {
        var k = fold(g[0]) + "|" + (g[3] || "");
        if (gazSeen[k]) return false;
        gazSeen[k] = 1;
        return true;
      }).slice(0, SUG_GAZ);
      if (gkeep.length) { sugGaz = gkeep; sugRender(places, sugNames, gkeep); }
    }).catch(function () {});
    /* The surname shard is a fetch, so the list appears on places first and
       grows a «Names» section when it lands — rather than the whole dropdown
       waiting on a file for a name the reader may not have meant. */
    surnames(term).then(function (ns) {
      /* ONLY «ARE THEY STILL TYPING THIS». The guard also carried
         `|| sugBox.hidden && !places.length`, which is exactly the case that
         matters most: a pure surname like «blazevic» matches no place, so the
         box was hidden, so the names were thrown away and the dropdown stayed
         empty for the one query it should answer best. */
      if (sugTerm !== term) return;
      var keep = (ns || []).filter(function (r) {
        var n = fold(r.n);
        return n === f || n.indexOf(f) === 0;
      }).slice(0, SUG_NAMES);
      /* BOTH LATE ARRIVALS REDRAW THE WHOLE LIST, so each has to carry the
         other's result forward or the second one to land erases the first —
         names wiping out the gazetteer or the other way about, depending on
         which file was quicker. */
      sugNames = keep;
      if (keep.length) sugRender(places, keep, sugGaz);
    }).catch(function () {});
  }

  sugBox = document.getElementById("ra-sug");

  /* Typing rebuilds the list; the search itself still runs on its own debounce
     further down, so the dropdown is a shortcut past it rather than a
     replacement for it. */
  qbox.addEventListener("input", function () { sugFor(qbox.value); });
  qbox.addEventListener("focus", function () {
    if (qbox.value.trim().length >= 2) sugFor(qbox.value);
  });
  /* A click inside the list must land before the blur closes it. */
  qbox.addEventListener("blur", function () { setTimeout(sugHide, 160); });

  qbox.addEventListener("keydown", function (ev) {
    if (sugBox.hidden || !sugRows.length) return;
    if (ev.key === "ArrowDown") {
      ev.preventDefault(); sugMark((sugIdx + 1) % sugRows.length);
    } else if (ev.key === "ArrowUp") {
      ev.preventDefault();
      sugMark((sugIdx <= 0 ? sugRows.length : sugIdx) - 1);
    } else if (ev.key === "Enter") {
      /* Enter with nothing highlighted runs the ordinary search, which is what
         somebody who typed a whole name and never looked down expects. */
      if (sugIdx > -1) { ev.preventDefault(); sugPick(sugIdx); }
      else sugHide();
    } else if (ev.key === "Escape") {
      sugHide();
    }
  });

  sugBox.addEventListener("mousedown", function (ev) {
    var b = ev.target.closest && ev.target.closest(".ra-sug-r");
    if (!b) return;
    ev.preventDefault();                 // keep focus, beat the blur
    sugPick(+b.dataset.i);
  });
  sugBox.addEventListener("mousemove", function (ev) {
    var b = ev.target.closest && ev.target.closest(".ra-sug-r");
    if (b) sugMark(+b.dataset.i);
  });

  var RECENT_KEY = "ra-recent", RECENT_MAX = 8;
  function recentGet() {
    try {
      var v = JSON.parse(localStorage.getItem(RECENT_KEY) || "[]");
      return Object.prototype.toString.call(v) === "[object Array]" ? v : [];
    } catch (e) { return []; }
  }
  function recentPut(list) {
    try { localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, RECENT_MAX))); }
    catch (e) { /* private window, or the reader has blocked it. Fine. */ }
  }
  var recentBox = document.getElementById("ra-recent");
  /* A FLAG THE EVENTS SET, rather than reading document.activeElement back.
     activeElement is the browser's answer to «what is focused right now»,
     and it is not dependable while a window is in the background — which is
     exactly where this was being tested, and it produced two results that
     looked like bugs and were not. The events themselves are unambiguous:
     focus happened, or blur did. */
  var qFocused = false;
  function recentShouldShow() {
    return recentGet().length > 0 && qbox.value.trim() === "" && qFocused;
  }
  function recentSync() {
    var show = recentShouldShow();
    recentBox.hidden = !show;
    /* The bar has to clear the map for this exactly as it does for the
       filter dropdowns, or the list opens behind Leaflet's controls. */
    document.querySelector(".ra-bar").classList.toggle("ra-bar-raised",
      show || [].slice.call(document.querySelectorAll(".ra-drop")).some(function (d) { return d.open; }));
  }
  function drawRecent() {
    var list = recentGet();
    if (!list.length) { recentBox.hidden = true; recentBox.innerHTML = ""; return; }
    recentBox.innerHTML = '<span class="ra-recent-l">Again:</span>' +
      list.map(function (t) {
        return '<button type="button" class="ra-recent-p" data-q="' + esc(t) +
          '" title="Search ' + esc(t) + ' again">' + esc(t) + "</button>";
      }).join("") +
      '<button type="button" class="ra-recent-x" title="Forget these searches. ' +
      'They are kept in this browser only and never leave it.">Forget</button>';
    recentSync();
  }
  qbox.addEventListener("focus", function () { qFocused = true; recentSync(); });
  qbox.addEventListener("blur", function () {
    /* A click on a pill moves focus out of the box before the click lands,
       so the list cannot close the instant blur fires — it waits a beat,
       and the pill's own handler closes it when it runs. */
    qFocused = false;
    setTimeout(function () {
      if (recentBox.contains(document.activeElement)) return;
      recentSync();
    }, 140);
  });
  function recentAdd(term) {
    term = String(term || "").trim();
    if (term.length < 2) return;
    var list = recentGet().filter(function (t) {
      return t.toLowerCase() !== term.toLowerCase();
    });
    list.unshift(term);
    recentPut(list);
    drawRecent();
  }
  recentBox.addEventListener("click", function (ev) {
    var x = ev.target.closest(".ra-recent-x");
    if (x) { recentPut([]); drawRecent(); return; }
    var b = ev.target.closest(".ra-recent-p");
    if (!b) return;
    qbox.value = b.getAttribute("data-q");
    setQ("q", qbox.value);
    qFocused = false;
    recentSync();
    apply();
  });
  drawRecent();

  qbox.addEventListener("input", function () {
    setQ("q", qbox.value.trim());
    lastTyped = Date.now();
    recentSync();
    clearTimeout(qbox._t);
    qbox._t = setTimeout(apply, 140);
    /* The flag cards ride the same keystroke. Debounced together so the two
       halves of the answer change at the same moment rather than staggering. */
    clearTimeout(qbox._tf);
    qbox._tf = setTimeout(function () { drawFlagRes(qbox.value); }, 160);
    /* REMEMBERED ONLY WHEN IT WORKED, AND ONLY WHEN THE TYPING STOPPED.
       apply() runs on a 140ms debounce, so recording there would keep «B»,
       «Bl» and «Bla» as well as «Blažević». A second and a half of quiet,
       and a panel actually showing something, is the difference between a
       search and a keystroke. */
    clearTimeout(qbox._r);
    qbox._r = setTimeout(function () {
      var v = qbox.value.trim();
      if (v.length >= 2 && searchHit) recentAdd(v);
    }, 1600);
  });
  /* Enter is the reader saying they meant it, so it does not wait. */
  qbox.addEventListener("keydown", function (e) {
    if (e.key !== "Enter") return;
    clearTimeout(qbox._t);
    apply();
    var v = qbox.value.trim();
    setTimeout(function () { if (v.length >= 2 && searchHit) recentAdd(v); }, 350);
  });

  /* ---- basemap switch, home, and the view in the address bar -------------- */
  var bctl = L.control({ position: "topright" });
  bctl.onAdd = function () {
    var b = L.DomUtil.create("div", "leaflet-bar ra-base");
    b.innerHTML = ["map", "terrain", "satellite"].map(function (k) {
      /* Each of the three had no hover text at all — «Map», «Terrain» and
         «Satellite» are a guess unless you click them. */
      var what = { map: "Plain map — place names and borders, easiest to read",
                   terrain: "Terrain — hills and rivers, which is often why a "
                          + "parish is where it is",
                   satellite: "Satellite — what the ground looks like now" };
      return '<a href="#" data-b="' + k + '" title="' + esc(what[k] || k) + '"' +
             (k === baseNow ? ' class="on"' : "") + ">" + k + "</a>";
    }).join("");
    L.DomEvent.disableClickPropagation(b);
    L.DomEvent.on(b, "click", function (e) {
      var a = e.target.closest("a[data-b]"); if (!a) return;
      L.DomEvent.stop(e);
      var k = a.getAttribute("data-b");
      if (k === baseNow) return;
      map.removeLayer(BASES[baseNow]);
      baseNow = k; BASES[k].addTo(map); BASES[k].bringToBack();
      b.querySelectorAll("a").forEach(function (x) {
        x.classList.toggle("on", x.getAttribute("data-b") === k); });
      setQ("base", k === "map" ? "" : k);
    });
    return b;
  };
  bctl.addTo(map);

  /* ONE HOME VIEW NOW, AND IT IS THE WORLD. There used to be two, because the
     shelf was Croatian ground and opening on the world would have shown a
     stripe of green in the Adriatic and nothing else. That has stopped being
     true: the shelf stands in 95 countries, and opening on Istria would now
     hide 94 of them. A worldwide atlas that opens on one county is asking to
     be judged as a county map. */
  /* OPEN WHERE THE RECORDS ARE. This was the whole world for a while, on the
     argument that a worldwide atlas opening on one county asks to be judged as
     a county map. True, and it produced a first screen that was mostly ocean:
     the density is Europe and always will be, because that is where the parish
     registers are. Every country still carries a marker, so nowhere is hidden
     by opening here — it is one scroll out. */
  var HOME = [[35.5, -9.5], [56.5, 30.0]];
  var v = (Q.get("view") || "").split(",").map(Number);
  if (v.length === 3 && v.every(function (n) { return !isNaN(n); })) map.setView([v[0], v[1]], v[2]);
  else map.fitBounds(L.latLngBounds(HOME), { padding: [24, 24] });
  map.on("moveend", function () {
    var c = map.getCenter();
    setQ("view", c.lat.toFixed(4) + "," + c.lng.toFixed(4) + "," + map.getZoom());
  });

  /* HOVER IS NOT AN EXPLANATION ON A PHONE. Every sentence that moved into a
     tooltip is also here, in full, one button away. */
  var helpBox = document.getElementById("ra-help");
  document.getElementById("ra-info").addEventListener("click", function () {
    var open = helpBox.hidden;
    this.setAttribute("aria-expanded", String(open));
    if (!open) { helpBox.hidden = true; return; }
    var h = ['<div class="ra-help-in">'];
    h.push("<p><b>Search</b> finds a place by any name it has ever had \u2014 " +
           "Gallignana finds Gračišće — and finds a surname, and says which " +
           "records it is written in.</p>");
    h.push("<p><b>The layers</b></p><ul>");
    LAYERS.forEach(function (l) {
      var el = document.querySelector('.ra-layer[data-l="' + l[0] + '"]');
      h.push("<li>" + esc((el && el.title) || (l[1] + " — " + l[2])) + "</li>");
    });
    h.push("</ul>");
    h.push("<p><b>The years</b> — two handles, a range. Turn it on and the map " +
           "keeps only the places that can answer for any year between them, and " +
           "every panel names each polity that held the ground in that span. " +
           "A range that crosses a handover — Istria in 1880–1920 is Austria and " +
           "then Italy — is where records get lost, and that is the thing this " +
           "map is for.</p>");
    h.push("<p><b>The colours</b> say what it costs to look:</p><ul>");
    RANK.forEach(function (a) {
      h.push('<li><i class="at-dot" style="background:' + ACC[a][0] + '"></i>' +
             esc(ACC[a][1]) + "</li>");
    });
    h.push("</ul><p>A <b>hollow</b> dot means no volumes are recorded there. Any " +
           "colour it has is borrowed from a collection catalogued under it, or " +
           "under the district it sits in — so it is never a walk somebody did.</p>");
    h.push("</div>");
    helpBox.innerHTML = h.join("");
    helpBox.hidden = false;
  });

  /* START AGAIN. Seven layers, a year range, eight access filters and a search
     box is a lot of state to have got into by accident, and every one of them
     hides something. A map whose filters can be set but not unset makes the
     reader wonder whether it is broken — which, twice today, is exactly what
     happened: a year slider left on 2004 emptied it, and the only way back was
     to know which control had done it. */
  /* FULL SCREEN. The Defranceski map has had this since the beginning and this
     one never did — and it matters more here, because the panel beside the map
     is now long enough to scroll: volumes, sources, eras, national archives.
     Leaflet has to be told the size changed or it renders into the old box. */
  /* AND THE CONTROLS HAVE TO COME WITH IT. Full screen fixed `.at-wrap` —
     the map and the panel — to the viewport, and the control bar is a
     SIBLING of that element, not a child. So going full screen left the
     search box, the layer switches, the year slider and every button
     behind the overlay: David asked where the search box had gone, and the
     answer was "underneath". The `/` shortcut made it worse by focusing a
     box nobody could see.

     The bar is fixed to the top of the window and the wrap is padded down
     by however tall it turns out to be. Measured rather than assumed,
     because the bar wraps to two or three rows depending on width and a
     hard-coded offset would cover the map at one size and leave a gap at
     another. */
  /* A DRAG ON THE SCRUBBER IS NOT A DRAG ON THE MAP. The strip sits inside
     the Leaflet container, so without this, pulling a year handle pans the
     world underneath it and a scroll over the strip zooms. */
  /* HOW MUCH PAGE SITS ABOVE THE MAP, measured rather than guessed. The
     first attempt at fitting the map to the window subtracted a flat 300px
     for the header, the lede and the bar — and the real figure is 342, so
     the scrubber pinned to the foot of the map still finished sixteen
     pixels below the fold. It is not a constant anyway: the lede wraps
     differently at every width and the bar wraps to two rows or three.
     Measured on load and on resize, and the CSS clamp still floors and
     caps it so this can never produce a letterbox or a sprawl. */
  function fitMapToWindow() {
    var el = document.getElementById("ra-map");
    if (!el) return;
    var above = el.getBoundingClientRect().top + window.scrollY;
    document.documentElement.style.setProperty("--ra-above",
      Math.round(above + 34) + "px");
  }
  fitMapToWindow();
  window.addEventListener("resize", function () {
    fitMapToWindow();
    setTimeout(function () { map.invalidateSize(); }, 80);
  });

  var timeEl = document.getElementById("ra-time");
  if (timeEl && window.L && L.DomEvent) {
    L.DomEvent.disableClickPropagation(timeEl);
    L.DomEvent.disableScrollPropagation(timeEl);
  }

  var fullBtn = document.getElementById("ra-full");
  var fsBar = document.querySelector(".ra-bar");
  function fitFsBar() {
    var wrap = document.querySelector(".at-wrap");
    if (!wrap.classList.contains("ra-fs")) return;
    wrap.style.paddingTop = (fsBar.offsetHeight + 12) + "px";
  }
  /* THE TOOLS LIVE IN THE HEADER — EXCEPT IN FULL SCREEN, WHERE THE HEADER IS
     UNDER THE OVERLAY. Full screen fixes .at-wrap to the viewport and covers
     everything behind it, which is the exact bug the «full screen keeps the
     controls» spec exists for: last time it swallowed the search box. Moving
     these to the header would have swallowed them too, one control further
     along. So they go home to the bar while full screen is on and back to the
     header when it ends — the same elements throughout, so their handlers and
     their state come with them. */
  var toolSlot = document.getElementById("ra-tools");
  var toolHome = document.getElementById("ra-info") &&
                 document.getElementById("ra-info").parentNode;
  function toolsTo(where) {
    if (!where) return;
    /* ra-info joins them: David asked for it up in the header with the rest
       of the icons, and it is the same kind of thing — a control about the
       map rather than a part of it. */
    ["ra-info", "ra-copy", "ra-full", "ra-reset"].forEach(function (id) {
      var b = document.getElementById(id);
      if (b && b.parentNode !== where) where.appendChild(b);
    });
  }
  if (toolSlot) toolsTo(toolSlot);

  function setFull(on2) {
    toolsTo(on2 ? toolHome : toolSlot);
    var wrap = document.querySelector(".at-wrap");
    wrap.classList.toggle("ra-fs", on2);
    fsBar.classList.toggle("ra-fs-bar", on2);
    document.body.classList.toggle("ra-fs-on", on2);
    if (on2) { fitFsBar(); window.addEventListener("resize", fitFsBar); }
    else { wrap.style.paddingTop = ""; window.removeEventListener("resize", fitFsBar); }
    fullBtn.title = on2 ? "Leave full screen (or press Escape)"
                        : "Full screen — the map and its panel fill the window";
    /* A WAY OUT THAT CAN BE SEEN. Escape worked from the first day and the
       button toggles, but full screen covers the page — including the button's
       own row and every other landmark — so there was nothing on screen
       saying so, and David asked how to get out. A control you have to already
       know about is not a control. */
    var esc = document.getElementById("ra-fs-esc");
    if (on2 && !esc) {
      esc = document.createElement("button");
      esc.id = "ra-fs-esc";
      esc.type = "button";
      esc.innerHTML = "\u2715 Exit full screen <span>Esc</span>";
      esc.addEventListener("click", function () { setFull(false); });
      document.body.appendChild(esc);
    } else if (!on2 && esc) {
      esc.remove();
    }
    setTimeout(function () { fitFsBar(); map.invalidateSize(); }, 60);
  }
  fullBtn.addEventListener("click", function () {
    setFull(!document.querySelector(".at-wrap").classList.contains("ra-fs"));
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") setFull(false);
  });

  document.getElementById("ra-reset").addEventListener("click", function () {
    qbox.value = "";
    yon.checked = false; year = year2 = null;
    yin.value = 1780; yin2.value = 1920;
    off = {};
    on = { shelf: true, countries: true };
    LAYERS.forEach(function (l) {
      var el = document.querySelector('.ra-layer[data-l="' + l[0] + '"]');
      if (el) {
        el.classList.toggle("on", !!on[l[0]]);
        var box = el.querySelector("input");
        if (box) box.checked = !!on[l[0]];
      }
    });
    document.querySelectorAll(".ra-opt[data-cat]").forEach(function (b) {
      b.classList.add("on");
      var i = b.querySelector("input"); if (i) i.checked = true;
    });
    kindOn = {};
    document.querySelectorAll(".ra-opt[data-kind]").forEach(function (b) {
      b.classList.remove("on");
      var i = b.querySelector("input"); if (i) i.checked = false;
    });
    kindSummary();
    catSummary();
    /* Was two separate disclosures; one now. Guarded because this runs on
       reset and a missing element used to throw here silently. */
    var _one = document.getElementById("ra-layersw");
    if (_one) _one.open = false;
    if (gmark) { map.removeLayer(gmark); gmark = null; }
    ctryLayer.clearLayers();
    communeLayer.clearLayers();
    litCC = null; litFor = null;
    hitLayer.clearLayers(); lastHitFor = null;
    helpBox.hidden = true;
    document.getElementById("ra-info").setAttribute("aria-expanded", "false");
    panel.hidden = true; empty.hidden = false; clearHood();
    var ck = document.getElementById("ra-check"); if (ck) ck.hidden = true;
    clearCheckPins();
    ["q", "year", "years", "off", "kind", "layers", "at", "view"].forEach(function (k) {
      setQ(k, "");
    });
    syncLayers();
    yearUI();
    apply();
    map.fitBounds(L.latLngBounds(HOME), { padding: [24, 24] });
  });

  function closeSheet() { panel.hidden = true; empty.hidden = false; clearHood(); }
  document.getElementById("ra-sheet-x").addEventListener("click", closeSheet);

  /* ---- A HANDLE ON THE MAP, ON PURPOSE -----------------------------------
     Everything above lives inside one closure, which is right for the page
     and wrong for testing it: the Playwright specs in test/e2e can see the
     DOM and nothing else, so «are the clusters up at this zoom» was a
     question only a human squinting at a screenshot could answer. Trying to
     answer it from outside is what surfaced the need — synthetic mouse
     events do not reach Leaflet's canvas hit-testing, and a canvas in a
     window the compositor has parked is simply never painted, so an empty
     canvas proves nothing either way.

     Read-only by intent: it hands over the Leaflet map and a few counters,
     not the setters. Nothing on the page uses it, so removing it would
     break nothing here — it exists for the test suite and for anyone who
     wants to drive this map from their own console. */
  window.recordAtlas = {
    map: map,
    version: 1,
    layers: { shelf: shelfLayer, clusters: clusterLayer, archives: archiveLayer,
              countries: countryLayer, regions: regionLayer },
    state: function () {
      var bubbles = map.hasLayer(clusterLayer), n = 0;
      clusterLayer.eachLayer(function () { n++; });
      return {
        zoom: map.getZoom(),
        clustered: bubbles,
        clusters: n,
        shelfOnMap: map.hasLayer(shelfLayer),
        shown: lastVisible.length,
        total: markers.length,
        query: qbox.value.trim(),
        splitName: qName,
        splitPlace: qPlace,
        year: year === null ? null : [year, year2]
      };
    }
  };

  document.getElementById("ra-copy").addEventListener("click", function () {
    navigator.clipboard.writeText(location.href).then(function () {
      var t = document.getElementById("ra-copied");
      t.hidden = false; setTimeout(function () { t.hidden = true; }, 1600);
    });
  });

  /* HOW MUCH ROOM IS LEFT UNDER THE SEARCH BAR, for the mobile sheet.
     Recomputed on resize and on rotate because the bar wraps differently at
     every width, and the sheet is anchored to the bottom so its top edge is
     whatever is left over. Written as a pixel value on the root so the rule
     can take the smaller of this and its own 70vh. */
  function sheetRoom() {
    var bar = document.querySelector(".ra-bar");
    if (!bar) return;
    var room = window.innerHeight - bar.getBoundingClientRect().bottom - 8;
    document.documentElement.style.setProperty(
      "--ra-sheet-max", Math.max(220, Math.round(room)) + "px");
  }
  sheetRoom();
  window.addEventListener("resize", sheetRoom);
  window.addEventListener("orientationchange", sheetRoom);

  syncLayers();
  paintRegions();
  yearUI();
  var loadingEl = document.getElementById("ra-loading");
  if (loadingEl) loadingEl.remove();

  var openAt = Q.get("at");
  var opened = false;
  if (openAt) {
    var hit = idx.places.filter(function (p) { return p.i === openAt; })[0];
    if (hit) { open(hit); opened = true; }
  }

  /* ---- the quiet dots, once the map is already up -------------------------
     index.json is the one fetch the first paint waits on, and it had grown
     to 533 KB. A quarter of that was places carrying no volume and no
     collection — real ground, correctly placed, nobody has walked it. They
     belong on the map, but nothing about them is an answer to a search, so
     making the map wait for them was paying the whole latency for the least
     urgent quarter of it. They come second now: 409 KB draws the atlas,
     124 KB fills in the ground behind it.

     Everything they touch has to be topped up, not just the layer — the
     name index, so a search for one of them still resolves; the filters,
     so they obey the year and the kind boxes the visitor has already set;
     and a ?at= link that pointed at one, which found nothing a moment ago
     and can now be honoured. */
  /* After the map is drawable, not before: 164 KB of cards must not stand in
     front of the file the first paint waits on. */
  loadFlagIndex();

  /* ?hub=Former+Yugoslavia — the hub cards offer it, so the map has to honour
     it. A link that lands on an unchanged map is the fault this project
     caught in its own Flag History deep links this morning: an address the
     browser accepts and silently does nothing with looks exactly like one
     that worked. */
  (function () {
    var wantHub = Q.get("hub");
    if (!wantHub) return;
    var tries = 0;
    (function waitForIndex() {
      if (!FLAGIDX) {
        if (tries++ > 60) return;      // the file never came; leave the map alone
        setTimeout(waitForIndex, 250);
        return;
      }
      var hub = (FLAGIDX.hubs || []).filter(function (h) {
        return h.name === wantHub; })[0];
      if (!hub || !hub.holds || !hub.holds.ccs || !hub.holds.ccs.length) return;
      var want = {};
      hub.holds.ccs.forEach(function (c) { want[c] = 1; });
      /* Actually narrow the map to the hub, rather than merely flying to it.
         keep() reads hubCCs, so one apply() hides everything outside it and
         every other filter goes on working inside it. */
      hubCCs = want;
      apply();
      var pts = [];
      markers.forEach(function (m) {
        if (m._p && want[m._p.cc]) pts.push([m._p.y, m._p.x]);
      });
      if (pts.length) map.fitBounds(pts, { padding: [30, 30], maxZoom: 6 });
      var box = document.getElementById("ra-flagres-sub");
      if (box) {
        /* A FILTER THE READER CANNOT SEE IS A BUG THEY CANNOT REPORT. The map
           is now showing a fraction of itself, so it has to say so, and to
           offer the way out in the same breath. */
        box.innerHTML = "";
        box.appendChild(document.createTextNode(
          "Showing only " + hub.name + " \u2014 " +
          hub.holds.places.toLocaleString() + " places across " +
          hub.holds.countries + " countries. "));
        var clear = document.createElement("button");
        clear.type = "button";
        clear.className = "ra-hubclear";
        clear.textContent = "Show the whole map";
        clear.addEventListener("click", function () {
          hubCCs = null;
          apply();
          box.textContent = "";
          try {
            var u = new URL(location.href);
            u.searchParams.delete("hub");
            history.replaceState(null, "", u);
          } catch (e) {}
        });
        box.appendChild(clear);
      }
      if (fSec) fSec.hidden = false;
    })();
  })();

  if (idx.quiet && idx.quiet.file) {
    fetch(INDEX.replace(/[^/]*$/, idx.quiet.file))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var qp = d.places || [];
        qp.forEach(function (p) {
          var k = fold(p.n);
          if (!(k in byName)) byName[k] = p.i;
          markers.push(makeMarker(p));
        });
        idx.places = idx.places.concat(qp);
        /* AND NOW THE TRUTH REPLACES THE DECLARATION. TOTAL_PLACES was
           idx.places.length plus idx.quiet.places — a number index.json
           STATES about a file it does not contain. If the two ever disagree
           the count can never settle: it reads «21,479 of 21,473 places
           shown», which is both wrong and impossible, and it stays that way.
           A stale local public/ produced exactly that, six places apart.
           Once the file is here, its rows are the count, so the declaration
           is only ever used for the second before it can be checked. */
        TOTAL_PLACES = idx.places.length;
        /* The counts in the filters were taken from the loud half alone;
           the quiet half is 5,693 more places and almost all of them
           unsurveyed, so redraw or the numbers are a third of the truth. */
        COUNTS = optionCounts();
        drawCats();
        drawKinds();
        catSummary();
        kindSummary();
        apply(true);
        if (openAt && !opened) {
          var late = qp.filter(function (p) { return p.i === openAt; })[0];
          if (late) { open(late); opened = true; }
        }
      })
      .catch(function () { /* the atlas is still an atlas without them */ });
  }
});
</script>

<style>
  /* ---- one bar ----------------------------------------------------------
     Search, seven layers, the year and two icon buttons on a single line that
     wraps only when it has to. It replaces roughly 800px of stacked panels
     with about 100, and the map — the thing the page is for — starts near the
     top of the screen instead of below the fold. */
  /* A COLUMN OF ROWS, not one long wrapping line. Where a control landed
     used to depend on the width of everything before it. */
  /* AND THE BAR HAS TO SIT ABOVE THE MAP. With the wrapper positioned, the
     dropdown landed in the right place and was then painted over by Leaflet —
     only its «PLACES» heading showed above the map's top edge. Leaflet stacks
     its own panes from 200 to 700 inside the map container, so the bar needs
     a stacking context of its own above that. 800 was not enough: Leaflet's
     CONTROLS — the zoom buttons and the basemap switcher — sit at 1000, and
     they went on punching through the list. Above them, and still below the
     full-screen exit pill at 950... which is itself below this, so the pill
     is raised with it where full screen applies. */
  .ra-bar { display: flex; flex-direction: column; align-items: stretch;
            gap: 8px; margin: 14px 0 10px; position: relative; z-index: 1100; }
  .ra-bar-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  /* The filter rides with the search box; the icon buttons still go to the
     far end of the row. */
  .ra-bar-filters { flex: 0 0 auto; }
  /* The box takes the room the row has. Without this it sat at its intrinsic
     width with the filter jammed against it. */
  /* THE THING BOTH DROPDOWNS HANG FROM. .ra-sug and .ra-recent are both
     `position: absolute; top: calc(100% + 6px); left: 0; right: 0` — which
     only means «under the search box» if the search box's wrapper is a
     positioned ancestor. It was static, so they resolved against the page and
     rendered 1,462 pixels down it, full width, below the fold. The dropdown
     was in the DOM, not hidden, display:block, with seven rows in it — and
     invisible. My own checks asked `hidden`, `innerHTML.length` and `display`
     and never asked WHERE it was, so they all passed while nothing was on
     screen. One line, and it fixes the remembered-searches list too, which
     has been landing in the same wrong place. */
  .ra-bar-find .ra-find { flex: 1 1 320px; min-width: 200px; position: relative; }
  /* Its own line when the row is full, which is most of the time now that the
     filter shares it — and always, when the message becomes a sentence. */
  .ra-bar-find #ra-count { flex: 1 1 100%; margin: 0; }
  /* The search takes the row and the buttons are pushed to the far end. */
  .ra-bar-find #ra-q { font-size: 14px; padding: 9px 12px; }
  .ra-bar-find #ra-info { margin-left: auto; }
  .ra-bar #ra-q { font-size: 14px; padding: 9px 12px; }
  /* The opening panel's three ways in. Compact, because it is scaffolding
     the reader should stop needing after their first search. */
  /* ONE PARAGRAPH, NOT A LIST OF THREE. See the note on the markup. Held to
     a readable measure because the panel it sits in is now the full width of
     the page, and a single line of 150 characters is its own kind of waste. */
  .at-start { margin: 0; font-size: 13.5px; line-height: 1.65;
              color: var(--ink-2); max-width: 88ch; }
  .at-start b { color: var(--ink); }
  .at-start a { border-bottom: 1px solid var(--rule-strong); }
  .at-start-more { margin: 6px 0 0; font-size: 12.5px; }
  #ra-play[aria-pressed="true"] { background: var(--accent); color: var(--band-label, #fff);
                                  border-color: var(--accent); }
  /* THE SAME HEIGHT AS THE SEARCH BOX. They were 32px against its 38 and sat
     on the same line looking like an afterthought. One variable, so the two
     cannot drift apart again — the input's height is its own padding plus
     line-height, and this is set to match it rather than guessed at. */
  /* margin: 0 is the whole fix. A global form rule gives this input a 6px
     top margin; centring it in a 38px row then splits the overflow and puts
     the box three pixels below the buttons beside it. Everything measured
     38 and it still looked wrong, which is why the answer came from asking
     for the computed margin rather than from staring at heights. */
  .ra-bar-find #ra-q { height: var(--ra-ctl, 38px); box-sizing: border-box;
                       margin: 0; }
  .ra-ico { flex: 0 0 auto; width: var(--ra-ctl, 38px); height: var(--ra-ctl, 38px);
            box-sizing: border-box; border: 1px solid var(--rule);
            border-radius: 3px; background: var(--panel); color: var(--ink-2);
            font-size: 15px; line-height: 1; cursor: pointer; }
  .ra-ico:hover { border-color: var(--accent); color: var(--accent); }
  .ra-help { margin: 0 0 12px; border: 1px solid var(--rule);
             border-left: 2px solid var(--accent); border-radius: 3px;
             background: var(--panel); }
  :global(.ra-help-in) { padding: 14px 16px; font-family: var(--sans);
                         font-size: 12.5px; line-height: 1.6; color: var(--ink-2); }
  :global(.ra-help-in p) { margin: 0 0 8px; max-width: 78ch; }
  :global(.ra-help-in ul) { margin: 0 0 10px; padding-left: 0; list-style: none; }
  :global(.ra-help-in li) { margin: 0 0 3px; color: var(--ink-3); }
  /* The wrap becomes the window. z-index sits above Leaflet's panes (400–700)
     and below nothing else this page has. */
  :global(.at-wrap.ra-fs) { position: fixed; inset: 0; z-index: 900;
    margin: 0; padding: 12px; background: var(--ground); gap: 12px; }
  :global(body.ra-fs-on) { overflow: hidden; }
  /* The bar rides along, fixed to the top. Above the wrap (900) so it is
     not covered, below the exit pill (950) so that stays reachable. It
     scrolls if somebody has a very narrow window and the controls wrap to
     four rows, rather than eating the whole screen. */
  :global(.ra-bar.ra-fs-bar) { position: fixed; top: 0; left: 0; right: 0;
    z-index: 940; margin: 0; padding: 10px 12px;
    background: var(--ground); border-bottom: 1px solid var(--rule-strong);
    max-height: 45vh; overflow-y: auto; }
  /* ON A PHONE THE BAR WRAPS TO 268 PIXELS, which in «full screen» left the
     map 296 of an 812-pixel window — the controls taking a third of the
     screen in the mode whose whole purpose is to give the map the screen.
     Capped so the search row is always visible and the rest is one scroll
     away, which keeps the thing that was missing and gives the map back
     the space. */
  @media (max-width: 760px) {
    :global(.ra-bar.ra-fs-bar) { max-height: 96px; }
  }
  /* AND THE EXIT PILL MOVES OUT OF ITS WAY. It used to sit top-right, which
     is exactly where the bar's own buttons now are; the two overlapped. The
     phone layout had already put it at the bottom for the same reason. */
  :global(body.ra-fs-on #ra-fs-esc) { top: auto;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 16px); right: 18px;
    /* The phone rule centres it with a translate. This wins on specificity
       for `right`, and without resetting the transform too the pill would
       be shoved half its own width off the edge. */
    transform: none; }
  :global(#ra-fs-esc) { position: fixed; top: 14px; right: 16px; z-index: 950;
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    font-family: var(--sans); font-size: 12.5px; color: var(--ink-2);
    background: var(--panel); border: 1px solid var(--rule-strong);
    border-radius: 999px; padding: 7px 13px;
    box-shadow: 0 6px 20px rgba(10, 20, 26, .28); }
  :global(#ra-fs-esc:hover) { color: var(--accent); border-color: var(--accent); }
  :global(#ra-fs-esc span) { font-family: var(--mono); font-size: 10.5px;
    color: var(--ink-3); border: 1px solid var(--rule); border-radius: 3px;
    padding: 1px 5px; }
  :global(.at-wrap.ra-fs .at-map) { height: auto; }
  /* AND THE PANEL WITH IT. The map was switched to auto so it fills the
     window, but the panel kept the shared 600px and stopped a third of the way
     down — so the deeper a country's list of sources, the more it scrolled
     inside a box with empty screen beneath it. Both sides are grid items in a
     container that is already the height of the window; auto lets the row
     stretch them equally. */
  /* THE PANEL IS A ROW NOW. When it was the right-hand column, `height:auto`
     let it stretch to the window beside the map. As the bottom row of the
     areas grid, `auto` means «as tall as your content» — so a place with
     forty volumes would push the map off the screen in the mode whose whole
     point is to give the map the screen. The rows split it instead. */
  :global(.at-wrap.ra-fs) { grid-template-rows: 1fr minmax(0, 38vh); }
  :global(.at-wrap.ra-fs .at-panel) { height: auto; min-height: 0;
    overflow-y: auto; }
  :global(.at-wrap.ra-fs .ra-rail) { height: auto; min-height: 0; }
  /* FULL SCREEN ON A PHONE GAVE THE MAP A SLIVER.
     The two rules above say `height: auto` so that, in the two-COLUMN
     desktop layout, both sides stretch to the height of the window. Below
     900px the wrap collapses to one column, so map and panel become two
     ROWS — and `height: auto` then means "size to your content". The panel
     has volumes, sources and eras in it and the map has none, so the panel
     took the window and the map was left about 200px tall, letterboxed,
     with the basemap switcher hanging off the edge.
     Given rows, the map needs a share of the window rather than a share of
     its own content. min-height:0 is what lets a grid item shrink below its
     content and scroll instead of pushing the row open. */
  @media (max-width: 900px) {
    /* One column, so the rail becomes a horizontal strip and there are three
       rows to share rather than two. */
    :global(.at-wrap.ra-fs) { grid-template-rows: 3fr auto 2fr;
      padding: 8px; gap: 8px; }
    :global(.at-wrap.ra-fs .at-map) { height: 100%; min-height: 0; }
    :global(.at-wrap.ra-fs .at-panel) { height: 100%; min-height: 0;
      max-height: none; overflow-y: auto; }
    /* Clear of Leaflet's own controls: zoom sits top-left and the basemap
       switcher top-right, and the exit button was landing on the switcher.
       At the bottom it is over the map and in reach of a thumb. */
    :global(#ra-fs-esc) { top: auto; bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
      right: 50%; transform: translateX(50%); }
  }
  :global(.ra-crossed) { display: inline-block; margin-left: 6px; padding: 1px 7px;
    border-radius: 999px; font-family: var(--sans); font-size: 10.5px;
    color: var(--accent); background: var(--accent-wash);
    border: 1px solid var(--rule); white-space: nowrap; }
  .ra-cats-wrap { min-width: 240px; }
  /* A POPOVER, NOT A FOLD-OUT. An inline disclosure pushed the map down
     every time somebody looked at a filter, and in full screen it would
     have changed the height of a bar whose height is measured. Absolutely
     positioned, so opening one moves nothing. */
  .ra-drop { position: relative; min-width: 0; }
  /* THE POPOVER OPENED BEHIND THE MAP. z-index inside an element that
     establishes no stacking context is measured against its siblings, and
     the bar's sibling is the map — whose Leaflet controls sit at z-index
     1000 in the root context. Thirty never stood a chance.

     Lifted only WHILE A DROPDOWN IS OPEN, not permanently: the page header
     is sticky at z-index 60, so a bar parked above everything would scroll
     up and paint over the header on its way past. Raised on open, dropped
     on close, and the map is the only thing it needs to beat. */
  :global(.ra-bar.ra-bar-raised) { position: relative; z-index: 1200; }
  :global(.ra-drop > .ra-drop-in) {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 30;
    /* z-index 30 is only meaningful INSIDE the bar's stacking context. The
       bar has to be lifted above the map first — see .ra-bar-raised. */
    min-width: 280px; max-width: min(92vw, 540px);
    background: var(--panel); border: 1px solid var(--rule-strong);
    border-radius: 6px; padding: 12px 14px;
    box-shadow: 0 10px 28px rgba(10, 20, 26, .22);
  }
  :global(.ra-drop .ra-key-lead) { display: block; margin: 0 0 10px;
    font: 400 11.5px/1.6 var(--sans); color: var(--ink-2); max-width: 54ch; }
  :global(.ra-drop .ra-layers) { gap: 6px; }
  /* THE FILTER CONTROL IS AN ICON THAT CAN GROW A BADGE.
     It was a text pill reading «Filters 2 · All · All». As a funnel it sits
     the same size and shape as the link, full-screen and reset buttons it now
     stands beside, so the row reads as one set of tools rather than a pill
     and some icons. It widens only when something is actually narrowed. */
  .ra-cats-wrap summary { font: 400 12px/1.6 var(--sans); color: var(--ink-2);
    cursor: pointer; border: 1px solid var(--rule); border-radius: 3px;
    background: var(--panel); list-style: none;
    box-sizing: border-box; height: var(--ra-ctl, 38px);
    min-width: var(--ra-ctl, 38px); padding: 0 8px;
    display: inline-flex; align-items: center; justify-content: center;
    gap: 6px; flex: 0 0 auto; }
  .ra-cats-wrap summary:hover { border-color: var(--accent); color: var(--accent); }
  .ra-cats-wrap summary:focus-visible { outline: 2px solid var(--accent);
    outline-offset: 2px; }
  :global(.ra-funnel) { width: 15px; height: 15px; display: block; flex: none; }
  .ra-cats-wrap summary::-webkit-details-marker { display: none; }
  :global(.ra-cats-wrap summary .ra-badge) {
    display: inline-block; margin-left: 5px; padding: 0 5px;
    font: 500 10.5px/1.7 var(--mono); color: var(--accent);
    background: var(--accent-wash); border-radius: 4px;
    vertical-align: baseline; }
  .ra-cats-wrap summary::after { content: " \25BE"; }
  .ra-cats-wrap[open] summary::after { content: " \25B4"; }
  .ra-cats-wrap[open] .atlas-key { margin-top: 8px; }
  .ra-key-lead { display: none; }
  .ra-cats-wrap[open] .ra-key-lead { display: block; margin: 9px 0 0;
    font: 400 11.5px/1.6 var(--sans); color: var(--ink-2); max-width: 62ch; }
  .ra-bar #ra-count { margin: 0 0 0 auto; font-size: 11.5px; line-height: 1.5;
                      max-width: 100%; text-align: right; }
  /* On a narrow window the four buttons would be squeezed against the search
     box; let them fall to their own line rather than crush it. */
  @media (max-width: 620px) {
    .ra-bar-find #ra-info { margin-left: 0; }
    .ra-find { flex: 1 1 100%; }
  }
  /* When it grows into the «nothing can answer for that year» explanation it
     takes the whole row rather than squeezing the buttons off the end. */
  :global(.ra-bar #ra-count b) { color: var(--ink); }
  @media (max-width: 760px) {
    .ra-bar #ra-count { margin-left: 0; text-align: left; flex: 1 1 100%; }
  }

  .ra-top { margin-top: 10px; }
  /* The layer switches and the filter pills are written by the script with
     innerHTML, so they never carry Astro's scope attribute — which means every
     rule that styles them matches nothing at all unless it is :global. The
     component this descends from learned that the expensive way. */
  .ra-layers { display: flex; gap: 5px; flex-wrap: wrap; }
  :global(.ra-layer) {
    display: inline-flex; align-items: center; gap: 5px; cursor: pointer;
    padding: 6px 9px; border: 1px solid var(--rule); border-radius: 999px;
    background: var(--panel); opacity: .6; white-space: nowrap;
  }
  :global(.ra-layer.on) { opacity: 1; border-color: var(--accent); }
  :global(.ra-layer input) { margin: 0; accent-color: var(--accent);
                             width: 12px; height: 12px; }
  :global(.ra-layer b) { font-family: var(--sans); font-size: 12px; font-weight: 500; }

  .ra-ylab { display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
             padding: 5px 9px; border: 1px solid var(--rule); border-radius: 999px;
             background: var(--panel); font-family: var(--sans); font-size: 12px;
             white-space: nowrap; flex: 0 1 220px; }
  .ra-ylab input { accent-color: var(--accent); }
  /* TWO SLIDERS STACKED, because the web has no two-handled range input. The
     lower one is inert except for its thumb — pointer-events are off on the
     track and back on for the thumb — so each handle stays grabbable wherever
     the other one is. */
  .ra-slider { position: relative; flex: 1 1 120px; min-width: 96px; height: 18px;
               display: block; }
  .ra-slider input[type=range] {
    position: absolute; left: 0; top: 0; width: 100%; margin: 0; height: 18px;
    background: none; pointer-events: none; -webkit-appearance: none; appearance: none;
  }
  .ra-slider input[type=range]::-webkit-slider-thumb {
    pointer-events: auto; -webkit-appearance: none; appearance: none;
    width: 13px; height: 13px; border-radius: 50%; background: var(--panel);
    border: 2px solid var(--accent); cursor: grab; margin-top: -5px;
  }
  .ra-slider input[type=range]::-moz-range-thumb {
    pointer-events: auto; width: 13px; height: 13px; border-radius: 50%;
    background: var(--panel); border: 2px solid var(--accent); cursor: grab;
  }
  .ra-slider input[type=range]::-webkit-slider-runnable-track {
    height: 3px; background: var(--rule); border-radius: 2px; }
  .ra-slider input[type=range]::-moz-range-track {
    height: 3px; background: var(--rule); border-radius: 2px; }
  .ra-slider input[type=range]:disabled::-webkit-slider-thumb { opacity: .35; }
  .ra-slider input[type=range]:disabled::-moz-range-thumb { opacity: .35; }
  .ra-track { position: absolute; top: 7px; height: 3px; background: var(--accent);
              border-radius: 2px; pointer-events: none; }
  #ra-yout { white-space: nowrap; }
  #ra-yout { font-size: 15px; font-weight: 500; color: var(--accent); min-width: 5ch; }

  /* See index.astro: the shared .pagehead is sized for reading, not for a
     tool. Here the title sits closer to the top and the standfirst runs the
     full column instead of stopping at 76ch. */
  /* ONE BASELINE ROW: heading, then the scale, then the way out to /help/.
     See the note on the markup in index.astro. The row wraps rather than
     shrinking the type, so a narrow window gets two short lines instead of
     an unreadable one. */
  :global(.pagehead.ra-lede) { padding: 16px 0 10px; margin-bottom: 10px;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  :global(.pagehead.ra-lede h1) { font-size: clamp(21px, 2vw, 27px);
    margin: 0; letter-spacing: -.01em; }
  :global(.pagehead.ra-lede .lab) { margin: 0; }
  :global(.pagehead.ra-lede .dek) { max-width: none; margin: 0;
    font-size: 13px; }
  /* The stats line is the first thing to go when there is no room for it:
     it is evidence of scale, not an instruction, and the reader can find the
     same numbers on /help/ and on the data index. */
  @media (max-width: 760px) {
    :global(.pagehead.ra-lede) { padding: 12px 0 8px; margin-bottom: 8px; }
    :global(.pagehead.ra-lede .lab) { flex-basis: 100%; }
  }
  /* TWO COLUMNS BECAME AN L. The answer — name, volumes, archives — used to
     be a 360px column on the right, which is a narrow measure for a list of
     volume titles and left the map three quarters of the width. It now runs
     full width UNDER the map, and the right of the map is a 112px rail of
     era flags, which is the one thing that suits a tall thin box.
     Areas rather than DOM order, because full screen fixes this same element
     to the viewport with the panel inside it — moving the panel out of the
     wrap in markup would have emptied full screen of everything but the map. */
  /* The column is as wide as the checklist wants to be: a 44px rail when it
     is shut, a readable list when it is open. The map takes the rest either
     way, which is why this is `auto` and not a number. */
  .at-wrap { display: grid; gap: 18px; margin-top: 12px;
             grid-template-columns: 1fr auto;
             grid-template-areas: "map check" "panel panel"; }
  .at-map { grid-area: map; }
  .ra-check { grid-area: check; }
  .at-panel { grid-area: panel; }
  /* A MAP THAT DOES NOT FIT THE WINDOW IS A MAP YOU SCROLL TO USE.
     600px was fine while every control lived in the bar above it. It stopped
     being fine the moment the year scrubber moved to the FOOT of the map:
     header, lede and bar come to about 300px, so on a 800px laptop the last
     hundred pixels of the map — and the scrubber pinned to them — sat below
     the fold. David saw a page that «seems to cut off», and the page was
     fine; what was cut off was the control I had just moved there.
     Sized against the window, floored so it never becomes a letterbox and
     capped so it does not sprawl on a tall monitor. */
  .at-map { height: clamp(380px, calc(100vh - var(--ra-above, 340px)), 620px);
            border: 1px solid var(--rule); border-radius: 3px; }
  /* NO LONGER A 620px SCROLLER. Beside the map it had to match the map's
     height and scroll inside itself; under the map it can be as tall as its
     content and the page scrolls, which is one scrollbar instead of two. */
  .at-panel { height: auto; border: 1px solid var(--rule);
              border-radius: 3px; background: var(--panel); padding: 16px 18px 20px; }
  /* AND FULL WIDTH IS NOT A REASON FOR 160-CHARACTER LINES. The body was a
     vertical list built for a narrow column; across the full width its
     volume lists would run the width of a monitor. A card grid keeps the
     measure readable and puts the sources side by side, which is how the
     mockup read. The heading and the two notes that qualify the whole place
     span every column — they are about the place, not about one source. */
  .at-body { display: grid; gap: 14px 18px; align-items: start;
             grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  /* The BODY is rendered by Astro and carries the scope class; everything
     inside it is written by script and does not, so the child half of each
     of these has to be global or the rule never lands. This is the whole
     reason the band appeared inside one 362px column of a four-column grid
     with its segments overflowing, instead of spanning the panel. */
  .at-body > :global(.at-h), .at-body > :global(.at-also),
  .at-body > :global(.ra-juris), .at-body > :global(#ra-flagera),
  /* A NAME IS NOT A PLACE, AND SHOULD NOT SIT IN A PLACE'S COLUMN. David:
     «why are we so crammed? isnt this about the name, not places… shouldnt the
     name go the whole way across?» — quite right. .at-body is a grid of ~300px
     cards because a PLACE answers with several sources side by side. A surname
     answers with one card that holds a timeline, an origin and a list of
     countries, and it was being folded into a third of the width while «No
     places of that name here yet» took the other two thirds. */
  .at-body > :global(.ra-surn), .at-body > :global(.ra-dead),
  /* .ra-note also lands here on its own — Taylor's Belgian commune count is a
     paragraph, not a card, and a paragraph in a 327px column beside a
     1361px one is the same crammed reading all over again. */
  .at-body > :global(.ra-note),
  .at-body > :global(.ra-era-lead), .at-body > :global(.ra-tl),
  .at-body > :global(.ra-tl-group),
  .at-body > :global(.at-lab),
  .at-body > :global(.at-hint) { grid-column: 1 / -1; }

  /* NOT EVERY CHILD IS A CARD, AND THE FIRST VERSION TREATED THEM ALL AS ONE.
     David: «why is everything so wonky? a whole column dedicated to
     "everything about Gračišće"». He was looking at a 21-pixel link holding a
     362-pixel column open, and — worse — at the 32 volumes for Gračišće
     squeezed into another 362-pixel column, 870 pixels tall, with three
     quarters of the page blank beside it, while «Marriages 1671–1835 … ŽU
     Gračišće» wrapped onto two lines for want of room it could see.

     Three kinds of child, three behaviours. The source blocks ARE cards and
     read well side by side, which is what the grid is for. A single link is
     not a card. A list of volumes is not a card either: it wants the full
     width and its own columns, because a long list of short lines is the one
     thing that genuinely benefits from being set in columns. */
  .at-body > :global(.at-go), .at-body > :global(.at-sub-wide),
  .at-body > :global(.at-sec-wide) { grid-column: 1 / -1; }
  /* Sized in em so the columns track the text, not the window: at 22em a
     volume title and its years sit on one line, which is the whole point.

     display:block IS LOAD-BEARING. .at-films is `display: grid` further down
     for its 5px row gap, and a grid container ignores `columns` outright —
     the property computed to a 418px column width and the list went on
     rendering as one 755px column of 32 items, which looked exactly like the
     bug I had just fixed. The row gap comes back as a margin. */
  :global(.at-sec-wide .at-films) { display: block; columns: 22em;
    column-gap: 30px; }
  :global(.at-sec-wide .at-films li) { break-inside: avoid; margin-bottom: 5px; }
  /* BIRTHS, MARRIAGES, DEATHS SIDE BY SIDE — see the note at the loop that
     builds these. `columns` is reset inside, because the outer rule would
     otherwise pour each type's list through columns of its own again and put
     the problem back one level down. */
  :global(.at-kinds) { display: grid; gap: 4px 30px;
    grid-template-columns: repeat(auto-fit, minmax(19em, 1fr)); }
  :global(.at-kinds .at-films) { columns: auto; column-gap: normal; }
  :global(.at-kinds .at-kind .lab) { margin: 10px 0 2px; }
  /* The country a run of archives belongs to, set as a rule over them. In a
     multi-column list a heading that lands at the foot of a column labels
     nothing, so it is glued to the row beneath it. */
  :global(.at-films-cc) { font-family: var(--sans); font-size: 10.5px;
    letter-spacing: .09em; text-transform: uppercase; color: var(--ink-3);
    margin: 12px 0 4px; padding-bottom: 3px; border-bottom: 1px solid var(--rule);
    break-after: avoid; break-inside: avoid; list-style: none; }
  :global(.at-films-cc:first-child) { margin-top: 0; }
  :global(.at-films-cc a) { color: var(--ink-2); text-decoration: none;
    border-bottom: 1px solid transparent; }
  :global(.at-films-cc a:hover) { color: var(--ink); border-bottom-color: var(--rule-strong); }
  /* The country's own count, set apart from its name so the rule reads
     «Italy  126» and not «Italy 126» as one word. */
  :global(.at-films-cc .ra-who) { float: right; letter-spacing: 0; }

  /* The vertical era rail's styles lived here. The rail is gone — one
     timeline, under the map — so they went with it. loadEraArt() and the
     .ra-tl-flag rules remain: the country band still draws the flags.

     RESTORED BELOW, AND THE REASON THIS NOTE IS LONG. Removing the rail's
     rules, I cut from the rail's own comment to the next section marker and
     assumed the two were adjacent. They were two hundred and thirty lines
     apart, so the cut took .at-h, .at-sec, .at-films, .ra-fcard, .ra-eras and
     ninety-odd other rules with it — most of the panel and every flag card.
     Twenty-three kilobytes for a block that should have been two. The rules
     below are those, put back. */
  .at-empty p { font-size: 13px; line-height: 1.6; color: var(--ink-2); margin: 8px 0 0; }
  :global(.at-dot) { display: inline-block; width: 7px; height: 7px;
    border-radius: 50%; margin-right: 5px; vertical-align: baseline; }
  /* Matches the hollow marker: rim only, middle empty. */
  :global(.at-hollow-key) { cursor: default; opacity: .75; }
  :global(.at-hollow-key i) { background: transparent !important;
    border: 1.5px solid var(--ink-3); }
  :global(.at-natl-key i) { border-style: dotted !important; }
  /* The two ways out of the panel, beside the heading rather than under the
     fold. Sized and bordered like the bar's own icon buttons so they read as
     controls rather than as decoration next to a title. `align-self: center`
     because .at-h aligns on the baseline, and a 26px box baseline-aligned to a
     22px serif heading sits visibly low. */
  :global(.at-ico) { display: inline-flex; gap: 4px; margin-left: auto;
    align-items: center; align-self: center; flex: 0 0 auto; }
  /* The flag slot. Sized to the icon buttons either side of it so the row
    still reads as a row of controls rather than a picture wedged into one. */
 :global(.at-ico a.at-ico-flag) { padding: 0; overflow: hidden; }
 :global(.at-ico a.at-ico-flag svg) { width: 22px; height: 15px; display: block;
    border: 1px solid var(--rule); }
 :global(.at-ico a) { display: inline-flex; align-items: center;
    justify-content: center; width: 26px; height: 26px; border-radius: 5px;
    border: 1px solid var(--rule); background: var(--panel);
    font-size: 13px; line-height: 1; text-decoration: none; color: var(--ink-2); }
  :global(.at-ico a:hover) { border-color: var(--accent); color: var(--accent); }
  :global(.at-ico a:focus-visible) { outline: 2px solid var(--accent);
    outline-offset: 2px; }
  :global(.at-h h3) { font-family: var(--serif); font-size: 22px; margin: 0; line-height: 1.25; }
  :global(.at-n) { font: 400 11px/1 var(--mono); color: var(--accent); white-space: nowrap; }
  :global(.at-sub) { font: 400 11.5px/1.5 var(--mono); color: var(--ink-3); margin: 6px 0 8px; }
  :global(.at-sec) { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--rule); }
  :global(.at-films) { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 5px; }
  :global(.at-films li) { font-size: 12.5px; line-height: 1.5; }
  :global(.at-y) { font: 400 11px/1 var(--mono); color: var(--ink-3); }
  :global(.ra-who) { font: 400 10.5px/1 var(--sans); color: var(--ink-3); }
  :global(.ra-dot) { width: 9px; height: 9px; border-radius: 50%; display: inline-block;
                     margin-right: 7px; vertical-align: baseline; }
  :global(.ra-juris p) { font-size: 13px; line-height: 1.6; margin: 6px 0 0; }
  :global(.ra-juris.ra-unmapped) { background: transparent; border-left-color: var(--rule-strong); }
  :global(.ra-filed) { font-size: 12.5px !important; }
  :global(.ra-note) { font-family: var(--sans); font-size: 11.5px !important;
                      line-height: 1.55 !important; color: var(--ink-2); margin-top: 8px !important; }
  :global(.ra-arch i) { display: block; width: 11px; height: 11px;
                        border: 2.5px solid #7C8A91; background: var(--ground);
                        transform: rotate(45deg); box-sizing: border-box; }
  :global(.ra-acc) { font-family: var(--sans); font-size: 12px; color: var(--ink-2);
                     margin: 12px 0 0; }
  :global(.at-what) { font-size: 13.5px; line-height: 1.65; margin: 12px 0 0; }
  :global(.ra-surn) { margin-top: 14px; padding: 12px 14px; border-radius: 3px;
                      background: var(--accent-wash); border-left: 2px solid #7A5CA8; }
  /* FULL WIDTH IS FOR THE TIMELINE, NOT FOR THE PROSE. Spanning the card to
     1361px — which is what «shouldnt the name go the whole way across?» asked
     for, and right for the era band and the country rows — set every sentence
     in it as a single 200-character line. The card stays wide; the reading
     stays at a measure a person can follow back to the left margin. */
  :global(.ra-surn p) { font-size: 13px; line-height: 1.6; margin: 6px 0 0; }
  /* THE MEASURE BECAME THE RAGGED EDGE. A 76ch cap is textbook-correct — the
     readable range is about 66 to 90 characters — and in a card 1,900px wide
     it stops the prose at roughly a third, directly under bands that run the
     whole way. David, looking at it: «can all the text go the full width
     across, looks odd cutting off short». He is describing the page, not the
     rule, and he is right: a paragraph ending at 35% under a timeline ending
     at 100% reads as a layout fault rather than a considered line length.
     THE CAP IS GONE, WHICH IS WHAT WAS ASKED FOR TWICE. Columns were tried
     first and are worse: a three-line paragraph split into two columns of a
     line and a half is a different kind of broken. The real cost of removing
     it is long lines on a wide monitor — the thing the cap existed to stop —
     and that is a trade the owner of the page is entitled to make, having now
     looked at both. The panel is not the full window: it is the right-hand
     pane, and the surrounding structure already breaks the prose up with
     labelled rows, so the lines are nothing like the 230 characters a bare
     measurement of the viewport would suggest. */
  :global(.ra-note) { max-width: none; }
  /* First attested sits at the head of the timeline it summarises, so the
     reader meets the claim before the rows it was read from. */
  :global(.ra-first) { margin: 2px 0 8px !important; font-size: 13px; }
  /* Confidence is a word, not a colour alone — a reader who cannot tell the
     greens apart still reads «a lead». The colour follows it. */
  :global(.ra-conf) { font-family: var(--mono); font-size: 10px;
    text-transform: uppercase; letter-spacing: .07em; padding: 1px 6px;
    border-radius: 999px; border: 1px solid currentColor; }
  :global(.ra-conf-3) { color: var(--accent); }
  :global(.ra-conf-2) { color: var(--ink-2); }
  :global(.ra-conf-1) { color: var(--brick); }
  :global(.ra-first b) { font-family: var(--serif); font-size: 15px; }
  :global(.ra-surn b) { font-family: var(--serif); font-size: 18px; }
  :global(.ra-vars) { font-size: 12.5px !important; }
  :global(.ra-vars.ra-weak) { color: var(--ink-3); }
  :global(.ra-tag) { font-family: var(--sans); font-size: 10px; text-transform: uppercase;
                     letter-spacing: .08em; color: var(--ink-3); margin-right: 6px; }
  :global(.ra-dead) { padding: 24px; font-family: var(--sans); font-size: 13px; color: var(--ink-3); }
  .at-tools { display: flex; flex-wrap: wrap; gap: 16px 26px; align-items: flex-end; margin-top: 16px; }
  .at-find { flex: 1 1 280px; }
  #ra-q:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  :global(.at-cat) { font: 400 12px/1 var(--sans); color: var(--ink-3); cursor: pointer;
            background: none; border: 1px solid var(--rule); border-radius: 999px;
            padding: 6px 11px; display: inline-flex; align-items: center; gap: 6px; opacity: .45; }
  :global(.at-cat.on) { opacity: 1; color: var(--ink-2); border-color: var(--ink-3); }
  :global(.at-cat i) { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
  /* ONE OPTION, ONE SHAPE, IN ALL THREE MENUS. */
  :global(.ra-opt) { display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 11px; border: 1px solid var(--rule); border-radius: 999px;
    background: var(--panel); cursor: pointer; white-space: nowrap;
    font: 400 12px/1.2 var(--sans); color: var(--ink-2); }
  :global(.ra-opt.on) { border-color: var(--accent); color: var(--ink); }
  :global(.ra-opt input) { margin: 0; width: 12px; height: 12px;
    accent-color: var(--accent); flex: none; }
  :global(.ra-opt .ra-sw) { width: 9px; height: 9px; border-radius: 50%;
    display: inline-block; flex: none; }
  :global(.ra-opt .ra-n) { font: 500 10.5px/1.6 var(--mono); color: var(--ink-3); }
  /* NOTHING BEHIND IT, AND SAYING SO. Five of the eight access classes are
     empty or near-empty and three are exactly zero; an option that would
     remove nothing, or empty the map, should not look like a live choice. */
  :global(.ra-opt.dead) { opacity: .4; cursor: default; border-style: dashed; }
  :global(.ra-opt.dead .ra-n) { color: var(--ink-3); }
  .ra-copy { font: 400 12px/1 var(--sans); color: var(--accent); cursor: pointer;
             background: none; border: 1px solid var(--rule); border-radius: 3px; padding: 6px 10px; }
  :global(.ra-ico-wide) { width: auto !important; padding: 0 11px;
    gap: 5px; font: 400 12px/1 var(--sans); }
  .ra-find #ra-q { width: 100%; }
  /* [hidden] is a UA rule, and `display: flex` below is an author rule, so
     the author rule wins: the closed dropdown stayed laid out — a 1074x22
     panel-coloured box with a shadow, absolutely positioned six pixels under
     the search input. Once the bar became two rows those six pixels landed
     exactly on the filter row, and elementFromPoint over "Layers" returned
     this box. All three filters were unclickable on the live site. Nothing
     looked wrong, which is why it took a browser asking for the click. */
  .ra-recent[hidden] { display: none; }
  .ra-recent-l { font: 400 11px/1 var(--sans); color: var(--ink-3); }
  :global(.ra-recent-p) { font: 400 11.5px/1 var(--sans); color: var(--ink-2);
    background: var(--panel); border: 1px solid var(--rule); border-radius: 999px;
    padding: 5px 10px; cursor: pointer; }
  :global(.ra-recent-p:hover) { border-color: var(--accent); color: var(--accent); }
  :global(.ra-recent-x) { font: 400 10.5px/1 var(--sans); color: var(--ink-3);
    background: none; border: 0; cursor: pointer; text-decoration: underline;
    padding: 5px 2px; }
  /* ---- the flag cards under the map --------------------------------------
     THE FLAGS ATLAS'S OWN DEVICE, brought across rather than reinvented: a
     card with a coloured top edge keyed to the country, its flag, and the
     crowns as chips. It is the thing David pointed at when he said that site
     feels warmer, and it works here for the same reason it works there —
     colour carrying identity on a card, where it cannot be confused with the
     access classes that colour the dots on the map. Those stay the map's
     vocabulary and are not touched. */
  .ra-flagres { margin: 30px 0 8px; }
  .ra-flagres[hidden] { display: none; }
  .ra-flagres-head h2 { font-family: var(--serif); font-size: 22px; margin: 0; }
  .ra-flagres-head .cap { font-family: var(--mono); font-size: 11.5px;
    color: var(--ink-3); margin: 4px 0 14px; }
  .ra-fsub { font-family: var(--serif); font-size: 17px; margin: 22px 0 10px; }
  .ra-fgrid { display: grid; gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .ra-fgrid-hub { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
  :global(.ra-fcard) { display: block; text-decoration: none;
    background: var(--panel); border: 1px solid var(--rule);
    border-top: 3px solid var(--edge, var(--rule-strong));
    border-radius: 0 0 6px 6px; padding: 11px 13px 12px; }
  :global(.ra-fcard:hover) { border-color: var(--rule-strong);
    border-top-color: var(--edge, var(--accent)); }
  :global(.ra-fcard:focus-visible) { outline: 2px solid var(--accent);
    outline-offset: 2px; }
  :global(.ra-fflag) { display: inline-block; vertical-align: middle;
    width: 30px; margin-right: 9px; }
  :global(.ra-fflag svg) { display: block; width: 100%; height: auto;
    border: 1px solid var(--rule); border-radius: 2px; }
  :global(.ra-fname) { font-family: var(--serif); font-size: 16.5px;
    color: var(--ink); vertical-align: middle; }
  :global(.ra-freg) { display: block; font-family: var(--sans); font-size: 12px;
    color: var(--ink-3); margin: 5px 0 0; }
  :global(.ra-fcrowns) { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
  :global(.ra-fcrown) { font-family: var(--mono); font-size: 10px;
    letter-spacing: .03em; color: var(--ink-2); border: 1px solid var(--rule);
    border-radius: 999px; padding: 2px 7px; }
  :global(.ra-fmeta) { display: block; font-family: var(--mono); font-size: 10px;
    letter-spacing: .05em; text-transform: uppercase; color: var(--brass);
    margin-bottom: 5px; }
  :global(.ra-fwhat) { display: block; font-family: var(--sans); font-size: 12.5px;
    line-height: 1.55; color: var(--ink-2); margin-top: 6px; }
  :global(.ra-fholds) { display: block; font-family: var(--mono); font-size: 11px;
    color: var(--ink); margin-top: 5px; }
  /* The wrapper is the grid cell now; card and link stack inside it, and the
     card grows so every «Show these on the map» sits on the same baseline
     however long the hub's description runs. */
  :global(.ra-fhubwrap) { display: flex; flex-direction: column; }
  :global(.ra-fhubwrap > .ra-fcard) { flex: 1; }
  :global(.ra-fways) { display: block; font-family: var(--sans); font-size: 12px;
    margin-top: 6px; padding: 0 2px; color: var(--accent); text-decoration: none; }
  :global(.ra-fways:hover) { text-decoration: underline; }
  :global(.ra-fsrc) { margin-top: 4px; font-family: var(--sans); font-size: 12px; }
  :global(.ra-fsrc > summary) { cursor: pointer; color: var(--ink-3);
    list-style: none; padding: 2px; }
  :global(.ra-fsrc > summary::-webkit-details-marker) { display: none; }
  :global(.ra-fsrc > summary::before) { content: "\203A"; display: inline-block;
    margin-right: 6px; transition: transform .15s ease; }
  :global(.ra-fsrc[open] > summary::before) { transform: rotate(90deg); }
  :global(.ra-fsrc > summary:hover) { color: var(--brick); }
  :global(.ra-fsrc > summary b) { font-family: var(--mono); font-size: 10.5px;
    font-weight: 500; color: var(--accent); }
  :global(.ra-fsrc ul) { list-style: none; margin: 4px 0 0; padding: 0 0 0 16px; }
  :global(.ra-fsrc li) { margin: 2px 0; line-height: 1.4; }
  :global(.ra-fsrc a) { color: var(--accent); text-decoration: none; }
  :global(.ra-fsrc a:hover) { text-decoration: underline; }
  :global(.ra-fsrc-a) { font-family: var(--mono); font-size: 10px;
    color: var(--ink-3); }
  :global(.ra-hubclear) { font: inherit; color: var(--accent); background: none;
    border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  :global(.ra-hubclear:hover) { color: var(--brick); }
  /* ---- who held this ground -------------------------------------------- */
  .ra-eras { list-style: none; margin: 4px 0 10px; padding: 0; }
  :global(.ra-eras li) { display: grid; gap: 1px 10px; padding: 6px 0;
    grid-template-columns: 5.9em 1fr; border-top: 1px solid var(--rule); }
  :global(.ra-eras li:first-child) { border-top: 0; }
  :global(.ra-era-y) { font-family: var(--mono); font-size: 11.5px;
    color: var(--ink-2); white-space: nowrap; }
  :global(.ra-era-p) { font-size: 12.5px; color: var(--ink); line-height: 1.4; }
  /* The archive sits under the polity rather than beside it: «which archive»
     is the answer to «who governed», not a second fact of equal weight. */
  :global(.ra-era-f) { grid-column: 2; font-family: var(--mono); font-size: 11px;
    color: var(--ink-2); }
  :global(.ra-era-n) { grid-column: 2; font-size: 11.5px; color: var(--ink-3);
    line-height: 1.45; margin-top: 2px; }
  :global(.ra-era-none) { font-family: var(--sans); font-style: italic;
    color: var(--ink-3); }
  .ra-copied { font-family: var(--mono); font-size: 11px; color: var(--ink-3); margin-left: 8px; }
  :global(.ra-base a) { width: auto !important; padding: 0 9px; font: 500 11px/26px var(--sans);
                        text-transform: capitalize; }
  :global(.ra-base a.on) { background: var(--accent-wash); color: var(--accent); font-weight: 600; }

  .at-hint { color: var(--ink-3) !important; font-size: 12px !important; }
  :global(.at-h) { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  :global(.at-also) { font: 400 11.5px/1.5 var(--mono); color: var(--ink-3); margin: 8px 0 0; }
  :global(.ra-juris) { margin-top: 16px; padding: 12px 14px; border-radius: 3px;
                       background: var(--accent-wash); border-left: 2px solid var(--accent); }
  :global(.at-go) { margin: 14px 0 0; font-size: 13px; }
  #ra-q { width: 100%; box-sizing: border-box; margin-top: 6px; padding: 9px 12px;
          font: 400 15px/1.3 var(--serif); color: var(--ink);
          background: var(--panel); border: 1px solid var(--rule); border-radius: 3px; }
  .atlas-key { display: flex; flex-wrap: wrap; gap: 7px; }
  /* The suggestions sit where the remembered searches sit, and never both:
     the list replaces them the moment there is something to suggest. */
  .ra-sug { position: absolute; top: calc(100% + 6px); left: 0; right: 0;
            z-index: 45; max-height: 52vh; overflow-y: auto; padding: 6px;
            background: var(--panel); border: 1px solid var(--rule-strong);
            border-radius: 6px; box-shadow: 0 10px 28px rgba(10, 20, 26, .22); }
  .ra-sug[hidden] { display: none; }
  /* Where the name was, and when — the surname panel's answer to the place
    panel's era band, and deliberately the same furniture. */
 :global(.ra-tw) { margin: 10px 0 0; }
  /* ONE ROW PER COUNTRY, BUILT FROM THE GROUND BAND'S PARTS. The flag and the
     country name hold a fixed column so the bands line up under each other and
     can be read down as well as across; the band itself takes the rest, so the
     same decade sits at the same x on every row. */
  :global(.ra-tw-r) { display: flex; align-items: center; gap: 8px;
    margin: 0 0 3px; }
  :global(.ra-tw-f) { flex: none; width: 21px; height: 14px; display: block;
    border: 1px solid var(--rule); border-radius: 1px; overflow: hidden; }
  :global(.ra-tw-f svg) { width: 100%; height: 100%; display: block; }
  :global(.ra-tw-c) { flex: none; width: 11em; font-size: 12.5px; }
  /* THE BAND'S OWN LOOK, NOT THE BAND'S CLASS. Wearing .ra-tl-band too meant
     inheriting `display: flex` from a rule declared later in this sheet at
     equal specificity — which silently won, and undid the absolute
     positioning below. The frame is three declarations; copying them is
     cheaper than a specificity fight nobody will remember losing. */
  :global(.ra-tw-band) { flex: 1 1 auto; min-width: 0; display: block;
    position: relative; height: 21px; overflow: hidden;
    border: 1px solid var(--rule); border-radius: 3px;
    background: var(--ground); }
  /* Shorter than the ground band: that one carries a polity name under the
     year and this carries only the years, so the extra height would be air. */
  /* min-width keeps a single decade legible; because the segment is
     positioned rather than laid out, growing it past its share pushes
     nothing off the row — it just overlaps the empty ground beside it. */
  :global(.ra-tw-band .ra-tw-seg) { position: absolute; top: 0; bottom: 0;
    min-width: 52px; padding: 2px 5px; border-top-width: 3px; cursor: default;
    display: flex; align-items: center; }
  :global(.ra-tw-band .ra-tl-y) { font-size: 10.5px; white-space: nowrap; }
  /* A GAP IS THE POINT, SO IT IS DRAWN AS ONE — and now it needs no element
     of its own. De Franceschi is in Italy in the 1550s and then not again
     until the 1840s; with the runs placed on the scale, the silence is the
     band's own ground showing through between them, which is what it is. */
  /* Full width, because it is not a span and must not read as one. */
  :global(.ra-tw-none) { position: absolute; inset: 0; display: flex;
    align-items: center; padding: 2px 7px; border-top-width: 3px;
    border-top-style: solid; }
  :global(.ra-tw-none .ra-tl-y) { font-size: 10px; color: var(--ink-3);
    font-family: var(--sans); letter-spacing: .02em; }
  /* One country per line, flag first, the way the band above reads. */
  :global(.ra-vol li) { display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 6px; }
  :global(.ra-vol .ra-tw-f) { align-self: center; }
  :global(.ra-vol .ra-ck-n) { flex: 1 0 100%; margin: 0 0 0 29px; }
  /* The source, said on the row rather than in a key nobody reads. */
  :global(.ra-tw-src) { flex: none; font-family: var(--mono); font-size: 9px;
    letter-spacing: .05em; text-transform: uppercase; padding: 1px 4px;
    border-radius: 2px; border: 1px solid var(--rule); color: var(--ink-3);
    cursor: help; }
  :global(.ra-tw-src-ar) { color: var(--brick); border-color: var(--brick); }
  /* An archive row is drawn from counted people rather than from a handful of
     notable ones, so it reads as the more solid of the two. */
  :global(.ra-tw-seg-ar) { border-top-style: double; border-top-width: 5px; }
    :global(.ra-tw-axis) { display: flex; justify-content: space-between;
    margin: 4px 0 0; font-family: var(--mono); font-size: 10.5px;
    color: var(--ink-3); }
  :global(.ra-tw-c2) { margin: 6px 0 0; }
 :global(.ra-orig) { margin: 8px 0 0; padding: 9px 11px;
    background: var(--ground); border-left: 3px solid var(--brass);
    border-radius: 0 3px 3px 0; }
 :global(.ra-orig-l) { margin: 0 0 3px; font-size: 13px; }
 :global(.ra-orig-c) { margin: 4px 0 0; }
 :global(.ra-orig-s) { margin: 6px 0 0; font-size: 11.5px; color: var(--ink-3); }
  /* TWO SOURCES HAVE TO LOOK LIKE TWO SOURCES. Wikidata and Wiktionary can
     and do disagree about a name, and stacking two identical brass-edged
     blocks would read as one authority saying two things. The edge is the
     only difference that is needed — the label under each already names who
     said it, and the point of this whole pair of blocks is that the reader
     can see which claim came from where. */
  :global(.ra-orig-wk) { border-left-color: var(--brick); }
 :global(.ra-sug-h) { margin: 6px 0 3px; padding: 0 8px; font-family: var(--mono);
    font-size: 9.5px; letter-spacing: .07em; text-transform: uppercase;
    color: var(--brass); }
  :global(.ra-sug-r) { display: flex; align-items: baseline; gap: 9px;
    width: 100%; padding: 6px 8px; background: none; border: 0; cursor: pointer;
    border-radius: 4px; text-align: left; font-family: var(--sans);
    font-size: 13.5px; color: var(--ink); }
  :global(.ra-sug-r.on), :global(.ra-sug-r:hover) { background: var(--accent-wash); }
  :global(.ra-sug-n) { font-weight: 500; }
  :global(.ra-sug-m) { font-size: 11.5px; color: var(--ink-3); }
  :global(.ra-sug-c) { margin-left: auto; font-family: var(--mono);
    font-size: 10.5px; color: var(--ink-3); white-space: nowrap; }
  /* A GAZETTEER ROW IS A REAL ANSWER AND A LESSER ONE. It is the name you
     typed and a place that exists; it is not somewhere this atlas has walked
     a register. Marked by a rule rather than by dimming — opacity would take
     the contrast down with it, which this project has already paid for once
     — so it reads as a second rank without becoming hard to read. */
  :global(.ra-sug-g) { border-left: 2px solid var(--rule-strong); }

  .ra-recent { position: absolute; top: calc(100% + 6px); left: 0; right: 0;
               z-index: 40; display: flex; align-items: center; gap: 6px;
               flex-wrap: wrap; padding: 10px 12px;
               background: var(--panel); border: 1px solid var(--rule-strong);
               border-radius: 6px; box-shadow: 0 10px 28px rgba(10, 20, 26, .22); }

  /* MY OWN EDITS TO THESE, RE-APPLIED. .at-also and the page link ride on the
     heading row now rather than sitting under it — see the note in render(). */
  :global(.at-also) { font: 400 11.5px/1.5 var(--mono); color: var(--ink-3);
    margin: 0; }
  /* The icons take the place the sentence used to hold on the heading row.
     Nothing else is needed: `.at-ico a` above already gives every icon in this
     group its box, its border and its hover, so the page icon inherits the
     same shape as the flag beside it. The first cut restated all of that on a
     class of its own and check-built.py caught it — «selectors declared in a
     style block never reach the built CSS» is exactly what a redundant rule
     looks like from the outside. */
  :global(.at-h .at-ico) { margin-left: auto; }
  :global(.at-h .at-go) { margin: 0 0 0 auto; font-size: 12.5px;
    white-space: nowrap; }

  /* ---- who held this ground, as a band -----------------------------------
     Width is duration, colour is the regime's own, hatching is «no archive
     holds this yet». The reasoning is on eraBand().

     ALL OF THESE ARE :global(). The band is written into the panel by script,
     so its elements never carry Astro's scope class and a plain selector
     never reaches them — the same trap that made the first version of this
     band render as unstyled buttons. */
  :global(.at-era-src) { display: contents; }
 /* The neighbourhood caption. The swatch is the ring on the map, so the two
    are recognisably the same thing without a legend. */
 /* ---- the visitor's checklist -------------------------------------------
     TIED TO THE MAP'S HEIGHT, NOT ITS OWN. David: «why is the list extending
     past the map, it should be scrollable?» — it was running to its content,
     which for a place with twenty villages in the ring is far taller than the
     map beside it, so the column dragged the whole row down. Same clamp the
     map uses, and it scrolls inside that.

     AND A RAIL WHEN SHUT. 44px with the word on its side, rather than a
     full-width button sitting in an empty column. */
  .ra-check { align-self: start; background: var(--panel);
    border: 1px solid var(--rule); border-top: 3px solid var(--accent);
    border-radius: 0 0 3px 3px; width: 44px; overflow: hidden;
    height: clamp(380px, calc(100vh - var(--ra-above, 340px)), 620px);
    display: flex; flex-direction: column; }
  .ra-check.on { width: min(320px, 34vw); }
  .ra-check-t { flex: none; display: flex; align-items: center; gap: 8px;
    width: 100%; padding: 10px 11px; cursor: pointer; background: none;
    border: 0; border-bottom: 1px solid var(--rule); font-family: var(--sans);
    font-size: 12px; color: var(--ink-2); text-align: left; }
  .ra-check-t:hover { color: var(--accent); }
  .ra-check-i { flex: none; font-size: 14px; line-height: 1; }
  .ra-check:not(.on) .ra-check-w { writing-mode: vertical-rl; margin-top: 6px;
    letter-spacing: .04em; }
  .ra-check:not(.on) .ra-check-t { flex-direction: column; padding: 10px 4px;
    border-bottom: 0; }
  .ra-check-n { font-family: var(--mono); font-size: 10.5px; color: var(--brass); }
  /* The scroller is the body, so the toggle stays put while the list moves. */
  .ra-check-b { flex: 1 1 auto; min-height: 0; overflow-y: auto;
    -webkit-overflow-scrolling: touch; padding: 4px 13px 14px; }
  :global(.ra-check-b h4) { font-family: var(--mono); font-size: 9.5px;
    letter-spacing: .07em; text-transform: uppercase; color: var(--brass);
    margin: 14px 0 5px; font-weight: 400; }
  :global(.ra-check-b ul) { list-style: none; margin: 0; padding: 0; }
  :global(.ra-check-b li) { font-size: 12.5px; line-height: 1.45; margin: 0 0 6px; }
  /* «7.7 kmOn paper, in the building» — the distance and the note ran into
     each other. The note takes its own line, which is where it reads best in
     a column this narrow anyway. */
  /* The number, in the list and on the map, the same on both. */
 /* `hidden` LOSES TO A DISPLAY RULE, EVERY TIME. Setting el.hidden = true
    only works while nothing else sets `display`; .ra-check is display:flex and
    .at-body is display:grid, so both went on rendering after being hidden —
    the checklist sat there as an empty «Visiting» column taking a third of the
    map, and the panel below kept its layout. The attribute is the state; these
    two lines are what make the state mean anything. */
 .ra-check[hidden] { display: none; }
 :global(.at-body[hidden]) { display: none; }

 :global(.at-films .ra-vx) { display: none; }
 :global(.at-films.ra-vopen .ra-vx) { display: list-item; }
 :global(.ra-vmore-b) { margin-top: 4px; padding: 3px 9px; cursor: pointer;
    font-family: var(--sans); font-size: 11.5px; color: var(--accent);
    background: none; border: 1px solid var(--rule-strong); border-radius: 999px; }
 :global(.ra-vmore-b:hover) { border-color: var(--accent); }
 :global(.ra-sn) { padding: 0; background: none; border: 0; cursor: pointer;
    font-family: var(--sans); font-size: 13px; color: var(--accent);
    text-decoration: underline; text-decoration-color: var(--rule-strong); }
 :global(.ra-sn:hover) { color: var(--brick); }
 /* A match is a button because it selects rather than navigates. */
 :global(.ra-mk) { display: flex; align-items: baseline; gap: 0; width: 100%;
    padding: 3px 4px; margin: 0 0 1px -4px; background: none; border: 0;
    border-radius: 3px; cursor: pointer; text-align: left;
    font-family: var(--sans); font-size: 12.5px; color: var(--ink); }
 :global(.ra-mk:hover) { background: var(--accent-wash); }
 :global(.ra-mk-n) { text-decoration: underline;
    text-decoration-color: var(--rule-strong); }
 :global(.ra-mk .ra-ck-n) { margin-left: auto; padding-left: 8px; }
 :global(.ra-ck-i) { display: inline-flex; align-items: center;
    justify-content: center; width: 17px; height: 17px; flex: none;
    margin-right: 6px; border-radius: 50%; background: #1B2A5B; color: #fff;
    font-family: var(--mono); font-size: 9.5px; line-height: 1; }
 :global(.ra-pin) { display: flex !important; align-items: center;
    justify-content: center; border-radius: 50%; background: #1B2A5B;
    color: #fff; font-family: var(--mono); font-size: 10px; font-weight: 500;
    border: 1.5px solid #fff; box-shadow: 0 1px 4px rgba(10, 20, 26, .45); }
 :global(.ra-ck-km) { font-family: var(--mono); font-size: 10.5px;
    color: var(--ink-3); margin-left: 5px; white-space: nowrap; }
  :global(.ra-ck-n) { display: block; font-size: 11px; color: var(--ink-3); }
  :global(.ra-ck-more) { font-size: 11px; color: var(--ink-3); font-style: italic; }
  /* A run of archives belongs to a country, and the pane says which — the
     place pane groups by KIND (archives, parishes, graves) because everything
     in it is near one point. Nothing in a name's list is near anything, so
     the country is the only grouping that means something. */
  :global(.ra-ck-cc) { display: flex; justify-content: space-between;
    align-items: baseline; margin: 12px 0 4px; padding-bottom: 3px;
    border-bottom: 1px solid var(--rule); font-family: var(--mono);
    font-size: 9.5px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-3); }
  :global(.ra-ck-cc:first-child) { margin-top: 0; }
  /* A link, not a button, to look at — it sits mid-sentence and a grey box
     there would read as a form control in a paragraph. */
  :global(.ra-open-check) { padding: 0; border: 0; background: none;
    font: inherit; color: var(--accent); cursor: pointer;
    text-decoration: underline; text-underline-offset: 2px; }
  :global(.ra-open-check:hover) { color: var(--ink); }
  :global(.ra-ck-cc a) { color: var(--ink-2); text-decoration: none; }
  :global(.ra-ck-cc a:hover) { color: var(--accent); }
  /* The place pane's key is the navy dotted ring, because that is what is
     drawn on the map. A name has no ring — the pins are the whole of it — so
     the key is a pin. */
  :global(.ra-hood-k-n) { width: 15px; height: 15px; border-radius: 50%;
    border-style: solid; background: #1B2A5B; }
  :global(.ra-check-b .ra-dot) { margin-right: 5px; }
  @media (max-width: 900px) {
    /* ONE COLUMN, AND THE CHECKLIST BECOMES A ROW. This rule was written once
       and lost — a patch of mine reported it applied and had not — so the
       phone kept the desktop's `1fr auto` with the checklist beside the map.
       At 375px that leaves the map a sliver, and in full screen, where the
