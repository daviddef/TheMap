---
/* The map. Three layers, a year, and a panel that fetches.

   Descended from the Atlas in the family archives, and different from it in
   three ways that matter.

   ONE — THE COLOUR ANSWERS A STRANGER'S QUESTION. The archive it came from
   coloured a parish by how far one researcher had got with it, which is a true
   and useful thing to know if you are that researcher and meaningless if you
   are not. Here the colour says what you can actually OPEN: free images,
   images behind a login, an index, a paywall, a catalogue card, or paper in a
   building. A place takes the colour of the MOST OPEN thing it has, because
   the question is "can I see anything tonight", and the panel tells the rest.

   TWO — THE YEAR IS A FILTER, NOT A DECORATION. Set it to 1863 and the map
   does not merely shade the borders of 1863: it drops every place that cannot
   answer for that year, and every panel gains the line that is the whole
   reason this site exists — which empire's filing system this ground fell
   under, and therefore whose archive to write to.

   THREE — THE PANEL FETCHES. The index carries only what a marker needs to be
   drawn and found. Everything else arrives per place, on click, from
   p/<id>.json. 1,239 places is 145 KB rather than 2.5 MB, and the number that
   grows with the world is the one that compresses.

   Everything else — the find box, the filter pills, that every view is a link
   — is the family Atlas's and is kept deliberately, because a reader who knows
   one of these maps should know all of them. */
const { indexUrl, detailBase, regionsUrl, providersUrl, gazBase, surnameBase, belgiumBase, wikidataUrl, osmUrl, featureBase, settlementBase, districtBase, countryBase, townlandBase, comuneBase, estoniaBase, scotlandBase, worldArchivesUrl, countryPointsUrl, base } = Astro.props;

/* The long explanation the idle panel used to carry in full now lives at
   /help/, and the panel links to it. Derived from `base` so it survives the
   /TheMap/ prefix on GitHub Pages, which a hard-coded "/help/" would not. */
const HELP = base.replace(/\/$/, "") + "/help/";
---

{/* ONE BAR, NOT THREE PANELS. The search box, seven layer switches, the year
    control and the copy button used to stack to roughly eight hundred pixels
    of apparatus above a map — a visitor holding a surname had to scroll past
    the entire instrument to reach the map it drives.
    Everything is still here and nothing is hidden: the counts and the
    explanations moved into `title`, which is a tooltip on a desktop and a long
    press on a phone, and the ⓘ button opens the lot as plain text for anyone
    who cannot hover. A control that explains itself on demand is not the same
    as a control that explains itself at you. */}
<div class="ra-bar">
  {/* TWO ROWS, EXPLICITLY. The bar was one wrapping flex line, so where a
      control landed depended on the width of everything before it — the
      buttons drifted onto their own row on a narrow window and sat in the
      middle of the filters on a wide one. David asked for them on the
      search line, at the right. Two rows that say which is which do that,
      and stop the layout being an accident of arithmetic. */}
  <div class="ra-bar-row ra-bar-find">
    {/* A DROPDOWN ON THE SEARCH BOX, NOT A ROW OF ITS OWN. The remembered
        searches sat in the bar all the time, which is a lot of standing
        real estate for something wanted at the start of a visit and never
        again. David asked for it on focus. It appears under the box when
        you click in with the box empty, and gets out of the way the moment
        you type — these are the searches you made, not suggestions for the
        one you are making. */}
    <div class="ra-find">
      <input id="ra-q" type="search" autocomplete="off"
             aria-label="Find a place or a surname, by any name it has ever had"
             role="combobox" aria-expanded="false" aria-controls="ra-sug"
             aria-autocomplete="list"
             aria-describedby="ra-recent"
             placeholder="Find a place or a surname — Gallignana · Žubrinić · Lerena" />
      {/* role="group", because a div has no role and aria-label is prohibited
          on a roleless element — so the name this box was given was being
          discarded, and the one thing it had to say to a screen reader was
          the one thing it did not say. */}
      <div class="ra-recent" id="ra-recent" hidden role="group"
           aria-label="Searches you made before"></div>
      {/* ---- THE SUGGESTIONS, UNDER THE BOX ---------------------------------
          David: «cant we "smart search" this search field, so the choice
          happens in the search box dropdown smartly rather than this clunky
          window?» — so the choosing happens here, where the typing is, and
          the strip that used to sit above the map is gone.

          It answers with BOTH kinds at once, which is the thing the map could
          never do: «taylor» is four American villages and a surname borne in
          eleven countries, and until now a search could only be told one of
          those. Places first because this is a map, the name after them under
          its own heading, and an exact match outranks everything. */}
      <div class="ra-sug" id="ra-sug" hidden role="listbox"
           aria-label="Matching places and names"></div>
    </div>
    {/* THE FILTER SITS WITH THE SEARCH, NOT UNDER IT. David: «filter icon
        should be on right of search box, not taking 2 lines.» It was its own
        .ra-bar-row, so the bar was a search line and a filter line — two rows
        of chrome above a map, for one button. It is one control now and it
        belongs beside the box it filters. */}
    <div class="ra-bar-filters">
    {/* THREE FILTERS, THREE DIFFERENT SHAPES. The layers were eight loose
        pills in a row while «what it costs» and «what kind» were tidy
        disclosures that said how many were on — so the one control a reader
        touches most looked like scattered chrome beside two that looked
        designed. David said it was messy and it was. All three are the same
        control now, each saying its own state in its summary.

        AND ALL THREE LIVE IN THE BAR. The other two sat under the map, which
        meant full screen hid them exactly as it hid the search box — the same
        bug, two controls further along, and it would have been found the same
        way eventually. */}
    {/* AND NOW ONE CONTROL, NOT THREE. David: «can we consolidate the filter
        fills into a single filter icon that shows them all under one?» Three
        disclosures side by side spent the width of the bar saying «Layers 2
        · Costs All · Kind All», which is three states a reader has to read
        and reconcile before touching anything — and on a phone they wrapped
        onto their own line and pushed the map further down.

        One «Filters» disclosure holds all three panels and its summary says
        the combined state, so a closed control still answers «what is on the
        map». The three inner groups keep their own headings, because they
        filter different things and merging their vocabularies would be the
        real mess. */}
    <details class="ra-cats-wrap ra-drop ra-filters-one" id="ra-layersw">
      {/* AN ICON, NOT A WORD. David: «can filters just be a filter icon, no
          text». The word cost a third of the bar on a phone to say what a
          funnel says. The state is kept, but only when there IS a state: a
          count appears beside the funnel when something is actually filtered
          and nothing appears when everything is on, so the control is quiet
          by default and speaks when it has something to say. The full
          sentence is still in the title and the aria-label, which is where a
          reader who needs it goes and where a screen reader looks. */}
      <summary id="ra-laysum" aria-label="Filters — layers, cost and record kind"
               title="Filters — layers, cost and record kind"></summary>
      <div class="ra-drop-in">
        <p class="ra-fgroup-h">Layers</p>
        <p class="ra-key-lead">What the map draws. The shelf is the places and
          their volumes; the rest are context, and the unchecked ones cost
          nothing until you ask for them.</p>
        <div class="ra-layers" id="ra-layers"></div>

        <p class="ra-fgroup-h" id="ra-catsum">What it costs to look</p>
        <p class="ra-key-lead">Ordered from what you can open tonight down to what
          needs a letter. <b>A place takes the colour of the most open thing it
          has</b> — so red means red is the best on offer there, and green says
          nothing about what else is underneath it. The panel lists the rest.
          Click a colour to take it off the map.</p>
        <div class="atlas-key" id="ra-cats"></div>

        <p class="ra-fgroup-h" id="ra-kindsum">What kind of record</p>
        <div class="atlas-key" id="ra-kinds"></div>
      </div>
    </details>
    {/* PLAY IT, BECAUSE THE ARGUMENT IS A CHANGE OVER TIME.
        This atlas exists to say that ground changed hands and the paper
        followed it — that an 1863 baptism from a Croatian village is in a
        Croatian archive and a 1930 one from the same village is filed under
        Italy. That is a sentence on the about page and a slider somebody
        has to think to drag. Run it and it is the map telling you: Venice
        gives way to Austria gives way to Italy gives way to Yugoslavia over
        one piece of Istria, while the dots thin to the books that can
        answer for the decade on screen.
        A window, not a point: it walks a fifty-year range forward a decade
        at a time, because records come in runs and a single year empties
        the map. */}
    {/* «↺» AT TWELVE PIXELS IS A SMUDGE. David could not tell what it was, and
        an icon nobody recognises is a button nobody presses. The others in this
        row are conventional enough to stand alone — ⓘ, a link, the full-screen
        corners — but «start again» has no agreed glyph, so it gets a word. */}
    {/* THE COUNT REPORTS ON THE FILTERS AND SAT NOWHERE NEAR THEM. It lived
        under the map, which put it outside the element that goes full screen
        — so the one line that says whether a filter did anything was missing
        in the mode where the map is biggest. David asked for it up here with
        the rest.

        `margin-left: auto` sends it to the right-hand end of the bar when
        there is room and lets it take its own line when there is not, which
        matters because this is not always short: set a year nothing can
        answer for and it becomes a sentence explaining why the map is empty,
        with a way out. That message is better placed here than below a map
        the reader has already decided is broken. */}
  </div>
    {/* THE TITLE IS FOR THE POINTER; THE LABEL IS FOR EVERYBODY ELSE. All
        five of these carried a `title`, so hovering always explained them —
        but a button whose only content is an emoji announces itself to a
        screen reader as its emoji's name, or as nothing. `title` is not a
        reliable accessible name and never was; ra-reset below already had
        both, and the other four are now brought up to it. The glyph is
        hidden from the accessibility tree so the label is not read twice. */}
    <button class="ra-ico" id="ra-info" type="button" aria-expanded="false"
            aria-label="What these controls mean"
            title="What these controls mean"><span aria-hidden="true">&#9432;</span></button>
    <button class="ra-ico" id="ra-copy" type="button"
            aria-label="Copy a link to this exact view"
            title="Copy a link to this exact view"><span aria-hidden="true">&#128279;</span></button>
    <button class="ra-ico" id="ra-full" type="button"
            aria-label="Full screen — the map and its panel fill the window"
            title="Full screen — the map and its panel fill the window"><span aria-hidden="true">&#9974;</span></button>
    {/* IT CAME ALONG WITH THE FILTER AND SHOULD NOT HAVE. «1 of 21,754 places
        shown» was the last child of the filters block, so when that block
        moved up beside the search box the count moved with it and ended up
        wedged under the funnel. It belongs at the end of the row, where it
        can take a line of its own when the message grows into a sentence. */}
    <button class="ra-ico" id="ra-reset" type="button"
            aria-label="Start again — clear the search, the year, the filters and the layers, and go back to the whole world"
            title="Start again — clear the search, the year, the filters and the layers, and go back to the whole world"><span aria-hidden="true">&#8634;</span></button>
    <span class="cap" id="ra-count" role="status" aria-live="polite"></span>
    <span class="ra-copied" id="ra-copied" hidden>copied</span>
  </div>
</div>
<div class="ra-help" id="ra-help" hidden></div>

<div class="at-wrap">
  {/* A CANVAS OF CIRCLES IS NOT REACHABLE BY KEYBOARD, and pretending
      otherwise helps nobody. Leaflet with preferCanvas draws 21,302 dots
      into one element: there are no focusable markers to tab through and
      making them focusable would mean 21,302 tab stops, which is worse
      than none. So the map is labelled for what it is, and the reader is
      told where the same answers live in text — the search box reaches
      every place by any name it has ever had, and /places/ lists them
      all with a page each. That is an honest fallback rather than an
      ARIA costume over an unusable control. */}
  <div class="at-map" id="ra-map" role="application"
       aria-label="Map of places and archives. Not keyboard-navigable: use
                   the search box above, which finds any place by any name
                   it has ever had, or the full list of places linked below.">
    {/* THE MAP WAS A GREY BOX FOR AS LONG AS THE FETCHES TOOK, and a grey
        box is indistinguishable from a broken one. This says what is
        coming and how much of it, is server-rendered so it is on screen
        in the first paint, and is removed the moment the markers are
        drawn. It is not a spinner: a number tells the reader the wait is
        proportionate to something. */}
    {/* THE YEAR BELONGS TO THE MAP, NOT TO THE TOOLBAR.
        David: «can year slider go at base of map? more like an animation
        bar? doesnt need to be at the top». It is a scrubber — it plays,
        it has a handle you drag, and what it changes is the picture. Up
        in the bar it read as one more setting among eight; along the
        bottom of the map it reads as what it is.

        It sits 26 pixels up so it never covers OpenStreetMap's
        attribution, which is a licence condition and not decoration, and
        below Leaflet's own controls at z-index 1000 so zoom and the
        basemap switcher stay clickable. Being inside the map means full
        screen carries it without anything extra. */}
    <div class="ra-time" id="ra-time">
  <button class="ra-ico" id="ra-play" type="button" aria-pressed="false"
            aria-label="Play the years — watch the jurisdictions change and the records follow"
            title="Play the years — watch the jurisdictions change and the records follow"><span aria-hidden="true">&#9654;</span></button>
    <label class="ra-ylab" id="ra-ylab"
           title="Set a year and the map keeps only the places that can answer for it, the volume lists narrow to it, and every panel says whose archive those years belonged to.">
      <input type="checkbox" id="ra-yon"
             aria-label="Filter by year"
             title="Turn the year filter on or off" />
      <span class="ra-slider">
        <span class="ra-track" id="ra-track"></span>
        <input type="range" id="ra-year" min="1500" max="2026" value="1780" step="1" disabled
               aria-label="Earliest year" />
        <input type="range" id="ra-year2" min="1500" max="2026" value="1920" step="1" disabled
               aria-label="Latest year" />
      </span>
      <span class="ra-ylab-w">Year</span>
      <output id="ra-yout" class="mono">any year</output>
    </label>
    </div>
    <div class="ra-loading" id="ra-loading">
      <span class="ra-loading-b"></span>
      <span id="ra-loading-t" data-i18n>Loading the atlas&hellip;</span>
    </div>
  </div>
  {/* THE PANEL REWRITES ITSELF AND SAID NOTHING WHILE DOING IT.
      Every answer on this map arrives by replacing this element's
      innerHTML — a place, a surname, a country, a region. A sighted
      reader sees the change; a screen reader was told nothing at all,
      because nothing announced it. aria-live="polite" reads the new
      panel after the current utterance instead of interrupting, which is
      right for a result that follows a search the reader just typed.
      The count below is its own region for the same reason: «0 of 21302
      places shown» is the answer to a filter, and it was silent. */}
  {/* THE RAIL THAT USED TO BE HERE IS GONE, AND THE MAP HAS ITS WIDTH BACK.
      David: «arent we showing the same thing 2 different ways?» We were, and
      worse than that: they were two DIFFERENT sequences under one caption.
      The rail showed Croatia's national flag eras — seventeen of them, 925
      onwards. The band below the map showed Central Istria's record-region
      eras — eight, from 1200, each with the archive that holds its paper.
      Both said «who held it», and for Istria they disagree, because Istria
      was Venetian while Croatia proper was Habsburg.

      So there is one timeline now, and which one depends on what is known:
        · ground covered by a record region -> the band, coloured by regime,
          because that is the answer that also names an archive;
        · ground with no region yet -> the country's flag eras, as a band with
          the drawn flags on it, which is the best that can honestly be said.
      Never both. The «see the flags these regimes flew» link is still at the
      foot of the band for the ground that has a region. */}

  {/* ---- THE VISITOR'S CHECKLIST ------------------------------------------
      David, on the ring's caption: «this list? its meaningless if i cant know
      what they are. should we add a collapsed right pane … as a "visitors
      checklist" to include the list of things in the best order we can to go
      and research in the vicinity?»

      Quite right — «14 places · 3 parishes · 3 burial grounds» is a count you
      cannot act on, and every one of those things is already named in the
      data with a distance against it. The order is the order of a research
      day, not alphabetical: the archive that holds the paper first, because
      that is the appointment you have to make; then the parishes whose
      priests wrote the registers; then the burial grounds, which are open
      whenever you are; then the villages inside the ring, whose own registers
      may name the same family.

      Collapsed by default. It is the answer to a question the reader has not
      asked yet, and an open pane would take a third of the map to say so. */}
  <aside class="ra-check" id="ra-check" hidden>
    <button class="ra-check-t" id="ra-check-t" type="button"
            aria-expanded="false" aria-controls="ra-check-b">
      <span class="ra-check-i" aria-hidden="true">&#9776;</span>
      <span class="ra-check-w" data-i18n>Visiting</span>
      <span class="ra-check-n" id="ra-check-n"></span>
    </button>
    <div class="ra-check-b" id="ra-check-b" hidden></div>
  </aside>

  <aside class="at-panel" role="region" aria-live="polite"
         aria-label="What the map found">
    {/* «PICK A PLACE» ASKED THE READER TO ALREADY KNOW THE ANSWER.
        Most people arrive holding a surname, a half-remembered village, or
        nothing but a country — and the first thing this said was «click
        any marker», which assumes they know which. Three ways in, in the
        order people actually have them, and the legend's one idea stated
        in a sentence instead of hidden in a filter: the colour is what it
        costs to look. */}
    {/* ON A PHONE THE ANSWER ARRIVED BELOW THE FOLD. The panel stacks
        under the map at 900px, so tapping a dot filled a box the reader
        could not see and gave no sign anything had happened — they tapped
        again, and again. Under 700px a result becomes a sheet over the
        bottom of the map, which is where every phone map on earth puts
        one. It needs a way back out that is not a scroll, hence this.
        It is driven off :has() on the body's hidden attribute, so there
        is no state to keep in sync; a browser without :has() simply keeps
        the stacked panel it has today. */}
    <button class="ra-sheet-x" id="ra-sheet-x" type="button"
            title="Close this result and go back to the map">
      &#9662;&nbsp;<span data-i18n>Back to the map</span></button>
    {/* SIX HUNDRED PIXELS EXPLAINING A SEARCH BOX. David, on the old version
        of this block: «there isnt much point wasting real estate on describing
        what you can search for, its a terrible real estate waste.» He was
        right, and it got worse when the panel moved under the map: as a 360px
        column the three-item list and two paragraphs were a sidebar, at full
        width they were a wall between the map and the flags.

        What survives is the part a reader can ACT on — four example searches
        that run on click, because «a village by any name it ever had» is an
        abstraction until Breslau finds Wrocław. The rest is a link. The
        sentence about what a dot's colour means was the best paragraph on the
        page and it is still a paragraph nobody asked for; it lives on /help/
        and in the ⓘ, which is where somebody goes when they want it. */}
    <div class="at-empty" id="ra-empty">
      <p class="at-start">
        <b data-i18n>Start with what you have.</b>
        A surname &mdash;
        <a href="#" class="ra-try" data-q="Peeters"
           title="Run this search: Peeters &mdash; a Belgian name">Peeters</a>,
        <a href="#" class="ra-try" data-q="Blažević"
           title="Run this search: Blažević &mdash; a Croatian name">Blažević</a>
        &mdash; a village by any name it ever had &mdash;
        <a href="#" class="ra-try" data-q="Gallignana"
           title="Run this search: Gallignana &mdash; the Italian name of Gračišće">Gallignana</a>
        finds Gračišće,
        <a href="#" class="ra-try" data-q="Breslau"
           title="Run this search: Breslau &mdash; the German name of Wrocław">Breslau</a>
        finds Wrocław &mdash; or click any country on the map.
      </p>
      <p class="at-start-more">
        <a href="{HELP}"><span data-i18n>The colour of a dot is what it costs to look</span> &rarr;</a>
      </p>
      {/* THE THIRD COUNTS LINE IS GONE. David, counting them: «in this one
          area i see 3 different places you talk about volumes» — the masthead
          dek, the filter counter under the search box, and this. And it said
          «Search by any name a place has ever had — Gallignana finds
          Gračišće» directly beneath a paragraph that already says «a village
          by any name it ever had — Gallignana finds Gračišće», with the same
          example. Two sentences, four claims, nothing new in any of them.
          The dek states the size of the atlas, the counter answers a filter;
          this had no question of its own to answer. */}
    </div>
    <div class="at-body" id="ra-body" hidden></div>
  </aside>
</div>

{/* ---- THE FLAGS, UNDER THE MAP AND ON THE SAME SEARCH --------------------
    David asked for the Flags Atlas's own countries-and-hubs cards to sit
    below the map and filter as you type, the way its index page does. So one
    search box now answers two questions at once: where the records are, and
    who governed the ground.

    IT SHARES THE MAP'S BOX RATHER THAN ADDING ONE. Two search fields on one
    page is two places to look and two states to reconcile; the reader types
    once. The section is hidden until the data arrives and hidden again when
    nothing matches, so a fruitless search does not leave a wall of 210 cards
    contradicting an empty map.

    FETCHED, NOT BUNDLED. 164 KB of cards and hand-drawn flags is not worth
    delaying the first paint for, so it arrives after the map is up. */}
<section class="ra-flagres" id="ra-flagres" hidden aria-live="polite">
  <div class="ra-flagres-head">
    <h2 id="ra-flagres-h">Whose flag flew there</h2>
    <p class="cap" id="ra-flagres-sub"></p>
  </div>
  <div class="ra-fgrid" id="ra-fcountries"></div>
  <h3 class="ra-fsub" id="ra-fhubs-h" hidden>The hubs</h3>
  <div class="ra-fgrid ra-fgrid-hub" id="ra-fhubs"></div>
</section>



{/* The map cannot draw without these three, and the browser cannot know
    that from markup it never sees — they are fetched by script. A preload
    lets it start them at the same time as the stylesheets instead of
    after them, and a preconnect opens the CDN socket while the parser is
    still working. Measured cost of not doing it: index.json was not even
    requested until 4,821 ms. */}
<link rel="preload" as="fetch" href={indexUrl} crossorigin />
<link rel="preload" as="fetch" href={regionsUrl} crossorigin />
<link rel="preload" as="fetch" href={providersUrl} crossorigin />
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>

<script is:inline define:vars={{ INDEX: indexUrl, DETAIL: detailBase, REGIONS: regionsUrl, PROVIDERS: providersUrl, GAZ: gazBase, SURN: surnameBase, BSURN: belgiumBase, WDA: wikidataUrl, OSMA: osmUrl, FEAT: featureBase, SETT: settlementBase, DIST: districtBase, CTRY: countryBase, TOWN: townlandBase, COMU: comuneBase, ESTO: estoniaBase, SCOT: scotlandBase, WARCH: worldArchivesUrl, CPTS: countryPointsUrl, BASE: base }}>
/* ASK FOR THE DATA NOW, NOT AFTER EVERYTHING ELSE HAS LOADED.
   Measured on the live site rather than reasoned about, which is what
   should have happened the first time:

     first contentful paint   4,500 ms
     index.json REQUESTED     4,821 ms
     index.json arrived       5,696 ms   (422 KB)

   The map has always been built inside window.load, which fires only
   after every image, font, stylesheet and CDN script on the page has
   finished. So the one fetch the map cannot start without sat waiting
   nearly five seconds for things it does not need, and then took 875 ms.
   Splitting index.json from 533 KB to 419 KB — a careful, well-argued
   change — saved about 100 KB on a request that had not been made yet.
   That is what comes of budgeting bytes and never timing anything.

   The request starts here, while the parser is still working and while
   Leaflet is still downloading. `load` then waits on a promise that is
   usually already settled. Nothing else changes: the map still needs
   Leaflet, and still builds when the page is ready. */
var DATA = Promise.all([fetch(INDEX), fetch(REGIONS), fetch(PROVIDERS)])
  .then(function (r) { return Promise.all(r.map(function (x) { return x.json(); })); })
  .catch(function () { return null; });

window.addEventListener("load", async function () {
  var el = document.getElementById("ra-map");
  if (!el || typeof L === "undefined") return;

  var idx, regions, provs;
  var got = await DATA;
  if (!got) { el.innerHTML = '<p class="ra-dead">The map data could not be loaded.</p>'; return; }
  idx = got[0]; regions = got[1]; provs = got[2];

  var PROV = {}; provs.providers.forEach(function (p) { PROV[p.id] = p; });
  /* National archives and libraries by country, fetched once and kept for the
     whole session — 40 KB that turns «no sources here» into a list in 164
     countries. */
  var warch = {};
  /* HOW MUCH PAPER EACH COUNTRY HAS, AND FOR WHICH DECADES. David: «why no
     volume data for the name work? we show it really well in the location
     work?» — Senj prints «7 books catalogued for this place» and then the
     books. A surname has no books of its own, because a volume belongs to a
     PLACE; what it has is countries, and this atlas knows how much paper
     stands in each and which decades that paper covers.

     coverage-by-country.json is 31 KB, has been built all along, and nothing
     client-side had ever opened it. Fetched here rather than merged into the
     shards because it is per COUNTRY, not per name — 200-odd rows against
     943,956, so a shard merge would copy the same numbers a thousand times
     over. */
  var COVER = null;
  var coverReady = fetch(BASE + "coverage-by-country.json")
    .then(function (r) { return r.json(); })
    .then(function (d) { COVER = d.countries || {}; })
    .catch(function () { COVER = {}; });
  var warchReady = fetch(WARCH).then(function (r) { return r.json(); })
              .then(function (d) { warch = d.byCountry || {}; return warch; })
              .catch(function () { return {}; });
  var CNAME = idx.countries || {};
  var XL = { "đ": "d", "ł": "l", "ø": "o", "ß": "ss", "æ": "ae", "œ": "oe" };
  function fold(s) {
    return (s || "").toLowerCase().replace(/[đłøßæœ]/g, function (c) { return XL[c]; })
      .normalize("NFKD").replace(/[̀-ͯ]/g, "");
  }
  /* index.json already carries the country names the rest of the site uses,
     so a badge reads "Italy" and not "IT". */
  var ccName = function (cc) { return (idx.countries || {})[cc] || cc; };
  var esc = function (x) { return String(x == null ? "" : x)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); };

  /* ---- access, which is what the colour means ---------------------------
     Read off the stylesheet so the two themes stay in one place. */
  var css = getComputedStyle(document.documentElement);
  /* Base.astro defines these before anything in this component runs. The
     fallback is for the component being used outside that layout, where
     the honest answer is the English it was given. */
  var T = window.RA_T || function (x) { return x; };

  var ACC = {
    free:      ["#1E8449", T("Images, free, no account")],
    account:   ["#6FA82E", T("Images, free, account needed")],
    index:     ["#EFC03B", T("An index only — no images")],
    mixed:     ["#E8792B", T("Partly free, partly paid")],
    paid:      ["#C0392B", T("Images, behind a paywall")],
    catalogue: ["#8E6FA8", T("A catalogue entry — not photographed")],
    onsite:    ["#7C8A91", T("On paper, in the building")],
    unsurveyed:["#B6B2A6", T("Nobody has walked this one yet")]
  };
  var RANK = idx.rank || Object.keys(ACC);

  /* ---- URL as state ------------------------------------------------------
     Every view of this map is a link: the layers, the basemap, the year, what
     is typed in the find box, which filters are off, and where the map is
     looking. A view can be sent to somebody rather than only remembered. */
  var Q; try { Q = new URLSearchParams(location.search); } catch (e) { Q = new URLSearchParams(); }
  var writing = false;
  /* A HIDDEN TAB RUNS NO FRAMES, AND THE WRITE WAS WAITING FOR ONE.
     Coalescing on requestAnimationFrame alone means that if somebody
     switches tab, changes the year or the basemap, and comes back, the
     address bar still describes the map they left — the write is queued
     behind a frame that will not arrive until the page is looked at again.
     Every share and every reload in between carries the wrong view.
     I saw this myself while testing the record-kind filter and wrote it off
     as an artefact of an automation pane being hidden; it took the archive
     kit hitting it in the same condition to show it was the bug, not the
     test. A timer runs in a hidden tab, so whichever fires first does the
     write and the flag keeps it to once. */
  function push() {
    if (writing) return;
    writing = true;
    var go = function () {
      if (!writing) return;
      writing = false;
      var s = Q.toString();
      history.replaceState(null, "", location.pathname + (s ? "?" + s : "") + location.hash);
    };
    requestAnimationFrame(go);
    setTimeout(go, 250);
  }
  function setQ(k, v) { if (v === "" || v == null) Q.delete(k); else Q.set(k, v); push(); }

  /* CANVAS, NOT SVG, BECAUSE THERE ARE TWENTY-ONE THOUSAND DOTS.
     Leaflet's default renderer makes one DOM element per vector marker.
     Measured on the live site: 21,322 <path> elements, 21,645 DOM nodes in
     the whole document, and a 268 MB JavaScript heap — so every pan and
     every zoom asked the browser to lay out twenty-one thousand nodes, and
     David reported the map as very slow.
     preferCanvas draws them all into one canvas instead. circleMarker
     supports it fully: clicks, tooltips, dashArray and per-marker styling
     all behave the same, because this map styles through Leaflet options
     rather than CSS on the paths.
     The dot count is not the problem to solve — the places are real and
     the map is meant to show them. The renderer was. */
  var map = L.map(el, { scrollWheelZoom: true, worldCopyJump: true,
                        preferCanvas: true });
  var BASES = {
    map: L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      { attribution: "&copy; OpenStreetMap contributors", maxZoom: 18 }),
    terrain: L.tileLayer("https://tile.opentopomap.org/{z}/{x}/{y}.png",
      { attribution: "&copy; OpenStreetMap contributors, SRTM · OpenTopoMap (CC-BY-SA)", maxZoom: 17 }),
    satellite: L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      { attribution: "Esri, Maxar, Earthstar Geographics", maxZoom: 18 })
  };
  var baseNow = Q.get("base") && BASES[Q.get("base")] ? Q.get("base") : "map";
  BASES[baseNow].addTo(map);

  /* ---- the jurisdiction layer -------------------------------------------
     Regions are shaded by whichever regime held them in the chosen year. With
     no year chosen there is nothing honest to shade, so the layer draws its
     outlines only and says so. */
  var regionLayer = L.layerGroup();
  var regionShapes = regions.regions.map(function (reg) {
    var poly = L.polygon(reg.ring, { color: "#7C8A91", weight: 1.2, opacity: .65,
                                     fillColor: "#7C8A91", fillOpacity: .07 });
    poly.bindTooltip(reg.label, { sticky: true });
    poly.addTo(regionLayer);
    return { reg: reg, poly: poly };
  });
  function eraAt(reg, y) {
    for (var i = 0; i < reg.eras.length; i++) {
      var e = reg.eras[i];
      if (y >= e.from && y <= e.to) return e;
    }
    return null;
  }
  /* EVERY ERA THE RANGE TOUCHES. 1880–1920 over Istria is Austria AND Italy,
     and naming only one of them would hide the handover — which is the single
     most useful thing this map has to say about that ground. */
  function erasIn(reg, a, b) {
    return reg.eras.filter(function (e) { return e.from <= b && e.to >= a; });
  }
  function paintRegions() {
    regionShapes.forEach(function (rs) {
      /* The shading takes the era the range OPENS in — a band cannot be two
         colours, and the first is the one a researcher starts from. The panel
         names all of them. */
      var e = year && eraAt(rs.reg, year);
      var c = e ? (css.getPropertyValue(regions.regimes[e.regime].var).trim() || "#7C8A91") : "#7C8A91";
      rs.poly.setStyle({ color: c, fillColor: c, fillOpacity: e ? .20 : .07, weight: e ? 1.8 : 1.2 });
      rs.poly.setTooltipContent(e
        ? "<b>" + esc(rs.reg.label) + "</b><br>" + esc(e.polity) + " in " + year
        : esc(rs.reg.label));
    });
  }
  /* ---- WHO HELD THIS GROUND, AND WHERE TO SEE ITS FLAG ------------------
     David asked for the Flag History timeline to arrive in these results, so a
     reader gets the map and, under it, the polities that governed the place
     they just searched. The eras are OURS — regions.json, 230 researched eras
     with `filedUnder`, which archive a regime's paper actually went to. Flag
     History is the destination, not the source: nothing here parses their
     pages and nothing of theirs is embedded.

     JOINED ON THE REGION, NOT THE COUNTRY, and that is the whole point. A flag
     timeline keyed on a modern country is a statement about a border that
     mostly did not exist for the period it covers. Gračišće was Aquileian,
     Venetian, Habsburg, Napoleonic, Austrian, Italian, Yugoslav and Croatian,
     and only the last of those is answered by a page called croatia-flags.

     THE LINK CARRIES NO ANCHOR. Their ids are #era-<startyear> keyed on the
     year a FLAG changed; ours is the year a FILING system changed. Croatia's
     page has eighteen anchors and era-1374 is not one of them, so a precise
     link would land silently at the top of the page and look like it worked.
     Their page can find the year; we do not invent an address for it. */
  /* THESE ARE PAGE NAMES IN THE FLAG ATLAS, NOT GUESSES AT ONE. Three of
     them were guesses and all three missed: BA read "bosnia-and-herzegovina"
     where the page is "bosnia", GB read "united-kingdom" where it is "uk",
     and ES was not here at all — so Britain's seventeen eras and Spain's two
     drew nothing while looking, from the code, as though they were covered.
     Checked against the 210 slugs in flag-eras.json.
     FR IS DELIBERATELY LEFT POINTING AT A PAGE THAT DOES NOT EXIST. The flag
     atlas has no France, so the Napoleonic eras draw no flags; the guard
     below turns that into silence rather than an error, and the mapping is
     kept so it starts working the day that page is written. */
  var FLAG_SLUG = {
    AR: "argentina", AT: "austria", AU: "australia", BA: "bosnia",
    BE: "belgium", BY: "belarus", CA: "canada", CZ: "czechia", DE: "germany",
    DK: "denmark", EE: "estonia", ES: "spain", FI: "finland", FR: "france",
    GB: "uk", HR: "croatia", HU: "hungary", IE: "ireland",
    IT: "italy", LT: "lithuania", LV: "latvia", NL: "netherlands",
    NO: "norway", PL: "poland", PT: "portugal", RO: "romania", RS: "serbia",
    RU: "russia", SE: "sweden", SI: "slovenia", SK: "slovakia", UA: "ukraine",
    US: "united-states", ZA: "south-africa"
  };
  var FLAG_BASE = "https://daviddef.github.io/Flag-History/";

  /* Which regions contain this point. Leaflet's polygons are already built, so
     this asks them rather than carrying a second point-in-ring implementation —
     a place near an edge may fall in two, which is correct: the rings shade a
     filing system, they do not adjudicate a border. */
  function regionsAt(lat, lon) {
    var out = [];
    regionShapes.forEach(function (rs) {
      var r = rs.reg.ring, inside = false;
      for (var i = 0, j = r.length - 1; i < r.length; j = i++) {
        var yi = r[i][0], xi = r[i][1], yj = r[j][0], xj = r[j][1];
        if (((yi > lat) !== (yj > lat)) &&
            (lon < (xj - xi) * (lat - yi) / (yj - yi) + xi)) inside = !inside;
      }
      if (inside) out.push(rs.reg);
    });
    return out;
  }

  /* ---- TWO WAYS OUT OF THE PANEL, AS ICONS -------------------------------
     Both destinations already existed as sentences at the bottom of the panel
     — «Everything about Gračišće →» — which is where a reader looks last and
     only if they scroll. David asked for them as icons at the top, where the
     other controls are, and he is right: the panel's job is to answer the
     click, and the two things a reader wants next are the place's own page and
     whose flag flew over it.

     The flag icon is only drawn where Flag History actually has that country.
     A greyed-out icon that does nothing is worse than no icon, and a link to a
     page that 404s is worse than both. */
  /* THE SOURCES FOR ONE COUNTRY, AS A CARD. Lifted out of render() so an era
     can ask for a country other than the one the place is in today — which is
     the whole point of knowing that Istria was Italian between 1918 and 1943.
     Same ordering as before: national archives first, then diocesan, regional,
     libraries, and within a kind the cheapest to look at first. */
  /* Rough great-circle km. Good enough to put Trieste above Agrigento, which
     is the entire job. */
  function provKm(p, lat, lon) {
    if (lat == null || !p.at || p.at.lat == null) return null;
    var toR = Math.PI / 180, dLat = (p.at.lat - lat) * toR,
        dLon = (p.at.lon - lon) * toR, a = lat * toR, b = p.at.lat * toR;
    var x = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(a) * Math.cos(b) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return 6371 * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x));
  }

  function countrySources(cc, hint, heading, lat, lon, id) {
    if (!cc) return "";
    var nat = provs.providers.filter(function (p) {
      return (p.countries || []).indexOf(cc) > -1;
    }).sort(function (a, b) {
      var K = ["national-archive", "diocesan", "regional-archive", "library",
               "volunteer", "aggregator", "commercial"];
      var ka = K.indexOf(a.kind), kb = K.indexOf(b.kind);
      if (ka !== kb) return (ka < 0 ? 99 : ka) - (kb < 0 ? 99 : kb);
      /* THEN BY HOW FAR AWAY IT IS. Italy's list opened with the state
         archives of Agrigento and Alessandria — Sicily and Piedmont — for a
         village in Istria, because within a kind it was alphabetical. 125 of
         Italy's 126 providers carry coordinates, so the ones that actually
         held this ground's paper can come first: Trieste and Gorizia rather
         than the far end of the country. Only when the place is known;
         otherwise the old order stands. */
      var da = provKm(a, lat, lon), db = provKm(b, lat, lon);
      if (da != null && db != null && Math.round(da) !== Math.round(db))
        return da - db;
      return RANK.indexOf(a.access) - RANK.indexOf(b.access);
    });
    if (!nat.length) return "";
    var h = ['<div class="at-sec"' + (id ? ' id="' + id + '"' : "") +
             '><div class="lab">' +
             esc(heading || ("The sources for " + (CNAME[cc] || cc))) + "</div>"];
    if (hint) h.push('<p class="at-sub">' + esc(hint) + "</p>");
    h.push('<ul class="at-films">');
    nat.slice(0, 10).forEach(function (p) {
      /* MARKABLE HERE TOO. David: «none of the "where to look" items are
         available to mark». The place page has put `data-src` on every
         provider row since the states were added; this list — the one the map
         panel shows, which is where most readers meet an archive — had none,
         so «written, no reply» could not be recorded against the very
         institutions /my-research/ lists addresses for.
         THE SAME ID AS THE PLACE PAGE, deliberately: `source:<provider id>`.
         Mark ARHiNET from the map and open it later from Rovinj's own page
         and it is one mark, not two that disagree. */
      h.push('<li data-src="source:' + esc(p.id) + '" ' +
             'data-src-t="' + esc(p.name) + '" ' +
             'data-src-where="' + esc(CNAME[cc] || cc) + '" ' +
             'data-src-href="' + BASE + "archive/" + esc(p.id) + '/">' +
             '<a href="' + esc(p.url) + '" target="_blank" rel="noopener">' +
             esc(p.name) + " &#8599;</a> " +
             '<span class="ra-who"><i class="at-dot" style="background:' +
             (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' +
             esc((ACC[p.access] || [0, p.access])[1]) + "</span></li>");
    });
    if (nat.length > 10)
      h.push('<li class="ra-who">…and ' + (nat.length - 10) + " more on the " +
             '<a href="' + BASE + "country/" + cc.toLowerCase() + '/">' +
             esc(CNAME[cc] || cc) + " page</a>.</li>");
    h.push("</ul></div>");
    return h.join("");
  }

  /* The surname page's address, from the name. It was written inline where
     the card links to the page; the heading row needs the same one, and two
     copies of a URL rule is how the two stop agreeing. */
  function nameSlug(n) {
    return fold(n).replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  }

  function goIcons(pageHref, pageLabel, cc, name) {
    /* DRAWN, NOT TYPED. It was &#128196; — the page emoji — which every
       platform renders in its own house style, at its own weight, in colours
       nothing else here uses; on this ground it came out as a pale grey slab
       that read as disabled. An inline SVG in currentColor sits on the same
       line, at the same weight, as everything around it, and now that it is
       the ONLY way to that page it has to look like a control rather than a
       decoration somebody forgot to remove. */
    var h = '<span class="at-ico">';
    h += '<a href="' + pageHref + '" title="' + esc(pageLabel) +
         '" aria-label="' + esc(pageLabel) + '">' +
         '<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" ' +
         'fill="none" stroke="currentColor" stroke-width="1.4" ' +
         'stroke-linecap="round" stroke-linejoin="round">' +
         '<path d="M3.2 1.8h6l3.6 3.6v8.8H3.2z"/>' +
         '<path d="M9.2 1.8v3.6h3.6"/>' +
         '<path d="M5.6 8.4h4.8M5.6 11h3.2"/>' +
         "</svg></a>";
    if (cc && FLAG_SLUG[String(cc).toUpperCase()]) {
      var lab = T("Which flags flew over") + " " + name + " \u2014 Flag History";
      h += '<a class="at-ico-flag" data-cc="' + esc(String(cc).toUpperCase()) +
           '" href="' + FLAG_BASE + FLAG_SLUG[String(cc).toUpperCase()] +
           '-flags.html" target="_blank" rel="noopener" title="' + esc(lab) +
           '" aria-label="' + esc(lab) + '">&#9873;</a>';
    }
    return h + "</span>";
  }

  /* ---- THE FLAG TIMELINES, FETCHED WHEN A PLACE IS OPENED ----------------
     Phase 2. The 1,471 era cards used to exist only as markup on 245 pages,
     so this panel could answer «who held this ground» for the 33 countries
     our own region research covers and for nowhere else. flag-eras.json is
     the same research as data, so the answer now reaches 210 countries.

     FETCHED, NOT BUNDLED, and deliberately late. It is 916 KB — larger than
     index.json, which is the file the first paint waits on. Loading it up
     front to answer a question nobody has asked yet would slow the map for
     every visitor to help the few who open a place outside a record region.
     So it arrives on the first panel that needs it and is kept thereafter.

     OUR REGIONS STILL WIN WHERE WE HAVE THEM. A record region knows
     `filedUnder` — which archive the regime's paper actually went to — and
     that is the thing nobody else publishes. The flag data knows who was
     governing. Where both cover the ground, the archive answer is the more
     useful one and goes first; the flags fill in the rest of the world. */
  function drain(list) {
    var waiting = list.splice(0, list.length);
    waiting.forEach(function (fn) { try { fn(); } catch (e) {} });
  }
  var flagEras = null, flagErasWanted = false, flagErasWaiting = [];
  function loadFlagEras(then) {
    if (flagEras) { then(); return; }
    /* IN FLIGHT IS NOT THE SAME AS DONE. This used to return here, which
       threw the second caller's callback away: the country band asks for
       this on render and the era panel asks on the first click, usually
       while that first fetch is still open, and the panel's redraw never
       happened. Both are answered now, in the order they asked. */
    flagErasWaiting.push(then);
    if (flagErasWanted) return;
    flagErasWanted = true;
    fetch(BASE + "flag-eras.json")
      .then(function (r) { return r.json(); })
      .then(function (d) {
        flagEras = {};
        (d.eras || []).forEach(function (e) {
          (flagEras[e.slug] = flagEras[e.slug] || []).push(e);
        });
        drain(flagErasWaiting);
      })
      .catch(function () {
        /* The panel is fine without them, but everyone waiting still has to
           be released or the era detail sits half-drawn forever. */
        flagEras = {};
        drain(flagErasWaiting);
      });
  }

  function flagErasFor(cc) {
    var slug = FLAG_SLUG[String(cc || "").toUpperCase()];
    if (!slug || !flagEras) return null;
    return flagEras[slug + "-flags"] || null;
  }

  /* ---- THE ERA RAIL, RIGHT OF THE MAP -------------------------------------
     flag-eras.json has every era's dates and polity and no picture; the
     artwork was inline SVG inside the 210 flag pages, reachable by a reader
     who opened one and by nothing else. era-flags.json is that artwork,
     1,454 flags, lifted out by scripts/extract-era-flags.py.

     TWO FETCHES, BOTH LAZY, AND THE RAIL DRAWS TWICE. Years alone are worth
     showing the moment the eras arrive, so the rail paints as soon as
     flag-eras.json lands and repaints when the artwork does — rather than
     holding 544 KB in front of a reader who only wanted the dates. */
  var eraArt = null, eraArtWanted = false, eraArtWaiting = [];
  function loadEraArt(then) {
    if (eraArt) { then(); return; }
    eraArtWaiting.push(then);        /* see loadFlagEras: in flight ≠ done */
    if (eraArtWanted) return;
    eraArtWanted = true;
    fetch(BASE + "era-flags.json")
      .then(function (r) { return r.json(); })
      .then(function (d) { eraArt = d.art || {}; drain(eraArtWaiting); })
      /* Honest without the pictures: years and polity names still say who
         held the ground, so a failed fetch redraws rather than blocking. */
      .catch(function () { eraArt = {}; drain(eraArtWaiting); });
  }

  /* railFor()/hideRail() lived here and drew the vertical rail. Both are
     gone with it; loadEraArt() above stays, because the country band uses the
     same artwork. */

  /* THE 204 COUNTRIES WITH NO RECORD REGION, which is most of the world.
     Before this they got nothing at all from this panel — the honest answer
     was silence, and silence reads as «this ground has no history» rather
     than «this atlas has not researched its filing yet». The flag timelines
     do not know which archive holds the paper, and this says so rather than
     letting a reader assume the stronger claim. */
  /* TWO MODES, AND THEY ANSWER DIFFERENT QUESTIONS.
     `alone` — no record region covers this place, so the country's flag eras
     are the best that can be said about who governed it.
     `supplement` — a region band is already above this one. David: «could we
     show the flag timeline where the current "see the flags these regimes
     flew"? ie a horizontal timeline of flags?» The link took a line to point
     at the thing; the thing itself fits in the same space.

     They are not the duplicate pair the vertical rail was. That rail and the
     region band both claimed to say who held THIS GROUND and disagreed. This
     is explicitly the COUNTRY's flag history, labelled as such and sitting
     under the ground's own timeline, which is the relationship between them. */
  function flagsOnly(d, supplement) {
    var rows = flagErasFor(d.country);
    if (!rows) {
      if (d.country && FLAG_SLUG[String(d.country).toUpperCase()]) {
        loadFlagEras(function () {
          var box = document.getElementById("ra-flagera");
          if (box) { box.innerHTML = flagsOnly(d, supplement); bandsInit(box); }
        });
        return '<div id="ra-flagera"></div>';
      }
      return "";
    }
    /* A BAND HERE TOO, AND THIS IS WHERE THE DRAWN FLAGS BELONG. These eras
       are the COUNTRY's — the same sequence the flags atlas publishes — so a
       flag on each segment is the thing itself, not a guess about which flag
       flew over one valley. (The band below the map, for ground that has a
       record region, gets regime colours instead and no flags, because a
       national flag over a regional era would be exactly that guess: Istria
       was Venetian while Croatia proper was Habsburg.)

       This runs only where no record region covers the place, so the two can
       never appear at once. */
    var NOW = new Date().getFullYear();
    var asc = rows.filter(function (e) { return +e.from; })
                  .sort(function (a, b) { return (+a.from) - (+b.from); });
    if (!asc.length) return '<div id="ra-flagera"></div>';

    var slug = FLAG_SLUG[String(d.country).toUpperCase()];
    var art = eraArt && eraArt[slug + "-flags"];
    if (!art) loadEraArt(function () {
      var box = document.getElementById("ra-flagera");
      if (box) { box.innerHTML = flagsOnly(d, supplement); bandsInit(box); }
    });

    /* An era's end is its own `to`, or the next one's start, or today. Without
       this the last segment has no width and the band stops early. */
    var spans = asc.map(function (e, i) {
      var to = +e.to || (asc[i + 1] ? +asc[i + 1].from : NOW);
      return { e: e, from: +e.from, to: Math.max(to, +e.from + 1) };
    });
    var uid = "ra-tl-" + (++bandN);
    var h = ['<div id="ra-flagera"><div class="ra-tl ra-tl-flags" id="' + uid + '">'];
    if (supplement) {
      h.push('<p class="at-lab">' + esc(T("The flags")) + " " +
             esc(CNAME[String(d.country).toUpperCase()] || d.country) + " " +
             esc(T("has flown")) + "</p>");
    } else {
      h.push('<p class="at-lab">' + esc(T("Who governed this ground")) + "</p>");
      h.push('<p class="at-hint" style="margin:0 0 6px">' +
             esc(T("No record region covers this place yet, so this says who was " +
                   "governing — not which archive holds the paper.")) + "</p>");
    }
    h.push('<div class="ra-tl-band" role="tablist" aria-label="' +
           esc(T("Flags over time")) + '">');
    /* WHICH ONE OPENS SELECTED, AND WHY NOT SIMPLY THE LAST. Sorted by start
       year, Croatia's last era is the Republic of Serbian Krajina — a
       secessionist state over part of the country between 1991 and 1995 —
       so the band opened claiming that was what governs there now, above the
       Republic of Croatia which began in 1990 and has not ended. The era
       still running is the one to open on; `present` is the string "True" in
       this data, not a boolean. */
    var running = spans.filter(function (sp) {
      return String(sp.e.present) === "True" || sp.e.to == null; });
    var cur = running.length ? spans.indexOf(running[running.length - 1])
                             : spans.length - 1;

    spans.forEach(function (sp, i) {
      var svg = art && art[sp.e.id];
      var last = i === cur;
      h.push('<button type="button" role="tab" class="ra-tl-seg"' +
             ' id="' + uid + "-t" + i + '" aria-controls="' + uid + '-p"' +
             ' aria-selected="' + (last ? "true" : "false") + '"' +
             ' tabindex="' + (last ? "0" : "-1") + '"' +
             ' data-i="' + i + '" style="flex-grow:' + (sp.to - sp.from) + '"' +
             ' title="' + esc((sp.e.dates || sp.from) + " \u2014 " + sp.e.polity) + '">' +
             /* NO NAME IN THE SEGMENT. David: «the flags croatia has flown
                seems really squashed. could we just show the icon and a hover
                over or click describes it in more detail». Seventeen polities
                across one row gave «Kingdor of Serbs, Croats and Slovene» and
                «Democ Federal Yugosla (Partisa flag)» — text so clipped it
                was noise, in a band whose whole content is a picture. The
                year and the flag are the segment; the name is on the title
                for a hover and in the panel below on a click, both of which
                already existed and were being talked over. */
             '<span class="ra-tl-y">' + sp.from + "</span>" +
             '<span class="ra-tl-flag' + (svg ? "" : " ra-tl-flag-none") + '">' +
               (svg || "") + "</span>" +
             "</button>");
    });
    h.push("</div>");
    h.push('<p class="ra-tl-axis"><span>' + spans[0].from + "</span><span>" +
           spans[spans.length - 1].to + "</span></p>");
    if (!supplement)
      h.push('<div class="ra-tl-detail" id="' + uid + '-p" role="tabpanel"' +
             ' aria-live="polite"></div>');
    h.push("</div>");

    BANDS[uid] = spans.map(function (sp) {
      return '<p class="ra-tl-d-h"><span class="ra-era-y">' +
             esc(sp.e.dates || (sp.from + "\u2013" + sp.to)) +
             '</span> <span class="ra-era-p">' + esc(sp.e.polity) + "</span></p>" +
             '<p class="at-hint" style="margin:0"><a href="' + BASE +
             esc(sp.e.page || ("flags/" + slug + "-flags.html")) + "#" +
             esc(sp.e.id) + '">' + esc(T("This flag on Flag History")) +
             " \u2192</a></p>";
    });

    /* In supplement mode the flag beside the place's name already links to
       the same page, so a second link would be the third thing on screen
       pointing at Flag History. */
    if (!supplement)
      h.push('<p class="at-hint"><a href="' + BASE + "flags/" + slug +
             '-flags.html">' + esc(T("The flags these regimes flew")) +
             " \u2192</a></p>");
    return h.join("") + "</div>";
  }

  /* ---- WHO HELD THIS GROUND, AS A BAND -----------------------------------
     David, looking at the stacked version: «do you think this could show as a
     horizontal timeline?» It should, and the list was not merely longer — it
     was misleading. Central Istria's Habsburg era ran 1374–1805, four hundred
     and thirty-one years, and the Adriatisches Küstenland lasted two; stacked,
     they were the same size, and the one thing a reader most needs to know
     about a period — how long it lasted, and therefore how much paper it is
     likely to have left — was the one thing the shape did not say.

     Width is duration. Colour is whether anything holds the records: an era
     with an archive is solid, an era with none is hatched, because «no archive
     holds this yet» is a real state and not an empty cell.

     The notes stay below rather than inside. «THE TRAP. Records of these years
     are filed under ITALY, not Croatia» is the most valuable sentence on the
     page and it does not fit in a segment two years wide, so the band selects
     and the panel beneath it reads.

     A LIST IS STILL THE FALLBACK. One era is not a timeline, and a band of one
     segment is a rectangle pretending to be information. */
  /* Which countries' archives an era sends you to, other than the one the
     place is in today. regions.json now gives every regime an `archives`
     list — see regimeArchivesNote there for what it does and does not
     claim. */
  function abroadFor(e, home) {
    var rg = (regions.regimes || {})[e.regime] || {};
    return (rg.archives || []).filter(function (cc) { return cc !== home; });
  }

  var bandN = 0;
  /* `grouped` — this band shares one info block with the band above it, so
     it emits no detail panel of its own. See heldBy(). */
  function eraBand(reg, home, grouped) {
    var eras = (reg.eras || []).filter(function (e) {
      return +e.from && +e.to;
    }).sort(function (a, b) { return (+a.from) - (+b.from); });
    if (eras.length < 2) return eraList(reg);

    var uid = "ra-tl-" + (++bandN);
    var first = +eras[0].from, last = +eras[eras.length - 1].to;
    var h = ['<div class="ra-tl" id="' + uid + '">'];

    h.push('<div class="ra-tl-band" role="tablist" aria-label="' +
           esc(T("Who held this ground")) + '">');
    eras.forEach(function (e, i) {
      var yrs = (+e.to) - (+e.from);
      var held = (e.filedUnder || []).length;
      /* Grow by years so the band is to scale, but never below 38px: a
         two-year era inside a nine-century span computes to less than one
         pixel, and an invisible segment cannot be clicked or tabbed to. */
      /* THE COLOUR IS THE REGIME'S OWN. regions.json files every era under
         one of 43 regimes — venice, habsburg, ottoman, yugo — and each of
         those already has a colour in the stylesheet: Venice gold, Habsburg
         slate, Yugoslavia red. Nothing had ever drawn them. This is the
         «bold, colourful, distinct» the flags atlas gets from its cards, and
         it is not decoration: two segments of the same colour are the same
         power holding the ground twice, which is exactly the shape of
         Istria's 1374 and 1815. */
      var tint = e.regime ? "var(--r-" + String(e.regime).replace(/[^a-z0-9-]/gi, "") + ")" : "";
      h.push('<button type="button" role="tab" class="ra-tl-seg' +
             (held ? "" : " ra-tl-seg-bare") + '"' +
             (tint ? ' style="--seg:' + tint + ';flex-grow:' + Math.max(yrs, 1) + '"' : "") +
             ' id="' + uid + '-t' + i + '"' +
             ' aria-controls="' + uid + '-p" aria-selected="' +
             (i === eras.length - 1 ? "true" : "false") + '"' +
             ' tabindex="' + (i === eras.length - 1 ? "0" : "-1") + '"' +
             ' data-i="' + i + '"' +
             (tint ? "" : ' style="flex-grow:' + Math.max(yrs, 1) + '"') +
             ' title="' + esc(e.from + "\u2013" + e.to + " \u2014 " + e.polity) + '">' +
             '<span class="ra-tl-y">' + e.from + "</span>" +
             '<span class="ra-tl-p">' + esc(e.polity) + "</span>" +
             "</button>");
    });
    h.push("</div>");
    h.push('<p class="ra-tl-axis"><span>' + first + "</span><span>" +
           last + "</span></p>");
    if (!grouped)
      h.push('<div class="ra-tl-detail" id="' + uid + '-p" role="tabpanel"' +
             ' aria-live="polite"></div>');

    /* THE STANDING «ALSO GOVERNED FROM» ROW WAS HERE, AND IT WENT.
       I added it on the theory that a reader who never clicks a segment still
       needs to know the paper may sit in other countries' archives. What it
       actually produced was every country and every year range crushed onto
       one line under the band — David: «im literally trying to read the
       writing». And it was saying, in half the type size, precisely what the
       detail says when you click the era: «Governed from Austria · Hungary —
       try those archives for these years too». One statement, at the era it
       belongs to, is the whole point of having a band you can click. */
    h.push("</div>");

    /* The detail for each era, handed to the script as data rather than
       re-rendered from the region — the region object is not in scope by the
       time somebody clicks. */
    /* uid -> per-era [countries], read when a segment is chosen. */
    BAND_ABROAD[uid] = eras.map(function (e) {
      var rg = (regions.regimes || {})[e.regime] || {};
      return { ccs: abroadFor(e, home), home: home, from: e.from, to: e.to,
               /* EVERY country that governed, including the modern one — the
                  foreign list above is filtered for the sources block and is
                  empty for an era like 1991 Croatia, which still flew flags. */
               gov: (rg.archives || []).slice(),
               lat: bandLat, lon: bandLon };
    });
    BANDS[uid] = eras.map(function (e) {
      var filed = (e.filedUnder || []).length
        ? (e.filedUnder || []).map(esc).join(" \u00b7 ")
        /* An era with no archive is not a gap in the research — for Istria
           before 1374 no parish registers exist anywhere, because Trent only
           required them from 1563. Saying so beats an empty cell. */
        : '<span class="ra-era-none">' + esc(T("no archive holds this yet")) + "</span>";
      /* NOT THE ERA'S NAME AGAIN. David: «can you also explain why you showing
         e.g. another row for 1991-2026 with the same istria county?» Because
         the detail led with «1991–2026 Croatia — Istria County» while the
         segment above it, highlighted, already said exactly that — so the box
         read as a duplicate row rather than as the selected era's detail.
         What is genuinely new here is the END of the range, who holds the
         paper, and the note; the polity is named by the segment, and by the
         tab-panel's aria-labelledby for anybody who cannot see which one is
         lit. */
      /* THE SENTENCE THE PAGE COULD NOT SAY. David, on Gračišće's 1918–1943
         era: «if its under italian filling, then why arent you showing the
         italian sources? you just tell me its probably under italy but then
         keep showing the croatian.» Exactly right, and it was not a display
         bug — nothing in the data connected «regime: italy» to Italy, so the
         panel keyed its sources off the place's modern country and could only
         ever answer «Croatia».

         Worded as what the region data supports: this ground was governed
         from there over those years, so those archives are worth trying. Not
         «the records are in Italy», which is a claim about every volume and
         one the atlas cannot make. */
      var away = abroadFor(e, home);
      var alsoTry = away.length
        ? '<p class="ra-tl-d-away">' + esc(T("Governed from")) + " " +
          away.map(function (cc) {
            return '<a href="' + BASE + "country/" + cc.toLowerCase() + '/">' +
                   esc(CNAME[cc] || cc) + "</a>"; }).join(" \u00b7 ") +
          " \u2014 " + esc(T("try those archives for these years too")) + "</p>"
        : "";
      return '<p class="ra-tl-d-y"><span class="ra-era-y">' + e.from +
             "\u2013" + e.to + "</span> \u00b7 " + filed + "</p>" +
             (e.note ? '<p class="ra-era-n">' + esc(e.note) + "</p>"
                     : '<p class="ra-era-n ra-era-quiet">' +
                       esc(T("No note recorded for this era.")) + "</p>") +
             alsoTry;
    });
    return h.join("");
  }

  /* The old stacked list, kept for a region with a single era. */
  function eraList(reg) {
    var h = ['<ul class="ra-eras">'];
    (reg.eras || []).forEach(function (e) {
      var filed = (e.filedUnder || []).length
        ? (e.filedUnder || []).map(esc).join(" \u00b7 ")
        : '<span class="ra-era-none">' + esc(T("no archive holds this yet")) + "</span>";
      h.push('<li><span class="ra-era-y">' + e.from + "\u2013" + e.to + "</span>" +
             '<span class="ra-era-p">' + esc(e.polity) + "</span>" +
             '<span class="ra-era-f">' + filed + "</span>" +
             (e.note ? '<span class="ra-era-n">' + esc(e.note) + "</span>" : "") +
             "</li>");
    });
    h.push("</ul>");
    return h.join("");
  }

  /* uid -> [detail html per era]. Filled as bands are built, read on click. */
  var BANDS = {}, BAND_ABROAD = {}, groupN = 0;

  /* THE SOURCES FOLLOW THE ERA. David: «cant we show e.g. the italian sources
     when i click on 1918? instead of just telling me to try those archives.»
     Right — a sentence telling somebody to go and look is a worse version of
     the list itself, and the list was already being built for the place's own
     country three lines further down.

     WHAT THIS DOES NOT CLAIM. These are Italy's archives, shown because this
     ground was governed from Italy over those years. It is not a statement
     that any particular volume from Gračišće is in any particular one of
     them. FamilySearch's own collections are not repeated here: the map does
     not load the collection corpus, and the country page does, so the last
     row links there rather than guessing. */
  function paintEraSources(entry) {
    var box = document.getElementById("ra-era-src");
    var home = document.getElementById("ra-home-src");
    if (!box) return;
    /* An era with nothing abroad puts the standing card back and clears this. */
    if (!entry || !entry.ccs || !entry.ccs.length) {
      box.innerHTML = "";
      if (home) home.hidden = false;
      return;
    }
    /* BOTH COUNTRIES, NOT THE FOREIGN ONE ON ITS OWN. David: «if i select
       italy why are you ONLY showing italy? and not showing both italy and
       croatia? … it should be "you should look in Croatia and italian
       sources" not "heres italy"».

       He is right, and the first version was worse than incomplete: it added
       an Italy card while the standing «The sources for Croatia» card sat
       further down the page unchanged, so the two halves of one answer were
       in different places and neither said the other existed. The era now
       owns the whole question — the country that holds this ground TODAY
       first, because that is where the paper usually is, then whoever
       governed it then — and the standing card steps aside while it does. */
    if (home) home.hidden = true;
    var years = entry.from + "\u2013" + entry.to;
    var all = (entry.home ? [entry.home] : []).concat(entry.ccs);
    var names = all.map(function (cc) { return CNAME[cc] || cc; });
    var lead = names.length > 1
      ? names.slice(0, -1).join(", ") + " and " + names[names.length - 1]
      : names[0];

    var h = ['<p class="ra-era-lead"><span class="ra-era-lead-l">' +
             esc(T("Where to look for")) + " " + years + "</span> " +
             esc(T("Try")) + " <b>" + esc(lead) + "</b>. " +
             esc(entry.home
                 ? (CNAME[entry.home] || entry.home) + " holds this ground today; " +
                   "it was governed from " + names.slice(1).join(" and ") +
                   " over these years, so those archives may hold the paper too."
                 : "") + "</p>"];
    all.forEach(function (cc, i) {
      h.push(countrySources(cc,
        i === 0 && entry.home
          ? "Where this ground's records are kept now."
          : "This ground was governed from " + (CNAME[cc] || cc) + " over " +
            years + ", so its archives are worth trying for those years.",
        (CNAME[cc] || cc) + " \u00b7 " + years,
        entry.lat, entry.lon));
    });
    box.innerHTML = h.join("");
  }

  /* THE FLAGS BELONG TO THE ERA, NOT TO THE PAGE. David: «lose the flag
     timeline, and instead show the flags in the info area pertaining to the
     period we selected … so if i select the 1918 Italy provincia del istria i
     see the flags and descriptions of those flags from 1918 until 1939».

     And it has to be the GOVERNING power's flags, which is why the standing
     band had to go rather than move. That band was Croatia's flag history; for
     1918–1943 it would have shown the Kingdom of Serbs, Croats and Slovenes
     and the Kingdom of Yugoslavia — flags that never flew over Istria, because
     Italy held it those years. The era knows who governed it, so the flags
     come from there: Italy's for 1918–1943, Austria's and Hungary's for the
     Habsburg centuries, none at all for an era whose regime resolves to no
     modern archive.

     Overlap, not containment: a flag adopted in 1861 and struck in 1946 covers
     1918–1943 completely and would be missed by any rule that asked for flags
     BEGINNING inside the era. */
  function eraFlagsHtml(entry) {
    if (!entry || !entry.gov || !entry.gov.length || !flagEras) return "";
    var from = +entry.from, to = +entry.to, NOW = new Date().getFullYear();
    var out = [], flew = [];
    entry.gov.forEach(function (cc) {
      var slug = FLAG_SLUG[String(cc).toUpperCase()];
      var rows = slug && flagEras[slug + "-flags"];
      if (!rows) return;
      flew.push(CNAME[cc] || cc);
      var art = eraArt && eraArt[slug + "-flags"];
      rows.filter(function (e) {
        /* `present` is a JSON boolean. It was read as String(e.present) ===
           "True", which is Python's spelling and never matches JavaScript's
           "true" — so every flag still flying, Croatia's among them, tested as
           having ended in the year it was adopted and fell out of its own
           era. */
        var f = +e.from;
        var t = +e.to || (e.present === true ||
                          String(e.present).toLowerCase() === "true"
                            ? NOW : +e.from);
        return f && f <= to && t >= from;
      }).sort(function (a, b) { return (+a.from) - (+b.from); })
        .slice(0, 8).forEach(function (e) {
          var svg = art && art[e.id];
          out.push('<li><span class="ra-ef-f' + (svg ? "" : " ra-ef-none") + '">' +
                   (svg || "") + "</span>" +
                   '<span class="ra-ef-t"><b>' + esc(e.polity) + "</b>" +
                   '<span class="ra-ef-d">' + esc(e.dates || e.from) + " \u00b7 " +
                   esc(CNAME[cc] || cc) + "</span></span>" +
                   '<a class="ra-ef-l" href="' + BASE +
                   esc(e.page || ("flags/" + slug + "-flags.html")) + "#" +
                   esc(e.id) + '">\u2192</a></li>');
        });
    });
    if (!out.length) return "";
    /* NAME THE STATES, DO NOT CLAIM THE GROUND. The header said «Flags over
       this ground» and that is more than this can know: what is listed is the
       flag history of the states that governed here, taken whole across the
       era, and a state's own history includes flags that never reached this
       parish. Senj under Austria and Hungary, 1469–1809, picks up Ottoman
       Hungary's Budin Eyalet — true of the Kingdom of Hungary, never true of
       Senj. So the header names whose flag history this is, and the line
       under it says plainly that not every one flew here. */
    return '<div class="ra-ef"><p class="ra-ef-h">' +
           esc(T("The flags of") + " " + flew.join(" \u00b7 ")) + ", " +
           entry.from + "\u2013" + entry.to + "</p>" +
           '<p class="ra-ef-c">' + esc(T("Their whole flag history across " +
           "these years — not every one flew over this parish.")) + "</p>" +
           "<ul>" + out.join("") + "</ul></div>";
  }

  function bandShow(tl, i) {
    var rows = BANDS[tl.id];
    if (!rows || !rows[i]) return;
    /* The group's shared block when there is one, otherwise the band's own. */
    var grp = tl.closest && tl.closest(".ra-tl-group");
    var det = (grp && grp.querySelector(":scope > .ra-tl-detail")) ||
              tl.querySelector(".ra-tl-detail");
    if (!det) return;
    det.innerHTML = rows[i];
    [].forEach.call(tl.querySelectorAll(".ra-tl-seg"), function (b, j) {
      b.setAttribute("aria-selected", j === i ? "true" : "false");
      b.tabIndex = j === i ? 0 : -1;
      /* The panel no longer prints the era's name, so it has to borrow it
         from the tab — otherwise a screen reader hears «1374–1805 · dapa»
         with nothing saying whose years those were. */
      if (j === i && b.id) det.setAttribute("aria-labelledby", b.id);
    });
    /* The other band in the group is no longer what the block describes, so
       it stops looking selected. One segment keeps tabindex 0 so that band is
       still reachable by keyboard. */
    if (grp) {
      [].forEach.call(grp.querySelectorAll(".ra-tl"), function (other) {
        if (other === tl) return;
        [].forEach.call(other.querySelectorAll(".ra-tl-seg"), function (b, j) {
          b.setAttribute("aria-selected", "false");
          b.tabIndex = j === 0 ? 0 : -1;
        });
      });
    }
    /* Only the ground's own band moves the sources and the flags. */
    var entry = BAND_ABROAD[tl.id] && BAND_ABROAD[tl.id][i];
    if (entry) {
      paintEraSources(entry);
      /* Both files are fetched late; ask for them and redraw when they land,
         rather than holding the panel back for a picture. */
      if (!flagEras) loadFlagEras(function () { bandShow(tl, i); });
      else if (!eraArt) loadEraArt(function () { bandShow(tl, i); });
      det.insertAdjacentHTML("beforeend", eraFlagsHtml(entry));
    }
  }

  /* Delegated, because bands are written into the panel long after this runs
     and every one of them would otherwise need wiring at render time. */
  document.addEventListener("click", function (ev) {
    var seg = ev.target.closest && ev.target.closest(".ra-tl-seg");
    if (!seg) return;
    var tl = seg.closest(".ra-tl");
    if (tl) bandShow(tl, +seg.dataset.i);
  });

  /* A tablist that cannot be walked with the arrow keys is a row of buttons
     wearing the role. Home and End because nine centuries is a long way to
     arrow through to reach either end. */
  document.addEventListener("keydown", function (ev) {
    var seg = ev.target.closest && ev.target.closest(".ra-tl-seg");
    if (!seg) return;
    var tl = seg.closest(".ra-tl");
    if (!tl) return;
    var segs = [].slice.call(tl.querySelectorAll(".ra-tl-seg"));
    var i = segs.indexOf(seg), to = null;
    if (ev.key === "ArrowRight" || ev.key === "ArrowDown") to = i + 1;
    else if (ev.key === "ArrowLeft" || ev.key === "ArrowUp") to = i - 1;
    else if (ev.key === "Home") to = 0;
    else if (ev.key === "End") to = segs.length - 1;
    if (to == null) return;
    to = Math.max(0, Math.min(segs.length - 1, to));
    ev.preventDefault();
    bandShow(tl, to);
    segs[to].focus();
  });

  /* Bands arrive with an empty detail panel; this fills whichever is newest
     as soon as one is written into the page. */
  function bandsInit(root) {
    [].forEach.call((root || document).querySelectorAll(".ra-tl"), function (tl) {
      if (tl.dataset.on) return;
      tl.dataset.on = "1";
      var rows = BANDS[tl.id] || [];
      /* Open on whichever segment the markup marked selected, not blindly on
         the last — the flag band picks the era that is still running, which
         is not always the one with the latest start year. */
      var sel = tl.querySelector('.ra-tl-seg[aria-selected="true"]');
      /* In a group both bands would fill the shared block in turn and the
         last to run would win. The ground's band is the answer, so it opens
         the block; the flag band is wired below without writing anything. */
      if (tl.closest && tl.closest(".ra-tl-group") && !BAND_ABROAD[tl.id]) return;
      bandShow(tl, sel ? +sel.dataset.i : rows.length - 1);
    });
    [].forEach.call((root || document).querySelectorAll(".ra-tl-group .ra-tl"),
      function (tl) {
        if (BAND_ABROAD[tl.id]) return;
        [].forEach.call(tl.querySelectorAll(".ra-tl-seg"), function (b, j) {
          b.setAttribute("aria-selected", "false");
          b.tabIndex = j === 0 ? 0 : -1;
        });
      });
  }

  /* The position of the place whose panel is open, so an era's source cards
     can be ordered by distance from it. */
  var bandLat = null, bandLon = null;
  function heldBy(d) {
    if (d.lat == null || d.lon == null) return "";
    bandLat = d.lat; bandLon = d.lon;
    var regs = regionsAt(d.lat, d.lon);
    if (!regs.length) return flagsOnly(d);
    var h = [];
    regs.forEach(function (reg) {
      /* ONE INFO BLOCK FOR BOTH BANDS. David: «can we unify these 2 sections?
         … so i can tap a flag and tap a who held the ground and they show
         united text descriptions in one info block, instead of 2?»

         Two panels meant two places to read an answer and, worse, two answers
         on screen at once describing different centuries — the flag band
         sitting on 1990 while the ground band sat on 1918. One block, written
         by whichever segment was last tapped, and the other band's selection
         clears, so nothing on screen claims to be current that is not.

         Flags first, directly under the map, as asked; the ground's own band
         below it and nearer the block, because that is the answer and the
         country's flags are the context around it. */
      h.push('<p class="at-lab">' + esc(T("Who held this ground")) + " · " +
             esc(reg.label) + "</p>");
      h.push(eraBand(reg, d.country));
      /* The country's own flag timeline, in the space the link to it used
         to occupy. Below the ground's band, because the ground is the
         question and the country is the context. */
    });
    return h.join("");
  }

  /* ---- the flag cards under the map -------------------------------------
     One search box, two answers. The map filters places; this filters the 210
     countries and 34 hubs on the same keystroke, matching the name, the
     region, the hub and every crown that ruled there — so «habsburg» returns
     the ten countries it held, which is a question the map alone cannot
     answer and a reader of this atlas very often has. */
  var FLAGIDX = null, flagIdxWanted = false;
  var fSec = document.getElementById("ra-flagres");
  var fCountries = document.getElementById("ra-fcountries");
  var fHubs = document.getElementById("ra-fhubs");
  var fHubsH = document.getElementById("ra-fhubs-h");
  var fSub = document.getElementById("ra-flagres-sub");

  function loadFlagIndex() {
    if (FLAGIDX || flagIdxWanted) return;
    flagIdxWanted = true;
    fetch(BASE + "flag-index.json")
      .then(function (r) { return r.json(); })
      .then(function (d) { FLAGIDX = d; drawFlagRes(qbox ? qbox.value : "");
                           /* A panel may already be open and showing the
                              fallback glyph; upgrade it in place. */
                           paintIcoFlags(document); })
      .catch(function () { FLAGIDX = { countries: [], hubs: [] }; });
  }

  function flagCardHTML(c) {
    return '<a class="ra-fcard" href="' + BASE + esc(c.url) + '" style="--edge:' +
      esc(c.color || "var(--rule-strong)") + '">' +
      '<span class="ra-fflag">' + (c.flag
        ? '<svg viewBox="0 0 300 200" aria-hidden="true">' + c.flag + "</svg>" : "") +
      "</span>" +
      '<span class="ra-fname">' + esc(c.name) + "</span>" +
      (c.region ? '<span class="ra-freg">' + esc(c.region) + "</span>" : "") +
      '<span class="ra-fcrowns">' + (c.crowns || []).slice(0, 8).map(function (x) {
        return '<span class="ra-fcrown">' + esc(x) + "</span>"; }).join("") +
      "</span></a>";
  }

  function flagHay(c) {
    /* Built once per card and cached on it. Matching the crowns is the point:
       a reader who types «ottoman» is asking which ground it held. */
    if (!c._hay) {
      c._hay = fold([c.name, c.region, c.hub].concat(c.crowns || [])
                    .filter(Boolean).join(" "));
    }
    return c._hay;
  }

  /* Country codes straight to cards, bypassing the text filter. The atlas
     names countries in the ISO table's words and the flags data in its own,
     so the two are joined through flag-index's country names — the same
     aliasing build.py does for the hub totals, kept in one direction here. */
  /* The same twenty-two aliases build.py uses for the hub totals. Kept in
     both places deliberately: build.py needs them server-side to aggregate,
     this needs them in the browser, and shipping a second copy of a
     twenty-line table is cheaper than another fetch. If one changes, so must
     the other — which is why both say so. */
  var FLAG_ALIAS = {
    "Antigua and Barbuda": "Antigua and Barb.", "Bosnia & Herzegovina": "Bosnia and Herz.",
    "Cape Verde": "Cabo Verde", "Central African Republic": "Central African Rep.",
    "Democratic Republic of the Congo": "Dem. Rep. Congo",
    "Republic of the Congo": "Congo", "Dominican Republic": "Dominican Rep.",
    "Equatorial Guinea": "Eq. Guinea", "Eswatini": "eSwatini",
    "Marshall Islands": "Marshall Is.", "Saint Kitts and Nevis": "St. Kitts and Nevis",
    "Saint Vincent and the Grenadines": "St. Vin. and Gren.",
    "Solomon Islands": "Solomon Is.", "South Sudan": "S. Sudan",
    "S\u00e3o Tom\u00e9 & Pr\u00edncipe": "S\u00e3o Tom\u00e9 and Principe",
    "The Gambia": "Gambia", "United States": "United States of America",
    "Vatican City": "Vatican", "Scotland": "United Kingdom",
    "Wales": "United Kingdom", "Northern Ireland": "United Kingdom",
    "England": "United Kingdom"
  };
  var CC2FLAG = null;
  /* Lifted out of drawFlagResForCountries so the icon row can use it too.
     Names, not codes: the flags atlas files by its own spelling and this is
     the one place that reconciles the two. */
  function buildCC2FLAG() {
    if (CC2FLAG || !FLAGIDX) return;
    CC2FLAG = {};
    var n2 = {};
    Object.keys(CNAME).forEach(function (cc) { n2[fold(CNAME[cc])] = cc; });
    (FLAGIDX.countries || []).forEach(function (c) {
      var cc = n2[fold(c.name)] || n2[fold((FLAG_ALIAS[c.name] || ""))];
      if (cc) CC2FLAG[cc] = c;
    });
  }

  /* THE ICON BECOMES THE FLAG. David: «instead of "see the flags these
     regimes flew", can you just add the countrys flag to the right of the
     name? we already have an icon that does this but replace it with the
     flag and just add the hover text rather than waste real estate».

     So the ⚑ glyph in the icon row is replaced by the country's own drawn
     flag, and the sentence under the band goes. The glyph stays in the
     markup as the fallback: flag-index.json is fetched late and on purpose,
     so the row has to render before the artwork can possibly be there, and
     it must still be a working link if the fetch never finishes. */
  function paintIcoFlags(root) {
    buildCC2FLAG();
    if (!CC2FLAG) return;
    [].forEach.call((root || document).querySelectorAll(".at-ico-flag[data-cc]"),
      function (a) {
        if (a.dataset.on) return;
        var f = CC2FLAG[a.dataset.cc];
        if (!f || !f.flag) return;
        a.dataset.on = "1";
        a.innerHTML = '<svg viewBox="0 0 300 200" aria-hidden="true">' +
                      f.flag + "</svg>";
      });
  }
  function drawFlagResForCountries(ccs) {
    if (!FLAGIDX || !fSec) { return; }
    if (!ccs || !ccs.length) return;
    buildCC2FLAG();
    var cards = ccs.map(function (cc) { return CC2FLAG[cc]; }).filter(Boolean);
    if (!cards.length) { fSec.hidden = true; return; }
    fSec.hidden = false;
    fSub.textContent = cards.length + " of the countries this name is attested in";
    fCountries.innerHTML = cards.map(flagCardHTML).join("");
    fHubsH.hidden = true;
    fHubs.innerHTML = "";
  }

  function drawFlagRes(q) {
    if (!FLAGIDX || !fSec) return;
    var k = fold((q || "").trim());
    /* A TWO-PART QUERY STILL HAS TO ANSWER. «Blazevic Gracisce» is a surname
       and a village; neither is a country, so matching the whole string would
       hide this section for every combined search.
       splitQuery() looked like the tool for it and is not: it returns nothing
       and instead sets qPlace/qName on the module, so calling it from here
       would have reached into the map's own state to read a value that was
       never returned. Any word of three characters or more is asked
       separately instead — same effect, no side effect. */
    var words = k ? k.split(/\s+/).filter(function (w) { return w.length >= 3; }) : [];
    var hit = function (hay) {
      if (!k) return true;
      if (hay.indexOf(k) !== -1) return true;
      for (var i = 0; i < words.length; i++) {
        if (hay.indexOf(words[i]) !== -1) return true;
      }
      return false;
    };
    var cs = FLAGIDX.countries || [], hs = FLAGIDX.hubs || [];
    var mc = cs.filter(function (c) { return hit(flagHay(c)); });
    var mh = hs.filter(function (h) {
      return hit(fold(h.name + " " + (h.what || "") + " " + (h.meta || "")));
    });

    if (k && !mc.length && !mh.length) { fSec.hidden = true; return; }
    fSec.hidden = false;
    fSub.textContent = k
      ? mc.length + " of " + cs.length + " countries, " + mh.length + " of " +
        hs.length + " hubs"
      : cs.length + " countries and " + hs.length + " hubs — type to filter";

    /* Capped at 60. Painting 210 cards with inline SVG on every keystroke is
       work nobody asked for; an unfiltered reader is browsing, not looking. */
    fCountries.innerHTML = mc.slice(0, 60).map(flagCardHTML).join("");

    fHubsH.hidden = !mh.length;
    /* A HUB IS THE UNIT A RESEARCHER ACTUALLY HAS. Somebody chasing a Habsburg
       ancestor does not know whether the parish ended up in Austria, Hungary,
       Croatia or Romania — the hub spans exactly that uncertainty, which is
       why David asked for the records to hang off it. So each hub says what
       this atlas holds across its member countries and offers a way in.

       THE DENOMINATOR TRAVELS WITH IT, as everywhere else: «9 countries ·
       1,588 places · 6,844 volumes» is a claim about coverage and a hub with
       nothing says so rather than showing a bare zero. */
    fHubs.innerHTML = mh.slice(0, 12).map(function (h) {
      var held = h.holds, stat = "", ways = "", srcs = "";
      if (held) {
        stat = held.countries + " countr" + (held.countries === 1 ? "y" : "ies") +
          (held.places
            ? " · " + held.places.toLocaleString() + " place" +
              (held.places === 1 ? "" : "s") +
              (held.volumes ? " · " + held.volumes.toLocaleString() + " volume" +
                (held.volumes === 1 ? "" : "s") : "")
            : " · nothing walked here yet");
        /* Straight into the map with those countries lit, which is the thing
           a reader wants next and had no way to ask for. */
        /* A LINK INSIDE A LINK IS NOT A LINK. This «Show these on the map»
           anchor used to sit INSIDE the card's own anchor, which is invalid
           HTML, and every browser repairs it the same way: it closes the
           outer <a> early and hoists the inner one out as a sibling. The
           grid then laid that orphan out as a cell of its own, so the links
           marched down the page beside the cards they belonged to, one row
           out of step. It looked like a CSS problem and was a markup one. */
        if (held.ccs && held.ccs.length) {
          ways = '<a class="ra-fways" href="' + BASE + "?hub=" +
            encodeURIComponent(h.name) + '" data-hub="' + esc(h.name) + '">' +
            esc(T("Show these on the map")) + " \u2192</a>";
        }
        /* WHO ACTUALLY HOLDS THE PAPER FOR THIS HUB.
           The card used to carry three numbers and nowhere to go, which is
           the question it raises rather than the answer. These are the
           archives across the hub's countries, national ones first, and each
           is a link to what this atlas knows about it. Folded, because a
           reader scanning twelve hubs wants the names of the hubs, not
           fourteen archives under each. */
        if (held.sources && held.sources.length) {
          srcs = '<details class="ra-fsrc"><summary>' +
            esc(T("Where the records are held")) + ' <b>' +
            (held.sourceCount > held.sources.length
              ? held.sources.length + " of " + held.sourceCount
              : String(held.sourceCount || held.sources.length)) +
            "</b></summary><ul>" +
            held.sources.map(function (sc) {
              return '<li><a href="' + BASE + "archive/" + esc(sc.id) + '/">' +
                esc(sc.name) + "</a>" +
                (sc.access && sc.access !== "unsurveyed"
                  ? ' <span class="ra-fsrc-a">' + esc(sc.access) + "</span>"
                  : "") + "</li>";
            }).join("") + "</ul></details>";
        }
      }
      return '<div class="ra-fhubwrap" style="--edge:' +
        esc(h.color || "var(--rule-strong)") + '">' +
        '<a class="ra-fcard ra-fhub" href="' + BASE + esc(h.url) + '">' +
        (h.meta ? '<span class="ra-fmeta">' + esc(h.meta) + "</span>" : "") +
        '<span class="ra-fname">' + esc(h.name) + "</span>" +
        (stat ? '<span class="ra-fholds">' + esc(stat) + "</span>" : "") +
        (h.what ? '<span class="ra-fwhat">' + esc(h.what) + "</span>" : "") +
        "</a>" + ways + srcs + "</div>";
    }).join("");
  }

  var REGION = {}; regions.regions.forEach(function (r) { REGION[r.id] = r; });
  /* Folded name -> place id, so a civil parish or a province named in a search
     result can be turned into a link to the page this map already has for it. */
  var byName = {};
  idx.places.forEach(function (p) {
    var k = fold(p.n);
    if (!(k in byName)) byName[k] = p.i;
  });
  var REGIONS_N = regions.regions.length;
  /* THE SPLIT MUST NOT CHANGE WHAT THE MAP CLAIMS TO HOLD. index.json now
     stops at the places that have something to show, so every count taken
     from idx.places.length would have quietly shed the 4,932 quiet dots —
     the same class of mistake as the header that said 8,557 volumes. */
  var TOTAL_PLACES = idx.places.length + ((idx.quiet && idx.quiet.places) || 0);
  var loadT = document.getElementById("ra-loading-t");
  /* «Drawing 21,473 places…» has an English verb in it, so a translated
     page says the number and the noun rather than a half-translated
     sentence. */
  if (loadT) loadT.textContent =
    (window.RA_LANG && window.RA_LANG !== "en"
      ? TOTAL_PLACES.toLocaleString() + " " + T("places") + "\u2026"
      : "Drawing " + TOTAL_PLACES.toLocaleString() + " places\u2026");

  /* ---- the markers -------------------------------------------------------
     Radius by how many volumes stand at a place, which is the one piece of
     editorial here and worth saying out loud: weight on this map is not
     importance. A parish with ninety volumes nobody has read and a parish with
     two are both on it, and the big one is not the better lead. */
  var shelfLayer = L.layerGroup();
  function makeMarker(p) {
    /* WALKED MEANS A BOOK STANDS HERE, by whatever route it was found.
       This read the collection count alone, so a place carrying 1,500
       FamilySearch volumes and no curated collection was drawn hollow —
       the mark that says nobody has been through it. */
    var n = (p.v || 0) || (p.c || 0);
    /* HOLLOW MEANS NOBODY WALKED IT. 2,199 of the 4,106 dots carry no volume of
       their own — mostly the administrative divisions, which are real ground,
       correctly placed, and completely unread. 319 of them still have a colour,
       borrowed (`b`) from a collection catalogued under the place or the
       district it sits in; the rest are grey. Either way, drawing them like a
       parish somebody went through would be the map claiming 2,199 walks that
       never happened. So: the colour on the rim, the middle left empty, which
       reads at a glance as «there is something here, and nobody has been
       through it». */
    /* `a` is an INDEX into RANK now, not the word itself — 116 KB of the index
       was eight strings written out 7,391 times. */
    var col = (ACC[RANK[p.a]] || ["#7C8A91"])[0];
    /* A DOTTED RIM MEANS «NOTHING HERE, BUT THIS COUNTRY HAS AN ARCHIVE». Grey
       hollow dots across the whole of Africa read as «there is nothing», and
       what they actually mean is «nothing has reached here YET» — while 32
       African countries have a named national archive sitting in the panel.
       The marker could not say that and now does. */
    /* GREEN ON GREEN. David: «green markers on the map are almost impossible
       to see» — and the free-access colour is #1E8449 sitting on OpenStreetMap's
       wooded green, held apart by a white stroke eight tenths of a pixel wide.
       Every access colour has some basemap it disappears into: the greens in
       forest, the greys in urban fill, the amber in farmland.

       So the ring does the separating, not the fill: 1.8px of solid white on
       the dots that carry volumes, and the unwalked dots keep a neutral edge
       rather than a faint tint of their own colour, which was the worst of
       both — too pale to read as a dot, too coloured to read as absent. */
    var m = L.circleMarker([p.y, p.x], !n ? {
      radius: Math.min(3.5 + Math.sqrt(p.b || 1) * 0.5, 8),
      color: p.w && !p.b ? "#6B7780" : "#8A8E86", weight: 1.5, opacity: .95,
      dashArray: p.w && !p.b ? "2 2" : null,
      fillColor: col, fillOpacity: .22
    } : {
      radius: Math.min(3 + Math.sqrt(n) * 0.9, 13),
      color: "#fff", weight: 1.8, opacity: 1,
      fillColor: col, fillOpacity: .95
    });
    m._p = p;
    m.bindTooltip(p.n, { sticky: true });
    m.on("click", function () { open(p); });
    return m;
  }
  var markers = idx.places.map(makeMarker);

  /* ---- WHERE YOU HAVE ALREADY BEEN ---------------------------------------
     David: «when we are done researching with a location can it be shown on
     the map differently to those locations that we are part way through vs
     those not started?»

     Three states, and they are READ FROM THE VOLUME MARKS rather than set:
     a town is finished when every volume this atlas holds for it has been
     marked, under way when some have, and untouched otherwise. Nothing new
     is stored — the same objection as the rollup, that a second record of the
     same work is a record that can disagree with the first.

     DRAWN AS A RING, NOT A FILL. The fill is already the access colour and a
     reader has learnt it: free is green, paid is amber, on paper is grey.
     Overwriting that to say «done» would trade one vocabulary for another and
     lose the first. A ring outside the dot says something about the READER's
     progress; the dot goes on saying what it always said about the record. */
  var PROG_RING = { done: "#1E8449", part: "#C77C2E" };
  function progressOf(placeId) {
    if (!window.raProgress) return null;
    var marks = window.raProgress.all();
    var pre = "volume:", n = 0;
    /* A mark knows which place it belongs to because the row that made it
       said so — see setWhat in ProgressKit. Counting by href keeps this from
       needing a second index of volumes by place. */
    var href = BASE + "place/" + placeId + "/";
    /* PER LINE, because the rings answer «how far am I with THIS family».
       A volume walked in full counts for everybody; one scanned for another
       surname does not, and colouring Senj green because somebody once
       searched it for a different family is the over-claim the line model
       was added to stop. */
    var slug = window.raProgress.active();
    for (var k in marks) {
      if (k.indexOf(pre) !== 0) continue;
      if (marks[k].href !== href) continue;
      if (window.raProgress.coverage(k, slug).length) n++;
    }
    return n;
  }
  function paintProgressRings() {
    if (!window.raProgress) return { done: 0, part: 0 };
    var tally = { done: 0, part: 0 };
    markers.forEach(function (m) {
      var p = m._p;
      if (!p || !p.i) return;
      var done = progressOf(p.i);
      var total = p.v || 0;
      var state = !done ? null : (total && done >= total ? "done" : "part");
      if (m._prog === state) return;
      m._prog = state;
      if (!state) { m.setStyle({ color: m.options.color, weight: m.options.weight }); return; }
      m.setStyle({ color: PROG_RING[state], weight: 3.5, opacity: 1 });
    });
    /* Counted again from scratch rather than incremented, because `_prog`
       short-circuits the loop for markers that have not changed. */
    markers.forEach(function (m) { if (m._prog) tally[m._prog]++; });
    return tally;
  }
  /* Repainted whenever a mark changes — VolumeMarks calls this after every
     save, so the map reflects the work without a reload. */
  window.raPaintProgress = paintProgressRings;
  setTimeout(paintProgressRings, 0);

  /* ---- the archives -------------------------------------------------------
     Where the paper physically is. Drawn as a hollow square rather than a
     filled dot because an institution is not a place on the shelf: one archive
     in Zadar holds the registers of two hundred Dalmatian parishes, and
     conflating the two would say there are two hundred archives.

     This layer is also the only one that is genuinely worldwide today, and it
     is what stops the map claiming to cover the earth while showing Croatia. */
  var archiveLayer = L.layerGroup();
  var archives = provs.providers.filter(function (p) { return p.at; });
  var archMarkers = archives.map(function (p) {
    var m = L.marker([p.at.lat, p.at.lon], {
      icon: L.divIcon({ className: "ra-arch", iconSize: [13, 13],
                        html: '<i style="border-color:' + (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' })
    });
    m.bindTooltip(p.name, { sticky: true });
    m.on("click", function () { openArchive(p); });
    m.addTo(archiveLayer);
    /* Searchable by its name, its city, and every country it covers — so
       "Ireland" finds the Dublin archives AND the aggregators that reach
       Ireland from somewhere else entirely. */
    m._q = fold([p.name, p.at.place,
                 (p.countries || []).map(function (c) { return CNAME[c] || c; }).join(" ")
                ].join(" "));
    m._p = p;
    return m;
  });

  /* WIKIDATA'S ARCHIVES — everything it knows the location of, and nobody
     here has opened one. Drawn as a small hollow ring rather than the filled
     diamond a checked provider gets, because the difference between «we have
     read this and it is free» and «Wikidata says there is an archive here» is
     the whole editorial value of the other 178. */
  var wikiLayer = L.layerGroup(), nsite = 0;
  var wikiMarkers = [];
  (async function () {
    var wd;
    try { wd = await (await fetch(WDA)).json(); } catch (e) { return; }
    wd.archives.forEach(function (a) {
      var m = L.circleMarker([a.y, a.x], {
        renderer: featCanvas,
        radius: 3.4, color: "#8E6FA8", weight: 1.2, opacity: .75,
        fillColor: "#8E6FA8", fillOpacity: .18
      });
      m.bindTooltip(a.n, { sticky: true });
      m.on("click", function () {
        empty.hidden = true; panel.hidden = false;
        var h = ['<div class="at-h"><h3>' + esc(a.n) + "</h3></div>"];
        h.push('<p class="at-also">' + esc(CNAME[a.cc] || a.cc || "") + "</p>");
        h.push('<div class="ra-juris ra-unmapped"><div class="lab">From Wikidata, unchecked' +
               "</div><p>Wikidata records an archive here. <b>Nobody on this project has " +
               "opened it</b>, and it may hold nothing genealogical — corporate, film and " +
               "museum archives are archives too. The " + provs.providers.length +
               " institutions drawn as diamonds have been looked at; this has not.</p></div>");
        if (a.sites && a.sites.length)
          h.push('<p class="at-go"><a href="' + esc(a.sites[0]) +
                 '" target="_blank" rel="noopener">' + esc(a.sites[0]) + " &#8599;</a></p>");
        h.push('<p class="at-sub"><a href="https://www.wikidata.org/wiki/' + esc(a.q) +
               '" target="_blank" rel="noopener">' + esc(a.q) + " on Wikidata &#8599;</a></p>");
        panel.innerHTML = h.join("");
      });
      m.addTo(wikiLayer);
      wikiMarkers.push(m);
    });
    var n = wd.archives.length;
    nsite = wd.archives.filter(function (a) {
      return a.sites && a.sites.length;
    }).length;
    /* OpenStreetMap's archives share this layer and this caveat. They are a
       separate FILE because ODbL is share-alike and everything else here is
       CC0 — but to a reader they are the same kind of claim: somebody mapped
       an archive here and nobody on this project has opened it. */
    try {
      var om = await (await fetch(OSMA)).json();
      om.archives.forEach(function (a) {
        var m = L.circleMarker([a.y, a.x], {
          renderer: featCanvas,
          radius: 3.4, color: "#4E7A55", weight: 1.2, opacity: .75,
          fillColor: "#4E7A55", fillOpacity: .18
        });
        m.bindTooltip(a.n, { sticky: true });
        m.on("click", function () {
          empty.hidden = true; panel.hidden = false;
          var h = ['<div class="at-h"><h3>' + esc(a.n) + "</h3></div>"];
          if (a.by) h.push('<p class="at-also">' + esc(a.by) + "</p>");
          h.push('<div class="ra-juris ra-unmapped"><div class="lab">From OpenStreetMap, ' +
                 "unchecked</div><p>Somebody mapped an archive at this spot. Nobody here " +
                 "has opened it. &copy; OpenStreetMap contributors, ODbL.</p></div>");
          if (a.site) h.push('<p class="at-go"><a href="' + esc(a.site) +
                             '" target="_blank" rel="noopener">' + esc(a.site) + " &#8599;</a></p>");
          panel.innerHTML = h.join("");
        });
        m.addTo(wikiLayer);
      });
      n += om.archives.length;
    } catch (e) {}
    /* SAY HOW MANY CAN BE OPENED, because most of them now can.
       This layer drew 4,929 archives with no website at all — a dot a
       reader could see and not follow — and the label said «unchecked»,
       which was true and buried the useful half. The harvest now carries
       5,276 addresses, so the label counts them: a layer worth turning on
       is a layer that says what turning it on gets you. */
    var lab = document.querySelector('.ra-layer[data-l="wikidata"]');
    if (lab) lab.title = "Others — " + n.toLocaleString() +
      " mapped by others, " + nsite.toLocaleString() +
      " with a website · unchecked, and not all genealogical";
    if (on.wikidata) wikiLayer.addTo(map);
  })();

  /* THE GROUND ITSELF — cemeteries, churches, libraries, inside the record
     regions only. Wikidata knows 295,702 cemeteries and 273,894 churches
     worldwide; drawing them all would be a map of Wikidata rather than of
     where records are, and would bury 2,130 walked places under half a
     million dots. The regions are the ground this project has worked out. */
  /* ONE CANVAS, NOT 46,909 DOM NODES. The church layer drew a separate SVG
     path per parish and put every one of them in the document whether it was
     on screen or not, which is a browser brought to its knees by a layer
     nobody asked to be slow. Leaflet will rasterise a layer to a single canvas
     instead, and for tens of thousands of small circles that is the difference
     between a map and a slideshow. */
  var featCanvas = L.canvas({ padding: 0.3 });
  var FEATS = [
    ["cemeteries", "Cemeteries", "#6C5CE0", 2.8],
    ["churches",   "Churches and parishes", "#B07CD9", 2.6],
    ["libraries",  "Libraries", "#2E86C1", 3.0]
  ];
  var featLayers = {};
  FEATS.forEach(function (F) {
    var key = F[0], layer = L.layerGroup();
    featLayers[key] = layer;
    (async function () {
      /* Two sources per layer, and neither is checked: Wikidata's CC0 set and
         OpenStreetMap's ODbL one, which live in separate files because
         share-alike must not leak into the rest but are the same claim to a
         reader — somebody mapped this and nobody here has been. */
      var d = { features: [], srcs: [] };
      for (var si = 0; si < 2; si++) {
        var which = ["wikidata", "osm"][si];
        try {
          /* Checked, because not every layer has both halves — churches and
             libraries are Wikidata-only — and an unchecked fetch logged two
             404s on every page load that looked like a fault and were not. */
          var res = await fetch(FEAT + key + "-" + which + ".json");
          if (!res.ok) continue;
          var part = await res.json();
          if (part.features && part.features.length) {
            d.features = d.features.concat(part.features);
            d.srcs.push(which === "osm" ? "OpenStreetMap" : "Wikidata");
          }
        } catch (e) {}
      }
      if (!d.srcs.length) d.srcs = ["Wikidata"];
      d.features.forEach(function (f) {
        var m = L.circleMarker([f.y, f.x], {
          renderer: featCanvas,
          radius: F[3], color: F[2], weight: 1, opacity: .7,
          fillColor: F[2], fillOpacity: .35
        });
        m.bindTooltip(f.n, { sticky: true });
        m.on("click", function () {
          empty.hidden = true; panel.hidden = false;
          panel.innerHTML =
            '<div class="at-h"><h3>' + esc(f.n) + "</h3></div>" +
            '<p class="at-also">' + esc(F[1]) + "</p>" +
            '<div class="ra-juris ra-unmapped"><div class="lab">From Wikidata, unchecked' +
            "</div><p>Wikidata records this here, inside the <b>" + esc(f.r) +
            "</b> record region. Nobody on this project has been. It is drawn because the " +
            "ground a family stood on is part of where its records are.</p></div>" +
            '<p class="at-sub"><a href="https://www.wikidata.org/wiki/' + esc(f.q) +
            '" target="_blank" rel="noopener">' + esc(f.q) + " on Wikidata &#8599;</a></p>";
        });
        m.addTo(layer);
      });
      /* NAME BOTH SOURCES. The cemetery layer merges 11,698 CC0 rows from
         Wikidata with 5,443 ODbL ones from OpenStreetMap, and a label saying
         only «from Wikidata» is both wrong and, for the ODbL half, an
         attribution this project owes. */
      var lab = document.querySelector('.ra-layer[data-l="' + key + '"]');
      if (lab) lab.title = (lab.querySelector("b") || {}).textContent + " — " +
        d.features.length.toLocaleString() + " in the record regions · " +
        d.srcs.join(" and ") + ", unchecked";
      if (on[key]) layer.addTo(map);
    })();
  });

  /* Which record regions name this archive as the holder of their records, and
     for how many eras. An archive that four regions cite for twenty eras is a
     different proposition from one nobody has connected to any ground yet. */
  function citedBy(id) {
    var out = [];
    regions.regions.forEach(function (r) {
      var n = r.eras.filter(function (e) { return e.filedUnder.indexOf(id) > -1; }).length;
      if (n) out.push({ label: r.label, n: n });
    });
    return out;
  }

  function openArchive(p) {
    empty.hidden = true; panel.hidden = false;
    setQ("at", "");
    var h = [];
    h.push('<div class="at-h"><h3>' + esc(p.name) + "</h3></div>");
    h.push('<p class="at-also">' + esc(p.at.place) + "</p>");
    h.push('<p class="at-what">' + esc(p.what) + "</p>");
    h.push('<p class="ra-acc"><i class="ra-dot" style="background:' +
           (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' +
           esc((ACC[p.access] || [0, p.access])[1]) + "</p>");
    var cite = citedBy(p.id);
    if (cite.length) {
      h.push('<div class="at-sec at-sec-wide"><div class="lab">Holds the records of</div><ul class="at-films">');
      cite.forEach(function (c) {
        h.push("<li>" + esc(c.label) + ' <span class="at-y">' + c.n +
               " era" + (c.n === 1 ? "" : "s") + "</span></li>");
      });
      h.push("</ul></div>");
    }
    h.push('<p class="at-go"><a href="' + BASE + "archive/" + esc(p.id) + '/">' +
           "Everything about " + esc(p.name) + " &rarr;</a> · " +
           '<a href="' + esc(p.url) + '" target="_blank" rel="noopener">the site &#8599;</a></p>');
    h.push('<p class="at-sub">Last checked ' + esc(p.checked) + ".</p>");
    panel.innerHTML = h.join("");
  }

  /* ---- the panel, fetched per place --------------------------------------
     The index cannot carry this and should not try. */
  var panel = document.getElementById("ra-body"), empty = document.getElementById("ra-empty");
  var cache = {};
  async function open(p) {
    empty.hidden = true; panel.hidden = false;
    panel.innerHTML = '<p class="at-sub">Fetching ' + esc(p.n) + "…</p>";
    var d = cache[p.i];
    if (!d) {
      try { d = cache[p.i] = await (await fetch(DETAIL + p.i + ".json")).json(); }
      catch (e) { panel.innerHTML = '<p class="at-sub">Could not load this place.</p>'; return; }
    }
    setQ("at", p.i);
    panel.innerHTML = render(d);
    bandsInit(panel);
    paintIcoFlags(panel);
    buildCheck(d, drawHood(d));
  }

  function render(d) {
    var h = [];
    /* ONE LINE, NOT FOUR. David: «"everything about gracisce" does it really
       need that much real estate. cant it just be written on the same line as
       the gracisce header». It was a heading, then a line of older spellings,
       then a lone link on a row of its own — three stacked blocks and most of
       two hundred pixels before the first source. The heading already lays
       out as a wrapping flex row, so both join it. */
    h.push('<div class="at-h"><h3>' + esc(d.name) + "</h3>");
    if (d.collections.length)
      h.push('<span class="at-n">' + d.collections.length + " volume" +
             (d.collections.length === 1 ? "" : "s") + "</span>");
    var alsoNames = (d.names || []).map(function (n) { return n.n; });
    if (alsoNames.length)
      h.push('<span class="at-also">also written ' +
             alsoNames.map(function (x) { return "<em>" + esc(x) + "</em>"; })
                      .join(" · ") + "</span>");
    /* The page behind the panel. A marker is a view; a page is a thing you
       can send somebody, bookmark, or find from a search engine. */
    /* THE ICON BESIDE IT WENT TO THE SAME PAGE. David: «there is a "read more
       about…" and also the icon next to the flag, both take me to the same
       place page? can we keep it to the icon and save the text real estate?»
       Two controls, one destination, on the row that has least room for
       either — the heading already carries the name, the volume count and
       every former spelling. The icon stays and is drawn properly below; the
       sentence goes. Nothing is lost for a screen reader, which was reading
       the same href twice and now reads it once, with the same words, from
       the icon's own label. */
    /* THE PLACE ITSELF IS A THING YOU DECIDE ABOUT. David: «i search e.g. a
       place and i want to add it to my to-do list / dossier?» Until now the
       only markable things here were the books inside it, so a reader who had
       decided to work Rovinj — and had not yet opened a single register — had
       nowhere to put that decision, and /my-research/ could not show it.
       «planning to» is the whole point of a to-do list. */
    h.push('<span class="at-placemark" data-src="place:' + esc(d.id) + '" ' +
           'data-src-t="' + esc(d.name) + '" ' +
           'data-src-where="' + esc(CNAME[d.country] || d.country || "") + '" ' +
           'data-src-href="' + BASE + "place/" + esc(d.id) + '/"></span>');
    h.push(goIcons(BASE + "place/" + esc(d.id) + "/",
                   T("Everything about") + " " + d.name + " \u2014 its own page",
                   d.country, d.name));
    /* WHAT THE VOLUMES BELOW COME TO — derived, never set. David: «youre
       marking a whole town, i want to mark specifc volumes that roll up into
       that town». A town with a state of its own would be a second tally of
       the same work, disagreeing with the volumes the moment either moved.
       VolumeMarks fills this from the rows it can see. */
    h.push('<span class="ra-rollup" hidden></span>');
    h.push("</div>");

    /* The older spellings ride on the heading line now, built above. */

    if (d.filedUnder) {
      h.push('<div class="ra-juris" style="border-left-color:#C0392B">' +
             '<div class="lab">Filed under another country</div><p>' +
             esc(d.name) + " is in " + esc(CNAME[d.country] || d.country) +
             " today. FamilySearch catalogues it under <b>" +
             esc(CNAME[d.filedUnder] || d.filedUnder) +
             "</b>, because that is who held the ground when the records were made.</p></div>");
    }
    if (d.level) {
      h.push('<p class="at-sub">A ' + esc(d.level) + ", not a town — the marker is at its " +
             "centre, not at a building.</p>");
    }
    if (d.note) h.push('<p class="at-sub">' + esc(d.note) + "</p>");

    /* FIRST, NOT LAST. It used to sit at the foot of the panel on the grounds
       that «the volumes are what a reader came for and the jurisdiction is
       what they need next». That was true while the panel was a narrow column
       you scrolled; under the map at full width it meant the timeline sat
       below the sources and the volume lists, a screen and a half down, and
       David — having asked for it under the map — could not see that it was.
       It is also the thing that tells you WHICH archive to believe, so it
       belongs above the list of them. */
    h.push(heldBy(d));
    /* Filled when an era is selected. display:contents so its cards become
       grid items of the panel proper, and sit beside «The sources for
       Croatia» rather than in a box of their own. */
    h.push('<div class="at-era-src" id="ra-era-src"></div>');

    /* THE LINE THIS SITE EXISTS FOR. */
    var reg = d.region && REGION[d.region];
    if (reg) {
      if (year) {
        var es = erasIn(reg, year, year2);
        if (es.length) {
          h.push('<div class="ra-juris"><div class="lab">' +
                 (year === year2 ? "In " + year + ", this was"
                  : "Between " + year + " and " + year2 + ", this ground changed hands " +
                    (es.length === 1 ? "not at all" : (es.length - 1) + " time" +
                     (es.length === 2 ? "" : "s"))) + "</div>");
          es.forEach(function (e) {
            h.push("<p><span class=\"y\">" + Math.max(e.from, year) + "\u2013" +
                   Math.min(e.to, year2) + "</span> <b>" + esc(e.polity) + "</b></p>");
            if (e.filedUnder.length) {
              h.push('<p class="ra-filed">Filed under ' +
                e.filedUnder.map(function (f) {
                  var pv = PROV[f];
                  return pv ? '<a href="' + esc(pv.url) + '" target="_blank" rel="noopener">' +
                              esc(pv.name) + "</a>" : esc(f);
                }).join(" · ") + ".</p>");
            } else {
              h.push('<p class="ra-filed">No registers survive for this period anywhere.</p>');
            }
            if (e.note) h.push('<p class="ra-note">' + esc(e.note) + "</p>");
          });
          if (es.length > 1)
            h.push('<p class="ra-note"><b>That handover is the trap.</b> A family that ' +
                   "never moved has its records in two filing systems, and the second " +
                   "archive will tell you it holds nothing.</p>");
          h.push("</div>");
        }
      } else {
        /* NOTHING HERE, AND THAT IS THE POINT.
           «Whose ground this was» stood here restating, as a sentence, what
           the band above answers era by era with the archives attached —
           David: «why do we talk about "who held this ground" in 2 separate
           places?» I replaced it with the one thing it uniquely offered, a
           «set a year» link, and that was still a whole line spent on a
           control the reader can already see: the year scrubber sits along
           the foot of the map, a few pixels away, with its own label and its
           own hover text. So the line goes too, and the scrubber's tooltip
           carries the explanation instead. */
      }
    } else {
      h.push('<div class="ra-juris ra-unmapped"><div class="lab">Whose ground this was</div>' +
             "<p>Not yet mapped. " + REGIONS_N + " record regions carry an era " +
             "table so far — Istria, the Kvarner, Carnia, Dalmatia, Galicia, Bukovina, " +
             "Bohemia, Moravia, Hungary, Transylvania, East Prussia, Pomerania and the " +
             "rest — and this place is outside all of them. That is a gap in this map " +
             "rather than a gap in the record.</p></div>");
    }

    /* The link to this place's own page moved up onto the heading line.
       Until these pages existed, 1,239 places had no address of their own. */

    /* THE BOOKS THEMSELVES. «Croatia, Church Books, 1516–1994 covers this
       place» is true and one step short of what a researcher needs: which
       book, for which years, and where is it. */
    if (d.volumes && d.volumes.length) {
      /* TWO VOCABULARIES, BECAUSE THERE ARE TWO WALKS. Croatia's books were
         read in a browser and carry the EVENT — Births, Marriages, Deaths —
         parsed from titles that were all in one language. The rest of the
         world arrives from the waypoint API with titles in every language
         FamilySearch catalogues in, so those carry the record-kind reading
         instead. Grouping by whichever a book has keeps both legible; the
         alternative was every foreign book landing in "Other". */
      var byKind = {}, order = [];
      d.volumes.forEach(function (v) {
        var gs = (v.kinds && v.kinds.length) ? v.kinds
               : (v.rk && v.rk.length) ? v.rk.map(function (k) { return KLAB[k] || k; })
               : ["Other"];
        gs.forEach(function (k) {
          if (!byKind[k]) { byKind[k] = []; order.push(k); }
          byKind[k].push(v);
        });
      });
      /* Events first in their familiar order, then anything else as it came. */
      var PREF = ["Births", "Marriages", "Deaths", "Church Census",
                  "Confirmations", "Index"];
      order.sort(function (a, b) {
        var ia = PREF.indexOf(a), ib = PREF.indexOf(b);
        if (ia < 0) ia = a === "Other" ? 999 : 500;
        if (ib < 0) ib = b === "Other" ? 999 : 500;
        return ia - ib || a.localeCompare(b);
      });
      h.push('<div class="at-sec at-sec-wide"><div class="lab">The volumes themselves</div>');
      h.push('<p class="at-sub">' +
             (d.volumesTotal
                ? esc(d.volumesTotal.toLocaleString()) + " books catalogued for " +
                  "this place, of which the oldest " + d.volumes.length +
                  " are listed here. "
                : d.volumes.length + " book" +
                  (d.volumes.length === 1 ? "" : "s") + " catalogued for this place. ") +
             "<b>Nobody here has opened any of them</b> — these are the " +
             "catalogue's own titles and the links that open the images.</p>");
      /* A COLUMN PER RECORD TYPE, NOT ONE LIST POURED THROUGH COLUMNS.
         David: «could we rather show these as columns? eg births all together
         in a column, then marriages, then deaths?» The list was `columns:
         22em`, which is CSS multi-column: it takes ONE list and flows it
         across the available width, so Births ran left-to-right into the
         second and third columns and Marriages started wherever Births
         happened to stop. Reading down a column got you three record types
         and reading across got you one, which is the opposite of both.
         A grid of three lists instead: each type is a column, each column is
         read top to bottom, and the headings line up across the top. */
      h.push('<div class="at-kinds">');
      order.forEach(function (k) {
        if (!byKind[k]) return;
        h.push('<div class="at-kind"><div class="lab">' + esc(k) + "</div>");
        h.push('<ul class="at-films">');
        /* EVERY VOLUME IS WRITTEN, AND THE TAIL IS FOLDED. David: «i see a
           "…and 34 more" but i cant click on it to get the more? surely it
           should expand the full list?» — it was a caption describing a
           truncation, which is the least useful sentence a list can end on.
           The rows past the first 25 are in the page now and hidden, so the
           button reveals what is already there rather than fetching again. */
        byKind[k].forEach(function (v, vi) {
          /* THE MARK BELONGS WHERE THE WORK HAPPENS. It was built on the
             standalone place page and not here, which is backwards: the map
             IS the product, and a reader who has just found Senj's registers
             is looking at this list, not at /place/g-senj-hr/. David: «not
             following how the checklist/research works here. on a page like
             the attached? if ive done those volumes? how can i see it?»
             The id is the same waypoint the place page uses, so a volume
             marked on either surface is the same volume. */
          h.push("<li" + (vi >= 25 ? ' class="ra-vx"' : "") +
            ' data-vol="' + esc("volume:" + (v.waypoint || v.url || v.t)) + '"' +
            ' data-vol-t="' + esc(v.t) + '"' +
            ' data-vol-where="' + esc(d.name + (d.country ? ", " +
                 (CNAME[d.country] || d.country) : "")) + '"' +
            ' data-vol-href="' + esc(BASE + "place/" + d.id + "/") + '">' + (v.url
              ? '<a href="' + esc(v.url) + '" target="_blank" rel="noopener">' +
                esc(v.t) + " &#8599;</a>"
              : "<b>" + esc(v.t) + "</b>") +
            (v.from ? ' <span class="at-y">' + v.from + "\u2013" + v.to + "</span>" : "") +
            (v.conf ? ' <span class="ra-who">' + esc(v.conf) + "</span>" : "") +
            (v.film ? ' <span class="ra-who">film ' + esc(v.film) + "</span>" : "") +
            /* The path through FamilySearch's tree that put this book on
               this dot. Without it a reader has no way to tell a good match
               from a wrong one, and these are matched by name. */
            (v["in"] ? ' <span class="ra-who" title="Where this book sits in ' +
                       'FamilySearch\u2019s own tree">' + esc(v["in"]) + "</span>" : "") +
            '<span class="volmark"></span>' +
            "</li>");
        });
        if (byKind[k].length > 25)
          h.push('<li class="ra-vmore"><button type="button" class="ra-vmore-b">' +
                 esc(T("Show all") + " " + byKind[k].length.toLocaleString() + " " +
                     T("volumes")) + " \u25be</button></li>");
        h.push("</ul></div>");
      });
      h.push("</div>");          /* .at-kinds */
      h.push("</div>");
    }

    /* THE NATIONAL SOURCES, WHICH NO PANEL HAS EVER SHOWN. David clicked an
       Irish parish and asked where IrishGenealogy had gone. It had never been
       there: a provider's `countries` list was read by the find box and by the
       country pages and by nothing else, so the five free Irish national
       sources — IrishGenealogy, the National Library's parish registers, the
       National Archives, PRONI, Findmypast — were invisible on every Irish
       place on this map.
       That is backwards. A place with no volumes walked on it is exactly the
       place where the national source IS the answer, and it is the one thing
       this panel could always have said and never did.
       The worldwide twelve — FamilySearch, Ancestry, MyHeritage and the rest —
       are kept out of this list on purpose. They cover everywhere, so they say
       nothing about here, and they would bury the five that do. */
    /* AND WHERE THERE IS NOTHING CURATED, WHAT THERE IS. 199 countries had no
       named source at all, so clicking a place in Bolivia answered with
       FamilySearch — true of everywhere, and therefore a statement about
       nothing. These are Wikidata's national archives and libraries, fetched
       once and kept apart from the curated list because rattling a door is not
       the same as having read what is behind it. */
    if (d.country && warch[d.country]) {
      h.push('<div class="at-sec"><div class="lab">National sources, unverified</div>');
      h.push('<p class="at-sub">From Wikidata, CC0. Nobody here has opened these — ' +
             "the link answered when it was asked and that is all this map knows " +
             "about them. They are listed because <b>a country with no named " +
             "source at all is the worse answer</b>.</p>");
      h.push('<ul class="at-films">');
      warch[d.country].slice(0, 6).forEach(function (r) {
        /* SAME ID AS THE PLACE PAGE'S OWN WIKIDATA ROWS (`source:wd-…`), so a
           national archive marked here and the same one marked there are one
           record. David: «why do national sources… not have the ability to
           +?» — because only two of the panel's six lists had ever been
           wired, and which two was an accident of the order they were
           written in rather than a decision about what is markable. */
        h.push('<li data-src="source:wd-' + esc(r.id || r.name) + '" ' +
               'data-src-t="' + esc(r.name) + '" ' +
               'data-src-where="' + esc(CNAME[d.country] || d.country) + '" ' +
               'data-src-href="' + esc(r.url) + '">' +
               '<a href="' + esc(r.url) + '" target="_blank" rel="noopener">' +
               esc(r.name) + " &#8599;</a> " +
               '<span class="ra-who">' +
               (r.kind === "national-archive" ? "national archive" : "national library") +
               (r.status && r.status !== "ok"
                 ? " · " + esc(r.status === "challenged"
                     ? "behind a bot gate, but alive"
                     : r.status === "unreachable"
                       ? "did not answer this checker" : "answered with an error")
                 : "") + "</span></li>");
      });
      h.push("</ul></div>");
    }

    if (d.country) h.push(countrySources(d.country,
      "National and regional, and they cover this ground whether or not " +
      "anybody has walked it here.", null, d.lat, d.lon, "ra-home-src"));

    /* The collections that reach this ground. The panel shows the nearest few
       and the page shows them all — a marker is a glance, not a catalogue. */
    if (d.nfs) {
      var near = (d.fs || []).filter(function (c) { return c.rank <= 2; });
      h.push('<div class="at-sec"><div class="lab">FamilySearch reaches here</div>');
      h.push('<p class="at-sub">' + d.nfs + " collection" + (d.nfs === 1 ? "" : "s") +
             " cover this ground" + (near.length ? ", " + near.length +
             " of them catalogued under this place or the district it sits in" : "") + ".</p>");
      h.push('<ul class="at-films">');
      /* WHOSE SHELF, WHEN IT IS NOT THIS COUNTRY'S. An 1863 baptism from an
         Istrian village sits in a Croatian archive; a 1915 one from the same
         village is filed under "Italy, Pola and Trieste". Somebody searching
         Croatia will never think to look there, and until now this map could
         not tell them — the harvest treated a collection whose places
         disagreed with its title as an error and threw the places away. Now
         it is a badge on the row, because it is the most useful single thing
         this map knows.
         NOT class ra-filed: that name is already the jurisdiction section's. */
      (near.length ? near : (d.fs || [])).slice(0, 5).forEach(function (c) {
        /* AND THE COLLECTIONS. `collection:<url or title>` is the place page's
           id for the same rows. A collection is a thing you finish — «searched,
           nothing found» against a whole church-book series is one of the most
           useful things a reader can record, and there was nowhere to put it. */
        h.push('<li data-src="collection:' + esc(c.url || c.t) + '" ' +
               'data-src-t="' + esc(c.t) + '" ' +
               'data-src-where="' + esc(CNAME[d.country] || d.country || "") + '" ' +
               'data-src-href="' + esc(c.url) + '">' +
               '<a href="' + esc(c.url) + '" target="_blank" rel="noopener">' +
               esc(c.t) + " &#8599;</a>" +
               (c.from ? ' <span class="at-y">' + c.from + "\u2013" + c.to + "</span>" : "") +
               (c.filed && c.filed.length
                 ? ' <span class="ra-crossed" title="Filed under ' +
                   esc(c.filed.map(ccName).join(", ")) +
                   ', not under this place\u2019s own country \u2014 searching by ' +
                   'country alone will not find it.">filed under ' +
                   esc(c.filed.map(ccName).join(", ")) + "</span>"
                 : "") +
               "</li>");
      });
      h.push("</ul></div>");
    }

    var cs = d.collections.slice();
    if (year) cs = cs.filter(function (c) { return covers(c, year, year2); });
    if (!cs.length) {
      h.push('<p class="at-sub" style="margin-top:16px">' + (year
        ? "Nothing walked here covers " + (year === year2 ? year : year + "\u2013" + year2) + "."
        : (d.nfs ? "Nobody has walked this place volume by volume. The " + d.nfs +
                   " collection" + (d.nfs === 1 ? "" : "s") + " above " +
                   (d.nfs === 1 ? "is" : "are") + " what reaches it, and " +
                   (d.nfs === 1 ? "it is" : "they are") + " where to start."
                 : "No volumes recorded here yet.")) + "</p>");
      return h.join("");
    }

    /* Grouped by what it costs to look, most open first, because that is the
       order a reader actually wants to try them in. */
    var by = {};
    cs.forEach(function (c) { (by[c.access] = by[c.access] || []).push(c); });
    RANK.forEach(function (a) {
      if (!by[a]) return;
      h.push('<div class="at-sec at-sec-wide"><div class="lab"><i class="ra-dot" style="background:' +
             ACC[a][0] + '"></i>' + esc(ACC[a][1]) + "</div>");
      h.push('<ul class="at-films">');
      by[a].forEach(function (c) {
        var span = c.from ? " <span class=\"at-y\">" +
          (c.to && c.to !== c.from ? c.from + "–" + c.to : c.from) + "</span>" : "";
        var who = PROV[c.provider] ? PROV[c.provider].name : c.provider;
        var t = esc(c.title || "Untitled volume");
        /* THE SAME BOOKS AS THE LIST ABOVE, SORTED A SECOND WAY — and that is
           the whole of David's «why do some have a + and some do not». This
           panel shows a place's volumes twice: grouped by what the register
           is (Births, Marriages, Deaths) and grouped by what it costs to look
           at it. The first grouping was wired for marking and the second was
           not, so the same book carried a + in one list and nothing in the
           other, a few hundred pixels apart. That reads as a rule about the
           books when it was only an accident of which loop got the attribute.
           SAME ID, so it is one mark seen twice rather than two marks that can
           disagree: `volume:<waypoint or url or title>`, exactly as above. */
        h.push('<li data-vol="' + esc("volume:" + (c.waypoint || c.url || c.title)) + '"' +
          ' data-vol-t="' + esc(c.title || "Untitled volume") + '"' +
          ' data-vol-where="' + esc(d.name + (d.country ? ", " +
               (CNAME[d.country] || d.country) : "")) + '"' +
          ' data-vol-href="' + esc(BASE + "place/" + d.id + "/") + '">' + (c.url
          ? '<a href="' + esc(c.url) + '" target="_blank" rel="noopener">' + t + " &#8599;</a>"
          : t) + span + ' <span class="ra-who">' + esc(who) + "</span>" +
          (c.held ? ' <span class="ra-who">held at ' + esc(c.held) + "</span>" : "") + "</li>");
      });
      h.push("</ul></div>");
    });
    return h.join("");
  }

  /* A VOLUME ANSWERS FOR A RANGE IF IT OVERLAPS IT AT ALL. A register running
     1798–1858 is exactly what somebody searching 1840–1870 wants, and a rule
     that demanded containment either way round would refuse it. */
  function covers(c, a, b) {
    if (!c.from) return false;
    var to = c.to || c.from;
    return c.from <= (b === undefined ? a : b) && to >= a;
  }

  /* ---- layers ------------------------------------------------------------ */
  /* id, the word on the chip, the sentence behind it, the layer. The short
     word is what fits in a row of seven; the sentence is the tooltip and the
     ⓘ panel, so nothing this used to say has stopped being said. */
  /* ---- EVERY COUNTRY, so that nowhere answers with nothing ---------------
     A marker has always meant «a place with volumes», so Libya — which has a
     FamilySearch research guide, a national archive and a GenWeb project —
     showed empty ground. A country is a place too, and the coarsest possible
     answer is enormously better than a blank. */
  var countryLayer = L.layerGroup(), cpts = [], cmarks = [];
  /* WHICH COUNTRIES THE CURRENT ANSWER IS ABOUT, or null when the
     question is not a surname. See syncCountryDots. */
  var litCC = null;
  /* WHICH QUERY LIT THEM. The country outlines and the country dots are the
     answer to a SURNAME — «this name is attested in these eight countries».
     They were cleared when the box was emptied and when a search found
     nothing, and not when the next search succeeded. So searching a surname
     and then a place left eight countries outlined and eight dots standing,
     answering a question the reader had already moved on from. David saw
     exactly that: «some countries become bordered/outlines indicating
     something, but i dont know what» — they were Blažević's, and he was
     looking at Gračišće. */
  var litFor = null;
  var hitLayer = L.layerGroup(), lastHitFor = null;

  /* ---- THE GROUND YOU WOULD ACTUALLY WALK -------------------------------
     David: «if i really was doing research i would "walk the region" around
     gracisce — parishes, cemeteries, etc within a reasonable neighbours
     realm. could you draw a boundary around that neighbourhood?»

     THE RADIUS IS NOT A NUMBER I PICKED. A fixed 10 km would be a guess
     dressed as a fact, and wrong in both directions — too wide on the Istrian
     plateau, far too narrow on the Canadian prairie. The atlas already knows
     what is near a place, because the place record carries its parishes and
     its cemeteries with the distance to each, researched rather than
     computed. So the circle is drawn to hold them: the furthest of that
     place's own parishes and burial grounds, and far enough to reach a
     handful of neighbouring settlements, whichever is greater.

     Gračišće comes out at about 12 km, which holds its three parishes (8.0,
     8.7, 9.2), its three cemeteries (6.9, 7.9, 11.5) and fourteen villages
     including Pazin — which is exactly the day a researcher would plan.

     Clamped at both ends. Under 4 km the ring is smaller than the village and
     says nothing; over 25 it stops being a neighbourhood and becomes a
     county, and the reader should be looking at the region band by then. */
  var hoodLayer = L.layerGroup();
  var HOOD_MIN = 4, HOOD_MAX = 25, HOOD_NEIGHBOURS = 8;

  function hoodKm(d) {
    var far = 0;
    (d.parishes || []).forEach(function (p) { if (+p.km > far) far = +p.km; });
    (d.graves || []).forEach(function (g) { if (+g.km > far) far = +g.km; });
    /* Far enough to reach the nearest few villages, so a place with no parish
       or cemetery of its own still gets a sensible ring. */
    var ds = [];
    idx.places.forEach(function (p) {
      if (p.y == null || p.i === d.id) return;
      ds.push(haversine(d.lat, d.lon, p.y, p.x));
    });
    ds.sort(function (a, b) { return a - b; });
    var nth = ds[Math.min(HOOD_NEIGHBOURS, ds.length) - 1];
    if (nth != null && nth > far) far = nth;
    return Math.min(HOOD_MAX, Math.max(HOOD_MIN, Math.ceil(far)));
  }

  function haversine(a, b, c, e) {
    var p = Math.PI / 180;
    var x = Math.sin((c - a) * p / 2) * Math.sin((c - a) * p / 2) +
            Math.cos(a * p) * Math.cos(c * p) *
            Math.sin((e - b) * p / 2) * Math.sin((e - b) * p / 2);
    return 2 * 6371 * Math.asin(Math.sqrt(x));
  }

  /* A ring with no caption is decoration. This says what it holds, in the
     panel, using the counts the place record already carries. */
  /* HEADS THE CHECKLIST INSTEAD OF SITTING UNDER THE MAP. David: «can this
     just move to the top of our maps right hand pane?» — it describes the
     ring AND the list the pane holds, so having it in the panel below meant
     the caption and the things it counts were in different places. It is
     returned as a string rather than written into a slot, because the
     checklist rebuilds its own body and would wipe anything written there
     first. */
  function hoodNoteHtml(d, r) {
    if (!r) return "";
    var places = 0;
    idx.places.forEach(function (p) {
      if (p.y == null || p.i === d.id) return;
      if (haversine(d.lat, d.lon, p.y, p.x) <= r) places++;
    });
    var bits = [];
    if (places) bits.push(places + " " + T(places === 1 ? "place" : "places"));
    if ((d.parishes || []).length)
      bits.push(d.parishes.length + " " +
                T(d.parishes.length === 1 ? "parish" : "parishes"));
    if ((d.graves || []).length)
      bits.push(d.graves.length + " " +
                T(d.graves.length === 1 ? "burial ground" : "burial grounds"));
    if (!bits.length) return "";
    return '<p class="ra-hood"><span class="ra-hood-k"></span><span>' +
      esc(T("Within") + " " + r + " km") + " \u2014 " + esc(bits.join(" \u00b7 ")) +
      ". " + esc(T("The ring on the map is the ground worth walking in a day.")) +
      "</span></p>";
  }

  function drawHood(d) {
    hoodLayer.clearLayers();
    if (d.lat == null || d.lon == null) return null;
    var r = hoodKm(d);
    /* Deep navy, dotted, and almost no fill — a boundary to read the map
       through, not a shape laid over it. Round caps make the dashes read as
       dots rather than ticks.

       DRAWN TWICE. A single navy ring at 1.6px disappeared into Istria's
       greens and the pink of the roads; it was on the map and could not be
       found. A soft white ring underneath gives every dot something to sit
       on, so the boundary holds over forest, sea and relief alike without
       making the navy heavier than a hairline. */
    L.circle([d.lat, d.lon], {
      radius: r * 1000, interactive: false,
      color: "#FFFFFF", weight: 5, opacity: .55,
      dashArray: "2 6", lineCap: "round", fill: false
    }).addTo(hoodLayer);
    L.circle([d.lat, d.lon], {
      radius: r * 1000, interactive: false,
      color: "#1B2A5B", weight: 2.2, opacity: 1,
      dashArray: "2 6", lineCap: "round",
      fillColor: "#1B2A5B", fillOpacity: .05
    }).addTo(hoodLayer);
    if (!map.hasLayer(hoodLayer)) hoodLayer.addTo(map);
    return r;
  }

  function clearHood() { hoodLayer.clearLayers(); }

  /* A NEW SEARCH RETIRES THE LAST PLACE'S FURNITURE. David searched «senj»,
     got five matching places on the map, and the right-hand pane still listed
     Gračišće's archive, Gračišće's parishes and Gračišće's villages with
     twenty-two numbered pins to match — stale, and looking authoritative.

     CALLED FROM THE BRANCHES THAT ANSWER WITH SOMETHING OTHER THAN A PLACE,
     not from apply(). My first attempt cleared on any change of search term,
     which also fired on first load — after the ?at= place had already built
     its checklist — so arriving at a link to Gračišće showed no checklist at
     all. The panel's own «the panel must not still be answering the last
     question» note a few hundred lines down is the same bug, found twice. */
  function retireVisit() {
    clearHood(); clearCheckPins();
    var ck = document.getElementById("ra-check");
    if (ck) ck.hidden = true;
  }


  /* Picking one from the list is the same as clicking its dot. */
  document.addEventListener("click", function (ev) {
    /* The panel's door into the right pane. It opens it rather than toggling:
       somebody who just clicked «Where to read» wants it open, and a toggle
       would shut it for the reader who already had it open. */
    var oc = ev.target.closest && ev.target.closest(".ra-open-check");
    if (oc) {
      var ck = document.getElementById("ra-check");
      if (ck && !ck.classList.contains("on")) {
        var tb = document.getElementById("ra-check-t");
        if (tb) tb.click();
      }
      if (ck) ck.scrollIntoView({ block: "nearest" });
      return;
    }
    var sb = ev.target.closest && ev.target.closest(".ra-sn");
    if (sb) { elsewhere(sb.dataset.name, true); return; }
    var b = ev.target.closest && ev.target.closest(".ra-mk");
    if (!b) return;
    var p = matchCache[b.dataset.place];
    if (!p) return;
    markHit(p, fold(qbox.value.trim()));
    open(p);
    map.setView([p.y, p.x], Math.max(map.getZoom(), 11));
  });

  /* ---- the checklist's contents ------------------------------------------
     Everything here is already in the data with a distance against it; none
     of it is computed about the world, only measured from the place. */
  var ACCESS_DOT = function (a) { return (ACC[a] || ["#7C8A91"])[0]; };

  /* NUMBERED, AND THE SAME NUMBER ON THE MAP. David: «could we show all
     those items numbered, and numbered on the map? so a person planning their
     trip can see them in relation to each other?» — which is the difference
     between a list of distances and a route. One running number down the
     whole checklist, archives first, so 1 is the appointment and the rest
     fall around it.

     An item without coordinates still gets its number and simply has no pin;
     nothing in the list is silently dropped for want of a position. */
  var checkPins = [];
  function checkRow(href, name, km, note, dot, num, y, x) {
    if (num != null && y != null && x != null)
      checkPins.push({ n: num, y: y, x: x, name: name });
    return '<li>' +
           (num != null ? '<span class="ra-ck-i">' + num + "</span>" : "") +
           (dot ? '<i class="ra-dot" style="background:' + dot + '"></i>' : "") +
           (href ? '<a href="' + esc(href) + '" target="_blank" rel="noopener">' +
                   esc(name) + "</a>" : esc(name)) +
           (km != null ? ' <span class="ra-ck-km">' + (Math.round(km * 10) / 10) +
                         " km</span>" : "") +
           (note ? '<span class="ra-ck-n">' + esc(note) + "</span>" : "") + "</li>";
  }

  var checkLayer = L.layerGroup();
  function drawCheckPins() {
    checkLayer.clearLayers();
    checkPins.forEach(function (p) {
      L.marker([p.y, p.x], {
        interactive: false, keyboard: false,
        icon: L.divIcon({ className: "ra-pin", iconSize: [19, 19],
                          iconAnchor: [9.5, 9.5], html: String(p.n) })
      }).addTo(checkLayer);
    });
    if (checkPins.length && !map.hasLayer(checkLayer)) checkLayer.addTo(map);
  }
  function clearCheckPins() { checkPins = []; checkLayer.clearLayers(); }

  function buildCheck(d, r) {
    var pane = document.getElementById("ra-check");
    var body = document.getElementById("ra-check-b");
    if (!pane || !body) return;
    if (d.lat == null || !r) { pane.hidden = true; clearCheckPins(); return; }
    clearCheckPins();
    var h = [hoodNoteHtml(d, r)], count = 0;

    /* 1. The archive. The appointment you have to make, and often the only
          one with an opening time. */
    var arch = provs.providers.filter(function (p) {
      return p.at && p.at.lat != null &&
             (p.countries || []).indexOf(d.country) > -1;
    }).map(function (p) {
      return { p: p, km: haversine(d.lat, d.lon, p.at.lat, p.at.lon) };
    /* Within a drive, not merely nearest. Gračišće's third-closest Croatian
       archive is Zadar at 160 km, which is a different holiday; the list said
       so with a straight face because it only asked for the nearest three. */
    }).filter(function (x) { return x.km <= 120; })
      .sort(function (a, b) { return a.km - b.km; }).slice(0, 4);
    /* HELD BACK, NOT DROPPED — see the note above the ordering below. The
       archives are built here because the numbering runs in display order and
       they have to be numbered last; they are emitted after the ring. */
    var archHtml = [];

    /* WHAT IS HERE, BEFORE WHERE YOU MUST TRAVEL. David, looking at Senj:
       «if i wanted to research senj you are sending me out of senj first and
       forgetting everything inside it». He was reading the panel exactly as
       written — «Where the paper is» led with Rijeka at 51.9 km, Gospić at
       61.9, Pazin at 80.3 and Zadar at 100.3, and Senj's own Co-Cathedral at
       0.2 km came after all four.
       The old order had a reason and it is still in the comment above: an
       archive is the appointment you have to make, and often the only thing
       here with an opening time. That is true and it is outranked. A reader
       who has just found Senj is asking what Senj holds; the drive to Zadar
       is the answer to a later question, and putting it first buries the
       parish that wrote the register under four places that did not.
       So: outward from the ground. Parishes, then burial grounds, then the
       villages in the ring, then the archives. */

    /* 2. The parishes. Where the registers were written. */
    if ((d.parishes || []).length) {
      h.push('<h4>' + esc(T("Parishes")) + "</h4><ul>");
      d.parishes.forEach(function (p) {
        count++;
        h.push(checkRow(p.q ? "https://www.wikidata.org/wiki/" + p.q : null,
                        p.n, p.km, null, null, count, p.y, p.x));
      });
      h.push("</ul>");
    }

    /* 3. The burial grounds. Open whenever you are. */
    if ((d.graves || []).length) {
      h.push('<h4>' + esc(T("Burial grounds")) + "</h4><ul>");
      d.graves.forEach(function (g) {
        count++;
        var href = g.src === "wikidata"
          ? "https://www.wikidata.org/wiki/" + g.id
          : g.id ? "https://www.openstreetmap.org/" +
                   ({ w: "way", n: "node", r: "relation" }[g.id[0]] || "way") +
                   "/" + g.id.slice(1)
                 : null;
        /* «A burial ground» rather than a blank. The row is still worth
           walking to; what OpenStreetMap does not know is its name. */
        h.push(checkRow(href, g.n || T("A burial ground"), g.km,
                        g.n ? null : T("unnamed in OpenStreetMap"),
                        null, count, g.y, g.x));
      });
      h.push("</ul>");
    }

    /* 4a. The archives, last, because they are the furthest and the most
           planning. Built at the top of this function, numbered here. */
    if (arch.length) {
      archHtml.push('<h4>' + esc(T("Where the paper is")) + "</h4><ul>");
      arch.forEach(function (x) {
        count++;
        archHtml.push(checkRow(x.p.url, x.p.name, x.km,
                        (ACC[x.p.access] || [0, x.p.access])[1],
                        ACCESS_DOT(x.p.access), count, x.p.at.lat, x.p.at.lon));
      });
      archHtml.push("</ul>");
      h = h.concat(archHtml);
    }

    /* 4. The villages inside the ring, nearest first — their own registers
          may name the same family, and they are a walk apart. */
    var vs = [];
    idx.places.forEach(function (p) {
      if (p.y == null || p.i === d.id) return;
      var km = haversine(d.lat, d.lon, p.y, p.x);
      if (km <= r) vs.push({ p: p, km: km });
    });
    vs.sort(function (a, b) { return a.km - b.km; });
    if (vs.length) {
      h.push('<h4>' + esc(T("Villages within") + " " + r + " km") + "</h4><ul>");
      vs.slice(0, 20).forEach(function (x) {
        count++;
        h.push(checkRow(BASE + "place/" + x.p.i + "/", x.p.n, x.km,
                        x.p.c ? x.p.c + " " + T(x.p.c === 1 ? "volume" : "volumes")
                              : null, null, count, x.p.y, x.p.x));
      });
      if (vs.length > 20)
        h.push('<li class="ra-ck-more">' + esc(T("and") + " " +
               (vs.length - 20) + " " + T("more")) + "</li>");
      h.push("</ul>");
    }

    if (!count) { pane.hidden = true; return; }
    body.innerHTML = h.join("");
    document.getElementById("ra-check-n").textContent = count;
    (document.querySelector(".ra-check-w") || {}).textContent = T("Visiting");
    pane.hidden = false;
    drawCheckPins();
  }

  /* ---- THE SAME PANE, FOR A NAME -----------------------------------------
     David, with Senj and Lerena open side by side: «search by place vs name,
     completely different look and feel. can we align names to places please?
     the timelines the maps, the volumes, the right pane».

     Senj gets a framed map with numbered pins, a right pane reading «WHERE
     THE PAPER IS · Državni arhiv u Rijeci 51.9 km», parishes, burial grounds
     and villages. Lerena got a world map with grey dots and no pane at all —
     and the archives it DOES have were printed as a flat list at the bottom
     of the panel, below the fold, unnumbered and unpinned.

     A name is not a place and the pane cannot be identical: there is no
     «within 14 km» because there is no centre, and no parish for a surname.
     But the two questions rhyme — «where do I go and read» — and the answer
     should be built out of the same parts. So: the same pane, the same
     running number, the same pin on the same map, grouped by country in the
     order the timeline above uses.

     WHAT MAKES THE NUMBER WORTH HAVING IS THAT IT IS ON BOTH. The list is
     ordered by the name's own evidence, not by distance, so a reader working
     down it is walking their family's countries in the order the name
     appears in them. */
  function buildNameCheck(term, byCC, order, rank) {
    var pane = document.getElementById("ra-check");
    var body = document.getElementById("ra-check-b");
    if (!pane || !body) return;
    clearCheckPins();
    if (!order.length) { pane.hidden = true; return; }
    var h = ['<p class="ra-hood ra-hood-n">' +
             '<span class="ra-hood-k ra-hood-k-n"></span><span>' +
             esc(T("Where to read for") + " " + term) + " \u2014 " +
             esc(order.length + " " +
                 T(order.length === 1 ? "country" : "countries") + ", " +
                 T("in the order the name appears in them")) + ".</span></p>"];
    var count = 0;
    h.push("<h4>" + esc(T("Where the paper is")) + "</h4><ul>");
    order.forEach(function (cc) {
      var ps = byCC[cc];
      h.push('<li class="ra-ck-cc">' +
             (cc ? '<a href="' + BASE + "country/" + cc.toLowerCase() + '/">' +
                   esc(CNAME[cc] || cc) + "</a>" : esc(T("Matched by name"))) +
             ' <span class="ra-ck-km">' + ps.length + "</span></li>");
      ps.slice(0, 3).forEach(function (pv) {
        count++;
        /* The access colour is the same vocabulary the place pane uses and a
           reader has already learnt — free, account, index, paid. */
        h.push(checkRow(pv.url, pv.name, null,
                        (ACC[pv.access] || [0, pv.access])[1],
                        ACCESS_DOT(pv.access), count,
                        pv.at ? pv.at.lat : null, pv.at ? pv.at.lon : null));
      });
      if (ps.length > 3)
        h.push('<li class="ra-ck-more">' + esc(T("and") + " " +
               (ps.length - 3) + " " + T("more in") + " " +
               (CNAME[cc] || cc)) + "</li>");
    });
    h.push("</ul>");
    if (!count) { pane.hidden = true; return; }
    body.innerHTML = h.join("");
    document.getElementById("ra-check-n").textContent = count;
    (document.querySelector(".ra-check-w") || {}).textContent = T("Where to read");
    pane.hidden = false;
    drawCheckPins();
    /* AND FRAME THE MAP ON THEM, which is the other half of what makes Senj
       look answered and Lerena look ignored. A world view with a dozen grey
       dots on it is the view you get before you have searched; once there is
       an answer the map should be looking at it. Padded, and never tighter
       than a continent — a name with one archive should not slam to street
       level on a building nobody asked about. */
    if (checkPins.length) {
      var b = L.latLngBounds(checkPins.map(function (pp) { return [pp.y, pp.x]; }));
      map.fitBounds(b.pad(0.25), { maxZoom: 6, animate: false });
    }
  }

  /* Shut by default, and it stays as the reader left it while they move from
     place to place — somebody planning a trip opens it once. */
  (function () {
    var t = document.getElementById("ra-check-t");
    if (!t) return;
    t.addEventListener("click", function () {
      var open = document.getElementById("ra-check").classList.toggle("on");
      t.setAttribute("aria-expanded", open ? "true" : "false");
