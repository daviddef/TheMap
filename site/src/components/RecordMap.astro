  }

  var LAYERS = [
    ["countries", "Countries", "every country on earth · the coarsest answer, and better than a blank", countryLayer],
    ["shelf", T("Shelf"), TOTAL_PLACES.toLocaleString() + " places · every volume that covers them", shelfLayer],
    ["archives", T("Archives"), archives.length + " institutions · where the paper actually is", archiveLayer],
    ["jurisdiction", T("Jurisdiction"), regions.regions.length + " record regions · whose archive this ground was", regionLayer],
    ["wikidata", T("Others"), "loading · unchecked, and not all genealogical", wikiLayer],
    ["cemeteries", T("Cemeteries"), "loading", featLayers.cemeteries],
    ["churches", T("Churches"), "loading", featLayers.churches],
