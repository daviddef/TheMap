---
/* The map. Three layers, a year, and a panel that fetches.

   Descended from the Atlas in the family archives, and different from it in
   three ways that matter.

   ONE — THE COLOUR ANSWERS A STRANGER'S QUESTION. The archive it came from
   coloured a parish by how far one researcher had got with it, which is a true
   and useful thing to know if you are that researcher and meaningless if you
   are not. Here the colour says what you can actually OPEN: free images,
   images behind a login, an index, a paywall, a catalogue card, or paper in a
   building. A place takes the colour of the MOST OPEN thing it has, because
   the question is "can I see anything tonight", and the panel tells the rest.

   TWO — THE YEAR IS A FILTER, NOT A DECORATION. Set it to 1863 and the map
   does not merely shade the borders of 1863: it drops every place that cannot
   answer for that year, and every panel gains the line that is the whole
   reason this site exists — which empire's filing system this ground fell
   under, and therefore whose archive to write to.

   THREE — THE PANEL FETCHES. The index carries only what a marker needs to be
   drawn and found. Everything else arrives per place, on click, from
   p/<id>.json. 1,239 places is 145 KB rather than 2.5 MB, and the number that
   grows with the world is the one that compresses.

   Everything else — the find box, the filter pills, that every view is a link
   — is the family Atlas's and is kept deliberately, because a reader who knows
   one of these maps should know all of them. */
const { indexUrl, detailBase, regionsUrl, providersUrl, gazBase, surnameBase, wikidataUrl, osmUrl, featureBase, settlementBase, base } = Astro.props;
---

<div class="ra-top">
  <div class="lab">The layers — switch any of them on or off</div>
  <div class="ra-layers" id="ra-layers"></div>
</div>

<div class="ra-yearbar">
  <label class="ra-ylab"><input type="checkbox" id="ra-yon" /> <span>Search a year</span></label>
  <input type="range" id="ra-year" min="1500" max="2026" value="1863" step="1" disabled />
  <output id="ra-yout" class="mono">any year</output>
  <p class="ra-yhint" id="ra-yhint">Turn this on and the map keeps only the places that can answer for that year — and every panel says whose archive that year belonged to.</p>
</div>

<div class="at-wrap">
  <div class="at-map" id="ra-map"></div>
  <aside class="at-panel">
    <div class="at-empty" id="ra-empty">
      <div class="lab">Pick a place</div>
      <p>Click any marker. Bigger markers hold more record volumes.</p>
      <p class="at-hint" id="ra-hint"></p>
    </div>
    <div class="at-body" id="ra-body" hidden></div>
  </aside>
</div>

<div class="at-tools">
  <label class="at-find">
    <span class="lab">Find a place, or a surname — by any name it has ever had</span>
    <input id="ra-q" type="search" placeholder="A place or a surname — Gallignana · Žubrinić · Lerena" autocomplete="off" />
  </label>
  <div class="atlas-key" id="ra-cats"></div>
</div>
<p class="cap" id="ra-count"></p>
<p class="cap"><button class="ra-copy" id="ra-copy" type="button">Copy link to this view</button>
  <span class="ra-copied" id="ra-copied" hidden>copied</span></p>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>

<script is:inline define:vars={{ INDEX: indexUrl, DETAIL: detailBase, REGIONS: regionsUrl, PROVIDERS: providersUrl, GAZ: gazBase, SURN: surnameBase, WDA: wikidataUrl, OSMA: osmUrl, FEAT: featureBase, SETT: settlementBase, BASE: base }}>
window.addEventListener("load", async function () {
  var el = document.getElementById("ra-map");
  if (!el || typeof L === "undefined") return;

  var idx, regions, provs;
  try {
    var r = await Promise.all([fetch(INDEX), fetch(REGIONS), fetch(PROVIDERS)]);
    idx = await r[0].json(); regions = await r[1].json(); provs = await r[2].json();
  } catch (e) { el.innerHTML = '<p class="ra-dead">The map data could not be loaded.</p>'; return; }

  var PROV = {}; provs.providers.forEach(function (p) { PROV[p.id] = p; });
  var CNAME = idx.countries || {};
  var XL = { "đ": "d", "ł": "l", "ø": "o", "ß": "ss", "æ": "ae", "œ": "oe" };
  function fold(s) {
    return (s || "").toLowerCase().replace(/[đłøßæœ]/g, function (c) { return XL[c]; })
      .normalize("NFKD").replace(/[̀-ͯ]/g, "");
  }
  var esc = function (x) { return String(x == null ? "" : x)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); };

  /* ---- access, which is what the colour means ---------------------------
     Read off the stylesheet so the two themes stay in one place. */
  var css = getComputedStyle(document.documentElement);
  var ACC = {
    free:      ["#1E8449", "Images, free, no account"],
    account:   ["#6FA82E", "Images, free, account needed"],
    index:     ["#EFC03B", "An index only — no images"],
    mixed:     ["#E8792B", "Partly free, partly paid"],
    paid:      ["#C0392B", "Images, behind a paywall"],
    catalogue: ["#8E6FA8", "A catalogue entry — not photographed"],
    onsite:    ["#7C8A91", "On paper, in the building"],
    unsurveyed:["#B6B2A6", "Nobody has walked this one yet"]
  };
  var RANK = idx.rank || Object.keys(ACC);

  /* ---- URL as state ------------------------------------------------------
     Every view of this map is a link: the layers, the basemap, the year, what
     is typed in the find box, which filters are off, and where the map is
     looking. A view can be sent to somebody rather than only remembered. */
  var Q; try { Q = new URLSearchParams(location.search); } catch (e) { Q = new URLSearchParams(); }
  var writing = false;
  function push() {
    if (writing) return;
    writing = true;
    requestAnimationFrame(function () {
      writing = false;
      var s = Q.toString();
      history.replaceState(null, "", location.pathname + (s ? "?" + s : "") + location.hash);
    });
  }
  function setQ(k, v) { if (v === "" || v == null) Q.delete(k); else Q.set(k, v); push(); }

  var map = L.map(el, { scrollWheelZoom: true, worldCopyJump: true });
  var BASES = {
    map: L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      { attribution: "&copy; OpenStreetMap contributors", maxZoom: 18 }),
    terrain: L.tileLayer("https://tile.opentopomap.org/{z}/{x}/{y}.png",
      { attribution: "&copy; OpenStreetMap contributors, SRTM · OpenTopoMap (CC-BY-SA)", maxZoom: 17 }),
    satellite: L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      { attribution: "Esri, Maxar, Earthstar Geographics", maxZoom: 18 })
  };
  var baseNow = Q.get("base") && BASES[Q.get("base")] ? Q.get("base") : "map";
  BASES[baseNow].addTo(map);

  /* ---- the jurisdiction layer -------------------------------------------
     Regions are shaded by whichever regime held them in the chosen year. With
     no year chosen there is nothing honest to shade, so the layer draws its
     outlines only and says so. */
  var regionLayer = L.layerGroup();
  var regionShapes = regions.regions.map(function (reg) {
    var poly = L.polygon(reg.ring, { color: "#7C8A91", weight: 1.2, opacity: .65,
                                     fillColor: "#7C8A91", fillOpacity: .07 });
    poly.bindTooltip(reg.label, { sticky: true });
    poly.addTo(regionLayer);
    return { reg: reg, poly: poly };
  });
  function eraAt(reg, y) {
    for (var i = 0; i < reg.eras.length; i++) {
      var e = reg.eras[i];
      if (y >= e.from && y <= e.to) return e;
    }
    return null;
  }
  function paintRegions() {
    regionShapes.forEach(function (rs) {
      var e = year && eraAt(rs.reg, year);
      var c = e ? (css.getPropertyValue(regions.regimes[e.regime].var).trim() || "#7C8A91") : "#7C8A91";
      rs.poly.setStyle({ color: c, fillColor: c, fillOpacity: e ? .20 : .07, weight: e ? 1.8 : 1.2 });
      rs.poly.setTooltipContent(e
        ? "<b>" + esc(rs.reg.label) + "</b><br>" + esc(e.polity) + " in " + year
        : esc(rs.reg.label));
    });
  }
  var REGION = {}; regions.regions.forEach(function (r) { REGION[r.id] = r; });

  /* ---- the markers -------------------------------------------------------
     Radius by how many volumes stand at a place, which is the one piece of
     editorial here and worth saying out loud: weight on this map is not
     importance. A parish with ninety volumes nobody has read and a parish with
     two are both on it, and the big one is not the better lead. */
  var shelfLayer = L.layerGroup();
  var markers = idx.places.map(function (p) {
    var n = p.c || 0;
    var m = L.circleMarker([p.y, p.x], {
      radius: Math.min(3 + Math.sqrt(n) * 0.9, 13),
      color: "#fff", weight: 0.8, opacity: .9,
      fillColor: (ACC[p.a] || ["#7C8A91"])[0], fillOpacity: .85
    });
    m._p = p;
    m.bindTooltip(p.n, { sticky: true });
    m.on("click", function () { open(p); });
    return m;
  });

  /* ---- the archives -------------------------------------------------------
     Where the paper physically is. Drawn as a hollow square rather than a
     filled dot because an institution is not a place on the shelf: one archive
     in Zadar holds the registers of two hundred Dalmatian parishes, and
     conflating the two would say there are two hundred archives.

     This layer is also the only one that is genuinely worldwide today, and it
     is what stops the map claiming to cover the earth while showing Croatia. */
  var archiveLayer = L.layerGroup();
  var archives = provs.providers.filter(function (p) { return p.at; });
  var archMarkers = archives.map(function (p) {
    var m = L.marker([p.at.lat, p.at.lon], {
      icon: L.divIcon({ className: "ra-arch", iconSize: [13, 13],
                        html: '<i style="border-color:' + (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' })
    });
    m.bindTooltip(p.name, { sticky: true });
    m.on("click", function () { openArchive(p); });
    m.addTo(archiveLayer);
    /* Searchable by its name, its city, and every country it covers — so
       "Ireland" finds the Dublin archives AND the aggregators that reach
       Ireland from somewhere else entirely. */
    m._q = fold([p.name, p.at.place,
                 (p.countries || []).map(function (c) { return CNAME[c] || c; }).join(" ")
                ].join(" "));
    m._p = p;
    return m;
  });

  /* WIKIDATA'S ARCHIVES — everything it knows the location of, and nobody
     here has opened one. Drawn as a small hollow ring rather than the filled
     diamond a checked provider gets, because the difference between «we have
     read this and it is free» and «Wikidata says there is an archive here» is
     the whole editorial value of the other 178. */
  var wikiLayer = L.layerGroup();
  var wikiMarkers = [];
  (async function () {
    var wd;
    try { wd = await (await fetch(WDA)).json(); } catch (e) { return; }
    wd.archives.forEach(function (a) {
      var m = L.circleMarker([a.y, a.x], {
        radius: 3.4, color: "#8E6FA8", weight: 1.2, opacity: .75,
        fillColor: "#8E6FA8", fillOpacity: .18
      });
      m.bindTooltip(a.n, { sticky: true });
      m.on("click", function () {
        empty.hidden = true; panel.hidden = false;
        var h = ['<div class="at-h"><h3>' + esc(a.n) + "</h3></div>"];
        h.push('<p class="at-also">' + esc(CNAME[a.cc] || a.cc || "") + "</p>");
        h.push('<div class="ra-juris ra-unmapped"><div class="lab">From Wikidata, unchecked' +
               "</div><p>Wikidata records an archive here. <b>Nobody on this project has " +
               "opened it</b>, and it may hold nothing genealogical — corporate, film and " +
               "museum archives are archives too. The " + provs.providers.length +
               " institutions drawn as diamonds have been looked at; this has not.</p></div>");
        if (a.sites && a.sites.length)
          h.push('<p class="at-go"><a href="' + esc(a.sites[0]) +
                 '" target="_blank" rel="noopener">' + esc(a.sites[0]) + " &#8599;</a></p>");
        h.push('<p class="at-sub"><a href="https://www.wikidata.org/wiki/' + esc(a.q) +
               '" target="_blank" rel="noopener">' + esc(a.q) + " on Wikidata &#8599;</a></p>");
        panel.innerHTML = h.join("");
      });
      m.addTo(wikiLayer);
      wikiMarkers.push(m);
    });
    var n = wd.archives.length;
    /* OpenStreetMap's archives share this layer and this caveat. They are a
       separate FILE because ODbL is share-alike and everything else here is
       CC0 — but to a reader they are the same kind of claim: somebody mapped
       an archive here and nobody on this project has opened it. */
    try {
      var om = await (await fetch(OSMA)).json();
      om.archives.forEach(function (a) {
        var m = L.circleMarker([a.y, a.x], {
          radius: 3.4, color: "#4E7A55", weight: 1.2, opacity: .75,
          fillColor: "#4E7A55", fillOpacity: .18
        });
        m.bindTooltip(a.n, { sticky: true });
        m.on("click", function () {
          empty.hidden = true; panel.hidden = false;
          var h = ['<div class="at-h"><h3>' + esc(a.n) + "</h3></div>"];
          if (a.by) h.push('<p class="at-also">' + esc(a.by) + "</p>");
          h.push('<div class="ra-juris ra-unmapped"><div class="lab">From OpenStreetMap, ' +
                 "unchecked</div><p>Somebody mapped an archive at this spot. Nobody here " +
                 "has opened it. &copy; OpenStreetMap contributors, ODbL.</p></div>");
          if (a.site) h.push('<p class="at-go"><a href="' + esc(a.site) +
                             '" target="_blank" rel="noopener">' + esc(a.site) + " &#8599;</a></p>");
          panel.innerHTML = h.join("");
        });
        m.addTo(wikiLayer);
      });
      n += om.archives.length;
    } catch (e) {}
    var lab = document.querySelector('.ra-layer[data-l="wikidata"] span');
    if (lab) lab.textContent = n + " mapped by others · unchecked, and not all genealogical";
    if (on.wikidata) wikiLayer.addTo(map);
  })();

  /* THE GROUND ITSELF — cemeteries, churches, libraries, inside the record
     regions only. Wikidata knows 295,702 cemeteries and 273,894 churches
     worldwide; drawing them all would be a map of Wikidata rather than of
     where records are, and would bury 2,130 walked places under half a
     million dots. The regions are the ground this project has worked out. */
  var FEATS = [
    ["cemeteries", "Cemeteries", "#6C5CE0", 2.8],
    ["churches",   "Churches and parishes", "#B07CD9", 2.6],
    ["libraries",  "Libraries", "#2E86C1", 3.0]
  ];
  var featLayers = {};
  FEATS.forEach(function (F) {
    var key = F[0], layer = L.layerGroup();
    featLayers[key] = layer;
    (async function () {
      var d;
      try { d = await (await fetch(FEAT + key + "-wikidata.json")).json(); }
      catch (e) { return; }
      d.features.forEach(function (f) {
        var m = L.circleMarker([f.y, f.x], {
          radius: F[3], color: F[2], weight: 1, opacity: .7,
          fillColor: F[2], fillOpacity: .35
        });
        m.bindTooltip(f.n, { sticky: true });
        m.on("click", function () {
          empty.hidden = true; panel.hidden = false;
          panel.innerHTML =
            '<div class="at-h"><h3>' + esc(f.n) + "</h3></div>" +
            '<p class="at-also">' + esc(F[1]) + "</p>" +
            '<div class="ra-juris ra-unmapped"><div class="lab">From Wikidata, unchecked' +
            "</div><p>Wikidata records this here, inside the <b>" + esc(f.r) +
            "</b> record region. Nobody on this project has been. It is drawn because the " +
            "ground a family stood on is part of where its records are.</p></div>" +
            '<p class="at-sub"><a href="https://www.wikidata.org/wiki/' + esc(f.q) +
            '" target="_blank" rel="noopener">' + esc(f.q) + " on Wikidata &#8599;</a></p>";
        });
        m.addTo(layer);
      });
      var lab = document.querySelector('.ra-layer[data-l="' + key + '"] span');
      if (lab) lab.textContent = d.features.length + " in the record regions · from Wikidata, unchecked";
      if (on[key]) layer.addTo(map);
    })();
  });

  /* Which record regions name this archive as the holder of their records, and
     for how many eras. An archive that four regions cite for twenty eras is a
     different proposition from one nobody has connected to any ground yet. */
  function citedBy(id) {
    var out = [];
    regions.regions.forEach(function (r) {
      var n = r.eras.filter(function (e) { return e.filedUnder.indexOf(id) > -1; }).length;
      if (n) out.push({ label: r.label, n: n });
    });
    return out;
  }

  function openArchive(p) {
    empty.hidden = true; panel.hidden = false;
    setQ("at", "");
    var h = [];
    h.push('<div class="at-h"><h3>' + esc(p.name) + "</h3></div>");
    h.push('<p class="at-also">' + esc(p.at.place) + "</p>");
    h.push('<p class="at-what">' + esc(p.what) + "</p>");
    h.push('<p class="ra-acc"><i class="ra-dot" style="background:' +
           (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' +
           esc((ACC[p.access] || [0, p.access])[1]) + "</p>");
    var cite = citedBy(p.id);
    if (cite.length) {
      h.push('<div class="at-sec"><div class="lab">Holds the records of</div><ul class="at-films">');
      cite.forEach(function (c) {
        h.push("<li>" + esc(c.label) + ' <span class="at-y">' + c.n +
               " era" + (c.n === 1 ? "" : "s") + "</span></li>");
      });
      h.push("</ul></div>");
    }
    h.push('<p class="at-go"><a href="' + BASE + "archive/" + esc(p.id) + '/">' +
           "Everything about " + esc(p.name) + " &rarr;</a> · " +
           '<a href="' + esc(p.url) + '" target="_blank" rel="noopener">the site &#8599;</a></p>');
    h.push('<p class="at-sub">Last checked ' + esc(p.checked) + ".</p>");
    panel.innerHTML = h.join("");
  }

  /* ---- the panel, fetched per place --------------------------------------
     The index cannot carry this and should not try. */
  var panel = document.getElementById("ra-body"), empty = document.getElementById("ra-empty");
  var cache = {};
  async function open(p) {
    empty.hidden = true; panel.hidden = false;
    panel.innerHTML = '<p class="at-sub">Fetching ' + esc(p.n) + "…</p>";
    var d = cache[p.i];
    if (!d) {
      try { d = cache[p.i] = await (await fetch(DETAIL + p.i + ".json")).json(); }
      catch (e) { panel.innerHTML = '<p class="at-sub">Could not load this place.</p>'; return; }
    }
    setQ("at", p.i);
    panel.innerHTML = render(d);
  }

  function render(d) {
    var h = [];
    h.push('<div class="at-h"><h3>' + esc(d.name) + "</h3>");
    if (d.collections.length)
      h.push('<span class="at-n">' + d.collections.length + " volume" +
             (d.collections.length === 1 ? "" : "s") + "</span>");
    h.push("</div>");

    var alsoNames = (d.names || []).map(function (n) { return n.n; });
    if (alsoNames.length)
      h.push('<p class="at-also">also written ' + alsoNames.map(function (x) {
        return "<em>" + esc(x) + "</em>"; }).join(" · ") + "</p>");

    if (d.filedUnder) {
      h.push('<div class="ra-juris" style="border-left-color:#C0392B">' +
             '<div class="lab">Filed under another country</div><p>' +
             esc(d.name) + " is in " + esc(CNAME[d.country] || d.country) +
             " today. FamilySearch catalogues it under <b>" +
             esc(CNAME[d.filedUnder] || d.filedUnder) +
             "</b>, because that is who held the ground when the records were made.</p></div>");
    }
    if (d.level) {
      h.push('<p class="at-sub">A ' + esc(d.level) + ", not a town — the marker is at its " +
             "centre, not at a building.</p>");
    }

    /* THE LINE THIS SITE EXISTS FOR. */
    var reg = d.region && REGION[d.region];
    if (reg) {
      if (year) {
        var e = eraAt(reg, year);
        if (e) {
          h.push('<div class="ra-juris"><div class="lab">In ' + year + ', this was</div>');
          h.push("<p><b>" + esc(e.polity) + "</b></p>");
          if (e.filedUnder.length) {
            h.push('<p class="ra-filed">Records of this period are filed under ' +
              e.filedUnder.map(function (f) {
                var pv = PROV[f];
                return pv ? '<a href="' + esc(pv.url) + '" target="_blank" rel="noopener">' +
                            esc(pv.name) + "</a>" : esc(f);
              }).join(" · ") + ".</p>");
          } else {
            h.push('<p class="ra-filed">No registers survive for this period anywhere.</p>');
          }
          if (e.note) h.push('<p class="ra-note">' + esc(e.note) + "</p>");
          h.push("</div>");
        }
      } else {
        h.push('<div class="ra-juris"><div class="lab">Whose ground this was</div>' +
               "<p>" + esc(reg.label) + " — <a href=\"#\" class=\"ra-setyear\">set a year</a> " +
               "to see which empire held it, and whose archive that means.</p></div>");
      }
    } else {
      h.push('<div class="ra-juris ra-unmapped"><div class="lab">Whose ground this was</div>' +
             "<p>Not yet mapped. The record regions cover Istria, the Kvarner, Carnia and " +
             "Dalmatia so far — this place is outside them, and that is a gap in this map " +
             "rather than a gap in the record.</p></div>");
    }

    /* The page behind the panel. A marker is a view; a page is a thing you
       can send somebody, bookmark, or find from a search engine — and until
       these existed, 1,239 places had no address of their own. */
    h.push('<p class="at-go"><a href="' + BASE + "place/" + esc(d.id) + '/">' +
           "Everything about " + esc(d.name) + " &rarr;</a></p>");

    /* The collections that reach this ground. The panel shows the nearest few
       and the page shows them all — a marker is a glance, not a catalogue. */
    if (d.nfs) {
      var near = (d.fs || []).filter(function (c) { return c.rank <= 1; });
      h.push('<div class="at-sec"><div class="lab">FamilySearch reaches here</div>');
      h.push('<p class="at-sub">' + d.nfs + " collection" + (d.nfs === 1 ? "" : "s") +
             " cover this ground" + (near.length ? ", " + near.length + " of them by name or "
             + "within 75 km" : "") + ".</p>");
      h.push('<ul class="at-films">');
      (near.length ? near : (d.fs || [])).slice(0, 5).forEach(function (c) {
        h.push('<li><a href="' + esc(c.url) + '" target="_blank" rel="noopener">' +
               esc(c.t) + " &#8599;</a>" +
               (c.from ? ' <span class="at-y">' + c.from + "\u2013" + c.to + "</span>" : "") +
               "</li>");
      });
      h.push("</ul></div>");
    }

    var cs = d.collections.slice();
    if (year) cs = cs.filter(function (c) { return covers(c, year); });
    if (!cs.length) {
      h.push('<p class="at-sub" style="margin-top:16px">' + (year
        ? "Nothing here covers " + year + "."
        : "No volumes recorded here yet.") + "</p>");
      return h.join("");
    }

    /* Grouped by what it costs to look, most open first, because that is the
       order a reader actually wants to try them in. */
    var by = {};
    cs.forEach(function (c) { (by[c.access] = by[c.access] || []).push(c); });
    RANK.forEach(function (a) {
      if (!by[a]) return;
      h.push('<div class="at-sec"><div class="lab"><i class="ra-dot" style="background:' +
             ACC[a][0] + '"></i>' + esc(ACC[a][1]) + "</div>");
      h.push('<ul class="at-films">');
      by[a].forEach(function (c) {
        var span = c.from ? " <span class=\"at-y\">" +
          (c.to && c.to !== c.from ? c.from + "–" + c.to : c.from) + "</span>" : "";
        var who = PROV[c.provider] ? PROV[c.provider].name : c.provider;
        var t = esc(c.title || "Untitled volume");
        h.push("<li>" + (c.url
          ? '<a href="' + esc(c.url) + '" target="_blank" rel="noopener">' + t + " &#8599;</a>"
          : t) + span + ' <span class="ra-who">' + esc(who) + "</span>" +
          (c.held ? ' <span class="ra-who">held at ' + esc(c.held) + "</span>" : "") + "</li>");
      });
      h.push("</ul></div>");
    });
    return h.join("");
  }

  function covers(c, y) {
    if (!c.from) return false;
    return y >= c.from && y <= (c.to || c.from);
  }

  /* ---- layers ------------------------------------------------------------ */
  var LAYERS = [
    ["shelf", "The shelf", idx.places.length + " places · every volume that covers them", shelfLayer],
    ["archives", "The archives", archives.length + " institutions · where the paper actually is", archiveLayer],
    ["jurisdiction", "The jurisdiction", regions.regions.length + " record regions · whose archive this ground was", regionLayer],
    ["wikidata", "Mapped by others", "loading · unchecked, and not all genealogical", wikiLayer],
    ["cemeteries", "Cemeteries", "loading", featLayers.cemeteries],
    ["churches", "Churches and parishes", "loading", featLayers.churches],
    ["libraries", "Libraries", "loading", featLayers.libraries]
  ];
  var on = {};
  (Q.get("layers") !== null ? Q.get("layers").split(",").filter(Boolean) : ["shelf"])
    .forEach(function (k) { on[k] = true; });
  if (!Object.keys(on).length) on.shelf = true;

  var lbox = document.getElementById("ra-layers");
  lbox.innerHTML = LAYERS.map(function (l) {
    return '<label class="ra-layer' + (on[l[0]] ? " on" : "") + '" data-l="' + l[0] + '">' +
      '<input type="checkbox"' + (on[l[0]] ? " checked" : "") + ' />' +
      "<b>" + esc(l[1]) + "</b><span>" + esc(l[2]) + "</span></label>";
  }).join("");
  function syncLayers() {
    LAYERS.forEach(function (l) {
      var has = map.hasLayer(l[3]);
      if (on[l[0]] && !has) l[3].addTo(map);
      if (!on[l[0]] && has) map.removeLayer(l[3]);
    });
    var live = LAYERS.filter(function (l) { return on[l[0]]; }).map(function (l) { return l[0]; });
    setQ("layers", live.join(","));
  }
  lbox.addEventListener("change", function (ev) {
    var lab = ev.target.closest(".ra-layer"); if (!lab) return;
    var k = lab.getAttribute("data-l");
    on[k] = ev.target.checked;
    lab.classList.toggle("on", !!on[k]);
    syncLayers();
  });

  /* ---- the access filter pills ------------------------------------------- */
  var off = {};
  (Q.get("off") || "").split(",").filter(Boolean).forEach(function (k) { off[k] = true; });
  document.getElementById("ra-cats").innerHTML = RANK.map(function (a) {
    return '<button class="at-cat' + (off[a] ? "" : " on") + '" data-cat="' + a + '">' +
      '<i style="background:' + ACC[a][0] + '"></i>' + esc(ACC[a][1]) + "</button>";
  }).join("");
  document.getElementById("ra-cats").addEventListener("click", function (ev) {
    var b = ev.target.closest(".at-cat"); if (!b) return;
    var c = b.getAttribute("data-cat");
    off[c] = !off[c];
    b.classList.toggle("on", !off[c]);
    setQ("off", Object.keys(off).filter(function (k) { return off[k]; }).join(","));
    apply();
  });

  /* ---- the year ---------------------------------------------------------- */
  var year = null;
  var yon = document.getElementById("ra-yon"), yin = document.getElementById("ra-year"),
      yout = document.getElementById("ra-yout");
  var qy = parseInt(Q.get("year"), 10);
  if (qy >= 1500 && qy <= 2026) { year = qy; yon.checked = true; yin.value = qy; }
  function yearUI() {
    yin.disabled = !year;
    yout.textContent = year ? String(year) : "any year";
    document.getElementById("ra-yhint").textContent = year
      ? "Showing only what can answer for " + year + ". Every panel now says whose archive that year belonged to."
      : "Turn this on and the map keeps only the places that can answer for that year — and every panel says whose archive that year belonged to.";
    setQ("year", year || "");
    paintRegions();
    apply();
    var at = Q.get("at");
    if (at && cache[at]) { panel.innerHTML = render(cache[at]); }
  }
  yon.addEventListener("change", function () {
    year = yon.checked ? parseInt(yin.value, 10) : null;
    yearUI();
  });
  yin.addEventListener("input", function () {
    if (!yon.checked) return;
    year = parseInt(yin.value, 10);
    yout.textContent = String(year);
    clearTimeout(yin._t);
    yin._t = setTimeout(yearUI, 120);
  });
  document.addEventListener("click", function (ev) {
    if (!ev.target.classList || !ev.target.classList.contains("ra-setyear")) return;
    ev.preventDefault();
    yon.checked = true; year = parseInt(yin.value, 10); yearUI();
    yin.scrollIntoView({ block: "center", behavior: "smooth" });
  });

  /* ---- find, filter, count ----------------------------------------------- */
  var qbox = document.getElementById("ra-q"), count = document.getElementById("ra-count");
  qbox.value = Q.get("q") || "";
  /* A year the place cannot answer for is a place that is not an answer. The
     index carries no spans, so this uses the volume count as a cheap proxy and
     the panel does the exact test — except that the exact test is the one that
     matters, so spans ride in the index after all. See build.py. */
  function keep(p) {
    if (off[p.a]) return false;
    var t = fold(qbox.value.trim());
    /* `q` now holds only the forms that are NOT the place's own name, so the
       name itself is folded here rather than shipped 2,128 times. */
    if (t && fold(p.n).indexOf(t) < 0 && !(p.q && p.q.indexOf(t) > -1)) return false;
    if (year && p.s && (year < p.s[0] || year > p.s[1])) return false;
    return true;
  }
  function apply() {
    var t = fold(qbox.value.trim());
    var shown = 0;
    markers.forEach(function (m) {
      var ok = keep(m._p);
      if (ok) { if (!shelfLayer.hasLayer(m)) m.addTo(shelfLayer); shown++; }
      else if (shelfLayer.hasLayer(m)) shelfLayer.removeLayer(m);
    });
    var aShown = 0;
    archMarkers.forEach(function (m) {
      var ok = !t || m._q.indexOf(t) > -1;
      if (ok) { if (!archiveLayer.hasLayer(m)) m.addTo(archiveLayer); aShown++; }
      else if (archiveLayer.hasLayer(m)) archiveLayer.removeLayer(m);
    });
    count.textContent = shown + " of " + markers.length + " places shown" +
      (year ? ", able to answer for " + year : "") +
      (on.archives ? ", and " + aShown + " of " + archives.length + " archives" : "");

    if (!t) return;
    var vis = markers.filter(function (m) { return shelfLayer.hasLayer(m); });
    var avis = archMarkers.filter(function (m) { return archiveLayer.hasLayer(m); });
    var frame = vis.concat(on.archives ? avis : []);
    if (frame.length) {
      map.fitBounds(L.latLngBounds(frame.map(function (m) { return m.getLatLng(); })),
                    { padding: [40, 40], maxZoom: 11 });
      if (vis.length === 1) { open(vis[0]._p); return; }
    }
    /* THE HONEST EMPTY RESULT. Somebody typing "Ireland" has asked a real
       question, and a blank map answers it with a falsehood. There is no Irish
       shelf here YET — but there are providers that cover Ireland and archives
       standing in Dublin, and the difference between "we have not walked this"
       and "there is nothing here" has to be said out loud every single time or
       the map quietly implies a completeness it does not have. */
    if (!shown) elsewhere(qbox.value.trim());
  }

  /* SURNAMES. A place is not the only thing somebody arrives holding: very
     often all they have is a name on a certificate and no idea which country
     to start in. This answers that — the spellings the name also takes, the
     countries it is attested in, and from there the collections and archives
     that reach those countries.

     «Attested in» means the name appears in a dataset held here. It never
     means the name exists there and nowhere else, and the panel says so. */
  var scache = {};
  async function surnames(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in scache)) {
      try { scache[key] = await (await fetch(SURN + key + ".json")).json(); }
      catch (e) { scache[key] = []; }
    }
    var hit = [];
    scache[key].forEach(function (r) {
      var q = fold(r.n);
      var m = q === f ? 0 : q.indexOf(f) === 0 ? 1 : null;
      if (m === null) {
        for (var i = 0; i < r.variants.length; i++) {
          var fv = fold(r.variants[i].n);
          if (fv === f) { m = 2; break; }
          if (fv.indexOf(f) === 0 && m === null) m = 3;
        }
      }
      if (m !== null) hit.push([m, r]);
    });
    hit.sort(function (a, b) {
      return a[0] - b[0] || (b[1].countries.length - a[1].countries.length);
    });
    /* ONE CARD PER CLUSTER. Searching «Llerena» returned LLERENA, LARENA and
       LERENA as three separate panels saying much the same thing, because
       each is a hit in its own right. They are one family of spellings: if a
       name is already listed as a variant of something shown above it, it is
       not news. The best-ranked one wins and carries the rest. */
    var shown = [], claimed = {};
    hit.forEach(function (x) {
      var r = x[1];
      if (claimed[fold(r.n)]) return;
      shown.push(r);
      claimed[fold(r.n)] = true;
      r.variants.forEach(function (v) { claimed[fold(v.n)] = true; });
    });
    return shown.slice(0, 4);
  }

  var HOWLAB = {
    curated: "a person linked these",
    archive: "appears in a family archive",
    sounds:  "only sounds alike"
  };

  function renderSurnames(list, term) {
    var h = [];
    list.forEach(function (r) {
      h.push('<div class="ra-surn"><div class="lab">The name</div>');
      h.push("<p><b>" + esc(r.n) + "</b></p>");

      var cur = r.variants.filter(function (v) { return v.how !== "sounds"; });
      var snd = r.variants.filter(function (v) { return v.how === "sounds"; });
      if (cur.length)
        h.push('<p class="ra-vars"><span class="ra-tag">also written</span> ' +
               cur.map(function (v) { return "<em>" + esc(v.n) + "</em>"; }).join(" · ") + "</p>");
      if (snd.length)
        h.push('<p class="ra-vars ra-weak"><span class="ra-tag">only sounds alike</span> ' +
               snd.slice(0, 8).map(function (v) { return esc(v.n); }).join(" · ") + "</p>");

      if (r.countries.length) {
        h.push('<p class="ra-filed">Attested in ' +
          r.countries.map(function (c) {
            return '<a href="' + BASE + "country/" + c.cc.toLowerCase() + '/">' +
                   esc(CNAME[c.cc] || c.cc) + "</a>";
          }).join(" · ") + ".</p>");
        h.push('<p class="ra-note">That means the name appears in a dataset held here — ' +
               "not that it exists in those countries and nowhere else. The " +
               "blanks on this map are gaps in it, as always.</p>");
      } else {
        h.push('<p class="ra-note">No country attested yet. The name is known; where it ' +
               "is found is not, which is a gap in this map rather than in the world.</p>");
      }
      h.push("</div>");
    });
    return h.join("");
  }

  /* The worldwide gazetteer, fetched three letters at a time and kept.
     48,906 places and 212,101 names they have been written under — enough to
     answer "the name changed" for the whole earth, which is the one of the
     three problems that does not need a shelf to solve. */
  var gcache = {}, gmark = null;
  async function gazetteer(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in gcache)) {
      try { gcache[key] = await (await fetch(GAZ + key + ".json")).json(); }
      catch (e) { gcache[key] = []; }
    }
    var hit = [];
    gcache[key].forEach(function (r) {
      var fn = fold(r[0]);
      var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
      if (m === null) {
        /* r[5] is every form the place has ever been written in, folded and
           space-joined — not the curated display list, which is missing the
           very names people type. */
        var best = null;
        (r[5] || "").split(" ").forEach(function (fa) {
          var v = fa === f ? 3 : fa.indexOf(f) === 0 ? 4 : fa.indexOf(f) > -1 ? 5 : null;
          if (v !== null && (best === null || v < best)) best = v;
        });
        m = best;
      }
      if (m !== null) hit.push([m, r]);
    });
    /* An exact hit on the current name first, then a prefix, then an exact hit
       on a FORMER name — and the shard is already in population order, which
       is the right tie-break: somebody typing Czernowitz means Chernivtsi, not
       a suburb of Brno that kept the same name. */
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return hit.slice(0, 8).map(function (x) { return x[1]; });
  }

  /* Settlements inside a record region that hold no volumes here. They are
     not drawn — 8,352 grey dots would bury the 2,128 that carry something —
     but a reader holding a village name still gets the answer they came for,
     because the region knows whose archive held that ground. */
  var setcache = {};
  async function settlements(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in setcache)) {
      try { setcache[key] = await (await fetch(SETT + key + ".json")).json(); }
      catch (e) { setcache[key] = []; }
    }
    return setcache[key].filter(function (r) {
      return fold(r.n).indexOf(f) > -1;
    }).slice(0, 4);
  }

  async function elsewhere(term) {
    var f = fold(term);
    var iso = Object.keys(CNAME).filter(function (k) {
      return fold(CNAME[k]).indexOf(f) > -1 || k.toLowerCase() === f;
    });
    var cover = provs.providers.filter(function (p) {
      if (iso.some(function (k) { return (p.countries || []).indexOf(k) > -1; })) return true;
      if (p.at && fold(p.at.place).indexOf(f) > -1) return true;
      return fold(p.name).indexOf(f) > -1;
    });
    var hits = await gazetteer(term);
    var names = await surnames(term);
    var setts = await settlements(term);
    /* If the typed word is an OLD name, say which one it matched and what the
       place is called now. "Pressburg → Bratislava" is the whole answer to the
       first of the three problems, and it works in any country on earth. */
    empty.hidden = true; panel.hidden = false;
    var h = ['<div class="at-h"><h3>' + esc(term) + "</h3></div>"];
    if (names.length) h.push(renderSurnames(names, term));
    /* A village inside a mapped region: no shelf, but a jurisdiction answer,
       which is the thing this map is actually for. */
    setts.forEach(function (r) {
      var reg = REGION[r.r];
      if (!reg) return;
      var e = year ? eraAt(reg, year) : null;
      h.push('<div class="ra-juris"><div class="lab">A place in a mapped region</div>');
      h.push("<p><b>" + esc(r.n) + "</b> — " + esc(CNAME[r.k] || r.k) +
             ', in <a href="' + BASE + "region/" + esc(r.r) + '/">' +
             esc(reg.label) + "</a>.</p>");
      if (e) {
        h.push('<p class="ra-filed">In ' + year + " this was <b>" + esc(e.polity) +
               "</b>" + (e.filedUnder.length ? ", and records of that period are filed under " +
               e.filedUnder.map(function (x) {
                 return PROV[x] ? esc(PROV[x].name) : esc(x); }).join(" · ") : "") + ".</p>");
      } else {
        h.push('<p class="ra-filed">No volumes here yet — but the ground is mapped. ' +
               '<a href="#" class="ra-setyear">Set a year</a> and this will say whose ' +
               "empire held it, and therefore whose archive holds the paper.</p>");
      }
      h.push("</div>");
    });
    if (hits.length) {
      if (gmark) { map.removeLayer(gmark); gmark = null; }
      var top = hits[0];
      gmark = L.circleMarker([top[1], top[2]], {
        radius: 9, color: "var(--accent)", weight: 2, opacity: .9,
        fillColor: "#8E6FA8", fillOpacity: .35, dashArray: "3 3"
      }).addTo(map);
      map.setView([top[1], top[2]], Math.max(map.getZoom(), 8));
      h.push('<div class="ra-juris"><div class="lab">That name is a place</div>');
      hits.slice(0, 5).forEach(function (r) {
        var older = r[4].filter(function (a) { return fold(a) !== fold(r[0]); });
        /* If what they typed is a form the curated list left out, put it back
           at the front — it is the one word on this panel they already trust. */
        if (!older.some(function (a) { return fold(a).indexOf(f) > -1; }))
          older.unshift(term);
        older = older.slice(0, 5);
        h.push("<p><b>" + esc(r[0]) + "</b> — " + esc(CNAME[r[3]] || r[3]) +
               (older.length ? '<br><span class="ra-who">also written ' +
                 older.map(esc).join(" · ") + "</span>" : "") + "</p>");
      });
      h.push("</div>");
    }
    /* Only worth printing when it adds something. Typing "Ireland" and being
       told "Ireland" is noise; typing "HR" and being told "Croatia" is not. */
    var named = iso.map(function (k) { return CNAME[k]; })
                   .filter(function (n) { return fold(n) !== f; });
    if (named.length)
      h.push('<p class="at-also">' + named.map(esc).join(" · ") + "</p>");
    /* Widen the provider list to the country the gazetteer just landed in —
       somebody who typed Pressburg wants Slovakia's sources, and has not said
       the word "Slovakia" at any point. */
    names.forEach(function (r) {
      r.countries.forEach(function (c) { if (iso.indexOf(c.cc) < 0) iso.push(c.cc); });
    });
    if (hits.length || names.length) {
      hits.slice(0, 3).forEach(function (r) { if (iso.indexOf(r[3]) < 0) iso.push(r[3]); });
      cover = provs.providers.filter(function (p) {
        if (iso.some(function (k) { return (p.countries || []).indexOf(k) > -1; })) return true;
        if (p.at && fold(p.at.place).indexOf(f) > -1) return true;
        return fold(p.name).indexOf(f) > -1;
      });
    }
    h.push('<p class="at-what"><b>No places of that name here yet.</b> The shelf — the volume-by-volume ' +
           "layer — is deep for Croatia, Istria and Carnia and has not been walked anywhere " +
           "else. <b>That is a gap in this map, not a gap in the record.</b></p>");
    if (cover.length) {
      h.push('<div class="at-sec"><div class="lab">But these reach it</div><ul class="at-films">');
      cover.slice(0, 14).forEach(function (p) {
        h.push('<li><a href="' + esc(p.url) + '" target="_blank" rel="noopener">' +
               esc(p.name) + " &#8599;</a> <span class=\"ra-who\">" +
               esc((ACC[p.access] || [0, p.access])[1]) + "</span>" +
               (p.at ? ' <span class="ra-who">' + esc(p.at.place) + "</span>" : "") + "</li>");
      });
      h.push("</ul>");
      if (cover.length > 14) h.push('<p class="at-sub">and ' + (cover.length - 14) + " more.</p>");
      h.push("</div>");
      h.push('<p class="at-sub">Switch on <b>The archives</b> above to see the ones that have ' +
             "a building.</p>");
    } else {
      h.push('<p class="at-sub">Nothing in this map reaches it either — which is exactly the ' +
             "kind of gap worth telling us about.</p>");
    }
    panel.innerHTML = h.join("");
  }
  qbox.addEventListener("input", function () {
    setQ("q", qbox.value.trim());
    clearTimeout(qbox._t);
    qbox._t = setTimeout(apply, 140);
  });

  /* ---- basemap switch, home, and the view in the address bar -------------- */
  var bctl = L.control({ position: "topright" });
  bctl.onAdd = function () {
    var b = L.DomUtil.create("div", "leaflet-bar ra-base");
    b.innerHTML = ["map", "terrain", "satellite"].map(function (k) {
      return '<a href="#" data-b="' + k + '"' + (k === baseNow ? ' class="on"' : "") + ">" + k + "</a>";
    }).join("");
    L.DomEvent.disableClickPropagation(b);
    L.DomEvent.on(b, "click", function (e) {
      var a = e.target.closest("a[data-b]"); if (!a) return;
      L.DomEvent.stop(e);
      var k = a.getAttribute("data-b");
      if (k === baseNow) return;
      map.removeLayer(BASES[baseNow]);
      baseNow = k; BASES[k].addTo(map); BASES[k].bringToBack();
      b.querySelectorAll("a").forEach(function (x) {
        x.classList.toggle("on", x.getAttribute("data-b") === k); });
      setQ("base", k === "map" ? "" : k);
    });
    return b;
  };
  bctl.addTo(map);

  /* Two home views, because the map is two maps. The shelf is Croatian ground
     and opens on it; the archives are worldwide and opening on Istria would
     hide forty of the forty-one. */
  var HOME = (on.archives || on.jurisdiction) ? [[-42, -125], [62, 175]]
                                             : [[42.2, 12.4], [46.9, 19.6]];
  var v = (Q.get("view") || "").split(",").map(Number);
  if (v.length === 3 && v.every(function (n) { return !isNaN(n); })) map.setView([v[0], v[1]], v[2]);
  else map.fitBounds(L.latLngBounds(HOME), { padding: [24, 24] });
  map.on("moveend", function () {
    var c = map.getCenter();
    setQ("view", c.lat.toFixed(4) + "," + c.lng.toFixed(4) + "," + map.getZoom());
  });

  document.getElementById("ra-copy").addEventListener("click", function () {
    navigator.clipboard.writeText(location.href).then(function () {
      var t = document.getElementById("ra-copied");
      t.hidden = false; setTimeout(function () { t.hidden = true; }, 1600);
    });
  });

  document.getElementById("ra-hint").textContent =
    idx.places.length + " places, " +
    idx.places.reduce(function (a, p) { return a + (p.c || 0); }, 0) +
    " record volumes. Search by any name a place has ever had — Gallignana finds Gračišće.";

  syncLayers();
  paintRegions();
  yearUI();

  var openAt = Q.get("at");
  if (openAt) {
    var hit = idx.places.filter(function (p) { return p.i === openAt; })[0];
    if (hit) open(hit);
  }
});
</script>

<style>
  .ra-top { margin-top: 10px; }
  /* The layer switches and the filter pills are written by the script with
     innerHTML, so they never carry Astro's scope attribute — which means every
     rule that styles them matches nothing at all unless it is :global. The
     component this descends from learned that the expensive way. */
  .ra-layers { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
