  /* A NAME AND A BADGE. These read «Layers — 2 of 8 on», «What it costs to
     look — all 8 shown», «What kind of record — every kind» — three long
     sentences in a row, which is a paragraph pretending to be a toolbar.
     David asked for «Layers [2]», and he is right: the sentence is what a
     reader needs ONCE, and the number is what they need every time after.

     So the sentence moves to `title` and `aria-label`, where it is a hover
     away and still the accessible name — a screen reader hears «what it
     costs to look, all 8 shown», not «costs, all». Nothing is lost; it
     stops shouting. */
  function setSummary(id, label, badge, full) {
    var el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = esc(label) + ' <b class="ra-badge">' + esc(badge) + "</b>";
    el.setAttribute("title", full);
    el.setAttribute("aria-label", full);
  }
  /* ONE SUMMARY FOR THREE STATES, and this time actually three.
     Merging the three controls into one «Filters» disclosure left the closed
     label still saying «Layers 2» — the name and the number of only the first
     of the three things now inside it. A reader narrowing by cost or by record
     kind then shut the panel and saw no sign they had done anything. The
     closed control has to answer «what is on the map», so it carries all
     three: «Filters  2 · All · All». */
  var sumBits = { layers: "", costs: "", kinds: "" };
  var sumFull = { layers: "", costs: "", kinds: "" };

  function oneSummary() {
    var el = document.getElementById("ra-laysum");
    if (!el) return;
    var full = [sumFull.layers, sumFull.costs, sumFull.kinds]
      .filter(Boolean).join(". ");
    /* «All» three times is the default and says nothing worth the width. Any
       other combination is a state the reader chose and has to be able to see
       without opening the panel. */
    var narrowed = [sumBits.layers, sumBits.costs, sumBits.kinds]
      .filter(function (b) { return b && b !== "All"; });
    el.innerHTML =
      '<svg class="ra-funnel" viewBox="0 0 16 16" aria-hidden="true" focusable="false">' +
      '<path d="M1.5 2.5h13l-5 6v5l-3 1.5v-6.5z" fill="none" ' +
      'stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>' +
      (narrowed.length
        ? '<b class="ra-badge">' + esc(narrowed.join(" \u00b7 ")) + "</b>"
        : "");
    el.setAttribute("title", full);
    el.setAttribute("aria-label", full);
  }

  function laySummary() {
    var n = LAYERS.filter(function (l) { return on[l[0]]; }).length;
    sumBits.layers = n === LAYERS.length ? "All" : String(n);
    sumFull.layers = n === LAYERS.length
      ? "Layers — all " + LAYERS.length + " on"
      : "Layers — " + n + " of " + LAYERS.length + " on";
    oneSummary();
  }
  /* HOW MANY PLACES ARE ACTUALLY BEHIND EACH OPTION.
     David: «i dont even see much for eg. costs, almost nothing for most
     categories? can you check as well.» He was right, and the numbers are
     worse than «not much»: of the eight access classes, `index`, `mixed`
     and `paid` are ZERO places, `free` is 3 and `catalogue` is 6, while
     `unsurveyed` is 19,416 — ninety per cent of the map. A filter offering
     eight choices where five do nothing is a filter that lies about what
     is there, which is the one thing this atlas is not allowed to do.
     Counted from the markers rather than asserted, so the numbers cannot
     drift, and recounted when the quiet half of the index lands. */
  function optionCounts() {
    var acc = {}, kind = {};
    markers.forEach(function (m) {
      var pl = m._p;
      var a = RANK[pl.a];
      if (a) acc[a] = (acc[a] || 0) + 1;
      var k = pl.k || 0;
      if (k) for (var name in KBIT) if (k & KBIT[name]) kind[name] = (kind[name] || 0) + 1;
    });
    return { acc: acc, kind: kind };
  }
  var COUNTS = { acc: {}, kind: {} };
  var nf = function (n) { return (n || 0).toLocaleString(); };

  /* ONE OPTION, ONE SHAPE, THREE MENUS. They were a checkbox in one, a
     coloured pill in another and a colourless pill in the third — three
     answers to the same question in three boxes a reader opens in a row.
     All of them are a checkbox now, because that is what a multi-select
     filter is, and the colour survives where colour is the meaning: on the
     access classes it is what the dots on the map are coloured by. */
  function optionHTML(kind, key, label, count, swatch, title, isOn, dead) {
    return '<label class="ra-opt' + (isOn ? " on" : "") + (dead ? " dead" : "") +
      '" data-' + kind + '="' + esc(key) + '" title="' + esc(title) + '">' +
      '<input type="checkbox"' + (isOn ? " checked" : "") +
      (dead ? " disabled" : "") + " />" +
      (swatch ? '<i class="ra-sw" style="background:' + swatch + '"></i>' : "") +
      "<span>" + esc(label) + "</span>" +
      '<b class="ra-n">' + (count == null ? "" : nf(count)) + "</b></label>";
  }

  function drawLayers() {
    laySummary();
    lbox.innerHTML = LAYERS.map(function (l) {
      return optionHTML("l", l[0], l[1], null, null,
                        l[1] + " — " + l[2], !!on[l[0]], false);
    }).join("");
  }
  drawLayers();
  function syncLayers() {
    LAYERS.forEach(function (l) {
      /* The shelf is the one layer this does not touch: below zoom 6 it is
         represented by the cluster bubbles instead, and drawClusters owns
         which of the two is on the map. */
      if (l[0] === "shelf") return;
      var has = map.hasLayer(l[3]);
      if (on[l[0]] && !has) l[3].addTo(map);
      if (!on[l[0]] && has) map.removeLayer(l[3]);
    });
    drawClusters(lastVisible);
    var live = LAYERS.filter(function (l) { return on[l[0]]; }).map(function (l) { return l[0]; });
    setQ("layers", live.join(","));
  }
  lbox.addEventListener("change", function (ev) {
    var lab = ev.target.closest(".ra-layer"); if (!lab) return;
    var k = lab.getAttribute("data-l");
    on[k] = ev.target.checked;
    lab.classList.toggle("on", !!on[k]);
    laySummary();
    syncLayers();
  });

  /* ---- the three dropdowns behave like dropdowns --------------------------
     <details> on its own stays open until it is clicked again, and three of
     them open at once in one bar is the mess this replaced. One at a time,
     and a click anywhere else closes the open one. */
  var drops = function () {
    return [].slice.call(document.querySelectorAll(".ra-drop"));
  };
  document.addEventListener("click", function (e) {
    var inside = e.target.closest && e.target.closest(".ra-drop");
    drops().forEach(function (d) {
      if (d !== inside && d.open) d.open = false;
    });
    if (!drops().some(function (d) { return d.open; }))
      document.querySelector(".ra-bar").classList.remove("ra-bar-raised");
  });
  /* Close on scroll. A popover anchored to a control has no business
     floating once that control has moved, and it also settles a question I
     could not answer by testing: the bar is lifted to z-index 1200 while
     open and the page header is sticky at 60, so a bar scrolling up past
     the header would paint over it. I could not get the page to scroll in
     the harness to prove that either way, and closing on scroll makes the
     question moot rather than leaving it open. */
  window.addEventListener("scroll", function () {
    if (!drops().some(function (d) { return d.open; })) return;
    drops().forEach(function (d) { d.open = false; });
    document.querySelector(".ra-bar").classList.remove("ra-bar-raised");
  }, { passive: true });
  drops().forEach(function (d) {
    d.addEventListener("toggle", function () {
      if (!d.open) {
        /* The last one closing puts the bar back below the header. */
        if (!drops().some(function (o) { return o.open; }))
          document.querySelector(".ra-bar").classList.remove("ra-bar-raised");
        return;
      }
      drops().forEach(function (o) { if (o !== d) o.open = false; });
      /* KEEP IT ON SCREEN, BY MEASURING RATHER THAN BY BREAKPOINT. These
         controls sit in a bar that WRAPS, so the same control is at the
         right-hand end at one width and the left-hand end at another, and
         no media query knows which. The first version flipped the last
         dropdown to right-aligned under 900px and duly pushed it 49 pixels
         off the LEFT edge, because at that width the bar had wrapped and
         the control was no longer on the right. Measured and nudged, it is
         correct at every width without knowing any of them. */
      document.querySelector(".ra-bar").classList.add("ra-bar-raised");
      var box = d.querySelector(".ra-drop-in");
      if (box) {
        box.style.left = "";
        var r = box.getBoundingClientRect(), pad = 10, shift = 0;
        if (r.right > window.innerWidth - pad) shift = (window.innerWidth - pad) - r.right;
        if (r.left + shift < pad) shift = pad - r.left;
        if (shift) box.style.left = Math.round(shift) + "px";
        /* AND THE SAME FOR THE BOTTOM EDGE, FOR THE SAME REASON. Merging
           the three filters into one control made this popover 1136px tall
           in a 900px viewport: the last third hung below the fold with no
           way to reach it, and the only test that caught it was the one
           that asks what is actually painted at a point. Measured, not
           guessed at with a breakpoint, because where the popover starts
           depends on whether the bar has wrapped. */
        box.style.maxHeight = "";
        box.style.overflowY = "";
        var room = window.innerHeight - box.getBoundingClientRect().top - pad;
        if (box.scrollHeight > room) {
          box.style.maxHeight = Math.max(160, Math.round(room)) + "px";
          box.style.overflowY = "auto";
          box.style.overscrollBehavior = "contain";
        }
      }
      /* The bar is fixed in full screen and its height is measured; a
         popover does not change that height, but the summary text does when
         it grows, so re-fit rather than assume. */
      if (typeof fitFsBar === "function") fitFsBar();
    });
  });

  /* ---- the access filter pills ------------------------------------------- */
  var off = {};
  (Q.get("off") || "").split(",").filter(Boolean).forEach(function (k) { off[k] = true; });
  function drawCats() {
  document.getElementById("ra-cats").innerHTML = RANK.map(function (a) {
    var n = COUNTS.acc[a] || 0;
    return optionHTML("cat", a, ACC[a][2] || ACC[a][1], n, ACC[a][0],
      ACC[a][1] + " — " + nf(n) + (n === 1 ? " place" : " places") +
      (n ? "" : " on this map, so this filter has nothing to remove"),
      !off[a], n === 0);
  }).join("") +
    /* The one thing on this map that the colours alone cannot say. */
    '<span class="at-cat at-hollow-key" title="A hollow dot means no volumes are ' +
    'recorded at that place. Any colour it has is borrowed from a collection ' +
    'catalogued under it, or under the district it sits in.">' +
    "<i></i>Hollow&nbsp;= unwalked</span>" +
    '<span class="at-cat at-hollow-key at-natl-key" title="Nothing in this atlas ' +
    'reaches that place, but its country has a named national archive or ' +
    'library — click the place and the panel lists it.">' +
    "<i></i>Dotted&nbsp;= country has an archive</span>";
  }
  COUNTS = optionCounts();
  drawCats();
  function catSummary() {
    var n = RANK.filter(function (a) { return !off[a]; }).length;
    var catFull = n === RANK.length
      ? "What it costs to look — all " + RANK.length + " shown"
      : "What it costs to look — " + n + " of " + RANK.length + " shown";
    setSummary("ra-catsum", "Costs", n === RANK.length ? "All" : String(n), catFull);
    sumBits.costs = n === RANK.length ? "All" : String(n);
    sumFull.costs = catFull;
