---
/* The map. Three layers, a year, and a panel that fetches.

   Descended from the Atlas in the family archives, and different from it in
   three ways that matter.

   ONE — THE COLOUR ANSWERS A STRANGER'S QUESTION. The archive it came from
   coloured a parish by how far one researcher had got with it, which is a true
   and useful thing to know if you are that researcher and meaningless if you
   are not. Here the colour says what you can actually OPEN: free images,
   images behind a login, an index, a paywall, a catalogue card, or paper in a
   building. A place takes the colour of the MOST OPEN thing it has, because
   the question is "can I see anything tonight", and the panel tells the rest.

   TWO — THE YEAR IS A FILTER, NOT A DECORATION. Set it to 1863 and the map
   does not merely shade the borders of 1863: it drops every place that cannot
   answer for that year, and every panel gains the line that is the whole
   reason this site exists — which empire's filing system this ground fell
   under, and therefore whose archive to write to.

   THREE — THE PANEL FETCHES. The index carries only what a marker needs to be
   drawn and found. Everything else arrives per place, on click, from
   p/<id>.json. 1,239 places is 145 KB rather than 2.5 MB, and the number that
   grows with the world is the one that compresses.

   Everything else — the find box, the filter pills, that every view is a link
   — is the family Atlas's and is kept deliberately, because a reader who knows
   one of these maps should know all of them. */
const { indexUrl, detailBase, regionsUrl, providersUrl, gazBase, surnameBase, belgiumBase, wikidataUrl, osmUrl, featureBase, settlementBase, districtBase, countryBase, townlandBase, comuneBase, estoniaBase, scotlandBase, worldArchivesUrl, countryPointsUrl, base } = Astro.props;
---

{/* ONE BAR, NOT THREE PANELS. The search box, seven layer switches, the year
    control and the copy button used to stack to roughly eight hundred pixels
    of apparatus above a map — a visitor holding a surname had to scroll past
    the entire instrument to reach the map it drives.
    Everything is still here and nothing is hidden: the counts and the
    explanations moved into `title`, which is a tooltip on a desktop and a long
    press on a phone, and the ⓘ button opens the lot as plain text for anyone
    who cannot hover. A control that explains itself on demand is not the same
    as a control that explains itself at you. */}
<div class="ra-bar">
  <input id="ra-q" type="search" autocomplete="off"
         aria-label="Find a place or a surname, by any name it has ever had"
         placeholder="Find a place or a surname — Gallignana · Žubrinić · Lerena" />
  <div class="ra-layers" id="ra-layers"></div>
  {/* A RANGE, NOT A YEAR. «What covers 1880 to 1920» is the question a
      researcher actually has; «what covers exactly 1904» is a question nobody
      asks. A single handle also made the map look broken whenever it landed on
      a recent year, because privacy windows close births for a century.
      Two overlaid sliders, because the web has no two-handled range input and
      a pair of them is honest about what it is. */}
  <label class="ra-ylab" id="ra-ylab"
         title="Keep only the places that can answer for any year in this range — and every panel will say whose archive those years belonged to.">
    <input type="checkbox" id="ra-yon" />
    <span class="ra-slider">
      <span class="ra-track" id="ra-track"></span>
      <input type="range" id="ra-year" min="1500" max="2026" value="1780" step="1" disabled
             aria-label="Earliest year" />
      <input type="range" id="ra-year2" min="1500" max="2026" value="1920" step="1" disabled
             aria-label="Latest year" />
    </span>
    <output id="ra-yout" class="mono">any year</output>
  </label>
  {/* PLAY IT, BECAUSE THE ARGUMENT IS A CHANGE OVER TIME.
      This atlas exists to say that ground changed hands and the paper
      followed it — that an 1863 baptism from a Croatian village is in a
      Croatian archive and a 1930 one from the same village is filed under
      Italy. That is a sentence on the about page and a slider somebody
      has to think to drag. Run it and it is the map telling you: Venice
      gives way to Austria gives way to Italy gives way to Yugoslavia over
      one piece of Istria, while the dots thin to the books that can
      answer for the decade on screen.
      A window, not a point: it walks a fifty-year range forward a decade
      at a time, because records come in runs and a single year empties
      the map. */}
  <button class="ra-ico" id="ra-play" type="button" aria-pressed="false"
          title="Play the years — watch the jurisdictions change and the records follow">&#9654;</button>
  <button class="ra-ico" id="ra-info" type="button" aria-expanded="false"
          title="What these controls mean">&#9432;</button>
  <button class="ra-ico" id="ra-copy" type="button" title="Copy a link to this exact view">&#128279;</button>
  <button class="ra-ico" id="ra-full" type="button"
          title="Full screen — the map and its panel fill the window">&#9974;</button>
  <button class="ra-ico" id="ra-reset" type="button"
          title="Start again — clear the search, the year, the filters and the layers, and go back to the whole world">&#10226;</button>
  <span class="ra-copied" id="ra-copied" hidden>copied</span>
</div>
<div class="ra-help" id="ra-help" hidden></div>

<div class="at-wrap">
  {/* A CANVAS OF CIRCLES IS NOT REACHABLE BY KEYBOARD, and pretending
      otherwise helps nobody. Leaflet with preferCanvas draws 21,302 dots
      into one element: there are no focusable markers to tab through and
      making them focusable would mean 21,302 tab stops, which is worse
      than none. So the map is labelled for what it is, and the reader is
      told where the same answers live in text — the search box reaches
      every place by any name it has ever had, and /places/ lists them
      all with a page each. That is an honest fallback rather than an
      ARIA costume over an unusable control. */}
  <div class="at-map" id="ra-map" role="application"
       aria-label="Map of places and archives. Not keyboard-navigable: use
                   the search box above, which finds any place by any name
                   it has ever had, or the full list of places linked below.">
    {/* THE MAP WAS A GREY BOX FOR AS LONG AS THE FETCHES TOOK, and a grey
        box is indistinguishable from a broken one. This says what is
        coming and how much of it, is server-rendered so it is on screen
        in the first paint, and is removed the moment the markers are
        drawn. It is not a spinner: a number tells the reader the wait is
        proportionate to something. */}
    <div class="ra-loading" id="ra-loading">
      <span class="ra-loading-b"></span>
      <span id="ra-loading-t" data-i18n>Loading the atlas&hellip;</span>
    </div>
  </div>
  {/* THE PANEL REWRITES ITSELF AND SAID NOTHING WHILE DOING IT.
      Every answer on this map arrives by replacing this element's
      innerHTML — a place, a surname, a country, a region. A sighted
      reader sees the change; a screen reader was told nothing at all,
      because nothing announced it. aria-live="polite" reads the new
      panel after the current utterance instead of interrupting, which is
      right for a result that follows a search the reader just typed.
      The count below is its own region for the same reason: «0 of 21302
      places shown» is the answer to a filter, and it was silent. */}
  <aside class="at-panel" role="region" aria-live="polite"
         aria-label="What the map found">
    {/* «PICK A PLACE» ASKED THE READER TO ALREADY KNOW THE ANSWER.
        Most people arrive holding a surname, a half-remembered village, or
        nothing but a country — and the first thing this said was «click
        any marker», which assumes they know which. Three ways in, in the
        order people actually have them, and the legend's one idea stated
        in a sentence instead of hidden in a filter: the colour is what it
        costs to look. */}
    {/* ON A PHONE THE ANSWER ARRIVED BELOW THE FOLD. The panel stacks
        under the map at 900px, so tapping a dot filled a box the reader
        could not see and gave no sign anything had happened — they tapped
        again, and again. Under 700px a result becomes a sheet over the
        bottom of the map, which is where every phone map on earth puts
        one. It needs a way back out that is not a scroll, hence this.
        It is driven off :has() on the body's hidden attribute, so there
        is no state to keep in sync; a browser without :has() simply keeps
        the stacked panel it has today. */}
    <button class="ra-sheet-x" id="ra-sheet-x" type="button">
      &#9662;&nbsp;<span data-i18n>Back to the map</span></button>
    <div class="at-empty" id="ra-empty">
      <div class="lab">Start with what you have</div>
      <ul class="at-start">
        <li><b>A surname.</b> Type it above — <a href="#" class="ra-try" data-q="Peeters">Peeters</a>,
          <a href="#" class="ra-try" data-q="Blažević">Blažević</a> — and the map lights the
          countries a register or an archive attests it in.</li>
        <li><b>A village, by any name it ever had.</b>
          <a href="#" class="ra-try" data-q="Gallignana">Gallignana</a> finds Gračišće;
          <a href="#" class="ra-try" data-q="Breslau">Breslau</a> finds Wrocław.</li>
        <li><b>Only a country.</b> Click anywhere on it — every country on earth answers with
          something, even where this atlas has nothing yet.</li>
      </ul>
      <p><b>The colour of a dot is what it costs to look</b> — free images, behind a login,
      an index with no images, a catalogue card for paper nobody has photographed. That is
      the thing most directories flatten into a link.</p>
      <p class="at-hint" id="ra-hint"></p>
    </div>
    <div class="at-body" id="ra-body" hidden></div>
  </aside>
</div>

<div class="ra-foot">
  {/* EIGHT PILLS FOR SOMETHING RARELY CHANGED. The colours still have to be
      legible — they are what the map means — but the SWITCHES behind them are
      a filter most readers set once or never, and a row of eight was more
      chrome than that deserves. Folded into a disclosure that says how many
      are on. */}
  {/* EIGHT COLOURS AND NO RULE FOR READING THEM. The swatches named
      themselves — "an index only", "behind a paywall" — and left the two
      facts that make the legend usable unsaid: that they run from what you
      can open tonight down to what needs a letter, and that a place takes
      the colour of the MOST OPEN thing it has, so a red dot means red is
      the best on offer there and a green one says nothing about what else
      is underneath. That a swatch is also a filter was undiscoverable. */}
  <details class="ra-cats-wrap" id="ra-catsw">
    <summary id="ra-catsum">What it costs to look</summary>
    <p class="ra-key-lead">Ordered from what you can open tonight down to what
      needs a letter. <b>A place takes the colour of the most open thing it
      has</b> — so red means red is the best on offer there, and green says
      nothing about what else is underneath it. The panel lists the rest.
      Click a colour to take it off the map.</p>
    <div class="atlas-key" id="ra-cats"></div>
  </details>
  {/* WHAT KIND OF RECORD. David asked for this directly — "many people
      really want to look at church records, do we know which are which and
      could we apply a church record filter". Until now nothing in this
      project knew which were which; the kind is read out of each
      collection's title by one shared classifier and carried on the index as
      a bitmask, so the filter works on first paint without fetching
      anything. Unset means every kind, including the sixth of collections
      whose title says nothing about what they are — a filter that quietly
      dropped those would be lying about coverage. */}
  <details class="ra-cats-wrap" id="ra-kindw">
    <summary id="ra-kindsum">What kind of record</summary>
    <div class="atlas-key" id="ra-kinds"></div>
  </details>
  <span class="cap" id="ra-count" role="status" aria-live="polite"></span>
</div>

{/* The map cannot draw without these three, and the browser cannot know
    that from markup it never sees — they are fetched by script. A preload
    lets it start them at the same time as the stylesheets instead of
    after them, and a preconnect opens the CDN socket while the parser is
    still working. Measured cost of not doing it: index.json was not even
    requested until 4,821 ms. */}
<link rel="preload" as="fetch" href={indexUrl} crossorigin />
<link rel="preload" as="fetch" href={regionsUrl} crossorigin />
<link rel="preload" as="fetch" href={providersUrl} crossorigin />
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>

<script is:inline define:vars={{ INDEX: indexUrl, DETAIL: detailBase, REGIONS: regionsUrl, PROVIDERS: providersUrl, GAZ: gazBase, SURN: surnameBase, BSURN: belgiumBase, WDA: wikidataUrl, OSMA: osmUrl, FEAT: featureBase, SETT: settlementBase, DIST: districtBase, CTRY: countryBase, TOWN: townlandBase, COMU: comuneBase, ESTO: estoniaBase, SCOT: scotlandBase, WARCH: worldArchivesUrl, CPTS: countryPointsUrl, BASE: base }}>
/* ASK FOR THE DATA NOW, NOT AFTER EVERYTHING ELSE HAS LOADED.
   Measured on the live site rather than reasoned about, which is what
   should have happened the first time:

     first contentful paint   4,500 ms
     index.json REQUESTED     4,821 ms
     index.json arrived       5,696 ms   (422 KB)

   The map has always been built inside window.load, which fires only
   after every image, font, stylesheet and CDN script on the page has
   finished. So the one fetch the map cannot start without sat waiting
   nearly five seconds for things it does not need, and then took 875 ms.
   Splitting index.json from 533 KB to 419 KB — a careful, well-argued
   change — saved about 100 KB on a request that had not been made yet.
   That is what comes of budgeting bytes and never timing anything.

   The request starts here, while the parser is still working and while
   Leaflet is still downloading. `load` then waits on a promise that is
   usually already settled. Nothing else changes: the map still needs
   Leaflet, and still builds when the page is ready. */
var DATA = Promise.all([fetch(INDEX), fetch(REGIONS), fetch(PROVIDERS)])
  .then(function (r) { return Promise.all(r.map(function (x) { return x.json(); })); })
  .catch(function () { return null; });

window.addEventListener("load", async function () {
  var el = document.getElementById("ra-map");
  if (!el || typeof L === "undefined") return;

  var idx, regions, provs;
  var got = await DATA;
  if (!got) { el.innerHTML = '<p class="ra-dead">The map data could not be loaded.</p>'; return; }
  idx = got[0]; regions = got[1]; provs = got[2];

  var PROV = {}; provs.providers.forEach(function (p) { PROV[p.id] = p; });
  /* National archives and libraries by country, fetched once and kept for the
     whole session — 40 KB that turns «no sources here» into a list in 164
     countries. */
  var warch = {};
  var warchReady = fetch(WARCH).then(function (r) { return r.json(); })
              .then(function (d) { warch = d.byCountry || {}; return warch; })
              .catch(function () { return {}; });
  var CNAME = idx.countries || {};
  var XL = { "đ": "d", "ł": "l", "ø": "o", "ß": "ss", "æ": "ae", "œ": "oe" };
  function fold(s) {
    return (s || "").toLowerCase().replace(/[đłøßæœ]/g, function (c) { return XL[c]; })
      .normalize("NFKD").replace(/[̀-ͯ]/g, "");
  }
  /* index.json already carries the country names the rest of the site uses,
     so a badge reads "Italy" and not "IT". */
  var ccName = function (cc) { return (idx.countries || {})[cc] || cc; };
  var esc = function (x) { return String(x == null ? "" : x)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); };

  /* ---- access, which is what the colour means ---------------------------
     Read off the stylesheet so the two themes stay in one place. */
  var css = getComputedStyle(document.documentElement);
  /* Base.astro defines these before anything in this component runs. The
     fallback is for the component being used outside that layout, where
     the honest answer is the English it was given. */
  var T = window.RA_T || function (x) { return x; };

  var ACC = {
    free:      ["#1E8449", T("Images, free, no account")],
    account:   ["#6FA82E", T("Images, free, account needed")],
    index:     ["#EFC03B", T("An index only — no images")],
    mixed:     ["#E8792B", T("Partly free, partly paid")],
    paid:      ["#C0392B", T("Images, behind a paywall")],
    catalogue: ["#8E6FA8", T("A catalogue entry — not photographed")],
    onsite:    ["#7C8A91", T("On paper, in the building")],
    unsurveyed:["#B6B2A6", T("Nobody has walked this one yet")]
  };
  var RANK = idx.rank || Object.keys(ACC);

  /* ---- URL as state ------------------------------------------------------
     Every view of this map is a link: the layers, the basemap, the year, what
     is typed in the find box, which filters are off, and where the map is
     looking. A view can be sent to somebody rather than only remembered. */
  var Q; try { Q = new URLSearchParams(location.search); } catch (e) { Q = new URLSearchParams(); }
  var writing = false;
  /* A HIDDEN TAB RUNS NO FRAMES, AND THE WRITE WAS WAITING FOR ONE.
     Coalescing on requestAnimationFrame alone means that if somebody
     switches tab, changes the year or the basemap, and comes back, the
     address bar still describes the map they left — the write is queued
     behind a frame that will not arrive until the page is looked at again.
     Every share and every reload in between carries the wrong view.
     I saw this myself while testing the record-kind filter and wrote it off
     as an artefact of an automation pane being hidden; it took the archive
     kit hitting it in the same condition to show it was the bug, not the
     test. A timer runs in a hidden tab, so whichever fires first does the
     write and the flag keeps it to once. */
  function push() {
    if (writing) return;
    writing = true;
    var go = function () {
      if (!writing) return;
      writing = false;
      var s = Q.toString();
      history.replaceState(null, "", location.pathname + (s ? "?" + s : "") + location.hash);
    };
    requestAnimationFrame(go);
    setTimeout(go, 250);
  }
  function setQ(k, v) { if (v === "" || v == null) Q.delete(k); else Q.set(k, v); push(); }

  /* CANVAS, NOT SVG, BECAUSE THERE ARE TWENTY-ONE THOUSAND DOTS.
     Leaflet's default renderer makes one DOM element per vector marker.
     Measured on the live site: 21,322 <path> elements, 21,645 DOM nodes in
     the whole document, and a 268 MB JavaScript heap — so every pan and
     every zoom asked the browser to lay out twenty-one thousand nodes, and
     David reported the map as very slow.
     preferCanvas draws them all into one canvas instead. circleMarker
     supports it fully: clicks, tooltips, dashArray and per-marker styling
     all behave the same, because this map styles through Leaflet options
     rather than CSS on the paths.
     The dot count is not the problem to solve — the places are real and
     the map is meant to show them. The renderer was. */
  var map = L.map(el, { scrollWheelZoom: true, worldCopyJump: true,
                        preferCanvas: true });
  var BASES = {
    map: L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      { attribution: "&copy; OpenStreetMap contributors", maxZoom: 18 }),
    terrain: L.tileLayer("https://tile.opentopomap.org/{z}/{x}/{y}.png",
      { attribution: "&copy; OpenStreetMap contributors, SRTM · OpenTopoMap (CC-BY-SA)", maxZoom: 17 }),
    satellite: L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      { attribution: "Esri, Maxar, Earthstar Geographics", maxZoom: 18 })
  };
  var baseNow = Q.get("base") && BASES[Q.get("base")] ? Q.get("base") : "map";
  BASES[baseNow].addTo(map);

  /* ---- the jurisdiction layer -------------------------------------------
     Regions are shaded by whichever regime held them in the chosen year. With
     no year chosen there is nothing honest to shade, so the layer draws its
     outlines only and says so. */
  var regionLayer = L.layerGroup();
  var regionShapes = regions.regions.map(function (reg) {
    var poly = L.polygon(reg.ring, { color: "#7C8A91", weight: 1.2, opacity: .65,
                                     fillColor: "#7C8A91", fillOpacity: .07 });
    poly.bindTooltip(reg.label, { sticky: true });
    poly.addTo(regionLayer);
    return { reg: reg, poly: poly };
  });
  function eraAt(reg, y) {
    for (var i = 0; i < reg.eras.length; i++) {
      var e = reg.eras[i];
      if (y >= e.from && y <= e.to) return e;
    }
    return null;
  }
  /* EVERY ERA THE RANGE TOUCHES. 1880–1920 over Istria is Austria AND Italy,
     and naming only one of them would hide the handover — which is the single
     most useful thing this map has to say about that ground. */
  function erasIn(reg, a, b) {
    return reg.eras.filter(function (e) { return e.from <= b && e.to >= a; });
  }
  function paintRegions() {
    regionShapes.forEach(function (rs) {
      /* The shading takes the era the range OPENS in — a band cannot be two
         colours, and the first is the one a researcher starts from. The panel
         names all of them. */
      var e = year && eraAt(rs.reg, year);
      var c = e ? (css.getPropertyValue(regions.regimes[e.regime].var).trim() || "#7C8A91") : "#7C8A91";
      rs.poly.setStyle({ color: c, fillColor: c, fillOpacity: e ? .20 : .07, weight: e ? 1.8 : 1.2 });
      rs.poly.setTooltipContent(e
        ? "<b>" + esc(rs.reg.label) + "</b><br>" + esc(e.polity) + " in " + year
        : esc(rs.reg.label));
    });
  }
  var REGION = {}; regions.regions.forEach(function (r) { REGION[r.id] = r; });
  /* Folded name -> place id, so a civil parish or a province named in a search
     result can be turned into a link to the page this map already has for it. */
  var byName = {};
  idx.places.forEach(function (p) {
    var k = fold(p.n);
    if (!(k in byName)) byName[k] = p.i;
  });
  var REGIONS_N = regions.regions.length;
  /* THE SPLIT MUST NOT CHANGE WHAT THE MAP CLAIMS TO HOLD. index.json now
     stops at the places that have something to show, so every count taken
     from idx.places.length would have quietly shed the 4,932 quiet dots —
     the same class of mistake as the header that said 8,557 volumes. */
  var TOTAL_PLACES = idx.places.length + ((idx.quiet && idx.quiet.places) || 0);
  var loadT = document.getElementById("ra-loading-t");
  /* «Drawing 21,473 places…» has an English verb in it, so a translated
     page says the number and the noun rather than a half-translated
     sentence. */
  if (loadT) loadT.textContent =
    (window.RA_LANG && window.RA_LANG !== "en"
      ? TOTAL_PLACES.toLocaleString() + " " + T("places") + "\u2026"
      : "Drawing " + TOTAL_PLACES.toLocaleString() + " places\u2026");

  /* ---- the markers -------------------------------------------------------
     Radius by how many volumes stand at a place, which is the one piece of
     editorial here and worth saying out loud: weight on this map is not
     importance. A parish with ninety volumes nobody has read and a parish with
     two are both on it, and the big one is not the better lead. */
  var shelfLayer = L.layerGroup();
  function makeMarker(p) {
    /* WALKED MEANS A BOOK STANDS HERE, by whatever route it was found.
       This read the collection count alone, so a place carrying 1,500
       FamilySearch volumes and no curated collection was drawn hollow —
       the mark that says nobody has been through it. */
    var n = (p.v || 0) || (p.c || 0);
    /* HOLLOW MEANS NOBODY WALKED IT. 2,199 of the 4,106 dots carry no volume of
       their own — mostly the administrative divisions, which are real ground,
       correctly placed, and completely unread. 319 of them still have a colour,
       borrowed (`b`) from a collection catalogued under the place or the
       district it sits in; the rest are grey. Either way, drawing them like a
       parish somebody went through would be the map claiming 2,199 walks that
       never happened. So: the colour on the rim, the middle left empty, which
       reads at a glance as «there is something here, and nobody has been
       through it». */
    /* `a` is an INDEX into RANK now, not the word itself — 116 KB of the index
       was eight strings written out 7,391 times. */
    var col = (ACC[RANK[p.a]] || ["#7C8A91"])[0];
    /* A DOTTED RIM MEANS «NOTHING HERE, BUT THIS COUNTRY HAS AN ARCHIVE». Grey
       hollow dots across the whole of Africa read as «there is nothing», and
       what they actually mean is «nothing has reached here YET» — while 32
       African countries have a named national archive sitting in the panel.
       The marker could not say that and now does. */
    var m = L.circleMarker([p.y, p.x], !n ? {
      radius: Math.min(3.5 + Math.sqrt(p.b || 1) * 0.5, 8),
      color: p.w && !p.b ? "#7C8A91" : col, weight: 1.4, opacity: .85,
      dashArray: p.w && !p.b ? "2 2" : null,
      fillColor: col, fillOpacity: .12
    } : {
      radius: Math.min(3 + Math.sqrt(n) * 0.9, 13),
      color: "#fff", weight: 0.8, opacity: .9,
      fillColor: col, fillOpacity: .85
    });
    m._p = p;
    m.bindTooltip(p.n, { sticky: true });
    m.on("click", function () { open(p); });
    return m;
  }
  var markers = idx.places.map(makeMarker);

  /* ---- the archives -------------------------------------------------------
     Where the paper physically is. Drawn as a hollow square rather than a
     filled dot because an institution is not a place on the shelf: one archive
     in Zadar holds the registers of two hundred Dalmatian parishes, and
     conflating the two would say there are two hundred archives.

     This layer is also the only one that is genuinely worldwide today, and it
     is what stops the map claiming to cover the earth while showing Croatia. */
  var archiveLayer = L.layerGroup();
  var archives = provs.providers.filter(function (p) { return p.at; });
  var archMarkers = archives.map(function (p) {
    var m = L.marker([p.at.lat, p.at.lon], {
      icon: L.divIcon({ className: "ra-arch", iconSize: [13, 13],
                        html: '<i style="border-color:' + (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' })
    });
    m.bindTooltip(p.name, { sticky: true });
    m.on("click", function () { openArchive(p); });
    m.addTo(archiveLayer);
    /* Searchable by its name, its city, and every country it covers — so
       "Ireland" finds the Dublin archives AND the aggregators that reach
       Ireland from somewhere else entirely. */
    m._q = fold([p.name, p.at.place,
                 (p.countries || []).map(function (c) { return CNAME[c] || c; }).join(" ")
                ].join(" "));
    m._p = p;
    return m;
  });

  /* WIKIDATA'S ARCHIVES — everything it knows the location of, and nobody
     here has opened one. Drawn as a small hollow ring rather than the filled
     diamond a checked provider gets, because the difference between «we have
     read this and it is free» and «Wikidata says there is an archive here» is
     the whole editorial value of the other 178. */
  var wikiLayer = L.layerGroup(), nsite = 0;
  var wikiMarkers = [];
  (async function () {
    var wd;
    try { wd = await (await fetch(WDA)).json(); } catch (e) { return; }
    wd.archives.forEach(function (a) {
      var m = L.circleMarker([a.y, a.x], {
        renderer: featCanvas,
        radius: 3.4, color: "#8E6FA8", weight: 1.2, opacity: .75,
        fillColor: "#8E6FA8", fillOpacity: .18
      });
      m.bindTooltip(a.n, { sticky: true });
      m.on("click", function () {
        empty.hidden = true; panel.hidden = false;
        var h = ['<div class="at-h"><h3>' + esc(a.n) + "</h3></div>"];
        h.push('<p class="at-also">' + esc(CNAME[a.cc] || a.cc || "") + "</p>");
        h.push('<div class="ra-juris ra-unmapped"><div class="lab">From Wikidata, unchecked' +
               "</div><p>Wikidata records an archive here. <b>Nobody on this project has " +
               "opened it</b>, and it may hold nothing genealogical — corporate, film and " +
               "museum archives are archives too. The " + provs.providers.length +
               " institutions drawn as diamonds have been looked at; this has not.</p></div>");
        if (a.sites && a.sites.length)
          h.push('<p class="at-go"><a href="' + esc(a.sites[0]) +
                 '" target="_blank" rel="noopener">' + esc(a.sites[0]) + " &#8599;</a></p>");
        h.push('<p class="at-sub"><a href="https://www.wikidata.org/wiki/' + esc(a.q) +
               '" target="_blank" rel="noopener">' + esc(a.q) + " on Wikidata &#8599;</a></p>");
        panel.innerHTML = h.join("");
      });
      m.addTo(wikiLayer);
      wikiMarkers.push(m);
    });
    var n = wd.archives.length;
    nsite = wd.archives.filter(function (a) {
      return a.sites && a.sites.length;
    }).length;
    /* OpenStreetMap's archives share this layer and this caveat. They are a
       separate FILE because ODbL is share-alike and everything else here is
       CC0 — but to a reader they are the same kind of claim: somebody mapped
       an archive here and nobody on this project has opened it. */
    try {
      var om = await (await fetch(OSMA)).json();
      om.archives.forEach(function (a) {
        var m = L.circleMarker([a.y, a.x], {
          renderer: featCanvas,
          radius: 3.4, color: "#4E7A55", weight: 1.2, opacity: .75,
          fillColor: "#4E7A55", fillOpacity: .18
        });
        m.bindTooltip(a.n, { sticky: true });
        m.on("click", function () {
          empty.hidden = true; panel.hidden = false;
          var h = ['<div class="at-h"><h3>' + esc(a.n) + "</h3></div>"];
          if (a.by) h.push('<p class="at-also">' + esc(a.by) + "</p>");
          h.push('<div class="ra-juris ra-unmapped"><div class="lab">From OpenStreetMap, ' +
                 "unchecked</div><p>Somebody mapped an archive at this spot. Nobody here " +
                 "has opened it. &copy; OpenStreetMap contributors, ODbL.</p></div>");
          if (a.site) h.push('<p class="at-go"><a href="' + esc(a.site) +
                             '" target="_blank" rel="noopener">' + esc(a.site) + " &#8599;</a></p>");
          panel.innerHTML = h.join("");
        });
        m.addTo(wikiLayer);
      });
      n += om.archives.length;
    } catch (e) {}
    /* SAY HOW MANY CAN BE OPENED, because most of them now can.
       This layer drew 4,929 archives with no website at all — a dot a
       reader could see and not follow — and the label said «unchecked»,
       which was true and buried the useful half. The harvest now carries
       5,276 addresses, so the label counts them: a layer worth turning on
       is a layer that says what turning it on gets you. */
    var lab = document.querySelector('.ra-layer[data-l="wikidata"]');
    if (lab) lab.title = "Others — " + n.toLocaleString() +
      " mapped by others, " + nsite.toLocaleString() +
      " with a website · unchecked, and not all genealogical";
    if (on.wikidata) wikiLayer.addTo(map);
  })();

  /* THE GROUND ITSELF — cemeteries, churches, libraries, inside the record
     regions only. Wikidata knows 295,702 cemeteries and 273,894 churches
     worldwide; drawing them all would be a map of Wikidata rather than of
     where records are, and would bury 2,130 walked places under half a
     million dots. The regions are the ground this project has worked out. */
  /* ONE CANVAS, NOT 46,909 DOM NODES. The church layer drew a separate SVG
     path per parish and put every one of them in the document whether it was
     on screen or not, which is a browser brought to its knees by a layer
     nobody asked to be slow. Leaflet will rasterise a layer to a single canvas
     instead, and for tens of thousands of small circles that is the difference
     between a map and a slideshow. */
  var featCanvas = L.canvas({ padding: 0.3 });
  var FEATS = [
    ["cemeteries", "Cemeteries", "#6C5CE0", 2.8],
    ["churches",   "Churches and parishes", "#B07CD9", 2.6],
    ["libraries",  "Libraries", "#2E86C1", 3.0]
  ];
  var featLayers = {};
  FEATS.forEach(function (F) {
    var key = F[0], layer = L.layerGroup();
    featLayers[key] = layer;
    (async function () {
      /* Two sources per layer, and neither is checked: Wikidata's CC0 set and
         OpenStreetMap's ODbL one, which live in separate files because
         share-alike must not leak into the rest but are the same claim to a
         reader — somebody mapped this and nobody here has been. */
      var d = { features: [], srcs: [] };
      for (var si = 0; si < 2; si++) {
        var which = ["wikidata", "osm"][si];
        try {
          /* Checked, because not every layer has both halves — churches and
             libraries are Wikidata-only — and an unchecked fetch logged two
             404s on every page load that looked like a fault and were not. */
          var res = await fetch(FEAT + key + "-" + which + ".json");
          if (!res.ok) continue;
          var part = await res.json();
          if (part.features && part.features.length) {
            d.features = d.features.concat(part.features);
            d.srcs.push(which === "osm" ? "OpenStreetMap" : "Wikidata");
          }
        } catch (e) {}
      }
      if (!d.srcs.length) d.srcs = ["Wikidata"];
      d.features.forEach(function (f) {
        var m = L.circleMarker([f.y, f.x], {
          renderer: featCanvas,
          radius: F[3], color: F[2], weight: 1, opacity: .7,
          fillColor: F[2], fillOpacity: .35
        });
        m.bindTooltip(f.n, { sticky: true });
        m.on("click", function () {
          empty.hidden = true; panel.hidden = false;
          panel.innerHTML =
            '<div class="at-h"><h3>' + esc(f.n) + "</h3></div>" +
            '<p class="at-also">' + esc(F[1]) + "</p>" +
            '<div class="ra-juris ra-unmapped"><div class="lab">From Wikidata, unchecked' +
            "</div><p>Wikidata records this here, inside the <b>" + esc(f.r) +
            "</b> record region. Nobody on this project has been. It is drawn because the " +
            "ground a family stood on is part of where its records are.</p></div>" +
            '<p class="at-sub"><a href="https://www.wikidata.org/wiki/' + esc(f.q) +
            '" target="_blank" rel="noopener">' + esc(f.q) + " on Wikidata &#8599;</a></p>";
        });
        m.addTo(layer);
      });
      /* NAME BOTH SOURCES. The cemetery layer merges 11,698 CC0 rows from
         Wikidata with 5,443 ODbL ones from OpenStreetMap, and a label saying
         only «from Wikidata» is both wrong and, for the ODbL half, an
         attribution this project owes. */
      var lab = document.querySelector('.ra-layer[data-l="' + key + '"]');
      if (lab) lab.title = (lab.querySelector("b") || {}).textContent + " — " +
        d.features.length.toLocaleString() + " in the record regions · " +
        d.srcs.join(" and ") + ", unchecked";
      if (on[key]) layer.addTo(map);
    })();
  });

  /* Which record regions name this archive as the holder of their records, and
     for how many eras. An archive that four regions cite for twenty eras is a
     different proposition from one nobody has connected to any ground yet. */
  function citedBy(id) {
    var out = [];
    regions.regions.forEach(function (r) {
      var n = r.eras.filter(function (e) { return e.filedUnder.indexOf(id) > -1; }).length;
      if (n) out.push({ label: r.label, n: n });
    });
    return out;
  }

  function openArchive(p) {
    empty.hidden = true; panel.hidden = false;
    setQ("at", "");
    var h = [];
    h.push('<div class="at-h"><h3>' + esc(p.name) + "</h3></div>");
    h.push('<p class="at-also">' + esc(p.at.place) + "</p>");
    h.push('<p class="at-what">' + esc(p.what) + "</p>");
    h.push('<p class="ra-acc"><i class="ra-dot" style="background:' +
           (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' +
           esc((ACC[p.access] || [0, p.access])[1]) + "</p>");
    var cite = citedBy(p.id);
    if (cite.length) {
      h.push('<div class="at-sec"><div class="lab">Holds the records of</div><ul class="at-films">');
      cite.forEach(function (c) {
        h.push("<li>" + esc(c.label) + ' <span class="at-y">' + c.n +
               " era" + (c.n === 1 ? "" : "s") + "</span></li>");
      });
      h.push("</ul></div>");
    }
    h.push('<p class="at-go"><a href="' + BASE + "archive/" + esc(p.id) + '/">' +
           "Everything about " + esc(p.name) + " &rarr;</a> · " +
           '<a href="' + esc(p.url) + '" target="_blank" rel="noopener">the site &#8599;</a></p>');
    h.push('<p class="at-sub">Last checked ' + esc(p.checked) + ".</p>");
    panel.innerHTML = h.join("");
  }

  /* ---- the panel, fetched per place --------------------------------------
     The index cannot carry this and should not try. */
  var panel = document.getElementById("ra-body"), empty = document.getElementById("ra-empty");
  var cache = {};
  async function open(p) {
    empty.hidden = true; panel.hidden = false;
    panel.innerHTML = '<p class="at-sub">Fetching ' + esc(p.n) + "…</p>";
    var d = cache[p.i];
    if (!d) {
      try { d = cache[p.i] = await (await fetch(DETAIL + p.i + ".json")).json(); }
      catch (e) { panel.innerHTML = '<p class="at-sub">Could not load this place.</p>'; return; }
    }
    setQ("at", p.i);
    panel.innerHTML = render(d);
  }

  function render(d) {
    var h = [];
    h.push('<div class="at-h"><h3>' + esc(d.name) + "</h3>");
    if (d.collections.length)
      h.push('<span class="at-n">' + d.collections.length + " volume" +
             (d.collections.length === 1 ? "" : "s") + "</span>");
    h.push("</div>");

    var alsoNames = (d.names || []).map(function (n) { return n.n; });
    if (alsoNames.length)
      h.push('<p class="at-also">also written ' + alsoNames.map(function (x) {
        return "<em>" + esc(x) + "</em>"; }).join(" · ") + "</p>");

    if (d.filedUnder) {
      h.push('<div class="ra-juris" style="border-left-color:#C0392B">' +
             '<div class="lab">Filed under another country</div><p>' +
             esc(d.name) + " is in " + esc(CNAME[d.country] || d.country) +
             " today. FamilySearch catalogues it under <b>" +
             esc(CNAME[d.filedUnder] || d.filedUnder) +
             "</b>, because that is who held the ground when the records were made.</p></div>");
    }
    if (d.level) {
      h.push('<p class="at-sub">A ' + esc(d.level) + ", not a town — the marker is at its " +
             "centre, not at a building.</p>");
    }
    if (d.note) h.push('<p class="at-sub">' + esc(d.note) + "</p>");

    /* THE LINE THIS SITE EXISTS FOR. */
    var reg = d.region && REGION[d.region];
    if (reg) {
      if (year) {
        var es = erasIn(reg, year, year2);
        if (es.length) {
          h.push('<div class="ra-juris"><div class="lab">' +
                 (year === year2 ? "In " + year + ", this was"
                  : "Between " + year + " and " + year2 + ", this ground changed hands " +
                    (es.length === 1 ? "not at all" : (es.length - 1) + " time" +
                     (es.length === 2 ? "" : "s"))) + "</div>");
          es.forEach(function (e) {
            h.push("<p><span class=\"y\">" + Math.max(e.from, year) + "\u2013" +
                   Math.min(e.to, year2) + "</span> <b>" + esc(e.polity) + "</b></p>");
            if (e.filedUnder.length) {
              h.push('<p class="ra-filed">Filed under ' +
                e.filedUnder.map(function (f) {
                  var pv = PROV[f];
                  return pv ? '<a href="' + esc(pv.url) + '" target="_blank" rel="noopener">' +
                              esc(pv.name) + "</a>" : esc(f);
                }).join(" · ") + ".</p>");
            } else {
              h.push('<p class="ra-filed">No registers survive for this period anywhere.</p>');
            }
            if (e.note) h.push('<p class="ra-note">' + esc(e.note) + "</p>");
          });
          if (es.length > 1)
            h.push('<p class="ra-note"><b>That handover is the trap.</b> A family that ' +
                   "never moved has its records in two filing systems, and the second " +
                   "archive will tell you it holds nothing.</p>");
          h.push("</div>");
        }
      } else {
        h.push('<div class="ra-juris"><div class="lab">Whose ground this was</div>' +
               "<p>" + esc(reg.label) + " — <a href=\"#\" class=\"ra-setyear\">set a year</a> " +
               "to see which empire held it, and whose archive that means.</p></div>");
      }
    } else {
      h.push('<div class="ra-juris ra-unmapped"><div class="lab">Whose ground this was</div>' +
             "<p>Not yet mapped. " + REGIONS_N + " record regions carry an era " +
             "table so far — Istria, the Kvarner, Carnia, Dalmatia, Galicia, Bukovina, " +
             "Bohemia, Moravia, Hungary, Transylvania, East Prussia, Pomerania and the " +
             "rest — and this place is outside all of them. That is a gap in this map " +
             "rather than a gap in the record.</p></div>");
    }

    /* The page behind the panel. A marker is a view; a page is a thing you
       can send somebody, bookmark, or find from a search engine — and until
       these existed, 1,239 places had no address of their own. */
    h.push('<p class="at-go"><a href="' + BASE + "place/" + esc(d.id) + '/">' +
           "Everything about " + esc(d.name) + " &rarr;</a></p>");

    /* THE BOOKS THEMSELVES. «Croatia, Church Books, 1516–1994 covers this
       place» is true and one step short of what a researcher needs: which
       book, for which years, and where is it. */
    if (d.volumes && d.volumes.length) {
      /* TWO VOCABULARIES, BECAUSE THERE ARE TWO WALKS. Croatia's books were
         read in a browser and carry the EVENT — Births, Marriages, Deaths —
         parsed from titles that were all in one language. The rest of the
         world arrives from the waypoint API with titles in every language
         FamilySearch catalogues in, so those carry the record-kind reading
         instead. Grouping by whichever a book has keeps both legible; the
         alternative was every foreign book landing in "Other". */
      var byKind = {}, order = [];
      d.volumes.forEach(function (v) {
        var gs = (v.kinds && v.kinds.length) ? v.kinds
               : (v.rk && v.rk.length) ? v.rk.map(function (k) { return KLAB[k] || k; })
               : ["Other"];
        gs.forEach(function (k) {
          if (!byKind[k]) { byKind[k] = []; order.push(k); }
          byKind[k].push(v);
        });
      });
      /* Events first in their familiar order, then anything else as it came. */
      var PREF = ["Births", "Marriages", "Deaths", "Church Census",
                  "Confirmations", "Index"];
      order.sort(function (a, b) {
        var ia = PREF.indexOf(a), ib = PREF.indexOf(b);
        if (ia < 0) ia = a === "Other" ? 999 : 500;
        if (ib < 0) ib = b === "Other" ? 999 : 500;
        return ia - ib || a.localeCompare(b);
      });
      h.push('<div class="at-sec"><div class="lab">The volumes themselves</div>');
      h.push('<p class="at-sub">' +
             (d.volumesTotal
                ? esc(d.volumesTotal.toLocaleString()) + " books catalogued for " +
                  "this place, of which the oldest " + d.volumes.length +
                  " are listed here. "
                : d.volumes.length + " book" +
                  (d.volumes.length === 1 ? "" : "s") + " catalogued for this place. ") +
             "<b>Nobody here has opened any of them</b> — these are the " +
             "catalogue's own titles and the links that open the images.</p>");
      order.forEach(function (k) {
        if (!byKind[k]) return;
        h.push('<div class="lab" style="margin-top:10px">' + esc(k) + "</div>");
        h.push('<ul class="at-films">');
        byKind[k].slice(0, 25).forEach(function (v) {
          h.push("<li>" + (v.url
              ? '<a href="' + esc(v.url) + '" target="_blank" rel="noopener">' +
                esc(v.t) + " &#8599;</a>"
              : "<b>" + esc(v.t) + "</b>") +
            (v.from ? ' <span class="at-y">' + v.from + "\u2013" + v.to + "</span>" : "") +
            (v.conf ? ' <span class="ra-who">' + esc(v.conf) + "</span>" : "") +
            (v.film ? ' <span class="ra-who">film ' + esc(v.film) + "</span>" : "") +
            /* The path through FamilySearch's tree that put this book on
               this dot. Without it a reader has no way to tell a good match
               from a wrong one, and these are matched by name. */
            (v["in"] ? ' <span class="ra-who" title="Where this book sits in ' +
                       'FamilySearch\u2019s own tree">' + esc(v["in"]) + "</span>" : "") +
            "</li>");
        });
        if (byKind[k].length > 25)
          h.push('<li class="ra-who">…and ' + (byKind[k].length - 25) + " more</li>");
        h.push("</ul>");
      });
      h.push("</div>");
    }

    /* THE NATIONAL SOURCES, WHICH NO PANEL HAS EVER SHOWN. David clicked an
       Irish parish and asked where IrishGenealogy had gone. It had never been
       there: a provider's `countries` list was read by the find box and by the
       country pages and by nothing else, so the five free Irish national
       sources — IrishGenealogy, the National Library's parish registers, the
       National Archives, PRONI, Findmypast — were invisible on every Irish
       place on this map.
       That is backwards. A place with no volumes walked on it is exactly the
       place where the national source IS the answer, and it is the one thing
       this panel could always have said and never did.
       The worldwide twelve — FamilySearch, Ancestry, MyHeritage and the rest —
       are kept out of this list on purpose. They cover everywhere, so they say
       nothing about here, and they would bury the five that do. */
    /* AND WHERE THERE IS NOTHING CURATED, WHAT THERE IS. 199 countries had no
       named source at all, so clicking a place in Bolivia answered with
       FamilySearch — true of everywhere, and therefore a statement about
       nothing. These are Wikidata's national archives and libraries, fetched
       once and kept apart from the curated list because rattling a door is not
       the same as having read what is behind it. */
    if (d.country && warch[d.country]) {
      h.push('<div class="at-sec"><div class="lab">National sources, unverified</div>');
      h.push('<p class="at-sub">From Wikidata, CC0. Nobody here has opened these — ' +
             "the link answered when it was asked and that is all this map knows " +
             "about them. They are listed because <b>a country with no named " +
             "source at all is the worse answer</b>.</p>");
      h.push('<ul class="at-films">');
      warch[d.country].slice(0, 6).forEach(function (r) {
        h.push('<li><a href="' + esc(r.url) + '" target="_blank" rel="noopener">' +
               esc(r.name) + " &#8599;</a> " +
               '<span class="ra-who">' +
               (r.kind === "national-archive" ? "national archive" : "national library") +
               (r.status && r.status !== "ok"
                 ? " · " + esc(r.status === "challenged"
                     ? "behind a bot gate, but alive"
                     : r.status === "unreachable"
                       ? "did not answer this checker" : "answered with an error")
                 : "") + "</span></li>");
      });
      h.push("</ul></div>");
    }

    if (d.country) {
      var nat = provs.providers.filter(function (p) {
        return (p.countries || []).indexOf(d.country) > -1;
      }).sort(function (a, b) {
        var K = ["national-archive", "diocesan", "regional-archive", "library",
                 "volunteer", "aggregator", "commercial"];
        var ka = K.indexOf(a.kind), kb = K.indexOf(b.kind);
        if (ka !== kb) return (ka < 0 ? 99 : ka) - (kb < 0 ? 99 : kb);
        return RANK.indexOf(a.access) - RANK.indexOf(b.access);
      });
      if (nat.length) {
        h.push('<div class="at-sec"><div class="lab">The sources for ' +
               esc(CNAME[d.country] || d.country) + "</div>");
        h.push('<p class="at-sub">National and regional, and they cover this ground ' +
               "whether or not anybody has walked it here.</p>");
        h.push('<ul class="at-films">');
        nat.slice(0, 10).forEach(function (p) {
          h.push('<li><a href="' + esc(p.url) + '" target="_blank" rel="noopener">' +
                 esc(p.name) + " &#8599;</a> " +
                 '<span class="ra-who"><i class="at-dot" style="background:' +
                 (ACC[p.access] || ["#7C8A91"])[0] + '"></i>' +
                 esc((ACC[p.access] || [0, p.access])[1]) + "</span></li>");
        });
        if (nat.length > 10)
          h.push('<li class="ra-who">…and ' + (nat.length - 10) + " more on the " +
                 '<a href="' + BASE + "country/" + d.country.toLowerCase() +
                 '/">' + esc(CNAME[d.country] || d.country) + " page</a>.</li>");
        h.push("</ul></div>");
      }
    }

    /* The collections that reach this ground. The panel shows the nearest few
       and the page shows them all — a marker is a glance, not a catalogue. */
    if (d.nfs) {
      var near = (d.fs || []).filter(function (c) { return c.rank <= 2; });
      h.push('<div class="at-sec"><div class="lab">FamilySearch reaches here</div>');
      h.push('<p class="at-sub">' + d.nfs + " collection" + (d.nfs === 1 ? "" : "s") +
             " cover this ground" + (near.length ? ", " + near.length +
             " of them catalogued under this place or the district it sits in" : "") + ".</p>");
      h.push('<ul class="at-films">');
      /* WHOSE SHELF, WHEN IT IS NOT THIS COUNTRY'S. An 1863 baptism from an
         Istrian village sits in a Croatian archive; a 1915 one from the same
         village is filed under "Italy, Pola and Trieste". Somebody searching
         Croatia will never think to look there, and until now this map could
         not tell them — the harvest treated a collection whose places
         disagreed with its title as an error and threw the places away. Now
         it is a badge on the row, because it is the most useful single thing
         this map knows.
         NOT class ra-filed: that name is already the jurisdiction section's. */
      (near.length ? near : (d.fs || [])).slice(0, 5).forEach(function (c) {
        h.push('<li><a href="' + esc(c.url) + '" target="_blank" rel="noopener">' +
               esc(c.t) + " &#8599;</a>" +
               (c.from ? ' <span class="at-y">' + c.from + "\u2013" + c.to + "</span>" : "") +
               (c.filed && c.filed.length
                 ? ' <span class="ra-crossed" title="Filed under ' +
                   esc(c.filed.map(ccName).join(", ")) +
                   ', not under this place\u2019s own country \u2014 searching by ' +
                   'country alone will not find it.">filed under ' +
                   esc(c.filed.map(ccName).join(", ")) + "</span>"
                 : "") +
               "</li>");
      });
      h.push("</ul></div>");
    }

    var cs = d.collections.slice();
    if (year) cs = cs.filter(function (c) { return covers(c, year, year2); });
    if (!cs.length) {
      h.push('<p class="at-sub" style="margin-top:16px">' + (year
        ? "Nothing walked here covers " + (year === year2 ? year : year + "\u2013" + year2) + "."
        : (d.nfs ? "Nobody has walked this place volume by volume. The " + d.nfs +
                   " collection" + (d.nfs === 1 ? "" : "s") + " above " +
                   (d.nfs === 1 ? "is" : "are") + " what reaches it, and " +
                   (d.nfs === 1 ? "it is" : "they are") + " where to start."
                 : "No volumes recorded here yet.")) + "</p>");
      return h.join("");
    }

    /* Grouped by what it costs to look, most open first, because that is the
       order a reader actually wants to try them in. */
    var by = {};
    cs.forEach(function (c) { (by[c.access] = by[c.access] || []).push(c); });
    RANK.forEach(function (a) {
      if (!by[a]) return;
      h.push('<div class="at-sec"><div class="lab"><i class="ra-dot" style="background:' +
             ACC[a][0] + '"></i>' + esc(ACC[a][1]) + "</div>");
      h.push('<ul class="at-films">');
      by[a].forEach(function (c) {
        var span = c.from ? " <span class=\"at-y\">" +
          (c.to && c.to !== c.from ? c.from + "–" + c.to : c.from) + "</span>" : "";
        var who = PROV[c.provider] ? PROV[c.provider].name : c.provider;
        var t = esc(c.title || "Untitled volume");
        h.push("<li>" + (c.url
          ? '<a href="' + esc(c.url) + '" target="_blank" rel="noopener">' + t + " &#8599;</a>"
          : t) + span + ' <span class="ra-who">' + esc(who) + "</span>" +
          (c.held ? ' <span class="ra-who">held at ' + esc(c.held) + "</span>" : "") + "</li>");
      });
      h.push("</ul></div>");
    });
    return h.join("");
  }

  /* A VOLUME ANSWERS FOR A RANGE IF IT OVERLAPS IT AT ALL. A register running
     1798–1858 is exactly what somebody searching 1840–1870 wants, and a rule
     that demanded containment either way round would refuse it. */
  function covers(c, a, b) {
    if (!c.from) return false;
    var to = c.to || c.from;
    return c.from <= (b === undefined ? a : b) && to >= a;
  }

  /* ---- layers ------------------------------------------------------------ */
  /* id, the word on the chip, the sentence behind it, the layer. The short
     word is what fits in a row of seven; the sentence is the tooltip and the
     ⓘ panel, so nothing this used to say has stopped being said. */
  /* ---- EVERY COUNTRY, so that nowhere answers with nothing ---------------
     A marker has always meant «a place with volumes», so Libya — which has a
     FamilySearch research guide, a national archive and a GenWeb project —
     showed empty ground. A country is a place too, and the coarsest possible
     answer is enormously better than a blank. */
  var countryLayer = L.layerGroup(), cpts = [], cmarks = [];
  /* WHICH COUNTRIES THE CURRENT ANSWER IS ABOUT, or null when the
     question is not a surname. See syncCountryDots. */
  var litCC = null;
  /* Held as a promise, not just a variable. A visitor types faster than a
     fetch returns, and «libya» arriving before the country list did would
     find nothing and say so — which is the bug this layer exists to fix,
     reintroduced one line lower down. */
  var cptsReady = fetch(CPTS).then(function (r) { return r.json(); }).then(function (d) {
    cpts = d.countries || [];
    cpts.forEach(function (c) {
      var rich = c.p || c.v || c.c;
      var m = L.circleMarker([c.y, c.x], {
        radius: rich ? 7 : 5.5,
        color: "var(--accent)", weight: rich ? 1.8 : 1.2,
        opacity: rich ? .9 : .55,
        fillColor: "var(--accent)", fillOpacity: rich ? .18 : .07,
        dashArray: rich ? null : "2 3"
      });
      m.bindTooltip(c.n, { sticky: true });
      m.on("click", function () { openCountry(c); });
      m._cc = c.cc; m._n = fold(c.n);
      cmarks.push(m);
      m.addTo(countryLayer);
    });
    syncLayers();
    syncCountryDots();
    return cpts;
  }).catch(function () { return []; });

  function openCountry(c) {
    empty.hidden = true; panel.hidden = false;
    var h = ['<div class="at-h"><h3>' + esc(c.n) + "</h3>" +
             '<span class="at-n">the whole country</span></div>'];
    h.push('<p class="at-sub">' +
           (c.p ? c.p.toLocaleString() + " place" + (c.p === 1 ? "" : "s") + " drawn, " +
                  c.v.toLocaleString() + " volume" + (c.v === 1 ? "" : "s") + " walked"
                : "<b>No place in this country has been walked.</b>") +
           (c.c ? " · " + c.c + " collection" + (c.c === 1 ? "" : "s") + " cover it" : "") +
           "</p>");

    if (c.fs) {
      h.push('<div class="at-sec"><div class="lab">Where to start</div>');
      h.push('<ul class="at-films"><li><a href="https://www.familysearch.org/en/wiki/' +
             esc(c.fs) + '_Genealogy" target="_blank" rel="noopener">FamilySearch ' +
             "Research Wiki — " + esc(c.n) + " &#8599;</a> " +
             '<span class="ra-who">a research guide FamilySearch keeps for every ' +
             "country: what records exist, from when, and who holds them</span></li></ul>");
      h.push("</div>");
    }
    if (warch[c.cc]) {
      h.push('<div class="at-sec"><div class="lab">National sources, unverified</div>');
      h.push('<ul class="at-films">');
      warch[c.cc].slice(0, 6).forEach(function (r) {
        h.push('<li><a href="' + esc(r.url) + '" target="_blank" rel="noopener">' +
               esc(r.name) + " &#8599;</a> " + '<span class="ra-who">' +
               (r.kind === "national-archive" ? "national archive" : "national library") +
               "</span></li>");
      });
      h.push("</ul></div>");
    }
    var nat = provs.providers.filter(function (p) {
      return (p.countries || []).indexOf(c.cc) > -1;
    });
    if (nat.length) {
      h.push('<div class="at-sec"><div class="lab">Checked sources for ' +
             esc(c.n) + "</div><ul class=\"at-films\">");
      nat.slice(0, 8).forEach(function (p) {
        h.push('<li><a href="' + esc(p.url) + '" target="_blank" rel="noopener">' +
               esc(p.name) + " &#8599;</a> " + '<span class="ra-who">' +
               esc((ACC[p.access] || [0, p.access])[1]) + "</span></li>");
      });
      h.push("</ul></div>");
    }
    if (!c.fs && !warch[c.cc] && !nat.length) {
      h.push('<p class="at-what"><b>This map holds nothing for ' + esc(c.n) +
             " at all.</b> Not a collection, not an archive, not a research guide. " +
             "<b>That is a gap in this map, not a gap in the record.</b></p>");
    }
    h.push('<p class="at-go"><a href="' + BASE + "country/" + c.cc.toLowerCase() +
           '/">Everything this map holds for ' + esc(c.n) + " &rarr;</a></p>");
    if (!c.p)
      h.push('<p class="ra-note">No place inside ' + esc(c.n) + " is drawn on this " +
             "map yet, so there is nothing here to click. Switch on <b>Countries</b> " +
             "above and every country carries a marker like this one.</p>");
    panel.innerHTML = h.join("");
  }

  var LAYERS = [
    ["countries", "Countries", "every country on earth · the coarsest answer, and better than a blank", countryLayer],
    ["shelf", T("Shelf"), TOTAL_PLACES.toLocaleString() + " places · every volume that covers them", shelfLayer],
    ["archives", T("Archives"), archives.length + " institutions · where the paper actually is", archiveLayer],
    ["jurisdiction", T("Jurisdiction"), regions.regions.length + " record regions · whose archive this ground was", regionLayer],
    ["wikidata", T("Others"), "loading · unchecked, and not all genealogical", wikiLayer],
    ["cemeteries", T("Cemeteries"), "loading", featLayers.cemeteries],
    ["churches", T("Churches"), "loading", featLayers.churches],
    ["libraries", T("Libraries"), "loading", featLayers.libraries]
  ];
  var on = {};
  (Q.get("layers") !== null ? Q.get("layers").split(",").filter(Boolean)
                           : ["shelf", "countries"])
    .forEach(function (k) { on[k] = true; });
  if (!Object.keys(on).length) on.shelf = true;

  var lbox = document.getElementById("ra-layers");
  function drawLayers() {
    lbox.innerHTML = LAYERS.map(function (l) {
      return '<label class="ra-layer' + (on[l[0]] ? " on" : "") + '" data-l="' + l[0] +
        '" title="' + esc(l[1] + " — " + l[2]) + '">' +
        '<input type="checkbox"' + (on[l[0]] ? " checked" : "") + ' />' +
        "<b>" + esc(l[1]) + "</b></label>";
    }).join("");
  }
  drawLayers();
  function syncLayers() {
    LAYERS.forEach(function (l) {
      /* The shelf is the one layer this does not touch: below zoom 6 it is
         represented by the cluster bubbles instead, and drawClusters owns
         which of the two is on the map. */
      if (l[0] === "shelf") return;
      var has = map.hasLayer(l[3]);
      if (on[l[0]] && !has) l[3].addTo(map);
      if (!on[l[0]] && has) map.removeLayer(l[3]);
    });
    drawClusters(lastVisible);
    var live = LAYERS.filter(function (l) { return on[l[0]]; }).map(function (l) { return l[0]; });
    setQ("layers", live.join(","));
  }
  lbox.addEventListener("change", function (ev) {
    var lab = ev.target.closest(".ra-layer"); if (!lab) return;
    var k = lab.getAttribute("data-l");
    on[k] = ev.target.checked;
    lab.classList.toggle("on", !!on[k]);
    syncLayers();
  });

  /* ---- the access filter pills ------------------------------------------- */
  var off = {};
  (Q.get("off") || "").split(",").filter(Boolean).forEach(function (k) { off[k] = true; });
  document.getElementById("ra-cats").innerHTML = RANK.map(function (a) {
    return '<button class="at-cat' + (off[a] ? "" : " on") + '" data-cat="' + a +
      '" title="' + esc(ACC[a][1]) + '">' +
      '<i style="background:' + ACC[a][0] + '"></i>' + esc(ACC[a][2] || ACC[a][1]) +
      "</button>";
  }).join("") +
    /* The one thing on this map that the colours alone cannot say. */
    '<span class="at-cat at-hollow-key" title="A hollow dot means no volumes are ' +
    'recorded at that place. Any colour it has is borrowed from a collection ' +
    'catalogued under it, or under the district it sits in.">' +
    "<i></i>Hollow&nbsp;= unwalked</span>" +
    '<span class="at-cat at-hollow-key at-natl-key" title="Nothing in this atlas ' +
    'reaches that place, but its country has a named national archive or ' +
    'library — click the place and the panel lists it.">' +
    "<i></i>Dotted&nbsp;= country has an archive</span>";
  function catSummary() {
    var n = RANK.filter(function (a) { return !off[a]; }).length;
    document.getElementById("ra-catsum").textContent =
      n === RANK.length ? "What it costs to look — all " + RANK.length + " shown"
                        : "What it costs to look — " + n + " of " + RANK.length + " shown";
  }
  catSummary();
  document.getElementById("ra-cats").addEventListener("click", function (ev) {
    var b = ev.target.closest(".at-cat"); if (!b) return;
    var c = b.getAttribute("data-cat");
    off[c] = !off[c];
    b.classList.toggle("on", !off[c]);
    catSummary();
    setQ("off", Object.keys(off).filter(function (k) { return off[k]; }).join(","));
    apply();
  });

  /* ---- what kind of record ------------------------------------------------ */
  /* The bit for each kind comes from index.json rather than being written out
     here. Two copies of a derived constant is exactly how the shard keys came
     to disagree between build and client, and that cost 10,962 surnames their
     own spelling — so the client reads the mapping it is given. */
  var KBIT = idx.kinds || {};
  var KLAB = idx.kindLabels || {};
  var KORDER = Object.keys(KBIT);
  var kindOn = {};
  (Q.get("kind") || "").split(",").filter(Boolean).forEach(function (k) {
    if (KBIT[k]) kindOn[k] = true;
  });
  function kindMask() {
    var m = 0;
    for (var k in kindOn) { if (kindOn[k]) m |= KBIT[k]; }
    return m;
  }
  var kbox = document.getElementById("ra-kinds");
  if (KORDER.length) {
    kbox.innerHTML = KORDER.map(function (k) {
      return '<button class="at-cat' + (kindOn[k] ? " on" : "") + '" data-kind="' + k +
        '" title="' + esc(KLAB[k] || k) + '">' + esc(KLAB[k] || k) + "</button>";
    }).join("") +
      '<span class="at-cat at-hollow-key" title="A collection is sorted by what ' +
      'its title says it is. About one in six says nothing either way, so it ' +
      'appears only when no kind is chosen — narrowing to a kind can therefore ' +
      'hide a register that simply is not described.">' +
      "<i></i>Read from the title";
  }
  function kindSummary() {
    var n = KORDER.filter(function (k) { return kindOn[k]; });
    document.getElementById("ra-kindsum").textContent = !n.length
      ? "What kind of record — every kind"
      : "What kind of record — " + n.map(function (k) { return KLAB[k] || k; }).join(", ");
  }
  kindSummary();
  if (Object.keys(kindOn).length) document.getElementById("ra-kindw").open = true;
  kbox.addEventListener("click", function (ev) {
    var b = ev.target.closest(".at-cat[data-kind]"); if (!b) return;
    var k = b.getAttribute("data-kind");
    kindOn[k] = !kindOn[k];
    b.classList.toggle("on", !!kindOn[k]);
    kindSummary();
    setQ("kind", KORDER.filter(function (x) { return kindOn[x]; }).join(","));
    apply();
  });

  /* ---- the year ---------------------------------------------------------- */
  var year = null, year2 = null;
  var yon = document.getElementById("ra-yon"), yin = document.getElementById("ra-year"),
      yout = document.getElementById("ra-yout");
  var yin2 = document.getElementById("ra-year2");
  /* «years=1780,1920» is the new state. A bare «year=1863» from an older link
     still works and becomes a range of one, because a link somebody sent
     somebody else should not stop opening. */
  var qr = (Q.get("years") || "").split(",").map(function (x) { return parseInt(x, 10); });
  var qy = parseInt(Q.get("year"), 10);
  if (qr.length === 2 && qr[0] >= 1500 && qr[1] <= 2026 && qr[0] <= qr[1]) {
    year = qr[0]; year2 = qr[1]; yon.checked = true;
    yin.value = year; yin2.value = year2;
  } else if (qy >= 1500 && qy <= 2026) {
    year = year2 = qy; yon.checked = true; yin.value = qy; yin2.value = qy;
  }
  function paintTrack() {
    var lo = Math.min(+yin.value, +yin2.value), hi = Math.max(+yin.value, +yin2.value);
    var a = (lo - 1500) / (2026 - 1500) * 100, b = (hi - 1500) / (2026 - 1500) * 100;
    var t = document.getElementById("ra-track");
    t.style.left = a + "%";
    t.style.width = Math.max(b - a, 0.5) + "%";
    t.style.opacity = year ? "1" : ".25";
  }
  function yearUI() {
    yin.disabled = yin2.disabled = !year;
    yout.textContent = year
      ? (year === year2 ? String(year) : year + "\u2013" + year2)
      : "any year";
    paintTrack();
    /* The hint was a whole line of static prose under the slider. It is the
       control's own tooltip now, which is where a sentence that only matters
       once belongs. */
    document.getElementById("ra-ylab").title = year
      ? "Showing only what can answer for " + (year === year2 ? year : year + "–" + year2) +
        ". Every panel now says whose archive those years belonged to."
      : "Turn this on and the map keeps only the places that can answer for a range of years — and every panel says whose archive those years belonged to.";
    setQ("years", year ? year + "," + year2 : "");
    setQ("year", "");
    paintRegions();
    apply();
    var at = Q.get("at");
    if (at && cache[at]) { panel.innerHTML = render(cache[at]); }
  }
  yon.addEventListener("change", function () {
    readRange();
    yearUI();
  });

  /* ---- the years, running ------------------------------------------------
     Stepped on a timer rather than an animation frame: each step redraws
     every region polygon and re-filters 21,302 markers, which is far too
     much for 60fps and does not want to be smooth anyway. A decade every
     900ms is about reading speed — long enough to see a border move,
     short enough that five centuries take under a minute.

     It stops at the end rather than looping, and any touch of the sliders
     or the checkbox stops it, because a control that keeps moving under
     somebody trying to use it is worse than no control. */
  var playT = null, playBtn = document.getElementById("ra-play");
  var PLAY_SPAN = 50, PLAY_STEP = 10, PLAY_MS = 900;
  function stopPlay() {
    if (!playT) return;
    clearInterval(playT); playT = null;
    playBtn.innerHTML = "&#9654;";
    playBtn.setAttribute("aria-pressed", "false");
    playBtn.title = "Play the years — watch the jurisdictions change and the records follow";
  }
  function startPlay() {
    if (playT) return stopPlay();
    if (!yon.checked) { yon.checked = true; readRange(); }
    year = 1500; year2 = year + PLAY_SPAN;
    yin.value = year; yin2.value = year2;
    playBtn.innerHTML = "&#9632;";
    playBtn.setAttribute("aria-pressed", "true");
    playBtn.title = "Stop";
    yearUI();
    playT = setInterval(function () {
      if (year2 >= 2026) { stopPlay(); return; }
      year = Math.min(year + PLAY_STEP, 2026 - PLAY_SPAN);
      year2 = Math.min(year + PLAY_SPAN, 2026);
      yin.value = year; yin2.value = year2;
      yearUI();
    }, PLAY_MS);
  }
  /* Re-bucketing on every zoom, because a grid sized for zoom 2 is
     nonsense at zoom 5. Not on pan: the cells are absolute, so panning
     shows the same cells from a different angle. */
  map.on("zoomend", function () { drawClusters(lastVisible); });

  playBtn.addEventListener("click", startPlay);

  /* The examples on the opening panel actually run a search, rather than
     being decoration a reader has to retype. */
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest(".ra-try");
    if (!a) return;
    e.preventDefault();
    qbox.value = a.getAttribute("data-q") || "";
    qbox.dispatchEvent(new Event("input", { bubbles: true }));
    qbox.focus();
  });

  /* ---- keys, for people who are here for an hour -------------------------
     A researcher works down a list of parishes, and every one of them
     meant reaching for the mouse to clear the box. Four keys, all of them
     the ones already in muscle memory from everywhere else, and none of
     them stealing a keystroke from somebody typing into a field. */
  document.addEventListener("keydown", function (e) {
    var t = e.target || {};
    var typing = t.tagName === "INPUT" || t.tagName === "TEXTAREA"
              || t.isContentEditable;
    if (e.key === "Escape") {
      if (typing && t === qbox && qbox.value) { qbox.value = ""; apply(); return; }
      stopPlay();
      /* On a phone the result is a sheet over the map, and Escape is the
         other way out of it. On a desktop the panel is a column that is
         not covering anything, so closing it would just throw the answer
         away — hence the width test. */
      if (!panel.hidden && window.innerWidth <= 700) closeSheet();
      return;
    }
    if (typing || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === "/") { e.preventDefault(); qbox.focus(); qbox.select(); }
    else if (e.key === "y") { e.preventDefault(); yon.click(); }
    else if (e.key === "p") { e.preventDefault(); startPlay(); }
  });
  yon.addEventListener("change", stopPlay);
  yin.addEventListener("input", stopPlay);
  yin2.addEventListener("input", stopPlay);
  /* Either handle may be dragged past the other; the range is whichever way
     round they end up. Forbidding it would mean a handle that sticks, which
     is the more annoying of the two behaviours. */
  function readRange() {
    if (!yon.checked) { year = year2 = null; return; }
    var a = parseInt(yin.value, 10), b = parseInt(yin2.value, 10);
    year = Math.min(a, b); year2 = Math.max(a, b);
  }

  [yin, yin2].forEach(function (el) {
  el.addEventListener("input", function () {
    if (!yon.checked) return;
    readRange();
    yout.textContent = year === year2 ? String(year) : year + "\u2013" + year2;
    paintTrack();
    clearTimeout(yin._t);
    yin._t = setTimeout(yearUI, 120);
  });
  });
  /* «Take me there.» A townland, a district or an undrawn settlement is a real
     coordinate this map knows and could not previously be asked to show. */
  document.addEventListener("click", function (ev) {
    var g = ev.target.closest && ev.target.closest(".ra-goto");
    if (!g) return;
    ev.preventDefault();
    var y = parseFloat(g.getAttribute("data-y")), x = parseFloat(g.getAttribute("data-x"));
    if (isNaN(y) || isNaN(x)) return;
    if (gmark) { map.removeLayer(gmark); gmark = null; }
    gmark = L.circleMarker([y, x], {
      radius: 9, color: "var(--accent)", weight: 2, opacity: .9,
      fillColor: "#8E6FA8", fillOpacity: .35, dashArray: "3 3"
    }).addTo(map).bindTooltip(g.getAttribute("data-n"), { permanent: false });
    map.setView([y, x], Math.max(map.getZoom(), 11));
    document.querySelector(".at-map").scrollIntoView({ block: "center", behavior: "smooth" });
  });

  document.addEventListener("click", function (ev) {
    var cy = ev.target.closest && ev.target.closest(".ra-clearyear");
    if (cy) {
      ev.preventDefault();
      yon.checked = false; year = 0; yearUI();
      return;
    }
    if (!ev.target.classList || !ev.target.classList.contains("ra-setyear")) return;
    ev.preventDefault();
    yon.checked = true; year = parseInt(yin.value, 10); yearUI();
    yin.scrollIntoView({ block: "center", behavior: "smooth" });
  });

  /* EVERY COUNTRY ON EARTH IS THE RIGHT ANSWER TO NOTHING IN PARTICULAR.
     This layer draws all 237 of them so that clicking anywhere gives
     something back, which is right when nobody has asked a question. It
     was not filtered by the search, so typing a surname left two hundred
     country dots standing across Africa and Asia next to eight lit
     outlines — and a reader looking at a map of dots after typing a name
     reads the dots as the name. «0 of 21302 places shown» was printed at
     the bottom of a map covered in markers.

     So: no question, every country. A surname, only the countries that
     surname is attested in. Any other search, only countries whose name
     matches what was typed — «libya» should still find Libya. */
  function syncCountryDots() {
    /* The country list is fetched and can land before the search box is
       wired; `var qbox` is hoisted but undefined until then, and reading
       .value off it throws. This layer's whole reason for existing is a
       race exactly like that one. */
    if (!cmarks.length || !qbox) return;
    var t = fold(qbox.value.trim());
    cmarks.forEach(function (m) {
      var keep;
      if (litCC) keep = litCC[m._cc] === 1;
      else if (!t) keep = true;
      else keep = m._n.indexOf(t) > -1;
      if (keep) { if (!countryLayer.hasLayer(m)) m.addTo(countryLayer); }
      else if (countryLayer.hasLayer(m)) countryLayer.removeLayer(m);
    });
  }

  /* ---- find, filter, count ----------------------------------------------- */
  var qbox = document.getElementById("ra-q"), count = document.getElementById("ra-count");
  qbox.value = Q.get("q") || "";
  /* A year the place cannot answer for is a place that is not an answer. The
     index carries no spans, so this uses the volume count as a cheap proxy and
     the panel does the exact test — except that the exact test is the one that
     matters, so spans ride in the index after all. See build.py. */
  /* ---- A SURNAME AND A PLACE, ASKED TOGETHER -----------------------------
     «Blazevic Istria» is the question everybody actually has, and this map
     could only be asked one half of it at a time: type both and it matched
     nothing, because no place is called that and no register holds a name
     with a space in it.

     The split is only attempted when the WHOLE query matches no place, so
     nothing that works today changes — «Nova Gorica» is still one place,
     not a Nova in Gorica. Then the query is cut at each space and the first
     cut whose right-hand side names places on this map wins; the left-hand
     side is carried off to the surname register.

     `qPlace` is what the map filters on. `qName` is what the panel goes and
     looks up. If the register does not attest the name, the panel says so
     and still shows the places — «we hold no register for this name» and
     «nobody of this name lived there» are different statements and only the
     first one is ours to make. */
  var qPlace = null, qName = null;
  function nameMatch(p, t) {
    return fold(p.n).indexOf(t) > -1 || !!(p.q && wordHit(p.q, t));
  }
  function splitQuery(t) {
    qPlace = qName = null;
    if (!t || t.indexOf(" ") < 0) return;
    if (markers.some(function (m) { return nameMatch(m._p, t); })) return;
    var w = t.split(/\s+/).filter(Boolean);
    for (var i = 1; i < w.length; i++) {
      var left = w.slice(0, i).join(" "), right = w.slice(i).join(" ");
      if (left.length < 3 || right.length < 3) continue;
      if (markers.some(function (m) { return nameMatch(m._p, right); })) {
        qPlace = right; qName = left; return;
      }
    }
  }

  function keep(p) {
    if (off[RANK[p.a]]) return false;
    var t = qPlace || fold(qbox.value.trim());
    /* `q` now holds only the forms that are NOT the place's own name, so the
       name itself is folded here rather than shipped 2,128 times. */
    /* THE BLOB IS MATCHED ON WHOLE WORDS. `q` holds a place's other names
       AND the country it stands in — Kyiv's reads "kyiv, soviet ukraine,
       union". Searching «Krain», the German name of Carniola, therefore
       selected every Ukrainian place on the map, and the map fitted its
       bounds to Kyiv, Odesa and Stalin and flew to the middle of Ukraine
       with an empty panel. Found by patching L.Map.fitBounds on the live
       site and reading the stack, after three wrong guesses about which
       corpus was matching.
       The place's own name is still matched loosely, so typing part of a
       name still finds it. It is the blob, which carries the country, that
       has to respect word boundaries. */
    if (t && fold(p.n).indexOf(t) < 0 && !(p.q && wordHit(p.q, t))) return false;
    if (year && p.s && (p.s[0] > year2 || p.s[1] < year)) return false;
    /* ANY of the chosen kinds, not all of them: somebody after church records
       and censuses wants both sorts of place, not only the places holding
       both. A place with no kind at all is hidden once a kind is chosen,
       which is honest — nothing about it says it holds that kind. */
    var km = kindMask();
    if (km && !((p.k || 0) & km)) return false;
    return true;
  }
  /* `noFrame` is for the one caller that is not a visitor doing something:
     the quiet dots arriving a second after the map drew. They have to be
     filtered in like every other marker — they obey the year and the kind
     boxes too — but the visitor may already be typing, and re-framing the
     map on a wider set of matches would move the ground under them for a
     reason they did not ask for. Every other caller frames. */
  /* ---- CLUSTERS, BECAUSE 21,302 DOTS AT WORLD ZOOM IS A SMEAR ----------
     Canvas made drawing them all fast and did nothing for reading them:
     zoomed out, Europe is one grey mass and the eye cannot find where the
     collection actually is. This is a grid, not a clustering library —
     buckets sized in degrees by zoom, one circle per bucket, labelled
     with what it stands for.

     It swaps rather than overlays: below the threshold the individual
     markers come off the map entirely, because a bubble drawn on top of
     the dots it summarises is just more ink. Above it the bubbles go and
     the real dots come back, which is where clicking a place has to work.

     THE COUNT IS PLACES, NOT VOLUMES, and the tooltip says both. A bubble
     over Croatia reading "1,177" that silently meant books would be the
     map lying at the one zoom where nobody can check it. */
  /* THE CELL IS SEVENTY PIXELS, NOT SO-MANY DEGREES. The first version cut
     the world into degree-wide squares and at the opening zoom that gave
     639 bubbles for 21,473 places — a finer smear on top of the old one,
     which is worse than no clustering because it also hides the colours.
     Measured, not guessed: `recordAtlas.state()` reports the count, which
     is most of why that handle exists.
     A cell in projected pixels is the same size on screen at every zoom, so
     the map holds roughly ninety bubbles whatever the reader does, and
     zooming in genuinely divides them instead of merely redrawing. */
  var clusterLayer = L.layerGroup(), CLUSTER_TO = 6, CLUSTER_PX = 70,
      lastVisible = [];
  function show(layer, want) {
    var has = map.hasLayer(layer);
    if (want && !has) layer.addTo(map);
    else if (!want && has) map.removeLayer(layer);
  }
  function drawClusters(visible) {
    clusterLayer.clearLayers();
    var z = map.getZoom();
    var bubbles = !!(on.shelf && z < CLUSTER_TO && visible.length);
    show(clusterLayer, bubbles);
    show(shelfLayer, on.shelf && !bubbles);
    if (!bubbles) return false;
    /* Read the token rather than hard-coding the teal: Leaflet paints these
       into a canvas, where a CSS variable would come out as nothing, and
       dark mode moves --accent from #1F5C6B to #6FB6C6. */
    var ink = getComputedStyle(document.documentElement)
      .getPropertyValue("--accent").trim() || "#1F5C6B";
    var cells = {}, top = 1;
    visible.forEach(function (m) {
      var p = m._p, pt = map.latLngToLayerPoint(m.getLatLng());
      var k = Math.floor(pt.x / CLUSTER_PX) + ":" + Math.floor(pt.y / CLUSTER_PX);
      var c = cells[k] || (cells[k] = { n: 0, v: 0, y: 0, x: 0 });
      c.n++; c.v += p.v || 0; c.y += pt.y; c.x += pt.x;
      if (c.n > top) top = c.n;
    });
    Object.keys(cells).forEach(function (k) {
      var c = cells[k];
      var at = map.layerPointToLatLng(L.point(c.x / c.n, c.y / c.n));
      L.circleMarker(at, {
        radius: 7 + 22 * Math.sqrt(c.n / top),
        color: "#fff", weight: 1, opacity: 0.9,
        fillColor: ink, fillOpacity: 0.62
      })
        .bindTooltip(c.n.toLocaleString() + (c.n === 1 ? " place" : " places") +
          (c.v ? " \u00b7 " + c.v.toLocaleString() + " volumes" : ""),
          { sticky: true })
        .on("click", function (e) {
          map.setView(e.latlng, Math.min(map.getZoom() + 3, CLUSTER_TO + 1));
        })
        .addTo(clusterLayer);
    });
    return true;
  }

  function apply(noFrame) {
    var t = fold(qbox.value.trim());
    splitQuery(t);
    if (qPlace) t = qPlace;
    syncCountryDots();
    var shown = 0, vis = [];
    markers.forEach(function (m) {
      var ok = keep(m._p);
      if (ok) { if (!shelfLayer.hasLayer(m)) m.addTo(shelfLayer); shown++; vis.push(m); }
      else if (shelfLayer.hasLayer(m)) shelfLayer.removeLayer(m);
    });
    lastVisible = vis;
    drawClusters(vis);
    var aShown = 0;
    archMarkers.forEach(function (m) {
      /* Same blob, same fix: an archive's _q carries the town and country
         it stands in, so «Krain» matched every archive in Ukraine too. */
      var ok = !t || wordHit(m._q, t);
      if (ok) { if (!archiveLayer.hasLayer(m)) m.addTo(archiveLayer); aShown++; }
      else if (archiveLayer.hasLayer(m)) archiveLayer.removeLayer(m);
    });
    /* A YEAR THAT EMPTIES THE MAP SHOULD SAY SO LOUDLY. Set to 2004 this hides
       everything, because almost nothing is open for 2004 — privacy windows
       close births for a century and deaths for fifty years. That is a correct
       answer and it looks exactly like a broken map, which is why the count
       line now says which it is and offers the way out. */
    count.innerHTML = esc(shown + " of " + markers.length + " places shown") +
      (year ? esc(", able to answer for " + year) : "") +
      (on.archives ? esc(", and " + aShown + " of " + archives.length + " archives") : "");
    if (year && !shown) {
      count.innerHTML = '<b>Nothing on this map can answer for ' + (year === year2 ? year : year + '\u2013' + year2) + '.</b> ' +
        "Records close for a lifetime — a century for births, fifty years for " +
        'deaths — so a recent year empties it. <a href="#" class="ra-clearyear">' +
        "Clear the year</a> to see all " + markers.length + " places.";
    }

    if (!t) {
      /* Clearing the box clears the map with it. Anything drawn to answer a
         search is an answer to a question nobody is asking any more. */
      if (gmark) { map.removeLayer(gmark); gmark = null; }
      ctryLayer.clearLayers();
      communeLayer.clearLayers();
      litCC = null;
      return;
    }
    if (noFrame) return;
    var vis = markers.filter(function (m) { return shelfLayer.hasLayer(m); });
    var avis = archMarkers.filter(function (m) { return archiveLayer.hasLayer(m); });
    var frame = vis.concat(on.archives ? avis : []);
    if (frame.length) {
      map.fitBounds(L.latLngBounds(frame.map(function (m) { return m.getLatLng(); })),
                    { padding: [40, 40], maxZoom: 11 });
      /* Both halves were asked, so both get answered, in one panel. */
      if (qName) { both(vis, qName, qbox.value.trim()); return; }
      if (vis.length === 1) { open(vis[0]._p); return; }
      /* SEVERAL PLACES MATCHED, SO THE MAP IS THE ANSWER — BUT THE PANEL
         MUST NOT STILL BE ANSWERING THE LAST QUESTION. This branch framed
         the matches and fell through without touching the panel, so the
         panel kept whatever the previous search had put there. Typing
         «Kranj» moved the map to Carniola while the panel went on
         describing the surname Kosina from the search before it. I misread
         that as a broken search twice today before noticing the panel and
         the map were answering different questions.
         One line saying what was framed, and which places they are. */
      if (vis.length > 1) {
        empty.hidden = true; panel.hidden = false;
        var some = vis.slice(0, 12);
        var hh = ['<div class="at-h"><h3>' + esc(qbox.value.trim()) + "</h3>" +
                  '<span class="at-n">' + vis.length.toLocaleString() +
                  " places</span></div>"];
        hh.push('<p class="at-what"><b>' + vis.length.toLocaleString() +
                " places match, and the map is framed on them.</b> Click a dot for " +
                "what stands there, or narrow the name.</p>");
        hh.push('<ul class="at-films">');
        some.forEach(function (m) {
          var p = m._p;
          hh.push('<li><a href="' + BASE + "place/" + esc(p.i) + '/">' + esc(p.n) +
                  "</a>" + (p.c ? ' <span class="ra-who">' + p.c +
                  " collection" + (p.c === 1 ? "" : "s") + "</span>" : "") + "</li>");
        });
        hh.push("</ul>");
        if (vis.length > some.length)
          hh.push('<p class="cap">and ' + (vis.length - some.length).toLocaleString() +
                  " more on the map.</p>");
        panel.innerHTML = hh.join("");
        return;
      }
    }

    /* «NO PLACES OF THAT NAME» WHEN THE YEAR IS WHAT HID IT. David searched
       Crikvenica and was told this map had nothing, while his own archive
       shows six volumes for it. It has all six. The year slider was on 2004
       and Crikvenica's registers run 1798 to 1943, so the filter removed the
       marker — correctly — and the search then reported the place as absent,
       which is a different and untrue thing.
       A filter hiding something is not the same as the something not being
       there, and this panel is the only place that can say which. */
    if (year) {
      var hidden = markers.filter(function (m) {
        var p = m._p;
        if (shelfLayer.hasLayer(m)) return false;
        var q = fold(p.n) + " " + (p.q || "");
        return wordHit(q, t);
      });
      if (hidden.length) {
        var one = hidden[0]._p;
        empty.hidden = true; panel.hidden = false;
        var hh = ['<div class="at-h"><h3>' + esc(one.n) + "</h3></div>"];
        hh.push('<div class="ra-juris" style="border-left-color:#E8792B">' +
                '<div class="lab">Hidden by the year, not missing</div>');
        hh.push("<p><b>" + esc(one.n) + "</b> is on this map with <b>" +
                ((one.v || 0) || (one.c || 0)).toLocaleString() + " volume" +
                (((one.v || 0) || (one.c || 0)) === 1 ? "" : "s") + "</b>" +
                (one.s ? ", covering " + one.s[0] + "–" + one.s[1] : "") +
                " — and <b>nothing here covers " + (year === year2 ? year : year + "\u2013" + year2) + "</b>, so the year " +
                "filter has taken it off the map.</p>");
        hh.push('<p><a href="#" class="ra-clearyear"><b>Clear the year</b></a>' +
                " and it comes back" +
                (hidden.length > 1 ? ", with " + (hidden.length - 1) + " other " +
                 (hidden.length === 2 ? "place" : "places") + " this is hiding" : "") +
                '. Or go straight to <a href="' + BASE + "place/" + esc(one.i) +
                '/">everything recorded at ' + esc(one.n) + "</a>.</p>");
        hh.push("</div>");
        panel.innerHTML = hh.join("");
        return;
      }
    }
    /* THE HONEST EMPTY RESULT. Somebody typing "Ireland" has asked a real
       question, and a blank map answers it with a falsehood. There is no Irish
       shelf here YET — but there are providers that cover Ireland and archives
       standing in Dublin, and the difference between "we have not walked this"
       and "there is nothing here" has to be said out loud every single time or
       the map quietly implies a completeness it does not have. */
    if (!shown) elsewhere(qbox.value.trim());
  }

  /* THE ANSWER TO «A NAME, IN A PLACE».
     The map is already framed on the places by the time this runs; this
     writes the panel. The one thing it must not do is imply that an
     attestation is a presence: the Croatian register saying 11,163 people
     carry a name is a fact about Croatia, not about the four villages the
     map happens to be showing. So the two statements are kept apart, and
     the places that DO sit in an attested country are marked as such and
     the others are not. */
  async function both(vis, name, raw) {
    var mine = ++searchTok;
    var list = await surnames(name);
    if (mine !== searchTok) return;
    var r = list[0];
    /* MATCHED ON THE COUNTRY CODE, not on the country's name turning up in
       the place's search blob. The first version did the latter and was
       wrong every single time: `q` carries only the names a place used to
       have, so Gračišće's is the one word "gallignana" and it matched
       nothing at all. The panel then told a reader that Blažević is not
       attested where Gračišće stands — which is Croatia, which the same
       paragraph went on to list. `cc` is back on the index row for this. */
    var attested = {}, ccs = [];
    if (r) r.countries.forEach(function (c) {
      if (!c.cc) return;
      attested[String(c.cc).toUpperCase()] = c; ccs.push(c);
    });
    var inAttested = function (p) {
      return p.cc ? attested[String(p.cc).toUpperCase()] || null : null;
    };
    var hit = vis.filter(function (m) { return !!inAttested(m._p); });

    empty.hidden = true; panel.hidden = false;
    /* The heading is the register's own spelling where there is one —
       «Blažević», not the folded «blazevic» the matcher works in, which is
       what the first version printed across the top of the panel. Failing
       that, the words the reader actually typed. */
    var typed = raw.split(/\s+/);
    var asked = typed.slice(0, Math.max(1, typed.length -
                  qPlace.split(/\s+/).length)).join(" ");
    var title = r ? r.n : asked;
    var h = ['<div class="at-h"><h3>' + esc(title) + "</h3>" +
             '<span class="at-n">' + vis.length.toLocaleString() +
             (vis.length === 1 ? " place" : " places") + "</span></div>"];
    h.push('<p class="at-sub">' + esc(raw) + " — read as the name <b>" + esc(asked) +
           "</b> and the place <b>" + esc(vis[0]._p.n) + "</b>.</p>");

    if (!r) {
      h.push('<p class="at-what"><b>No register here attests ' + esc(asked) + '.</b> ' +
             "That is a statement about this atlas and not about the name — the " +
             "registers it holds cover some countries and not others, and a name " +
             "absent from them may be perfectly common where your people lived. " +
             "The places below are the other half of what you asked.</p>");
    } else if (!ccs.length) {
      h.push('<p class="at-what"><b>' + esc(r.n) + " is held here with no country " +
             "attached,</b> so it cannot be lined up against these places.</p>");
    } else if (hit.length) {
      /* «1 of these 1 places stands» is what arithmetic says and not what
         a person would. One place gets a sentence about that place. */
      h.push('<p class="at-what"><b>' +
             (vis.length === 1
               ? esc(vis[0]._p.n) + " stands in a country where " + esc(r.n) +
                 " is attested."
               : hit.length.toLocaleString() + " of these " +
                 vis.length.toLocaleString() + " places " +
                 (hit.length === 1 ? "stands" : "stand") + " in a country where " +
                 esc(r.n) + " is attested.") +
             "</b> Attested means a register counted the " +
             "name in that country. It does not mean anybody of the name lived in " +
             "these particular villages — that is what the records are for, and " +
             "they are listed on each place below.</p>");
    } else {
      h.push('<p class="at-what"><b>None of these places is in a country where ' +
             esc(r.n) + " is attested here.</b> That is worth knowing and it is not " +
             "a verdict: it can equally mean this atlas holds no register for that " +
             "country. The name is attested in " +
             ccs.slice(0, 6).map(function (c) { return esc(CNAME[c.cc]); }).join(", ") +
             (ccs.length > 6 ? " and " + (ccs.length - 6) + " more" : "") + ".</p>");
    }

    h.push('<ul class="at-films">');
    vis.slice(0, 14).forEach(function (m) {
      var pl = m._p, a = inAttested(pl);
      h.push('<li><a href="' + BASE + "place/" + esc(pl.i) + '/">' + esc(pl.n) + "</a>" +
             (pl.c ? ' <span class="ra-who">' + pl.c + " collection" +
              (pl.c === 1 ? "" : "s") + "</span>" : "") +
             (a ? ' <span class="ra-crossed">' + esc(CNAME[a.cc]) +
              (a.n ? " · " + a.n.toLocaleString() + " of the name" : "") +
              "</span>" : "") + "</li>");
    });
    h.push("</ul>");
    if (vis.length > 14)
      h.push('<p class="cap">and ' + (vis.length - 14).toLocaleString() +
             " more on the map.</p>");
    if (r) h.push(renderSurnames([r], r.n));
    panel.innerHTML = h.join("");
    if (r) showCountries(r.countries, function () { return mine !== searchTok; });
  }

  /* SURNAMES. A place is not the only thing somebody arrives holding: very
     often all they have is a name on a certificate and no idea which country
     to start in. This answers that — the spellings the name also takes, the
     countries it is attested in, and from there the collections and archives
     that reach those countries.

     «Attested in» means the name appears in a dataset held here. It never
     means the name exists there and nowhere else, and the panel says so. */
  var scache = {};
  async function surnames(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in scache)) {
      try { scache[key] = await (await fetch(SURN + key + ".json")).json(); }
      catch (e) { scache[key] = []; }
    }
    var hit = [];
    scache[key].forEach(function (r) {
      var q = fold(r.n);
      var m = q === f ? 0 : q.indexOf(f) === 0 ? 1 : null;
      if (m === null) {
        for (var i = 0; i < r.variants.length; i++) {
          var fv = fold(r.variants[i].n);
          if (fv === f) { m = 2; break; }
          if (fv.indexOf(f) === 0 && m === null) m = 3;
        }
      }
      if (m !== null) hit.push([m, r]);
    });
    hit.sort(function (a, b) {
      return a[0] - b[0] || (b[1].countries.length - a[1].countries.length);
    });
    /* ONE CARD PER CLUSTER. Searching «Llerena» returned LLERENA, LARENA and
       LERENA as three separate panels saying much the same thing, because
       each is a hit in its own right. They are one family of spellings: if a
       name is already listed as a variant of something shown above it, it is
       not news. The best-ranked one wins and carries the rest. */
    var shown = [], claimed = {};
    hit.forEach(function (x) {
      var r = x[1];
      if (claimed[fold(r.n)]) return;
      shown.push(r);
      claimed[fold(r.n)] = true;
      r.variants.forEach(function (v) { claimed[fold(v.n)] = true; });
    });
    return shown.slice(0, 4);
  }

  function renderSurnames(list, term) {
    var h = [];
    var same = list.length && fold(list[0].n) === fold(term);
    list.forEach(function (r) {
      h.push('<div class="ra-surn"><div class="lab">The name</div>');
      /* Suppressed when the panel's own heading is already this name —
         see the canon note where the heading is built. */
      if (!(same && fold(r.n) === fold(term)))
        h.push("<p><b>" + esc(r.n) + "</b></p>");

      /* AND SOMEWHERE TO GO. The panel named a surname and stopped,
         while the atlas holds a page for it — variants, where it is
         borne, when it was being born, and which archives to write to.
         `pg` is set by build.py for the 23,926 names that have one;
         without the flag this would 404 for thirty-nine names in forty,
         because most surnames in a 946,575-name corpus have nothing to
         put on a page. */
      if (r.pg) {
        var slug = fold(r.n).replace(/[^a-z0-9]+/g, "-")
                            .replace(/^-|-$/g, "");
        if (slug)
          h.push('<p class="ra-go"><a href="' + BASE + "surname/" + slug +
                 '/">Everything about ' + esc(r.n) + " &#8594;</a></p>");
      } else {
        /* AND THE THIRTY-NINE IN FORTY THAT HAVE NO PAGE NOW GO SOMEWHERE
           TOO. They used to stop here, which is where most searches land —
           the panel said what the register knew and then offered nothing to
           click. /surname/ answers for any name in the corpus off the same
           shard this panel just read, so there is a destination without
           900,000 pages of one line each. */
        h.push('<p class="ra-go"><a href="' + BASE + "surname/?q=" +
               encodeURIComponent(r.n) + '">What the registers say about ' +
               esc(r.n) + " &#8594;</a></p>");
      }

      /* Everything but the phonetic guess counts as evidence here, which
                 now includes the spelling tier: one systematic substitution
                 between two names that are both independently attested. */
      var cur = r.variants.filter(function (v) { return v.how !== "sounds"; });
      var snd = r.variants.filter(function (v) { return v.how === "sounds"; });
      if (cur.length)
        h.push('<p class="ra-vars"><span class="ra-tag">also written</span> ' +
               cur.map(function (v) { return "<em>" + esc(v.n) + "</em>"; }).join(" · ") + "</p>");
      if (snd.length)
        h.push('<p class="ra-vars ra-weak"><span class="ra-tag">the same name by sound, ' +
               'not by a record</span> ' +
               snd.slice(0, 8).map(function (v) { return esc(v.n); }).join(" · ") + "</p>");

      /* THREE QUESTIONS, NOT ONE. «Attested in» was answering all of them at
         once and therefore none of them clearly: where a name is BORNE today,
         where a record NAMES it, and where it CAME FROM. They take different
         evidence and deserve different sentences. */
      var byHow = {};
      r.countries.forEach(function (c) { (byHow[c.how] = byHow[c.how] || []).push(c); });
      var linkCC = function (list, withN) {
        return list.map(function (c) {
          return '<a href="' + BASE + "country/" + c.cc.toLowerCase() + '/">' +
                 esc(CNAME[c.cc] || c.cc) + "</a>" +
                 (withN && c.n ? ' <span class="ra-who">' + c.n.toLocaleString() +
                                 "</span>" : "");
        }).join(" · ");
      };

      /* THE RESEARCHED CLAIM LEADS, NOT THE STATISTICAL ONE. «Borne in» came
         first and read as «born in», which it does not mean — and for D'Arcy
         it put «Poland 6» at the top of the panel, because Poland's is the
         only one of our six national registers with a D'Arcy in it, above 308
         surnames of actual D'Arcy research naming Britain, Ireland and
         Australia. A six-person head-count is not the headline fact about an
         Irish name. A document naming the family on the ground is. */
      var found = (byHow.archive || []).concat(byHow.curated || []);
      if (found.length) {
        h.push('<p class="ra-filed"><span class="ra-tag">found in records here</span> ' +
               linkCC(found, false) + "</p>");
        h.push('<p class="ra-note">A family archive or a catalogue names this surname ' +
               "on that ground — a document, not a head-count. Narrower evidence than " +
               "a register, usually much older, and the reason this map exists.</p>");
      }

      if (byHow.register) {
        h.push('<p class="ra-filed"><span class="ra-tag">counted in a national ' +
               'register</span> ' + linkCC(byHow.register, true) + "</p>");
        h.push('<p class="ra-note">How many people of that name a state counted — ' +
               "the closest thing here to «where the name is now». This map holds " +
               "registers for six countries only, so a small number in one of them " +
               "says more about which registers we have than about the name.</p>");
      }
      if (byHow.grammar || byHow.sounds) {
        h.push('<p class="ra-filed ra-weak"><span class="ra-tag">a form of the name</span> ' +
               linkCC((byHow.grammar || []).concat(byHow.sounds || []), false) + "</p>");
      }

      /* ORIGIN, and the only kind this map will assert. */
      if (r.places && r.places.length) {
        h.push('<p class="ra-filed"><span class="ra-tag">also a place</span> ' +
               r.places.map(function (pl) {
                 var how = pl.via === "name" ? ""
                   : pl.via === "variant" ? " — a spelling of the name"
                   : " — but only a phonetic neighbour, not a spelling";
                 return "<b>" + esc(pl.n) + "</b>" +
                        (pl.cc ? " <span class=\"ra-who\">" + esc(CNAME[pl.cc] || pl.cc) +
                                 (pl.pop ? ", pop. " + pl.pop.toLocaleString() : "") +
                                 esc(how) + "</span>" : "");
               }).join(" · ") + "</p>");
        h.push('<p class="ra-note"><b>This is as close to an origin as this map will ' +
               "go.</b> A surname that is also a place name often came from it — and " +
               "often did not: plenty are occupations or patronymics that happen to " +
               "collide, and plenty of places are named after a family rather than " +
               "the other way round. It is a fact with a source, which is more than " +
               "an etymology page offers.</p>");
      } else {
        h.push('<p class="ra-note">No place of this name is in the gazetteer, so this ' +
               "map says nothing about where the name came from. Search anywhere else " +
               "and you will be told an ORIGIN — that it is Latin, or Italian, or " +
               "means «joyful». That is etymology, it is usually unsourced, and it is " +
               "a different question from the one this map answers.</p>");
      }

      if (r.countries.length) {
        h.push('<p class="ra-note">Every one of these means the name appears in a ' +
               "dataset held here — never that it exists in those countries and " +
               "nowhere else. The blanks on this map are gaps in it, as always.</p>");
      } else {
        h.push('<p class="ra-note">No country attested yet. The name is known; where it ' +
               "is found is not, which is a gap in this map rather than in the world.</p>");
      }
      h.push("</div>");
    });
    return h.join("");
  }

  /* The worldwide gazetteer, fetched three letters at a time and kept.
     48,906 places and 212,101 names they have been written under — enough to
     answer "the name changed" for the whole earth, which is the one of the
     three problems that does not need a shelf to solve. */
  var gcache = {}, gmark = null;
  async function gazetteer(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in gcache)) {
      try { gcache[key] = await (await fetch(GAZ + key + ".json")).json(); }
      catch (e) { gcache[key] = []; }
    }
    var hit = [];
    gcache[key].forEach(function (r) {
      var fn = fold(r[0]);
      var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
      if (m === null) {
        /* r[5] is every form the place has ever been written in, folded and
           space-joined — not the curated display list, which is missing the
           very names people type. */
        var best = null;
        (r[5] || "").split(" ").forEach(function (fa) {
          var v = fa === f ? 3 : fa.indexOf(f) === 0 ? 4 : fa.indexOf(f) > -1 ? 5 : null;
          if (v !== null && (best === null || v < best)) best = v;
        });
        m = best;
      }
      if (m !== null) hit.push([m, r]);
    });
    /* An exact hit on the current name first, then a prefix, then an exact hit
       on a FORMER name — and the shard is already in population order, which
       is the right tie-break: somebody typing Czernowitz means Chernivtsi, not
       a suburb of Brno that kept the same name. */
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return hit.slice(0, 8).map(function (x) { return x[1]; });
  }

  /* Settlements inside a record region that hold no volumes here. They are
     not drawn — 8,352 grey dots would bury the 2,128 that carry something —
     but a reader holding a village name still gets the answer they came for,
     because the region knows whose archive held that ground. */
  var setcache = {};
  async function settlements(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in setcache)) {
      try { setcache[key] = await (await fetch(SETT + key + ".json")).json(); }
      catch (e) { setcache[key] = []; }
    }
    return setcache[key].filter(function (r) {
      return fold(r.n).indexOf(f) > -1;
    }).slice(0, 4);
  }

  /* Districts — the rung records are filed at, for the 17,320 of them no
     collection names. Undrawn on purpose; still the answer to "where is Kreis
     Bomst", which is a question this atlas should never have to refuse. */
  var dcache = {};
  async function districts(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in dcache)) {
      try { dcache[key] = await (await fetch(DIST + key + ".json")).json(); }
      catch (e) { dcache[key] = []; }
    }
    var hit = [];
    dcache[key].forEach(function (r) {
      var fn = fold(r.n);
      var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
      if (m !== null) hit.push([m, r]);
    });
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return hit.slice(0, 4).map(function (x) { return x[1]; });
  }

  /* WHERE A NAME IS FOUND, DRAWN. A surname search used to produce a list of
     country links and leave the map showing whatever it was showing — which
     is the one thing a map is for and the one thing this did not do. Outlines
     are fetched one country at a time from c/, so answering «Lerena» costs
     four small files and nothing at all for anyone who never searches a name. */
  var ccache = {}, ctryLayer = L.layerGroup();

  /* ---- A NAME AT THE GRAIN OF A TOWN -------------------------------------
     Shading a country is the most a national register supports, and for ten
     of the eleven registers here it is the honest maximum. Belgium counts
     every surname in each of its 565 communes, so for a Belgian name this
     map can do what the whole atlas is for: put the answer on the ground.

     Fetched only when a name has matched, from its own shards, so a search
     that has nothing to do with Belgium never pays for it. */
  var bcache = {}, communeLayer = L.layerGroup(), communeBox = null;
  /* The same three-character shard rule as the search corpus — see
     build.py, which tried four to split the Belgian «Van » names and put
     it back rather than keep two rules in step by hand. */
  async function communes(name) {
    var f = fold(name), key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return null;
    if (!(key in bcache)) {
      try { bcache[key] = await (await fetch(BSURN + key + ".json")).json(); }
      catch (e) { bcache[key] = null; }
    }
    var sh = bcache[key];
    if (!sh || !sh.n || !sh.n[f]) return null;
    var row = sh.n[f];
    /* [index, count] against the shard's own commune table, so each
       commune's name and coordinates are written once per file. */
    return [row[0].map(function (p) {
      var c = sh.c[p[0]];
      return [c[0], c[1], p[1], c[2]];
    }), row[1], row[2]];
  }

  function showCommunes(rec, label) {
    communeLayer.clearLayers();
    communeBox = null;
    if (!rec) return null;
    var rows = rec[0], total = rec[1], people = rec[2];
    if (!map.hasLayer(communeLayer)) communeLayer.addTo(map);
    var top = rows.reduce(function (a, r) { return Math.max(a, r[2]); }, 1);
    rows.forEach(function (r) {
      /* Sized like the shelf dots, so the two layers read as one map. A
         commune is a place a state counted people in, which is a firmer
         claim than anything else drawn here, and it is drawn solid. */
      L.circleMarker([r[0], r[1]], {
        radius: Math.min(3 + Math.sqrt(r[2]) * 0.9, 14),
        color: "#fff", weight: 0.8, opacity: .9,
        fillColor: "#1E8449", fillOpacity: .8
      }).bindTooltip(esc(r[3]) + " — " + r[2].toLocaleString() + " " +
                     esc(label), { sticky: true }).addTo(communeLayer);
    });
    communeBox = L.latLngBounds(rows.map(function (r) {
      return [r[0], r[1]];
    }));
    return { drawn: rows.length, total: total, people: people };
  }
  async function outline(cc) {
    var k = (cc || "").toLowerCase();
    if (!k) return null;
    if (!(k in ccache)) {
      try { ccache[k] = await (await fetch(CTRY + k + ".json")).json(); }
      catch (e) { ccache[k] = null; }
    }
    return ccache[k];
  }
  /* HOW THIS COUNTRY CAME TO BE LIT, drawn rather than merely listed. A name
     found in a national register of 1,575 people and a name found because
     somebody walked a parish archive are not the same claim, and the first cut
     of this shaded them identically — Spain and Croatia the same colour, the
     same weight, the same everything.
     A register is a solid outline: a state counted these people. An archive is
     a dashed one: one researcher found this name on this ground, which is a
     narrower and more human kind of evidence, and the map should not dress it
     up as a census. */
  var EVID = {
    register: { color: "#1E8449", dash: null,
                say: "a national register counted it" },
    archive:  { color: "#8E6FA8", dash: "5 4",
                say: "a family archive found it on this ground" },
    grammar:  { color: "#B08322", dash: "2 4",
                say: "a grammatical form of the name" },
    curated:  { color: "#3C5A8A", dash: null, say: "a curated link" },
    sounds:   { color: "#7C8A91", dash: "1 5", say: "a phonetic neighbour" }
  };

  async function showCountries(list, stale) {
    /* Clears its own outlines and NOT the commune dots. It used to clear
       both, which was invisible until the dots started being drawn first
       — showCommunes ran, drew 60 towns, and this wiped them a
       millisecond later. Each layer is cleared by whoever fills it, and
       by the search that starts a new question. */
    ctryLayer.clearLayers();
    if (!list.length) return;
    var got = await Promise.all(list.slice(0, 10).map(function (x) {
      return outline(x.cc || x);
    }));
    if (stale && stale()) return;
    var box = null;
    got.forEach(function (c, i) {
      if (!c) return;
      var e = EVID[(list[i] || {}).how] || EVID.register;
      L.polygon(c.rings.map(function (r) {
        return r.map(function (p) { return [p[1], p[0]]; });
      }), { color: e.color, weight: e.dash ? 2.2 : 1.6, opacity: .9,
            dashArray: e.dash, fillColor: e.color, fillOpacity: .10,
            interactive: false })
        .addTo(ctryLayer);
      var b = L.latLngBounds([c.box[0], c.box[1]], [c.box[2], c.box[3]]);
      box = box ? box.extend(b) : b;
    });
    if (!map.hasLayer(ctryLayer)) ctryLayer.addTo(map);
    if (!map.hasLayer(communeLayer)) communeLayer.addTo(map);
    /* THE SHARPEST ANSWER FRAMES THE MAP.
       Searching «Peeters» lit Spain, France, Poland and the United States,
       fitted the map to all four and landed the reader in the middle of
       the Atlantic — while 411 Belgian communes, the only place-level
       answer on the map, sat unframed off the edge. Country outlines are
       context; towns a state counted people in are the answer, so when
       there are towns they decide the view. */
    if (communeBox) map.fitBounds(communeBox, { padding: [40, 40], maxZoom: 9 });
    else if (box) map.fitBounds(box, { padding: [30, 30], maxZoom: 7 });
  }

  /* Irish townlands. Undrawn — 60,883 dots would bury Ireland — but a townland
     is the unit an Irish record actually names, and the county and civil parish
     that come back with it are the whole answer: «Glebe» is 213 different
     places and is not an address until you know which. */
  var tcache = {};
  async function townlands(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in tcache)) {
      try { tcache[key] = await (await fetch(TOWN + key + ".json")).json(); }
      catch (e) { tcache[key] = []; }
    }
    var hit = [];
    tcache[key].forEach(function (r) {
      var fn = fold(r.n);
      var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
      if (m !== null) hit.push([m, r]);
    });
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return { rows: hit.slice(0, 6).map(function (x) { return x[1]; }),
             total: hit.length };
  }

  /* THE LAST SEARCH TYPED IS THE ONE THAT WINS. Every fetch in here is async
     and a search runs on a 140 ms debounce, so «defranceski» and the earlier
     «defrance» are in flight together and whichever finishes last writes the
     panel. David's screenshot caught it exactly: the box read «defranceski»
     and the panel was headed «defrance», listing Defrance and Defrances —
     right answers to a question already superseded.
     Each run takes a ticket. If a newer one has started by the time this one
     has its data, it drops everything rather than painting over the answer. */
  var searchTok = 0;

  /* Italian comuni. Undrawn — the province is already a dot and it is the rung
     Antenati files by — but searchable under BOTH names, which is the whole
     point: somebody holding a record that says «Bozen» is holding a record
     about Bolzano and may not know it. */
  var mcache = {};
  async function comuni(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in mcache)) {
      try { mcache[key] = await (await fetch(COMU + key + ".json")).json(); }
      catch (e) { mcache[key] = []; }
    }
    var hit = [];
    mcache[key].forEach(function (r) {
      var forms = [r.n].concat(r.a || []);
      var best = null;
      forms.forEach(function (x) {
        var fx = fold(x);
        var m = fx === f ? 0 : fx.indexOf(f) === 0 ? 1 : fx.indexOf(f) > -1 ? 2 : null;
        if (m !== null && (best === null || m < best)) best = m;
      });
      if (best !== null) hit.push([best, r]);
    });
    hit.sort(function (a, b) { return a[0] - b[0]; });
    return hit.slice(0, 5).map(function (x) { return x[1]; });
  }

  /* Estonian parishes and historic counties. Names only — the archive
     publishes no coordinates and this map will not invent any. */
  var ecache = {};
  async function estonia(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in ecache)) {
      try { ecache[key] = await (await fetch(ESTO + key + ".json")).json(); }
      catch (e) { ecache[key] = []; }
    }
    return ecache[key].filter(function (r) {
      return fold(r.n).indexOf(f) > -1;
    }).slice(0, 4);
  }

  /* Scotland's civil parishes. The unit every Scottish record is filed by —
     the old parish registers, the statutory registers and the censuses all
     use it — and until now typing one returned nothing at all. These carry
     coordinates, so a hit can say where it is rather than only that it
     exists. */
  var sccache = {};
  async function scotland(term) {
    var f = fold(term);
    var key = "";
    for (var i = 0; i < f.length && key.length < 3; i++)
      if (/[a-z0-9]/.test(f[i])) key += f[i];
    if (key.length < 3) return [];
    if (!(key in sccache)) {
      try { sccache[key] = await (await fetch(SCOT + key + ".json")).json(); }
      catch (e) { sccache[key] = []; }
    }
    return sccache[key].filter(function (r) {
      return fold(r.n).indexOf(f) > -1;
    }).slice(0, 4);
  }

  /* A RECORD NAMES THE GROUND BY ITS OWN NAME, NOT BY OURS.
     David's Blazevic research has a man from "Kranjska zupa sv. Martin kod
     Krainburg" — Carniola, the parish of St Martin near Kranj, whose German
     name is Krainburg. This atlas HAS that region, with eight eras from
     Inner Austria through the Illyrian Provinces to the Duchy of Carniola,
     and typing any of those words found nothing at all: the regions were
     drawn, shaded and clickable, and never searchable. A jurisdiction layer
     that cannot be reached by the name the record uses is a layer for
     people who already know the answer. */
  function regionsNamed(term) {
    var f = fold(term);
    if (f.length < 3) return [];
    var out = [];
    regions.regions.forEach(function (reg) {
      var names = [reg.label].concat(reg.alt || []);
      var best = null;
      names.forEach(function (n) {
        var fn = fold(n);
        var m = fn === f ? 0 : fn.indexOf(f) === 0 ? 1 : fn.indexOf(f) > -1 ? 2 : null;
        if (m !== null && (best === null || m < best)) best = m;
      });
      if (best !== null) out.push([best, reg]);
    });
    out.sort(function (a, b) { return a[0] - b[0]; });
    return out.slice(0, 3).map(function (x) { return x[1]; });
  }

  /* A COUNTRY IS MATCHED ON WHOLE WORDS, NOT ON ANY RUN OF LETTERS INSIDE ONE.
     «Krain» is the German name of Carniola, and typing it flew the map to
     Ukraine — because "ukraine".indexOf("krain") is 1. The region's other
     names all worked, so the one that failed was the one hiding inside a
     larger word. A query matches a country when it begins the name or begins
     a word in it: "united" and "kingdom" both find the United Kingdom, and
     "krain" finds neither it nor Ukraine, and falls through to Carniola. */
  function wordHit(hay, needle) {
    if (!hay || !needle) return false;
    var i = hay.indexOf(needle);
    while (i > -1) {
      if (i === 0 || /[^a-z0-9]/.test(hay.charAt(i - 1))) return true;
      i = hay.indexOf(needle, i + 1);
    }
    return false;
  }

  async function elsewhere(term) {
    var mine = ++searchTok;
    /* TYPING A COUNTRY'S NAME SHOULD OPEN THE COUNTRY. David typed «libya» and
       got «Qaṣr Lībiyā», a village whose name happens to contain it, and
       nothing at all about the country — while the country panel, with its
       research guide and its national archive, was one marker click away and
       unreachable by the one thing everybody does first, which is type.
       This runs before everything else: an exact country name is not an
       ambiguous query. */
    var fterm = fold(term);
    var hitCC = null;
    var list = await cptsReady;
    await warchReady;
    if (mine !== searchTok) return;
    for (var ci = 0; ci < list.length; ci++) {
      var cp = list[ci];
      if (fold(cp.n) === fterm || cp.cc.toLowerCase() === fterm) { hitCC = cp; break; }
    }
    if (hitCC) {
      if (gmark) { map.removeLayer(gmark); gmark = null; }
      ctryLayer.clearLayers();
      communeLayer.clearLayers();
      litCC = null;
      openCountry(hitCC);
      showCountries([{ cc: hitCC.cc, how: "register" }], function () {
        return mine !== searchTok;
      });
      return;
    }
    var stale = function () { return mine !== searchTok; };
    /* EVERY SEARCH STARTS FROM A CLEAN MAP. The gazetteer marker used to be
       removed only when a NEW gazetteer hit replaced it, so typing on past a
       match left the old one behind: «Lere» found a village in Nigeria and
       flew there, and «Lerena» — which matches no place at all — left the map
       in Nigeria with a marker on a village that has nothing to do with the
       name. The panel said «no places of that name here yet» while the map
       said otherwise, and the map is louder. */
    if (gmark) { map.removeLayer(gmark); gmark = null; }
    ctryLayer.clearLayers();
    communeLayer.clearLayers();
    litCC = null;
    var f = fold(term);
    var iso = Object.keys(CNAME).filter(function (k) {
      return wordHit(fold(CNAME[k]), f) || k.toLowerCase() === f;
    });
    var cover = provs.providers.filter(function (p) {
      if (iso.some(function (k) { return (p.countries || []).indexOf(k) > -1; })) return true;
      if (p.at && wordHit(fold(p.at.place), f)) return true;
      return wordHit(fold(p.name), f);
    });
    var hits = await gazetteer(term);
    var names = await surnames(term);
    /* Fetched here with the rest, because the panel is written once
       and a promise landing after it has nowhere to put its line. */
    var beRec = names.length ? await communes(names[0].n) : null;
    if (stale()) return;
    var setts = await settlements(term);
    var dists = await districts(term);
    var tlands = await townlands(term);
    var com = await comuni(term);
    var est = await estonia(term);
    var sct = await scotland(term);
    var regs = regionsNamed(term);
    if (stale()) return;
    /* If the typed word is an OLD name, say which one it matched and what the
       place is called now. "Pressburg → Bratislava" is the whole answer to the
       first of the three problems, and it works in any country on earth. */
    empty.hidden = true; panel.hidden = false;
    /* ONE HEADER, AND THE NAME AS ITS OWNER SPELLS IT.
       This echoed what was typed — «defranceski», lower case, because
       that is how it was keyed — and then renderSurnames printed «The
       name / Defranceski» directly underneath. Two headings for one
       answer, the first of them a transcript of the reader's own
       keystrokes. When the search is an exact surname the canonical
       spelling is the better title, and the card below drops its
       duplicate. */
    var canon = null;
    if (names.length && fold(names[0].n) === fold(term)) canon = names[0].n;
    var h = ['<div class="at-h"><h3>' + esc(canon || term) + "</h3></div>"];
    if (names.length) {
      h.push(renderSurnames(names, term));
      /* The strongest evidence for a country wins its outline. A name in both
         a register and an archive is drawn as a register — the stronger claim
         is the true one, and the panel lists both anyway. */
      var lit = [], seen = {};
      var STRONG = ["register", "curated", "archive", "grammar", "sounds"];
      function light(list) {
        (list || []).forEach(function (c) {
          var was = seen[c.cc];
          if (was === undefined) { seen[c.cc] = lit.length; lit.push({cc: c.cc, how: c.how}); }
          else if (STRONG.indexOf(c.how) < STRONG.indexOf(lit[was].how)) lit[was].how = c.how;
        });
      }
      /* Drawn before the outlines, because showCountries decides the
         view and needs to know whether there is anything sharper. */
      var be = showCommunes(beRec, names[0].n);
      names.forEach(function (r) { light(r.countries); });
      litCC = {};
      /* THE SPELLINGS COUNT TOO, AND THEY WERE NOT COUNTING.
         «One card per cluster» folds Blazevich and Blaževič into the
         Blažević card, which is right for the panel and was quietly wrong
         for the map: only the representative's countries were lit, so a
         search for a name showed where THAT spelling is counted and not
         where the name is. The clerk's choice of letter is exactly what a
         researcher does not know.
         Sounds-alike variants are left out. They are an algorithm's guess,
         the panel says so, and lighting a country on one would put a
         family in Poland because a machine thought two names rhymed. */
      var VARIANT_OK = { curated: 1, grammar: 1, spelling: 1 };
      var byName = {};
      names.forEach(function (r) { byName[fold(r.n)] = 1; });
      var extra = [];
      names.forEach(function (r) {
        (r.variants || []).forEach(function (v) {
          if (!VARIANT_OK[v.how]) return;
          var fv = fold(v.n);
          if (byName[fv]) return;
          byName[fv] = 1;
          extra.push(fv);
        });
      });
      if (extra.length) {
        var pool = [];
        Object.keys(scache).forEach(function (k) {
          (scache[k] || []).forEach(function (r) { pool.push(r); });
        });
        pool.forEach(function (r) {
          if (extra.indexOf(fold(r.n)) > -1) light(r.countries);
        });
      }
      lit.forEach(function (c) { litCC[c.cc] = 1; });
      syncCountryDots();
      showCountries(lit, stale);

      /* And where a state counted by town rather than by country, draw
         the towns. Belgium is the only one, and the panel says so — a
         reader seeing Belgium in dots and France in a wash must not read
         that as a fact about the name. */
      if (be) {
        h.push('<p class="ra-note"><b>' + esc(names[0].n) +
          " in Belgium, by commune.</b> " + be.people.toLocaleString() +
          " people in " + be.total + " of Belgium's 565 communes" +
          (be.drawn < be.total ? ", the " + be.drawn + " biggest drawn"
                               : "") +
          ". Statbel counts every surname in every commune, and no other " +
          "register here counts below the country — so this layer is " +
          "Belgium alone, and a country drawn as a wash is a gap in what " +
          "states publish, not in the name.</p>");
      }
    }
    /* A village inside a mapped region: no shelf, but a jurisdiction answer,
       which is the thing this map is actually for. */
    setts.forEach(function (r) {
      var reg = REGION[r.r];
      if (!reg) return;
      var e = year ? eraAt(reg, year) : null;
      h.push('<div class="ra-juris"><div class="lab">A place in a mapped region</div>');
      h.push('<p><a href="#" class="ra-goto" data-y="' + r.y + '" data-x="' + r.x +
             '" data-n="' + esc(r.n) + '"><b>' + esc(r.n) + "</b></a> — " +
             esc(CNAME[r.k] || r.k) +
             ', in <a href="' + BASE + "region/" + esc(r.r) + '/">' +
             esc(reg.label) + "</a>.</p>");
      if (e) {
        h.push('<p class="ra-filed">In ' + year + " this was <b>" + esc(e.polity) +
               "</b>" + (e.filedUnder.length ? ", and records of that period are filed under " +
               e.filedUnder.map(function (x) {
                 return PROV[x] ? esc(PROV[x].name) : esc(x); }).join(" · ") : "") + ".</p>");
      } else {
        h.push('<p class="ra-filed">No volumes here yet — but the ground is mapped. ' +
               '<a href="#" class="ra-setyear">Set a year</a> and this will say whose ' +
               "empire held it, and therefore whose archive holds the paper.</p>");
      }
      h.push("</div>");
    });
    /* An Estonian parish or historic county. */
    if (est.length) {
      h.push('<div class="ra-juris"><div class="lab">In the Estonian filing system</div>');
      est.forEach(function (r) {
        h.push("<p><b>" + esc(r.n) + "</b> — " +
               (r.k === "parish"
                 ? "a <b>kihelkond</b>, the parish Estonian church records are filed by"
                 : "a historic county of the Baltic governorates") + "</p>");
      });
      h.push('<p class="ra-note">Before 1866 the civil administration filed by MANOR ' +
             "rather than by parish, and the revision lists that name a whole household " +
             "at once are arranged that way — so an Estonian line has two filing systems " +
             "over it, and the first question about any record is which one it came out " +
             "of. Some of these counties are in LATVIA today: the governorate boundary " +
             "did not follow the modern one.</p>");
      h.push("</div>");
    }
    /* THE GROUND ITSELF, under whichever name the record used. */
    if (regs.length) {
      h.push('<div class="ra-juris"><div class="lab">Whose archive this ground was</div>');
      regs.forEach(function (reg) {
        var eras = (reg.eras || []).length;
        h.push("<p><b>" + esc(reg.label) + "</b>" +
               (reg.alt && reg.alt.length
                 ? ' <span class="ra-who">also written ' +
                   esc(reg.alt.slice(0, 4).join(", ")) + "</span>" : "") +
               " — " + eras + " era" + (eras === 1 ? "" : "s") +
               ' on this ground. <a href="' + esc(BASE) + "region/" +
               esc(reg.id) + '/">who held it, and when</a>' +
               ' · <a href="#" class="ra-setyear">set a year</a></p>');
      });
      h.push('<p class="ra-note">A record names the ground by the name it had at ' +
             "the time. Kranjska, Krain and Krainburg are all Carniola; Küstenland " +
             "is the Austrian Littoral. The era table says which archive held the " +
             "paper in the year you care about, which is a different question from " +
             "which country the ground is in now.</p>");
      h.push("</div>");
    }
    /* A Scottish civil parish. */
    if (sct.length) {
      h.push('<div class="ra-juris"><div class="lab">In the Scottish filing system</div>');
      sct.forEach(function (r) {
        h.push("<p><b>" + esc(r.n) + "</b> — a <b>civil parish</b>" +
               (r.c ? ", parish number " + esc(r.c) : "") +
               (r.y != null ? ' <a href="#" class="ra-goto" data-y="' + r.y +
                 '" data-x="' + r.x + '">show on the map</a>' : "") + "</p>");
      });
      h.push('<p class="ra-note">Scotland files by civil parish and by nothing else: ' +
             "the old parish registers before 1855, the statutory registers after it, " +
             "and every census in between. The parish number is the one ScotlandsPeople " +
             "indexes by, so it is the fastest thing to search with. Parish boundaries " +
             "were redrawn in 1891 and a name can sit in two counties either side of " +
             "that, which is why a search that finds nothing is worth trying under the " +
             "older county.</p>");
      h.push("</div>");
    }
    /* An Italian comune, found under either of its names. */
    if (com.length) {
      h.push('<div class="ra-juris"><div class="lab">An Italian comune</div>');
      com.forEach(function (r) {
        var other = (r.a || []).filter(function (x) { return fold(x) !== fold(r.n); });
        h.push("<p><b>" + esc(r.n) + "</b>" +
               (other.length ? " — officially also <b>" + other.map(esc).join(" · ") +
                               "</b>" : "") +
               (r.p ? '<br><span class="ra-who">Provincia di ' + esc(r.p) +
                      (r.r ? ", " + esc(r.r) : "") +
                      " — the province is the rung the state archives and Antenati " +
                      "file by</span>" : "") + "</p>");
      });
      h.push("</div>");
    }
    /* A townland. The county and civil parish are the answer, not the trimming:
       the civil parish is what Griffith's Valuation and the registration
       districts are arranged by, so it is the word to search next. */
    if (tlands.rows && tlands.rows.length) {
      h.push('<div class="ra-juris"><div class="lab">An Irish townland</div>');
      if (tlands.total > tlands.rows.length)
        h.push('<p class="at-sub">' + tlands.total + " townlands carry this name. " +
               "Which one it is depends on the county — that is what a townland " +
               "name alone cannot tell you.</p>");
      tlands.rows.forEach(function (r) {
        /* The civil parish is usually a place this map draws. Offering the
           name without the link made the reader search again for a word this
           panel had just handed them. */
        var cpp = r.cp ? byName[fold(r.cp)] : null;
        h.push('<p><a href="#" class="ra-goto" data-y="' + r.y + '" data-x="' + r.x +
               '" data-n="' + esc(r.n) + '"><b>' + esc(r.n) + "</b></a>" +
               (r.co ? " — County " + esc(r.co) : "") +
               (r.cp ? '<br><span class="ra-who">in the civil parish of ' +
                       (cpp ? '<a href="' + BASE + "place/" + esc(cpp) + '/"><b>' +
                              esc(r.cp) + "</b></a>" : "<b>" + esc(r.cp) + "</b>") +
                       (r.bar ? ", barony of " + esc(r.bar) : "") +
                       " — the unit Griffith's Valuation and the registration " +
                       "districts are arranged by</span>" : "") + "</p>");
      });
      h.push("</div>");
    }
    /* THE YEAR CONTROL REACHED THE SHELF AND NOT THE NAMES. Somebody who has
       typed a surname, lit four countries and then set 1863 is asking the
       question this atlas exists for — whose archive held that ground in that
       year — and the year control simply ignored them. Every record region
       inside a lit country now answers for the year set. */
    if (year && names.length) {
      var ccLit = {};
      names.forEach(function (r) {
        (r.countries || []).forEach(function (c) { ccLit[c.cc] = true; });
      });
      var eraRows = [];
      regions.regions.forEach(function (rg) {
        if (!(rg.countries || []).some(function (k) { return ccLit[k]; })) return;
        var e = eraAt(rg, year) || erasIn(rg, year, year2)[0];
        if (e) eraRows.push([rg, e]);
      });
      if (eraRows.length) {
        h.push('<div class="ra-juris"><div class="lab">In ' +
               (year === year2 ? year : year + "\u2013" + year2) +
               ", the ground these names sit on</div>");
        eraRows.slice(0, 8).forEach(function (pair) {
          var rg = pair[0], e = pair[1];
          h.push('<p><a href="' + BASE + "region/" + esc(rg.id) + '/">' +
                 esc(rg.label) + "</a> — <b>" + esc(e.polity) + "</b>" +
                 (e.filedUnder.length ? '<br><span class="ra-who">filed under ' +
                   e.filedUnder.map(function (x) {
                     return PROV[x] ? esc(PROV[x].name) : esc(x); }).join(" · ") +
                   "</span>" : "") + "</p>");
          if (e.note && e.note.indexOf("THE TRAP") === 0)
            h.push('<p class="ra-note">' + esc(e.note) + "</p>");
        });
        if (eraRows.length > 8)
          h.push('<p class="ra-who">…and ' + (eraRows.length - 8) +
                 " more regions in those countries.</p>");
        h.push("</div>");
      }
    }
    /* A district with nothing of its own. Saying which first-level division
       it sits in is not a consolation prize: adm1 is the rung a collection is
       filed at, so it is the word to search next. */
    if (dists.length) {
      h.push('<div class="ra-juris"><div class="lab">An administrative district</div>');
      dists.forEach(function (r) {
        var pp = r.p ? byName[fold(r.p)] : null;
        h.push('<p><a href="#" class="ra-goto" data-y="' + r.y + '" data-x="' + r.x +
               '" data-n="' + esc(r.n) + '"><b>' + esc(r.n) + "</b></a> — " +
               esc(CNAME[r.k] || r.k) +
               (r.p ? ", in " + (pp ? '<a href="' + BASE + "place/" + esc(pp) +
                                      '/">' + esc(r.p) + "</a>" : esc(r.p)) : "") +
               '<br><span class="ra-who">No collection here names this district. ' +
               (r.p ? "Try " + esc(r.p) + ", which is the level they are filed at."
                    : "Try the country.") + "</span></p>");
      });
      h.push("</div>");
    }
    if (hits.length) {
      var top = hits[0];
      gmark = L.circleMarker([top[1], top[2]], {
        radius: 9, color: "var(--accent)", weight: 2, opacity: .9,
        fillColor: "#8E6FA8", fillOpacity: .35, dashArray: "3 3"
      }).addTo(map);
      /* Only fly to a place when the place is what was asked for. A surname
         that happens to begin with the letters of a village is not a request
         to go to the village, and the map jumping there buries the answer. */
      if (!names.length || fold(top[0]) === f)
        map.setView([top[1], top[2]], Math.max(map.getZoom(), 8));
      h.push('<div class="ra-juris"><div class="lab">That name is a place</div>');
      hits.slice(0, 5).forEach(function (r) {
        var older = r[4].filter(function (a) { return fold(a) !== fold(r[0]); });
        /* If what they typed is a form the curated list left out, put it back
           at the front — it is the one word on this panel they already trust. */
        if (!older.some(function (a) { return fold(a).indexOf(f) > -1; }))
          older.unshift(term);
        older = older.slice(0, 5);
        h.push("<p><b>" + esc(r[0]) + "</b> — " + esc(CNAME[r[3]] || r[3]) +
               (older.length ? '<br><span class="ra-who">also written ' +
                 older.map(esc).join(" · ") + "</span>" : "") + "</p>");
      });
      h.push("</div>");
    }
    /* Only worth printing when it adds something. Typing "Ireland" and being
       told "Ireland" is noise; typing "HR" and being told "Croatia" is not. */
    var named = iso.map(function (k) { return CNAME[k]; })
                   .filter(function (n) { return fold(n) !== f; });
    if (named.length)
      h.push('<p class="at-also">' + named.map(esc).join(" · ") + "</p>");
    /* Widen the provider list to the country the gazetteer just landed in —
       somebody who typed Pressburg wants Slovakia's sources, and has not said
       the word "Slovakia" at any point. */
    names.forEach(function (r) {
      r.countries.forEach(function (c) { if (iso.indexOf(c.cc) < 0) iso.push(c.cc); });
    });
    if (hits.length || names.length) {
      hits.slice(0, 3).forEach(function (r) { if (iso.indexOf(r[3]) < 0) iso.push(r[3]); });
      cover = provs.providers.filter(function (p) {
        if (iso.some(function (k) { return (p.countries || []).indexOf(k) > -1; })) return true;
        if (p.at && fold(p.at.place).indexOf(f) > -1) return true;
        return fold(p.name).indexOf(f) > -1;
      });
    }
    h.push('<p class="at-what"><b>No places of that name here yet.</b> The shelf stands in ' +
           "95 countries, but only 46 of them have a place somebody has actually walked " +
           "volume by volume — the rest are districts, correctly placed and unread. " +
           "<b>That is a gap in this map, not a gap in the record.</b></p>");
    if (cover.length) {
      h.push('<div class="at-sec"><div class="lab">But these reach it</div><ul class="at-films">');
      cover.slice(0, 14).forEach(function (p) {
        h.push('<li><a href="' + esc(p.url) + '" target="_blank" rel="noopener">' +
               esc(p.name) + " &#8599;</a> <span class=\"ra-who\">" +
               esc((ACC[p.access] || [0, p.access])[1]) + "</span>" +
               (p.at ? ' <span class="ra-who">' + esc(p.at.place) + "</span>" : "") + "</li>");
      });
      h.push("</ul>");
      if (cover.length > 14) h.push('<p class="at-sub">and ' + (cover.length - 14) + " more.</p>");
      h.push("</div>");
      h.push('<p class="at-sub">Switch on <b>The archives</b> above to see the ones that have ' +
             "a building.</p>");
    } else {
      h.push('<p class="at-sub">Nothing in this map reaches it either — which is exactly the ' +
             "kind of gap worth telling us about.</p>");
    }
    panel.innerHTML = h.join("");
  }
  qbox.addEventListener("input", function () {
    setQ("q", qbox.value.trim());
    clearTimeout(qbox._t);
    qbox._t = setTimeout(apply, 140);
  });

  /* ---- basemap switch, home, and the view in the address bar -------------- */
  var bctl = L.control({ position: "topright" });
  bctl.onAdd = function () {
    var b = L.DomUtil.create("div", "leaflet-bar ra-base");
    b.innerHTML = ["map", "terrain", "satellite"].map(function (k) {
      return '<a href="#" data-b="' + k + '"' + (k === baseNow ? ' class="on"' : "") + ">" + k + "</a>";
    }).join("");
    L.DomEvent.disableClickPropagation(b);
    L.DomEvent.on(b, "click", function (e) {
      var a = e.target.closest("a[data-b]"); if (!a) return;
      L.DomEvent.stop(e);
      var k = a.getAttribute("data-b");
      if (k === baseNow) return;
      map.removeLayer(BASES[baseNow]);
      baseNow = k; BASES[k].addTo(map); BASES[k].bringToBack();
      b.querySelectorAll("a").forEach(function (x) {
        x.classList.toggle("on", x.getAttribute("data-b") === k); });
      setQ("base", k === "map" ? "" : k);
    });
    return b;
  };
  bctl.addTo(map);

  /* ONE HOME VIEW NOW, AND IT IS THE WORLD. There used to be two, because the
     shelf was Croatian ground and opening on the world would have shown a
     stripe of green in the Adriatic and nothing else. That has stopped being
     true: the shelf stands in 95 countries, and opening on Istria would now
     hide 94 of them. A worldwide atlas that opens on one county is asking to
     be judged as a county map. */
  /* OPEN WHERE THE RECORDS ARE. This was the whole world for a while, on the
     argument that a worldwide atlas opening on one county asks to be judged as
     a county map. True, and it produced a first screen that was mostly ocean:
     the density is Europe and always will be, because that is where the parish
     registers are. Every country still carries a marker, so nowhere is hidden
     by opening here — it is one scroll out. */
  var HOME = [[35.5, -9.5], [56.5, 30.0]];
  var v = (Q.get("view") || "").split(",").map(Number);
  if (v.length === 3 && v.every(function (n) { return !isNaN(n); })) map.setView([v[0], v[1]], v[2]);
  else map.fitBounds(L.latLngBounds(HOME), { padding: [24, 24] });
  map.on("moveend", function () {
    var c = map.getCenter();
    setQ("view", c.lat.toFixed(4) + "," + c.lng.toFixed(4) + "," + map.getZoom());
  });

  /* HOVER IS NOT AN EXPLANATION ON A PHONE. Every sentence that moved into a
     tooltip is also here, in full, one button away. */
  var helpBox = document.getElementById("ra-help");
  document.getElementById("ra-info").addEventListener("click", function () {
    var open = helpBox.hidden;
    this.setAttribute("aria-expanded", String(open));
    if (!open) { helpBox.hidden = true; return; }
    var h = ['<div class="ra-help-in">'];
    h.push("<p><b>Search</b> finds a place by any name it has ever had \u2014 " +
           "Gallignana finds Gračišće — and finds a surname, and says which " +
           "records it is written in.</p>");
    h.push("<p><b>The layers</b></p><ul>");
    LAYERS.forEach(function (l) {
      var el = document.querySelector('.ra-layer[data-l="' + l[0] + '"]');
      h.push("<li>" + esc((el && el.title) || (l[1] + " — " + l[2])) + "</li>");
    });
    h.push("</ul>");
    h.push("<p><b>The years</b> — two handles, a range. Turn it on and the map " +
           "keeps only the places that can answer for any year between them, and " +
           "every panel names each polity that held the ground in that span. " +
           "A range that crosses a handover — Istria in 1880–1920 is Austria and " +
           "then Italy — is where records get lost, and that is the thing this " +
           "map is for.</p>");
    h.push("<p><b>The colours</b> say what it costs to look:</p><ul>");
    RANK.forEach(function (a) {
      h.push('<li><i class="at-dot" style="background:' + ACC[a][0] + '"></i>' +
             esc(ACC[a][1]) + "</li>");
    });
    h.push("</ul><p>A <b>hollow</b> dot means no volumes are recorded there. Any " +
           "colour it has is borrowed from a collection catalogued under it, or " +
           "under the district it sits in — so it is never a walk somebody did.</p>");
    h.push("</div>");
    helpBox.innerHTML = h.join("");
    helpBox.hidden = false;
  });

  /* START AGAIN. Seven layers, a year range, eight access filters and a search
     box is a lot of state to have got into by accident, and every one of them
     hides something. A map whose filters can be set but not unset makes the
     reader wonder whether it is broken — which, twice today, is exactly what
     happened: a year slider left on 2004 emptied it, and the only way back was
     to know which control had done it. */
  /* FULL SCREEN. The Defranceski map has had this since the beginning and this
     one never did — and it matters more here, because the panel beside the map
     is now long enough to scroll: volumes, sources, eras, national archives.
     Leaflet has to be told the size changed or it renders into the old box. */
  /* AND THE CONTROLS HAVE TO COME WITH IT. Full screen fixed `.at-wrap` —
     the map and the panel — to the viewport, and the control bar is a
     SIBLING of that element, not a child. So going full screen left the
     search box, the layer switches, the year slider and every button
     behind the overlay: David asked where the search box had gone, and the
     answer was "underneath". The `/` shortcut made it worse by focusing a
     box nobody could see.

     The bar is fixed to the top of the window and the wrap is padded down
     by however tall it turns out to be. Measured rather than assumed,
     because the bar wraps to two or three rows depending on width and a
     hard-coded offset would cover the map at one size and leave a gap at
     another. */
  var fullBtn = document.getElementById("ra-full");
  var fsBar = document.querySelector(".ra-bar");
  function fitFsBar() {
    var wrap = document.querySelector(".at-wrap");
    if (!wrap.classList.contains("ra-fs")) return;
    wrap.style.paddingTop = (fsBar.offsetHeight + 12) + "px";
  }
  function setFull(on2) {
    var wrap = document.querySelector(".at-wrap");
    wrap.classList.toggle("ra-fs", on2);
    fsBar.classList.toggle("ra-fs-bar", on2);
    document.body.classList.toggle("ra-fs-on", on2);
    if (on2) { fitFsBar(); window.addEventListener("resize", fitFsBar); }
    else { wrap.style.paddingTop = ""; window.removeEventListener("resize", fitFsBar); }
    fullBtn.title = on2 ? "Leave full screen (or press Escape)"
                        : "Full screen — the map and its panel fill the window";
    /* A WAY OUT THAT CAN BE SEEN. Escape worked from the first day and the
       button toggles, but full screen covers the page — including the button's
       own row and every other landmark — so there was nothing on screen
       saying so, and David asked how to get out. A control you have to already
       know about is not a control. */
    var esc = document.getElementById("ra-fs-esc");
    if (on2 && !esc) {
      esc = document.createElement("button");
      esc.id = "ra-fs-esc";
      esc.type = "button";
      esc.innerHTML = "\u2715 Exit full screen <span>Esc</span>";
      esc.addEventListener("click", function () { setFull(false); });
      document.body.appendChild(esc);
    } else if (!on2 && esc) {
      esc.remove();
    }
    setTimeout(function () { fitFsBar(); map.invalidateSize(); }, 60);
  }
  fullBtn.addEventListener("click", function () {
    setFull(!document.querySelector(".at-wrap").classList.contains("ra-fs"));
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") setFull(false);
  });

  document.getElementById("ra-reset").addEventListener("click", function () {
    qbox.value = "";
    yon.checked = false; year = year2 = null;
    yin.value = 1780; yin2.value = 1920;
    off = {};
    on = { shelf: true, countries: true };
    LAYERS.forEach(function (l) {
      var el = document.querySelector('.ra-layer[data-l="' + l[0] + '"]');
      if (el) {
        el.classList.toggle("on", !!on[l[0]]);
        var box = el.querySelector("input");
        if (box) box.checked = !!on[l[0]];
      }
    });
    document.querySelectorAll(".at-cat[data-cat]").forEach(function (b) {
      b.classList.add("on");
    });
    kindOn = {};
    document.querySelectorAll(".at-cat[data-kind]").forEach(function (b) {
      b.classList.remove("on");
    });
    kindSummary();
    catSummary();
    document.getElementById("ra-catsw").open = false;
    document.getElementById("ra-kindw").open = false;
    if (gmark) { map.removeLayer(gmark); gmark = null; }
    ctryLayer.clearLayers();
    communeLayer.clearLayers();
    litCC = null;
    helpBox.hidden = true;
    document.getElementById("ra-info").setAttribute("aria-expanded", "false");
    panel.hidden = true; empty.hidden = false;
    ["q", "year", "years", "off", "kind", "layers", "at", "view"].forEach(function (k) {
      setQ(k, "");
    });
    syncLayers();
    yearUI();
    apply();
    map.fitBounds(L.latLngBounds(HOME), { padding: [24, 24] });
  });

  function closeSheet() { panel.hidden = true; empty.hidden = false; }
  document.getElementById("ra-sheet-x").addEventListener("click", closeSheet);

  /* ---- A HANDLE ON THE MAP, ON PURPOSE -----------------------------------
     Everything above lives inside one closure, which is right for the page
     and wrong for testing it: the Playwright specs in test/e2e can see the
     DOM and nothing else, so «are the clusters up at this zoom» was a
     question only a human squinting at a screenshot could answer. Trying to
     answer it from outside is what surfaced the need — synthetic mouse
     events do not reach Leaflet's canvas hit-testing, and a canvas in a
     window the compositor has parked is simply never painted, so an empty
     canvas proves nothing either way.

     Read-only by intent: it hands over the Leaflet map and a few counters,
     not the setters. Nothing on the page uses it, so removing it would
     break nothing here — it exists for the test suite and for anyone who
     wants to drive this map from their own console. */
  window.recordAtlas = {
    map: map,
    version: 1,
    layers: { shelf: shelfLayer, clusters: clusterLayer, archives: archiveLayer,
              countries: countryLayer, regions: regionLayer },
    state: function () {
      var bubbles = map.hasLayer(clusterLayer), n = 0;
      clusterLayer.eachLayer(function () { n++; });
      return {
        zoom: map.getZoom(),
        clustered: bubbles,
        clusters: n,
        shelfOnMap: map.hasLayer(shelfLayer),
        shown: lastVisible.length,
        total: markers.length,
        query: qbox.value.trim(),
        splitName: qName,
        splitPlace: qPlace,
        year: year === null ? null : [year, year2]
      };
    }
  };

  document.getElementById("ra-copy").addEventListener("click", function () {
    navigator.clipboard.writeText(location.href).then(function () {
      var t = document.getElementById("ra-copied");
      t.hidden = false; setTimeout(function () { t.hidden = true; }, 1600);
    });
  });

  /* VOLUMES ARE `v`; `c` IS COLLECTIONS. This line summed the collection
     count and called the total "record volumes", so it told every visitor
     "26,699 places, 8,557 record volumes" while the atlas held 2,016,426 —
     wrong by a factor of 236, on the first line under the map. */
  document.getElementById("ra-hint").textContent =
    TOTAL_PLACES.toLocaleString() + " places, " +
    idx.places.reduce(function (a, p) { return a + (p.v || 0); }, 0).toLocaleString() +
    " record volumes. Search by any name a place has ever had — Gallignana finds Gračišće.";

  syncLayers();
  paintRegions();
  yearUI();
  var loadingEl = document.getElementById("ra-loading");
  if (loadingEl) loadingEl.remove();

  var openAt = Q.get("at");
  var opened = false;
  if (openAt) {
    var hit = idx.places.filter(function (p) { return p.i === openAt; })[0];
    if (hit) { open(hit); opened = true; }
  }

  /* ---- the quiet dots, once the map is already up -------------------------
     index.json is the one fetch the first paint waits on, and it had grown
     to 533 KB. A quarter of that was places carrying no volume and no
     collection — real ground, correctly placed, nobody has walked it. They
     belong on the map, but nothing about them is an answer to a search, so
     making the map wait for them was paying the whole latency for the least
     urgent quarter of it. They come second now: 409 KB draws the atlas,
     124 KB fills in the ground behind it.

     Everything they touch has to be topped up, not just the layer — the
     name index, so a search for one of them still resolves; the filters,
     so they obey the year and the kind boxes the visitor has already set;
     and a ?at= link that pointed at one, which found nothing a moment ago
     and can now be honoured. */
  if (idx.quiet && idx.quiet.file) {
    fetch(INDEX.replace(/[^/]*$/, idx.quiet.file))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var qp = d.places || [];
        qp.forEach(function (p) {
          var k = fold(p.n);
          if (!(k in byName)) byName[k] = p.i;
          markers.push(makeMarker(p));
        });
        idx.places = idx.places.concat(qp);
        apply(true);
        if (openAt && !opened) {
          var late = qp.filter(function (p) { return p.i === openAt; })[0];
          if (late) { open(late); opened = true; }
        }
      })
      .catch(function () { /* the atlas is still an atlas without them */ });
  }
});
</script>

<style>
  /* ---- one bar ----------------------------------------------------------
     Search, seven layers, the year and two icon buttons on a single line that
     wraps only when it has to. It replaces roughly 800px of stacked panels
     with about 100, and the map — the thing the page is for — starts near the
     top of the screen instead of below the fold. */
