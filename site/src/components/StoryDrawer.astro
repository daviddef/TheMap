---
/* THE START-WITH-YOUR-STORY DRAWER, on the home map. Option C of the options David chose (8 Nov 2026): a panel beside the map where
   someone with a story and one thing in their hand can type, paste or drop it, and watch the map draw the journey while a short plan
   builds, ending in a button that starts the research family. The behaviour is public/js/story-drawer.js; the thinking is
   public/js/story-engine.js, shared with the guided Ask on /read/ and with /looking-for/. */
import { u } from "../lib/url.js";
---
<button type="button" id="ra-story-open" class="sd-launch" hidden aria-controls="ra-story">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="currentColor"/></svg>
  Start with your story
</button>

<aside id="ra-story" class="sd" aria-label="Start with your story" hidden>
  <div class="sd-head">
    <div>
      <h2 class="sd-h">Who are you looking for?</h2>
      <p class="sd-sub">Write what you know, even a few words. Add a photo or document if you have one. The map fills in as you go.</p>
    </div>
    <button type="button" class="sd-x" aria-label="Close and go back to the map">×</button>
  </div>

  <div class="sd-drop">
    <label class="sd-lab" for="sd-text">What do you know?</label>
    <textarea id="sd-text" class="sd-text" rows="4" maxlength="8000" spellcheck="false" placeholder="My great-grandfather Ivan came from Gallignana to Hamilton around 1905. All I have is this photo."></textarea>
    <ul class="sd-shots" hidden aria-label="Pictures you added"></ul>
    <div class="sd-read" hidden>
      <p class="sd-read-why">Claude can read the names and writing on your photo and add them to your story.</p>
      <button type="button" class="sd-read-btn">Read it with Claude</button>
      <p class="sd-fine sd-read-note">Only the picture and the surnames in your story are sent, through ai.recordatlas.org, and only when you press this. Each picture uses 2 of today's free reads.</p>
    </div>
    <p class="sd-row">
      <label class="sd-add"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Add a photo or document<input type="file" class="sd-file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
      <button type="button" class="sd-eg">Try an example</button>
      <button type="button" class="sd-clear" hidden>Start again</button>
    </p>
    <p class="sd-fine">You can also drop or paste a picture here.</p>
  </div>

  <div class="sd-chips" aria-live="polite"></div>
  <p class="sd-did" aria-live="polite" hidden></p>
  <p class="sd-status" role="status" aria-live="polite"></p>

  <p class="sd-fine sd-priv">Your words stay in this browser. A picture goes to Claude only if you press "Read it with Claude". Please don't enter details of anyone who may be alive.</p>
</aside>

<section id="ra-journey" class="sd sdk sd-journey" aria-label="Play their journey" hidden>
  <div class="sdk-bar">
    <h3 class="sdk-title">Their journey</h3>
    <div class="sd-time" hidden>
      <button type="button" class="sd-play">▶ Play</button>
      <input type="range" class="sd-year" min="1800" max="1900" step="1" value="1800" aria-label="Year" />
      <output class="sd-yearout"></output>
    </div>
    <button type="button" class="sdk-more">The whole story below ↓</button>
    <button type="button" class="sdk-x" aria-label="Hide the journey">×</button>
  </div>
  <div class="sd-cap lf-capbox sdk-cap" aria-live="polite"></div>
</section>

<section id="ra-report" class="rep" aria-label="Their story" hidden>
  <header class="rep-h">
    <p class="rep-k">Their story</p>
    <h2 class="rep-title">Their journey</h2>
    <p class="rep-lede"></p>
    <div class="sd-fa" hidden>
      <label class="sd-fa-l"><span class="sd-sr">Which family research</span>
        <select class="sd-fa-line"></select></label>
      <input type="text" class="sd-fa-name" maxlength="60" aria-label="Name for the new family research" placeholder="Name it" />
      <button type="button" class="sd-fa-btn">Add this family to your research</button>
      <p class="sd-fa-out" role="status"></p>
    </div>
    <div class="rep-nav" role="navigation" aria-label="In this story">
      <button type="button" data-go="rep-places">Place by place</button>
      <button type="button" data-go="rep-life">The person, as told</button>
      <button type="button" data-go="rep-names">First names and surnames</button>
      <button type="button" data-go="rep-family">The family</button>
      <button type="button" data-go="rep-setting">What was going on</button>
      <button type="button" data-go="rep-plan">What to do first</button>
    </div>
  </header>
  <div class="rep-ask"></div>
  <section class="rep-sec" id="rep-places">
    <h2>Place by place</h2>
    <p class="rep-intro">For each place they lived: who held the ground in that year, and where to search for what happened there. The dashed line on the map joins the places in order; it is not the route they took, which only a ship's list or a permit would show.</p>
    <div class="rep-stops"></div>
  </section>
  <section class="rep-sec" id="rep-life">
    <h2>The person, as told</h2>
    <div class="sd-life"></div>
  </section>
  <section class="rep-sec" id="rep-names">
    <h2>First names and surnames</h2>
    <p class="rep-intro">A register is indexed under the clerk's spelling and language, so a name typed from the family tree misses most of it. These are the forms the Atlas holds. Leads are where to look, not findings.</p>
    <div class="sd-names"></div>
  </section>
  <section class="rep-sec" id="rep-family">
    <h2>The family</h2>
    <div class="sd-tree"></div>
  </section>
  <section class="rep-sec" id="rep-setting">
    <h2>What was going on</h2>
    <div class="sd-moments lf-moments"></div>
  </section>
  <section class="rep-sec" id="rep-plan">
    <h2>What to do first</h2>
    <section class="sd-plan" aria-label="What to do first"></section>
    <section class="sd-family" hidden>
      <p class="sd-save-p"><button type="button" class="sd-save-btn">Save this story, to add more later</button></p>
      <p class="sd-fine sd-save-out" role="status">Keeps the words you typed in My research, under My story. There you can add the next article, photo caption or paragraph, and the Atlas reads it all together.</p>
      <p class="sd-fine">Already have a tree? <a href={u("/roots/")}>Open it in Roots &amp; Routes</a> to see everyone on the map.</p>
    </section>
  </section>
</section>

<script is:inline src={u("/js/story-drawer.js")} defer></script>
<script is:inline src={u("/js/unified-search.js")} defer></script>

<style is:global>
  .sd-launch { position: absolute; z-index: 1001; top: 12px; left: 64px; display: inline-flex; gap: 8px; align-items: center; padding: 10px 16px; border: 0; border-radius: 999px;
    background: var(--accent); color: #fff; font: 600 15px/1 var(--sans); cursor: pointer; box-shadow: 0 4px 16px rgba(0,0,0,.18); transition: transform .2s, background .2s; }
  .sd-launch:hover { background: var(--accent-2); transform: translateY(-1px); }
  .sd-launch[hidden], .sd[hidden] { display: none; }
  .sd { position: absolute; z-index: 1001; top: 10px; left: 64px; width: min(380px, calc(100% - 80px)); max-height: calc(100% - 54px - var(--sdk-h, 0px)); overflow-y: auto; overscroll-behavior: contain;
    background: var(--panel); border: 1px solid var(--rule); border-radius: 16px; padding: 16px 16px 12px; box-shadow: 0 12px 40px rgba(0,0,0,.22);
    opacity: 0; transform: translateX(-18px) scale(.98); transform-origin: left top; transition: opacity .28s ease, transform .28s ease; font-family: var(--sans); color: var(--ink); }
  .sd.is-open { opacity: 1; transform: none; }
  .sd-head { display: flex; gap: 10px; justify-content: space-between; align-items: flex-start; }
  .sd-h { font: 500 22px/1.2 var(--serif); margin: 0 0 4px; }
  .sd-sub { font-size: 14px; line-height: 1.45; color: var(--ink-2); margin: 0 0 12px; }
  .sd-x { flex: none; width: 32px; height: 32px; border-radius: 50%; border: 0; background: var(--panel-2); color: var(--ink); font-size: 20px; line-height: 1; cursor: pointer; }
  .sd-x:hover { background: var(--rule); }
  .sd-drop { border: 2px dashed var(--rule-strong); border-radius: 14px; padding: 10px 12px 8px; background: var(--ground); transition: border-color .2s, background .2s; }
  .sd-drop.hot { border-color: var(--accent); background: var(--accent-wash); }
  .sd-lab { display: block; font: 600 12px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: 2px 0 8px; }
  .sd-text { width: 100%; box-sizing: border-box; border: 0; background: transparent; font: 400 16px/1.5 var(--sans); color: var(--ink); resize: vertical; min-height: 84px; outline: none; }
  .sd-text::placeholder { color: var(--ink-3); }
  .sd-read { margin: 6px 0 8px; display: grid; gap: 6px; justify-items: start; } .sd-read[hidden], .sd-clear[hidden] { display: none; }
  .sd-read-why { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--ink); }
  .sd-read-btn { font: 600 13px/1 var(--sans); padding: 9px 14px; border: 1px solid var(--accent); border-radius: 999px; background: var(--accent); color: #fff; cursor: pointer; } .sd-read-btn:disabled { opacity: .6; cursor: default; }
  .sd-shots { display: flex; gap: 8px; flex-wrap: wrap; margin: 6px 0; padding: 0; list-style: none; }
  .sd-shot { position: relative; display: inline-block; }
  .sd-shot img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid var(--rule-strong); display: block; animation: sd-pop .4s cubic-bezier(.3,1.5,.5,1); }
  .sd-shot button { position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; border-radius: 50%; border: 0; background: var(--ink); color: var(--ground); font-size: 13px; line-height: 1; cursor: pointer; }
  .sd-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 4px 0; }
  .sd-add, .sd-eg, .sd-clear { font: 500 13px/1 var(--sans); padding: 8px 12px; border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
  .sd-add:hover, .sd-eg:hover, .sd-clear:hover { background: var(--accent-wash); border-color: var(--accent); }
  .sd-clear { border-color: transparent; color: var(--ink-2); background: none; }
  .sd-fine { font-size: 12.5px; line-height: 1.45; color: var(--ink-2); margin: 4px 0; }
  .sd-fine a { color: var(--accent); }
  .sd-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 2px; min-height: 4px; }
  .sd-chip { font: 500 13px/1 var(--sans); padding: 7px 11px; border-radius: 999px; background: var(--accent-wash); color: var(--accent); border: 1px solid transparent; }
  .sd-chip.from { background: color-mix(in srgb, var(--terra) 14%, var(--panel)); color: var(--terra); }
  .sd-chip.warn { background: color-mix(in srgb, var(--ochre) 16%, var(--panel)); color: var(--ochre); }
  button.sd-chip { cursor: pointer; } button.sd-chip:hover { border-color: currentColor; }
  .sd-chip.pop { animation: sd-pop .4s cubic-bezier(.3,1.5,.5,1); }
  @keyframes sd-pop { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
  .sd-status { font-size: 13px; color: var(--ink-2); min-height: 1em; margin: 2px 0; }
  .sd-h3 { font: 500 18px/1.2 var(--serif); margin: 14px 0 6px; }
  .sd-journey { animation: sd-rise .5s ease both; }
  .sd-time { display: flex; gap: 10px; align-items: center; margin: 4px 0 6px; }
  .sd-time[hidden], .sd-play[hidden] { display: none; }
  .sd-play { flex: none; font: 600 13px/1 var(--sans); padding: 8px 12px; border-radius: 8px; border: 1px solid var(--accent); background: var(--panel); color: var(--accent); cursor: pointer; }
  .sd-year { flex: 1; min-width: 0; accent-color: var(--accent); }
  .sd-yearout { font: 600 18px/1 var(--serif); min-width: 2.6em; text-align: right; }
  :is(.sd, .rep) .lf-capbox { display: grid; gap: 6px; }
  :is(.sd, .rep) .lf-capline { font-size: 14px; line-height: 1.4; padding: 8px 10px; border-left: 3px solid var(--accent); background: var(--ground); border-radius: 0 8px 8px 0; }
  :is(.sd, .rep) .lf-filed { color: var(--ink-2); font-size: 12.5px; margin-top: 2px; } :is(.sd, .rep) .lf-regime { color: var(--ink-2); }
  .sd-more { margin: 6px 0; font-size: 14px; } .sd-more summary { cursor: pointer; color: var(--accent); }
  :is(.sd, .rep) .lf-moments ul { margin: 6px 0; padding-left: 18px; } :is(.sd, .rep) .lf-moments .cap { font-size: 12px; color: var(--ink-2); }
  :is(.sd, .rep) .lf-capline { position: relative; }
  :is(.sd, .rep) .lf-flag { float: right; width: 36px; height: 24px; margin: 0 0 4px 10px; object-fit: cover; border: 1px solid var(--rule); border-radius: 3px; background: var(--panel); }
  :is(.sd, .rep) .lf-leader { font-style: italic; }
  :is(.sd, .rep) .lf-now { margin-top: 5px; padding: 4px 8px; border-radius: 6px; background: var(--accent-wash); font-size: 13px; line-height: 1.35; }
  :is(.sd, .rep) .lf-now-epidemic, :is(.sd, .rep) .lf-ev-epidemic .lf-tag { --tagc: #8a3b6e; } :is(.sd, .rep) .lf-now-famine, :is(.sd, .rep) .lf-ev-famine .lf-tag { --tagc: #a8741a; }
  :is(.sd, .rep) .lf-now-war, :is(.sd, .rep) .lf-ev-war .lf-tag { --tagc: #b3452e; } :is(.sd, .rep) .lf-now-genocide, :is(.sd, .rep) .lf-ev-genocide .lf-tag, :is(.sd, .rep) .lf-ev-massacre .lf-tag, :is(.sd, .rep) .lf-ev-atrocity .lf-tag { --tagc: #7a1f1f; } :is(.sd, .rep) .lf-ev-displacement .lf-tag { --tagc: #1f5c6b; }
  :is(.sd, .rep) .lf-now { border-left: 3px solid var(--tagc, var(--accent)); }
  :is(.sd, .rep) .lf-tag { display: inline-block; padding: 1px 7px; border-radius: 999px; background: var(--tagc, var(--accent)); color: #fff; font: 600 11px/1.5 var(--sans); letter-spacing: .02em; }
  :is(.sd, .rep) .lf-events { list-style: none; padding-left: 0 !important; display: grid; gap: 8px; }
  :is(.sd, .rep) .lf-ev { padding: 6px 10px; border-left: 3px solid var(--tagc, var(--accent)); background: var(--ground); border-radius: 0 8px 8px 0; font-size: 13px; line-height: 1.4; }
  :is(.sd, .rep) .lf-moments h4, :is(.sd, .rep) .lf-names h4 { display: block; font: 600 11.5px/1 var(--sans); letter-spacing: .09em; text-transform: uppercase; color: var(--accent); margin: 14px 0 6px; }
  :is(.sd, .rep) .lf-forms { margin: 0 0 6px; padding-left: 18px; font-size: 13px; line-height: 1.5; } :is(.sd, .rep) .lf-forms li { margin: 0 0 4px; }
  :is(.sd, .rep) .lf-names .cap { color: var(--ink-2); font-size: 12.5px; }
  :is(.sd, .rep) .lf-askyear[hidden], .sg .lf-askyear[hidden] { display: none; }
  .sd.is-compact .sd-sub, .sd.is-compact .sd-priv, .sd.is-compact .sd-drop > .sd-fine { display: none; }
  .sd.is-compact .sd-text { height: 4.4em; min-height: 0; }
  :is(.sd, .rep) .lf-askyear { margin: 6px 0; padding: 8px 10px; border: 1px dashed var(--accent); border-radius: 10px; font-size: 13px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  :is(.sd, .rep) .lf-askyear input { width: 5.5em; font: inherit; padding: 5px 7px; border-radius: 6px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); }
  :is(.sd, .rep) .lf-askyear button { font: 600 13px/1 var(--sans); padding: 7px 10px; border-radius: 8px; border: 0; background: var(--accent); color: #fff; cursor: pointer; }
  :is(.sd, .rep) .lf-person { margin: 0 0 6px; border: 1px solid var(--rule); border-radius: 10px; padding: 4px 10px; background: var(--ground); } :is(.sd, .rep) .lf-person summary { cursor: pointer; font-size: 14px; }
  :is(.sd, .rep) .lf-tree { display: grid; justify-items: center; margin: 6px 0; } :is(.sd, .rep) .lf-gen { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  :is(.sd, .rep) .lf-tie { width: 2px; height: 16px; background: var(--rule-strong); }
  :is(.sd, .rep) .lf-card { min-width: 8.5rem; max-width: 14rem; padding: 8px 10px; border: 1px solid var(--rule-strong); border-radius: 10px; background: var(--panel); text-align: center; }
  :is(.sd, .rep) .lf-card-self { border-color: var(--accent); background: var(--accent-wash); } :is(.sd, .rep) .lf-card-you { border-style: dashed; }
  :is(.sd, .rep) .lf-card-role { font: 600 10px/1 var(--sans); letter-spacing: .09em; text-transform: uppercase; color: var(--accent); margin-bottom: 3px; }
  :is(.sd, .rep) .lf-card-name { font: 500 15px/1.25 var(--serif); } :is(.sd, .rep) .lf-card-place, :is(.sd, .rep) .lf-card-forms { font-size: 12px; color: var(--ink-2); margin-top: 2px; }
  /* the play bar along the bottom of the map: controls and one line of caption; everything else is in the story below */
  .sd.sdk { top: auto; left: 148px; right: 16px; bottom: 26px; width: auto; max-height: none; overflow: hidden; padding: 0; display: flex; flex-direction: column; transform: translateY(14px); transform-origin: bottom; }
  .sd.sdk.is-open { transform: none; }
  .sd.sdk[hidden] { display: none; } /* .sd.sdk sets display:flex, which would otherwise show the empty bar on every home page load */
  .sdk-bar { display: flex; gap: 14px; align-items: center; padding: 8px 12px 6px 16px; }
  .sdk-title { flex: none; max-width: 14em; margin: 0; font: 500 17px/1.2 var(--serif); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sdk .sd-time { flex: 1; min-width: 0; margin: 0; }
  .sdk-more { flex: none; font: 600 13px/1 var(--sans); padding: 8px 12px; border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--accent); cursor: pointer; margin-left: auto; }
  .sdk-more:hover { background: var(--accent-wash); border-color: var(--accent); }
  .sdk-x { flex: none; width: 30px; height: 30px; border-radius: 50%; border: 0; background: var(--panel-2); color: var(--ink); font-size: 19px; line-height: 1; cursor: pointer; }
  .sdk-x:hover { background: var(--rule); }
  .sdk .sdk-cap { display: block; padding: 0 16px 10px; max-height: 5.4em; overflow: hidden; }
  .sdk .sdk-cap:empty { display: none; }
  .sdk .lf-capline { padding: 4px 10px; font-size: 13.5px; } .sdk .lf-capline:not(:first-child) { display: none; }
  .sdk .lf-capline .lf-filed, .sdk .lf-capline .lf-now, .sdk .lf-capline .lf-leader { display: none; }
  .sdk .lf-flag { width: 27px; height: 18px; margin: 0 0 0 8px; }
  @media (max-width: 899px) { .sd.sdk { left: 8px; right: 8px; bottom: 8px; } #ra-map.has-dock .ra-time { display: none; } .sdk-title { display: none; } #ra-map.has-dock .sd-launch { bottom: 128px; } .sdk-more { font-size: 12px; padding: 7px 9px; } }

  /* the story below the map */
  .rep { margin: 30px 0 48px; font-family: var(--sans); color: var(--ink); }
  .rep[hidden], .rep-sec[hidden] { display: none; }
  .rep-h { padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
  .rep-k { font: 600 12px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin: 0 0 10px; }
  .rep-title { font: 500 clamp(28px, 4.2vw, 42px)/1.1 var(--serif); margin: 0 0 10px; text-wrap: balance; }
  .rep-lede { font-size: 17px; line-height: 1.55; color: var(--ink-2); max-width: 66ch; margin: 0; }
  .rep-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .rep-nav button { font: 500 13.5px/1 var(--sans); padding: 9px 14px; border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); cursor: pointer; }
  .rep-nav button:hover { background: var(--accent-wash); border-color: var(--accent); color: var(--accent); } .rep-nav button[hidden] { display: none; }
  .rep-ask:empty { display: none; } .rep-ask { margin-top: 16px; }
  .rep-sec { margin-top: 36px; scroll-margin-top: 70px; }
  .rep-sec > h2 { font: 500 clamp(22px, 3vw, 30px)/1.2 var(--serif); margin: 0 0 8px; }
  .rep-intro { font-size: 15px; line-height: 1.55; color: var(--ink-2); max-width: 70ch; margin: 0 0 16px; }
  .lf-stops { display: grid; gap: 16px; }
  .lf-stop { background: var(--panel); border: 1px solid var(--rule); border-radius: 16px; padding: 18px 20px 14px; }
  .lf-stop-h { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 12px; }
  .lf-stop-n { flex: none; display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff; font: 600 15px/1 var(--sans); }
  .lf-stop-k { font: 600 11.5px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
  .lf-stop h3 { font: 500 26px/1.15 var(--serif); margin: 0; }
  .lf-stop-s { font-size: 14px; color: var(--ink-2); margin-top: 3px; }
  .lf-stop-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 12px 28px; }
  .lf-stop-grid > * { min-width: 0; }
  .lf-full { margin-top: 14px; }
  .lf-full-btn { display: flex; flex-direction: column; gap: 2px; width: 100%; text-align: left; padding: 12px 14px; border: 1px solid var(--accent); border-radius: 10px; background: var(--panel); color: var(--ink); font: inherit; cursor: pointer; }
