---
/* THE START-WITH-YOUR-STORY DRAWER, on the home map. Option C of the options David chose (8 Nov 2026): a panel beside the map where
   someone with a story and one thing in their hand can type, paste or drop it, and watch the map draw the journey while a short plan
   builds, ending in a button that starts the research family. The behaviour is public/js/story-drawer.js; the thinking is
   public/js/story-engine.js, shared with the guided Ask on /read/ and with /looking-for/. */
import { u } from "../lib/url.js";
---
<button type="button" id="ra-story-open" class="sd-launch" hidden aria-controls="ra-story">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="currentColor"/></svg>
  Start with your story
</button>

<aside id="ra-story" class="sd" aria-label="Start with your story" hidden>
  <div class="sd-head">
    <div>
      <h2 class="sd-h">Who are you looking for?</h2>
      <p class="sd-sub">Tell us in your own words, or drop a photo or document. We'll find them on the map.</p>
    </div>
    <button type="button" class="sd-x" aria-label="Close and go back to the map">×</button>
  </div>

  <div class="sd-drop">
    <label class="sd-lab" for="sd-text">What do you know?</label>
    <textarea id="sd-text" class="sd-text" rows="4" maxlength="2000" spellcheck="false" placeholder="My great-grandfather Ivan came from Gallignana to Hamilton around 1905. All I have is this photo."></textarea>
    <ul class="sd-shots" hidden aria-label="Pictures you added"></ul>
    <p class="sd-row">
      <label class="sd-add"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Add a photo or document<input type="file" class="sd-file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
      <button type="button" class="sd-eg">Try an example</button>
      <button type="button" class="sd-clear">Start again</button>
    </p>
    <p class="sd-fine">or drag a picture onto this box, or paste one. It stays in this tab.</p>
  </div>

  <div class="sd-chips" aria-live="polite"></div>
  <p class="sd-status" role="status" aria-live="polite"></p>

  <section class="sd-journey" hidden aria-label="Their journey">
    <h3 class="sd-h3">Their journey</h3>
    <div class="sd-time" hidden>
      <button type="button" class="sd-play">▶ Play</button>
      <input type="range" class="sd-year" min="1800" max="1900" step="1" value="1800" aria-label="Year" />
      <output class="sd-yearout"></output>
    </div>
    <div class="sd-cap lf-capbox"></div>
    <details class="sd-more"><summary>What changed around then</summary><div class="sd-moments lf-moments"></div></details>
    <p class="sd-fine">The dashed line joins the places in date order. It is not the route they took.</p>
  </section>

  <section class="sd-plan" hidden aria-label="What to do first"></section>

  <section class="sd-family" hidden>
    <p class="sd-fam-h">Ready to begin?</p>
    <p class="sd-fine">Starting a research family adds the registers and sources above as planned, so you can mark them off as you go.</p>
    <p><button type="button" class="sd-fam-btn">Start the research family</button></p>
    <p class="sd-fam-out" role="status"></p>
    <p class="sd-fine">Already have a tree? <a href={u("/roots/")}>Open it in Roots &amp; Routes</a> to see everyone on the map.</p>
  </section>

  <p class="sd-fine sd-priv">Nothing you type or drop is sent anywhere. Please don't enter details of anyone who may be alive.
    To read writing on a photo with Claude, open <a href={u("/read/#ask")}>Reading the record</a>.</p>
</aside>

<script is:inline src={u("/js/story-drawer.js")} defer></script>

<style is:global>
  .sd-launch { position: absolute; z-index: 1001; top: 12px; left: 64px; display: inline-flex; gap: 8px; align-items: center; padding: 10px 16px; border: 0; border-radius: 999px;
    background: var(--accent); color: #fff; font: 600 15px/1 var(--sans); cursor: pointer; box-shadow: 0 4px 16px rgba(0,0,0,.18); transition: transform .2s, background .2s; }
  .sd-launch:hover { background: var(--accent-2); transform: translateY(-1px); }
  .sd-launch[hidden], .sd[hidden] { display: none; }
  .sd { position: absolute; z-index: 1001; top: 10px; left: 64px; bottom: 44px; width: min(380px, calc(100% - 80px)); overflow-y: auto; overscroll-behavior: contain;
    background: var(--panel); border: 1px solid var(--rule); border-radius: 16px; padding: 16px 16px 12px; box-shadow: 0 12px 40px rgba(0,0,0,.22);
    opacity: 0; transform: translateX(-18px) scale(.98); transform-origin: left top; transition: opacity .28s ease, transform .28s ease; font-family: var(--sans); color: var(--ink); }
  .sd.is-open { opacity: 1; transform: none; }
  .sd-head { display: flex; gap: 10px; justify-content: space-between; align-items: flex-start; }
  .sd-h { font: 500 22px/1.2 var(--serif); margin: 0 0 4px; }
  .sd-sub { font-size: 14px; line-height: 1.45; color: var(--ink-2); margin: 0 0 12px; }
  .sd-x { flex: none; width: 32px; height: 32px; border-radius: 50%; border: 0; background: var(--panel-2); color: var(--ink); font-size: 20px; line-height: 1; cursor: pointer; }
  .sd-x:hover { background: var(--rule); }
  .sd-drop { border: 2px dashed var(--rule-strong); border-radius: 14px; padding: 10px 12px 8px; background: var(--ground); transition: border-color .2s, background .2s; }
  .sd-drop.hot { border-color: var(--accent); background: var(--accent-wash); }
  .sd-lab { display: block; font: 600 12px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin: 2px 0 8px; }
  .sd-text { width: 100%; box-sizing: border-box; border: 0; background: transparent; font: 400 16px/1.5 var(--sans); color: var(--ink); resize: vertical; min-height: 84px; outline: none; }
  .sd-text::placeholder { color: var(--ink-3); }
  .sd-shots { display: flex; gap: 8px; flex-wrap: wrap; margin: 6px 0; padding: 0; list-style: none; }
  .sd-shot { position: relative; display: inline-block; }
  .sd-shot img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid var(--rule-strong); display: block; animation: sd-pop .4s cubic-bezier(.3,1.5,.5,1); }
  .sd-shot button { position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; border-radius: 50%; border: 0; background: var(--ink); color: var(--ground); font-size: 13px; line-height: 1; cursor: pointer; }
  .sd-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 4px 0; }
  .sd-add, .sd-eg, .sd-clear { font: 500 13px/1 var(--sans); padding: 8px 12px; border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
  .sd-add:hover, .sd-eg:hover, .sd-clear:hover { background: var(--accent-wash); border-color: var(--accent); }
  .sd-clear { border-color: transparent; color: var(--ink-2); background: none; }
  .sd-fine { font-size: 12.5px; line-height: 1.45; color: var(--ink-2); margin: 4px 0; }
  .sd-fine a { color: var(--accent); }
  .sd-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 2px; min-height: 4px; }
  .sd-chip { font: 500 13px/1 var(--sans); padding: 7px 11px; border-radius: 999px; background: var(--accent-wash); color: var(--accent); border: 1px solid transparent; }
  .sd-chip.from { background: color-mix(in srgb, var(--terra) 14%, var(--panel)); color: var(--terra); }
  .sd-chip.warn { background: color-mix(in srgb, var(--ochre) 16%, var(--panel)); color: var(--ochre); }
  button.sd-chip { cursor: pointer; } button.sd-chip:hover { border-color: currentColor; }
  .sd-chip.pop { animation: sd-pop .4s cubic-bezier(.3,1.5,.5,1); }
  @keyframes sd-pop { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
  .sd-status { font-size: 13px; color: var(--ink-2); min-height: 1em; margin: 2px 0; }
  .sd-h3 { font: 500 18px/1.2 var(--serif); margin: 14px 0 6px; }
  .sd-journey { animation: sd-rise .5s ease both; }
  .sd-time { display: flex; gap: 10px; align-items: center; margin: 4px 0 6px; }
  .sd-time[hidden], .sd-play[hidden] { display: none; }
  .sd-play { flex: none; font: 600 13px/1 var(--sans); padding: 8px 12px; border-radius: 8px; border: 1px solid var(--accent); background: var(--panel); color: var(--accent); cursor: pointer; }
  .sd-year { flex: 1; min-width: 0; accent-color: var(--accent); }
  .sd-yearout { font: 600 18px/1 var(--serif); min-width: 2.6em; text-align: right; }
  .sd .lf-capbox { display: grid; gap: 6px; }
  .sd .lf-capline { font-size: 14px; line-height: 1.4; padding: 8px 10px; border-left: 3px solid var(--accent); background: var(--ground); border-radius: 0 8px 8px 0; }
  .sd .lf-filed { color: var(--ink-2); font-size: 12.5px; margin-top: 2px; } .sd .lf-regime { color: var(--ink-2); }
  .sd-more { margin: 6px 0; font-size: 14px; } .sd-more summary { cursor: pointer; color: var(--accent); }
  .sd .lf-moments h4 { display: none; } .sd .lf-moments ul { margin: 6px 0; padding-left: 18px; } .sd .lf-moments .cap { font-size: 12px; color: var(--ink-2); }
  .sd-plan { margin-top: 12px; display: grid; gap: 6px; }
  .sd-step { background: var(--ground); border: 1px solid var(--rule); border-radius: 10px; animation: sd-rise .45s ease both; }
  .sd-step summary { list-style: none; display: flex; gap: 10px; align-items: center; padding: 9px 12px; cursor: pointer; font: 500 15px/1.3 var(--sans); }
  .sd-step summary::-webkit-details-marker { display: none; }
  .sd-step[open] { background: var(--panel); border-color: var(--accent); }
  .sd-num { flex: none; display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--accent); color: #fff; font: 600 12px/1 var(--sans); }
  .sd-step > *:not(summary) { margin: 0 12px 8px 46px; font-size: 14px; line-height: 1.45; }
  .sd-step ul { padding-left: 16px; } .sd-why { color: var(--ink-2); }
  .sd-ask b { color: var(--accent); } .sd-not b { color: var(--brick); }
  @keyframes sd-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .sd-family { margin-top: 14px; padding: 14px; border-radius: 12px; background: var(--accent-wash); animation: sd-rise .5s ease both; }
  .sd-fam-h { font: 500 18px/1.2 var(--serif); margin: 0 0 4px; }
  .sd-fam-btn { width: 100%; font: 600 15px/1 var(--sans); padding: 14px 16px; border: 0; border-radius: 10px; background: var(--accent); color: #fff; cursor: pointer; transition: background .2s, transform .15s; }
  .sd-fam-btn:hover { background: var(--accent-2); } .sd-fam-btn:active { transform: scale(.98); }
  .sd-fam-out { font-size: 13px; margin: 6px 0 2px; } .sd-fam-out a { color: var(--accent); }
  .sd-priv { margin-top: 12px; }
  .sd button:focus-visible, .sd-launch:focus-visible, .sd summary:focus-visible, .sd-text:focus-visible { outline: 3px solid var(--accent-2); outline-offset: 2px; }
  @media (max-width: 899px) {
    .sd-launch { left: 8px; top: auto; bottom: 52px; }
    .sd { left: 8px; right: 8px; width: auto; top: auto; bottom: 44px; max-height: 62%; }
  }
  @media (prefers-reduced-motion: reduce) { .sd, .sd-chip.pop, .sd-step, .sd-journey, .sd-family, .sd-shot img { animation: none; transition: none; } }
</style>
