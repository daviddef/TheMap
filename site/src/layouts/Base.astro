---
/* Fixed when the page is generated, not read in the browser:
   a date computed client-side would say «today» forever. */
const built = new Date().toISOString().slice(0, 10);
import { u } from "../lib/url.js";
import { flagHref } from "../lib/flags.js";
import { LANGS } from "../lib/i18n.js";
/* Small flags for the language links: 3:2, drawn inline so they cost no request.
   English is the Union Jack, the one most readers expect beside "English". */
const FLAG = {
  en: '<svg class="ra-flag" width="16" height="11" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="40" fill="#012169"/><path d="M0 0 60 40M60 0 0 40" stroke="#fff" stroke-width="8"/><path d="M0 0 60 40M60 0 0 40" stroke="#C8102E" stroke-width="3"/><path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="13"/><path d="M30 0v40M0 20h60" stroke="#C8102E" stroke-width="8"/></svg>',
  hr: '<svg class="ra-flag" width="16" height="11" viewBox="0 0 60 40" aria-hidden="true"><rect width="60" height="13.4" fill="#FF0000"/><rect y="13.3" width="60" height="13.4" fill="#fff"/><rect y="26.6" width="60" height="13.4" fill="#171796"/><path d="M25 12h10v11c0 4-5 6-5 6s-5-2-5-6z" fill="#fff" stroke="#FF0000" stroke-width="1.6"/><path d="M25 17h10M30 12v17" stroke="#FF0000" stroke-width="0"/><path d="M25 12h5v5h-5zM30 17h5v5h-5zM25 22h5v4c0 1 0 1-1 2l-4-3z" fill="#FF0000"/></svg>',
  it: '<svg class="ra-flag" width="16" height="11" viewBox="0 0 60 40" aria-hidden="true"><rect width="20" height="40" fill="#009246"/><rect x="20" width="20" height="40" fill="#fff"/><rect x="40" width="20" height="40" fill="#CE2B37"/></svg>',
};
import site from "../data/site.json";
import "../styles/kit.css"; // the friendly style (cards, pills, step lists), for every page
/* Counted, not typed. This line is on all 6,000 pages and it is a licence
   attribution — the one kind of number that must not quietly go stale. */
import osm from "../../public/archives-osm.json";

const { title, dek, eyebrow, bare, jsonld, og = "default", wide, flag } = Astro.props;
/* GROUPED, BECAUSE THE STYLESHEET ONLY EVER STYLED GROUPS. styles.css came
   across whole from the family archive and it carries a complete navigation
   design: dropdown groups, a menu button, a drawer. This file rendered eleven
   bare links instead, and the sheet has no rule for a bare link in the bar —
   so `header.site nav.topnav` won on specificity, the eleven ran together at
   its 1px gap, and below 1180px its display:none!important hid them behind a
   menu button that did not exist. Eleven top-level links was too many anyway. */
import { nav, footLinks } from "../lib/nav.js";
import whatsNewData from "../data/whats-new.json";
const newestNews = (whatsNewData.entries || []).map((e) => e.date).sort().pop() || "";
const here = Astro.url.pathname;

/* WHICH PAGES MAY CARRY AN AD, AND WHY MOST MAY NOT.
 *
 * AdSense refused recordatlas.org on 6 October for «Google-served ads on
 * screens without publisher content» and «low-value content». Measured, the
 * pages are not thin — a place page carries a median 14,513 characters of
 * visible text and a surname page 10,698, and NONE is under 2,000. Adding
 * words would have been effort spent arguing with the wrong diagnosis.
 *
 * The real figure is this: Senj and Rovinj, two different towns, are about
 * 96% identical character for character. They are one template with a little
 * data swapped, and the ad snippet lived in this layout, so all 65,177 pages
 * carried it. Google's test is «substantial unique value», which a 96%
 * identical long tail fails however long each page is.
 *
 * So the generated tail stops carrying ads and the written pages keep them.
 * The list below is pages somebody composed — prose, decisions, explanations
 * — rather than pages a loop produced. That is roughly a hundred pages
 * instead of sixty-five thousand, and it is the honest answer to the policy
 * rather than a way around it: these are the screens that actually have
 * publisher content on them.
 *
 * `/` is matched exactly. Everything else matches as a prefix, so /country/
 * covers its children while /place/ and /surname/ are simply absent.
 */
const AD_PAGES = ["/about/", "/help/", "/data/", "/coverage/", "/countries/",
                  "/country/", "/changelog/", "/worklist/", "/jurisdictions/",
                  "/add/", "/my-research/", "/flags/", "/errands/"];
const adsHere = here === "/" || AD_PAGES.some((p) => here.startsWith(p));
/* The three page kinds that carry ProgressKit, which is what the RESEARCHING
   control acts on. Everywhere else it is furniture. */
const marksHere = here === u("/") || here === "/"
  || here.startsWith(u("/place/")) || here.startsWith(u("/my-research/"));
/* Strip the query string: /?q=Breslau and / are the same page. */
const canon = new URL(here, Astro.site || "https://daviddef.github.io").href;
import LineSwitcher from "../components/LineSwitcher.astro";
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<script is:inline>try{var t=localStorage.getItem("ra-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`}</title>
<meta name="description" content={dek || site.tagline} />
<meta property="og:title" content={title} />
<meta property="og:description" content={dek || site.tagline} />
<meta property="og:type" content="website" />
{/* One canonical address per page. With 1,304 pages and a map whose every
    view is a query string, a crawler will otherwise find the same page under
    a dozen addresses and split its credit between them. */}
<link rel="canonical" href={canon} />
{/* A FEED READER CAN NOW SUBSCRIBE TO THIS ATLAS. The changelog page has
    existed for a while with no way to be told about it, which is no good
    for the society editors and archivists this most needs to reach — they
    read feeds, they do not revisit a page on the chance it moved. One
    entry per day rather than per commit, because a day here is routinely
    fifteen commits and fifteen notifications is how a feed gets dropped. */}
<link rel="alternate" type="application/atom+xml" title="Record Atlas — what changed"
      href={u("/feed.xml")} />
<meta property="og:url" content={canon} />
<meta property="og:site_name" content={site.name} />
{/* A shared link with no og:image renders as a blank grey rectangle. One card
    per page TYPE, not per page — 5,924 images would be a gigabyte of pictures
    nobody looks at twice, and the type is what actually differs. */}
<meta property="og:image" content={new URL(u(`/og/${og}.png`), Astro.site || "https://daviddef.github.io").href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
{/* Structured data. 5,924 pages emitted none, which is the cheapest remaining
    thing a search engine could be told: that /place/gracisce/ is a PLACE with
    coordinates, that /archive/dapa/ is an ARCHIVE, and that the whole thing is
    a dataset with a licence. */}
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
{/* The house mark. Every sibling archive has one and this had none, so a tab
    for Record Atlas sat among them showing a browser's grey placeholder. SVG
    first because it stays sharp at every size a tab strip, a bookmark bar or a
    phone home screen asks for; the OG cards already cover the social preview. */}
<link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
{/* PNG alongside it, because an SVG is not enough on its own. Safari ignores
    an SVG apple-touch-icon entirely, and a bookmark or a home screen falls
    back to a grey square — which is what "no icon" looked like. */}
<link rel="icon" href={u("/favicon-32.png")} sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} sizes="180x180" />
<meta name="theme-color" content="#1F5C6B" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Source+Sans+3:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css")} />
{/* GoatCounter, as on every sibling archive. No cookies and no personal
    data, so it needs no consent gate of its own — which is also why it is
    not inside the AdSense consent flow. is:inline because the src is a
    protocol-relative CDN path Astro would otherwise try to bundle, the same
    trap that stopped the ad loader reaching the page.
    Nothing renders at all when no code is configured. */}
{site.analytics?.goatcounter && (
  <script is:inline async src="//gc.zgo.at/count.js"
          data-goatcounter={`https://${site.analytics.goatcounter}.goatcounter.com/count`}></script>
)}
{/* THE STYLES LIVE HERE NOW, AND THE REASON MATTERS. They sat below the
    closing html tag, where the parser reparents stray content and Astro never
    collected them — so the whole block was dropped from the built CSS and the
    nav shipped unstyled. Two other explanations were tried first and both were
    wrong. A style element belongs in the head; anywhere else is luck. */}
<style is:global>
  /* ONLY WHAT styles.css DOES NOT ALREADY DEFINE. It owns header.site,
     .sitein, .brand, .pagehead, .topnav, .burger and .drawer — every one of
     those was duplicated here and lost, because `header.site nav.topnav`
     outranks a bare `.topnav`. A layout should not restate its stylesheet. */
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 12px; top: 12px; z-index: 999; background: var(--panel);
                padding: 10px 14px; border: 1px solid var(--accent); }
  .foot-when { color: var(--ink-3); }
  footer.site-foot { margin-top: 60px; padding: 26px 0 40px;
                     border-top: 1px solid var(--rule); background: var(--panel); }
  .foot-note { font-family: var(--sans); font-size: 12.5px; line-height: 1.6;
               color: var(--ink-3); max-width:var(--measure); margin: 0 0 8px; }
  .foot-thin { font-size: 11.5px; }

  /* ---- THE FOOTER, HALVED ---------------------------------------------
     It was five stacked blocks and half of them repeated the About menu —
     About, Use the data and Add a source all sit in the navigation above.
     Those rows are gone, Privacy moved up into that menu, and Feed rides the
     language line.

     THE ATTRIBUTION BLOCK COULD NOT MOVE, and the reason is worth keeping.
     GeoNames, Statbel, Istat, the National Records of Scotland,
     OpenStreetMap, Townlands.ie, Wiktionary and Trove are CC BY or equivalent:
     attribution is a CONDITION of the licence, owed on the pages that use the
     data, not a courtesy that can be filed away on /data/. check-built.py
     fails the build if any of those names leaves the home or place pages —
     so moving it would not have tidied the footer, it would have broken the
     licence and then the build. The only saving available on it was
     horizontal: it drops the 80ch reading measure and spans the wrap, which
     takes it from five lines to two on a wide screen. */
  .foot-cred { max-width: none; font-size: 11.5px; line-height: 1.7; }
  .foot-cred summary { cursor: pointer; list-style: none; color: var(--ink-2); }
  .foot-cred summary::-webkit-details-marker { display: none; }
  .foot-cred summary::after { content: " \25BE"; opacity: .7; }
  .foot-cred[open] summary::after { content: " \25B4"; }
  .foot-cred[open] summary { margin-bottom: 6px; }
  .foot-sep { margin: 0 4px 0 10px; color: var(--ink-3); }
    /* NOT A FLEX CONTAINER. It was, and the ins element inside it is a
     block-level flex child with no intrinsic width, so it measured zero and
     AdSense rejected the slot outright: "No slot size for availableWidth=0".
     The loader was arriving and being turned away at the door. A responsive
     unit needs a real width to size itself against. */
  /* NO :global() HERE. This block is <style is:global>, where :global() is
     not a selector function but literal text — the browser parses it as an
     unknown pseudo-class and drops the whole rule, silently. The class was
     on the body and the rule was nowhere, which is why the page stayed
     1080px wide while everything said it should not. */
  /* body.ra-wide no longer widens anything: every page shares --maxw (styles.css). The class stays so pages that pass `wide` still build. */
  .adslot { min-height: 90px; margin: 0 0 24px; display: block; }
  .adslot ins { display: block; width: 100%; }
  .ra-lang a { margin-left: 10px; }
  .ra-lang :global(.ra-flag) { width: 16px; height: 11px; margin-right: 5px; vertical-align: -1px; border-radius: 1px; box-shadow: 0 0 0 1px rgba(0,0,0,.18); }
  .ra-lang a.on { font-weight: 600; text-decoration: none; color: var(--ink-2); }
  .ra-lang [data-lang-note] { margin-left: 10px; }
</style>
</head>
{/* 1080px IS A READING MEASURE AND A MAP IS NOT PROSE. --maxw caps every
    page at 1080 so a paragraph never runs to an unreadable line length,
    which is right for /about/ and wrong for the map: on a 1280 screen it
    left the map 646 pixels and gave the rest to margin, and on anything
    wider it just grew the margin. David: «why are you only using half the
    page?»
    Set on the body so the header and the footer widen with the content
    rather than floating in the middle of it, and only on the pages that
    ask for it. */}
<body class={wide ? "ra-wide" : undefined}>
{/* The table is one shared file, loaded synchronously so a reader whose language is not English does not watch the page change a
    second after it arrives. It was inlined into every page until it grew to 64 KB: multiplied by 83,000 pages that was 5 GB of the
    10 GB the deploy allows. */}
<script is:inline src={u("/js/i18n-tables.js")}></script>
<script is:inline src={u("/js/i18n.js")}></script>
<a class="skip" href="#main" data-i18n>Skip to the map</a>
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>Record <em>Atlas</em></a>
    {/* A PAGE MAY PUT ONE PILL BETWEEN THE BRAND AND NEW: the home page puts its volume count here (slot "inv"). */}
    <slot name="inv" />
    {/* THE PULSING DOT SAYS WHERE YOUR RESEARCH LIVES. Green = a copy is kept online (six-word sync is on) and this browser is
        connected; orange = it is saved only in this browser; red = this browser is offline. David asked for exactly that, and for a
        warning beside it when something has changed and no backup (file or online) has been made for more than 24 hours.
        It reads only this browser's own storage and the online/offline events: no request, nothing sent. The same reading is
        published as window.raConn.get() so /backup/ tells the same story as the header. The keys are the ones research-file.js and
        research-sync.js write: ra-backup-v1 {at}, ra-sync-v1 {phrase, saved}, ra-own-first / ra-own-last (the reader's own changes). */}
    <a class="ra-live ra-live-top" href={u("/backup/")} data-state="local" role="status" aria-live="polite" title="Connection &amp; Backup">
      <svg class="ra-live-i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 3h11l4 4v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8 3v5h7V3M7 21v-7h10v7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span class="ra-live-dot" aria-hidden="true"></span><span class="ra-live-t">Local</span><span class="ra-live-w" hidden><svg viewBox="0 0 16 16" width="14" height="14" role="img" aria-label="Warning: not backed up for over a day"><path d="M8 1.6 15 14H1z" fill="#e8a200" stroke="#8a5a00" stroke-width="1" stroke-linejoin="round"/><path d="M8 6v4" stroke="#3b2600" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="12" r=".95" fill="#3b2600"/></svg></span>
    </a>
    <script is:inline src={u("/js/conn.js")}></script>
    
    {/* WHERE THE MAP'S OWN TOOLS GO. The link, full-screen and reset buttons
        sat in the map's control bar, below the search box, where on a phone
        they took a whole row of their own and pushed the map further down.
        David asked for them up here beside the burger.

        Empty in the markup and filled by the map on mount: only the map page
        has those buttons, and Base is shared by 46,000 pages. A container
        with nothing in it collapses to nothing. */}
    <span class="site-tools" id="ra-tools"></span>
    {/* THE WORD «MENU» WENT, THE NAME DID NOT. David: «can we have menu as
        just the burgers and no word "menu"? and then that will give space for
        the icons?» — the four map tools were wrapping to a 2×2 block on a
        phone because this button was eating the row.
        aria-label carries what the text used to carry, so a screen reader
        still hears «Menu, button» and the accessibility test still passes; a
        bare icon with no accessible name would read as «button» and nothing
        else, which is the trade this is deliberately not making. */}
    <button class="burger" type="button" aria-expanded="false"
            aria-controls="drawer" aria-label="Menu">
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav class="topnav" aria-label="Main" data-latest={newestNews}>
      {nav.map(([label, links]) => (
        typeof links === "string"
          ? <a class:list={["menulink", here === u(links) ? "on" : ""]} href={u(links)}>{label}</a>
          : <details class="menu">
              <summary data-spot={"menu-" + label.toLowerCase().replace(/[^a-z]+/g, "-")}>{label}</summary>
              <div class:list={["panel", links.length > 14 ? "long" : ""]}>
                {links.map(([h, l]) => h === null ? <span class="ph">{l}</span> : <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
              </div>
            </details>
      ))}
      {/* WHICH FAMILY EVERY MARK BELONGS TO — ON THE PAGES THAT MAKE MARKS.
          The comment here used to say it «renders on all 46,000 pages and
          shows itself on the three that carry ProgressKit … everywhere else
          the element stays hidden». It described an intention the code never
          had. line-switcher.js hides the bar on exactly one condition:

              bar.hidden = bar.getAttribute("data-quiet") === "1"
                           && lines.length < 2;

          and this call passes `compact` without `quiet`, so data-quiet is
          null, the condition is always false, and RESEARCHING has been
          sitting in the header of every page on the site — Flags, About,
          providers, the surname pages — offering to switch a family on pages
          where nothing can be marked. David: «the research dropdown isn't
          relevant on some screens, why show it?»

          Passing `quiet` would not fix it either: quiet hides the bar until a
          SECOND line exists, and there are fifty. The question is not how many
          families there are, it is whether this page can record anything
          against one. Three kinds of page can: the map, which draws the rings;
          a place page, where volumes are marked; and /my-research/ itself. */}
      {/* THE RESEARCHING GROUP IS ONE THING, SET APART. David: the family selector and the Live dot are the important ones and should
          read as a group, divided from the menu, in the menu's own type. Wide screens only; below the burger breakpoint the dot
          sits beside the brand (.ra-live-top) and the family is in the drawer. */}
      <span class="ra-grp">
        {marksHere ? <LineSwitcher compact /> : <LineSwitcher compact linkOnly />}
        <a class="ra-live ra-live-grp" href={u("/backup/")} data-state="local" role="status" aria-live="polite" title="Connection &amp; Backup">
          <svg class="ra-live-i" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 3h11l4 4v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8 3v5h7V3M7 21v-7h10v7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span class="ra-live-dot" aria-hidden="true"></span><span class="ra-live-t">Local</span><span class="ra-live-w" hidden><svg viewBox="0 0 16 16" width="14" height="14" role="img" aria-label="Warning: not backed up for over a day"><path d="M8 1.6 15 14H1z" fill="#e8a200" stroke="#8a5a00" stroke-width="1" stroke-linejoin="round"/><path d="M8 6v4" stroke="#3b2600" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="12" r=".95" fill="#3b2600"/></svg></span>
        </a>
      </span>
      {/* ADD SOURCE MOVED INTO THE ABOUT MENU, UNDER THE SOURCES. David: «move the "add source" work to the About menu under the sources, let's
          save the real estate.» It is a once-in-a-while action, and the header bar is the one place on every page that cannot spare a pill. */}
    </nav>
    {/* WHAT'S NEW LIVES IN THE ABOUT MENU, AND ABOUT FLASHES WHEN THERE IS NEWS. David: the «New» pill was one more thing in a crowded header. A soft
        orange dot beside «About» (and on the burger, below the breakpoint) says something was added in the last fortnight that this
        browser has not looked at; opening What's new, or the page itself, puts it out. The date is written at build, the test runs in
        the browser because pages are built once and read for weeks. Seen-ness is a per-browser convenience, so storage may be blocked. */}
    <script is:inline defer src={u("/js/spot.js")}></script>
    <script is:inline defer src={u("/js/theme.js")}></script>
    <script is:inline>
      function raNewsDot() {
        var nav = document.querySelector("nav.topnav"); if (!nav) return;
        var latest = nav.getAttribute("data-latest") || "", seen = "";
        try { seen = localStorage.getItem("ra-news-seen") || ""; } catch (e) { /* storage blocked */ }
        if (/\/whats-new\/?$/.test(location.pathname)) {
          try { localStorage.setItem("ra-news-seen", latest); } catch (e) { /* storage blocked */ }
          return;
        }
        var d = Date.parse(latest + "T23:59:59");
        if (!d || latest <= seen || Date.now() - d > 14 * 86400000) return;
        var sums = nav.querySelectorAll("details.menu > summary"), about = null;
        for (var i = 0; i < sums.length; i++) if (sums[i].textContent.trim() === "About") about = sums[i];
        if (about) { about.classList.add("fresh"); about.title = (window.RA_T || function (x) { return x; })("Something new: open About, then What's new"); }
        var bg = document.querySelector(".burger"); if (bg) bg.classList.add("fresh");
        var dr = document.querySelectorAll('.drawer a[href$="/whats-new/"]');
        for (var k = 0; k < dr.length; k++) dr[k].classList.add("fresh");
        var tp = nav.querySelectorAll('.panel a[href$="/whats-new/"]');
        for (var m = 0; m < tp.length; m++) tp[m].classList.add("fresh");
      }
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", raNewsDot); else raNewsDot();
    </script>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      typeof links === "string"
        ? <div class="dgrp"><a href={u(links)} class={here === u(links) ? "on" : ""}>{label}</a></div>
        : <div class="dgrp"><span class="gl">{label}</span>
            {links.map(([h, l]) => h === null ? <span class="gl gl2">{l}</span> : <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
          </div>
    ))}
      <div class="dgrp"><a href={u("/my-research/")} class={here === u("/my-research/") ? "on" : ""}>Researching</a></div>
      <div class="dgrp"><span class="gl">Contribute</span>
        <a href={u("/add/")} class={here === u("/add/") ? "on" : ""}>Add a source</a>
      </div>
    </div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {/* THE FLAG ATLAS DOES NOT LOOK LIGHTER BECAUSE OF ITS PALETTE.
        David kept asking why the rest of the site would not read like the
        flags atlas, and I kept answering with colour — warmer ground, a
        softer rule, Fraunces over the old face. Then I counted the hex
        values in the flags atlas's own stylesheet: TWO. It runs on exactly
        the tokens everything else runs on. What makes it feel lighter is
        that every card on it carries a hand-drawn flag, and the rest of this
        site carried none: flagFor was imported by three index pages and the
        map, and by none of the 21,754 place pages or 139 country pages —
        the pages a reader actually lands on.

        So the flag belongs in the page header, once, where every template
        gets it. Optional, because a page about a surname spans countries and
        a page about the project has no country at all.

        AND THE COMMENT LIVES OUT HERE, not inside the parentheses below.
        `{!bare && ( … )}` has to hold ONE expression: a braced JSX comment
        in there is a second one with no operator, and a plain block comment
        confuses the parser just as badly. Both spellings fail with a line
        number in the GENERATED file that points nowhere near this one. */}
    {!bare && (
      <div class={"pagehead" + (flag ? " pagehead-flagged" : "")}
           style={flag && flag.color ? `--edge:${flag.color}` : undefined}>
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <div class="pagehead-title">
          {/* LABELLED WITH THE COUNTRY, NOT THE PAGE. The first version used
              the page title, which on a country page is right by accident and
              on a place page is a lie: Gračišće's header carries the flag of
              CROATIA, and a screen reader was about to announce «Flag of
              Gračišće» on 21,754 pages. flag.name is the country as the flags
              atlas spells it.

              AND THIS COMMENT SITS OUTSIDE THE PARENTHESES, for the second
              time in ten minutes: I wrote the note explaining that a braced
              comment cannot be the first child of `{x && ( … )}`, and then
              immediately put one inside `{flag && ( … )}`. Same error, same
              unhelpful message about a generated line number. */}
          {flag && (
            <a class="pagehead-flag" href={u(flagHref(flag.url))}
               title={`${flag.name} in the flags atlas — who held this ground, and when`}>
              <svg viewBox="0 0 300 200" role="img"
                   aria-label={`Flag of ${flag.name}`} set:html={flag.flag} />
            </a>
          )}
          <h1>{title}</h1>
        </div>
        {dek && <p class="dek">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<footer class="site-foot">
  <div class="wrap">
    {/* The ad slot. Reserved at a fixed height so that turning it on can never
        shove the page around, kept well below the map so nothing here is ever
        clicked by somebody reaching for a control.

        THE LOADER WAS NEVER HERE. This block rendered the <ins> element and
        nothing else — no adsbygoogle script, no push — so switching `enabled`
        on would have produced an empty box and a puzzle. It is wired now.

        CONSENT IS GOOGLE'S, NOT OURS, AND THE OLD COMMENT OVERSTATED IT. It
        said «the script does not load until a visitor has agreed», which would
        need a consent platform this site does not have. What actually happens
        is that Google's own GDPR message, enabled in the AdSense dashboard,
        shows before personalised ads are served. That is compliant and it is a
        different mechanism, so it should not be described as the other one.
        See site/src/data/site.json. */}
    {/* AN ASIDE, NOT A DIV — and note where this comment is. A div has no
        role, and aria-label is prohibited on a roleless element, so axe calls
        it aria-prohibited-attr and a screen reader simply drops the name:
        the ad was an unannounced block of nothing before the article. An
        aside element carries role=complementary implicitly, which permits
        the name.

        Written inside the parenthesised expression below, this comment broke
        the build twice over: a comment is not a valid first child there, and
        it named the two elements in angle brackets, which is the fault the
        comment forty lines down describes in capitals. Read that one. */}
    {adsHere && site.ads.enabled && site.ads.slot && (
      <aside class="adslot" aria-label="Advertisement">
        <ins class="adsbygoogle" style="display:block" data-ad-client={site.ads.client}
             data-ad-slot={site.ads.slot} data-ad-format="horizontal"
             data-full-width-responsive="true"></ins>
        {/* is:inline, because the src is a template literal. Astro tries to
            bundle a script tag it thinks it owns, and a dynamic src is not
            something it can resolve — so the loader never reached the page and
            the slot stayed empty. This is the second reason no ad appeared. */}
        <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.ads.client}`}
                crossorigin="anonymous"></script>
        {/* BRACES IN A QUOTED ASTRO ATTRIBUTE ARE AN EXPRESSION, NOT TEXT.
            Written as set:html="...push({});" Astro read the {} as an
            interpolation, mis-parsed the rest of this file, and silently
            dropped the global style block at the bottom — so every nav rule
            vanished and the top menu ran together as one word.

            AND THEN THIS COMMENT DID IT AGAIN. Written with the literal tag
            name in angle brackets, Astro opened a style element HERE and
            swallowed everything down to the real closing tag sixty lines
            below. A comment explaining a parser bug, causing the same parser
            bug. Do not write tag syntax in these comments. The value
            has to be an expression containing a string, not a string
            containing braces. */}
        <script is:inline set:html={"(adsbygoogle = window.adsbygoogle || []).push({});"}></script>
      </aside>
    )}
    <nav class="foot-links" aria-label="More">{footLinks.map(([h, l]) => <a href={u(h)}>{l}</a>)}
      {site.contact && site.contact.email && (
        <a class="at-note" href={`mailto:${site.contact.email}?subject=${encodeURIComponent("Record Atlas: a note")}`}
           title="Opens your own mail app. Nothing is sent from this page."><span data-i18n>Like my work? Have a suggestion? Drop me a note.</span></a>
      )}
    </nav>
    <p class="foot-note">
      <b>Record Atlas</b> — {site.tagline}. <a href={site.repo}>Data and code on GitHub</a>.
      {/* WHEN THIS COPY WAS MADE. A researcher who looked in March and
          found nothing for their parish has no way to know whether to
          look again — the atlas gains places and volumes most weeks and
          said so nowhere. The date is the build's own, which is the only
          one that cannot drift from what is actually being served. */}
      <br /><span class="foot-when">This copy built {built}.</span>
    </p>
    {/* THE ATLAS SPOKE ENGLISH AT PEOPLE RESEARCHING CROATIA, which is the
        single biggest ceiling on its reach: somebody after a Gračišće
        baptism or a Puglia birth is likelier to read Croatian or Italian.
        This translates the CHROME — the navigation, the controls, the
        labels, the words that say what to type and what a colour means.
        It does NOT touch the prose, because the prose on this site is
        careful about evidence and a translated «attested» that drifts is
        worse than an English one that does not. It also carries no
        hreflang: there is one URL per page and pointing hreflang at a page
        that is still mostly English would be a claim this site cannot
        back. Translated routes are the next step and would triple a
        46,000-page build, so they are deliberately not this one. */}
    <p class="foot-note foot-thin ra-lang" data-ra-lang>
      <span>Language:</span>
      {LANGS.map(([code, label]) => (
        <a href={`?lang=${code}`} data-lang={code} hreflang={code}><Fragment set:html={FLAG[code] || ""} />{label}</a>
      ))}
      <span class="foot-when" data-lang-note></span>
      {/* Feed rides the language line rather than owning a row of its own.
          It was one of five stacked blocks; it is one link. */}
      <span class="foot-sep">·</span>
      <a href={u("/feed.xml")}>Feed</a>
      {site.analytics?.goatcounter && site.analytics?.showCount && (
        <span data-vc hidden><span class="foot-sep">·</span> <span data-vc-n>—</span> visits, no cookies (<a href="https://www.goatcounter.com/" rel="noopener">GoatCounter</a>)</span>
      )}
    </p>

    {/* ATTRIBUTION IS A LICENCE CONDITION, NOT A COURTESY, and four of these
        were missing. This credited OpenStreetMap, Natural Earth and Wikidata
        and said nothing about GeoNames — which is the gazetteer, and
        therefore the reason any old place name on this site resolves at all
        — nor Statbel, Istat or the National Records of Scotland. Three of
        those four are CC BY, where attribution is the whole of what is
        asked in return. Found while documenting /data/, which had made the
        same omission one layer up. */}
    <details class="foot-note foot-thin foot-cred">
      <summary>Data credits and licences</summary>
      Maps and {osm.archives.length} archives &copy; OpenStreetMap contributors,
      <a href="https://opendatacommons.org/licenses/odbl/">ODbL</a>, as are the Irish
      townlands via Townlands.ie ·
      Place names from <a href="https://www.geonames.org/">GeoNames</a>, CC BY 4.0 ·
      Belgian surnames by commune from <a href="https://statbel.fgov.be/">Statbel</a>,
      CC BY 4.0 · Italian comuni from Istat, CC BY 3.0 IT ·
      Scottish civil parishes from the National Records of Scotland, OGL v3.0 ·
      Estonian parishes from the Rahvusarhiiv ·
      {/* TROVE ASKS FOR THIS BY NAME, not merely by convention. Its API terms
          require an application to state that it uses data sourced from Trove
          and to link to it, and to identify the contributing source of each
          item as well as Trove — which the volume rows do, each naming the
          National Library of Australia and linking to the item's own Trove
          page. This is the site-wide half of the same requirement. */}
      Australian newspapers from
      <a href="https://trove.nla.gov.au/">Trove</a>, National Library of
      Australia ·
      Country outlines from Natural Earth, public domain ·
      Archives, churches, cemeteries and surnames from Wikidata, CC0 ·
      {/* SHARE-ALIKE, SO IT IS OWED HERE AND NOT ONLY ON /data/. What a
          surname is said to be comes from Wiktionary under CC BY-SA 4.0:
          attribution is a condition, and check-data.py fails the build if
          this name leaves the footer. */}
      What a surname is said to be from
      <a href="https://en.wiktionary.org/">Wiktionary</a>,
      <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> ·
      <a href={u("/data/")}>the whole list, per file</a>
    </details>
  </div>
</footer>
{site.analytics?.goatcounter && site.analytics?.showCount && (
  <script is:inline define:vars={{
    endpoint: `https://${site.analytics.goatcounter}.goatcounter.com/counter/TOTAL.json` }}>
    /* The count is hidden until it arrives and removed if it never does. A
       counter that cannot be reached should say nothing, rather than show a
       nought that is not true. The public endpoint is off by default in
       GoatCounter's own settings, so this failing quietly is the expected
       state until that switch is thrown. */
    (function () {
      var box = document.querySelector("[data-vc]");
      var n = box && box.querySelector("[data-vc-n]");
      if (!box || !n) return;
      fetch(endpoint)
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (d) {
          /* parseInt, because GoatCounter returns the count as a STRING and
             "0" is truthy in JavaScript — a brand-new site would have
             announced "0 visits" in its own footer. Below one, say nothing. */
          /* And GoatCounter groups thousands with a narrow no-break space
             ("1 004"), so parseInt read 1,004 as 1 the day the count passed
             a thousand. Keep the digits only. */
          var c = parseInt(String((d && d.count) || "0").replace(/\D/g, ""), 10) || 0;
          if (c > 0) { n.textContent = c.toLocaleString(); box.hidden = false; }
          else box.remove();
        })
        .catch(function () { box.remove(); });
    })();
  </script>
)}

<script is:inline>
  /* The menu button, and one dropdown open at a time. */
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest && e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
</body>
</html>
