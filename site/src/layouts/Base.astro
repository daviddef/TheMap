---
/* Fixed when the page is generated, not read in the browser:
   a date computed client-side would say «today» forever. */
const built = new Date().toISOString().slice(0, 10);
import { u } from "../lib/url.js";
import site from "../data/site.json";
/* Counted, not typed. This line is on all 6,000 pages and it is a licence
   attribution — the one kind of number that must not quietly go stale. */
import osm from "../../public/archives-osm.json";

const { title, dek, eyebrow, bare, jsonld, og = "default" } = Astro.props;
/* GROUPED, BECAUSE THE STYLESHEET ONLY EVER STYLED GROUPS. styles.css came
   across whole from the family archive and it carries a complete navigation
   design: dropdown groups, a menu button, a drawer. This file rendered eleven
   bare links instead, and the sheet has no rule for a bare link in the bar —
   so `header.site nav.topnav` won on specificity, the eleven ran together at
   its 1px gap, and below 1180px its display:none!important hid them behind a
   menu button that did not exist. Eleven top-level links was too many anyway. */
const nav = [
  /* SURNAMES ARE THE FRONT DOOR AND WERE FILED AS A DATASET. People arrive
     holding a name far more often than a place — it is the one thing on a
     certificate that survives every border change — and 23,930 of these
     pages exist, each naming the spellings, the countries, and the archives
     to write to. The navigation listed them fourth, under a word that reads
     like a table of statistics. Second, and named as the question. */
  ["Explore", [
    ["/", "The map"],
    ["/surnames/", "Look up a surname"],
    ["/places/", "Every place"],
    ["/countries/", "Countries"],
  ]],
  ["The sources", [
    ["/providers/", "Who holds records"],
    ["/jurisdictions/", "Whose archive"],
    ["/coverage/", "What's missing"],
  ]],
  ["About", [
    ["/start/", "Start here"],
    ["/about/", "About the atlas"],
    /* The files this map draws from are public URLs and nothing said so.
       A licence nobody can find is a licence nobody can act on. */
    ["/data/", "Use the data"],
    ["/changelog/", "What changed"],
    ["/worklist/", "What is being done"],
  ]],
];
const here = Astro.url.pathname;
/* Strip the query string: /?q=Breslau and / are the same page. */
const canon = new URL(here, Astro.site || "https://daviddef.github.io").href;
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`}</title>
<meta name="description" content={dek || site.tagline} />
<meta property="og:title" content={title} />
<meta property="og:description" content={dek || site.tagline} />
<meta property="og:type" content="website" />
{/* One canonical address per page. With 1,304 pages and a map whose every
    view is a query string, a crawler will otherwise find the same page under
    a dozen addresses and split its credit between them. */}
<link rel="canonical" href={canon} />
{/* A FEED READER CAN NOW SUBSCRIBE TO THIS ATLAS. The changelog page has
    existed for a while with no way to be told about it, which is no good
    for the society editors and archivists this most needs to reach — they
    read feeds, they do not revisit a page on the chance it moved. One
    entry per day rather than per commit, because a day here is routinely
    fifteen commits and fifteen notifications is how a feed gets dropped. */}
<link rel="alternate" type="application/atom+xml" title="Record Atlas — what changed"
      href={u("/feed.xml")} />
<meta property="og:url" content={canon} />
<meta property="og:site_name" content={site.name} />
{/* A shared link with no og:image renders as a blank grey rectangle. One card
    per page TYPE, not per page — 5,924 images would be a gigabyte of pictures
    nobody looks at twice, and the type is what actually differs. */}
<meta property="og:image" content={new URL(u(`/og/${og}.png`), Astro.site || "https://daviddef.github.io").href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
{/* Structured data. 5,924 pages emitted none, which is the cheapest remaining
    thing a search engine could be told: that /place/gracisce/ is a PLACE with
    coordinates, that /archive/dapa/ is an ARCHIVE, and that the whole thing is
    a dataset with a licence. */}
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
{/* The house mark. Every sibling archive has one and this had none, so a tab
    for Record Atlas sat among them showing a browser's grey placeholder. SVG
    first because it stays sharp at every size a tab strip, a bookmark bar or a
    phone home screen asks for; the OG cards already cover the social preview. */}
<link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
{/* PNG alongside it, because an SVG is not enough on its own. Safari ignores
    an SVG apple-touch-icon entirely, and a bookmark or a home screen falls
    back to a grey square — which is what "no icon" looked like. */}
<link rel="icon" href={u("/favicon-32.png")} sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} sizes="180x180" />
<meta name="theme-color" content="#1F5C6B" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css")} />
{/* GoatCounter, as on every sibling archive. No cookies and no personal
    data, so it needs no consent gate of its own — which is also why it is
    not inside the AdSense consent flow. is:inline because the src is a
    protocol-relative CDN path Astro would otherwise try to bundle, the same
    trap that stopped the ad loader reaching the page.
    Nothing renders at all when no code is configured. */}
{site.analytics?.goatcounter && (
  <script is:inline async src="//gc.zgo.at/count.js"
          data-goatcounter={`https://${site.analytics.goatcounter}.goatcounter.com/count`}></script>
)}
{/* THE STYLES LIVE HERE NOW, AND THE REASON MATTERS. They sat below the
    closing html tag, where the parser reparents stray content and Astro never
    collected them — so the whole block was dropped from the built CSS and the
    nav shipped unstyled. Two other explanations were tried first and both were
    wrong. A style element belongs in the head; anywhere else is luck. */}
<style is:global>
  /* ONLY WHAT styles.css DOES NOT ALREADY DEFINE. It owns header.site,
     .sitein, .brand, .pagehead, .topnav, .burger and .drawer — every one of
     those was duplicated here and lost, because `header.site nav.topnav`
     outranks a bare `.topnav`. A layout should not restate its stylesheet. */
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 12px; top: 12px; z-index: 999; background: var(--panel);
                padding: 10px 14px; border: 1px solid var(--accent); }
  .foot-when { color: var(--ink-3); }
  footer.site-foot { margin-top: 60px; padding: 26px 0 40px;
                     border-top: 1px solid var(--rule); background: var(--panel); }
  .foot-note { font-family: var(--sans); font-size: 12.5px; line-height: 1.6;
               color: var(--ink-3); max-width: 80ch; margin: 0 0 8px; }
  .foot-thin { font-size: 11.5px; }
    /* NOT A FLEX CONTAINER. It was, and the ins element inside it is a
     block-level flex child with no intrinsic width, so it measured zero and
     AdSense rejected the slot outright: "No slot size for availableWidth=0".
     The loader was arriving and being turned away at the door. A responsive
     unit needs a real width to size itself against. */
  .adslot { min-height: 90px; margin: 0 0 24px; display: block; }
  .adslot ins { display: block; width: 100%; }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to the map</a>
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>Record <em>Atlas</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/add/")}>Add a source</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}
      <div class="dgrp"><span class="gl">Contribute</span>
        <a href={u("/add/")} class={here === u("/add/") ? "on" : ""}>Add a source</a>
      </div>
    </div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek">{dek}</p>}
      </div>
    )}
    <slot />
  </div>
</main>

<footer class="site-foot">
  <div class="wrap">
    {/* The ad slot. Reserved at a fixed height so that turning it on can never
        shove the page around, kept well below the map so nothing here is ever
        clicked by somebody reaching for a control.

        THE LOADER WAS NEVER HERE. This block rendered the <ins> element and
        nothing else — no adsbygoogle script, no push — so switching `enabled`
        on would have produced an empty box and a puzzle. It is wired now.

        CONSENT IS GOOGLE'S, NOT OURS, AND THE OLD COMMENT OVERSTATED IT. It
        said «the script does not load until a visitor has agreed», which would
        need a consent platform this site does not have. What actually happens
        is that Google's own GDPR message, enabled in the AdSense dashboard,
        shows before personalised ads are served. That is compliant and it is a
        different mechanism, so it should not be described as the other one.
        See site/src/data/site.json. */}
    {site.ads.enabled && site.ads.slot && (
      <div class="adslot" aria-label="Advertisement">
        <ins class="adsbygoogle" style="display:block" data-ad-client={site.ads.client}
             data-ad-slot={site.ads.slot} data-ad-format="horizontal"
             data-full-width-responsive="true"></ins>
        {/* is:inline, because the src is a template literal. Astro tries to
            bundle a script tag it thinks it owns, and a dynamic src is not
            something it can resolve — so the loader never reached the page and
            the slot stayed empty. This is the second reason no ad appeared. */}
        <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.ads.client}`}
                crossorigin="anonymous"></script>
        {/* BRACES IN A QUOTED ASTRO ATTRIBUTE ARE AN EXPRESSION, NOT TEXT.
            Written as set:html="...push({});" Astro read the {} as an
            interpolation, mis-parsed the rest of this file, and silently
            dropped the global style block at the bottom — so every nav rule
            vanished and the top menu ran together as one word.

            AND THEN THIS COMMENT DID IT AGAIN. Written with the literal tag
            name in angle brackets, Astro opened a style element HERE and
            swallowed everything down to the real closing tag sixty lines
            below. A comment explaining a parser bug, causing the same parser
            bug. Do not write tag syntax in these comments. The value
            has to be an expression containing a string, not a string
            containing braces. */}
        <script is:inline set:html={"(adsbygoogle = window.adsbygoogle || []).push({});"}></script>
      </div>
    )}
    <p class="foot-note">
      <b>Record Atlas</b> — {site.tagline}. Built in the open:
      <a href={site.repo}>the data and the code are on GitHub</a>, and every source row
      says when it was last checked. A directory that lies is worse than no directory.
      {/* WHEN THIS COPY WAS MADE. A researcher who looked in March and
          found nothing for their parish has no way to know whether to
          look again — the atlas gains places and volumes most weeks and
          said so nowhere. The date is the build's own, which is the only
          one that cannot drift from what is actually being served. */}
      <br /><span class="foot-when">This copy built {built}.</span>
    </p>
    {site.analytics?.goatcounter && site.analytics?.showCount && (
      <p class="foot-note foot-thin vc" data-vc hidden>
        <span data-vc-n>—</span> visits, counted without cookies by
        <a href="https://www.goatcounter.com/" rel="noopener">GoatCounter</a>
      </p>
    )}
    <p class="foot-note foot-thin">
      <a href={u("/about/")}>About</a> · <a href={u("/add/")}>Add or correct a source</a> ·
      <a href={u("/data/")}>Use the data</a> ·
      <a href={u("/feed.xml")}>Feed</a> ·
      <a href={u("/privacy/")}>Privacy</a> · Maps and {osm.archives.length} archives &copy; OpenStreetMap
      contributors, <a href="https://opendatacommons.org/licenses/odbl/">ODbL</a> ·
      Country outlines from Natural Earth, public domain · Archives and surnames from
      Wikidata, CC0
    </p>
  </div>
</footer>
{site.analytics?.goatcounter && site.analytics?.showCount && (
  <script is:inline define:vars={{
    endpoint: `https://${site.analytics.goatcounter}.goatcounter.com/counter/TOTAL.json` }}>
    /* The count is hidden until it arrives and removed if it never does. A
       counter that cannot be reached should say nothing, rather than show a
       nought that is not true. The public endpoint is off by default in
       GoatCounter's own settings, so this failing quietly is the expected
       state until that switch is thrown. */
    (function () {
      var box = document.querySelector("[data-vc]");
      var n = box && box.querySelector("[data-vc-n]");
      if (!box || !n) return;
      fetch(endpoint)
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (d) {
          /* parseInt, because GoatCounter returns the count as a STRING and
             "0" is truthy in JavaScript — a brand-new site would have
             announced "0 visits" in its own footer. Below one, say nothing. */
          var c = parseInt((d && d.count) || "0", 10);
          if (c > 0) { n.textContent = c.toLocaleString(); box.hidden = false; }
          else box.remove();
        })
        .catch(function () { box.remove(); });
    })();
  </script>
)}

<script is:inline>
  /* The menu button, and one dropdown open at a time. */
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest && e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
</body>
</html>
