---
/* /about/ AND /start/ ARE ONE PAGE, AT /start/. This address stays so that every old link, bookmark and search result still lands somewhere.

   A STATIC SITE ON GITHUB PAGES HAS NO SERVER REDIRECT (no _redirects file, no rewrite rules, no 301), so this is the redirect the platform
   allows: an instant meta refresh, a canonical link to /start/ (which is how a search engine is told this page is that one, and which it
   treats like a permanent redirect), and a script for the case where meta refresh is off. It is not noindex, on purpose: noindex would
   drop the old address without passing its standing to the new one, and canonical does both. Same pattern as /survey/ and /jurisdictions/,
   except for that. The hash is kept, so /about/#something lands on /start/#something. */
import { u } from "../lib/url.js";
const to = u("/start/");
const canon = new URL(to, Astro.site || "https://daviddef.github.io").href;   // absolute, as Base.astro writes it for every other page
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>About Record Atlas: now on the Start here page</title>
  <link rel="canonical" href={canon} />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body style="font-family:system-ui,sans-serif;padding:32px">
  <p>About Record Atlas is now part of <a href={to}>Start here</a>.</p>
  <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
</body>
</html>
