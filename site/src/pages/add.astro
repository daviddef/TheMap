---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import site from "../data/site.json";
const iss = site.repo + "/issues/new";
---
<Base
  title="Add or correct a source"
  eyebrow="Everything here is a file in a public repository"
  dek="No login and no queue. Tell us by mail, or send a change to the public data files.">

  <div class="k-bar"><h2>What helps most</h2></div>
  <ul class="k-grid ways">
    <li><a class="k-card is-link way" href={`${iss}?template=add-source.yml`}>
      <span class="k-ico" aria-hidden="true">📚</span><span class="k-pill">Most useful</span>
      <h3>A provider this map does not have</h3>
      <p>Especially a national or regional archive outside western Europe, where the map is thinnest.</p></a></li>
    <li><a class="k-card is-link way" href={`${iss}?template=jurisdiction.yml`}>
      <span class="k-ico" aria-hidden="true">🗺</span><span class="k-pill is-plain">Rarest</span>
      <h3>A region's filing history</h3>
      <p>Which archive holds a piece of ground's records, for which years, under which regime.</p></a></li>
    <li><a class="k-card is-link way" href={`${iss}?template=dead-link.yml`}>
      <span class="k-ico" aria-hidden="true">🔗</span><span class="k-pill is-plain">Always welcome</span>
      <h3>Something that has changed</h3>
      <p>A dead link, a portal that moved, a collection that went from free to paid.</p></a></li>
  </ul>

  {/* A ROUTE FOR PEOPLE WHO DO NOT HAVE A GITHUB ACCOUNT.
      Every path on this page was an issue or a pull request, which is a
      developer's idea of how a stranger reports a dead link. The people
      best placed to correct this atlas — an archivist who finds their own
      institution marked «unsurveyed», a researcher who knows a collection
      went behind a paywall last year — will not open an account to say
      so. Rendered only when an address exists, because a contact link
      that goes nowhere is worse than none. */}
  {site.contact && site.contact.email && (
    <div class="k-bar"><h2>Send a source, no account</h2></div>
    <div class="k-card addform">
      <p class="addlead">Fill in what you know and leave the rest blank. <b>Nothing is sent from this page</b>: the button opens your own mail app with the message written, or you can copy it.</p>

      <div class="addgrid">
        <label>What is it called
          <input type="text" id="af-name" placeholder="Državni arhiv u Gospiću" /></label>
        <label>Its web address
          <input type="text" id="af-url" placeholder="https://…" /></label>
        <label>Which country or countries
          <input type="text" id="af-cc" placeholder="Croatia" /></label>
        <label>What does it hold
          <input type="text" id="af-what" placeholder="parish registers for Lika-Senj, 1780–1900" /></label>
        <label>What does it cost to look
          <select id="af-access">
            <option value="">I do not know</option>
            <option value="free">Images, free, no account</option>
            <option value="account">Images, free, account needed</option>
            <option value="index">An index only — no images</option>
            <option value="mixed">Partly free, partly paid</option>
            <option value="paid">Images, behind a paywall</option>
            <option value="catalogue">A catalogue entry only — the paper is not photographed</option>
            <option value="onsite">On paper, in the building</option>
          </select></label>
        <label class="addwide">Anything else — how you know, what is wrong, what changed
          <textarea id="af-note" rows="3" placeholder="I am the archivist here and our registers moved to a new portal in March."></textarea></label>
      </div>

      <p class="addbtns">
        <a id="af-send" href="#">Open this in my mail app</a>
        <button type="button" id="af-copy">Copy the message</button>
        <span id="af-said" role="status" aria-live="polite"></span>
      </p>
      <p class="cap addto">It goes to <b>{site.contact.email}</b>, and is checked against the source before anything changes.</p>
    </div>
  )}

  {site.contact && site.contact.email && (
    <script is:inline define:vars={{ TO: site.contact.email }}>
      (function () {
        /* NO SERVER, NO THIRD PARTY, NO FORM SERVICE. This site is static and
           stores nothing about anybody; posting a stranger's message through
           somebody else's endpoint to avoid asking them to open a mail client
           would trade the one property the whole project is built on for a
           small convenience. So the form composes text, and the reader sends
           it — or copies it, because a mail app is not a safe assumption and
           `mailto:` quietly fails on a machine with none configured. */
        var F = ["af-name", "af-url", "af-cc", "af-what", "af-access", "af-note"];
        var LBL = { "af-name": "Name", "af-url": "Web address",
                    "af-cc": "Country", "af-what": "What it holds",
                    "af-access": "What it costs to look", "af-note": "Notes" };
        function body() {
          var out = [];
          F.forEach(function (id) {
            var el = document.getElementById(id);
            var v = el && el.value ? el.value.trim() : "";
            if (v) out.push(LBL[id] + ": " + v);
          });
          if (!out.length) return "";
          out.push("", "Sent from the Add a source page on Record Atlas.");
          return out.join("\n");
        }
        var send = document.getElementById("af-send");
        var said = document.getElementById("af-said");
        function refresh() {
          var b = body();
          var name = (document.getElementById("af-name") || {}).value || "";
          send.href = "mailto:" + TO +
            "?subject=" + encodeURIComponent("Record Atlas — a source" +
              (name ? ": " + name.trim() : "")) +
            "&body=" + encodeURIComponent(b);
          send.setAttribute("aria-disabled", b ? "false" : "true");
        }
        F.forEach(function (id) {
          var el = document.getElementById(id);
          if (el) { el.addEventListener("input", refresh); el.addEventListener("change", refresh); }
        });
        refresh();
        send.addEventListener("click", function (e) {
          if (!body()) { e.preventDefault(); said.textContent = "Fill in at least one field first."; }
        });
        document.getElementById("af-copy").addEventListener("click", function () {
          var b = body();
          if (!b) { said.textContent = "Fill in at least one field first."; return; }
          var text = "To: " + TO + "\n\n" + b;
          function ok() { said.textContent = "Copied \u2014 paste it into any email."; }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(ok, function () { said.textContent = TO; });
          } else {
            /* Older browsers, and any context where the clipboard API is
               blocked: show the address rather than fail silently. */
            said.textContent = TO;
          }
        });
      })();
    </script>
  )}

  {site.contact && site.contact.email && (
    <details class="add-fold">
    <summary class="k-bar"><h2>Several at once</h2><span class="k-pill is-plain">paste a list</span></summary>
    <div class="k-card addform">
      <p class="addlead">Paste blocks of <code>Name:</code>, <code>Web address:</code>, <code>Country:</code>,
      <code>What it holds:</code>, <code>What it costs to look:</code> and <code>Notes:</code>, a blank line between sources. This makes <b>one</b> message, and nothing is sent from this page. An assistant can read the format at
      <a href={u("/add-sources.txt")}>add-sources.txt</a>.</p>
      <div class="addgrid">
        <label class="addwide">Your list
          <textarea id="bf-text" rows="8" placeholder={"Name: Portsmouth History Centre\nWeb address: https://…\nCountry: United Kingdom\nWhat it holds: …\n\nName: Vestfold-slekt\n…"}></textarea></label>
      </div>
      <p class="addbtns">
        <a id="bf-send" href="#">Open this in my mail app</a>
        <button type="button" id="bf-copy">Copy the message</button>
        <span id="bf-said" role="status" aria-live="polite"></span>
      </p>
    </div>
    </details>
  )}

  {site.contact && site.contact.email && (
    <script is:inline define:vars={{ TO: site.contact.email }}>
      (function () {
        /* The same rule as the form above: no server, nothing sent from here. A long list does not always survive a mailto: link (mail apps and
           browsers cut them), so a long one says to copy instead of quietly losing its end. */
        var box = document.getElementById("bf-text"), send = document.getElementById("bf-send"), said = document.getElementById("bf-said");
        if (!box || !send) return;
        function count(t) { var m = t.match(/^\s*name\s*:/gim); return m ? m.length : 0; }
        function subject(t) { var n = count(t); return "Record Atlas - " + (n || "a list of") + (n === 1 ? " source" : " sources"); }
        function refresh() {
          var t = box.value.trim();
          send.href = "mailto:" + TO + "?subject=" + encodeURIComponent(subject(t)) + "&body=" + encodeURIComponent(t ? t + "\n\nSent from the Add a source page on Record Atlas." : "");
          send.setAttribute("aria-disabled", t ? "false" : "true");
          said.textContent = t && send.href.length > 1800 ? "This is long: use \u201cCopy the message\u201d and paste it into an email, in case your mail app cuts it." : "";
        }
        box.addEventListener("input", refresh); refresh();
        send.addEventListener("click", function (e) { if (!box.value.trim()) { e.preventDefault(); said.textContent = "Paste your list first."; } });
        document.getElementById("bf-copy").addEventListener("click", function () {
          var t = box.value.trim(); if (!t) { said.textContent = "Paste your list first."; return; }
          var text = "To: " + TO + "\nSubject: " + subject(t) + "\n\n" + t;
          function ok() { said.textContent = "Copied \u2014 paste it into any email."; }
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(ok, function () { said.textContent = TO; });
          else said.textContent = TO;
        });
      })();
    </script>
  )}

  <details class="add-fold">
  <summary class="k-bar"><h2>Or send a pull request</h2><span class="k-pill is-plain">for editors</span></summary>
  <div class="k-prose">
    <p>The files are small and hand-editable:</p>
    <ul>
      <li><code>data/providers.json</code> — who holds records, and what access costs</li>
      <li><code>data/regions.json</code> — record regions, their eras, and whose archive each means</li>
      <li><code>data/places.json</code> — places and the volumes that cover them</li>
    </ul>
    <p><code>python3 scripts/check-data.py</code> will tell you whether your change is sound
    before you send it, and the build runs the same check, so nothing lands that fails it.</p>
    <p><b>Every source row must carry a <code>checked</code> date.</b> Not because dates are
    tidy, but because a link with no date is a claim about the present made out of a memory
    of the past.</p>
  </div>
  </details>
</Base>

<style>

  /* THE FORM. It had no rules at all: labels ran into the next field as a
     paragraph and the controls sat at browser defaults. Two columns, the label
     above its field, the long answer across the whole width, and one primary
     action beside one quiet one. Everything is a token, so both themes follow. */
  .addform { padding: 22px 24px 20px; --field: #FFFFFF; }   /* a field is lighter than the panel it sits on */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .addform { --field: var(--ground); } }
  :global(:root[data-theme="dark"]) .addform { --field: var(--ground); }
  .addlead { font-family: var(--sans); font-size: 14px; line-height: 1.6;
             color: var(--ink-2); max-width:var(--measure); margin: 10px 0 0; }
  .addlead b { color: var(--ink); font-weight: 600; }
  .addgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 20px;
             margin-top: 20px; }
  .addgrid label { display: flex; flex-direction: column; gap: 6px; min-width: 0;
                   font-family: var(--sans); font-size: 12.5px; font-weight: 600;
                   color: var(--ink-2); }
  .addwide { grid-column: 1 / -1; }
  .addgrid input, .addgrid select, .addgrid textarea {
    width: 100%; box-sizing: border-box; font-family: var(--sans); font-size: 14.5px;
    font-weight: 400; color: var(--ink); background: var(--field);
    border: 1px solid var(--rule-strong); border-radius: 6px; padding: 9px 11px;
    min-height: 40px; }
  .addgrid textarea { min-height: 96px; resize: vertical; line-height: 1.5; }
  .addgrid ::placeholder { color: var(--ink-3); opacity: .75; }
  .addgrid input:focus, .addgrid select:focus, .addgrid textarea:focus {
    outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }
  .addbtns { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px;
             margin: 22px 0 0; }
  .addbtns #af-send, .addbtns #af-copy, .addbtns #bf-send, .addbtns #bf-copy {
    font-family: var(--sans); font-size: 13.5px; font-weight: 600; line-height: 1;
    padding: 11px 18px; border-radius: 999px; cursor: pointer; text-decoration: none; }
  .addbtns #af-send, .addbtns #bf-send { background: var(--accent); color: #fff; border: 1px solid var(--accent); }
  .addbtns #af-send:hover, .addbtns #bf-send:hover { background: var(--accent-2); border-color: var(--accent-2); }
  .addbtns #af-send[aria-disabled="true"], .addbtns #bf-send[aria-disabled="true"] { opacity: .6; }
  .addbtns #af-copy, .addbtns #bf-copy { background: transparent; color: var(--ink);
                      border: 1px solid var(--rule-strong); }
  .addbtns #af-copy:hover, .addbtns #bf-copy:hover { border-color: var(--accent); color: var(--accent); }
  #af-said, #bf-said { font-family: var(--sans); font-size: 12.5px; color: var(--ink-3); }
  .addto { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--rule); }
  @media (max-width: 640px) {
    .addform { padding: 18px 16px 16px; }
    .addgrid { grid-template-columns: 1fr; }
    .addbtns #af-send, .addbtns #af-copy, .addbtns #bf-send, .addbtns #bf-copy { flex: 1 1 100%; text-align: center; padding: 13px 18px; }
  }
  .add-fold > summary { cursor: pointer; list-style: none; }
  .add-fold > summary::-webkit-details-marker { display: none; }
  .add-fold > summary h2::after { content: " ▾"; font-size: .6em; color: var(--ink-3); }
  .add-fold[open] > summary h2::after { content: " ▴"; }
  .way .k-ico { margin-bottom: 2px; }
  .way .k-pill { align-self: flex-start; }
  code { font-family: var(--mono); font-size: 12.5px; background: var(--panel-2);
         padding: 1px 5px; border-radius: 2px; }
</style>
