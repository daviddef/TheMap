---
import { brief } from "../../lib/brief.js";
/* One page per provider — the institution's own page.

   A researcher who starts from a building rather than from a village needs
   this direction of the same facts: what this archive holds, what ground it
   covers, what it costs to look, and which of our places carry its volumes. */
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import full from "../../data/places-full.json";
import regions from "../../../public/regions.json";
import provs from "../../../public/providers.json";
import { atlas as idx } from "../../lib/atlas.js";

export async function getStaticPaths() {
  const provs = (await import("../../../public/providers.json")).default;
  return provs.providers.map((p) => ({ params: { id: p.id }, props: { prov: p } }));
}

const { prov } = Astro.props;
const host = (() => { try { return new URL(prov.url).hostname.replace(/^www\./, ""); } catch { return prov.url; } })();
const ACC = {
  free: "Images, free, no account", account: "Images, free, account needed",
  index: "An index only — no images", mixed: "Partly free, partly paid",
  paid: "Images, behind a paywall", catalogue: "A catalogue entry — not photographed",
  onsite: "On paper, in the building",
};
/* Which of our places carry a volume from this provider, and how many. */
const holds = full.places
  .map((p) => ({ p, n: (p.collections || []).filter((c) => c.provider === prov.id).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n || a.p.name.localeCompare(b.p.name));
const vols = holds.reduce((a, x) => a + x.n, 0);
/* WHAT THE MAP KNOWS WHEN NO VOLUME IS PLACED. Almost every source has no places attached yet (only FamilySearch, DAPA, Antenati and Beweb do), so the empty state
   is the page most sources show. It says what is known (the countries it covers, its own address) rather than reading as an error, and lists the places on this
   map nearest the archive's address, which is where it is, NOT what it holds. Nothing here is guessed: no place is attached to the archive. */
const CN = idx.countries || {};
const world = (prov.countries || []).includes("*");
const covers = world ? [] : (prov.countries || []);
let near = [];
if (!holds.length && prov.at) {
  const k = Math.cos((prov.at.lat * Math.PI) / 180);
  near = full.places
    .filter((p) => !covers.length || covers.includes(p.country))
    .map((p) => ({ p, d: Math.hypot((p.lat - prov.at.lat) * 111, (p.lon - prov.at.lon) * 111 * k) }))
    .filter((x) => x.d <= 150)
    .sort((a, b) => a.d - b.d)
    .slice(0, 6)
    .map((x) => x.p)
    .sort((a, b) => a.name.localeCompare(b.name));   /* the six nearest, shown by name */
}
/* And which record regions name it as the holder of their records. */
const cited = regions.regions
  .map((r) => ({ r, eras: r.eras.filter((e) => e.filedUnder.includes(prov.id)) }))
  .filter((x) => x.eras.length);
const KIND = {
  "aggregator": "An aggregator", "national-archive": "A national archive or state portal",
  "regional-archive": "A regional archive", "diocesan": "A church archive",
  "volunteer": "A volunteer index", "library": "A library or newspaper archive",
  "commercial": "A commercial subscription",
};
---
<Base
  og="archive"
  jsonld={{
    "@context": "https://schema.org", "@type": "ArchiveOrganization",
    name: prov.name, url: prov.url, description: brief(prov.what, 300),
    address: prov.at ? { "@type": "PostalAddress", addressLocality: prov.at.place } : undefined,
    geo: prov.at ? { "@type": "GeoCoordinates", latitude: prov.at.lat,
                     longitude: prov.at.lon } : undefined,
  }}
  title={prov.name}
  eyebrow={KIND[prov.kind] || "A source"}
  dek={brief(prov.what, 360)}>

  <ul class="k-pills" style="margin-top:6px">
    <li><a class="bigl" href={prov.url} target="_blank" rel="noopener" title={prov.url}>Visit {host} ↗</a></li>
    {prov.at?.place && <li class="k-pill is-plain">{prov.at.place}</li>}
    {ACC[prov.access] && <li class="k-pill">{ACC[prov.access]}</li>}
  </ul>
  {String(prov.what || "").length > 360 && (
    <details class="k-more" style="margin-top:14px">
      <summary><span class="k-mt">Everything recorded about this archive</span></summary>
      <div><p class="what-full" style="line-height:1.6">{prov.what}</p></div>
    </details>
  )}
  <p class="cap">Last checked {prov.checked}. <a href={u("/add/")}>Tell us if this has changed.</a></p>

  {prov.holdings && prov.holdings.length > 0 && (
    <section>
      <div class="k-bar"><h2>What it holds</h2></div>
      {prov.holdingsNote && <p class="cap">{prov.holdingsNote}</p>}
      <ul class="vols" style="margin-top:12px">
        {prov.holdings.map((r) => (
          <li>
            {r.what}
            {r.from && <span class="y">{r.from}{r.to ? `–${r.to}` : "–"}</span>}
            {r.note && <><br /><span class="who">{r.note}</span></>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {cited.length > 0 && (
    <section>
      <div class="k-bar"><h2>The ground it holds</h2></div>
      <p class="cap">Record regions whose registers are filed here, and for which years.</p>
      {cited.map(({ r, eras }) => (
        <div style="margin-top:16px">
          <div class="lab"><a href={u(`/region/${r.id}/`)}>{r.label}</a></div>
          <ul class="eras">
            {eras.map((e) => (
              <li><span class="y">{e.from}–{e.to}</span> {e.polity}
                {e.note && e.note.startsWith("THE ") && <em class="trap"> — {e.note}</em>}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {holds.length > 0 ? (
    <section>
      <div class="k-bar"><h2>{vols} volumes across {holds.length} places</h2></div>
      <p class="cap">Places in this map that carry at least one volume from {prov.name}.</p>
      <ul class="places">
        {holds.slice(0, 400).map(({ p, n }) => (
          <li><a href={u(`/place/${p.id}/`)}>{p.name}</a> <span class="y">{n}</span></li>
        ))}
      </ul>
      {holds.length > 400 && <p class="cap">…and {holds.length - 400} more.</p>}
    </section>
  ) : (
    <div class="k-hi is-plain" style="margin-top:32px">
      <p><b>What this map knows so far</b></p>
      <p>{prov.name} is listed as covering
      {world ? " the world" : covers.map((cc, i) => (
        <>{i ? (i === covers.length - 1 ? " and " : ", ") : " "}<a href={u(`/country/${cc}/`)}>{CN[cc] || cc}</a></>
      ))}.
      No volume from it is placed on a map place yet. <b>That is a gap in this map, not a gap in the record.</b>
      Know a series or register it holds for a place? <a href={u("/add/")}>Tell us →</a></p>
      {near.length > 0 && (
        <p>On this map near the archive's address (where it is, not a list of what it holds):
          {near.map((p, i) => <>{i ? ", " : " "}<a href={u(`/place/${p.id}/`)}>{p.name}</a></>)}.</p>
      )}
    </div>
  )}

  <p class="k-pills" style="margin-top:30px"><a class="k-pill is-plain" href={u("/providers/")}>All sources</a>
    <a class="k-pill is-plain" href={u("/")}>The map</a></p>
</Base>

<style>
  .bigl { display: inline-flex; align-items: center; padding: 11px 20px; border-radius: 999px; background: var(--hue-solid, var(--accent));
          color: var(--on-hue, #fff); font: 700 15px/1.2 var(--sans); text-decoration: none; }
  .bigl:hover { filter: brightness(1.1); }
  .eras { list-style: none; padding: 0; margin: 6px 0 0; display: grid; gap: 4px; }
  .eras li { font-family: var(--sans); font-size: 12.5px; color: var(--ink-2); }
  .y { font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); }
  .trap { color: #C0392B; font-style: normal; font-size: 11.5px; }
  .places { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .places li { font-family: var(--sans); font-size: 13px; padding: 5px 6px 5px 13px; background: var(--hue-wash); border: 1px solid color-mix(in srgb, var(--hue, var(--accent)) 26%, transparent); border-radius: 999px; }
  .places li a { text-decoration: none; font-weight: 600; }
</style>
