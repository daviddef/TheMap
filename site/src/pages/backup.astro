---
/* CONNECTION & BACKUP: the one page for keeping your research safe.

   It opens from the pulsing dot in the header (green = a copy is kept online, orange = saved only in this browser, red =
   offline; a warning triangle joins the dot when something changed and no backup has been made for more than a day).

   Everything here was on /my-research/, between the family dossier and the buttons that mattered, and David asked for it to have
   a page of its own: «make it fun, intuitive, simple». So this page does three jobs in order: it SAYS in one line where the
   research is right now (the hero), it warns when that is risky (the amber bar), and it offers the ways to keep it safe as
   three cards, easiest first. The tiles under the hero are the same ways at a glance (this browser, a file, six words, share).

   Nothing here is built and nothing is sent: it reads this browser, as the header dot does (window.raConn, defined in Base.astro).
   The file logic is public/js/research-file.js (tested in test/research-backup.test.js); the six-word copy is
   components/ResearchSync.astro. The ids keep their old mr-* names because that is what the tests and the script were written
   against. */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import ProgressKit from "../components/ProgressKit.astro";
import ResearchSync from "../components/ResearchSync.astro";
---
<Base
  title="Connection &amp; Backup"
  eyebrow="Your research · where it lives and how to keep it safe"
  dek="Your research lives in this browser. Keep a copy somewhere safe. No account needed.">

  <ProgressKit />
  <script is:inline src={u("/js/research-file.js")}></script>

  <div class="bk">

    <section class="bk-hero" id="bk-hero" data-state="local" aria-live="polite">
      <div class="bk-orb" aria-hidden="true"><span class="bk-dot"></span></div>
      <div class="bk-hero-t">
        <h2 id="bk-h">Saved in this browser</h2>
        <p id="bk-p">Checking…</p>
      </div>
    </section>

    <div class="bk-warn" id="bk-warn" role="alert" hidden>
      <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path d="M8 1.6 15 14H1z" fill="#e8a200" stroke="#8a5a00" stroke-width="1" stroke-linejoin="round"/><path d="M8 6v4" stroke="#3b2600" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="12" r=".95" fill="#3b2600"/></svg>
      <p id="bk-warn-t"></p>
      <button type="button" id="bk-fix">Back up now</button>
    </div>

    <ul class="bk-tiles" aria-label="The four ways at a glance">
      <li><a href="#file"><b>This browser</b><span id="bk-t-here">Always on</span></a></li>
      <li><a href="#file"><b>A file</b><span id="bk-t-file">…</span></a></li>
      <li><a href="#sy"><b>Six words</b><span id="bk-t-sync">…</span></a></li>
      <li><a href="#share"><b>Share</b><span>Send a pack to someone</span></a></li>
    </ul>

    <section class="bk-card" id="file">
      <h2><span class="bk-n">1</span> Back up to a file <small>easiest, and you own it</small></h2>
      <p class="cap" data-th>One tap saves all your research. Keep the file somewhere safe. On another device, <b>Import</b> it: it merges, and nothing is replaced.</p>
      <div id="mr-safe">
        <p id="mr-status" class="mrstatus" role="status"></p>
        <p class="mrbtns">
          <button type="button" id="mr-export">Back up my research</button>
          <button type="button" id="mr-send" hidden>Send the file…</button>
          <button type="button" id="mr-import">Import a file</button>
          <input type="file" id="mr-file" accept="application/json,.json" hidden />
          <span id="mr-said" role="status" aria-live="polite"></span>
        </p>
        {/* WHERE THE FILE ACTUALLY GOES. A page cannot read your download folder and must not pretend to: what it CAN say for
            certain is the file's name, which it chooses, and that the browser puts it wherever downloads go. */}
        <p class="mrwhere3">Saved as <code id="mr-fname">record-atlas-research-…json</code>, usually in <b>Downloads</b>. Files from an older address of this site import too.</p>
        <p class="mrwhere3" id="mr-persist"></p>
      </div>
    </section>

    <section class="bk-card" id="online">
      <h2><span class="bk-n">2</span> Keep a copy online <small>six words, no account</small></h2>
      <ResearchSync />
      <script is:inline defer src={u("/js/sync-count.js")}></script>
    </section>

    <section class="bk-card" id="share">
      <h2><span class="bk-n">3</span> Share what you have found <small>with a cousin or fellow researcher</small></h2>
      <div id="mr-share">
        <p class="cap" data-th>A pack lists the volumes, pages and state of your work, by family line. No tree, no decisions; notes only if you tick them. The reader sees it as <b>reported by you, not checked</b> and can merge it into their own research.</p>
        <p class="mrbtns">
          <label>Share <select id="mr-pscope"></select></label>
          <label class="mrck"><input type="checkbox" id="mr-pnotes" /> Include my notes</label>
        </p>
        <p class="cap" id="mr-ppreview"></p>
        <p class="mrbtns">
          <button type="button" id="mr-pfile">Download the pack</button>
          <button type="button" id="mr-plink">Copy a link</button>
          <span id="mr-pnote" role="status" aria-live="polite"></span>
        </p>
      </div>
    </section>

    <section class="bk-card" id="lately">
      <h2>What changed lately <small>newest first</small></h2>
      <p class="bk-sub" id="ly-sum">Reading your marks…</p>
      <p class="mrbtns ly-bar">
        <label>Family line <select id="ly-line"><option value="">every line</option></select></label>
        <label>Show <select id="ly-src"><option value="">everything</option><option value="session">from research sessions</option><option value="here">marked here</option><option value="new">not in a saved copy yet</option></select></label>
      </p>
      <div id="ly-list" class="ly-list" aria-live="polite"></div>
      <p class="mrbtns"><button type="button" id="ly-more" hidden>Show 25 more</button></p>
    </section>

    <section class="bk-card" id="kept">
      <h2>What is kept with your research</h2>
      <p class="bk-sub">The file and the six-word copy carry all of this. Nothing is about a person except a MyHeritage link, if you pasted one.</p>
      <ul class="bk-kept">
        <li><b id="bk-k-marks">0</b> marks across <b id="bk-k-lines">0</b> family lines, with notes</li>
        <li><b id="bk-k-areas">0</b> saved map areas and <b id="bk-k-views">0</b> saved views <span class="bk-note">(shapes and positions only)</span></li>
        <li><span data-th>GEDCOM file <em>names</em></span> <span class="bk-note">(never the files)</span>
          <ul id="bk-k-ged" class="bk-ged"></ul></li>
        <li>MyHeritage link and Ancestry site: <span id="bk-k-sites" class="bk-note">none set</span></li>
        <li class="bk-no">Not kept: search history.</li>
      </ul>
    </section>

    <details class="bk-how">
      <summary>How this works</summary>
      <p class="cap" data-th><b>Your research lives in this browser only.</b> It was never sent to us. Clearing site data, a private window or a new machine will not find it.</p>
      <ul class="cap">
        <li data-th><b>Orange dot</b>: saved only here.</li>
        <li data-th><b>Green dot</b>: a copy is also kept online and this browser is connected.</li>
        <li data-th><b>Red dot</b>: offline. Your research is safe on this device.</li>
        <li data-th><b>Warning triangle</b>: changes with no backup for over 24 hours.</li>
      </ul>
      <p class="cap" data-th>The online copy is encrypted in your browser first; our server cannot read it. See <a href={u("/privacy/")}>privacy</a>. Your lines and marks are on <a href={u("/my-research/")}>My research</a>.</p>
    </details>
  </div>

  <script is:inline define:vars={{ BASE: u("/") }}>
    (function () {
      var P = window.raProgress, RF = window.raResearchFile;
      var $ = function (id) { return document.getElementById(id); };
      var said = $("mr-said");
      /* the language table's translator, for the few sentences this page joins from several parts (public/js/i18n.js); English when absent */
      var T = window.RA_T || function (x) { return x; };
      if (!P || !RF) return;
      var refresh = function () { document.dispatchEvent(new CustomEvent("ra-conn-refresh")); };
      var escH = function (t) { return String(t).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };

      /* ---- the hero, the warning and the tiles: the header dot's own reading (Base.astro), told in words ---- */
      function ago(ms) {
        if (ms == null) return "";
        var m = Math.floor(ms / 60000);
        if (m < 2) return "just now";
        if (m < 60) return m + " minutes ago";
        var h = Math.floor(m / 60);
        if (h < 24) return h + (h === 1 ? " hour" : " hours") + " ago";
        var d = Math.floor(h / 24);
        return d === 1 ? "yesterday" : d + " days ago";
      }
      var TEXT = {
        online: ["Connected, and a copy is kept online", "An encrypted copy is saved under your six words, so a new device can get it back."],
        local: ["Saved in this browser only", "Nothing has left this device. Back it up below so clearing your browser cannot take it."],
        offline: ["You are offline", "Your research is safe on this device. Backups wait until you are back online."]
      };
      function paint() {
        var c = window.raConn ? window.raConn.get() : null;
        if (!c) return;
        var hero = $("bk-hero"), t = TEXT[c.state];
        hero.setAttribute("data-state", c.state);
        $("bk-h").textContent = t[0];
        var W = window.raConn.when, bits = [];
        if (c.synced) bits.push(T(c.syncedAt ? "Last synced: " + W(c.syncedAt) + "." : "Not saved online yet."));
        bits.push(T(c.fileAt ? "Last file backup: " + W(c.fileAt) + "." : "No file backup yet."));
        var extra = " " + bits.join(" ");
        $("bk-p").textContent = T(t[1]) + extra;
        var warn = $("bk-warn");
        warn.hidden = !c.warn;
        if (c.warn) $("bk-warn-t").textContent = c.last
          ? "Changed since your last backup, " + ago(Date.now() - c.last) + "."
          : "Never backed up. This browser is the only copy.";
        $("bk-t-file").textContent = RF.backupStatus().never ? "Not yet" : RF.backupStatus().changed ? "Changes waiting" : "Up to date";
        $("bk-t-sync").textContent = c.synced ? "On" + (c.syncedAt ? ", synced " + W(c.syncedAt).replace(/ \(.*\)$/, "") : ", not saved yet") : "Off";
        /* RED when there is no backup at all, or changes have waited more than a day; amber for a gentler nudge */
        var st = RF.backupStatus(), red = c.warn || (st.never && st.changed) || st.level === "urgent";
        $("mr-status").textContent = c.warn && !c.last ? "Never backed up. This browser is the only copy." : c.warn ? "Changes are not backed up: the last backup was " + ago(Date.now() - c.last) + "." : st.text;
        $("mr-status").className = "mrstatus " + (red ? "urgent" : st.level);
        $("mr-status").hidden = !!c.warn;           /* the amber bar already says it */
      }
      function paintKept() {
        var cur = RF.current(), f = RF.exportAll().file, sm = RF.summary(f);
        $("bk-k-marks").textContent = sm.volumes; $("bk-k-lines").textContent = sm.lines; $("bk-k-areas").textContent = sm.areas; $("bk-k-views").textContent = sm.views;
        var ss = f.sites || {}, parts = [];
        if (ss.mh) parts.push(T("link to a MyHeritage profile")); if (ss.anc) parts.push("ancestry." + ss.anc);
        $("bk-k-sites").textContent = parts.length ? parts.join(", ") : T("none set");
        var g = (f.gedcoms || []), ul = $("bk-k-ged");
        ul.innerHTML = g.length ? g.map(function (x) {
          return "<li>" + escH(x.name) + ' <span class="bk-note">' + (x.saved ? escH(String(x.saved).slice(0, 10)) : "") + "</span></li>";
        }).join("") : '<li class="bk-note">None yet. Use \u201cRemember this file on this device\u201d on Roots &amp; Routes.</li>';
      }
      RF.refreshGedcomNames().then(paintKept); paintKept();
      document.addEventListener("ra-conn", paintKept);
      document.addEventListener("ra-conn", paint);

      $("bk-fix").addEventListener("click", function () {
        var c = window.raConn.get();
        var now = $("sy-now");
        if (c.synced && now && !$("sy-on").hidden) now.click(); else $("mr-export").click();
      });

      /* ---- the file ---- */
      var fn = $("mr-fname");
      if (fn) fn.textContent = "record-atlas-research-" + new Date().toISOString().slice(0, 10) + ".json";
      function showPersist(r) {
        var el = $("mr-persist");
        el.textContent = r === "yes" ? "This browser has agreed to keep this data unless you clear it yourself."
          : r === "no" ? "This browser may remove this data when it needs space. A backup file is the only safe copy." : "";
      }
      function saveFile(name, text) {
        var a = document.createElement("a");
        a.href = URL.createObjectURL(new Blob([text], { type: "application/json" }));
        a.download = name; a.click(); URL.revokeObjectURL(a.href);
      }
      $("mr-export").addEventListener("click", function () {
        var out = RF.exportAll(), sm = RF.summary(out.file);
        saveFile(out.name, out.text);
        RF.noteBackup("download");
        said.textContent = T("Backup file downloaded: " + out.name + " (look in your Downloads folder)") + " \u00b7 " + T(sm.volumes + " volumes") + ", " +
          T(sm.lines + (sm.lines === 1 ? " family line" : " family lines")) + (sm.decisions ? ", " + T(sm.decisions + " fix-it decisions") : "");
        RF.persist().then(showPersist);
        refresh();
      });
      var send = $("mr-send");
      try {
        if (navigator.canShare && navigator.canShare({ files: [new File(["{}"], "x.json", { type: "application/json" })] })) send.hidden = false;
      } catch (e) { /* no share sheet here */ }
      send.addEventListener("click", function () {
        var out = RF.exportAll();
        navigator.share({ files: [new File([out.text], out.name, { type: "application/json" })], title: "Record Atlas research backup" })
          .then(function () { RF.noteBackup("share"); said.textContent = "Shared " + out.name; refresh(); })
          .catch(function () { /* cancelled */ });
      });
      var file = $("mr-file");
      $("mr-import").addEventListener("click", function () { file.click(); });
      file.addEventListener("change", function () {
        var f = file.files && file.files[0];
        if (!f) return;
        var r = new FileReader();
        r.onload = function () {
          try {
            var res = RF.importText(String(r.result));
            said.textContent = T("Merged " + res.marks + " marks") + (res.decisions ? " " + T("and " + res.decisions + " fix-it decisions") : "") + " " + T("from " + f.name) +
              (res.kind === "record-atlas-pack" ? " " + T("(a shared pack: it is kept as its own family line)") : "");
            document.dispatchEvent(new CustomEvent("ra-progress-changed"));
          } catch (e) {
            said.textContent = "That is not a Record Atlas research file (an export, a pack, or a copy of browser storage).";
          }
          file.value = "";
        };
        r.readAsText(f);
      });

      /* ---- the pack ---- */
      var psel = $("mr-pscope"), pnotes = $("mr-pnotes"), pprev = $("mr-ppreview"), pnote = $("mr-pnote");
      function fillScope() {
        var cur = psel.value;
        psel.innerHTML = '<option value="">everything, every family line</option>' + P.lines().map(function (l) {
          return '<option value="' + escH(l.slug) + '">' + escH(l.name + (l.where ? " of " + l.where : "")) + "</option>";
        }).join("");
        psel.value = cur;
      }
      function currentPack() { return RF.pack({ line: psel.value || null, notes: pnotes.checked }); }
      function preview() {
        var sm = RF.summary(currentPack());
        pprev.textContent = T("This pack holds " + sm.volumes + " volumes (" + sm.pages + " pages) across " + sm.lines + (sm.lines === 1 ? " family line" : " family lines")) +
          (pnotes.checked ? ", " + T("with " + sm.notes + " of your notes: read them first, a note is where a name ends up") : ", " + T("without notes")) + ".";
      }
      $("mr-pfile").addEventListener("click", function () {
        saveFile("record-atlas-pack-" + (psel.value || "all") + "-" + new Date().toISOString().slice(0, 10) + ".json", JSON.stringify(currentPack(), null, 1));
        pnote.textContent = "Saved. Send the file to whoever should have it.";
      });
      $("mr-plink").addEventListener("click", function () {
        RF.encodeLink(currentPack()).then(function (t) {
          var url = location.origin + BASE + "shared/#pack=" + t;
          if (url.length > RF.LINK_MAX) { pnote.textContent = "Too big for a link (" + url.length + " characters). Download the pack and send the file."; return; }
          return navigator.clipboard.writeText(url).then(function () {
            pnote.textContent = "Link copied (" + url.length + " characters). The pack travels inside the link; nothing is stored on our server.";
          }, function () { pnote.textContent = url; });
        });
      });
      [psel, pnotes].forEach(function (x) { x.addEventListener("change", preview); });
      document.addEventListener("ra-progress-changed", function () { fillScope(); preview(); paint(); });
      fillScope(); preview(); paint();
      RF.persisted().then(function (p) { if (p) showPersist("yes"); });

      /* ---- what changed lately: the marks in this browser, newest first --------------------------------------------------
         Every mark already carries a date (`since`), a state, a family line and the volume's title, so this list needs nothing
         new stored. WHERE A ROW CAME FROM is not stored either: it is worked out by asking whether the published research file
         holds the same mark, line, date and state. If it does, the row came in from a research session; if not, it was marked
         in this browser. «Not in a saved copy yet» compares the row's date with the later of the last file backup and the
         last online save, so a row dated the same day as the backup is given the benefit of the doubt. */
      var LY = { n: 25, pub: null };
      var STATE = { found: "Found", searched: "Searched", exhausted: "Exhausted", blocked: "Blocked", written: "Written", planned: "Planned" };
      function pretty(w) { return String(w || "").replace(/[-_]+/g, " ").replace(/\b[a-z]/g, function (c) { return c.toUpperCase(); }); }
      function dayWord(d) {
        var today = new Date(), iso = function (x) { return x.toLocaleDateString("sv-SE"); };
        if (d === iso(today)) return T("Today");
        var y = new Date(today.getTime() - 864e5);
        if (d === iso(y)) return T("Yesterday");
        var p = d.split("-");
        return p.length === 3 ? Number(p[2]) + " " + ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][Number(p[1]) - 1] + " " + p[0] : d;
      }
      function pages(done) {
        return (done || []).map(function (r) { return r[0] === r[1] ? String(r[0]) : r[0] + "\u2013" + r[1]; }).join(", ");
      }
      function lastSafe() {
        var c = window.raConn ? window.raConn.get() : null, t = c ? Math.max(c.fileAt || 0, c.syncedAt || 0) : 0;
        return t ? new Date(t).toLocaleDateString("sv-SE") : "";
      }
      function lately() {
        var marks = P.all(), names = {}, rows = [], safe = lastSafe(), pub = LY.pub || {};
        P.lines().forEach(function (l) { names[l.slug] = l.name; });
        Object.keys(marks).forEach(function (k) {
          var m = marks[k], by = m.by || {};
          Object.keys(by).forEach(function (l) {
            var b = by[l];
            if (!b || !b.since) return;
            var q = pub[k] && pub[k].by && pub[k].by[l];
            rows.push({ k: k, l: l, since: String(b.since).slice(0, 10), state: b.state || "", note: b.note || "", done: b.done, t: m.t || k, where: m.where, href: m.href,
              session: !!(q && String(q.since).slice(0, 10) === String(b.since).slice(0, 10) && (q.state || "") === (b.state || "")),
              fresh: !!safe && String(b.since).slice(0, 10) > safe });
          });
        });
        var lsel = $("ly-line"), cur = lsel.value;
        lsel.innerHTML = '<option value="">every line</option>' + Object.keys(names).sort(function (a, b) { return names[a].localeCompare(names[b]); })
          .map(function (s) { return '<option value="' + escH(s) + '">' + escH(names[s]) + "</option>"; }).join("");
        lsel.value = cur;
        var src = $("ly-src").value, lf = lsel.value;
        var list = rows.filter(function (r) {
          return (!lf || r.l === lf) && (!src || (src === "session" ? r.session : src === "here" ? !r.session : r.fresh));
        });
        list.sort(function (a, b) { return a.since < b.since ? 1 : a.since > b.since ? -1 : a.t.localeCompare(b.t); });
        var newN = rows.filter(function (r) { return r.fresh; }).length, sesN = rows.filter(function (r) { return r.session; }).length;
        $("ly-sum").textContent = rows.length
          ? T(rows.length + " changes recorded") + ": " + T(sesN + " came in from research sessions") + ", " + T((rows.length - sesN) + " you marked here") +
            (safe ? ". " + (newN ? T(newN + " are newer than your last saved copy") : T("Everything is in your last saved copy")) + "." : ". " + T("No saved copy yet."))
          : "Nothing is marked yet. Marks you make on a place page, and work that comes in from research sessions, will be listed here.";
        var out = "", last = "";
        list.slice(0, LY.n).forEach(function (r) {
          if (r.since !== last) { out += '<h3 class="ly-d">' + escH(dayWord(r.since)) + "</h3>"; last = r.since; }
          var ok = r.href && /^(\/|https?:\/\/)/.test(r.href), title = escH(r.t);
          out += '<div class="ly-r"><div class="ly-t">' + (ok ? '<a href="' + escH(r.href) + '">' + title + "</a>" : title) +
            (r.where ? ' <span class="ly-w">' + escH(pretty(r.where)) + "</span>" : "") + "</div>" +
            '<div class="ly-m"><b>' + escH(names[r.l] || pretty(r.l)) + "</b>" +
            (r.state ? ' <span class="ly-s ly-' + escH(r.state) + '">' + escH(T(STATE[r.state] || r.state)) + "</span>" : "") +
            (pages(r.done) ? " <span>" + escH(T("pages") + " " + pages(r.done)) + "</span>" : "") +
            ' <span class="ly-o">' + escH(r.session ? T("from a research session") : T("marked here")) + "</span>" +
            (r.fresh ? ' <span class="ly-n">' + escH(T("not in a saved copy yet")) + "</span>" : "") + "</div>" +
            (r.note ? '<div class="ly-note">' + escH(String(r.note).replace(/[*`]+/g, "").slice(0, 220)) + "</div>" : "") + "</div>";
        });
        $("ly-list").innerHTML = out;
        var more = $("ly-more"); more.hidden = list.length <= LY.n;
        more.textContent = "Show " + Math.min(25, list.length - LY.n) + " more (" + (list.length - LY.n) + " older)";
      }
      $("ly-more").addEventListener("click", function () { LY.n += 25; lately(); });
      [$("ly-line"), $("ly-src")].forEach(function (x) { x.addEventListener("change", function () { LY.n = 25; lately(); }); });
      document.addEventListener("ra-progress-changed", lately);
      document.addEventListener("ra-conn", lately);
      lately();
      fetch(BASE + "research-sessions.json").then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { LY.pub = (d && d.marks) || {}; lately(); }).catch(function () { LY.pub = {}; });
    })();
  </script>
</Base>

<style>
  .bk { max-width: 56rem; display: grid; gap: 18px; }
  .bk :global(.cap), .bk :global(.mrsafe p) { max-width: none; }

  /* THE HERO: one big dot, one sentence. The dot pulses in the same colours as the header's. */
  .bk-hero { display: flex; gap: 18px; align-items: center; padding: 20px 22px; border: 1px solid var(--rule); border-radius: 10px;
    background: var(--panel); border-left: 6px solid #e8870e; }
  .bk-hero[data-state="online"] { border-left-color: #1f9d55; }
  .bk-hero[data-state="offline"] { border-left-color: #c0392b; }
