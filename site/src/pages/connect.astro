</Base>

<script is:inline src={u("/js/research-sync.js")}></script>
<script is:inline define:vars={{ API: api, SYNC: syncHost, AI: aiHost, P: u("/p/"), REG: u("/regions.json"), WORDS: u("/sync-words.json"), PROV: u("/providers.json") }}>
(function () {
  "use strict";
  function $(i) { return document.getElementById(i); }
  function esc(s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function pill(t, k) { return '<span class="chip s-' + esc(k || "") + '">' + esc(t) + "</span>"; }
  function getJSON(url, opt) { return fetch(url, opt).then(function (r) { if (!r.ok) throw new Error(r.status === 404 ? "no such file (404)" : "HTTP " + r.status); return r.json(); }); }
  function err(box, e) { box.innerHTML = '<p class="cx-bad"><b>Could not do that.</b> ' + esc(e && e.message || e) + "</p>"; }

  /* ---- live status of the three services ---- */
  function ping(url, id, label) {
    var el = $(id); if (!el) return;
    getJSON(url).then(function (j) { el.textContent = "answering"; el.className = "ok"; return j; }).catch(function () { el.textContent = (id === "st-api") ? "not reachable" : "answers recordatlas.org pages only"; el.className = (id === "st-api") ? "bad" : "ok"; });
  }
  ping(API + "/v1/health", "st-api"); ping(SYNC + "/v1/health", "st-sync"); ping(AI + "/v1/health", "st-ai");
  getJSON(SYNC + "/v1/count").then(function (j) { var g = $("gap-count"); if (g) g.textContent = j.registrations; }).catch(function () { var g = $("gap-count"); if (g) g.textContent = "2 (counted 12 Nov 2026; the live count is shown on recordatlas.org)"; });

  /* ---- 1 · sources for a place ---- */
  var plBox = $("pl-out"), provCache = null;
  function providers() { return provCache ? Promise.resolve(provCache) : getJSON(PROV).then(function (j) { var m = {}; (j.providers || []).forEach(function (p) { m[p.id] = p; }); provCache = { by: m, legend: j.access || {} }; return provCache; }); }
  function fetchPlace() {
    var id = $("pl-id").value.trim().toLowerCase().replace(/[^a-z0-9-]/g, "");
    if (!id) return;
    plBox.innerHTML = '<p class="cx-hint">fetching ' + esc(P + id + ".json") + " …</p>";
    Promise.all([getJSON(P + id + ".json"), providers()]).then(function (a) {
      var p = a[0], pv = a[1], cols = p.collections || [], vols = p.volumes || [];
      var h = '<p class="cx-meta"><b>' + esc(p.name) + "</b> · " + esc(p.country || "") + " · region <code>" + esc(p.region || "none") + "</code> · " + cols.length + " collections · " + vols.length + " volumes</p>";
      h += '<div class="scroll"><table class="cx-tbl"><thead><tr><th>Provider</th><th>Collection</th><th>Years</th><th>Cost to look</th></tr></thead><tbody>';
      cols.slice(0, 12).forEach(function (c) {
        var prov = pv.by[c.provider], nm = prov ? prov.name : c.provider;
        h += "<tr><td>" + esc(nm) + "</td><td>" + (c.url ? '<a href="' + esc(c.url) + '" rel="noopener">' + esc(c.title) + "</a>" : esc(c.title)) + "</td><td>" + esc((c.from || "") + (c.to && c.to !== c.from ? "–" + c.to : "")) + '</td><td><span class="acc a-' + esc(c.access) + '">' + esc(c.access || "?") + "</span></td></tr>";
      });
      h += "</tbody></table></div>" + (cols.length > 12 ? '<p class="cx-hint">… and ' + (cols.length - 12) + " more in the file.</p>" : "");
      if (vols.length) h += '<p class="cx-meta"><b>First volumes</b>: ' + vols.slice(0, 3).map(function (v) { return esc(v.t) + (v.waypoint ? " (<code>" + esc(v.waypoint) + "</code>)" : ""); }).join(" · ") + "</p>";
      h += '<p class="cx-hint">Open it in the Atlas: <a href="' + esc(P.replace("/p/", "/place/") + id + "/") + '">' + esc(p.name) + "</a></p>";
      plBox.innerHTML = h;
    }).catch(function (e) { err(plBox, e.message.indexOf("404") > -1 ? new Error("No place file called “" + id + "”. The id is the end of the place page's address.") : e); });
  }
  $("pl-go").addEventListener("click", fetchPlace);
  $("pl-id").addEventListener("keydown", function (e) { if (e.key === "Enter") fetchPlace(); });
  [].forEach.call(document.querySelectorAll("#try-places [data-p]"), function (b) { b.addEventListener("click", function () { $("pl-id").value = b.getAttribute("data-p"); fetchPlace(); }); });

  /* ---- 3 · names ---- */
  var nmBox = $("nm-out");
  function lookName() {
    var n = $("nm-in").value.trim(); if (!n) return;
    nmBox.innerHTML = '<p class="cx-hint">asking ' + esc(API + "/v1/given-name/" + n) + " …</p>";
    getJSON(API + "/v1/given-name/" + encodeURIComponent(n)).then(function (j) {
      if (!j.matches || !j.matches.length) { nmBox.innerHTML = '<p class="cx-hint">“' + esc(n) + "” is not in the catalogue. That means nobody has added it, not that it is not a name.</p>"; return; }
      var h = j.ambiguous ? '<p class="cx-meta"><b>' + j.matches.length + " names answer to “" + esc(n) + "”.</b> Pick the one you mean.</p>" : "";
      j.matches.slice(0, 3).forEach(function (m) {
        h += '<div class="cx-name"><p class="cx-meta"><b>' + esc(m.canonical) + "</b> · " + m.forms + " forms in " + Object.keys(m.languages || {}).length + ' languages · <a href="' + esc(m.page || "#") + '">its page in the Atlas</a></p>';
        var langs = Object.keys(m.languages || {}).slice(0, 8);
        langs.forEach(function (L) {
          h += '<div class="cx-lang"><span class="cx-l">' + esc(L) + "</span> " + (m.languages[L] || []).slice(0, 10).map(function (f) { return '<span class="frm st-' + esc(f.status) + '" title="' + esc(f.status + (f.seen ? ", met " + f.seen + " times" : "")) + '">' + esc(f.form) + "</span>"; }).join(" ") + "</div>";
        });
        h += "</div>";
      });
      h += '<p class="cx-hint"><span class="frm st-attested">seen</span> met on a record · <span class="frm st-lead">lead</span> right form, never met · <span class="frm st-rule">rule</span> made by grammar</p>';
      nmBox.innerHTML = h;
    }).catch(function (e) { err(nmBox, e); });
  }
  $("nm-go").addEventListener("click", lookName);
  $("nm-in").addEventListener("keydown", function (e) { if (e.key === "Enter") lookName(); });
  [].forEach.call(document.querySelectorAll("#try-names [data-n]"), function (b) { b.addEventListener("click", function () { $("nm-in").value = b.getAttribute("data-n"); lookName(); }); });

  /* ---- 4 · eras ---- */
  var erBox = $("er-out"), regCache = null;
  function regions() { return regCache ? Promise.resolve(regCache) : (function () { $("er-busy").hidden = false; return getJSON(REG).then(function (j) { $("er-busy").hidden = true; regCache = j; return j; }); })(); }
  function whoGoverned() {
    var id = $("er-id").value.trim().toLowerCase().replace(/[^a-z0-9-]/g, ""), yr = parseInt($("er-year").value, 10);
    if (!id || !yr) return;
    erBox.innerHTML = '<p class="cx-hint">reading the place, then its region …</p>';
    getJSON(P + id + ".json").then(function (p) {
      if (!p.region) { erBox.innerHTML = '<p class="cx-hint"><b>' + esc(p.name) + "</b> is not inside a mapped region, so the Atlas stays silent about who governed it. (That is on purpose: a wrong answer here sends someone to the wrong archive.)</p>"; return null; }
      return Promise.all([p, regions(), providers()]);
    }).then(function (a) {
      if (!a) return;
      var p = a[0], RJ = a[1], pv = a[2], r = (RJ.regions || []).filter(function (x) { return x.id === p.region; })[0], RG = RJ.regimes || {};
      if (!r) { erBox.innerHTML = '<p class="cx-bad">Region “' + esc(p.region) + "” is not in regions.json.</p>"; return; }
      var eras = r.eras || [], hit = eras.filter(function (e) { return e.from <= yr && (e.to == null || yr < e.to); });
      function lab(e) { return (RG[e.regime] && RG[e.regime].label) || e.regime; }
      function col(e) { return "var(--r-" + esc(e.regime) + ", #b9b7ad)"; }
      var lo = Math.min.apply(null, eras.map(function (e) { return e.from; })), hi = 2026, span = Math.max(1, hi - lo);
      var bar = '<div class="cx-time" role="img" aria-label="Timeline of eras">' + eras.map(function (e) {
        var l = (e.from - lo) / span * 100, w = ((e.to == null ? hi : e.to) - e.from) / span * 100, on = hit.indexOf(e) > -1;
        return '<span class="seg' + (on ? " on" : "") + '" style="left:' + l.toFixed(2) + "%;width:" + Math.max(w, 0.6).toFixed(2) + "%;background:" + col(e) + '" title="' + esc(e.from + "–" + (e.to == null ? "now" : e.to) + " " + lab(e)) + '"></span>';
      }).join("") + '<span class="mark" style="left:' + Math.min(100, Math.max(0, (yr - lo) / span * 100)).toFixed(2) + '%"><i>' + yr + "</i></span></div>";
      var h = '<p class="cx-meta"><b>' + esc(p.name) + "</b> sits in <b>" + esc(r.label) + "</b> (" + eras.length + " eras, " + lo + " to now). In <b>" + yr + "</b>:</p>" + bar;
      if (!hit.length) h += '<p class="cx-hint">No era covers ' + yr + " in this region. Before " + lo + " the table starts nowhere; the Atlas says nothing rather than guessing.</p>";
      hit.forEach(function (e) {
        h += '<div class="cx-era" style="border-color:' + col(e) + '"><p><b>' + esc(e.polity) + '</b> <span class="chip">' + esc(lab(e)) + "</span></p><p>" + e.from + "–" + (e.to == null ? "now" : e.to) + "</p>" +
          "<p><b>Records filed under:</b> " + ((e.filedUnder || []).length ? e.filedUnder.map(function (f) { var q = pv.by[f]; return esc(q ? q.name : f); }).join(" · ") : "nobody yet (the Atlas knows no archive for these years)") + "</p>" +
          (e.note ? '<p class="cx-hint">' + esc(String(e.note).slice(0, 260)) + "</p>" : "") + "</div>";
      });
      h += '<p class="cx-hint">Open the table in the Atlas: <a href="' + esc(P.replace("/p/", "/region/") + r.id + "/") + '">' + esc(r.label) + "</a></p>";
      erBox.innerHTML = h;
    }).catch(function (e) { $("er-busy").hidden = true; err(erBox, e); });
  }
  $("er-go").addEventListener("click", whoGoverned);

  /* ---- 2 · the six words (nothing is sent) ---- */
  var kdOut = $("kd-out");
