---
/* THE PAGE THAT SAYS HOW TO PLUG INTO THE ATLAS, FOR SOMEBODY WHO HAS NEVER DONE IT.
 *
 * /data/ lists the files and their licences, which is the right page for somebody who already knows what a JSON file is. This is
 * the other half: four things a researcher wants to DO (read the sources for a place, keep their own progress, use every spelling
 * of a name, ask who governed a place in a year), each as a short recipe with a "try it" that calls the real file or service from
 * this page, so what is on the screen is what the interface answers today, not a description of it.
 *
 * AND IT SAYS WHAT DOES NOT EXIST. The last section is a list of gaps found while writing it (no CORS on the data files, no
 * place-name lookup over the API, no way to add a single mark...). A page that only described what works would send somebody to build
 * on a door that is painted on. Every claim here was checked against the live services on 12 Nov 2026 or against the code that serves
 * them; nothing is promised that is not shipped.
 *
 * Counts are read from the shipped files at build time, so they cannot drift.
 */
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import { SERVICES } from "../lib/api-reference.js";
import { u } from "../lib/url.js";
import regions from "../../public/regions.json";
import provs from "../../public/providers.json";
import ctx from "../../public/context.json";
import gn from "../../public/given-names.json";
import sf from "../../public/surname-families.json";
import idx from "../../public/index.json";

const PUB = fs.existsSync(path.join(process.cwd(), "public")) ? path.join(process.cwd(), "public") : path.join(process.cwd(), "site", "public");
const nPlaceFiles = (() => { try { return fs.readdirSync(path.join(PUB, "p")).filter((f) => f.endsWith(".json")).length; } catch { return 0; } })();
const N = (n) => Number(n).toLocaleString("en-GB");
const cnt = ctx.counts || {};
const api = "https://api.recordatlas.org";
const syncHost = "https://sync.recordatlas.org";
const aiHost = "https://ai.recordatlas.org";
const ver = (ctx.contract && ctx.contract.version) || "";

/* THE FILE LIST ON THIS PAGE. One row per file somebody could want, grouped by the QUESTION they have, each with a command that
   was run against the live site on 19 Nov 2026 and answered. Sizes are read from the shipped files at build time, never typed.
   Every file here has an address on recordatlas.org (scripts/build-open-data.py publishes the catalogues that used to be GitHub-only). */
const H = "https://recordatlas.org";
const sz = (f) => { try { const n = fs.statSync(path.join(PUB, f)).size; return n >= 1048576 ? (n / 1048576).toFixed(1) + " MB" : Math.max(1, Math.round(n / 1024)) + " KB"; } catch { return ""; } };
const nMort = (() => { try { return JSON.parse(fs.readFileSync(path.join(PUB, "mortality.json"), "utf8")).events.length; } catch { return 0; } })();
const GROUPS = [
  { id: "f-records", q: "Where can I look for records?", rows: [
    { f: "providers.json", what: `WHO. One row per archive or website (${N(provs.providers.length)}): what it holds and what it costs to look. Start here for "which archives exist for Croatia, and which are free?".`,
      cmd: `curl -s ${H}/providers.json | jq '.providers[] | select(.countries | index("HR")) | {name, access, url}'` },
    { f: "p/senj.json", what: "WHAT, for one place. The collections (sets of records) and the individual books (volumes) that cover it, with years, cost and a link. One small file per place; the id is the end of the place page's address.",
      cmd: `curl -s ${H}/p/senj.json | jq '.collections[] | {provider, title, from, to, access}'` },
    { f: "coverage-by-country.json", what: "For each country: the years the books cover, and how many volumes and places. Where you could look, not where your family was.",
      cmd: `curl -s ${H}/coverage-by-country.json | jq '.countries.HR | {from, to, volumes, places}'` },
    { f: "collections.json", what: "WHAT, across a whole country. 3,504 FamilySearch record collections with their years and how many records and images each holds. Country-wide ones (the IGI, a whole country's church books) live only here. FamilySearch's catalogue metadata: no licence is stated for it, so read their terms before reusing it at scale.",
      cmd: `curl -s ${H}/collections.json | jq '.collections[] | select(.countries | index("HR")) | {title, from, to, records}'` },
    { f: "directory.json", what: "969 collections people and archives contributed, one row per named collection at a named repository: what it holds, the years, the cost and a link. CC0.",
      note: "A small, contributed list (60 countries; the US has 504 rows, Britain 103, Italy 43), so it has no rows for Croatia. That says nothing about the Atlas's Croatian coverage, which is large: look in providers.json, coverage-by-country.json and the place files (see the Croatia walk-through below).",
      cmd: `curl -s ${H}/directory.json | jq '.rows[] | select(.countries | index("IT")) | {repo, name, access}'` },
    { f: "provider-contacts.json", what: "Where to write to an archive that does not publish its images (only what Wikidata states). Keyed by the provider's Wikidata id.",
      cmd: `curl -s ${H}/provider-contacts.json | jq '.counts'` },
  ] },
  { id: "f-eras", q: "Who governed this place, in which year?", rows: [
    { f: "regions.json", what: "Record regions, each a table of eras: the polity that held the ground and the archives its paper went to. The part nobody else publishes.",
      cmd: `curl -s ${H}/regions.json | jq '.regions[] | select(.id == "kvarner") | .eras[] | {from, to, polity, filedUnder}'` },
    { f: "context.json", what: "The same eras with permanent ids, evidence and a list of gaps. Use this one if you are building something that must not break.",
      cmd: `curl -s ${H}/context.json | jq '.contract'` },
    { f: "flag-index.json", what: "Every country's flag page, with the region and the hub it is filed under. Era detail is in flag-eras.json and era-flags.json.",
      cmd: `curl -s ${H}/flag-index.json | jq '.counts'` },
    { f: "history.json", what: "Conquests, occupations, migrations, voyages and expeditions, each with dates, a start and an end point, and sources.",
      cmd: `curl -s ${H}/history.json | jq '.moves | length'` },
  ] },
  { id: "f-names", q: "What else might this name be called?", rows: [
    { f: "given-names.json", what: "Given names, every form in every language (Ivan, Johann, Giovanni, Zuane, Joannes). Each form says whether a record showed it, it is only a lead, or a grammar rule makes it.",
      cmd: `curl -s ${H}/given-names.json | jq '.rows[] | select(.id == "giovanni") | {canon, forms, langs: (.langs | keys)}'` },
    { f: "surname-families.json", what: "Surname spellings that are one family (Lerena, Llerena, Serena…), and the look-alikes that are NOT.",
      cmd: `curl -s ${H}/surname-families.json | jq '.rows[] | select(.name == "Lerena") | .forms'` },
    { f: "s/leh.json", what: "The big surname register, in small files named by the first three letters of a name: which countries have it, and which spellings are linked to it.",
      cmd: `curl -s ${H}/s/leh.json | jq '.[] | select(.n == "Lehmann") | {n, variants: [.variants[].n]}'` },
    { f: "surnames.csv.gz", what: "The whole surname register in one file, for a spreadsheet or a database. A JSON copy sits beside it (surnames.json.gz).",
      cmd: `curl -O ${H}/surnames.csv.gz` },
    { f: "API: given-name/Ivan", url: "https://api.recordatlas.org/v1/given-name/Ivan", what: "One given name answered directly, without downloading the file. Also register words (/v1/term) and old date styles (/v1/date).",
      cmd: `curl -s https://api.recordatlas.org/v1/given-name/Ivan | jq '.matches[0]'` },
  ] },
  { id: "f-places", q: "What was this place called, and where is it?", rows: [
    { f: "place-names.json", what: "What a place was called in a given year: Salisbury 1890–1982 is Harare. Dated, each with the page that dates it. Search a register under the name of its year.",
      cmd: `curl -s ${H}/place-names.json | jq '.places[] | select(.id == "harare") | .names[] | {name, from, to, kind}'` },
    { f: "g/zag.json", what: "The place-name search: every other name a place is known by (Zagreb is also Agram and Zagabria). Small files named by the first three letters of a name.",
      cmd: `curl -s ${H}/g/zag.json | jq '.[0] | {name: .[0], country: .[3], also: .[4]}'` },
    { f: "index.json", what: "The map's list of places (id, name, position, how many books). The busiest places only; the rest are in the pi/ files and index-quiet.json.",
      cmd: `curl -s ${H}/index.json | jq '.places[0:3]'` },
  ] },
  { id: "f-mass", q: "What wars, plagues and famines touched this place?", rows: [
    { f: "mortality.json", what: `${nMort ? N(nMort) + " " : ""}mass-death events (epidemics, famines, wars, massacres, forced removals): the years, a map outline, the countries, the estimated deaths with the range scholars give, and the sources. The outline is a rough area, not a boundary.`,
      cmd: `curl -s ${H}/mortality.json | jq '.events[] | select((.cc // []) | index("HR")) | {n, ty, f, t}'` },
  ] },
  { id: "f-points", q: "Which archives, churches, cemeteries and libraries are near here?", rows: [
    { f: "world-archives.json", what: "Archives at their street address.", cmd: `curl -s ${H}/world-archives.json | jq 'keys'` },
    { f: "archives-wikidata.json", what: "A wider set of archives from Wikidata. Not checked by hand.", cmd: `curl -s ${H}/archives-wikidata.json | jq 'keys'` },
    { f: "archives-osm.json", what: "Archives from OpenStreetMap. Share-alike licence: see the licence list on the data page.", cmd: `curl -s ${H}/archives-osm.json | jq 'keys'` },
    { f: "cemeteries-wikidata.json", what: "Cemeteries from Wikidata. A second set, from OpenStreetMap, is cemeteries-osm.json (share-alike).", cmd: `curl -s ${H}/cemeteries-wikidata.json | jq 'keys'` },
    { f: "churches-wikidata.json", what: "Churches from Wikidata, useful for finding a parish.", cmd: `curl -s ${H}/churches-wikidata.json | jq 'keys'` },
    { f: "libraries-wikidata.json", what: "Libraries from Wikidata.", cmd: `curl -s ${H}/libraries-wikidata.json | jq 'keys'` },
  ] },
  { id: "f-mine", q: "What have researchers already done?", rows: [
    { f: "research-sessions.json", what: "The books and sources the family archives have searched and what they found: marks only, no names. Your own copy is a different thing: see door 2.",
      cmd: `curl -s ${H}/research-sessions.json | jq '.archives | keys'` },
  ] },
];
---
<Base
  title="Connect to the Atlas"
  eyebrow="Read it · write your research to it · from a spreadsheet, a script, or an AI assistant"
  dek="Seven things you can do with the Atlas's data without opening the website, each as a short recipe you can try on this page. And the things that do not work yet, listed honestly.">

  <div class="k-stats" id="cx-status" aria-live="polite">
    <span class="k-tag">Read API <b id="st-api">checking…</b></span>
    <span class="k-tag">Sync <b id="st-sync">checking…</b></span>
    <span class="k-tag">Ask&nbsp;Claude <b id="st-ai">checking…</b></span>
    <span><b>{N(nPlaceFiles)}</b> place files</span>
    <span><b>{N(cnt.regionEras || 0)}</b> jurisdiction eras</span>
    <span><b>{N(gn.totalForms || 0)}</b> given-name forms</span>
  </div>

  <div class="k-hi">
    <p><b>You do not need to be a programmer to start.</b> The Atlas keeps everything in plain files with web addresses. A web address
    you can paste into a browser is already an API. The harder doors (saving your own research) are explained step by step below, and the
    page will show you exactly what your computer would send, without sending anything.</p>
  </div>

  <h2 class="k-h" id="doors">Pick your door <span class="k-count">what you want to do</span></h2>
  <ul class="k-tiles cx-doors">
    <li><a href="#places"><b>1 · What sources can I read for a place?</b></a><span>Archives, registers and year-ranges for one village. Read-only, no login.</span></li>
    <li><a href="#research"><b>2 · Keep my own research progress</b></a><span>Write "I searched this book, found it" from your own tool. Needs the six words.</span></li>
    <li><a href="#names"><b>3 · Use every spelling of a name</b></a><span>Ivan is Johann is Giovanni. Ask once, search them all.</span></li>
    <li><a href="#eras"><b>4 · Who governed this place in 1850?</b></a><span>Places, countries, flags and their eras, with the years, the polity and the archive that filed them.</span></li>
    <li><a href="#country"><b>5 · Everything for one country</b></a><span>A walk-through for Croatia: find the archives, years, places, eras and flag, with each address and what comes back.</span></li>
    <li><a href="#files"><b>6 · Every file, with its curl</b></a><span>Names, places, wars and plagues, archives, cemeteries. One line each, and providers or collections explained.</span></li>
    <li><a href="#api"><b>7 · How each API works</b></a><span>Addresses, formats, how a POST works, the MCP server, and what each one answers when it goes wrong.</span></li>
  </ul>

  <h2 class="k-h" id="files">Every file, and the one line that fetches it <span class="k-count">no key, no login</span></h2>
  <p class="k-lede">Everything the Atlas shows is a plain file with a web address. To use one, paste its line into a terminal (<code>curl</code> fetches the file;
    <code>jq</code> picks out the part you want), or paste just the address into a browser. Each line below was run against the live site and answers.
    A file's size is shown so you are not surprised.</p>

  <div class="k-hi is-plain" id="which">
    <p><b>Providers or collections?</b> They are two different things.</p>
    <ul class="cx-simple">
      <li><b><code>providers.json</code> is WHO.</b> An archive or website, such as FamilySearch or a state archive, with what it costs to look.</li>
      <li><b>A collection is WHAT.</b> One set of records inside a provider, such as "Croatia, Catholic Church Books 1678–1941", with its years and size. Each row in a place file's <code>collections</code> names its provider by the id in <code>providers.json</code>.</li>
      <li><b>So:</b> starting from a <i>place</i>? Read <code>/p/&lt;id&gt;.json</code>. Starting from an <i>archive</i> or a <i>cost</i>? Read <code>providers.json</code>. Want the country-wide FamilySearch collections? Read <code>collections.json</code>.</li>
    </ul>
  </div>

  {GROUPS.map((g) => (
    <>
      <h3 class="cx-h3" id={g.id}>{g.q}</h3>
      <div class="scroll"><table class="cx-tbl cx-files">
        <thead><tr><th>File</th><th>What it is</th><th>Fetch it</th></tr></thead>
        <tbody>
          {g.rows.map((r) => (
            <tr>
              <td><a href={r.url || (H + "/" + r.f)} rel="noopener"><code>{r.f}</code></a>{sz(r.f) && <><br /><span class="cx-hint">{sz(r.f)}</span></>}</td>
              <td>{r.what}{r.note && <p class="cx-hint cx-note"><b>Note.</b> {r.note}</p>}</td>
              <td><pre class="cx-pre cx-cmd">{r.cmd}</pre></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </>
  ))}

  <p class="cx-see"><b>Licences and the full list</b> (including the small per-place and per-name files): <a href={u("/data/")}>Use the data</a>. Files change shape when the site needs them to; read the field you need and ignore the rest.</p>


  <h2 class="k-h" id="country">Everything for one country: Croatia, step by step <span class="k-count">worked example · every line was run on 19 Nov 2026</span></h2>
  <p class="k-lede">You want <b>all the Atlas knows about a country</b>. There is no single "country file", so you ask seven small questions, each answered by one address.
    Swap <code>HR</code> (the two-letter country code) and <code>croatia-flags</code> for your country and the same lines work. Output is trimmed to a few rows; the shape of each row is what to look at.</p>
  <ol class="k-steps cx-walk">
    <li><b>Which archives and websites hold records? <span class="cx-hint">the live API, JSON</span></b>
      <pre class="cx-pre" set:text={`curl -s "https://api.recordatlas.org/v1/providers?country=HR&limit=100"
{ "total": 49,
  "providers": [
    { "id": "acta-croatica", "name": "Acta Croatica", "kind": "index", "access": "mixed", "countries": ["HR"], "url": "…", "what": "…" },
    { "id": "anno",          "name": "ANNO — Austrian Newspapers Online", "kind": "library", "access": "free", … },
    { "id": "arhinet",       "name": "ARHiNET — Croatian State Archives", "kind": "national-archive", "access": "catalogue", … } ] }`}></pre>
      <span class="cx-hint">Format: one object per source (without <code>&amp;limit=</code> you get the first 20 of the <code>total</code>). <code>access</code> says what it costs: <code>free</code> (6), <code>account</code> (2), <code>onsite</code> (8), <code>unsurveyed</code> (20)… The same list is in <code>providers.json</code>, filtered with <code>jq '.providers[] | select(.countries | index("HR"))'</code>.</span></li>
    <li><b>Which years do the books cover? <span class="cx-hint">a file, JSON</span></b>
      <pre class="cx-pre" set:text={`curl -s https://recordatlas.org/coverage-by-country.json | jq '.countries.HR | {from, to, volumes, places, kinds}'
{ "from": 1516, "to": 1994, "volumes": 5361, "places": 1154, "kinds": ["civil","church","census","military"] }`}></pre>
      <span class="cx-hint">Add <code>.decades</code> to the <code>jq</code> to get volumes per decade (1850s: 2,709), which draws the histogram on the country page.</span></li>
    <li><b>Which whole-country FamilySearch collections exist? <span class="cx-hint">a file, JSON</span></b>
      <pre class="cx-pre" set:text={`curl -s https://recordatlas.org/collections.json | jq '.collections[] | select(.countries | index("HR")) | {title, from, to, records, images}'
{ "title": "Croatia, Church Books, 1516-1994", "from": 1515, "to": 1994, "records": 7007772, "images": 1421761 }
{ "title": "Croatia, Delnice Deanery Catholic Church Books, 1571-1926", "from": 1570, "to": 1926, "records": 233088, "images": 3485 }`}></pre>
      <span class="cx-hint">Only two, because most Croatian books are catalogued as individual volumes per place (step 5), not as one country-wide collection.</span></li>
    <li><b>Which places? <span class="cx-hint">files by map square, JSON</span></b>
      <pre class="cx-pre" set:text={`curl -s https://recordatlas.org/pi/45_15.json | jq '[.places[] | select(.cc == "HR")] | sort_by(-(.v // 0)) | .[0:3] | map({i, n, y, x, v})'
[ { "i": "zagreb-hr", "n": "Zagreb",  "y": 45.8156,  "x": 15.9881,  "v": 66 },
  { "i": "vukovar",   "n": "Vukovar", "y": 45.34536, "x": 19.00604, "v": 40 },
  { "i": "osijek",    "n": "Osijek",  "y": 45.55355, "x": 18.69058, "v": 36 } ]`}></pre>
      <span class="cx-hint">Format: <code>i</code> is the place id, <code>n</code> the name, <code>y</code>/<code>x</code> latitude/longitude, <code>v</code> the volumes. There is no search-by-country call yet, so you read the squares the country sits in: Croatia's places are in <code>pi/45_10</code>, <code>pi/45_15</code>, <code>pi/40_10</code> and <code>pi/40_15</code>. (Filename = the south-west corner of a 5-degree square.) Or just open <a href={u("/country/hr/")}>the country page</a>.</span></li>
    <li><b>What exactly can I read for one place? <span class="cx-hint">one small file per place</span></b>
      <pre class="cx-pre" set:text={`curl -s https://recordatlas.org/p/senj.json | jq '{region, collections: (.collections | length), volumes: (.volumes | length)}'
{ "region": "vojna-krajina", "collections": 10, "volumes": 7 }

curl -s https://recordatlas.org/p/senj.json | jq '.collections[0] | {provider, title, from, to, access}'
{ "provider": "familysearch", "title": "Births (Rođeni) 1734-1756", "from": 1734, "to": 1756, "access": "account" }`}></pre>
      <span class="cx-hint">The id is the one from step 4 (<code>zagreb-hr</code>, <code>senj</code>…). Its <code>region</code> leads to step 6.</span></li>
    <li><b>Who governed it, and which archive got its paper? <span class="cx-hint">a file, JSON</span></b>
      <pre class="cx-pre" set:text={`curl -s https://recordatlas.org/regions.json | jq '.regions[] | select(.id == "vojna-krajina") | .eras[0:2] | map({from, to, regime, polity, filedUnder})'
[ { "from": 1553, "to": 1746, "regime": "habsburg", "polity": "Habsburg military frontier, under Graz and Vienna", "filedUnder": ["arhinet","familysearch"] },
  { "from": 1746, "to": 1848, "regime": "habsburg", "polity": "Habsburg — the regiment system", "filedUnder": ["arhinet","familysearch","anno"] } ]`}></pre>
      <span class="cx-hint">A year equal to a boundary belongs to the newer era. <code>filedUnder</code> are provider ids from step 1. For the country as a whole (18 eras) use <code>context.json</code>: <code>jq '.countries[] | select(.cc == "HR") | .eras'</code>.</span></li>
    <li><b>Which flags, in which years? <span class="cx-hint">a file, JSON, plus a page</span></b>
      <pre class="cx-pre" set:text={`curl -s https://recordatlas.org/flag-index.json | jq '.countries[] | select(.name == "Croatia") | {name, region, hub, flags: (.crowns | length)}'
{ "name": "Croatia", "region": "Balkans", "hub": "Former Yugoslavia", "flags": 18 }`}></pre>
      <span class="cx-hint">The era-by-era flags, with their dates, are in <code>context.json</code> (<code>{'.countries[] | select(.cc == "HR") | .eras[] | {dates, polity, url}'}</code>), and the page for each is at <a href={u("/flags/croatia-flags/")}>/flags/croatia-flags/</a>.</span></li>
  </ol>
  <p class="cx-see"><b>Not country-tagged.</b> Wars and plagues (<code>mortality.json</code>) and migrations (<code>history.json</code>) are drawn as shapes and routes with dates, not filed under a country code, so a country filter would be a guess. To find the ones that touched Croatia, read their dates and shapes against the eras above.
    <b>Names</b> are not per country either: see <a href="#names">door 3</a>.</p>

  <h2 class="k-h">The whole picture <span class="k-count">four services, one website built on them</span></h2>
  <figure class="cx-fig">
    <svg viewBox="0 0 880 330" role="img" aria-labelledby="map-t map-d">
      <title id="map-t">How a program talks to the Atlas</title>
      <desc id="map-d">Your tool on the left reaches four services on the right. Data files and the read API are read-only. Sync stores an encrypted copy of your research. Ask Claude reads a pasted line of a register.</desc>
      <defs><marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="var(--ink-3)"/></marker></defs>
      <rect x="12" y="95" width="170" height="140" rx="14" class="svg-box"/>
      <text x="97" y="135" text-anchor="middle" class="svg-h">Your tool</text>
      <text x="97" y="157" text-anchor="middle" class="svg-s">spreadsheet</text>
      <text x="97" y="175" text-anchor="middle" class="svg-s">script · app</text>
      <text x="97" y="193" text-anchor="middle" class="svg-s">AI assistant</text>
      <text x="97" y="216" text-anchor="middle" class="svg-s">your browser</text>

      <g>
        <rect x="330" y="8" width="250" height="68" rx="12" class="svg-read"/>
        <text x="345" y="32" class="svg-h2">Data files</text><text x="345" y="52" class="svg-s">recordatlas.org/p/senj.json …</text>
        <text x="345" y="68" class="svg-s2">READ · no key · {N(nPlaceFiles)} place files</text>
        <rect x="330" y="88" width="250" height="68" rx="12" class="svg-read"/>
        <text x="345" y="112" class="svg-h2">Read API + MCP</text><text x="345" y="132" class="svg-s">api.recordatlas.org/v1/…</text>
        <text x="345" y="148" class="svg-s2">READ · no key · 5 tools</text>
        <rect x="330" y="168" width="250" height="68" rx="12" class="svg-write"/>
        <text x="345" y="192" class="svg-h2">Sync</text><text x="345" y="212" class="svg-s">sync.recordatlas.org/v1/&lt;id&gt;</text>
