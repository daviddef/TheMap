---
/* One page per country the catalogue reaches — 93 of them.

   The harvest went worldwide and the map had nowhere to put it. A country is
   the right unit for that: big enough that there are only ninety-three, small
   enough that each one is a real answer to "where do I start with Portugal".
   It gathers everything this map knows about one country in one place — the
   collections, the institutions, the record regions and the places — which is
   more than any single layer of the map can show at once. */
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import full from "../../data/places-full.json";
import cols from "../../data/collections-full.json";
import dir from "../../data/directory.json";
import regions from "../../../public/regions.json";
import provs from "../../../public/providers.json";
import { atlas as idx } from "../../lib/atlas.js";

export async function getStaticPaths() {
  /* One shared list — see site/src/lib/country-pages.js for why. */
  const { COUNTRY_PAGES } = await import("../../lib/country-pages.js");
  return [...COUNTRY_PAGES].map((cc) => ({ params: { cc: cc.toLowerCase() },
                                           props: { cc } }));
}

const { cc } = Astro.props;
const NAME = (idx.countries || {})[cc] || cc;
/* CAPPED, AND ORDERED BY WHAT IS ON THEM. Italy's page listed all 2,372 of
   its places and was 536 KB — half a megabyte for one page, on a phone, and
   growing every time the matcher places another town. The alphabetical order
   made it worse: it opened on Abano Terme and Abbadia, so the places with
   the most records were somewhere in the middle of a list nobody scrolls.
   The heaviest shelves first, the rest counted and linked. */
const PLACE_CAP = 250;
const hereAll = full.places.filter((p) => p.country === cc)
  .sort((a, b) => ((b.collections || []).length - (a.collections || []).length)
                  || a.name.localeCompare(b.name));
const here = hereAll.slice(0, PLACE_CAP);
const hereHidden = hereAll.length - here.length;
/* GROUPED BY THE GROUND THEY COVER, NOT BY HOW BIG THEY ARE. This was one
   flat list, regional collections first and then by record count — so South
   Africa's thirty-two ran Cape, Transvaal, Cape, Natal, Transvaal in an order
   that looked like no order at all. A collection names its province in the
   place it is filed under; that is the thing a researcher already knows about
   their family, and the only sensible way to divide the list. */
const province = (c) => {
  const local = (c.places || []).filter((p) => p.type && p.type !== "COUNTRY");
  if (!local.length) return null;
  /* The place name is a chain narrowing outwards — "Johannesburg,
     Witwatersrand, Transvaal, South Africa" — so the province is the segment
     before the country, whatever depth the place itself sits at. A PROVINCE
     row is already exactly that and survives the same rule. */
  const parts = String(local[0].name || "").split(",").map((x) => x.trim()).filter(Boolean);
  return parts.length >= 2 ? parts[parts.length - 2] : (local[0].short || null);
};
const mine = cols.collections.filter((c) => c.countries.includes(cc))
  .map((c) => ({ c, local: !!province(c), reg: province(c) }));
const byRegion = [];
{
  const bag = new Map();
  for (const row of mine) {
    const k = row.reg || "\u0000national";
    if (!bag.has(k)) bag.set(k, []);
    bag.get(k).push(row);
  }
  for (const [k, rows] of bag) {
    rows.sort((a, b) => a.c.title.localeCompare(b.c.title));
    byRegion.push({ label: k === "\u0000national" ? `${NAME} — nationwide` : k,
                    national: k === "\u0000national", rows });
  }
  /* Regions alphabetically, and the nationwide indexes last: they cover
     everywhere, so they answer a narrower question than the province a family
     actually came from. */
  byRegion.sort((a, b) => (a.national === b.national
    ? a.label.localeCompare(b.label) : a.national ? 1 : -1));
}
/* THE CONTRIBUTED DIRECTORY, grouped by what kind of record each row is.
   David's own CSV. Country rows only — the 26 rows tagged Global would
   otherwise repeat identically on all 97 country pages and say nothing about
   any of them. Every link here was tried on the date shown and 430 of the
   original 1,399 were dropped for not answering at all. */
const KIND_LABEL = {
  church: "Church and parish registers", cemetery: "Cemeteries and burials",
  census: "Censuses and population lists", military: "Military and wartime",
  migration: "Immigration and emigration", probate: "Probate, land and notarial",
  civil: "Civil registration and vital records", minority: "Jewish and minority",
  archives: "General historical archives",
};
const KIND_ORDER = ["church", "civil", "census", "probate", "military",
                    "migration", "cemetery", "minority", "archives"];
const contributed = (dir.rows || []).filter((r) => r.countries.includes(cc));
const byKind = KIND_ORDER
  .map((k) => ({ k, label: KIND_LABEL[k],
                 rows: contributed.filter((r) => r.tags.includes(k))
                                  .sort((a, b) => a.repo.localeCompare(b.repo)) }))
  .filter((g) => g.rows.length);
const untagged = contributed.filter((r) => !r.tags.length);

const who = provs.providers.filter((p) => p.countries.includes(cc));
const world = provs.providers.filter((p) => p.countries.includes("*"));
/* Same correction as /coverage/: a country's regions are the ones whose GROUND
   lies in it, whether or not a place inside them has been walked. */
const regs = regions.regions.filter(
  (r) => (r.countries || []).includes(cc) || hereAll.some((p) => p.region === r.id));
const records = mine.reduce((a, x) => a + (x.c.records || 0), 0);
/* Every count here is about the COUNTRY, so it comes from the full set.
   Only the rendered list is capped — reading a total off the capped list
   would have printed "2,372 places, 4,118 volumes" where the volumes were
   the top 250's alone. */
const vols = hereAll.reduce((a, p) => a + (p.collections || []).length, 0);
const span = mine.filter(x => x.c.from).length
  ? [Math.min(...mine.filter(x => x.c.from).map(x => x.c.from)),
     Math.max(...mine.filter(x => x.c.to).map(x => x.c.to))] : null;

/* «RECORDS IN BOLIVIA» IS THE QUESTION AND THE PAGE ANSWERED WITH FOUR
   LISTS. Everything needed was on the page already — collections, archives,
   providers, regions, places — and a reader had to read all of it and do
   the arithmetic themselves to learn the only things they came for: is
   there anything I can open tonight, who do I have to write to, and what
   does this atlas simply not know here.

   Every sentence below is computed from the same data the lists render, so
   it cannot claim coverage the page does not show. In particular it says
   the unknown parts OUT LOUD: a country with archives and no walked places
   is a country where nobody has been through the paper, and a summary that
   glossed that would be the map implying completeness it has not got. */
const freeNow = who.filter((p) => p.access === "free");
const acctNow = who.filter((p) => p.access === "account");
const idxOnly = who.filter((p) => p.access === "index");
const paidish = who.filter((p) => p.access === "paid" || p.access === "mixed");
const onsite  = who.filter((p) => p.access === "onsite" || p.access === "catalogue");
/* 317 OF 516 PROVIDERS ARE `unsurveyed` AND THE FIRST DRAFT OF THIS SUMMARY
   COUNTED THEM AS THE DENOMINATOR. It would have read «2 of 19 sources can
   be opened tonight» for a country whose other seventeen have simply never
   been looked at — a sentence that reads as a judgement on the country's
   archives and is actually a report on our own idleness. Unsurveyed is its
   own number, said out loud, and it is never in the bottom of a fraction. */
const unsurv  = who.filter((p) => p.access === "unsurveyed" || !p.access);
const graded  = who.filter((p) => p.access && p.access !== "unsurveyed");
const natl    = who.filter((p) => p.kind === "national-archive"
                              || p.kind === "national-library");
const openable = freeNow.length + acctNow.length + idxOnly.length;
const worldFree = world.filter((p) => p.access === "free" || p.access === "account");
const nf = (n) => n.toLocaleString();
---
<Base
  title={NAME}
  eyebrow={[`${mine.length} FamilySearch collection${mine.length === 1 ? "" : "s"}`,
            who.length ? `${who.length} archive${who.length === 1 ? "" : "s"}` : null,
            hereAll.length ? `${hereAll.length.toLocaleString()} place${hereAll.length === 1 ? "" : "s"}` : null,
            span ? `${span[0]}–${span[1]}` : null].filter(Boolean).join(" · ")}
  dek={`Where the records of ${NAME} are, who holds them, and what it costs to look. ${records.toLocaleString()} indexed records reachable through FamilySearch alone.`}>

  <div class="one" style="margin-top:20px">
    <div class="lab">Where to start in {NAME}</div>
    <p><b>{!who.length
        ? `This atlas holds no source of its own for ${NAME} yet`
        : openable > 0
          ? `${nf(openable)} of the ${nf(graded.length)} checked ${graded.length === 1 ? "source" : "sources"} here can be opened tonight`
          : graded.length
            ? `None of the ${nf(graded.length)} checked ${graded.length === 1 ? "source" : "sources"} here can be opened from a keyboard`
            : `Nothing here has been checked for what it costs to look`}.</b>{" "}
      {freeNow.length > 0 && <>{nf(freeNow.length)} {freeNow.length === 1 ? "is" : "are"} free
        images with no account. </>}
      {acctNow.length > 0 && <>{nf(acctNow.length)} need{acctNow.length === 1 ? "s" : ""} a
        free account. </>}
      {idxOnly.length > 0 && <>{nf(idxOnly.length)} {idxOnly.length === 1 ? "is" : "are"} an
        index with no images. </>}
      {paidish.length > 0 && <>{nf(paidish.length)} {paidish.length === 1 ? "is" : "are"} paid
        or part-paid. </>}
      {onsite.length > 0 && <>{nf(onsite.length)} {onsite.length === 1 ? "is a catalogue card or paper in a building" : "are catalogue cards or paper in a building"} —
        a letter, not a click. </>}
      {worldFree.length > 0 && <>On top of that, {nf(worldFree.length)} worldwide services
        reach {NAME} without a subscription.</>}</p>

    {unsurv.length > 0 && (
      <p class="cap"><b>{nf(unsurv.length)} more {unsurv.length === 1 ? "institution is" : "institutions are"} listed
        here and {unsurv.length === 1 ? "has" : "have"} never been checked</b> — nobody has
        opened {unsurv.length === 1 ? "it" : "them"}, written to {unsurv.length === 1 ? "it" : "them"},
        or found out what {unsurv.length === 1 ? "it holds" : "they hold"}. They are on the
        map as grey because that is what they are, and the honest reading of this page is
        {" "}{nf(openable)} known-open, {nf(unsurv.length)} unknown.</p>
    )}

    <p class="cap">{natl.length > 0
      ? <>Write to <b>{natl.map((p) => p.name).join(", ")}</b> for what is not online.{" "}</>
      : <>No national archive is recorded here yet, which is a gap in this atlas and
         not a statement about {NAME}.{" "}</>}
      {mine.length > 0
        ? <>FamilySearch has {nf(mine.length)} collection{mine.length === 1 ? "" : "s"} covering
          it{span ? <>, running {span[0]}–{span[1]}</> : null}
          {records > 0 ? <>, {nf(records)} indexed records</> : null}.{" "}</>
        : <>FamilySearch has no catalogued collection for {NAME} in this atlas.{" "}</>}
      {regs.length > 0
        ? <>{regs.length === 1 ? "One piece" : `${regs.length} pieces`} of this ground
          {" "}{regs.length === 1 ? "is" : "are"} mapped for jurisdiction, so the atlas can
          say whose archive held it in a given year.</>
        : <>No jurisdiction region covers {NAME} yet, so this atlas cannot say whose archive
          held this ground in a given year — and it will not guess.</>}</p>

    <p class="cap">{hereAll.length > 0
      ? <><b>{nf(hereAll.length)} place{hereAll.length === 1 ? "" : "s"} placed, {nf(vols)} volume{vols === 1 ? "" : "s"} walked.</b>{" "}
        {vols === 0 && <>Not one of them has had its paper counted yet, so treat the shelf here as
          a list of somewhere to look rather than a list of what survives.</>}</>
      : <><b>No place in {NAME} has been walked.</b> The archives above are real and the shelf
        below is empty — which means nobody has been through the paper, not that there is
        none.</>}
      {" "}<a href={u(`/?q=${encodeURIComponent(NAME)}`)}>Open {NAME} on the map</a>, or{" "}
      <a href={u("/add/")}>tell us what is missing</a>.</p>
  </div>

  {regs.length > 0 && (
    <section style="margin-top:26px">
      <h2>Whose archive this ground was</h2>
      <p class="cap">Record regions mapped in {NAME} — which empire held the ground, and
      therefore which archive holds its paper.</p>
      <ul class="regs">
        {regs.map((r) => (
          <li><a href={u(`/region/${r.id}/`)}>{r.label}</a>
            <span class="y">{r.eras.length} eras</span>
            <span class="sub">{r.sub}</span></li>
        ))}
      </ul>
    </section>
  )}

  {who.length > 0 && (
    <section style="margin-top:30px">
      <h2>The archives</h2>
      <ul class="rows">
        {who.map((p) => (
          <li><a href={u(`/archive/${p.id}/`)}>{p.name}</a>
            <span class={"chip acc-" + p.access}>{p.access}</span>
            {p.at && <span class="y">{p.at.place}</span>}
            <p class="what">{p.what}</p></li>
        ))}
      </ul>
      <p class="cap" style="margin-top:10px">And {world.length} worldwide providers
      reach {NAME} too — <a href={u("/providers/")}>the full list</a>.</p>
    </section>
  )}

  {mine.length > 0 && (
    <section style="margin-top:34px">
      <h2>{mine.length} FamilySearch collections</h2>
      <p class="cap">Grouped by the ground each one covers, {byRegion.filter(g => !g.national).length > 0
        ? "province by province, with the nationwide indexes last" : "nationwide"}.
      A free account opens the images; some are restricted to a Family History Centre.</p>
      {byRegion.map((g) => (
        <div class="cgrp">
          <div class="lab">{g.label} <span class="n">{g.rows.length}</span></div>
          <ul class="rows">
            {g.rows.map(({ c }) => (
              <li>
                <a href={c.url} target="_blank" rel="noopener">{c.title} ↗</a>
                {c.from && <span class="y">{c.from}–{c.to}</span>}
                <span class="y">{(c.records || 0).toLocaleString()} records</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  {contributed.length > 0 && (
    <section style="margin-top:34px">
      <h2>{contributed.length} more collections, contributed</h2>
      <p class="cap">A directory David assembled, sorted by what kind of record each
      one is. <b>Read this differently from the rest of the page.</b> The descriptions
      are his, not an archive's catalogue, and nobody here has opened the volumes
      behind them. Every link was tried on {dir.checked} and answered; the ones that
      did not are not listed.</p>
      {byKind.map((g) => (
        <div class="cgrp">
          <div class="lab">{g.label} <span class="n">{g.rows.length}</span></div>
          <ul class="rows">
            {g.rows.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener">{r.name} ↗</a>
                <span class="y">{r.repo}</span>
                {r.from && <span class="y">{r.from}–{r.to}</span>}
                {r.access !== "free" && <span class={"chip acc-" + r.access}>{r.access}</span>}
                {r.gated && <span class="y" title="This address answered our checker by refusing it, which many archives do to any script while serving people perfectly well.">refuses scripts</span>}
                <p class="what">{r.what}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {untagged.length > 0 && (
        <div class="cgrp">
          <div class="lab">Kind not stated <span class="n">{untagged.length}</span></div>
          <ul class="rows">
            {untagged.map((r) => (
              <li><a href={r.url} target="_blank" rel="noopener">{r.name} ↗</a>
                <span class="y">{r.repo}</span>
                <p class="what">{r.what}</p></li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )}

  {hereAll.length > 0 ? (
    <section style="margin-top:34px">
      <h2>{hereAll.length.toLocaleString()} places, {vols} volumes</h2>
      {hereHidden > 0 && (
        <p class="cap">The {here.length} carrying the most collections are listed;
        <b> {hereHidden.toLocaleString()} more</b> are in {NAME} and on the map.
        <a href={u("/places/")}> Every place</a> lists them all.</p>
      )}
      <ul class="places">
        {here.map((p) => <li><a href={u(`/place/${p.id}/`)}>{p.name}</a>
          <span class="y">{(p.collections || []).length}</span></li>)}
      </ul>
    </section>
  ) : (
    <div class="one" style="margin-top:34px;border-left-color:var(--rule-strong)">
      <div class="lab">No places walked here yet</div>
      <p class="cap">The shelf — the volume-by-volume layer — has not been walked in {NAME}.
      <b>That is a gap in this map, not a gap in the record</b>: the collections above reach
      this ground and are worth opening. <a href={u("/add/")}>Help fill it →</a></p>
    </div>
  )}

  <p class="cap" style="margin-top:30px"><a href={u("/countries/")}>Every country</a> ·
    <a href={u("/")}>The map</a></p>
</Base>

<style>
  h2 { font-family: var(--serif); font-size: 26px; font-weight: 500; margin: 0 0 6px; }
  .rows, .regs { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 7px; }
  .rows li, .regs li { font-family: var(--sans); font-size: 13px; line-height: 1.5; }
  .what { font-size: 11.5px; color: var(--ink-3); margin: 3px 0 0; max-width: 78ch; }
  .sub { display: block; font-size: 11.5px; color: var(--ink-3); }
  .y { font-family: var(--mono); font-size: 11px; color: var(--ink-3); margin-left: 8px; }
  .loc { font-family: var(--sans); font-size: 10px; color: var(--accent);
         border: 1px solid var(--accent); border-radius: 999px; padding: 1px 6px; margin-left: 8px; }
  .cgrp { margin-top: 18px; }
  .cgrp .lab { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
  .cgrp .lab .n { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3);
                  letter-spacing: 0; font-weight: 400; }
  .places { list-style: none; padding: 0; margin: 12px 0 0;
            display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 3px; }
  .places li { font-family: var(--sans); font-size: 13px; }
  .chip { margin-left: 8px; }
  .chip.acc-free { background:#1E844922; color:#1E8449 } .chip.acc-account { background:#6FA82E22; color:#5C8C26 }
  .chip.acc-index { background:#EFC03B33; color:#8A6B10 } .chip.acc-mixed { background:#E8792B22; color:#B45A17 }
  .chip.acc-paid { background:#C0392B22; color:#C0392B } .chip.acc-catalogue { background:#8E6FA822; color:#7A5CA8 }
  .chip.acc-onsite { background:#7C8A9122; color:#5E6C73 }
</style>
