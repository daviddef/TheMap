---
/* The flags atlas index — 211 countries and 34 hubs — inside the atlas shell.
 *
 * It wears the same header as every other page now (a title, a one-line dek, the counts as a pill), so the lifted page's own kicker,
 * h1 and lede are taken out, and the hubs come BEFORE the country grid: David followed «#hubsHeadingEl» to find them, at the bottom of
 * a 211-card page. The explanation of the badges is folded, not deleted. */
import Base from "../../layouts/Base.astro";
import { page } from "../../lib/flag-pages.js";

const f = page("index");
let html = f.html
  .replace(/<p class="kicker">[\s\S]*?<\/p>/, "")
  .replace(/<h1>[\s\S]*?<\/h1>/, "")
  .replace(/<p class="lede">[\s\S]*?<\/p>/, "");
const nHubs = (html.match(/class="hub-card"/g) || []).length;
const ci = html.indexOf('<div class="countries-section">');
const hi = html.indexOf('<div class="hubs-section">');
const ai = html.indexOf('<div class="about">');
if (ci > 0 && hi > ci && ai > hi) {
  html = html.slice(0, ci) + html.slice(hi, ai) + html.slice(ci, hi) + html.slice(ai);
  html = html.replace('<div class="about">\n    <h2>How this index works</h2>', '<details class="about"><summary>How this index works</summary>');
  html = html.replace(/(<details class="about">[\s\S]*?)<\/div>(\s*<footer>)/, "$1</details>$2");
}
html = html.replace('" hubs · " + HUB_COUNTRIES_COVERED + " countries covered)"', '")"');
html = html.replace("<h2 id=\"hubsHeadingEl\">The hubs</h2>", "<h2 id=\"hubsHeadingEl\">Regions and empires</h2>");
---
<Base title="Flags" wide
      eyebrow={`211 countries · ${nHubs} regions and empires`}
      dek="Who ruled where, and what flag flew over it. Search a country, a crown or an empire.">
  <style is:inline set:html={f.css}></style>
  <div class="flagpage" set:html={html}></div>
</Base>
