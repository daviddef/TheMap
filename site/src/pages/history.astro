---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import hist from "../../public/history.json";

/* THE SECOND ROOM. The records map answers «what survives for this place?».
   This answers «what was happening to the ground, and who was doing it?» — the
   conquests, occupations and migrations the flag pages already record, played
   over time. It is a page of its own, not a layer in the records map, because
   the records map's year control starts at 1500 (nothing is filmed earlier)
   and is wired to filtering 21,000 places; history starts in the 600s and
   filters nothing.

   THE DATA IS site/public/history.json, built by scripts/build-history.py from
   era-moves.json: every movement with a start and an end point. An arrow
   between two countries is drawn between their label anchors; an arrow to an
   empire or a people is drawn from the SEAT it ruled from or the country it
   came from; anything else is a stub and says so. See that script for the
   rules, and notes/84-history-theatre-plan.md for where this is going
   (leaders, discoverers, the ground changing colour). */
const BASE = u("/");
const CH = hist.chapters;
---
<Base
  title="History"
  wide
  eyebrow="Conquest · occupation · migration"
  dek="Watch the ground change hands. Every arrow is something a flag page in this atlas says happened: an army that came, a people who left, a state that took another. Pick a chapter, or drag the years.">

  <div class="hm" id="hm" data-base={BASE}>
    <div class="hm-chapters" role="group" aria-label="Chapters">
      <button type="button" class="hm-chip hm-all" id="hm-tour-btn"
              title="Play every era in turn, from the first Islamic conquests to the present">
        <b>&#9654; Play all eras</b><i>one after another</i>
      </button>
      {CH.map((c) => (
        <button type="button" class="hm-chip" data-ch={c.id}
                title={`${c.from}–${c.to}: ${c.blurb}`}>
          <b>{c.title}</b><i>{c.from}–{c.to}</i>
        </button>
      ))}
    </div>

    <div class="hm-stage">
      <div class="hm-map" id="hm-map" role="application"
           aria-label="Map of conquests, occupations and migrations in the selected years"></div>
      <div class="hm-hud">
        <div class="hm-year" id="hm-year" aria-live="off">1914</div>
        <div class="hm-ch" id="hm-ch"></div>
        <section class="hm-list" id="hm-listw">
          <h2><span id="hm-list-h">Under way</span>
            <button type="button" id="hm-list-fold" aria-expanded="true" title="Fold the list away">&#9662;</button></h2>
          <ol id="hm-list"></ol>
        </section>
        <div class="hm-gnote" id="hm-gnote"></div>
      </div>
      <div class="hm-era" id="hm-era" hidden></div>

      <div class="hm-load" id="hm-load">Loading the movements&hellip;</div>
    </div>

    <div class="hm-bar">
      <button type="button" class="hm-play" id="hm-play" aria-pressed="false"
              title="Play or pause (space)">&#9654;</button>
      <div class="hm-scrub">
        <svg class="hm-dens" id="hm-dens" viewBox="0 0 1000 40" preserveAspectRatio="none"
             aria-hidden="true"></svg>
        <input type="range" id="hm-range" min="600" max="2026" value="1914" step="1"
               aria-label="Year" />
        <div class="hm-ticks" id="hm-ticks" aria-hidden="true"></div>
      </div>
      <label class="hm-tour"><input type="checkbox" id="hm-tour" checked /> Continue to the next era</label>
      <label class="hm-speed">Speed
        <select id="hm-speed" aria-label="Playback speed">
          <option value="8">Very fast &mdash; 8 years a second</option>
          <option value="4">Fast &mdash; 4 years a second</option>
          <option value="2">Medium &mdash; 2 years a second</option>
          <option value="1">Slow &mdash; 1 year a second</option>
          <option value="0.5" selected>Very slow &mdash; 1 year every 2 seconds</option>
          <option value="0.2">Crawl &mdash; 1 year every 5 seconds</option>
        </select>
      </label>
    </div>

    <div class="hm-layers" role="group" aria-label="Layers">
      <label><input type="checkbox" id="hm-l-conquest" checked /> <i class="k conquest"></i>Conquest</label>
      <label><input type="checkbox" id="hm-l-occupation" checked /> <i class="k occupation"></i>Occupation</label>
      <label><input type="checkbox" id="hm-l-migration" checked /> <i class="k migration"></i>Migration</label>
      <label><input type="checkbox" id="hm-l-voyages" checked /> <i class="k voyage"></i>Voyages</label>
      <label><input type="checkbox" id="hm-l-ground" checked /> Who held the ground</label>
      <label><input type="checkbox" id="hm-l-flags" /> Flags in this year</label>
      <label><input type="checkbox" id="hm-l-leaders" /> Heads of state (zoom in)</label>
      <label>Trail
        <select id="hm-trail" aria-label="How many years an arrow stays on the map">
          <option value="15">15 years</option>
          <option value="30" selected>30 years</option>
          <option value="60">60 years</option>
          <option value="120">120 years</option>
        </select>
      </label>
    </div>

    <div class="hm-below">
      <section class="hm-card" id="hm-card" aria-live="polite">
        <h2>Choose an arrow</h2>
        <p>Click any arrow or dot to read what the flag page says, and open the page it came from.</p>
        <p class="hm-fine">An arrow to a country joins the two countries' label points. An arrow to an empire or a people starts at the seat it ruled from or the country it came from. A dashed stub means the page names no second place. None of these is a route.</p>
      </section>
    </div>
  </div>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <link rel="stylesheet" href={u("/history-theatre.css")} />
  <script is:inline src={u("/js/history-theatre.js")} defer></script>
  <script is:inline src={u("/js/history-map.js")} defer></script>
</Base>

<style is:global>
  .hm { --hm-conquest:#B3442E; --hm-occupation:#C9792B; --hm-migration:#2E6F8E;
        display:grid; gap:12px; margin-top:12px; }
  .hm-chapters { display:flex; gap:8px; overflow-x:auto; padding:2px 0 6px;
                 scrollbar-width:thin; scrollbar-color:var(--accent, #1F5C6B) transparent; }
  .hm-chip { flex:0 0 auto; display:flex; flex-direction:column; align-items:flex-start;
             gap:1px; padding:7px 12px; border:1px solid var(--rule-strong, #bbb);
             border-radius:10px; background:var(--panel, #fff); color:var(--ink, #16222A);
             font:inherit; cursor:pointer; text-align:left; }
  .hm-chip b { font-size:.9rem; font-weight:600; }
  .hm-chip i { font-style:normal; font-size:.75rem; opacity:.7; font-variant-numeric:tabular-nums; }
  .hm-chip:hover, .hm-chip:focus-visible { border-color:var(--accent, #1F5C6B); }
  .hm-chip[aria-current="true"] { background:var(--accent, #1F5C6B); color:#fff; border-color:var(--accent, #1F5C6B); }
  .hm-stage { position:relative; border:1px solid var(--rule-strong, #bbb); border-radius:12px;
              overflow:hidden; background:var(--panel, #f2f2f2); }
  .hm-map { height:min(72vh, 700px); min-height:360px; background:#cfd8dc; }
  .hm-map .leaflet-tile-pane { filter:grayscale(.9) contrast(.88) brightness(1.06); opacity:.9; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hm-map { background:#1b2428; }
    :root:not([data-theme="light"]) .hm-map .leaflet-tile-pane { filter:grayscale(1) invert(1) contrast(.82) brightness(.72); }
  }
  :root[data-theme="dark"] .hm-map { background:#1b2428; }
  :root[data-theme="dark"] .hm-map .leaflet-tile-pane { filter:grayscale(1) invert(1) contrast(.82) brightness(.72); }
  .hm-hud { position:absolute; left:14px; top:12px; z-index:500; pointer-events:none;
            text-shadow:0 0 6px var(--panel, #fff), 0 0 2px var(--panel, #fff); }
  .hm-year { font:700 clamp(2.4rem, 7vw, 4.4rem)/1 var(--font-display, Georgia, serif);
             color:var(--ink, #16222A); font-variant-numeric:tabular-nums; }
  .hm-ch { font-size:.95rem; color:var(--ink, #16222A); max-width:34ch; margin-top:4px; }
  .hm-gnote { font-size:.75rem; margin-top:6px; max-width:34ch; opacity:.8; }
  .hm-load { position:absolute; inset:0; display:grid; place-items:center; z-index:600;
             background:color-mix(in srgb, var(--panel, #fff) 80%, transparent);
             color:var(--ink, #16222A); }
  .hm-load[hidden] { display:none; }
  .hm-bar { display:grid; grid-template-columns:auto 1fr auto; gap:12px; align-items:center; }
  .hm-play { width:44px; height:44px; border-radius:50%; border:1px solid var(--accent, #1F5C6B);
             background:var(--accent, #1F5C6B); color:#fff; font-size:1.05rem; cursor:pointer; }
  .hm-play:focus-visible { outline:3px solid var(--accent, #1F5C6B); outline-offset:2px; }
  .hm-scrub { position:relative; padding-top:42px; min-width:0; }
  .hm-dens { position:absolute; left:0; right:0; top:0; width:100%; height:40px; }
  .hm-dens rect { fill:var(--accent, #1F5C6B); opacity:.55; }
  .hm-dens rect.on { opacity:.95; }
  #hm-range { width:100%; accent-color:var(--accent, #1F5C6B); margin:0; }
  .hm-ticks { position:relative; height:18px; font-size:.7rem; color:var(--ink, #16222A); opacity:.7; }
  .hm-ticks span { position:absolute; transform:translateX(-50%); font-variant-numeric:tabular-nums; }
  .hm-speed { font-size:.8rem; display:grid; gap:2px; }
  .hm-tour { font-size:.85rem; display:inline-flex; gap:6px; align-items:center; }
  .hm-chip.hm-all { border-color:var(--accent, #1F5C6B); }
  .hm-layers { display:flex; flex-wrap:wrap; gap:6px 18px; align-items:center; font-size:.9rem; }
  .hm-layers label { display:inline-flex; gap:6px; align-items:center; }
  .hm-layers .k { display:inline-block; width:18px; height:4px; border-radius:2px; }
  .k.conquest { background:var(--hm-conquest); } .k.occupation { background:var(--hm-occupation); }
  .k.migration { background:var(--hm-migration); } .k.voyage { background:#7A4FA3; }
  .hm-below { display:grid; grid-template-columns:minmax(0,1fr); gap:16px; }
  @media (max-width:760px) { .hm-below { grid-template-columns:1fr; } .hm-bar { grid-template-columns:auto 1fr; } .hm-speed { grid-column:1 / -1; } }
  /* ONE TRANSLUCENT COLUMN ON THE LEFT, UNDER THE BIG YEAR. David: the year, the era, and the events rolling
     below them in the same panel, scrollable, not a second box on the other side of the map. The list's grid
     must not stretch its rows to fill the column (that was the big gaps between the items). On a phone the
     column is shorter and the list starts folded. */
  .hm-hud { top:12px; bottom:12px; left:12px; width:min(340px, 40%); display:flex; flex-direction:column; gap:0;
    padding:10px 14px 12px; border-radius:12px; text-shadow:none;
    background:color-mix(in srgb, var(--panel, #fff) 74%, transparent); backdrop-filter:blur(3px);
    -webkit-backdrop-filter:blur(3px); }
  .hm-hud .hm-list { pointer-events:auto; flex:1 1 auto; min-height:0; display:flex; flex-direction:column;
    background:none; border:0; padding:0; margin-top:8px; border-top:1px solid var(--rule-strong, #bbb); border-radius:0; }
  .hm-hud .hm-list h2 { margin:8px 0 4px; font-size:.95rem; }
  .hm-hud .hm-list ol { flex:1 1 auto; min-height:0; max-height:none; align-content:start; grid-auto-rows:min-content; gap:2px; }
  .hm-hud .hm-list li button { padding:4px 6px; font-size:.86rem; line-height:1.3; }
  .hm-hud .hm-list li small { font-size:.74rem; }
  .hm-hud .hm-gnote { font-size:.68rem; margin-top:6px; }
  .hm-list h2 { display:flex; justify-content:space-between; align-items:center; gap:8px; }
  .hm-list h2 button { border:0; background:none; font-size:1rem; cursor:pointer; color:inherit; padding:0 4px; }
  .hm-list.fold ol { display:none; }
  .hm-hud:has(.hm-list.fold) { bottom:auto; }
  .hm-list.fold { flex:0 0 auto; }
  .hm-list li button.hm-major { font-weight:600; }
  @media (max-width:760px) { .hm-hud { bottom:auto; width:min(300px, calc(100% - 70px)); max-height:78%; }
    .hm-hud .hm-gnote { display:none; } .hm-hud .hm-list ol { max-height:150px; } }
  .hm-card, .hm-list { background:var(--panel, #fff); border:1px solid var(--rule-strong, #bbb);
                       border-radius:12px; padding:14px 16px; min-width:0; }
  .hm-card h2, .hm-list h2 { margin:0 0 6px; font-size:1.05rem; }
  .hm-card p { margin:.4em 0; }
  .hm-fine { font-size:.8rem; opacity:.75; }
  .hm-list ol { list-style:none; margin:0; padding:0; display:grid; gap:4px; max-height:280px; overflow:auto; align-content:start; }
  .hm-list li button { width:100%; text-align:left; background:none; border:0; padding:5px 6px; font:inherit;
                       color:inherit; cursor:pointer; border-left:4px solid var(--c, #999); border-radius:2px; }
  .hm-list li button:hover, .hm-list li button:focus-visible { background:color-mix(in srgb, var(--c, #999) 14%, transparent); }
  .hm-list li small { display:block; opacity:.7; font-variant-numeric:tabular-nums; }
</style>
