---
import Base from "../layouts/Base.astro";
import RecordMap from "../components/RecordMap.astro";
import ProgressKit from "../components/ProgressKit.astro";
import VolumeMarks from "../components/VolumeMarks.astro";
import StoryDrawer from "../components/StoryDrawer.astro";
import { u } from "../lib/url.js";
import { atlas as idx } from "../lib/atlas.js";
import regions from "../../public/regions.json";
import { places, NEWS_KIND, latestNews, newsDay, volumes, placeCountries, countries, withPlaces, archives, archiveCountries, inventoryRows } from "../lib/inventory.js";

---
{/* STRUCTURED DATA ON THE ONE PAGE THAT HAD NONE. Place, surname and archive
    pages have carried a schema.org block for a while; the front page, which is
    the page a search engine meets first and the one that has to say what this
    site IS, carried nothing.

    Three things are declared and all three are facts this page already prints:
    the site and its publisher, the SearchAction that tells a search engine the
    search box exists and how to use it, and the atlas as a Dataset — which is
    what it is, and which is how somebody looking for «where are the parish
    registers for X» should be able to reach it. The counts are the same
    variables the header renders, so they cannot drift from what a reader sees. */}
<Base
  bare
  title="Record Atlas"
  dek="Every place your people came from, and who holds the paper."
  jsonld={{
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "WebSite", "@id": "https://recordatlas.org/#site",
        url: "https://recordatlas.org/", name: "Record Atlas",
        description: "Every place your people came from, and who holds the paper.",
        inLanguage: "en",
        publisher: { "@id": "https://recordatlas.org/#org" },
        potentialAction: {
          "@type": "SearchAction",
          target: { "@type": "EntryPoint",
                    urlTemplate: "https://recordatlas.org/?q={search_term_string}" },
          "query-input": "required name=search_term_string" } },
      { "@type": "Organization", "@id": "https://recordatlas.org/#org",
        name: "Record Atlas", url: "https://recordatlas.org/",
        description: "A free index of where genealogical records are held: which "
          + "archive holds which ground, for which years, and what it costs to look." },
      { "@type": "Dataset", "@id": "https://recordatlas.org/#dataset",
        name: "Record Atlas \u2014 where the records are",
        description: `${places.toLocaleString()} places with the archives that hold `
          + `their records, ${volumes.toLocaleString()} record volumes, across `
          + `${countries} countries. Free to search and openly published.`,
        url: "https://recordatlas.org/",
        isAccessibleForFree: true,
        creator: { "@id": "https://recordatlas.org/#org" },
        distribution: {
          "@type": "DataDownload", encodingFormat: "application/json",
          contentUrl: "https://recordatlas.org/index.json" },
        spatialCoverage: `${countries} countries` } ]
  }}
  wide>

  {/* TIGHTER THAN THE PROSE PAGES, BECAUSE THIS ONE IS A TOOL. The shared
      .pagehead gives every page 56px of air above the title and holds the
      standfirst to a 76ch measure — right for something you read, wrong for
      something you use, where it pushed the map below the fold and left a
      third of a wide screen blank. .ra-lede takes the air back and lets the
      line run the full width. The wording is two sentences now; the old five
      spent three of them clearing their throat before the point. */}
  {/* THREE STACKED BLOCKS BECAME ONE LINE. A 44px headline, a stats line and
      a standfirst came to about 150 pixels above the search box — on a laptop
      that is a fifth of the window spent saying the name of a page the reader
      is already looking at, and the same complaint David made about the panel
      below: «there isnt much point wasting real estate». The h1 stays, because
      a page needs one and a screen reader announces it; it is just no longer
      the size of a poster. Stats and the help link ride on the same baseline. */}
  {/* THE WHOLE LEDE ROW WENT. David: «can we remove this entire row? and move the volume count pill between the record atlas icon and
      "new"? how it works is just taking me to help which is already in the burger menu». The pill (and its inventory popover) now
      sits in the header through Base's "inv" slot; the "How this works" line was a second door to Help, which the About menu has. The
      h1 stays for screen readers and search engines, and is only hidden. (Earlier notes on this row: the page is a tool, not an
      article, so nothing between the header and the search box.) */}
  <h1 class="ra-sr">Where the records are</h1>
  <details class="ra-inv" slot="inv" id="ra-inv" data-volumes={volumes}>
    <summary class="ra-inv-ico" aria-label={volumes.toLocaleString() + " volumes: what the atlas holds"} title={(volumes / 1e6).toFixed(2) + "M volumes: what the Atlas holds"}><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M4 4h4v16H4zM10 4h4v16h-4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M16.3 5.7l3.7-.9 3 14.4-3.7.9z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span class="ra-inv-t">{(volumes / 1e6).toFixed(2)}M volumes</span></summary>
    <div class="ra-inv-grid">
      <div class="ra-inv-top">
        <p class="ra-inv-count"><span class="ra-inv-big">{volumes.toLocaleString()} volumes</span> <span class="ra-inv-in">in the Atlas</span><span class="ra-inv-new" hidden></span></p>
        <a class="ra-inv-all" href={u("/whats-new/")}>What's new: all updates →</a>
        <ul class="ra-inv-news" aria-label="The latest updates">
          {latestNews.map((e) => (
            <li><a href={u(e.href || "/whats-new/")} title={e.headline}><span class={"ra-inv-kind " + (e.kind || "better")}>{NEWS_KIND[e.kind] || "Better"}</span><span class="ra-inv-line">{e.headline}</span><time datetime={e.date}>{newsDay(e.date)}</time></a></li>
          ))}
        </ul>
      </div>
      {inventoryRows.map(([head, items]) => (
        <>
          <p class="ra-inv-h">{head}</p>
          <ul class="ra-inv-row">
            {items.map(([n, label, href, note, eg]) => (
              <li><a href={u(href)}><b>{n.toLocaleString()}</b> <span>{label}</span><small>{note}</small><em class="eg">e.g. {eg}</em></a></li>
            ))}
          </ul>
        </>
      ))}
    </div>
  </details>
  {/* RIGHT OF «LOCAL». David: «move the volume numbers to the right of "local" … short form, e.g. 3.43M». On a wide screen the pill moves into
      the Researching group, before the save button (David: the icon goes to the right of the count); below the burger breakpoint that group is in the drawer and the dot sits beside the brand, so
      the pill goes back to sit after it. One element, moved by matchMedia (without script it stays beside the brand). */}
  {/* The pill's placement, pulse and (on other pages) lazy fill are in /js/inventory-pill.js, loaded by Base. */}

  {/* ABOVE THE MAP, BECAUSE IT DECIDES WHERE EVERY MARK GOES. David: «can we
      move the researching dropdown thats hiding all the way at the bottom to
      the header at the top, otherwise im marking things without selecting a
      family?» It was below the map and below the fold, which on this page is
      a very long way down — so the honest description of it was not «quiet»
      but «hidden», and a reader could work a whole session into whichever
      line happened to be active. A control that assigns ownership has to be
      visible before the thing it assigns.
      `quiet` stays: it holds the bar to one line until a second family
      exists, which keeps a first-time reader's map uncluttered without
      hiding the selector from somebody who has several. */}
  <ProgressKit />

  <RecordMap
    indexUrl={u("/index.json")}
    detailBase={u("/p/")}
    regionsUrl={u("/regions.json")}
    providersUrl={u("/providers.json")}
    gazBase={u("/g/")}
    surnameBase={u("/s/")}
    belgiumBase={u("/bs/")}
    wikidataUrl={u("/archives-wikidata.json")}
    osmUrl={u("/archives-osm.json")}
    featureBase={u("/")}
    settlementBase={u("/rs/")}
    districtBase={u("/a/")}
    countryBase={u("/c/")}
    townlandBase={u("/t/")}
    comuneBase={u("/it/")}
    estoniaBase={u("/ee/")}
    scotlandBase={u("/sc/")}
    worldArchivesUrl={u("/world-archives.json")}
    countryPointsUrl={u("/country-points.json")}
    base={u("/")} />

  {/* THE TWO PROSE PANELS THAT WERE HERE NOW LIVE AT /help/.
      They were already folded behind a summary because they took half the
      page; folding was the right instinct and the wrong fix. A reader who
      wants four hundred words on why this is a map is asking for help and
      will go looking for it. A reader who arrived with a surname should meet
      the map and nothing else. */}

  <p id="ra-mywork" data-href={u("/my-research/")} hidden></p>
  <VolumeMarks />
  <StoryDrawer />
</Base>

<style>
  /* The folded explanation. A summary that looks like a control, not like
     a heading somebody forgot to style — a reader has to be able to tell
     it opens. */
</style>
