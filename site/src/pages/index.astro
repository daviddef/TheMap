---
import Base from "../layouts/Base.astro";
import RecordMap from "../components/RecordMap.astro";
import ProgressKit from "../components/ProgressKit.astro";
import VolumeMarks from "../components/VolumeMarks.astro";
import StoryDrawer from "../components/StoryDrawer.astro";
import { u } from "../lib/url.js";
import { countryTotals } from "../lib/country-metrics.js";
import { atlas as idx } from "../lib/atlas.js";
import regions from "../../public/regions.json";
import provs from "../../public/providers.json";
import { corpus } from "../lib/surname-corpus.js";
import gnFamilies from "../../../data/given-name-families.json";
import snFamilies from "../../../data/surname-families.json";
import flagIndex from "../../../data/flag-index.json";
import placeNames from "../../../data/place-names.json";

const places = idx.places.length;
/* `v` IS VOLUMES; `c` IS COLLECTIONS. The map's own hint had this wrong
   and was fixed; this line is the same mistake in the page header above
   it, and it is the one a reader sees first. It was printing "8557 record
   volumes" for an atlas holding 2,328,191. */
const volumes = idx.places.reduce((a, p) => a + (p.v || 0), 0);
/* `cc` IS THE COUNTRY. This used `k`, which is the place's KIND (church, cemetery, census ... in combination), so it counted 34 kinds and
   called them countries: on the page, in its search-engine description and in its structured data. David: «we have a dot everywhere,
   on most countries». */
const placeCountries = new Set(idx.places.map(p => p.cc || p.country).filter(Boolean));
/* THE SAME COUNT AS /countries/ AND /places/. This used to be the countries with a place plus the countries a worldwide source names
   (146), while those pages list every country anything is known about (162): a place, a collection, a provider or a surname register.
   David clicked 146 and landed on "162 of them". One definition now, from lib/country-metrics.js, so the tile and the list cannot differ. */
const ccTotals = countryTotals();
const countries = ccTotals.countries;
const withPlaces = ccTotals.walked;
const archives = provs.providers.filter(p => p.at);
const archiveCountries = new Set(archives.map(p => p.at.place.split(", ").pop())).size;
/* THE INVENTORY BEHIND THE ONE PILL. David: one pill, «volumes», and on click a summary of everything the atlas holds. Every
   number is read from the data when the page is built, so none can drift from what is held. */
const sur = corpus().surnames;
const surnameCount = Array.isArray(sur) ? sur.length : Object.keys(sur || {}).length;
/* ROWS, NOT ONE POURED GRID. David: countries, regions, places and dated places belong on a row of their own. Three rows: where
   (the ground), the records (what is kept and where), and names and flags. Each row: [heading, [number, label, link, what, example]]. */
const inventoryRows = [
  ["The ground", [
    [countries, "countries and territories", "/countries/", `${withPlaces} with a place on the map, and ${countries - withPlaces} more known from sources, collections or surnames`, "Egypt: archives listed, no town catalogued yet"],
    [regions.regions.length, "regions", "/jurisdictions/", "stretches of ground whose rulers changed together", "the Military Frontier"],
    /* THE ERAS THE REGIONS CARRY. David: «how many are we tracking? is there a way to show that in the counts?» An era is one ruler over
       one region for a span of years, with the archives that hold its paper: the unit the map and the history play are built on. */
    [regions.regions.reduce((n, r) => n + (r.eras || []).length, 0), "eras", "/jurisdictions/", "spans of years when one ruler held a region, each with the archives that kept its paper", "the Imotski frontier: Ottoman, then Venetian, then Austrian"],
    [places, "places", "/places/", "towns and villages, each with the books and archives that cover it", "Senj, in Croatia"],
    [Object.keys(placeNames.places).length, "places with dated names", "/place-names/", "a place's name in the year of the record", "Fiume before 1945 is today's Rijeka"],
  ]],
  /* «volume» and «archive» are the two words a first-time reader cannot tell apart: a volume is a book; an archive is where books are kept. */
  ["The records", [
    [volumes, "volumes", "/countries/", "register books of baptisms, marriages, burials and civil acts", "Senj, births 1859–1877: one book"],
    [archives.length, "archives", "/providers/", `the places that keep the books, in ${archiveCountries} countries`, "the State Archives in Rijeka"],
  ]],
  ["Names and flags", [
    [surnameCount, "surnames", "/surnames/", `${snFamilies.counts.families} families of spellings`, "Blažević has its own page"],
    [gnFamilies.counts.families, "given names", "/your-name/", `${gnFamilies.counts.forms.toLocaleString()} forms in many languages`, "Ivan, Johann and Giovanni are one name"],
    /* THE SAME NUMBERS THE FLAGS SECTION BELOW SAYS ("211 countries and 34 hubs"). This tile read counts.withFlag (210, the cards
       whose flag is an inline drawing: France's is a named reference, so it was left out) beside a section that counted 211, and
       the hubs were not shown at all. David asked why they disagreed. */
    [flagIndex.counts.countries, "countries with flags", "/flags/", "each with the flags that flew over it through history", "every flag that flew over Croatia"],
    [flagIndex.counts.hubs, "flag hubs", "/flags/#hubsHeadingEl", "regions that group those countries' flags together", "Former Yugoslavia"],
  ]],
];
---
{/* STRUCTURED DATA ON THE ONE PAGE THAT HAD NONE. Place, surname and archive
    pages have carried a schema.org block for a while; the front page, which is
    the page a search engine meets first and the one that has to say what this
    site IS, carried nothing.

    Three things are declared and all three are facts this page already prints:
    the site and its publisher, the SearchAction that tells a search engine the
    search box exists and how to use it, and the atlas as a Dataset — which is
    what it is, and which is how somebody looking for «where are the parish
    registers for X» should be able to reach it. The counts are the same
    variables the header renders, so they cannot drift from what a reader sees. */}
<Base
  bare
  title="Record Atlas"
  dek="Every place your people came from, and who holds the paper."
  jsonld={{
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "WebSite", "@id": "https://recordatlas.org/#site",
        url: "https://recordatlas.org/", name: "Record Atlas",
        description: "Every place your people came from, and who holds the paper.",
        inLanguage: "en",
        publisher: { "@id": "https://recordatlas.org/#org" },
        potentialAction: {
          "@type": "SearchAction",
          target: { "@type": "EntryPoint",
                    urlTemplate: "https://recordatlas.org/?q={search_term_string}" },
          "query-input": "required name=search_term_string" } },
      { "@type": "Organization", "@id": "https://recordatlas.org/#org",
        name: "Record Atlas", url: "https://recordatlas.org/",
        description: "A free index of where genealogical records are held: which "
          + "archive holds which ground, for which years, and what it costs to look." },
      { "@type": "Dataset", "@id": "https://recordatlas.org/#dataset",
        name: "Record Atlas \u2014 where the records are",
        description: `${places.toLocaleString()} places with the archives that hold `
          + `their records, ${volumes.toLocaleString()} record volumes, across `
          + `${countries} countries. Free to search and openly published.`,
        url: "https://recordatlas.org/",
        isAccessibleForFree: true,
        creator: { "@id": "https://recordatlas.org/#org" },
        distribution: {
          "@type": "DataDownload", encodingFormat: "application/json",
          contentUrl: "https://recordatlas.org/index.json" },
        spatialCoverage: `${countries} countries` } ]
  }}
  wide>

  {/* TIGHTER THAN THE PROSE PAGES, BECAUSE THIS ONE IS A TOOL. The shared
      .pagehead gives every page 56px of air above the title and holds the
      standfirst to a 76ch measure — right for something you read, wrong for
      something you use, where it pushed the map below the fold and left a
      third of a wide screen blank. .ra-lede takes the air back and lets the
      line run the full width. The wording is two sentences now; the old five
      spent three of them clearing their throat before the point. */}
  {/* THREE STACKED BLOCKS BECAME ONE LINE. A 44px headline, a stats line and
      a standfirst came to about 150 pixels above the search box — on a laptop
      that is a fifth of the window spent saying the name of a page the reader
      is already looking at, and the same complaint David made about the panel
      below: «there isnt much point wasting real estate». The h1 stays, because
      a page needs one and a screen reader announces it; it is just no longer
      the size of a poster. Stats and the help link ride on the same baseline. */}
  {/* THE WHOLE LEDE ROW WENT. David: «can we remove this entire row? and move the volume count pill between the record atlas icon and
      "new"? how it works is just taking me to help which is already in the burger menu». The pill (and its inventory popover) now
      sits in the header through Base's "inv" slot; the "How this works" line was a second door to Help, which the About menu has. The
      h1 stays for screen readers and search engines, and is only hidden. (Earlier notes on this row: the page is a tool, not an
      article, so nothing between the header and the search box.) */}
  <h1 class="ra-sr">Where the records are</h1>
  <details class="ra-inv" slot="inv" id="ra-inv">
    <summary class="k-tag is-new" aria-label={volumes.toLocaleString() + " volumes: what the atlas holds"}><span class="inv-full">{(volumes / 1e6).toFixed(2)}M</span><span class="inv-short" aria-hidden="true">{(volumes / 1e6).toFixed(2)}M</span></summary>
    <div class="ra-inv-grid">
      {inventoryRows.map(([head, items]) => (
        <>
          <p class="ra-inv-h">{head}</p>
          <ul class="ra-inv-row">
            {items.map(([n, label, href, note, eg]) => (
              <li><a href={u(href)}><b>{n.toLocaleString()}</b> <span>{label}</span><small>{note}</small><em class="eg">e.g. {eg}</em></a></li>
            ))}
          </ul>
        </>
      ))}
    </div>
  </details>
  {/* RIGHT OF «LOCAL». David: «move the volume numbers to the right of "local" … short form, e.g. 3.43M». On a wide screen the pill moves into
      the Researching group, after the Local dot; below the burger breakpoint that group is in the drawer and the dot sits beside the brand, so
      the pill goes back to sit after it. One element, moved by matchMedia (without script it stays beside the brand). */}
  <script is:inline>
    (function () {
      var pill = document.getElementById("ra-inv"), mq = window.matchMedia && window.matchMedia("(min-width: 1181px)");
      if (!pill || !mq) return;
      var home = pill.parentNode, next = pill.nextSibling;
      function place() {
        var live = document.querySelector(".ra-grp .ra-live-grp");
        if (mq.matches && live) { live.parentNode.insertBefore(pill, live.nextSibling); pill.classList.add("in-grp"); }
        else { home.insertBefore(pill, next); pill.classList.remove("in-grp"); }
      }
      place(); if (mq.addEventListener) mq.addEventListener("change", place);
    })();
  </script>

  {/* ABOVE THE MAP, BECAUSE IT DECIDES WHERE EVERY MARK GOES. David: «can we
      move the researching dropdown thats hiding all the way at the bottom to
      the header at the top, otherwise im marking things without selecting a
      family?» It was below the map and below the fold, which on this page is
      a very long way down — so the honest description of it was not «quiet»
      but «hidden», and a reader could work a whole session into whichever
      line happened to be active. A control that assigns ownership has to be
      visible before the thing it assigns.
      `quiet` stays: it holds the bar to one line until a second family
      exists, which keeps a first-time reader's map uncluttered without
      hiding the selector from somebody who has several. */}
  <ProgressKit />

  <RecordMap
    indexUrl={u("/index.json")}
    detailBase={u("/p/")}
    regionsUrl={u("/regions.json")}
    providersUrl={u("/providers.json")}
    gazBase={u("/g/")}
    surnameBase={u("/s/")}
    belgiumBase={u("/bs/")}
    wikidataUrl={u("/archives-wikidata.json")}
    osmUrl={u("/archives-osm.json")}
    featureBase={u("/")}
    settlementBase={u("/rs/")}
    districtBase={u("/a/")}
    countryBase={u("/c/")}
    townlandBase={u("/t/")}
    comuneBase={u("/it/")}
    estoniaBase={u("/ee/")}
    scotlandBase={u("/sc/")}
    worldArchivesUrl={u("/world-archives.json")}
    countryPointsUrl={u("/country-points.json")}
    base={u("/")} />

  {/* THE TWO PROSE PANELS THAT WERE HERE NOW LIVE AT /help/.
      They were already folded behind a summary because they took half the
      page; folding was the right instinct and the wrong fix. A reader who
      wants four hundred words on why this is a map is asking for help and
      will go looking for it. A reader who arrived with a surname should meet
      the map and nothing else. */}

  <p id="ra-mywork" data-href={u("/my-research/")} hidden></p>
  <VolumeMarks />
  <StoryDrawer />
</Base>

<style>
  /* The folded explanation. A summary that looks like a control, not like
     a heading somebody forgot to style — a reader has to be able to tell
     it opens. */
</style>
