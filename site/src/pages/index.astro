---
/* THE FRONT DOOR: one search box and one card that asks why you are here, over the Atlas's map and every tool it has.

   It was /v2/ while it was a trial and became the home page on 23 Nov 2026. The old layout is kept at /classic/ (the same map and tools,
   not indexed). The map, search, filters, layers, saved views and areas, the year control, the visiting checklist, My research colouring,
   the story panel and the basemaps are the one RecordMap component both pages render; /front-door-v2.css and /js/front-door-v2.js lay the
   shell over it. The page's words (components/HomeAbout.astro) used to sit under the map and now live on /help/, so the map has the screen; the
   structured data stays here because this is the page a search engine meets first. */
import Base from "../layouts/Base.astro";
import RecordMap from "../components/RecordMap.astro";
import ProgressKit from "../components/ProgressKit.astro";
import VolumeMarks from "../components/VolumeMarks.astro";
import StoryDrawer from "../components/StoryDrawer.astro";
import InventoryPill from "../components/InventoryPill.astro";
import { u } from "../lib/url.js";
import { places, volumes, countries, archives } from "../lib/inventory.js";
const base = u("/");
---
<Base
  bare
  title="Record Atlas"
  dek="Every place your people came from, and who holds the paper."
  jsonld={{
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "WebSite", "@id": "https://recordatlas.org/#site",
        url: "https://recordatlas.org/", name: "Record Atlas",
        description: "Every place your people came from, and who holds the paper.",
        inLanguage: "en",
        publisher: { "@id": "https://recordatlas.org/#org" },
        potentialAction: {
          "@type": "SearchAction",
          target: { "@type": "EntryPoint",
                    urlTemplate: "https://recordatlas.org/?q={search_term_string}" },
          "query-input": "required name=search_term_string" } },
      { "@type": "Organization", "@id": "https://recordatlas.org/#org",
        name: "Record Atlas", url: "https://recordatlas.org/",
        description: "A free index of where genealogical records are held: which "
          + "archive holds which ground, for which years, and what it costs to look." },
      { "@type": "Dataset", "@id": "https://recordatlas.org/#dataset",
        name: "Record Atlas \u2014 where the records are",
        description: `${places.toLocaleString()} places with the archives that hold `
          + `their records, ${volumes.toLocaleString()} record volumes, across `
          + `${countries} countries. Free to search and openly published.`,
        url: "https://recordatlas.org/",
        isAccessibleForFree: true,
        creator: { "@id": "https://recordatlas.org/#org" },
        distribution: {
          "@type": "DataDownload", encodingFormat: "application/json",
          contentUrl: "https://recordatlas.org/index.json" },
        spatialCoverage: `${countries} countries` } ]
  }}
  wide>

  <h1 class="ra-sr">Where the records are</h1>
  <InventoryPill slot="inv" />
  <ProgressKit />


  <div class="fd2-stage" id="fd2-stage" data-places={places} data-volumes={volumes} data-countries={countries} data-archives={archives.length} data-base={base}>
    <RecordMap
      indexUrl={u("/index.json")}
      detailBase={u("/p/")}
      regionsUrl={u("/regions.json")}
      providersUrl={u("/providers.json")}
      gazBase={u("/g/")}
      surnameBase={u("/s/")}
      belgiumBase={u("/bs/")}
      wikidataUrl={u("/archives-wikidata.json")}
      osmUrl={u("/archives-osm.json")}
      featureBase={u("/")}
      settlementBase={u("/rs/")}
      districtBase={u("/a/")}
      countryBase={u("/c/")}
      townlandBase={u("/t/")}
      comuneBase={u("/it/")}
      estoniaBase={u("/ee/")}
      scotlandBase={u("/sc/")}
      worldArchivesUrl={u("/world-archives.json")}
      countryPointsUrl={u("/country-points.json")}
      base={u("/")} />
  </div>

  <p id="ra-mywork" data-href={u("/my-research/")} hidden></p>
  <VolumeMarks />
  <StoryDrawer />
  <p class="fd2-classic-foot">Prefer the old layout? <a href={u("/classic/")}>Classic view</a></p>

  <link rel="stylesheet" href={base + "front-door-v2.css"} />
  <script is:inline>document.body.classList.add("fd2");</script>
  <script is:inline defer src={base.replace(/\/$/, "") + "/js/front-door-v2.js"}></script>
</Base>
