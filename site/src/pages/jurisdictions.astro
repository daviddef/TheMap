---
/* /jurisdictions/ ("Whose archive") is the second view of /providers/ now: one search box over the sources and over the regions
   and eras. A static site has no server redirect, so this is the page old links land on. */
import { u } from "../lib/url.js";
const to = u("/providers/") + "#regions";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Whose archive: now on the sources page</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={u("/providers/")} />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body style="font-family:system-ui,sans-serif;padding:32px">
  <p>The table of record regions and whose archive holds each era now lives on <a href={to}>the sources page</a>.</p>
  <script is:inline>location.replace(document.querySelector("a").href);</script>
</body>
</html>
