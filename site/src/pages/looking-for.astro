---
/* "Tell us who you're looking for" is one page now: the story page, /read/#story. David: «the looking-for page and the read/#story page are confusingly similar and
   wordy: keep /read/#story and merge into one place». This stays only so a link already sent to somebody still works: it turns an old
   #surname=...&from=...&to=...&left=... address into a sentence (story-link.js) and goes on to the story page with it filled in. The words stay in the part after
   the #, which is never sent to a server. Without script the page says where it went. */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
const target = u("/read/#story");
---
<Base
  title="Tell us who you're looking for"
  eyebrow="This page has moved"
  dek="It is part of the story page now. Say who you are looking for, and the page asks for what is missing."
  noindex>
  <a class="k-card lf-go" href={target}><span class="k-ico" aria-hidden="true">✎</span><h3>Go to the story page →</h3><p>Say who, from where, to where and when.</p></a>
  <script is:inline src={u("/js/story-link.js")}></script>
  <script is:inline define:vars={{ target }}>
    (function () {
      var L = window.raStoryLink, to = target;
      try { var t = L && L.sentenceFromOld(location.hash); if (t) to = target.replace(/#story$/, "") + L.hashFor(t).hash; } catch (e) { /* the plain story page */ }
      location.replace(to);
    })();
  </script>
</Base>

<style>
  .lf-go { max-width: 420px; align-items: flex-start; }
  .lf-go h3 { font-size: 22px; }
</style>
