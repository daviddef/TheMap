  .mrcode code { background: var(--ground); padding: 7px 10px;
    border-radius: 3px; display: inline-block; }
  /* a map to read, not a strip: most of a screen on a desktop, about a square on a phone */
  #mr-map { height: clamp(360px, 62vh, 600px); margin: 6px 0; border: 1px solid var(--rule);
    border-radius: 12px; isolation: isolate; }
  @media (max-width: 600px) {
    #mr-map { height: clamp(280px, 86vw, 420px); }
