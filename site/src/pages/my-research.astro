    background: color-mix(in srgb, var(--st) 11%, var(--panel)); }
  :global(.mrp-done .mrph h3 a), :global(.mrp-part .mrph h3 a), :global(.mrp-plan .mrph h3 a), :global(.mrp-rec .mrph h3 a) { color: var(--st); }
  :global(.mrp.mrp-rec) { border-left-style: dashed; }
