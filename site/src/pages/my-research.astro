  :global(.mrn-plan) { flex: 0 0 auto; font: inherit; font-family: var(--sans); font-size: 12.5px; padding: 5px 10px; border: 1px solid var(--st);
    background: var(--panel); color: var(--st); border-radius: 3px; cursor: pointer; }
