  /* THE PAGE USES ITS WIDTH. The shared reading measure (44rem) is right for an article and wrong here: David, on a wide screen, saw
     the boxes and notes squeezed to half the page with the rest empty. Only inside this page; the measure stays everywhere else. */
  .mr-full :global(.one), .mr-full :global(.one p), .mr-full :global(.cap), .mr-full :global(.dek), .mr-full :global(.prose),
  .mr-full :global(.mrwhere2) { max-width: none; }
