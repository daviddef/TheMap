    #mr-map :global(.ra-base) { max-width: 196px; }
  }
  #mr-map[hidden] { display: none; }
  /* THE HOME MAP'S MARKS: every dot carries a white edge, so it reads on photographs and on a dark ground as well as on a pale map. */
  :global(.mr-pin) { background: var(--accent); color: var(--panel);
    border-radius: 50%; width: 24px; height: 24px; line-height: 21px; box-sizing: border-box; border: 1.5px solid #fff;
    text-align: center; font-family: var(--sans); font-size: 12px;
    font-weight: 700; box-shadow: 0 1px 3px rgba(0,0,0,.4); }
  /* and its soft translucent disc where places are too close to draw apart (the same teals the home map inks its discs with) */
  :global(.mr-disc) { display: grid; place-items: center; box-sizing: border-box; border-radius: 50%; border: 1px solid #fff;
    background: color-mix(in srgb, var(--accent, #1F5C6B) 62%, transparent); color: #fff; font: 700 12.5px/1 var(--sans); text-shadow: 0 0 3px rgba(0,0,0,.65); cursor: pointer; }
  :global(.leaflet-marker-icon.mr-disc) { display: grid; }
  :global(.ra-dark-look .mr-disc) { background: rgba(111, 182, 198, .62); }
