  :global(.mrleg .mr-pin) { display: inline-block; width: 18px; height: 18px; line-height: 18px; font-size: 11px; font-style: normal; }
  /* A PLACE CARD TAKES ITS COLOUR FROM ITS STATE, in the title, the left bar and the header tint; and says it in words as well
     (the label), so colour is never the only signal. green = every book read, teal = in flight (something read or concluded),
     brass = planned (on the to-do list only), mauve dashed = recommended next. Same four colours as the pins on the map. */
  :global(.mrp-done) { --st: var(--r-italy); }
