---
/* WHAT YOU HAVE SEARCHED, AND THE FILE THAT MAKES IT YOURS.

   Everything on this page is read out of this browser at load. Nothing here
   is built, nothing here is sent anywhere, and the server has never seen any
   of it — which is the honest position for a static site with no accounts,
   and also the reason EXPORT is the loudest thing on the page rather than a
   link at the bottom.

   Elsewhere this project treats localStorage as «a convenience and not a
   record». Page ranges are a record: somebody may build them over months.
   localStorage can still vanish — cleared site data, a private window, a
   browser evicting under pressure, a new laptop — so the page says so in
   words rather than assuming a reader knows, and hands them a file.
*/
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import ProgressKit from "../components/ProgressKit.astro";
import LineSwitcher from "../components/LineSwitcher.astro";
import { atlas as idx } from "../lib/atlas.js";

const CCNAMES = idx.countries || {};

/* The links below are rendered by Astro rather than by the dossier's script,
   so they need the base path at build time, not the one define:vars hands the
   inline script further down. */
const BASE_ = u("/");
---
<Base
  title="My research"
  eyebrow="Kept in this browser · never sent anywhere"
  dek="The volumes you have marked, the pages you did, and where to start again. This lives in this browser only — export it to keep it.">

  <link rel="stylesheet" href={u("/vendor/leaflet/leaflet.min.css")} />
  <script src={u("/vendor/leaflet/leaflet.min.js")} defer></script>

  <ProgressKit />
  <link rel="stylesheet" href={u("/story-cards.css")} />
  <script is:inline src={u("/js/stories.js")}></script>
  <script is:inline src={u("/js/research-file.js")}></script>
  <script is:inline src={u("/js/shard-key.js")}></script>
  <script is:inline src={u("/js/name-intro.js")}></script>
  <script is:inline>
    (function () {
      /* this script sits in the head slot, before the container exists: the container is looked up when drawing, not now */
      var host = null, N = window.raNameIntro;
      if (!N) return;
      var base = (document.documentElement.getAttribute("data-base") || "/").replace(/\/?$/, "/"), names = {}, cache = {}, token = 0;
      function getJ(u) { return cache[u] || (cache[u] = fetch(u).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; })); }
      function show(node) { if (!host) return; host.textContent = ""; if (node) { host.append(node); host.hidden = false; } else host.hidden = true; }
      function draw() {
        var P = window.raProgress; if (!P) return;
        host = document.getElementById("mr-intro"); if (!host) return;
        if (!Object.keys(names).length) { try { names = JSON.parse(document.getElementById("mr-cn").textContent) || {}; } catch (e) {} }
        var me = P.lines().filter(function (l) { return l.active; })[0];
        if (!me || /^(My research so far|Research Names)$/.test(me.name)) { token++; show(null); return; }
        var my = ++token, f = window.raFold(me.name);
        getJ(base + "shards.json").then(function (sh) {
          var key = window.raShardKey(f, sh && sh.s); if (!key) return null;
          return getJ(base + "s/" + encodeURIComponent(key) + ".json");
        }).then(function (rows) {
          if (my !== token) return;
          /* a shard that could not be fetched is not a finding: say nothing */
          if (!rows) { show(null); return; }
          var row = N.pick(rows, me.name);
          if (!row) { show(N.render(N.build(null), base)); return; }
          return Promise.all([getJ(base + "flag-eras.json"), getJ(base + "flag-map.json")]).then(function (a) {
            if (my !== token) return;
            show(N.render(N.build(row, { names: names, eras: a[0] && a[0].eras, map: a[1] }), base));
          });
        });
      }
      document.addEventListener("ra-progress-changed", draw);
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", function () { setTimeout(draw, 0); }); else setTimeout(draw, 0);
    })();
  </script>
  <LineSwitcher admin />

  {/* AN INTRODUCTION TO THE NAME, between the bar and the tabs: what the surname is, where the registers count it, and whose flag flew
      there. Drawn by js/name-intro.js from the same shard the map's search reads; empty (and hidden) for a family that is not a surname. */}
  <div id="mr-intro" hidden></div>
  <script type="application/json" id="mr-cn" set:html={JSON.stringify(CCNAMES)}></script>

  <div class="mr-full">

  {/* WHERE THE BACKUP WENT. The "where this lives" note, the back-up / import / share buttons and the six-word online copy were
      all here, and David asked for them to have a page of their own: /backup/ (Connection & Backup), which the pulsing dot in
      the header opens. What stays is one line saying where this page's data lives, and the way there. */}
  <div class="one" style="border-left-color:var(--brick)">
    <div class="lab">Where this lives</div>
    <p class="cap"><b>In this browser, and nowhere else</b> unless you back it up. <span id="mr-conn"></span>
    <a href={BASE_ + "backup/"}>Connection &amp; Backup</a> is where you save a file, keep a copy online, or share what you found.</p>
  </div>

  {/* THE DOSSIER ON A MAP. David: «can the dossier include a map with a marker
      to places?» The page lists where a family has been worked as text, which
      answers «what have I done» and not «where has this family been» — and for
      a family that has moved, the second question is the shape of the whole
      problem. Same tiles, same numbering as the map's own visiting pane, so a
      number here and a number there mean the same row.
      DRAWN ONLY WHEN THERE IS SOMETHING TO DRAW. An empty map of the world is
      a worse answer than no map. */}
  {/* TABS, AS ON THE READ PAGE. The page was one long scroll: the family, its places, then two notes about other people's work. Four tabs
      now, the same ones-and-panels shape as the Journey / Story / People tabs on /read/ (the rs-tab styles). The map and the dossier
      stay in the first panel, untouched: the script below still finds them by id. */}
  <div class="rs-tabs mr-tabs" role="tablist" id="mr-tabs">
    <button type="button" class="rs-tab" role="tab" id="mr-t-families" aria-controls="mr-p-families" aria-selected="true">Families &amp; places</button>
    <button type="button" class="rs-tab" role="tab" id="mr-t-story" aria-controls="mr-p-story" aria-selected="false" tabindex="-1">My story</button>
    <button type="button" class="rs-tab" role="tab" id="mr-t-fixes" aria-controls="mr-p-fixes" aria-selected="false" tabindex="-1">GEDCOM to fix <span class="rs-n" id="mr-n-fixes" hidden></span></button>
    <button type="button" class="rs-tab" role="tab" id="mr-t-sessions" aria-controls="mr-p-sessions" aria-selected="false" tabindex="-1">Other names</button>
  </div>

  <div class="rs-panel mr-panel" id="mr-p-families" role="tabpanel" aria-labelledby="mr-t-families">
  <div id="mr-map" hidden></div>
  <p class="cap" id="mr-map-cap" hidden></p>
  <p class="cap" id="mr-dots-hint" hidden></p>

  <div id="mr-body"></div>
  </div>

  <div class="rs-panel mr-panel" id="mr-p-story" role="tabpanel" aria-labelledby="mr-t-story" hidden>
  <div class="ms" id="ms-root">
    <p class="ms-intro">Tell the story of someone you are looking for, then keep adding to it as you find more: write the next part, paste an article or an obituary, add a photo with its caption. The Atlas reads everything together, so the journey, the registers to search and the names to try grow with it, and every addition is kept in a dated log. Kept in this browser; with the six words on, it travels to your other devices with the rest of your research.</p>
    <p class="ms-status" id="ms-status" role="status"></p>

    <div class="ms-bar" id="ms-bar" hidden>
      <label class="ms-sr" for="ms-pick">Story</label>
      <select id="ms-pick" class="ms-in ms-pick"></select>
      <button type="button" class="ms-btn" id="ms-new">New story</button>
      <button type="button" class="ms-link" id="ms-rename">Rename</button>
      <button type="button" class="ms-link" id="ms-del">Delete story</button>
    </div>
    <div class="ms-row ms-rename" id="ms-rename-row" hidden>
      <input type="text" id="ms-rename-in" class="ms-in" maxlength="80" aria-label="New name for this story" />
      <button type="button" class="ms-btn ms-pri" id="ms-rename-ok">Rename</button>
      <button type="button" class="ms-btn" id="ms-rename-no">Cancel</button>
    </div>

    <section class="ms-first" id="ms-first" hidden>
      <h2 class="ms-h">Start a story</h2>
      <p class="ms-dim ms-first-sub">Write what you know, even a few words. Add a photo or document if you have one. The Atlas draws the journey, lists the registers to search and the names to try as you go.</p>
      <div class="ms-drop" id="ms-first-drop">
        <label class="ms-lab" for="ms-first-text">Who are you looking for, and what do you know?</label>
        <textarea id="ms-first-text" class="ms-in ms-ta" rows="5" maxlength="6000" placeholder="My great-grandfather Ivan Kosina came from Gallignana to Hamilton around 1905. All I have is one photo."></textarea>
        <ul class="ms-shots" id="ms-first-shots" hidden></ul>
        <div class="ms-row">
          <label class="ms-btn ms-filebtn"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 15V4m0 0L8 8m4-4l4 4M5 14v4.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg> Add a photo or document<input type="file" id="ms-first-file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
          <button type="button" class="ms-btn" id="ms-first-eg">Try an example</button>
          <button type="button" class="ms-link" id="ms-first-clear" hidden>Start again</button>
        </div>
        <p class="ms-dim">You can also drop or paste a picture here.</p>
        <div class="ms-read" id="ms-first-read" hidden>
          <p class="ms-read-why">A census sheet, a certificate or a petition can be read for you: the pictures are sent to Claude only when you press the button, and what it says about people with your surnames is added to your words, where you can edit it.</p>
          <button type="button" class="ms-btn ms-pri" id="ms-first-readbtn">Read it with Claude</button>
        </div>
      </div>
      <div class="ms-chips" id="ms-first-chips" aria-live="polite"></div>
      <label class="ms-lab" for="ms-first-name">A name for this story (optional)</label>
      <input type="text" id="ms-first-name" class="ms-in" maxlength="80" placeholder="Ivan Kosina's journey" />
      <div class="ms-row"><button type="button" class="ms-btn ms-pri" id="ms-first-go">Start the story</button></div>
      <p class="ms-dim">Nothing is sent anywhere unless you press Read it with Claude. Please leave out details of people who may be alive.</p>
    </section>

    <div id="ms-view" hidden>
      <h2 class="ms-h" id="ms-name"></h2>

      <section class="ms-comp" id="ms-comp" aria-labelledby="ms-add-h">
        <h3 class="ms-h3" id="ms-add-h">Add the next piece to <span id="ms-add-to"></span></h3>
        <div class="ms-kinds" role="group" aria-label="What are you adding?">
          <button type="button" class="ms-kind" data-kind="story" aria-pressed="true">Write more</button>
          <button type="button" class="ms-kind" data-kind="document" aria-pressed="false">Paste an article or document</button>
          <button type="button" class="ms-kind" data-kind="photo" aria-pressed="false">Add a photo</button>
          <button type="button" class="ms-kind" data-kind="note" aria-pressed="false">A note</button>
        </div>
        <div class="ms-photo" id="ms-photo-row" hidden>
          <label class="ms-btn ms-filebtn">Choose a photo<input type="file" id="ms-file" accept="image/jpeg,image/png,image/webp,image/gif" hidden /></label>
          <span class="ms-dim">or drop one here, or paste it into the box below. The photo is shown here only while this page is open: the Atlas reads words, so type who, where and when, and that is what is kept.</span>
          <div class="ms-photo-prev" id="ms-photo-prev" hidden></div>
          <button type="button" class="ms-btn ms-pri" id="ms-photo-read" hidden>Read it with Claude</button>
        </div>
        <label class="ms-sr" for="ms-text">What to add</label>
        <textarea id="ms-text" class="ms-in ms-ta" rows="6" maxlength="60000"></textarea>
        <div class="ms-row" id="ms-label-row">
          <label class="ms-sr" for="ms-label">Where it came from</label>
          <input type="text" id="ms-label" class="ms-in ms-lab-in" maxlength="80" />
          <button type="button" class="ms-btn ms-pri" id="ms-add">Add to the story</button>
        </div>
      </section>

      <section class="ms-out" id="ms-out" aria-labelledby="ms-so-h" hidden>
        <h3 class="ms-h3" id="ms-so-h">The story so far</h3>
        <p class="ms-lede" id="ms-lede"></p>
        <p class="ms-also" id="ms-did" hidden></p>
        <div id="ms-fam" class="ms-fam" aria-label="Add this family to your research"></div>
        <div class="ms-nav" id="ms-nav" role="navigation" aria-label="In this story">
          <button type="button" data-go="ms-journey">The journey</button>
          <button type="button" data-go="ms-stops-h">Place by place</button>
          <button type="button" data-go="ms-life-sec">The person, as told</button>
          <button type="button" data-go="ms-names-sec">First names and surnames</button>
          <button type="button" data-go="ms-tree-sec">The family</button>
          <button type="button" data-go="ms-plan-h">What to do first</button>
        </div>
        <p class="ms-also" id="ms-also" hidden></p>
        <div id="ms-journey" hidden>
          <div id="ms-map" class="ms-map" role="img" aria-label="Map of the journey"></div>
          <div class="lf-time" id="ms-time">
            <button id="ms-play" class="lf-play" type="button">▶ Play</button>
            <label class="lf-slide"><span class="ms-sr">Year</span><input id="ms-year" type="range" min="1800" max="1900" step="1" value="1800" /></label>
            <output id="ms-yearout" class="lf-yearout" for="ms-year"></output>
          </div>
          <div id="ms-year-row"></div>
          <div id="ms-cap" class="lf-capbox" aria-live="polite"></div>
          <div id="ms-moments" class="lf-moments"></div>
        </div>
        <div id="ms-rest" hidden>
          <h3 class="ms-h3" id="ms-stops-h">Place by place: who held the ground, and where to search</h3>
          <div id="ms-stops"></div>
          <section id="ms-life-sec" hidden><h3 class="ms-h3">The person, as told</h3><div id="ms-life"></div></section>
          <section id="ms-names-sec" hidden><h3 class="ms-h3">First names and surnames</h3><div id="ms-names"></div></section>
          <section id="ms-tree-sec" hidden><h3 class="ms-h3">The family</h3><div id="ms-tree"></div></section>
          <h3 class="ms-h3" id="ms-plan-h">What to do first</h3>
          <div id="ms-plan"></div>
        </div>
      </section>

      <section class="ms-logbox" aria-labelledby="ms-log-h">
        <h3 class="ms-h3" id="ms-log-h">Log of additions <span class="ms-count" id="ms-log-n"></span></h3>
        <ol class="ms-log" id="ms-log"></ol>
      </section>
    </div>
  </div>
  <p class="ms-dim ms-fail" id="ms-fail" hidden>My story could not start. Reload the page. If it still does not appear, the site is probably being updated: try again in a few minutes. Nothing you have kept is lost.</p>
  <script is:inline src={u("/js/story-tab.js")}></script>
  <script is:inline>if (!window.raStoryTab) { var f = document.getElementById("ms-fail"); if (f) f.hidden = false; }</script>
  </div>

  <div class="rs-panel mr-panel" id="mr-p-fixes" role="tabpanel" aria-labelledby="mr-t-fixes" hidden>
    <h2 class="mr-h">GEDCOM research still to fix</h2>
    <p class="cap">What the fix list in <a href={BASE_ + "roots/"}>Roots &amp; Routes</a> found in your family tree file, kept here so the work is part of your research.
    It is kept automatically each time you open a tree in Roots &amp; Routes (switch <b>Remember my decisions on this device</b> off on the Fix list to stop). Places are listed as typed in your file; people are only counted,
    and nothing leaves this browser. Open the file in Roots &amp; Routes to see who.</p>
    <div id="mr-fixes"></div>
  </div>

  {/* WHERE THE OTHER SESSIONS' WORK IS, AND WHY IT IS NOT HERE YET. The family
      archives record what they searched — pages, waypoints, the family each
      row is about — into their own repositories. Nothing watches those, and no
      script can write to this page: it reads a store in this browser. So the
      work arrives only when somebody runs the importer and imports the file,
      and until this said so there was no way to know that from here. */}
  {/* OTHER NAMES IN THIS SESSION. A research session is one family archive (Defranceschi, Mazza, Falco…); the families it records are the names
      it researches. This lists, for the family being viewed, every other name filed under the same session, so one click moves to it. Drawn
      below by the sessions script from raProgress.lines(); it used to be three paragraphs about how the published file is merged. */}
  <div class="rs-panel mr-panel" id="mr-p-sessions" role="tabpanel" aria-labelledby="mr-t-sessions" hidden>
    <div id="mr-sess"></div>
  </div>


  <script is:inline>
    (function () {
      var P = window.raProgress, host = document.getElementById("mr-sess");
      if (!P || !host) return;
      function el(t, c, x) { var e = document.createElement(t); if (c) e.className = c; if (x != null) e.textContent = x; return e; }
      function short(a) { return String(a.name || a.id).replace(/^The /, "").replace(/ Archive$/, ""); }
      function draw() {
        var lines = P.lines(), me = lines.filter(function (l) { return l.active; })[0];
        host.textContent = "";
        var box = el("section", "mrsess");
        if (!me) { box.append(el("p", "mrsess-p", "Choose a family above to see the other names researched alongside it.")); host.append(box); return; }
        var ar = me.archives || [];
        if (!ar.length) {
          box.append(el("h2", "mrsess-h", "Other names in this session"));
          box.append(el("p", "mrsess-p", me.name + " was started by you, so it is not part of a family research session. When a session researches it, the names researched with it will be listed here."));
          host.append(box); return;
        }
        ar.forEach(function (a) {
          var sec = el("div", "mrsess-g"), h = el("h2", "mrsess-h", "Other names in the " + short(a) + " session");
          var open = el("a", "mrsess-open", "Open the " + short(a) + " archive \u2197"); open.href = a.url; open.target = "_blank"; open.rel = "noopener";
          sec.append(h, open);
          var others = lines.filter(function (l) { return l.slug !== me.slug && (l.archives || []).some(function (x) { return x.id === a.id; }); });
          if (!others.length) { sec.append(el("p", "mrsess-p", "No other names are filed under this session yet.")); box.append(sec); return; }
          sec.append(el("p", "mrsess-p", others.length + (others.length === 1 ? " other name" : " other names") + " researched in this session. Choose one to see its research."));
          var ul = el("ul", "mrsess-l");
          others.forEach(function (l) {
            var li = el("li"), b = el("button", "mrsess-b"); b.type = "button";
            b.append(el("b", "", l.name + (l.where ? " of " + l.where : "")), el("small", "", l.marks ? l.marks + (l.marks === 1 ? " mark" : " marks") : "no marks yet"));
            b.addEventListener("click", function () { P.setActive(l.slug); document.dispatchEvent(new CustomEvent("ra-progress-changed")); window.scrollTo({ top: 0, behavior: "smooth" }); });
            li.append(b); ul.append(li);
          });
          sec.append(ul); box.append(sec);
        });
        host.append(box);
      }
      draw(); document.addEventListener("ra-progress-changed", draw); window.addEventListener("storage", draw);
    })();
  </script>

  <script is:inline define:vars={{ BASE: u("/") }}>
    /* TABS AND THE GEDCOM-TO-FIX PANEL. Reads ra-gedcom-fixes-v1 (written by Roots & Routes while "Remember my decisions" is on; see
       roots/js/decisions.js). Place text is user data, so every node here is built with textContent. */
    (function () {
      var NAMES = ["families", "story", "fixes", "sessions"], FKEY = "ra-gedcom-fixes-v1";
      function show(n, push) {
        NAMES.forEach(function (k) {
          var on = k === n, t = document.getElementById("mr-t-" + k), p = document.getElementById("mr-p-" + k);
          if (!t || !p) return; t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1; p.hidden = !on;
        });
        if (push) { try { history.replaceState(null, "", n === "families" ? location.pathname + location.search : "#" + n); } catch (e) { /* no history */ } }
        if (n === "story" && window.raStoryTab) window.raStoryTab.show();
        if (n === "families") setTimeout(function () { window.dispatchEvent(new Event("resize")); }, 30);   // the map was drawn while hidden
      }
      NAMES.forEach(function (k, i) {
        var t = document.getElementById("mr-t-" + k); if (!t) return;
        t.addEventListener("click", function () { show(k, true); });
        t.addEventListener("keydown", function (e) {
          var d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0; if (!d) return;
          var n = NAMES[(i + d + NAMES.length) % NAMES.length]; show(n, true); document.getElementById("mr-t-" + n).focus(); e.preventDefault();
        });
      });
      var h = (location.hash || "").replace("#", ""); if (/^story(\/|$)/.test(h)) show("story", false); else if (NAMES.indexOf(h) > 0) show(h, false);

      function el(tag, text, cls) { var e = document.createElement(tag); if (text != null) e.textContent = text; if (cls) e.className = cls; return e; }
      function read() { try { var r = localStorage.getItem(FKEY), d = r && JSON.parse(r); return d && d.trees ? d : { v: 1, trees: {} }; } catch (e) { return { v: 1, trees: {} }; } }
      function draw() {
        var box = document.getElementById("mr-fixes"); if (!box) return; box.textContent = "";
        var d = read(), names = Object.keys(d.trees).sort(function (a, b) { return String(d.trees[b].saved).localeCompare(String(d.trees[a].saved)); }), open = 0;
        names.forEach(function (n) { (d.trees[n].sections || []).forEach(function (s) { open += Math.max(0, s.total - s.done - s.asis); }); });
        var badge = document.getElementById("mr-n-fixes"); if (badge) { badge.hidden = !open; badge.textContent = open; }
        if (!names.length) {
          var e = el("div", null, "mr-fx-empty"); e.append(el("p", "No fix list is kept here yet."), el("p", "Open your tree in Roots & Routes once and go to its Fix list. What is left to fix is kept here from then on, and ticks you make there are counted. If you had switched \u201cRemember my decisions on this device\u201d off, switch it back on.", "cap"));
          var a = el("a", "Open Roots & Routes", "mr-fx-go"); a.href = BASE + "roots/"; e.append(a); box.append(e); return;
        }
        names.forEach(function (n) {
          var t = d.trees[n], card = el("article", null, "mr-fx"), head = el("header", null, "mr-fx-head");
          var left = (t.sections || []).reduce(function (a, s) { return a + Math.max(0, s.total - s.done - s.asis); }, 0);
          head.append(el("h3", n), el("span", left + " left to fix \u00b7 kept " + t.saved, "mr-fx-meta")); card.append(head);
          var groups = {}, order = [];
          (t.sections || []).forEach(function (s) { var g = s.group || "Other"; if (!groups[g]) { groups[g] = []; order.push(g); } groups[g].push(s); });
          order.forEach(function (g) {
            var gd = el("div", null, "mr-fx-group"); gd.append(el("h4", g));
            groups[g].forEach(function (s) {
              var rest = Math.max(0, s.total - s.done - s.asis), row = el("div", null, "mr-fx-row"), bar = el("span", null, "mr-fx-bar"), fill = el("i"); fill.style.width = Math.round(100 * (s.done + s.asis) / Math.max(1, s.total)) + "%"; bar.append(fill);
              row.append(el("span", s.title, "mr-fx-t"), bar, el("span", rest ? rest + " of " + s.total + " left" : "all " + s.total + " done", "mr-fx-c" + (rest ? "" : " ok"))); gd.append(row);
            });
            card.append(gd);
          });
          var pl = (t.places || []).filter(function (p) { return p.s === "o"; });
          if (pl.length) {
            var det = el("details", null, "mr-fx-places"), sm = el("summary"); sm.append(el("b", "Places to correct or choose "), el("span", "(" + pl.length + (pl.length >= 150 ? "+" : "") + ")", "muted")); det.append(sm);
            var ul = el("ul"); pl.slice(0, 60).forEach(function (p) { var li = el("li"); li.append(el("span", p.t, "mr-fx-raw")); if (p.to) li.append(" \u2192 ", el("b", p.to)); ul.append(li); });
            det.append(ul); if (pl.length > 60) det.append(el("p", "and " + (pl.length - 60) + " more in Roots & Routes", "cap")); card.append(det);
          }
          var foot = el("p", null, "mr-fx-foot"), go = el("a", "Open Roots & Routes"); go.href = BASE + "roots/"; foot.append(go, " and load this file again to work down the list. ");
          var fg = el("button", "Forget this list"); fg.type = "button"; fg.className = "link"; fg.onclick = function () { var x = read(); delete x.trees[n]; try { if (Object.keys(x.trees).length) localStorage.setItem(FKEY, JSON.stringify(x)); else localStorage.removeItem(FKEY); } catch (e) { /* blocked */ } draw(); };
          foot.append(fg); card.append(foot); box.append(card);
        });
      }
      draw(); window.addEventListener("storage", draw);
    })();
  </script>

  <script is:inline define:vars={{ BASE: u("/") }}>
    (function () {
      var P = window.raProgress;
      var body = document.getElementById("mr-body");
      if (!P || !body) return;

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
        });
      }
      /* ---- THE DOSSIER ---------------------------------------------------
         David: «could the my research page be a full guided checklist /
         progress showing everything we're looking at for a family, everything
         we should be looking at, neighbours, parishes… similar to a place page
         but focused on a specific family, and everything around it — places,
         status, inputs, letters we've written?»

         So this stopped being a list of marks and became the page for ONE
         FAMILY LINE: where that family has been worked, what is left at those
         places, and what is out in the post. The line switcher above chooses
         whose page it is.

         EVERYTHING IS DERIVED, NOTHING IS ASKED FOR. The marks already know
         which place they belong to, because the row that made one said so; the
         atlas already knows how many volumes a place holds. «2 of 7» is those
         two facts put next to each other, and it is the number a researcher
         actually wants.

         AND THE NEIGHBOURS ARE LINKED, NOT RECOMPUTED. The place page works
         out the ring and lists what falls inside it. Doing that a second time
         here would be a second answer to one question, which is the mistake
         this project has already made once with the era radius. */
      var ATLAS = null, PLACEC = {}, PROVS = null, CONTACTS = null;
      var PSTAT = {};   /* per place, what this family has done there: set by draw(), read by drawMap() */
      var IDX = null;   /* the atlas's place index (coordinates + how many FamilySearch books), fetched once for the suggestions */

      function fetchOnce(url, into, key) {
        return fetch(url).then(function (r) { return r.json(); })
          .then(function (d) { return d; })
          .catch(function () { return null; });
      }

      /* THE STATES, IN WORDS A PERSON WOULD SAY. The chip printed the stored
         value, so a to-do read «planned» and a find read «found». The same
         seven the place page offers, and «planned» is the to-do list. */
      var STATE_SAY = { planned: "to do", written: "written, no reply",
                        searched: "searched, nothing found", found: "found something",
                        exhausted: "read everything", blocked: "cannot get access" };
      /* WHICH «NOT YET MARKED» LISTS ARE OPEN. draw() rewrites the whole body,
         which would close every <details> the moment a book was added to the
         to-do list — so the list the reader is working in would collapse under
         their hand. Remembered here, the way the place page remembers which
         volume editor is open and for the same reason. */
      var openMore = {};

      function placeIdOf(m) {
        var h = m.href || "";
        var x = h.match(/\/place\/([^/]+)\/?/);
        return x ? x[1] : null;
      }

      function daysSince(iso) {
        if (!/^\d{4}-\d{2}-\d{2}$/.test(iso || "")) return null;
        var d = Math.round((Date.now() - Date.parse(iso)) / 86400000);
        return d >= 0 ? d : null;
      }

      function line() {
        return P.lines().filter(function (l) { return l.active; })[0] || null;
      }

      function draw() {
        var marks = P.all(), slug = P.active(), me = line();
        PSTAT = {};
        /* WHAT THIS FAMILY DID, AND WHAT WAS READ FOR SOMEBODY ELSE.
           A volume WALKED in full is shared by every line, on purpose: the
           progress kit says reading a page is a fact about the page, and
           nobody should read it twice. That is right for coverage and wrong
           for «where this family has been worked». This list took walked
           volumes as this family's work, so Defranceschi showed Arienzo and
           Santa Maria a Vico — Falco's ground, four volumes Falco read — in a
           browser with none of David's own marks. He asked why a Falco place
           was under Defranceschi and I told him it was his own mis-click. It
           was not; it was this filter.
           Own work lists. Walked-only volumes are counted and named once,
           below, as what they are. */
        var mine = [], sharedOnly = [];
        Object.keys(marks).forEach(function (id) {
          var b = (marks[id].by && marks[id].by[slug]) || {};
          if ((b.done && b.done.length) || b.state || b.note) mine.push(id);
          else if (marks[id].walked && marks[id].walked.length) sharedOnly.push(id);
        });

        if (!mine.length) {
          var others = P.lines().filter(function (l) { return !l.active && l.marks; });
          /* AN EMPTY PAGE THAT DOES NOT SAY HOW TO FILL IT IS A DEAD END.
             David: «how do i add things to the dossier? eg i want to go to
             the senj archive or volume or look at a parish… i just dont see
             anything». Everything IS markable — volumes, archives, parishes,
             burial grounds, whole collections — and every control lives on a
             PLACE page, which this page knew and never said. It told a reader
             to «open a place and find its volumes» and stopped there, which
             names one of the five things and none of the buttons. */
          body.innerHTML =
            '<p class="cap" style="margin-top:22px">Nothing recorded yet' +
            (me ? " for <b>" + esc(me.name) + "</b>" : "") + "." +
            (others.length ? " You do have work under " +
              others.map(function (l) { return "<b>" + esc(l.name) + "</b>"; }).join(", ") +
              " — switch above to see it." : "") + "</p>" +
            '<div class="one mrhow"><div class="lab">How this page fills up</div>' +
            "<p>Everything here is recorded on a <b>place page</b>, and it all " +
            "lands under whichever family is chosen above. Open the place you " +
            "are working \u2014 " +
            '<a href="' + BASE + 'place/senj/">Senj</a>, say \u2014 and you can mark:</p>' +
            '<ul class="mrhowl">' +
            /* NAMING THE GLYPH, because the words came off the button. An
               instruction that still says «mark pages» sends a reader looking
               for text that is no longer on the screen. */
            "<li><b>A volume</b> \u2014 the green <b>+</b> beside any book, then " +
            "type the images you did: <code>1-47, 60-72</code>. It remembers " +
            "where to start again, and the <b>+</b> becomes a <b>\u2713</b> so " +
            "you can see down the list what you have already done.</li>" +
            /* NAMING THE WORDS ON THE BUTTON, not a description of it. An
               instruction that says «the dropdown» when the screen says
               «mark what you did …» makes the reader check whether they are
               looking at the right thing. */
            "<li><b>An archive</b> \u2014 the dropdown beside it, the one reading " +
            "\u00abmark what you did\u00bb: planning to, " +
            "written no reply, searched nothing found, found something, read " +
            "everything, cannot get access. A letter shows up here with the " +
            "address and how long it has been.</li>" +
            "<li><b>A parish</b> or <b>a burial ground</b> \u2014 same dropdown, " +
            "beside each one in its list.</li>" +
            "<li><b>A whole collection</b> \u2014 same again, where the page " +
            "lists them.</li></ul>" +
            "<p class=\"cap\">If you already have work recorded elsewhere, " +
            "<b>Import a file</b> above merges it in rather than replacing " +
            "what is here.</p></div>";
          return;
        }

        /* ---- sort the marks into the three questions the page answers ---- */
        var byPlace = {}, films = [], registers = [], letters = [], blocked = [], loose = [];
        var pages = 0, vols = 0;
        mine.forEach(function (id) {
          var m = marks[id], b = (m.by && m.by[slug]) || {};
          var cov = P.coverage(id, slug);
          var row = { id: id, m: m, b: b, cov: cov };
          if (cov.length) { vols++; pages += P.covered(cov); }
          if (b.state === "blocked") { blocked.push(row); return; }
          /* A FILM THAT HAS BEEN RESOLVED KNOWS ITS GROUND. The importer reads the
             waypoint off FamilySearch's own film page and writes `place` onto the
             mark (16 of the 22 films have one), and this line used to throw that
             away: every film went under «not yet tied to a place» whether it was
             tied or not. David, looking at it: «why do these volumes all get
             'films worked, not yet tied to a place' when all of them have
             places?» — they did, and the page was not reading them. */
          if (id.indexOf("film:") === 0) {
            if (m.place) { (byPlace[m.place] = byPlace[m.place] || []).push(row); return; }
            films.push(row); return;
          }
          /* AN ANTENATI REGISTER OPENED. The atlas holds Antenati registers by comune, kind and years and not by the register's own
             id, so a register somebody opened cannot be filed under a place's books; it is recorded here, by id, until it can be. */
          if (id.indexOf("antenati:") === 0) {
            /* FILED BY THE COMUNE ITS OWN TITLE NAMES (placedBy, from the importer): under that place, never as one of its volumes. */
            if (m.place) { (byPlace[m.place] = byPlace[m.place] || []).push(row); return; }
            registers.push(row); return;
          }
          /* A PLACE YOU HAVE DECIDED ABOUT BELONGS TO THAT PLACE'S SECTION,
             which is the whole reason for marking it: «planning to» against
             Rovinj is a to-do, and a to-do filed under «other» is lost. It
             opens the section even when not one book inside it is marked. */
          if (id.indexOf("place:") === 0) {
            var ppid = placeIdOf(m) || id.slice(6);
            (byPlace[ppid] = byPlace[ppid] || []).push(row);
            return;
          }
          if (id.indexOf("volume:") === 0) {
            var pid = placeIdOf(m);
            if (pid) { (byPlace[pid] = byPlace[pid] || []).push(row); return; }
            loose.push(row); return;
          }
          if (b.state === "written") { letters.push(row); return; }
          loose.push(row);
        });

        var sharedByPlace = {}, sharedName = {};
        sharedOnly.forEach(function (id) {
          var m = marks[id];
          if (id.indexOf("volume:") !== 0) return;
          var pid = placeIdOf(m);
          if (!pid) return;
          sharedByPlace[pid] = (sharedByPlace[pid] || 0) + 1;
          if (m.where) sharedName[pid] = m.where;
        });

        var h = [];

        /* ---- the line, and what it amounts to --------------------------- */
        var sum = [];
        if (Object.keys(byPlace).length)
          sum.push("<b>" + Object.keys(byPlace).length + "</b> place" +
                   (Object.keys(byPlace).length === 1 ? "" : "s"));
        if (vols) sum.push("<b>" + vols + "</b> book" + (vols === 1 ? "" : "s") +
                           " with pages recorded");
        if (pages) sum.push("<b>" + pages.toLocaleString() + "</b> page" +
                            (pages === 1 ? "" : "s"));
        if (films.length) sum.push("<b>" + films.length + "</b> film" +
                                   (films.length === 1 ? "" : "s"));
        if (registers.length) sum.push("<b>" + registers.length + "</b> Antenati register" +
                                       (registers.length === 1 ? "" : "s"));
        if (letters.length) sum.push("<b>" + letters.length + "</b> letter" +
                                     (letters.length === 1 ? "" : "s") + " out");
        h.push('<p class="mrsum">' + (sum.join(" \u00b7 ") || "No books marked for this family yet. Open a place and mark a book as searched, and it counts here") + "</p>");

        /* ---- 1. where this family has been ------------------------------ */
        var pids = Object.keys(byPlace).sort();
        if (pids.length) {
          h.push('<div class="lab">Where this family has been worked</div>');
          h.push('<p class="mrlead">Opening a place lets you mark its books \u2014 ' +
                 "and shows the villages within a day's walk, whose registers " +
                 "may hold this family under their own name.</p>");
          pids.forEach(function (pid, idx) {
            var rows = byPlace[pid];
            /* THE PLACE'S OWN NAME, NOT ITS SLUG. This read
               «rows[0].m.where || pid», and where a mark carried no `where`
               the heading printed the id: «arienzo», «liznjan», «kastelir».
               Lowercase, unaccented, and not what anybody calls the place.
               PLACEC already holds the atlas's name for it — «Ližnjan»,
               «Kaštelir» — because this page fetches p/<id>.json for the book
               count two lines down. The slug stays as the last resort, for a
               place whose file has not arrived yet. */
            var pc = PLACEC[pid];
            /* THE ATLAS'S NAME FIRST, AND A SLUG IS NOT A LABEL. The importer
               writes `where` = the place id whenever it has nothing better
               (import-research-sessions.py, `or vols[wp]["place"]`), so on
               every imported mark `where` is «arienzo», «liznjan», «bakar».
               The line above this one used to prefer `where`, which meant the
               fix below it for «a slug where a name belongs» never fired and
               the headings kept printing the id. A `where` that is just the
               id says nothing the id did not, so it is ignored; one that
               carries more — «Senj, the Kvarner» — still wins over the
               atlas's name, because somebody wrote it. */
            var wh = rows[0].m.where;
            var label = (wh && wh !== pid && wh.toLowerCase().replace(/[^a-z0-9]/g, "") !==
                         pid.replace(/[^a-z0-9]/g, "") ? wh : null) ||
                        (pc && pc.name) || wh || pid;
            /* THE TRUE TOTAL, NOT THE CAPPED LIST. The place file carries at most
               60 volumes, oldest first, and says how many it is not showing in
               `volumesTotal`. This counted the 60, so a place with 12,656 books
               read «of 60». */
            var pcv = PLACEC[pid];
            var vols = pcv ? (pcv.volumes || []) : null;
            var held = pcv ? (pcv.volumesTotal || vols.length) : null;
            var num = idx + 1;
            /* «1 of 19 books marked» must count BOOKS. A place-level mark is
               in this list too — it is what opens the section — and counting
               it here would report a book nobody has opened. */
            var books = rows.filter(function (r) {
              return r.id.indexOf("volume:") === 0;
            }).length;
            var pct = held ? Math.min(100, Math.round(100 * books / held)) : 0;
            /* WHAT THE MAP COLOURS BY. «Completed» is claimed only on evidence: every book the atlas lists for the place has been read
               to its last page (or marked «read everything») for this family or in full for anyone. A place whose list is capped at 60
               can never be called complete, because the books past the cap were not looked at. */
            var nDone = 0, anyFound = false, nPlan = 0, lastSince = "", inFlight = false;
            (vols || []).forEach(function (v) {
              if (!v.waypoint) return;
              var vid = "volume:" + String(v.waypoint).split(":")[0], vm = marks[vid];
              if (!vm) return;
              var vb = (vm.by && vm.by[slug]) || {};
              if (vb.state === "exhausted" ||
                  (vm.total && P.covered(P.coverage(vid, slug)) >= vm.total)) nDone++;
            });
            rows.forEach(function (r) {
              /* IN FLIGHT = something has actually been read or concluded here, not only put on the to-do list */
              if (r.cov.length || (r.b.state && r.b.state !== "planned")) inFlight = true;
              if (r.b.state === "found") anyFound = true;
              if (r.b.state === "planned") nPlan++;
              if (r.b.since && r.b.since > lastSince) lastSince = r.b.since;
            });
            PSTAT[pid] = { held: held, listed: vols ? vols.length : 0, done: nDone, books: books, found: anyFound,
                           planned: nPlan, last: lastSince, flight: inFlight || nDone > 0,
                           complete: !!(held && vols && vols.length === held && nDone === held) };
            /* THE PLACE IS THE HEADING, AND IT HAS THE MAP'S OWN NUMBER. The pin
               on the map and the section below were two separate things a
               reader had to match by name; the same disc now sits in both, and
               its number is the section's position, which is also what the map
               uses. */
            var cst = PSTAT[pid].complete ? "done" : PSTAT[pid].flight ? "part" : "plan";
            var csay = { done: "every book read", part: "in flight", plan: "planned" }[cst];
            h.push('<section class="mrp mrp-' + cst + '" id="mrp-' + esc(pid) + '" data-place="' + esc(pid) +
              '" data-n="' + num + '">' +
              '<header class="mrph"><span class="mr-pin mr-pin-h mr-pin-' + cst + (anyFound ? " mr-pin-found" : "") + '" aria-hidden="true">' +
              (cst === "done" ? "\u2713" : num) + "</span>" +
              '<h3><a href="' + BASE + "place/" + esc(pid) + '/">' + esc(label) + "</a></h3>" +
              '<span class="mrstl">' + csay + (anyFound ? " \u00b7 found something" : "") + "</span>" +
              '<span class="mrcount">' + books +
              (held != null ? " of " + held : "") + " book" +
              ((held != null ? held : books) === 1 ? "" : "s") + " marked</span>" +
              (held ? '<span class="mrbar" role="img" aria-label="' + books + " of " + held +
                      ' books marked"><i style="width:' + pct + '%"></i></span>' : "") +
              "</header>");
            h.push('<ul class="mrlist">');
            rows.forEach(function (r) { h.push(rowHtml(r)); });
            h.push("</ul>");

            /* THE BOOKS NOT YET MARKED, RIGHT HERE. «1 of 14 books marked» was
               a sentence about thirteen books the reader could not see, and
               the only way to see them was to leave, open the place, and find
               their way back. Opened here, each one can go straight onto the
               to-do list. A book is «not yet marked» when this family has
               recorded nothing against it; one read in full for somebody else
               is shown as such rather than hidden. */
            var have = {};
            rows.forEach(function (r) { have[r.id] = 1; });
            var todo = (vols || []).filter(function (v) {
              /* `waypoint` and `url` are what the PLACE file carries; `wp` is the
                 world file's name for the same thing, and reading it here found
                 nothing, so no book ever showed as unmarked. */
              return v.waypoint && !have["volume:" + String(v.waypoint).split(":")[0]];
            });
            if (todo.length) {
              var capped = held > vols.length;
              h.push('<details class="mrmore" data-more="' + esc(pid) + '"' +
                (openMore[pid] ? " open" : "") + "><summary>" + todo.length + " book" +
                (todo.length === 1 ? "" : "s") + " not yet marked" +
                (capped ? " <span>(the oldest " + vols.length + " of " + held + ")</span>" : "") +
                "</summary>" +
                '<div class="mrmorebar"><button type="button" class="mraddall" data-pid="' +
                esc(pid) + '">Add all ' + todo.length + " to my to-do list</button></div>" +
                '<ul class="mrlist mrmorelist">' + todo.map(function (v) {
                  var id = String(v.waypoint).split(":")[0];
                  var span = v.from ? (v.to && v.to !== v.from ? v.from + "\u2013" + v.to : String(v.from)) : "";
                  var walkedBy = marks["volume:" + id] && marks["volume:" + id].walked &&
                                 marks["volume:" + id].walked.length;
                  return '<li class="mrrow"><div class="mrline mrline-t">' +
                    (v.url ? '<a class="mrt" href="' + esc(v.url) +
                             '" target="_blank" rel="noopener">' + esc(v.t || id) + " \u2197</a>"
                           : '<span class="mrt">' + esc(v.t || id) + "</span>") +
                    '<button type="button" class="mradd" data-pid="' + esc(pid) + '" data-wp="' +
                    esc(id) + '" data-t="' + esc(v.t || id) + '">+ to do</button></div>' +
                    '<div class="mrline mrline-r">' +
                    (span ? '<span class="mrn">' + esc(span) + "</span>" : "") +
                    (v.conf ? '<span class="mrn">' + esc(v.conf.replace(/\s*\([^)]*\)\s*$/, "")) + "</span>" : "") +
                    (walkedBy ? '<span class="mrwalk">read in full for another family</span>' : "") +
                    "</div></li>";
                }).join("") + "</ul></details>");
            }
            h.push('<p class="mrnext">' + (held != null && !todo.length && held <= books
              ? "Every book here is marked \u2014 " : "") +
              '<a href="' + BASE + "place/" + esc(pid) + '/">Open ' + esc(label) +
              "</a> for the full list and the villages within a day's walk.</p>");
            if (sharedByPlace[pid]) {
              h.push('<p class="mrshared">' + sharedByPlace[pid] + " more book" +
                (sharedByPlace[pid] === 1 ? "" : "s") +
                " here " + (sharedByPlace[pid] === 1 ? "was" : "were") +
                " read in full while looking for another family.</p>");
            }
            h.push("</section>");
          });
          /* THE NEIGHBOURS ARE FILLED IN BY drawMap, once the place index has arrived; the container is here so they sit with the places */
          h.push('<div id="mr-next" class="mrrec" hidden></div>');
        }

        /* ---- READ FOR OTHERS, WHERE THIS FAMILY HAS NOT BEEN ------------- */
        var elsewhere = Object.keys(sharedByPlace).filter(function (pid) {
          return !byPlace[pid];
        }).sort();
        if (elsewhere.length) {
          h.push('<p class="mrshared mrshared-else">Books read page by page, which count for every family, in places ' +
            esc(me ? me.name : "this family") + " has no marks of its own: " + elsewhere.map(function (pid) {
              var pc = PLACEC[pid];
              /* data-shared-place so fill() fetches the place's own file and
                 the NAME arrives. Without it these links are not [data-place]
                 sections, nothing asks for their files, and the line read
                 «arienzo (2)» — the slug again. */
              return '<a data-shared-place="' + esc(pid) + '" href="' + BASE + "place/" + esc(pid) + '/">' +
                     esc((pc && pc.name) || sharedName[pid] || pid) + "</a> (" +
                     sharedByPlace[pid] + ")";
            }).join(", ") + ".</p>");
        }

        /* ---- 2. films, which have no place of their own ------------------ */
        if (films.length) {
          h.push('<div class="lab">Films worked, not yet tied to a place</div>');
          h.push('<p class="cap">These films have not been resolved to a ' +
                 "place yet: the atlas only knows a film's ground once someone has " +
                 "read its waypoint off FamilySearch's own film page. The " +
                 "work is recorded all the same.</p>");
          h.push('<ul class="mrlist">');
          films.forEach(function (r) { h.push(rowHtml(r)); });
          h.push("</ul>");
        }

        /* ---- 2b. Antenati registers opened ------------------------------- */
        if (registers.length) {
          h.push('<div class="lab">Antenati registers opened</div>');
          h.push('<p class="cap">Registers opened on Antenati, by their own id. The atlas lists ' +
                 "Antenati registers by comune, kind and years, not by id, so these are not yet " +
                 "tied to a place's books. The work is recorded all the same.</p>");
          h.push('<ul class="mrlist">');
          registers.forEach(function (r) { h.push(rowHtml(r)); });
          h.push("</ul>");
        }

        /* ---- 3. letters out ---------------------------------------------- */
        if (letters.length) {
          h.push('<div class="lab">Letters out, no reply yet</div>');
          h.push('<ul class="mrlist mrletters">');
          letters.forEach(function (r) {
            var pid = r.id.replace(/^source:/, "");
            var p = PROVS ? PROVS[pid] : null;
            var c = (p && CONTACTS && CONTACTS[p.wikidata]) || null;
            var d = daysSince(r.b.since);
            h.push("<li>" +
              '<span class="mrt">' + esc(r.m.t || pid) + "</span>" +
              (d != null ? '<span class="mrago">' + d + " day" + (d === 1 ? "" : "s") +
                           " ago</span>" : "") +
              (r.b.note ? '<span class="mrnote">' + esc(r.b.note) + "</span>" : "") +
              (c && c.email ? '<a class="mrcm" href="mailto:' + esc(c.email) + '">' +
                              esc(c.email) + "</a>" : "") +
              (c && c.tel ? '<span class="mrct">' + esc(c.tel) + "</span>" : "") +
              (c && c.post ? '<span class="mrcp">' + esc(c.post) + "</span>" : "") +
              (!c ? '<span class="mrcp mrnoc">No address recorded for this one ' +
                    "\u2014 the atlas knows it only by its website.</span>" : "") +
              "</li>");
          });
          h.push("</ul>");
        }

        /* ---- 4. blocked, and the rest ------------------------------------ */
        if (blocked.length) {
          h.push('<div class="lab">Cannot get access</div><ul class="mrlist">');
          blocked.forEach(function (r) { h.push(rowHtml(r)); });
          h.push("</ul>");
        }
        if (loose.length) {
          h.push('<div class="lab">Sources worked</div><ul class="mrlist">');
          loose.forEach(function (r) { h.push(rowHtml(r)); });
          h.push("</ul>");
        }

        body.innerHTML = h.join("");
        fill();
      }

      function rowHtml(r) {
        var m = r.m, b = r.b, cov = r.cov;
        var raw = r.id.replace(/^(volume|film|source|collection|antenati):/, "");
        var shared = (m.walked || []).length;
        /* THREE LINES, NOT NINE SPANS IN A ROW. Every part of this — the
           title, the page ranges, the count, «start again at», «read in
           full», the state, the note and the date — was a sibling span, so a
           browser ran them together and the result read as one sentence:
           «…640-1236 820 pages start again at 1 read in full». They are
           different KINDS of thing and now sit on different lines:

             1. what it is          the volume, linked
             2. what was read       the ranges, then the chips that act on them
             3. what was found      the note, and when

           Nothing is removed; the stars, ranges and dates are all still here.
           They are only told apart. */
        var chips = "";
        if (cov.length) {
          chips += '<span class="mrn">' +
                   (m.total ? P.covered(cov) + " of " + m.total
                            : P.covered(cov) + " pages") + "</span>";
          chips += '<span class="mrres">start again at ' + P.resume(cov) + "</span>";
        }
        if (shared) chips += '<span class="mrwalk">read in full</span>';
        if (b.state) chips += '<span class="mrstate mrstate-' + esc(b.state) + '">' +
                              esc(STATE_SAY[b.state] || b.state) + "</span>";

        /* A FILM CAN HOLD MORE THAN ONE PARISH, and the place it is filed under is
           only the one it OPENS at. Saying so beside it stops «Vodnjan, Liber
           Copulatorum» sitting under a neighbouring parish with no explanation. */
        var opens = (r.id.indexOf("film:") === 0 && m.opensAt)
          ? '<div class="mrline mrline-n"><span class="mrnote">This film opens at: ' +
            esc(m.opensAt) + ". It can hold more than one parish.</span></div>" : "";
        /* A FILM WITH NO WAYPOINT STILL HAS A SHAPE. Sessions record which item of the film holds which book, and when the
           machine transcript cannot be trusted over the images (so a transcript scan proves nothing); both travel on the mark. */
        var isFilm = r.id.indexOf("film:") === 0;
        var filed = (r.id.indexOf("antenati:") === 0 && m.placedBy === "comune")
          ? '<div class="mrline mrline-n"><span class="mrnote">An Antenati register, filed here because its title names this comune. It is not one of this place\u2019s FamilySearch books.</span></div>' : "";
        var items = (isFilm && m.items && m.items.length)
          ? '<div class="mrline mrline-n"><span class="mrnote">Items: ' +
            m.items.map(function (i) {
              return esc("item " + i.n + (i.images ? " (images " + i.images + ")" : "") + ": " + i.what);
            }).join("; ") + "</span></div>" : "";
        var warn = (isFilm && m.transcript)
          ? '<div class="mrline mrline-n"><span class="mrnote">' + esc(m.transcript) + "</span></div>" : "";
        return '<li class="mrrow">' +
          '<div class="mrline mrline-t">' +
            (m.href ? '<a class="mrt" href="' + esc(m.href) + '">' + esc(m.t || raw) + "</a>"
                    : '<span class="mrt">' + esc(m.t || raw) + "</span>") +
            '<button type="button" class="mrdel" data-id="' + esc(r.id) + '">forget</button>' +
          "</div>" +
          (cov.length || chips
            ? '<div class="mrline mrline-r">' +
              (cov.length ? '<span class="mrdone">' + esc(P.fmt(cov)) + "</span>" : "") +
              chips + "</div>"
            : "") +
          opens + filed + items + warn +
          (b.note
            ? '<div class="mrline mrline-n"><span class="mrnote">' + esc(b.note) + "</span>" +
              (b.since ? '<span class="mrsince">' + esc(b.since) + "</span>" : "") +
              "</div>"
            : (b.since ? '<div class="mrline mrline-n"><span class="mrsince">' +
                         esc(b.since) + "</span></div>" : "")) +
          "</li>";
      }

      /* THE COUNTS ARRIVE SECOND. «2 of 7 books» needs the place's own file,
         and there is no reason to hold the whole page back for it — the marks
         are already true without it. Fetched once per place, then the page is
         drawn again with the denominators in. */
      var filling = false;
      function fill() {
        if (filling) return;
        var want = [].slice.call(document.querySelectorAll("[data-place],[data-shared-place]"))
          .map(function (el) { return el.getAttribute("data-place") || el.getAttribute("data-shared-place"); })
          .filter(function (p, i, all) { return !(p in PLACEC) && all.indexOf(p) === i; });
        var needProv = !PROVS, needCon = !CONTACTS;
        if (!want.length && !needProv && !needCon) { drawMap(); return; }
        filling = true;
        var jobs = want.map(function (pid) {
          return fetch(BASE + "p/" + pid + ".json").then(function (r) { return r.json(); })
            .then(function (d) { PLACEC[pid] = d; })
            .catch(function () { PLACEC[pid] = { volumes: [] }; });
        });
        if (needProv) jobs.push(
          fetch(BASE + "providers.json").then(function (r) { return r.json(); })
            .then(function (d) {
              PROVS = {};
              (d.providers || []).forEach(function (p) { PROVS[p.id] = p; });
            }).catch(function () { PROVS = {}; }));
        if (needCon) jobs.push(
          fetch(BASE + "provider-contacts.json").then(function (r) { return r.json(); })
            .then(function (d) { CONTACTS = d.contacts || {}; })
            .catch(function () { CONTACTS = {}; }));
        Promise.all(jobs).then(function () { filling = false; draw(); drawMap(); });
      }

      /* ---- THE DOSSIER ON A MAP ------------------------------------------
         One pin per place this family has been worked at, numbered in the same
         order the sections below are written, so «3» in the list and «3» on
         the map are the one place. Coordinates come from the place files the
         page already fetches for its «6 books here you have not opened» counts
         — no second request and nothing new to keep in step.
         SHOWN ONLY WHEN IT SAYS SOMETHING. One place is not a map, it is a
         dot; an empty world is worse than no map at all. Two or more, or
         nothing. */
      var mrMap = null;

      function kmBetween(a, b, c, e) {
        var q = Math.PI / 180;
        var x = Math.sin(((c - a) * q) / 2) * Math.sin(((c - a) * q) / 2) +
                Math.cos(a * q) * Math.cos(c * q) * Math.sin(((e - b) * q) / 2) * Math.sin(((e - b) * q) / 2);
        return 2 * 6371 * Math.asin(Math.sqrt(x));
      }

      /* THE NEXT STEPS, ALONG A NEIGHBOURLY PATH. A register belongs to a parish, not a village, so the book that holds a family
         is often catalogued under the next place along. From the place this family was last worked at, the path goes to the
         nearest place the atlas lists FamilySearch books for that has not been worked yet, then the nearest to that, and so on.
         «Near» is the place page's own ring (the nearest eight settlements, clamped to 4-25 km): one rule, not a second one. */
      function nextSteps(worked) {
        if (!IDX || !worked.length) return { path: [], finish: [] };
        var pool = IDX.filter(function (p) { return p.y != null && p.v > 0; });
        var haveId = {}; worked.forEach(function (w) { haveId[w.id] = 1; });
        /* each worked place's ring, by the place page's rule */
        worked.forEach(function (w) {
          var ds = IDX.filter(function (p) { return p.y != null && p.i !== w.id; })
            .map(function (p) { return kmBetween(w.y, w.x, p.y, p.x); }).sort(function (a, b) { return a - b; });
          var nth = ds[Math.min(8, ds.length) - 1] || 0;
          w.ring = Math.min(25, Math.max(4, Math.ceil(nth)));
        });
        var cand = [];
        pool.forEach(function (p) {
          if (haveId[p.i]) return;
          var best = null;
          worked.forEach(function (w) {
            var k = kmBetween(w.y, w.x, p.y, p.x);
            if (k <= w.ring && (!best || k < best.km)) best = { km: k, from: w };
          });
          if (best) cand.push({ id: p.i, n: p.n, y: p.y, x: p.x, v: p.v, cc: p.cc, km: best.km, from: best.from.n });
        });
        /* start: the incomplete place worked most recently */
        var open = worked.filter(function (w) { return !w.complete; });
        var from = (open.length ? open : worked).slice().sort(function (a, b) { return (b.last || "") < (a.last || "") ? -1 : 1; })[0];
        var path = [], cur = { y: from.y, x: from.x, n: from.n }, left = cand.slice();
        while (path.length < 6 && left.length) {
          var bi = -1, bk = 1e9;
          left.forEach(function (c, i) { var k = kmBetween(cur.y, cur.x, c.y, c.x); if (k < bk) { bk = k; bi = i; } });
          if (bi < 0 || bk > 25) break;
          var c = left.splice(bi, 1)[0];
          c.hop = bk; c.prev = cur.n; path.push(c); cur = c;
        }
        var finish = worked.filter(function (w) { return !w.complete && w.held; });
        return { path: path, finish: finish, start: from };
      }

      function esc2(t) { return String(t == null ? "" : t).replace(/[<>&"]/g, ""); }

      /* RECOMMENDED PLACES ARE CARDS TOO. Same header as a place this family has worked (disc, name, a state label, a count), in the
         recommended colour, so «worked», «planned» and «recommended» read as one family of things. The places still to finish are NOT
         repeated here: they are the cards above, with their own state. */
      function drawNext(ns, worked) {
        var box = document.getElementById("mr-next");
        if (!box) return;
        if (!ns || !ns.path.length) { box.hidden = true; box.innerHTML = ""; return; }
        var h = ['<div class="lab">Recommended next' + (ns.start ? ", nearest first, from " + esc2(ns.start.n) : "") + "</div>",
                 '<div class="mrrec-grid">'];
        ns.path.forEach(function (c, i) {
          h.push('<section class="mrp mrp-rec" id="mrr-' + esc(c.id) + '"><header class="mrph">' +
            '<span class="mr-pin mr-pin-h mr-pin-g" aria-hidden="true">' + String.fromCharCode(65 + i) + "</span>" +
            '<div class="mrrec-t"><h3><a href="' + BASE + "place/" + esc(c.id) + '/">' + esc2(c.n) + "</a></h3>" +
            '<span class="mrcount">' + (c.hop < 1 ? "under 1" : Math.round(c.hop)) + " km from " + esc2(c.prev) + " \u00b7 " +
            c.v.toLocaleString() + " FamilySearch book" + (c.v === 1 ? "" : "s") + "</span></div>" +
            '<span class="mrstl">recommended</span>' +
            '<button type="button" class="mrn-plan" data-pid="' + esc(c.id) + '" data-name="' + esc(c.n) + '">Plan its books</button>' +
            "</header></section>");
        });
        h.push("</div>");
        h.push('<p class="cap">Only places the atlas lists FamilySearch books for, within a day\u2019s walk of where you have worked. ' +
               "A suggestion, never a finding: nothing is marked until you mark it.</p>");
        box.innerHTML = h.join(""); box.hidden = false;
      }

      /* THE PLACE INDEX COMES IN 5-DEGREE CELLS (pi/<lat>_<lon>.json, the same files the main map reads), so only the cells around
         the places this family has worked are fetched: one to four files, and never the whole world. The first draw has no
         neighbours yet; the redraw when a cell arrives adds them. */
      var CELLS = {}, CELLASK = {};
      function rebuildIdx() { IDX = [].concat.apply([], Object.keys(CELLS).map(function (c) { return CELLS[c]; })); }
      function askCell(k, done) {
        if (CELLASK[k]) { if (CELLS[k] && done) done(); return; }
        CELLASK[k] = 1;
        fetch(BASE + "pi/" + k + ".json").then(function (r) { return r.json(); })
          .then(function (d) { CELLS[k] = d.places || []; }).catch(function () { CELLS[k] = []; })
          .then(function () { if (done) done(); });
      }
      function wantCells(pts) {
        var need = {};
        pts.forEach(function (p) {
          [-0.6, 0.6].forEach(function (dy) { [-0.8, 0.8].forEach(function (dx) {
            need[Math.floor((p.y + dy) / 5) * 5 + "_" + Math.floor((p.x + dx) / 5) * 5] = 1;
          }); });
        });
        var fresh = false;
        Object.keys(need).forEach(function (k) {
          if (CELLASK[k]) return;
          CELLASK[k] = 1; fresh = true;
          fetch(BASE + "pi/" + k + ".json").then(function (r) { return r.json(); })
            .then(function (d) { CELLS[k] = d.places || []; }).catch(function () { CELLS[k] = []; })
            .then(function () {
              var all = Object.keys(need).every(function (c) { return CELLS[c]; });
              if (all) { IDX = [].concat.apply([], Object.keys(CELLS).map(function (c) { return CELLS[c]; })); drawMap(); }
            });
        });
        if (!fresh && !IDX && Object.keys(need).every(function (c) { return CELLS[c]; }))
          IDX = [].concat.apply([], Object.keys(CELLS).map(function (c) { return CELLS[c]; }));
      }

      /* EVERY PLACE THAT HAS RECORDS AT ALL, as small dots, for whatever the map is showing. It is drawn from the same 5-degree index cells
         the main map reads (a place with FamilySearch books, or with any listed collection), fetched for the cells in view only, and only
         from zoom 7 in (about a region) so a whole country is not a carpet. A click opens the place and, when it has FamilySearch books, puts them on this
         family's to-do list with the same «Plan its books» the recommended places use. Places already on the page (worked, or recommended)
         are not drawn twice. */
      var DOTZ = 7, DOTMAX = 1500;
      function viewCells() {
        if (!mrMap || mrMap.getZoom() < DOTZ) return;
        var b = mrMap.getBounds(), keys = [];
        for (var la = Math.floor(b.getSouth() / 5) * 5; la <= b.getNorth(); la += 5)
          for (var lo = Math.floor(b.getWest() / 5) * 5; lo <= b.getEast(); lo += 5) keys.push(la + "_" + lo);
        if (keys.length > 12) return;
        keys.forEach(function (k) { askCell(k, function () { rebuildIdx(); drawDots(); }); });
      }
      function drawDots() {
        if (!mrMap || mrMap._raPop) return;
        if (mrMap._raDots) { mrMap.removeLayer(mrMap._raDots); mrMap._raDots = null; }
        var hint = document.getElementById("mr-dots-hint");
        function say(t) { if (hint) { hint.textContent = t; hint.hidden = !t; } }
        if (mrMap.getZoom() < DOTZ) { say("Zoom in to see every place with records; at this distance only your places and the recommended ones are shown."); return; }
        if (!IDX) { say(""); return; }
        var b = mrMap.getBounds().pad(0.1), skip = mrMap._raSkip || {};
        var here = IDX.filter(function (p) {
          return p.y != null && (p.v > 0 || p.c > 0) && !skip[p.i] && b.contains([p.y, p.x]);
        });
        var cut = here.length > DOTMAX;
        if (cut) here = here.sort(function (a, c) { return (c.v || 0) - (a.v || 0); }).slice(0, DOTMAX);
        var g = L.layerGroup();
        here.forEach(function (p) {
          var plan = p.v > 0
            ? '<br><button type="button" class="mrn-plan" data-pid="' + esc(p.i) + '" data-name="' + esc(esc2(p.n)) + '">Plan its books</button>'
            : '<br><span class="mrs-none">no FamilySearch books listed, so nothing to plan here</span>';
          L.circleMarker([p.y, p.x], { radius: 5, color: "#ffffff", weight: 1.5, fillColor: "#6B5B73", fillOpacity: .85 })
            .addTo(g).bindPopup('<a href="' + BASE + "place/" + esc(p.i) + '/">' + esc2(p.n) + "</a><br>" +
              (p.v ? p.v.toLocaleString() + " FamilySearch book" + (p.v === 1 ? "" : "s") : "") +
              (p.v && p.c ? " \u00b7 " : "") + (p.c ? p.c.toLocaleString() + " collection" + (p.c === 1 ? "" : "s") : "") + plan);
        });
        g.addTo(mrMap); mrMap._raDots = g;
        say(here.length ? (cut ? "Showing the " + DOTMAX.toLocaleString() + " places with the most books in view; zoom in for the rest. " :
                                 "Showing " + here.length.toLocaleString() + " other place" + (here.length === 1 ? "" : "s") + " with records in view. ") +
                          "Click a dot to open it or plan its books." : "");
      }

      function drawMap() {
        var box = document.getElementById("mr-map");
        var cap = document.getElementById("mr-map-cap");
        if (!box || typeof L === "undefined") return;
        var pts = [];
        [].slice.call(document.querySelectorAll("[data-place]")).forEach(function (el) {
          var pid = el.getAttribute("data-place");
          var d = PLACEC[pid];
          if (!d || d.lat == null || d.lon == null) return;
          var st = PSTAT[pid] || {};
          pts.push({ id: pid, y: d.lat, x: d.lon, n: (d.name || pid).replace(/\s*\([^)]*\)\s*$/, ""),
                     num: +el.getAttribute("data-n") || (pts.length + 1),
                     held: st.held, done: st.done || 0, complete: !!st.complete, found: !!st.found, flight: !!st.flight,
                     last: st.last || "", books: st.books || 0 });
        });
        wantCells(pts);
        var ns = nextSteps(pts);
        drawNext(ns, pts);
        if (!pts.length) {
          box.hidden = true; if (cap) cap.hidden = true;
          if (mrMap) { mrMap.remove(); mrMap = null; }
          return;
        }
        box.hidden = false;
        if (!mrMap) {
          mrMap = L.map(box, { scrollWheelZoom: false, preferCanvas: true });
          /* ONCE THE READER HAS MOVED THE MAP IT STAYS WHERE THEY PUT IT: planning a place redraws the page, and the map must not jump back */
          ["pointerdown", "wheel", "keydown"].forEach(function (ev) { box.addEventListener(ev, function () { mrMap._raMoved = true; }, { passive: true }); });
          mrMap.on("moveend zoomend", function () { viewCells(); drawDots(); });
          /* a popup pans the map, and the redraw that follows would close it: leave the dots alone while one is open */
          mrMap.on("popupopen", function (e) {
            mrMap._raPop = true;
            var el = e.popup.getElement(), b = el && el.querySelector(".mrn-plan");
            if (b) b.addEventListener("click", function () { planPlace(b); mrMap.closePopup(); });
          });
          mrMap.on("popupclose", function () { mrMap._raPop = false; drawDots(); });
          /* The same quiet ground as the main map: Esri's light grey canvas, with
             its place names in a separate pane above the tiles and below the pins. */
          L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}", {
            attribution: "Esri, HERE, Garmin &middot; &copy; OpenStreetMap contributors",
            maxNativeZoom: 16, maxZoom: 18
          }).addTo(mrMap);
          mrMap.createPane("baseLabels");
          mrMap.getPane("baseLabels").style.zIndex = 250;
          mrMap.getPane("baseLabels").style.pointerEvents = "none";
          L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}", {
            pane: "baseLabels", maxNativeZoom: 16, maxZoom: 18
          }).addTo(mrMap);
        }
        if (mrMap._raPins) mrMap.removeLayer(mrMap._raPins);
        var g = L.layerGroup();
        /* the neighbourly path first, so the pins sit on top of the line */
        if (ns.path.length && ns.start) {
          var line = [[ns.start.y, ns.start.x]].concat(ns.path.map(function (c) { return [c.y, c.x]; }));
          L.polyline(line, { color: "#6B5B73", weight: 2.5, dashArray: "6 7", opacity: .9, interactive: false }).addTo(g);
          ns.path.forEach(function (c, i) {
            L.marker([c.y, c.x], {
              icon: L.divIcon({ className: "mr-pin mr-pin-g", html: String.fromCharCode(65 + i), iconSize: [22, 22] })
            }).addTo(g).bindPopup('<a href="' + BASE + "place/" + c.id + '/">' + String.fromCharCode(65 + i) + " · " +
              esc2(c.n) + '</a><br>' + Math.round(c.hop) + " km from " + esc2(c.prev) + ", " + c.v.toLocaleString() + " FamilySearch books");
          });
        }
        pts.forEach(function (p, i) {
          var cls = "mr-pin " + (p.complete ? "mr-pin-done" : p.flight ? "mr-pin-part" : "mr-pin-plan") +
                    (p.found ? " mr-pin-found" : "");
          var say = p.complete ? "every book read to the end" :
                    (p.held ? p.done + " of " + p.held + " books read to the end" : "");
          L.marker([p.y, p.x], {
            icon: L.divIcon({ className: cls, html: p.complete ? "✓" : String(p.num), iconSize: [22, 22] })
          }).addTo(g).bindPopup('<a href="' + BASE + "place/" + p.id + '/">' +
                                p.num + " · " + p.n.replace(/[<>&]/g, "") + '</a>' +
                                (say ? "<br>" + say : "") + (p.found ? "<br>found something here" : "") +
                                '<br><a href="#mrp-' + p.id + '">see it below ↓</a>');
        });
        g.addTo(mrMap); mrMap._raPins = g;
        var all = pts.map(function (p) { return [p.y, p.x]; }).concat(ns.path.map(function (c) { return [c.y, c.x]; }));
        var sig = all.map(function (q) { return q.join(","); }).join(";");
        mrMap._raSkip = {};
        pts.forEach(function (p) { mrMap._raSkip[p.id] = 1; });
        ns.path.forEach(function (c) { mrMap._raSkip[c.id] = 1; });
        if (mrMap._raSig !== sig && !mrMap._raMoved) mrMap.fitBounds(L.latLngBounds(all).pad(0.2), { maxZoom: 13 });
        mrMap._raSig = sig;
        viewCells(); drawDots();
        if (cap) {
          var nd = pts.filter(function (p) { return p.complete; }).length;
          cap.hidden = false;
          cap.innerHTML = pts.length + " place" + (pts.length === 1 ? "" : "s") + " worked, numbered as listed below. " +
            '<span class="mrleg"><i class="mr-pin mr-pin-done">✓</i> every book read to the end (' + nd + ")</span>" +
            '<span class="mrleg"><i class="mr-pin mr-pin-part">•</i> in flight (some books read)</span>' +
            '<span class="mrleg"><i class="mr-pin mr-pin-plan">•</i> planned</span>' +
            '<span class="mrleg"><i class="mr-pin mr-pin-found mr-pin-part">•</i> found something</span>' +
            '<span class="mrleg"><i class="mr-dot"></i> other place with records (zoom in; click one to plan its books)</span>' +
            (ns.path.length ? '<span class="mrleg"><i class="mr-pin mr-pin-g">A</i> recommended next, dashed line is the path</span>' : "");
        }
      }

      draw();
      document.addEventListener("ra-progress-changed", draw);
      /* one line of the same story the header dot tells (window.raConn is defined in Base.astro) */
      function connLine() {
        var el = document.getElementById("mr-conn"), c = window.raConn && window.raConn.get();
        if (!el || !c) return;
        el.textContent = (c.synced ? "A copy is also kept online. " : "") + (c.warn ? "Warning: changes are not backed up. " : "");
      }
      document.addEventListener("ra-conn", connLine); connLine();
      /* A BOOK ONTO THE TO-DO LIST. Two calls the place page already makes:
         record what the mark is and where it lives, then give it the state
         «planned». It lands under the ACTIVE family, like every other mark. */
      function addTodo(pid, wp, title, label) {
        var id = "volume:" + wp;
        P.setWhat(id, { t: title, where: label, href: BASE + "place/" + pid + "/" });
        P.setState(id, "planned");
      }
      /* «PLAN ITS BOOKS»: every FamilySearch book the atlas lists for the place goes onto this family's to-do list as «planned». The same
         button sits on the recommended cards and in the map's popups. */
      function planPlace(plan) {
        var ppid = plan.getAttribute("data-pid"), pname = plan.getAttribute("data-name");
        if (!P.active()) { document.dispatchEvent(new CustomEvent("ra-need-family")); return; }
        plan.disabled = true; plan.textContent = "Adding\u2026";
        fetch(BASE + "p/" + ppid + ".json").then(function (r) { return r.json(); }).then(function (d) {
          PLACEC[ppid] = d;
          (d.volumes || []).forEach(function (v) {
            if (v.waypoint) addTodo(ppid, String(v.waypoint).split(":")[0], v.t || v.waypoint, pname);
          });
          document.dispatchEvent(new CustomEvent("ra-progress-changed"));
        }).catch(function () { plan.disabled = false; plan.textContent = "Plan its books"; });
      }
      function onBodyClick(e) {
        var t = e.target.closest ? e.target : null;
        if (!t) return;
        var add = t.closest(".mradd");
        if (add) {
          var sec = add.closest("[data-place]");
          var lab = sec ? sec.querySelector("h3 a").textContent : add.getAttribute("data-pid");
          openMore[add.getAttribute("data-pid")] = true;
          addTodo(add.getAttribute("data-pid"), add.getAttribute("data-wp"),
                  add.getAttribute("data-t"), lab);
          document.dispatchEvent(new CustomEvent("ra-progress-changed"));
          return;
        }
        var plan = t.closest(".mrn-plan");
        if (plan) { planPlace(plan); return; }
        var all = t.closest(".mraddall");
        if (all) {
          var pid = all.getAttribute("data-pid");
          var sec2 = all.closest("[data-place]");
          var lab2 = sec2.querySelector("h3 a").textContent;
          openMore[pid] = true;
          [].slice.call(sec2.querySelectorAll(".mradd")).forEach(function (b2) {
            addTodo(pid, b2.getAttribute("data-wp"), b2.getAttribute("data-t"), lab2);
          });
          document.dispatchEvent(new CustomEvent("ra-progress-changed"));
          return;
        }
        var b = t.closest(".mrdel");
        if (!b) return;
        P.clear(b.getAttribute("data-id"));
        draw();
      }
      body.addEventListener("click", onBodyClick);
      /* EVERY LINK ON THESE PANELS OPENS IN A NEW TAB, so a reader following a place, a book or a FamilySearch page never loses their
         place in the dossier (and the marks they were about to make). One handler for the lot, because most of the links are written by
         script: place headings, book titles, the recommended places, the map's popups. In-page jumps (#...) and mail/phone links stay as
         they are. It sets the attributes just before the browser follows the link, so it also works from the keyboard. */
      document.addEventListener("click", function (e) {
        var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
        if (!a || !a.closest(".mr-panel")) return;
        var hr = a.getAttribute("href") || "";
        if (!hr || hr.charAt(0) === "#" || /^(mailto|tel|javascript):/i.test(hr) || a.hasAttribute("download")) return;
        a.setAttribute("target", "_blank"); a.setAttribute("rel", "noopener");
      }, true);
      /* toggle does not bubble, so it is caught on the way down. */
      body.addEventListener("toggle", function (e) {
        var d = e.target;
        if (d && d.matches && d.matches("details.mrmore"))
          openMore[d.getAttribute("data-more")] = d.open;
      }, true);
    })();
  </script>
  </div>
</Base>

<style>
  /* Set apart from the dossier above it, because it is a different kind of
