  :global(.mr-pin.mr-pin-found), :global(.mr-pin.mr-pin-found.mr-pin-done), :global(.mr-pin.mr-pin-found.mr-pin-plan) { box-shadow: 0 0 0 3px #C9971C, 0 1px 3px rgba(0,0,0,.4); }
  :global(.mr-pin.mr-pin-g) { background: var(--panel); color: var(--r-hre); box-shadow: inset 0 0 0 2px var(--r-hre); border: 0; }
  #mr-map-cap { line-height: 2; }
  #mr-dots-hint { margin-top: 0; }
  :global(.mr-dot) { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--r-hre); border: 1.5px solid var(--panel); box-shadow: 0 0 0 1px var(--r-hre); }
  :global(.mrs-none) { color: #4C5D66; font-size: 12px; }
