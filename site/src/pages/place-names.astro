---
/* WHAT A PLACE WAS CALLED, AND WHEN — the list behind the "places with dated names" tile.
 *
 * Read from data/place-names.json, the one catalogue, written with scripts/place_names.py. Nothing here is typed. Alphabetical by
 * country and place, because a list ordered by size reads as unsorted. A name is a dated claim: when a source gives the name but
 * not the years it is marked "lead" and is searched, never used to date a record.
 */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { atlas as idx } from "../lib/atlas.js";
import cat from "../../../data/place-names.json";

const KIND = { official: "official", colonial: "colonial", historic: "historic", exonym: "other language", native: "native" };
const LANG = { it: "Italian", hr: "Croatian", de: "German", sl: "Slovene", hu: "Hungarian", la: "Latin", en: "English", fr: "French", es: "Spanish", pt: "Portuguese", nl: "Dutch", ru: "Russian", uk: "Ukrainian", pl: "Polish", tr: "Turkish", bg: "Bulgarian", sr: "Serbian", fur: "Friulian", ga: "Irish", no: "Norwegian" };
const countryName = (cc) => (idx.countries || {})[cc] || cc;
const span = (n) => n.from && n.to ? `${n.from}–${n.to}` : n.to ? `until ${n.to}` : n.from ? `from ${n.from}` : "undated";

const byCountry = new Map();
for (const p of cat.places || []) {
  const k = p.country || "";
  if (!byCountry.has(k)) byCountry.set(k, []);
  byCountry.get(k).push(p);
}
const groups = [...byCountry.entries()]
  .map(([cc, list]) => [cc, countryName(cc), list.sort((a, b) => a.name.localeCompare(b.name))])
  .sort((a, b) => a[1].localeCompare(b[1]));
const nNames = (cat.places || []).reduce((a, p) => a + p.names.length, 0);
---
<Base title="Places with dated names"
  eyebrow="What a place was called in the year of the record"
  dek="A clerk filed a record under the name of his year, so today's name can miss it. These are the old names we know, with their years.">

  <div class="k-search"><span class="k-ico" aria-hidden="true">🔎</span>
    <input type="search" id="pn-q" autocomplete="off" spellcheck="false" aria-label="Find a place or an old name" placeholder="Find a place or an old name: Salisbury, Fiume, Danzig" />
    <span class="pn-n" id="pn-n" role="status" aria-live="polite"></span></div>
  <div class="k-stats pn-stats">
    <span class="k-pill"><b>{(cat.places || []).length}</b> places</span>
    <span class="k-pill"><b>{nNames}</b> names</span>
    <span class="k-pill"><b>{groups.length}</b> countries</span>
  </div>

  <p class="pn-jump">{groups.map(([cc, name]) => <a class="k-pill" href={`#c-${cc}`}>{name}</a>)}</p>

  {groups.map(([cc, name, list], gi) => (
    <section id={`c-${cc}`} class="pn-sec">
      <div class="k-bar"><h2>{name}</h2><span class="k-count">{list.length}</span></div>
      <ul class="pn-list">
        {list.map((p) => (
          <li data-q={(p.name + " " + p.names.map((n) => n.name).join(" ")).toLowerCase()}>
            <a class="pn-place" href={u(`/place/${p.id}/`)}>{p.name}</a>
            <ul class="pn-names">
              {p.names.map((n) => (
                <li>
                  <b>{n.name}</b>
                  <span class="pn-yrs">{span(n)}</span>
                  <span class="pn-meta">{LANG[n.lang] || n.lang} · {KIND[n.kind] || n.kind}</span>
                  {n.status === "lead" && <span class="k-tag">lead</span>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="cap">"Lead" means a source gives the name but not the years: search it, but do not date a record by it.</p>
</Base>

<style>
  .pn-stats { margin: 16px 0 0; }
  .pn-n { font: 12px var(--mono); color: var(--ink-3); padding-right: 14px; }
  .pn-jump { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 8px; }
  .pn-sec[hidden], .pn-list > li[hidden] { display: none; }
  .pn-list { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); }
  .pn-list > li { background: var(--panel); border: 1px solid var(--rule); border-top: 5px solid var(--hue); border-radius: 18px; padding: 14px 18px; }
  .pn-place { font-family: var(--serif); font-size: 21px; font-weight: 800; letter-spacing: -.015em; color: var(--ink); text-decoration: none; }
  .pn-place:hover { color: var(--hue-ink, var(--accent)); }
  .pn-names { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .pn-names li { font-size: 15px; display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline; }
  .pn-yrs { font: 700 12px var(--mono); padding: 2px 8px; border-radius: 999px; background: color-mix(in srgb, var(--hue) 16%, var(--panel)); color: var(--hue-ink); }
  .pn-meta { font-size: 12.5px; color: var(--ink-3); }
</style>

<script is:inline>
  (function () {
    var q = document.getElementById("pn-q"), out = document.getElementById("pn-n");
    if (!q) return;
    function fold(s) { return (s || "").normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim(); }
    var secs = [].slice.call(document.querySelectorAll(".pn-sec"));
    q.addEventListener("input", function () {
      var v = fold(q.value), n = 0;
      secs.forEach(function (s) {
        var any = false;
        [].forEach.call(s.querySelectorAll(".pn-list > li"), function (li) {
          var hit = !v || fold(li.getAttribute("data-q")).indexOf(v) >= 0;
          li.hidden = !hit; if (hit) { any = true; n++; }
        });
        s.hidden = !any;
      });
      out.textContent = v ? n + " found" : "";
    });
  })();
</script>
