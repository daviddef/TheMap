---
/* One page per place — 1,239 of them, and the reason they exist is that until
   now there were six.

   Every place lived inside a JSON file that JavaScript fetched, which meant a
   search engine saw a map and nothing in it, a reader with JavaScript off saw
   an empty box, and nobody could send anybody a link to Gračišće. A map that
   cannot be linked into is a demo.

   These are not doorway pages. Each one says something a searcher cannot get
   in one place anywhere else: every name the place has been written under,
   which empire held it in which years, WHICH ARCHIVE that means, and every
   surviving volume with what it costs to open it. */
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import full from "../../data/places-full.json";
import regions from "../../../public/regions.json";
import provs from "../../../public/providers.json";
import { sourcesFor, access as ACCESS } from "../../lib/sources-by-country.js";
import idx from "../../../public/index.json";

export async function getStaticPaths() {
  const full = (await import("../../data/places-full.json")).default;
  return full.places.map((p) => ({ params: { id: p.id }, props: { place: p } }));
}

const { place } = Astro.props;
const PROV = Object.fromEntries(provs.providers.map((p) => [p.id, p]));
/* THE NATIONAL SOURCES. A provider's `countries` list was read by the find box
   and the country pages and by nothing else, so the five free Irish national
   sources were invisible on all 2,130 Irish places. Ranked archive-first, then
   by how open it is. The worldwide dozen are excluded deliberately — covering
   everywhere is not a fact about here. */
const VOLKINDS = ["Births", "Marriages", "Deaths", "Church Census",
                  "Confirmations", "Index", "Other"];
let volumes = [];
try {
  const fv = (await import("../../../../data/fs-volumes.json")).default;
  volumes = (fv.byPlace || {})[place.id] || [];
} catch (e) { volumes = []; }
const national = sourcesFor(place.country);
/* Wikidata's national archive and library, where this atlas has nothing
   curated for the country. Kept apart from `national` above because those
   have been looked at and these have not. */
let worldNat = [];
try {
  const wa = (await import("../../../../data/world-archives.json")).default;
  worldNat = (wa.archives || []).filter((r) => r.cc === place.country)
    .sort((a, b) => (a.kind !== "national-archive") - (b.kind !== "national-archive"))
    .slice(0, 6);
} catch (e) { worldNat = []; }
const countryName = (idx.countries || {})[place.country] || place.country;
const region = regions.regions.find((r) => r.id === place.region);
const ACC = {
  free: "Images, free, no account",
  account: "Images, free, account needed",
  index: "An index only — no images",
  mixed: "Partly free, partly paid",
  paid: "Images, behind a paywall",
  catalogue: "A catalogue entry — not photographed",
  onsite: "On paper, in the building",
};
const RANK = ["free", "account", "index", "mixed", "paid", "catalogue", "onsite"];
const cs = place.collections || [];
const byAccess = RANK.map((a) => [a, cs.filter((c) => c.access === a)]).filter(([, v]) => v.length);
const years = cs.filter((c) => c.from).map((c) => [c.from, c.to || c.from]);
const span = years.length
  ? [Math.min(...years.map((y) => y[0])), Math.max(...years.map((y) => y[1]))]
  : null;
const older = (place.names || []).map((n) => n.n);
/* All 234 of them, from the index, rather than the eight European ones this
   page was born with — which printed "Graaff-Reinet in ZA" the moment the
   map reached the Cape. */
const where = (idx.countries || {})[place.country] || place.country;

/* The sentence a search engine gets, and the one a human reads first. It has
   to carry the former names, because that is what people type. */
const dek = older.length
  ? `${place.name} in ${where}, also written ${older.join(", ")}. ` +
    `${cs.length} record volume${cs.length === 1 ? "" : "s"} covering ` +
    (span ? `${span[0]}–${span[1]}` : "no dated years") + `, and who holds them.`
  : `${place.name} in ${where}. ${cs.length} record volume${cs.length === 1 ? "" : "s"} ` +
    (span ? `covering ${span[0]}–${span[1]}, ` : "") + "and who holds them.";
/* The FamilySearch collections that cover this ground, and how nearly. */
const fs = place.fs || [];
const adm = place.admin || {};
const RANKS = [
  [0, "Named for this place", "Catalogued under this place by name — the closest thing to a direct hit."],
  [1, adm.adm2 ? `Catalogued under ${adm.adm2}` : "This county or province",
      "The administrative unit this place sits in. For a parish register or a probate file that is usually the same archive."],
  [2, adm.adm1 ? `Catalogued under ${adm.adm1}` : "This state or region",
      "Wider than the county, narrower than the country, and filed under the unit this place belongs to."],
  [3, "Elsewhere in the same country",
      "Narrower than the country but catalogued under some other district. Listed because a collection's title is not always where its records end, and never because it covers this ground."],
  [4, "The whole country", "Worth searching, and worth knowing it is a national index rather than a local one."],
];
const filedName = place.filedUnder
  ? ((idx.countries || {})[place.filedUnder] || place.filedUnder) : null;
const mapLink = u(`/?q=${encodeURIComponent(place.name)}&at=${place.id}&view=${place.lat},${place.lon},12`);
---
<Base
  og="place"
  jsonld={{
    "@context": "https://schema.org", "@type": "Place",
    name: place.name,
    alternateName: older.length ? older : undefined,
    address: { "@type": "PostalAddress", addressCountry: place.country,
               addressRegion: (place.admin || {}).adm1 },
    geo: { "@type": "GeoCoordinates", latitude: place.lat, longitude: place.lon },
    description: dek,
  }}
  title={place.name}
  eyebrow={[adm.adm2, adm.adm1, where,
            `${cs.length} volume${cs.length === 1 ? "" : "s"}`,
            span ? `${span[0]}–${span[1]}` : null].filter(Boolean).join(" · ")}
  dek={dek}>

  {place.filedUnder && (
    <div class="one" style="border-left-color:#C0392B">
      <div class="lab">Filed under a country that no longer holds it</div>
      <p class="cap"><b>{place.name} is in {where} today.</b>{" "}
      FamilySearch catalogues it under <b>{filedName}</b>, because that is who held the ground
      when the records were made. Searching {where} alone will not find them — look under{" "}
      <a href={u(`/country/${(place.filedUnder||"").toLowerCase()}/`)}>{filedName}</a> as well.</p>
    </div>
  )}

  {place.level && (
    <p class="cap" style="margin-top:14px">This is a <b>{place.level}</b>, not a town — the
    marker sits at its centre, not at a building. Records filed at this level are usually held
    for the whole {place.level}.</p>
  )}

  {older.length > 0 && (
    <div class="one" style="border-left-color:var(--accent)">
      <div class="lab">Also written</div>
      <p class="names">{older.map((n) => <b>{n}</b>)}</p>
      <p class="cap">If the document in your hand says one of these, this is the place it means.</p>
    </div>
  )}

  {region ? (
    <section style="margin-top:30px">
      <h2>Whose archive this ground was</h2>
      <p class="cap">{place.name} sits in <a href={u(`/region/${region.id}/`)}>{region.label}</a>.
      Which empire held it decides which archive holds its records — and for some of these
      years that is not the archive you would guess.</p>
      <table style="margin-top:14px">
        <thead><tr><th class="m">Years</th><th>Who held it</th><th>Whose archive that means</th></tr></thead>
        <tbody>
          {region.eras.map((e) => (
            <tr>
              <td class="m">{e.from}–{e.to}</td>
              <td><span class="reg" style={`--c:var(${regions.regimes[e.regime].var})`}><i></i>{e.polity || regions.regimes[e.regime].label}</span></td>
              <td>
                {e.filedUnder.length
                  ? e.filedUnder.map((f, i) => (<>{i > 0 && " · "}<a href={u(`/archive/${f}/`)}>{PROV[f].name}</a></>))
                  : <span class="none">no registers survive</span>}
                {e.note && <p class={"enote" + (e.note.startsWith("THE ") ? " trap" : "")}>{e.note}</p>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ) : (
    <div class="one" style="margin-top:30px;border-left-color:var(--rule-strong)">
      <div class="lab">Whose archive this ground was</div>
      <p class="cap">Not yet mapped. The record regions cover Istria, the Kvarner, Carnia and
      Dalmatia so far, and {place.name} is outside them. That is a gap in this map rather than
      a gap in the record — <a href={u("/add/")}>and the most useful thing anyone could fill in</a>.</p>
    </div>
  )}

  {cs.length > 0 ? (
    <section style="margin-top:34px">
      <h2>The volumes</h2>
      <p class="cap">Grouped by what it costs to look, most open first — which is the order
      worth trying them in.</p>
      {byAccess.map(([a, list]) => (
        <div style="margin-top:22px">
          <div class="lab"><i class={"dot d-" + a}></i>{ACC[a]} — {list.length}</div>
          <ul class="vols">
            {list.map((c) => (
              <li>
                {c.url
                  ? <a href={c.url} target="_blank" rel="noopener">{c.title || "Untitled volume"} ↗</a>
                  : <span>{c.title || "Untitled volume"}</span>}
                {c.from && <span class="y">{c.to && c.to !== c.from ? `${c.from}–${c.to}` : c.from}</span>}
                <span class="who"><a href={u(`/archive/${c.provider}/`)}>{PROV[c.provider]?.name || c.provider}</a></span>
                {c.held && <span class="who">held at {c.held}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ) : (
    <p class="cap" style="margin-top:30px">No volumes recorded here yet.</p>
  )}

  {(place.parishes || []).length > 0 && (
    <section style="margin-top:34px">
      <h2>The nearest parishes</h2>
      <p class="cap">A church is a parish and a parish is where a register is kept — the
      register of a hamlet with no church of its own is kept at the church it walked to, so
      the distance is the useful part. <b>Wikidata's coverage is very uneven</b>: 34,612
      churches in England against 105 in central Istria, so a short list here means thin
      data and not an empty landscape. Unchecked, and only inside a mapped record region.</p>
      <ul class="vols">
        {place.parishes.map((c) => (
          <li>
            <a href={`https://www.wikidata.org/wiki/${c.q}`} target="_blank" rel="noopener">{c.n} ↗</a>
            <span class="y">{c.km} km</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {volumes.length > 0 && (
    <section style="margin-top:38px">
      <h2>{volumes.length} volumes catalogued here</h2>
      <p class="cap">The level below «a collection covers this place»: which book, for which
      years, and the link that opens its images. From FamilySearch's own catalogue.
      <b>Nobody here has opened any of them.</b></p>
      {VOLKINDS.map((k) => {
        const rows = volumes.filter((v) => (v.kinds && v.kinds.length ? v.kinds : ["Other"]).includes(k));
        return rows.length > 0 && (
          <div style="margin-top:16px">
            <div class="lab">{k} — {rows.length}</div>
            <ul class="vols">
              {rows.map((v) => (
                <li>
                  {v.url ? <a href={v.url} target="_blank" rel="noopener">{v.t} ↗</a> : <b>{v.t}</b>}
                  {v.from && <span class="y">{v.from}–{v.to}</span>}
                  {v.conf && <span class="who">{v.conf}</span>}
                  {v.film && <span class="who">film {v.film}</span>}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </section>
  )}

  {worldNat.length > 0 && (
    <section style="margin-top:38px">
      <h2>National sources for {countryName}, unverified</h2>
      <p class="cap">From Wikidata, CC0 — the national archive and the national library
      where the country has one. <b>Nobody here has opened these.</b> The link answered when
      it was asked and that is the whole of what this map knows about them. They are listed
      because <b>a country with no named source at all is the worse answer</b>: 199 of the
      237 countries here had nothing but the worldwide services, which cover everywhere and
      therefore say nothing about anywhere.</p>
      <ul class="vols" style="margin-top:12px">
        {worldNat.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener">{r.name} ↗</a>
            <span class="who">{r.kind === "national-archive" ? "national archive" : "national library"}</span>
            {r.status !== "ok" && <span class="who">{
              r.status === "challenged" ? "behind a bot gate, but alive"
              : r.status === "unreachable" ? "did not answer this checker"
              : "answered with an error"}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {national.length > 0 && (
    <section style="margin-top:38px">
      <h2>The sources for {countryName}</h2>
      <p class="cap">National and regional sources that cover this ground <b>whether or not
      anybody has walked it here</b> — which makes them the answer, not the consolation, for
      a place with no volumes recorded on it. The worldwide services are left out: they cover
      everywhere, so they say nothing about here.</p>
      <ul class="vols" style="margin-top:12px">
        {national.map((p) => (
          <li>
            <a href={u(`/archive/${p.id}/`)}>{p.name}</a>
            <span class="who">{ACCESS[p.access] || p.access}</span>
            {p.at && <span class="who">{p.at.place}</span>}
            {p.what && <><br /><span class="who">{p.what}</span></>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {fs.length > 0 && (
    <section style="margin-top:38px">
      <h2>FamilySearch collections that reach here</h2>
      <p class="cap">A collection is a claim over an area, not a book standing in this town —
      so these are ranked by how specifically they reach {place.name}. A free account is
      needed to open the images, and some are restricted to a Family History Centre.</p>
      {RANKS.map(([r, head, sub]) => {
        const rows = fs.filter((c) => c.rank === r);
        return rows.length > 0 && (
          <div style="margin-top:20px">
            <div class="lab">{head} — {rows.length}</div>
            <p class="cap" style="margin-top:2px">{sub}</p>
            <ul class="vols">
              {rows.slice(0, 25).map((c) => (
                <li>
                  <a href={c.url} target="_blank" rel="noopener">{c.t} ↗</a>
                  {c.from && <span class="y">{c.from}–{c.to}</span>}
                  <span class="who">{c.n.toLocaleString()} records</span>
                  {c.where && <span class="who">covers {c.where}</span>}
                  {c.km != null && c.km > 0 && <span class="who">{c.km} km</span>}
                </li>
              ))}
            </ul>
            {rows.length > 25 && <p class="cap">…and {rows.length - 25} more.</p>}
          </div>
        );
      })}
    </section>
  )}

  {region && (
    <p style="margin-top:30px"><a class="bigl"
      href={u(`/?q=${encodeURIComponent(place.name)}&at=${place.id}&years=1800,1920&layers=shelf,jurisdiction&view=${place.lat},${place.lon},9`)}>
      See who held {place.name} between 1800 and 1920 →</a><br />
      <span class="cap">The jurisdiction answer — which empire held this ground, and therefore
      whose archive — could only be got at from the map until now. This opens it there, on
      1863; drag the year from any point between {region.eras[0].from} and
      {region.eras[region.eras.length - 1].to}.</span></p>
  )}

  <p style="margin-top:22px"><a class="bigl" href={mapLink}>See {place.name} on the map →</a></p>
  <p class="cap"><a href={u(`/country/${(place.country||"").toLowerCase()}/`)}>Everything in {where}</a> ·
    <a href={u("/places/")}>All {full.places.length} places</a> ·
    <a href={u("/add/")}>Correct something on this page</a></p>
</Base>

<style>
  h2 { font-family: var(--serif); font-size: 26px; font-weight: 500; margin: 0 0 6px; }
  .names { font-family: var(--serif); font-size: 21px; line-height: 1.5; margin: 8px 0 6px; }
  .names b { font-weight: 500; margin-right: 14px; }
  .vols { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .vols li { font-family: var(--sans); font-size: 13px; line-height: 1.5; }
  .y { font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); margin-left: 8px; }
  .who { font-size: 11px; color: var(--ink-3); margin-left: 8px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: 7px; }
  .d-free { background: #1E8449 } .d-account { background: #6FA82E }
  .d-index { background: #EFC03B } .d-mixed { background: #E8792B }
  .d-paid { background: #C0392B } .d-catalogue { background: #8E6FA8 }
  .d-onsite { background: #7C8A91 }
  .reg { display: inline-flex; align-items: baseline; gap: 7px; }
  .reg i { width: 9px; height: 9px; border-radius: 2px; background: var(--c); display: inline-block; flex: 0 0 auto; }
  .none { color: var(--ink-3); font-style: italic; }
  .enote { font-family: var(--sans); font-size: 11.5px; line-height: 1.55; color: var(--ink-3);
           margin: 6px 0 0; max-width: 58ch; }
  .enote.trap { color: var(--ink-2); border-left: 2px solid #C0392B; padding-left: 9px; }
  td { vertical-align: top; }
  .bigl { font-family: var(--serif); font-size: 19px; }
</style>
