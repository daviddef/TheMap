---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import provs from "../../public/providers.json";
import "../styles/kit.css";

const P = provs.providers;
const byKind = {};
for (const p of P) (byKind[p.kind] = byKind[p.kind] || []).push(p);
const KIND = {
  "aggregator": "The aggregators — many countries at once",
  "national-archive": "National archives and state portals",
  "regional-archive": "Regional and state archives",
  "diocesan": "Church and diocesan archives",
  "volunteer": "Volunteer transcriptions and indexes",
  "library": "Libraries, newspapers and full-text",
  "national-library": "National libraries",
  "index": "Name indexes",
  "catalogue": "Catalogues",
  "statistics": "Statistical offices",
  "commercial": "Commercial subscriptions",
};
const order = ["aggregator", "national-archive", "regional-archive", "diocesan",
               "volunteer", "library", "national-library", "index", "catalogue",
               "statistics", "commercial"];

/* A KIND THIS PAGE HAS NO HEADING FOR MUST NOT VANISH, and eight of them did.
   `order` was a hand-written list and the render was `order.filter(...)`, so a
   provider whose kind was missing from it — index, statistics, national-library,
   catalogue — was silently dropped. Eight sources sat in the directory, counted
   in its own total, and appeared nowhere on the page that exists to list them.
   A directory that quietly omits its own entries is the exact failure this
   project keeps finding elsewhere, so the fallback below is the fix that
   matters more than the four labels added above: anything not in `order` is
   rendered under its own raw kind rather than discarded. */
const shown = new Set(order);
const leftover = [...new Set(P.map((p) => p.kind).filter((k) => !shown.has(k)))].sort();
const sections = [...order.filter((k) => byKind[k]), ...leftover];

const free = P.filter(p => p.access === "free").length;
const unsurveyed = P.filter(p => p.access === "unsurveyed").length;
const triaged = P.filter(p => p.triage).length;

/* A long description folds to three lines. FamilySearch's runs to forty and pushed every
   other row off the screen; the whole of it is one tap away, and nothing is cut. */
const LONG = 220;
const clip = (t) => String(t || "");
---
<Base
  title="The sources"
  eyebrow="Who holds the paper, and what it costs to look"
  dek="Every provider this map can point at, and what it actually costs to look. The access class is the ordinary visitor's experience, not the best case: FamilySearch is filed as needing an account because it does.">

  <p class="k-stats" aria-label="Summary">
    <span><b>{P.length}</b> providers</span>
    <span class="k-tag is-new">{free} free, no account</span>
    <span class="k-tag">{triaged} door-rattled</span>
    <span class="k-tag">{unsurveyed} never opened</span>
  </p>

  <h2 class="k-h">What the access classes mean</h2>
  <ul class="k-tiles">
    {Object.entries(provs.access).map(([k, v]) => (
      <li><span class={"chip acc-" + k}>{k}</span>{v}</li>
    ))}
  </ul>

  {/* WHAT THE DIRECTORY IS, HONESTLY, before the tables imply otherwise.
      A reader seeing 569 rows reasonably assumes 569 assessed sources. */}
  <div class="k-hi">
    <p><b>{unsurveyed} of these {P.length} have never been opened.</b> A national register, an open
    dataset or a state's own list named them, which is worth knowing and is not the same as somebody
    having looked.</p>
    <p>{triaged} have at least had their door rattled: alive or dead, a page or a JavaScript
    application, open or refusing robots. That makes a queue somebody can work, not a surveyed source:
    the access class reads <b>unsurveyed</b> until a person has read the site and written down the
    sentence that settles it. <a href={u("/survey/")}>Want to open one? It takes ten minutes →</a></p>
  </div>
  <p class="k-lede">
    <b>Declining after looking is a result; declining without looking is a gap.</b> Sources that refuse
    automated access are recorded as declined, with what was found, rather than worked around. An archive
    that turns a robot away is stating its terms, and an atlas that asks archives to trust it cannot be the
    thing that ignores them.
  </p>

  <nav class="jump" aria-label="Kinds of provider">
    {sections.map((k) => <a class="k-tag" href={`#k-${k}`}>{KIND[k]?.split(" — ")[0] || k}<span>{byKind[k].length}</span></a>)}
  </nav>

  {sections.map(k => (
    <section style="margin-top:34px" id={`k-${k}`}>
      <h2 class="k-h">{KIND[k] || k} <span class="k-count">{byKind[k].length}</span></h2>
      <table class="k-table">
        <thead><tr>
          <th class="c-name">Provider</th><th class="c-what">What it is</th><th class="m c-acc">Access</th><th class="m c-where">Where</th><th class="m c-date">Checked</th>
        </tr></thead>
        <tbody>
          {byKind[k].sort((a, b) => a.name.localeCompare(b.name)).map(p => (
            <tr>
              <td><a href={u(`/archive/${p.id}/`)}>{p.name}</a></td>
              <td class="what">
                {clip(p.what).length > LONG ? (
                  <details class="k-more">
                    <summary><span class="k-clip">{p.what}</span> <span class="k-mt">more</span></summary>
                    <div>{p.what}</div>
                  </details>
                ) : p.what}
              </td>
              <td class="m"><span class={"chip acc-" + p.access}>{p.access}</span></td>
              <td class="m w">{p.countries.includes("*") ? "worldwide" : p.countries.join(" ")}</td>
              <td class="m">{p.checked}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <aside class="k-foot">
    <p>Links rot, portals move, and free things become paid, so every row says when a person last checked it.</p>
    <p>The build refuses any row without a date. <a href={u("/add/")}>Found one that has changed? Say so →</a></p>
  </aside>
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .jump a { text-decoration: none; color: var(--ink-2); }
  .jump a:hover { border-color: var(--accent); color: var(--accent); }
  .jump a span { color: var(--ink-3); margin-left: 4px; }
  /* Fixed widths, because auto layout gave the description whatever the short columns left
     and squeezed it to a third of the card. The description is the thing being read. */
  .k-table { table-layout: fixed; }
  .c-name { width: 17%; } .c-what { width: 49%; } .c-acc { width: 10%; } .c-where { width: 14%; } .c-date { width: 10%; }
  td.m { white-space: normal; }
  td.w { line-height: 1.6; word-spacing: 4px; overflow-wrap: anywhere; }
  td:first-child { overflow-wrap: anywhere; }
  @media (max-width: 760px) {
    .k-table { table-layout: auto; }
    .k-table thead { display: none; }
    .k-table, .k-table tbody, .k-table tr, .k-table td { display: block; width: 100%; }
    .k-table tr { background: var(--panel); border: 1px solid var(--rule); border-radius: 10px; padding: 10px 14px; margin-bottom: 10px; }
    .k-table td, .k-table td:first-child, .k-table td:last-child { border: 0; border-radius: 0; padding: 3px 0; background: none; }
  }
  td { vertical-align: top; }
  .chip.acc-free { background: #1E844922; color: #1E8449; }
  .chip.acc-account { background: #6FA82E22; color: #5C8C26; }
  .chip.acc-index { background: #EFC03B33; color: #8A6B10; }
  .chip.acc-mixed { background: #E8792B22; color: #B45A17; }
  .chip.acc-paid { background: #C0392B22; color: #C0392B; }
  .chip.acc-catalogue { background: #8E6FA822; color: #7A5CA8; }
  .chip.acc-onsite { background: #7C8A9122; color: #5E6C73; }
</style>
