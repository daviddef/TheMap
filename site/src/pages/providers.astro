---
/* THE SOURCES, IN ONE PLACE. This page used to be three: /providers/ (who holds records and what it costs), /survey/ (the queue of
 * sources nobody has opened) and /jurisdictions/ (for this ground in these years, whose archive holds the paper). They answered one
 * question from three ends and each copied the others, so a reader could not tell which was the real list. It is now one page with
 * one search box and two views of the same directory:
 *
 *   Sources            every archive, library, index and portal, grouped by kind, with what it costs to look
 *   Whose archive      every record region and era, and the archives that kept its paper (the old /jurisdictions/)
 *
 * THE ROWS ARE NOT IN THE HTML. They were (1,801 of them, 7.5 MB), and the region tables would have added ~15 MB more. The page is
 * the controls, the explanations and a no-script list of links; public/js/providers-page.js builds the rows from providers.json
 * (and regions.json, only when the Whose archive view is opened), 40 at a time. Every source still has its own page at /archive/<id>/.
 */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import fs from "node:fs";
import provs from "../../public/providers.json";
import regions from "../../public/regions.json";
import { atlas as idx } from "../lib/atlas.js";
import "../styles/kit.css";

const P = provs.providers;
const KIND = {
  "aggregator": "The aggregators — many countries at once",
  "national-archive": "National archives and state portals",
  "regional-archive": "Regional and state archives",
  "diocesan": "Church and diocesan archives",
  "volunteer": "Volunteer transcriptions and indexes",
  "library": "Libraries, newspapers and full-text",
  "national-library": "National libraries",
  "index": "Name indexes",
  "catalogue": "Catalogues",
  "statistics": "Statistical offices",
  "commercial": "Commercial subscriptions",
};
const order = ["aggregator", "national-archive", "regional-archive", "diocesan",
               "volunteer", "library", "national-library", "index", "catalogue",
               "statistics", "commercial"];
/* A KIND THIS PAGE HAS NO HEADING FOR MUST NOT VANISH (eight of them once did): anything not in `order` is listed under its own
   raw kind. The kinds are handed to the script in one list. */
const leftover = [...new Set(P.map((p) => p.kind).filter((k) => !order.includes(k)))].sort();
const kinds = [...order, ...leftover].filter((k) => P.some((p) => p.kind === k));

const free = P.filter((p) => p.access === "free").length;
const unsurveyed = P.filter((p) => p.access === "unsurveyed").length;
const easyStarts = P.filter((p) => p.access === "unsurveyed" && p.triage === "read").length;
const triaged = P.filter((p) => p.triage).length;

/* THE ACCESS CLASSES, IN PLAIN WORDS: one short label each, the full sentence on hover, the count beside it. They are the filter. */
const ACC = {
  free: "Free, images online",
  account: "Free with an account",
  index: "Index only",
  mixed: "Part paid",
  paid: "Paid",
  catalogue: "Catalogue only",
  onsite: "In the building",
  unsurveyed: "Not yet checked",
};
const SHORT = { free: "Free", account: "Account", index: "Index", mixed: "Part paid", paid: "Paid",
                catalogue: "Catalogue", onsite: "In person", unsurveyed: "Unchecked" };
const accCount = {};
for (const p of P) accCount[p.access] = (accCount[p.access] || 0) + 1;

/* THE NEW PILL: the latest day the directory grew, linked to What's new, which keeps the full list. */
const ADDED = (p) => p.added || p.checked;
const latest = P.map(ADDED).sort().pop();
const latestN = P.filter((p) => ADDED(p) === latest).length;
const MONTH = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const latestLabel = (() => { const [, m, d] = String(latest).split("-").map(Number); return `${d} ${MONTH[m - 1]}`; })();

/* ---- WHOSE ARCHIVE: what the region view needs from the build ---------------------------------------------------------------- */
const FLAG_SLUG = {
  AR: "argentina", AT: "austria", AU: "australia", BA: "bosnia-and-herzegovina",
  BE: "belgium", BY: "belarus", CA: "canada", CZ: "czechia", DE: "germany",
  DK: "denmark", EE: "estonia", FI: "finland", FR: "france",
  GB: "united-kingdom", HR: "croatia", HU: "hungary", IE: "ireland",
  IT: "italy", LT: "lithuania", LV: "latvia", NL: "netherlands", NO: "norway",
  PL: "poland", PT: "portugal", RO: "romania", RS: "serbia", RU: "russia",
  SE: "sweden", SI: "slovenia", SK: "slovakia", UA: "ukraine",
  US: "united-states", ZA: "south-africa",
};
const eras = regions.regions.reduce((a, r) => a + r.eras.length, 0);
const covered = new Set(regions.regions.flatMap((r) => r.countries || []));
const CN = idx.countries || {};
const placesByCC = {};
for (const p of (idx.places || [])) { if (p.cc) placesByCC[p.cc] = (placesByCC[p.cc] || 0) + 1; }
let flagEraCount = {};
try {
  const fi = JSON.parse(fs.readFileSync("../data/flag-index.json", "utf8"));
  const fe = JSON.parse(fs.readFileSync("../data/flag-eras.json", "utf8"));
  const slugToName = {};
  for (const c of fi.countries) slugToName[c.url.split("/").pop().replace(".html", "")] = c.name;
  const nameToCC = Object.fromEntries(Object.entries(CN).map(([k, v]) => [v, k]));
  for (const e of fe.eras) {
    const nm = slugToName[e.slug];
    const cc = nm && nameToCC[nm];
    if (cc) flagEraCount[cc] = (flagEraCount[cc] || 0) + 1;
  }
} catch { flagEraCount = {}; }
const gaps = Object.entries(placesByCC)
  .filter(([cc]) => !covered.has(cc))
  .map(([cc, n]) => ({ cc, n, name: CN[cc] || cc, eras: flagEraCount[cc] || 0 }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 16);

/* What the script needs and the build alone knows. Rows come from providers.json and regions.json. */
const conf = {
  kinds: kinds.map((k) => [k, KIND[k] || k]),
  acc: ACC, short: SHORT, accDefs: provs.access,
  flags: FLAG_SLUG,
  base: u("/"),
  latest,
};
---
<Base
  title="The sources"
  eyebrow="Who holds the paper, and what it costs to look"
  dek="Every archive, library, index and portal this map can point at, what it actually costs to look, and whose archive holds the paper for a given ground and year. The access class is the ordinary visitor's experience, not the best case: FamilySearch is filed as needing an account because it does.">

  <div class="pv-root" id="pv-root">

  <form id="pv-find" class="pv-find" role="search" autocomplete="off">
    <div class="pv-row">
      <label class="pv-q"><span class="pv-lab">Search the sources and regions</span>
        <input id="pv-q" type="search" placeholder="A name, a country, a kind of record: Antenati, croatia church, usa census, Istria…" enterkeyhint="search" /></label>
      <details class="pv-drop" id="pv-filters">
        <summary id="pv-fsum" aria-label="Filters: what it costs to look, kind of source" title="Filters: what it costs to look, kind of source">
          <svg class="pv-funnel" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1.5 2.5h13l-5 6v5l-3 1.5v-6.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
          <span class="pv-badge" id="pv-badge" hidden></span>
        </summary>
        <div class="pv-drop-in">
          <p class="pv-fh">What it costs to look</p>
          <div class="pv-opts" id="pv-acc">
            {Object.entries(ACC).map(([k, label]) => (
              <label class="pv-opt" title={provs.access[k]}><input type="checkbox" data-acc={k} /><i class={"pv-sw acc-" + k} aria-hidden="true"></i><span>{label}</span><b>{accCount[k] || 0}</b></label>
            ))}
          </div>
          <p class="pv-fh">Kind of source</p>
          <div class="pv-opts" id="pv-kindopts">
            {kinds.map((k) => (
              <label class="pv-opt"><input type="checkbox" data-kind={k} /><span>{(KIND[k] || k).split(" — ")[0]}</span><b>{P.filter((p) => p.kind === k).length}</b></label>
            ))}
          </div>
          <p class="pv-drop-foot"><button type="button" class="pv-link" id="pv-clear2">Clear the filters</button></p>
        </div>
      </details>
      <nav class="pv-icons" aria-label="More about the sources">
        <a class="pv-ib" id="pv-new" href={u("/whats-new/#sources")} title={`New: ${latestN} sources added on ${latestLabel}. See what is new`} aria-label={`New: ${latestN} sources added on ${latestLabel}`}>
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 1.5l1.5 4.2 4.2 1.5-4.2 1.5L8 12.9 6.5 8.7 2.3 7.2l4.2-1.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M12.8 11.2l.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6-1.6-.6 1.6-.6z" fill="currentColor"/></svg>
          <span class="pv-ibn">{latestN}</span>
        </a>
        <button type="button" class="pv-ib" id="pv-help-open" data-dlg="pv-helpdlg" aria-haspopup="dialog" title={`Help check a source: ${unsurveyed} have never been opened`} aria-label={`Help check a source: ${unsurveyed} have never been opened`}>
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5.2 8.2l2 2 3.6-4.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="pv-ib" id="pv-about-open" data-dlg="pv-aboutdlg" aria-haspopup="dialog" title="What this list is, and is not" aria-label="What this list is, and is not">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 7.2v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="8" cy="4.9" r=".9" fill="currentColor"/></svg>
        </button>
      </nav>
    </div>
    <div class="pv-tabs" role="group" aria-label="Two views of the same directory">
      <button type="button" class="pv-tab" data-view="kind" aria-pressed="true">Sources <span>{P.length.toLocaleString("en")}</span></button>
      <button type="button" class="pv-tab" data-view="regions" aria-pressed="false">Whose archive, by region and years <span>{regions.regions.length}</span></button>
    </div>
    <p class="pv-line"><span id="pv-say" role="status" aria-live="polite">{P.length.toLocaleString("en")} sources</span>
      <button type="button" id="pv-newfilter" class="pv-link" hidden>showing one day's arrivals — show all</button>
      <button type="button" id="pv-clear" class="pv-link" hidden>Clear the search and filters</button></p>
    <div id="pv-place" class="pv-place" hidden></div>
  </form>

  <p id="pv-none" class="pv-none" hidden>Nothing matches that. Try fewer words, or take the country off. A source missing from the directory?
    <a href={u("/add/")}>Tell us →</a></p>

    <dialog class="pv-dlg" id="pv-helpdlg" aria-labelledby="pv-help-h">
      <form method="dialog" class="pv-dlg-x"><button aria-label="Close" class="pv-dlg-close">×</button></form>
      <h2 class="k-h" id="pv-help-h">Help check a source <span class="k-count">{unsurveyed}</span></h2>
      <p class="pv-helplead"><b>{unsurveyed} of these have never been opened.</b> A national register, an open dataset or a state's own list
        named them, which is worth knowing and is not the same as somebody having looked. Opening one takes about ten minutes,
        and it turns a grey dot into an answer.</p>
      <p class="pv-helpgo"><button type="button" class="pv-link" id="pv-easy-link">Show the {easyStarts} easy starts</button> · <button type="button" class="pv-link" id="pv-unchecked-link">all {unsurveyed} not yet checked</button></p>
      <p class="cap">An easy start is a source whose homepage we have already read, so the list shows what we found there.</p>
      <details class="pv-how">
        <summary>How to check one</summary>
        <ol class="k-steps">
          <li><b>Open the site.</b> Every not-yet-checked row has an <em>Open the site</em> link.</li>
          <li><b>Find the records, not the homepage.</b> Look for the register viewer. In French it is usually <em>archives en ligne</em> or
            <em>état civil</em>; in Italian <em>registri</em>; in German <em>Kirchenbücher</em>.</li>
          <li><b>Answer one question: what does it cost to look?</b> Free images, free with an account, an index only, a catalogue card,
            in the building only, or a charge.</li>
          <li><b>Copy the sentence that proves it</b> and the page it is on. Not a summary: the site's own words, so the next person can
            check you instead of trusting you.</li>
          <li><b>Send it</b> <a href={u("/add/")}>through this form</a>, with the source's name, the class, the quotation and the URL.</li>
        </ol>
        <ul class="k-tiles pv-two">
          <li><span class="k-tag">Stop</span><span><b>If a site refuses robots or asks you not to, stop.</b> Record that it declined and why. This
            project does not defeat bot gates or pretend to be a browser it is not: an atlas that asks archives to trust it cannot be the thing
            that ignores them.</span></li>
          <li><span class="k-tag">Say so</span><span><b>If you cannot tell, say you cannot tell.</b> An honest <em>not yet checked</em> is worth more than
            a confident guess. A place wrongly marked <em>free</em> costs somebody an evening and costs this directory the only thing it sells.</span></li>
        </ul>
      </details>
    </dialog>

  <div id="pv-view-kind">

    <div id="pv-kinds"></div>

    <noscript>
      <p class="pv-none">The lists on this page are drawn by a script, which is switched off here. The whole directory is one file,
        <a href={u("/providers.json")}>providers.json</a>, and every source has its own page at <code>/archive/&lt;id&gt;/</code>.</p>
    </noscript>

  </div>

  <div id="pv-view-regions" hidden>
    <div class="k-hi">
      <p><b>Knowing who ruled a place is trivia. Knowing whose archive that means is research.</b></p>
      <p>Every history of Istria will tell you it was Italian between the wars. What almost none of them tell
      you is the consequence: the parish registers of those years were filmed by FamilySearch into a
      collection called <em>Italy, Pola and Trieste</em>, so a search of the Croatian collection returns
      nothing at all, and nothing looks exactly like a record that does not exist.
      <a href={u("/")}>Set a year on the map</a> and the answer appears in every panel.</p>
    </div>
    <p class="k-lede">
      A record region is a piece of ground whose records were filed the same way, and an era is a stretch of years over which that stayed true.
      <b>The other half of the same question:</b> <a href={u("/flags/")}>the flag pages</a> know who was governing and what they flew, for 210
      countries. Each region links to the flag history of the countries it covers. Treat that link as context, not an equivalence: a flag page is
      keyed on a modern country, and a record region usually is not one. Istria has been under seven regimes and is not the same shape as Croatia.
    </p>
    <p class="cap">{regions.precision}</p>
    <p class="pv-note" id="pv-rnote" hidden>The cost and date filters apply to the list of sources. Here the search and the country narrow the regions.</p>
    <div id="pv-regions"></div>
    <p class="pv-loading" id="pv-rload">Loading the regions…</p>

  
    <section style="margin-top:44px">
      <h2 class="k-h">Where this layer is missing</h2>
      <p class="cap">These {regions.regions.length} regions cover {covered.size} of the {Object.keys(CN).length} countries this atlas names. Below are the
      countries where the atlas already holds the most ground and has no jurisdiction research at all, which is where the next region would do the most good.
      <b>The sovereignty half is already in hand:</b> the <a href={u("/flags/")}>flag timelines</a> give who governed and when. What they cannot give is
      <em>whose archive that means</em>, which is read out of finding aids one country at a time.</p>
      <table class="k-table pv-gaps">
        <thead><tr><th>Country</th><th class="m">Places held</th><th class="m">Eras already known</th><th>Starting point</th></tr></thead>
        <tbody>
          {gaps.map((g) => (
            <tr>
              <td><a href={u(`/country/${g.cc.toLowerCase()}/`)}>{g.name}</a></td>
              <td class="m">{g.n.toLocaleString()}</td>
              <td class="m">{g.eras || "—"}</td>
              <td>{g.eras ? <a href={u("/flags/")}>its flag timeline</a> : <span class="cap">no timeline either — both halves open</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>

  <aside class="k-foot">
    <p>Links rot, portals move, and free things become paid, so every row says when a person last checked it.</p>
    <p>The build refuses any row without a date. <a href={u("/add/")}>Found one that has changed? Say so →</a></p>
  </aside>
  </div>

  <dialog class="pv-dlg" id="pv-aboutdlg" aria-labelledby="pv-about-h">
    <form method="dialog" class="pv-dlg-x"><button aria-label="Close" class="pv-dlg-close">×</button></form>
    <h2 class="k-h" id="pv-about-h">What this list is, and is not</h2>
    
      <p>It lists the <b>institutions and portals</b>: archives, libraries, indexes, volunteer projects and the commercial sites. The individual
      collections inside them, and the registers walked page by page, are on each place's own page.</p>
      <p>{triaged.toLocaleString("en")} have at least had their door rattled: alive or dead, a page or a JavaScript application, open or refusing
      robots. That makes a queue somebody can work, not a surveyed source: the class reads <b>not yet checked</b> until a person has read the site and
      written down the sentence that settles it.</p>
      <p><b>Declining after looking is a result; declining without looking is a gap.</b> Sources that refuse automated access are recorded as
      declined, with what was found, rather than worked around.</p>
    <p><b>Links rot, portals move, and free things become paid</b>, so every row says when a person last checked it. The build refuses any row without a date.
      <a href={u("/add/")}>Found one that has changed? Say so →</a></p>
  </dialog>

  <script type="application/json" id="pv-conf" set:html={JSON.stringify(conf)}></script>
  <script is:inline src={u("/js/sources-search.js")}></script>
  <script is:inline src={u("/js/shard-key.js")}></script>
  <script is:inline src={u("/js/providers-page.js")}></script>
</Base>

<style is:global>
  /* FULL WIDTH. This page is a wide table; the shared reading width left half the screen as margin. */
  :root { --maxw: min(2200px, 98vw); }
  .pv-root [hidden] { display: none !important; }
  /* Fixed widths, because auto layout gave the description whatever the short columns left and squeezed it to a third of the card. */
  .pv-root .k-table { table-layout: fixed; }
  .pv-root .c-name { width: 20%; } .pv-root .c-what { width: 46%; } .pv-root .c-acc { width: 10%; } .pv-root .c-where { width: 12%; } .pv-root .c-date { width: 11%; }
  .pv-root .c-yrs { width: 13%; } .pv-root .c-who { width: 27%; } .pv-root .c-arch { width: 60%; }
  .pv-root td.m { white-space: normal; }
  .pv-root td.m:last-child { white-space: nowrap; }
  .pv-root td.w { line-height: 1.6; word-spacing: 4px; overflow-wrap: anywhere; }
  .pv-root td:first-child { overflow-wrap: anywhere; }
  .pv-root td { vertical-align: top; }
  @media (max-width: 760px) {
    .pv-root .k-table { table-layout: auto; }
    .pv-root .k-table thead { display: none; }
    .pv-root .k-table, .pv-root .k-table tbody, .pv-root .k-table tr, .pv-root .k-table td { display: block; width: 100%; }
    .pv-root .k-table tr { background: var(--panel); border: 1px solid var(--rule); border-radius: 10px; padding: 10px 14px; margin-bottom: 10px; }
    .pv-root .k-table td, .pv-root .k-table td:first-child, .pv-root .k-table td:last-child { border: 0; border-radius: 0; padding: 3px 0; background: none; }
  }
  /* the text is the cost colour pulled toward the ink, so it stays AA on its own wash in both themes (the bare colours were 3.0-3.9:1) */
  .chip.acc-free { background: #1E844922; color: color-mix(in srgb, #1E8449 60%, var(--ink)); }
  .chip.acc-account { background: #6FA82E22; color: color-mix(in srgb, #5C8C26 55%, var(--ink)); }
  .chip.acc-index { background: #EFC03B33; color: color-mix(in srgb, #8A6B10 40%, var(--ink)); }
  .chip.acc-mixed { background: #E8792B22; color: color-mix(in srgb, #B45A17 60%, var(--ink)); }
  .chip.acc-paid { background: #C0392B22; color: color-mix(in srgb, #C0392B 60%, var(--ink)); }
  .chip.acc-catalogue { background: #8E6FA822; color: color-mix(in srgb, #7A5CA8 60%, var(--ink)); }
  .chip.acc-onsite { background: #7C8A9122; color: color-mix(in srgb, #5E6C73 60%, var(--ink)); }
  .chip.acc-unsurveyed { background: #7C8A9122; color: var(--ink-2); }

  .pv-find { display: grid; gap: 12px; margin: 0 0 20px; }
  .pv-row { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: end; }
  .pv-lab { display: block; font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px; }
  .pv-q { flex: 1 1 420px; }
  .pv-row { flex-wrap: nowrap; }
  .pv-q input { width: 100%; box-sizing: border-box; font: 16px var(--sans); color: var(--ink); background: var(--panel);
    border: 1px solid var(--rule-strong, var(--rule)); border-radius: 10px; padding: 11px 14px; }
  .pv-q input:focus { outline: 3px solid var(--accent); outline-offset: 1px; }
    .pv-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .pv-tab { font: 600 14px var(--sans); color: var(--ink-2); background: var(--panel); border: 1px solid var(--rule-strong, var(--rule)); border-radius: 10px; padding: 9px 16px; cursor: pointer; }
  .pv-tab span { font: 11px var(--mono); margin-left: 8px; }
  .pv-tab[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); background: var(--accent-wash); }
  /* THE FILTERS ARE THE HOME SCREEN'S: one funnel that opens a panel of pill options with their counts, and fills when something is narrowed. */
  .pv-drop { position: relative; align-self: end; }
  .pv-drop > summary { list-style: none; cursor: pointer; box-sizing: border-box; height: 46px; min-width: 46px; padding: 0 12px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    color: var(--ink-2); background: var(--panel); border: 1px solid var(--rule-strong, var(--rule)); border-radius: 10px; }
  .pv-drop > summary::-webkit-details-marker { display: none; }
  .pv-drop > summary:hover { border-color: var(--accent); color: var(--accent); }
  .pv-drop > summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .pv-drop.has-filter > summary { border-color: var(--accent); background: var(--accent-wash); color: var(--accent); }
  .pv-drop.has-filter .pv-funnel path { fill: var(--accent); stroke: var(--accent); }
  .pv-funnel { width: 18px; height: 18px; display: block; flex: none; }
  .pv-badge { font: 500 11px/1.7 var(--mono); color: var(--accent); }
  .pv-drop:not([open]) > .pv-drop-in { display: none; }
