  .sp .lf-events { list-style: none; padding-left: 0 !important; display: grid; gap: 8px; }
  .sp .lf-ev { padding: 6px 10px; border-left: 3px solid var(--tagc, var(--accent)); background: var(--ground); border-radius: 0 8px 8px 0; font-size: 14px; line-height: 1.4; }
  .sp .lf-moments h4, .sp .lf-names h4 { display: block; font: 600 11.5px/1 var(--sans); letter-spacing: .09em; text-transform: uppercase; color: var(--accent); margin: 14px 0 6px; }
  .sp .lf-forms { margin: 0 0 6px; padding-left: 18px; font-size: 14px; line-height: 1.5; } .sp .lf-forms li { margin: 0 0 4px; }
  /* the first names, three to a row: one language per cell; the long «worth trying» line takes the whole row */
  .sp .lf-namelink { margin: 2px 0 8px; font-size: 14px; }
  .sp .lf-forms-cols { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr; gap: 6px 24px; }
