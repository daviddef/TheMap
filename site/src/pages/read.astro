---
/* READING THE RECORD: a term finder and a date decoder for old church registers.
 *
 * The terms are data/record-terms.json (every one sourced, in our own words, nothing about a person); the finder and decoder are
 * public/js/record-reader.js, which only reads what is typed. Plan: docs/reading-the-record-plan.md. This is its first piece:
 * the annotated page, the line reader and the trap list come later.
 */
import Base from "../layouts/Base.astro";
import { recordTerms } from "../lib/record-terms.js";
import { u } from "../lib/url.js";
import ProgressKit from "../components/ProgressKit.astro";
const { sources, terms, seen } = recordTerms();
const langNames = { la: "Latin", it: "Italian", es: "Spanish", pt: "Portuguese", nl: "Dutch", de: "German", fr: "French", cs: "Czech", sk: "Slovak", pl: "Polish", da: "Danish", hu: "Hungarian", hr: "Croatian" };
const langCount = Object.fromEntries(Object.keys(langNames).map((l) => [l, terms.filter((t) => t.lang === l).length]));
const chips = ["uxoris", "7bris", "susceptores", "obiit", "infans", "natum"];
const dateChips = ["die 30 7bris 1671", "undecima februarii anno millesimo septingentesimo quadragesimo sexto", "xvi martii 1801"];
const eventNames = { baptism: "Baptism", marriage: "Marriage", burial: "Burial" };
---
<Base
  title="Reading the record"
  eyebrow={`${terms.length} terms in ${Object.values(langCount).filter(Boolean).length} languages · every one sourced · the finder and date decoder keep everything in your browser`}
  dek="Type a word as you see it in the register, or a whole date, and see what it is, what it does not tell you, and where it comes from."
  description="A searchable guide to the words of old registers, in Latin and in the languages of their catalogue titles, with how often each turns up in the Atlas's own records, and a decoder for dates such as 'die 30 7bris 1671'.">

  <div class="rd-pick" role="tablist" aria-label="What would you like to do?">
    <button type="button" role="tab" id="tab-story" class="rd-tab is-on" aria-selected="true" aria-controls="tool-story" data-tool="story">
      <span class="rd-n">1</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><b>Start with your story</b><span class="rd-d">Tell a family story, with photos or papers if you have them. See their journey, family and what to do first. No Claude involved.</span></button>
    <button type="button" role="tab" id="tab-ask" class="rd-tab" aria-selected="false" aria-controls="tool-ask" data-tool="ask">
      <span class="rd-n">2</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M7 3.5h7l4 4V20H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9.5 12h6M9.5 15.5h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>Read a register entry</b><span class="rd-d">Paste a line or drop a page image: Claude gives a draft reading to check. Uses Claude, only when you press the button.</span></button>
    <button type="button" role="tab" id="tab-date" class="rd-tab" aria-selected="false" aria-controls="tool-date" data-tool="date">
      <span class="rd-n">3</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 10h16M9 3v4M15 3v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>Decode a date</b><span class="rd-d">7bris 1671, xvi martii 1801: what day it was, with the working.</span></button>
    <button type="button" role="tab" id="tab-word" class="rd-tab" aria-selected="false" aria-controls="tool-word" data-tool="word">
      <span class="rd-n">4</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15 15l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>Find a word</b><span class="rd-d">uxoris, obiit, susceptores: what it means and what it does not say.</span></button>
  </div>

  <section id="tool-story" class="rd-panel" role="tabpanel" aria-labelledby="tab-story">
    <div class="sp" id="sp" aria-label="Your story">
      <nav class="sp-rail" id="sp-rail" aria-label="On this page" hidden>
        <span class="sp-grp">Your story</span>
        <a href="#sp-told" data-go="sp-told">What you told us</a>
        <a href="#sp-family" data-go="sp-family" hidden>The family</a>
        <a href="#sp-places" data-go="sp-places" hidden>Place by place</a>
        <a href="#sp-life" data-go="sp-life" hidden>The person, as told</a>
        <a href="#sp-names" data-go="sp-names" hidden>Names and spellings</a>
        <a href="#sp-setting" data-go="sp-setting" hidden>What was going on</a>
        <span class="sp-grp">Research</span>
        <a href="#sp-plan" data-go="sp-plan" hidden>Your research plan</a>
        <a href="#sp-keep" data-go="sp-keep" hidden>Keep it</a>
      </nav>

      <div class="sp-main">
        <header id="sp-told" class="sp-head">
          <h2 class="sp-title" id="sp-title">Tell us what you know</h2>
          <p class="sp-lede" id="sp-lede">Type it, paste it, or say it your own way. Names, places and years are all we need. The page fills in as you write.</p>
        </header>

        <div class="sp-drop" id="sp-drop">
          <textarea id="sp-text" rows="4" maxlength="8000" spellcheck="false" aria-label="What you know" placeholder="My great-grandfather Ivan Kosina came from Gallignana to Hamilton around 1905. All I have is this photo."></textarea>
          <ul class="sp-shots" id="sp-shots" hidden aria-label="Pictures you added"></ul>
          <p class="sp-row">
            <label class="sp-add"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> Photo or document<input type="file" id="sp-file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
            <button type="button" class="sp-ghost" id="sp-eg">Try an example</button>
            <button type="button" class="sp-ghost" id="sp-tidy" title="Claude rewrites your words as short plain sentences, so the page can read them. You see both before anything changes.">AI ready</button>
            <button type="button" class="sp-ghost" id="sp-postbtn" title="Paste a post from a forum or group that asks for help: get what it knows, what it asks and a draft reply.">Paste a forum post</button>
            <button type="button" class="sp-ghost" id="sp-read" hidden>Read the writing on it with Claude</button>
            <button type="button" class="sp-ghost" id="sp-clear" hidden>Start over</button>
          </p>
          <p class="sp-fine">Drag a picture onto this box, or paste one. It stays in this tab until you choose to have it read.</p>
        </div>
        <section class="sp-aipanel" id="sp-aipanel" aria-labelledby="sp-aip-h" hidden>
          <header class="sp-aip-head">
            <h3 id="sp-aip-h">Get the story AI ready</h3>
            <button type="button" class="sp-ghost sp-aip-close" id="sp-aip-x" aria-label="Close this panel">Close</button>
          </header>
          <p class="sp-aip-note" id="sp-aip-note"></p>
          <div class="sp-aip-in" hidden>
            <label class="sp-aip-lab" for="sp-aip-in">The post to read</label>
            <textarea id="sp-aip-in" rows="7" maxlength="8000" spellcheck="false" placeholder="Paste the post here: for example, someone asking who the parents of their grandfather were, with what they know."></textarea>
          </div>
          <div class="sp-aip-send" id="sp-aip-send" hidden>
            <span class="sp-aip-lab">What will be sent</span>
            <blockquote class="sp-aip-quote" id="sp-aip-preview"></blockquote>
          </div>
          <label class="sp-aip-ok"><input type="checkbox" id="sp-aip-ok" /> <span id="sp-aip-consent"></span></label>
          <div class="sp-aip-act">
            <button type="button" class="sp-btn" id="sp-aip-go" disabled>Make it AI ready</button>
            <span class="sp-aip-why" id="sp-aip-why" aria-live="polite"></span>
          </div>
          <p class="sp-status" id="sp-aip-status" role="status" aria-live="polite"></p>
          <div id="sp-aip-out"></div>
        </section>
        <div class="sp-did" id="sp-did" hidden></div>
        <div class="sp-chips" id="sp-chips" aria-live="polite"></div>
        <p class="sp-status" id="sp-status" role="status" aria-live="polite"></p>

        <section class="sp-sec" id="sp-family" aria-labelledby="sp-family-h" hidden>
          <h2 id="sp-family-h">The family, as you told it</h2>
          <div id="sp-tree"></div>
        </section>

        <section class="sp-sec" id="sp-places" aria-labelledby="sp-places-h" hidden>
          <h2 id="sp-places-h">Place by place</h2>
          <div class="sp-map" id="sp-map" role="img" aria-label="Map of the places in the story, in order"></div>
          <div class="sp-time" id="sp-time" hidden>
            <button type="button" class="sp-play" id="sp-play">▶ Play</button>
            <input type="range" id="sp-year" min="1800" max="1900" step="1" value="1800" aria-label="Year" />
            <output id="sp-yearout" class="sp-yearout" for="sp-year"></output>
          </div>
          <div class="sp-cap lf-capbox" id="sp-cap"></div>
          <div id="sp-stops"></div>
        </section>

        <section class="sp-sec" id="sp-life" aria-labelledby="sp-life-h" hidden>
          <h2 id="sp-life-h">The person, as told</h2>
          <p class="sp-sublede">Kept as you told it. Nothing here is checked against a record.</p>
          <div id="sp-lifebox"></div>
        </section>

        <section class="sp-sec" id="sp-names" aria-labelledby="sp-names-h" hidden>
          <h2 id="sp-names-h">Names and spellings</h2>
          <div id="sp-namesbox"></div>
        </section>

        <section class="sp-sec" id="sp-setting" aria-labelledby="sp-setting-h" hidden>
          <h2 id="sp-setting-h">What was going on</h2>
          <div class="lf-moments" id="sp-moments"></div>
          <div id="sp-ask"></div>
        </section>

        <section class="sp-sec sp-planbox" id="sp-plan" aria-labelledby="sp-plan-h" hidden>
          <div class="sp-plan-h">
            <div>
              <h2 id="sp-plan-h">Your research plan</h2>
              <p class="sp-sublede">Who to contact, what to read, where to look. Built from your story and the Atlas&rsquo;s own records of archives and registers.</p>
            </div>
            <button type="button" class="sp-btn" id="sp-ai-btn">Build my research plan</button>
          </div>
          <p class="sp-ai-note" id="sp-ai-note">Nothing is sent until you press the button. Then only what the story says (places, relationships, years and the Atlas records matched to them) goes to Claude Haiku. Not the picture, not the full text, and no name.</p>
          <p class="sp-status" id="sp-ai-status" role="status" aria-live="polite"></p>
          <div id="sp-ai-out" hidden></div>
          <h3 class="sp-steps-h">What to do first</h3>
          <div class="sp-plan" id="sp-steps"></div>
        </section>

        <section class="sp-sec" id="sp-keep" aria-labelledby="sp-keep-h" hidden>
          <h2 id="sp-keep-h">Keep it</h2>
          <div class="sp-fa">
            <label class="sp-fa-l"><span class="sp-sr">Which family research</span><select id="sp-fa-line"></select></label>
            <input type="text" id="sp-fa-name" maxlength="60" aria-label="Name for the new family research" placeholder="A surname" />
            <button type="button" class="sp-btn" id="sp-fa-btn">Add this family to your research</button>
            <button type="button" class="sp-btn sp-btn-ghost" id="sp-save-btn">Save the story only</button>
          </div>
          <p class="sp-fine">Adding a family starts a research list with the registers above marked as planned, and makes it your active family. Saving keeps just the words (and the names of any photos) in <a href={u("/my-research/#story")}>My story</a>, in My research. Either stays in this browser.</p>
          <p class="sp-fine sp-out" id="sp-fa-out" role="status"></p>
          <p class="sp-fine sp-out" id="sp-save-out" role="status"></p>
          <p class="sp-fine">Already have a tree? <a href={u("/tree-canvas/")}>Open it in the Tree Canvas</a> to see everyone on the map.</p>
        </section>

        <p class="sp-fine sp-priv">Nothing leaves your browser until you press &ldquo;Build my research plan&rdquo; or &ldquo;Read the writing on it with Claude&rdquo;. Please do not enter details of anyone who may be alive.</p>
      </div>
    </div>
  </section>

  <section id="tool-ask" class="rd-panel" role="tabpanel" aria-labelledby="tab-ask" hidden>
    <p class="rd-lead">This is the part that uses Claude. Paste one register entry, or drop up to four pictures of the page, and press the button: you get a draft reading to check against the page, and what the Atlas knows about that place and year. If you want a family story turned into a journey and a plan instead, use <a href="#story" data-tool-link="story">Start with your story</a>.</p>
    <div class="one ask-card" id="ask" hidden>
      <div class="ask-head">
        <span class="ask-spark" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="currentColor"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" fill="currentColor"/></svg></span>
        <div>
          <h2 class="ask-title">Show Claude a line from a register</h2>
          <p class="ask-lead">Paste an entry, or drop up to four pictures of the page. You get a draft reading to check against the page, and what the Atlas knows about that place and year.</p>
        </div>
      </div>
      <div class="ask-drop" id="ask-drop">
        <textarea id="ask-text" rows="4" maxlength="4000" spellcheck="false" aria-label="A line from a register" placeholder="Paste or type one entry, as written"></textarea>
        <p class="ask-hint"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> or drop pictures here, up to four. You can paste them too.</p>
      </div>
      <ul class="ask-tray" id="ask-tray" aria-label="Pictures ready to read" hidden></ul>
      <div class="ask-bar">
        <input type="text" id="ask-where" maxlength="120" spellcheck="false" aria-label="Where the entry is from, if you know" placeholder="From where? A place and a year help (optional)" />
        <button type="button" id="ask-go" class="chip ask-btn ask-cta">Read this line</button>
      </div>
      <p class="ask-more">
        <label class="ask-file ask-link">Add pictures<input type="file" id="ask-photo" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
        <span aria-hidden="true">·</span>
        <button type="button" id="ask-atlas" class="ask-link">What the Atlas holds on this</button>
      </p>
      <div class="ask-ready" id="ask-ready" hidden>
        <p class="ask-ready-n" id="ask-ready-n"></p>
        <p class="ask-row">
          <button type="button" id="ask-read-docs" class="chip ask-btn is-primary">Read as documents</button>
          <button type="button" id="ask-read-lines" class="chip ask-btn">Read as register lines</button>
          <button type="button" id="ask-clear" class="ask-link">Remove all</button>
        </p>
        <p class="cap" id="ask-ready-cost"></p>
      </div>
      <div id="ask-ts"></div>
      <p class="cap ask-meter" id="ask-meter" aria-live="polite" hidden></p>
      <p class="cap ask-status" id="ask-status" role="status" aria-live="polite"></p>
      <div id="ask-out" aria-live="polite"></div>
      <div id="ask-hand" hidden></div>
      <div id="ask-sum" aria-live="polite" hidden></div>
      <details class="ask-priv ask-fine"><summary><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 11V8a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg> Nothing is sent until you press a button. What is sent, and what is kept</summary>
        <p>What you paste or photograph is sent over the internet to our small service and on to Claude, an AI made by
        Anthropic, which writes the draft. We keep no text, no picture and no answer, only a count of how many tries each visitor has used. Anthropic's
        <a href="https://privacy.claude.com/en/articles/7996866-how-long-do-you-store-my-organization-s-data" rel="noopener">published policy</a> says it deletes
        what is sent within 30 days, keeps content its safety systems flag for longer, and does not train on it without permission. Please do not paste or photograph details of
        people who may be alive. Cloudflare's bot check loads when you first click in the box. <a href={u("/privacy/")}>More in the privacy note.</a></p></details>
    </div>
  </section>

  <section id="tool-date" class="rd-panel" role="tabpanel" aria-labelledby="tab-date" hidden>
    <div class="one" id="rr-date">
      <div class="lab">Decode a date</div>
      <p class="cap" style="margin-top:6px">Digits, Roman numerals or Latin words. The old signs 7bris, 8bris, 9bris and 10bris (Xbris) are
      September to December. The answer shows its working, and says what it could not read.</p>
      <p><input type="text" id="rr-d" autocomplete="off" spellcheck="false" aria-label="A date as written in the register" placeholder="die 30 7bris 1671" /></p>
      <p class="cap rr-chips">Try: {dateChips.map((c) => <button type="button" class="chip rr-dchip" data-q={c}>{c}</button>)}</p>
      <div id="rr-dout" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section id="tool-word" class="rd-panel" role="tabpanel" aria-labelledby="tab-word" hidden>
    <div class="one" id="rr-find">
      <div class="lab">Find a word</div>
      <p class="cap" style="margin-top:6px">Spell it as written. Capitals, accents, i for j and u for v do not matter, and another ending finds the same word
      (uxoris, uxorem). English works too.</p>
      <p><input type="search" id="rr-q" autocomplete="off" spellcheck="false" aria-label="A word from the register" placeholder="uxoris" /></p>
      <p class="rr-filters" role="group" aria-label="Kind of record">
        {Object.entries(eventNames).map(([k, v]) => <label><input type="checkbox" class="rr-ev" value={k} /> {v}</label>)}
        <label>Language <select id="rr-lang"><option value="">All</option>{Object.entries(langNames).filter(([l]) => langCount[l]).map(([l, n]) => <option value={l}>{n} ({langCount[l]})</option>)}</select></label>
      </p>
      <p class="cap rr-chips">Try: {chips.map((c) => <button type="button" class="chip rr-chip" data-q={c}>{c}</button>)}</p>
      <div id="rr-out" role="status" aria-live="polite"></div>
      <details class="rr-alldet">
      <summary><b>Browse all {terms.length} terms, A to Z</b> <span class="rr-m">the whole list the word finder searches, not only what matched</span></summary>
      <ul class="rr-all">
        {terms.map((t) => (
          <li><b>{t.forms[0]}</b> <span class="rr-m">{langNames[t.lang] || t.lang} · {t.means}</span></li>
        ))}
      </ul>
    </details>
    </div>
  </section>

  <ProgressKit />
  <script type="application/json" id="rr-data" set:html={JSON.stringify({ terms, seen, langs: langNames, sources: Object.fromEntries(Object.entries(sources).map(([k, s]) => [k, s.title])) })}></script>
  <script is:inline>
    (function () {
      var tabs = [].slice.call(document.querySelectorAll(".rd-tab"));
      function pick(name, focus) {
        tabs.forEach(function (t) {
          var on = t.dataset.tool === name;
          t.classList.toggle("is-on", on); t.setAttribute("aria-selected", on ? "true" : "false"); t.tabIndex = on ? 0 : -1;
          document.getElementById("tool-" + t.dataset.tool).hidden = !on;
          if (on && focus) t.focus();
        });
        try { history.replaceState(null, "", "#" + name); } catch (e) {}
      }
      window.raReadPick = pick;
      [].forEach.call(document.querySelectorAll("[data-tool-link]"), function (a) { a.addEventListener("click", function (e) { e.preventDefault(); pick(a.getAttribute("data-tool-link")); }); });
      tabs.forEach(function (t, i) {
        t.addEventListener("click", function () { pick(t.dataset.tool); });
        t.addEventListener("keydown", function (e) {
          var n = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (n) { e.preventDefault(); pick(tabs[(i + n + tabs.length) % tabs.length].dataset.tool, true); }
        });
      });
      var h = (location.hash || "").slice(1);
      pick(/[?&]q=/.test(location.search) ? "word" : (h === "date" || h === "word" || h === "ask" || h === "story" ? h : "story"));
    })();
  </script>
  <script is:inline src={u("/js/record-reader.js")}></script>
  <script is:inline src={u("/js/ask-claude.js")} defer></script>
  <script is:inline src={u("/js/atlas-summary.js")} defer></script>
  <script is:inline src={u("/js/shard-key.js")} defer></script>
  <script is:inline src={u("/js/story-engine.js")} defer></script>
  <script is:inline src={u("/js/story-plan.js")} defer></script>
  <script is:inline src={u("/js/story-page.js")} defer></script>
  <script is:inline src={u("/js/story-ai.js")} defer></script>
  <script is:inline src={u("/js/case-atlas.js")} defer></script>
  <script is:inline src={u("/js/handover.js")} defer></script>
  <script is:inline>
    (function () {
      var R = window.raReadRecord; if (!R) return;
      var D = JSON.parse(document.getElementById("rr-data").textContent), idx = R.index(D.terms);
      var q = document.getElementById("rr-q"), out = document.getElementById("rr-out");
      var d = document.getElementById("rr-d"), dout = document.getElementById("rr-dout");
      var EV = { baptism: "baptism", marriage: "marriage", burial: "burial", all: "any record" };
      function el(tag, text, cls) { var e = document.createElement(tag); if (text != null) e.textContent = text; if (cls) e.className = cls; return e; }
      function events() { return [].slice.call(document.querySelectorAll(".rr-ev:checked")).map(function (c) { return c.value; }); }
      var LN = D.langs || {}, SEEN = D.seen || { terms: {}, concepts: {} };
      var KIND = { baptism: "baptisms and births", marriage: "marriages", banns: "marriage banns", death: "deaths and burials", confirmation: "confirmations", index: "indexes", "soul-count": "parish censuses" };
      function num(n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ","); }
      function where(x) {
        var top = x.countries.slice(0, 3).map(function (c) { return c[0] + " " + num(c[1]); }).join(", "), more = x.nCountries - Math.min(3, x.countries.length);
        return top + (more > 0 ? " and " + more + " more countr" + (more === 1 ? "y" : "ies") : "");
      }
      function when(x) { return x.mostly ? "most from " + x.mostly[0] + " to " + x.mostly[1] + (x.earliest && x.earliest < x.mostly[0] - 30 ? ", the earliest " + x.earliest : "") : (x.earliest ? "earliest " + x.earliest : ""); }
      function card(t) {
        var c = el("div", null, "rr-card");
