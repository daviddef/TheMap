  .rr-filters select { font: inherit; margin-left: 4px; }
  .rr-chips .chip { background: var(--panel); color: var(--ink-2); font-size: 13px; padding: 5px 12px; border-radius: 999px; cursor: pointer; letter-spacing: 0; }
  .rr-chips .chip:hover, .rr-chips .chip:focus-visible { border-color: var(--accent); color: var(--accent); background: var(--accent-wash); }
  .sp .lf-askyear[hidden] { display: none; }
  .sp .lf-askyear { margin: 8px 0; padding: 10px 14px; border: 1px dashed var(--accent); border-radius: 10px; font-size: 14.5px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .sp .lf-askyear input { width: 6.5em; font: inherit; padding: 6px 8px; border-radius: 6px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); }
  .sp .lf-askyear button { font: 600 14px/1 var(--sans); padding: 8px 12px; border-radius: 8px; border: 0; background: var(--accent); color: #fff; cursor: pointer; }
  .sp .lf-person { margin: 0 0 6px; border: 1px solid var(--rule); border-radius: 10px; padding: 6px 12px; background: var(--ground); } .sp .lf-person summary { cursor: pointer; }
  .sp .lf-tree { display: grid; gap: 0; justify-items: center; margin: 8px 0 4px; max-width: 54rem; }
  .sp .lf-tree :where(.lf-gen) { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }   /* the tree's rows only: the books-by-generation folds share the class */
  .sp .lf-side { display: grid; gap: 6px; justify-items: center; align-content: start; } .sp .lf-side-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .sp .lf-side-h { font: 700 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
  .sp .lf-grand { gap: 18px 28px; } .sp .lf-side .lf-card { min-width: 7.5rem; max-width: 12rem; padding: 8px 10px; }
  .sp .lf-tie { width: 2px; height: 22px; background: var(--rule-strong); }
  .sp .lf-card { min-width: 11rem; max-width: 19rem; padding: 10px 14px; border: 1px solid var(--rule-strong); border-radius: 12px; background: var(--panel); text-align: center; animation: sp-rise .5s ease both; }
  .sp .lf-card-self { border-color: var(--accent); background: var(--accent-wash); } .sp .lf-card-you { border-style: dashed; }
  .sp .lf-card-role { font: 600 11px/1 var(--sans); letter-spacing: .09em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
  .sp .lf-card-name { font: 500 18px/1.25 var(--serif); } .sp .lf-card-place, .sp .lf-card-forms { font-size: 13px; color: var(--ink-2); margin-top: 3px; }
    .sp .lf-others { margin-top: 18px; max-width: 54rem; } .sp .lf-others-h { font: 600 11px/1 var(--sans); letter-spacing: .09em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 8px; text-align: center; }
  .sp .lf-others-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; } .sp .lf-other { padding: 8px 12px; border: 1px solid var(--rule); border-radius: 10px; background: var(--panel); text-align: center; min-width: 8rem; }
  .sp .lf-other-name { font: 500 15px/1.25 var(--serif); } .sp .lf-other-rel { font-size: 12px; color: var(--ink-2); margin-top: 2px; }
  .sp .lf-couple .lf-card { min-width: 9rem; max-width: 13rem; padding: 8px 10px; }
  .sp .lf-kids .lf-card { flex: 1 1 7.5rem; min-width: 7.5rem; max-width: 10rem; padding: 8px 10px; } .sp .lf-kids .lf-card-name { font-size: 16px; }
  .sp .lf-no, .sp-rail .lf-no { display: inline-grid; place-items: center; min-width: 19px; height: 19px; padding: 0 4px; margin-right: 6px; border-radius: 999px; background: var(--accent); color: var(--panel); font: 700 11px/1 var(--sans); letter-spacing: 0; vertical-align: middle; }
  .sp .lf-jump { display: block; margin: 6px auto 0; padding: 2px 0; font: 600 12.5px/1.3 var(--sans); color: var(--accent); background: transparent; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .sp .lf-person > .lf-jump { margin: 8px 0 2px; } .sp .lf-person { scroll-margin-top: 84px; } .sp-rail .psub-n { min-width: 0; }
  .sp .lf-card-maiden { font: 700 10.5px/1.3 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); margin-top: 1px; }
  .sp .lf-card-line { border-style: dashed; background: transparent; } .sp .lf-card-line .lf-card-name { font-size: 15px; font-style: italic; color: var(--ink-2); }
  .sp .lf-line-note { flex: 1 0 100%; text-align: center; font-size: 13px; color: var(--ink-2); margin: 0 0 2px; }
  .sp .lf-line { flex-wrap: wrap; }
  .sp .lf-card-empty { border-style: dashed; background: transparent; } .sp .lf-card-empty .lf-card-name { color: var(--ink-3); font-size: 15px; font-style: italic; }
  .sp .lf-card.editing { max-width: 23rem; text-align: left; } .sp .lf-card.editing .lf-card-role, .sp .lf-card.editing .lf-card-name { text-align: center; }
  .sp .lf-edit { margin-top: 8px; font: 600 12.5px/1 var(--sans); color: var(--accent); background: transparent; border: 1px solid var(--rule-strong); border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .sp .lf-edit:hover { background: var(--accent-wash); }
  .sp .lf-form { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px; margin-top: 10px; text-align: left; }
  .sp .lf-form label { display: grid; gap: 3px; grid-column: 1 / -1; font: 600 11px/1.2 var(--sans); color: var(--ink-2); } .sp .lf-form label.sm { grid-column: auto; }
  .sp .lf-form input { font: 400 14px/1.3 var(--sans); padding: 6px 8px; border: 1px solid var(--rule-strong); border-radius: 8px; background: var(--panel); color: var(--ink); min-width: 0; width: 100%; box-sizing: border-box; }
  .sp .lf-form-row { grid-column: 1 / -1; display: flex; gap: 8px; } .sp .lf-form-row button { font: 600 13px/1 var(--sans); padding: 8px 14px; border-radius: 999px; border: 1px solid var(--rule-strong); background: var(--panel); color: var(--ink); cursor: pointer; }
  .sp .lf-form-row button[type="submit"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .sp .lf-form-note { grid-column: 1 / -1; margin: 0; font-size: 11.5px; color: var(--ink-3); }
  .sp-plan { display: grid; gap: 10px; max-width: 54rem; }
  .sp-pstep { background: var(--ground); border: 1px solid var(--rule); border-radius: 14px; padding: 14px 18px 10px; animation: sp-rise .5s ease both; }
  .sp-pstep h3 { font: 500 19px/1.3 var(--serif); margin: 0 0 4px; display: flex; gap: 12px; align-items: baseline; }
  .sp-num { flex: none; display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; font: 600 14px/1 var(--sans); transform: translateY(-2px); }
  .sp-pstep p, .sp-pstep ul { font-size: 15px; line-height: 1.5; margin: 0 0 8px; max-width: var(--measure); } .sp-pstep ul { padding-left: 20px; } .sp-why { color: var(--ink-2); }
  .sp-ask b { color: var(--accent); } .sp-not b { color: var(--brick); }
  @keyframes sp-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .sp button:focus-visible, .sp summary:focus-visible, .sp textarea:focus-visible { outline: 3px solid var(--accent-2); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .sp-step, .sp-stage, .sp-chip.pop, .sp-pstep, .sp-family, .sp-shot img { animation: none; transition: none; } }


  /* the plan, place by place: today's four moves, then a card each for the desk, the letter, the neighbours, the ground, the times and the moves */
  .sp-todo { margin: 6px 0 14px; }
  .sp-todo-h { font: 800 17px/1.2 var(--sans); margin: 14px 0 8px; }
  .sp-todo-note { margin: 8px 0; padding: 10px 14px; border-left: 4px solid var(--hue); background: var(--hue-wash); border-radius: 0 12px 12px 0; font-size: 14px; }
  .sp-today { list-style: none; margin: 0 0 16px; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; }
  .sp-today li { background: var(--panel); border: 1px solid var(--rule); border-radius: 14px; padding: 12px 14px; font-size: 14px; line-height: 1.4; display: grid; gap: 4px; align-content: start; min-width: 0; overflow-wrap: anywhere; }
  .sp-today li b { font-weight: 800; }
  .sp-today-n { width: 24px; height: 24px; border-radius: 50%; background: var(--hue-solid); color: var(--on-hue); font: 800 13px/24px var(--sans); text-align: center; }
  .sp-todo-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 14px; }
  .sp-todo-card { min-width: 0; padding: 16px 18px; }
  .sp-todo-card h3 { font: 800 16px/1.2 var(--sans); margin: 0 0 12px; padding-left: 10px; border-left: 4px solid var(--hue); }
  .sp-todo-card ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .sp-todo-card li { display: grid; gap: 3px; font-size: 14px; line-height: 1.4; overflow-wrap: anywhere; }
  .sp-todo-card li.is-gap { border-left: 2px dashed var(--rule-strong, var(--rule)); padding-left: 10px; color: var(--ink-2); }
  .sp-todo-t b { font-weight: 800; }
  .sp-todo-tag { font-size: 11px; padding: 2px 8px; margin-left: 4px; }
  .sp-todo-why { color: var(--ink-2); font-size: 13px; }
  .sp-todo-det { color: var(--ink-2); font-size: 12.5px; }
  .sp-todo-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .sp-todo-link { min-height: 32px; display: inline-flex; align-items: center; text-decoration: none; white-space: normal; max-width: 100%; }
  .sp-todo-wide { grid-column: 1 / -1; }
  .sp-todo-person summary { cursor: pointer; line-height: 1.4; overflow-wrap: anywhere; }
  .sp-todo-steps { margin: 6px 0 2px; padding-left: 18px; display: grid; gap: 8px; } .sp-todo-card .sp-todo-steps li { display: list-item; border: 0; padding: 0; overflow-wrap: anywhere; }
  .sp-todo-steps li > span { display: block; }
  .sp-todo-steps li > span.sp-todo-links { display: flex; }
  .sp-todo-card ul.sp-todo-known { list-style: disc; margin: 2px 0 8px; padding-left: 18px; gap: 2px; font-size: 13px; } .sp-todo-card ul.sp-todo-known li { display: list-item; }
  .sp-todo-draft { margin-top: 4px; }
  .sp-todo-draft summary { cursor: pointer; font-size: 13px; font-weight: 700; color: var(--hue-ink); }
  .sp-todo-draft-t { margin: 6px 0 0; padding: 10px 12px; background: var(--panel-2, var(--panel)); border-radius: 10px; font-size: 13.5px; user-select: all; }
  .sp-method { margin-top: 14px; }
  .sp-method > summary { cursor: pointer; font-weight: 700; color: var(--hue-ink); }

  /* THE FAMILY FIRST: the tree is the selector, three searches, one person, and the shelves. New names start sp- */
  .sp .sp-drop { padding: 14px 18px 10px; border-radius: 18px; }
  .sp .sp-drop textarea { min-height: 64px; }
  .sp .sp-fam .lf-tree { max-width: none; justify-items: center; }
  .sp .sp-fam-card { position: relative; box-sizing: border-box; max-width: min(19rem, 100%); overflow-wrap: anywhere; }
  .sp .sp-fam-card:hover { border-color: var(--accent); }
  .sp .sp-fam-pick { display: inline; margin: 0; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-align: inherit; cursor: pointer; }
