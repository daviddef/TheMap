---
/* READING THE RECORD: a term finder and a date decoder for old church registers.
 *
 * The terms are data/record-terms.json (every one sourced, in our own words, nothing about a person); the finder and decoder are
 * public/js/record-reader.js, which only reads what is typed. Plan: docs/reading-the-record-plan.md. This is its first piece:
 * the annotated page, the line reader and the trap list come later.
 */
import Base from "../layouts/Base.astro";
import { recordTerms } from "../lib/record-terms.js";
import { u } from "../lib/url.js";
import ProgressKit from "../components/ProgressKit.astro";
const { sources, terms } = recordTerms();
const chips = ["uxoris", "7bris", "susceptores", "obiit", "infans", "natum"];
const dateChips = ["die 30 7bris 1671", "undecima februarii anno millesimo septingentesimo quadragesimo sexto", "xvi martii 1801"];
const eventNames = { baptism: "Baptism", marriage: "Marriage", burial: "Burial" };
---
<Base
  title="Reading the record"
  eyebrow={`${terms.length} terms · every one sourced · the finder and date decoder keep everything in your browser`}
  dek="Type a word as you see it in the register, or a whole date, and see what it is, what it does not tell you, and where it comes from."
  description="A searchable guide to the Latin of old church registers: look up a word, an abbreviation or an ending, and decode a date such as 'die 30 7bris 1671'.">

  <div class="rd-pick" role="tablist" aria-label="What would you like to do?">
    <button type="button" role="tab" id="tab-ask" class="rd-tab is-on" aria-selected="true" aria-controls="tool-ask" data-tool="ask">
      <span class="rd-n">1</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><b>Ask Claude to read a line</b><span class="rd-d">Paste a line or a picture. Get a reading, and the story of the place.</span></button>
    <button type="button" role="tab" id="tab-date" class="rd-tab" aria-selected="false" aria-controls="tool-date" data-tool="date">
      <span class="rd-n">2</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 10h16M9 3v4M15 3v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>Decode a date</b><span class="rd-d">7bris 1671, xvi martii 1801: what day it was, with the working.</span></button>
    <button type="button" role="tab" id="tab-word" class="rd-tab" aria-selected="false" aria-controls="tool-word" data-tool="word">
      <span class="rd-n">3</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15 15l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>Find a word</b><span class="rd-d">uxoris, obiit, susceptores: what it means and what it does not say.</span></button>
  </div>

  <section id="tool-ask" class="rd-panel" role="tabpanel" aria-labelledby="tab-ask">
    <div class="one" id="ask" hidden>
      <p class="ask-lead">Paste a register line or drop up to four pictures. Claude drafts a reading to check against the page, not an answer.</p>
      <details class="ask-priv"><summary>Nothing is sent until you press a button. What is sent, and what is kept</summary>
        <p>What you paste or photograph is sent over the internet to our small service and on to Claude, an AI made by
        Anthropic, which writes the draft. We keep no text, no picture and no answer, only a count of how many tries each visitor has used. Anthropic's
        <a href="https://privacy.claude.com/en/articles/7996866-how-long-do-you-store-my-organization-s-data" rel="noopener">published policy</a> says it deletes
        what is sent within 30 days, keeps content its safety systems flag for longer, and does not train on it without permission. Please do not paste or photograph details of
        people who may be alive. Cloudflare's bot check loads when you first click in the box. <a href={u("/privacy/")}>More in the privacy note.</a></p></details>
      <div class="ask-drop" id="ask-drop">
        <textarea id="ask-text" rows="4" maxlength="4000" spellcheck="false" aria-label="A line from a register" placeholder="Paste or type one entry, as written"></textarea>
        <p class="ask-hint">Drop pictures here (up to four), or paste them</p>
      </div>
      <ul class="ask-tray" id="ask-tray" aria-label="Pictures ready to read" hidden></ul>
      <p><input type="text" id="ask-where" maxlength="120" spellcheck="false" aria-label="Where the entry is from, if you know" placeholder="Where is it from? A place and a year help (optional)" /></p>
      <p class="ask-row">
        <button type="button" id="ask-go" class="chip ask-btn">Read this line</button>
        <button type="button" id="ask-atlas" class="chip ask-btn">What the Atlas holds on this</button>
        <label class="chip ask-btn ask-file">Add pictures<input type="file" id="ask-photo" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
      </p>
      <div class="ask-ready" id="ask-ready" hidden>
        <p class="ask-ready-n" id="ask-ready-n"></p>
        <p class="ask-row">
          <button type="button" id="ask-read-docs" class="chip ask-btn is-primary">Read as documents</button>
          <button type="button" id="ask-read-lines" class="chip ask-btn">Read as register lines</button>
          <button type="button" id="ask-clear" class="chip ask-btn">Remove all</button>
        </p>
        <p class="cap" id="ask-ready-cost"></p>
      </div>
      <div id="ask-ts"></div>
      <p class="cap ask-status" id="ask-status" role="status" aria-live="polite"></p>
      <div id="ask-out" aria-live="polite"></div>
      <div id="ask-hand" hidden></div>
      <div id="ask-sum" aria-live="polite" hidden></div>
    </div>
  </section>

  <section id="tool-date" class="rd-panel" role="tabpanel" aria-labelledby="tab-date" hidden>
    <div class="one" id="rr-date">
      <div class="lab">Decode a date</div>
      <p class="cap" style="margin-top:6px">Digits, Roman numerals or Latin words. The old signs 7bris, 8bris, 9bris and 10bris (Xbris) are
      September to December. The answer shows its working, and says what it could not read.</p>
      <p><input type="text" id="rr-d" autocomplete="off" spellcheck="false" aria-label="A date as written in the register" placeholder="die 30 7bris 1671" /></p>
      <p class="cap rr-chips">Try: {dateChips.map((c) => <button type="button" class="chip rr-dchip" data-q={c}>{c}</button>)}</p>
      <div id="rr-dout" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section id="tool-word" class="rd-panel" role="tabpanel" aria-labelledby="tab-word" hidden>
    <div class="one" id="rr-find">
      <div class="lab">Find a word</div>
      <p class="cap" style="margin-top:6px">Spell it as written. Capitals, accents, i for j and u for v do not matter, and another ending finds the same word
      (uxoris, uxorem). English works too.</p>
      <p><input type="search" id="rr-q" autocomplete="off" spellcheck="false" aria-label="A word from the register" placeholder="uxoris" /></p>
      <p class="rr-filters" role="group" aria-label="Kind of record">
        {Object.entries(eventNames).map(([k, v]) => <label><input type="checkbox" class="rr-ev" value={k} /> {v}</label>)}
      </p>
      <p class="cap rr-chips">Try: {chips.map((c) => <button type="button" class="chip rr-chip" data-q={c}>{c}</button>)}</p>
      <div id="rr-out" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section>
    <details class="rr-alldet">
      <summary><b>Browse all {terms.length} terms, A to Z</b> <span class="rr-m">the whole list the word finder searches, not only what matched</span></summary>
      <ul class="rr-all">
        {terms.map((t) => (
          <li><b>{t.forms[0]}</b> <span class="rr-m">{t.means}</span></li>
        ))}
      </ul>
    </details>
    <h2 class="yn-h">Where this comes from</h2>
    <p class="cap">Each meaning is written in our own words from the pages below, and each card says which. Word meanings are facts; the guides
    themselves are not copied. Where the card gives a warning, it is a point the source makes, not a rule that always holds: registers vary by
    parish and century, so look at the page in front of you.</p>
    <ul class="cap">
      {Object.entries(sources).sort((a, b) => a[1].title.localeCompare(b[1].title, "en")).map(([k, s]) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
    </ul>
    <p class="cap">Next on the plan: an annotated register page you can point at, a tool that reads a whole line, and a list of the misreadings that cost
    researchers time. <a href={u("/worklist/")}>The worklist</a> has it.</p>
  </section>

  <ProgressKit />
  <script type="application/json" id="rr-data" set:html={JSON.stringify({ terms, sources: Object.fromEntries(Object.entries(sources).map(([k, s]) => [k, s.title])) })}></script>
  <script is:inline>
    (function () {
      var tabs = [].slice.call(document.querySelectorAll(".rd-tab"));
      function pick(name, focus) {
        tabs.forEach(function (t) {
          var on = t.dataset.tool === name;
          t.classList.toggle("is-on", on); t.setAttribute("aria-selected", on ? "true" : "false"); t.tabIndex = on ? 0 : -1;
          document.getElementById("tool-" + t.dataset.tool).hidden = !on;
          if (on && focus) t.focus();
        });
        try { history.replaceState(null, "", "#" + name); } catch (e) {}
      }
      tabs.forEach(function (t, i) {
        t.addEventListener("click", function () { pick(t.dataset.tool); });
        t.addEventListener("keydown", function (e) {
          var n = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (n) { e.preventDefault(); pick(tabs[(i + n + tabs.length) % tabs.length].dataset.tool, true); }
        });
      });
      var h = (location.hash || "").slice(1);
      pick(/[?&]q=/.test(location.search) ? "word" : (h === "date" || h === "word" ? h : "ask"));
    })();
  </script>
  <script is:inline src={u("/js/record-reader.js")}></script>
  <script is:inline src={u("/js/ask-claude.js")} defer></script>
  <script is:inline src={u("/js/atlas-summary.js")} defer></script>
  <script is:inline src={u("/js/case-atlas.js")} defer></script>
  <script is:inline src={u("/js/handover.js")} defer></script>
  <script is:inline>
    (function () {
      var R = window.raReadRecord; if (!R) return;
      var D = JSON.parse(document.getElementById("rr-data").textContent), idx = R.index(D.terms);
      var q = document.getElementById("rr-q"), out = document.getElementById("rr-out");
      var d = document.getElementById("rr-d"), dout = document.getElementById("rr-dout");
      var EV = { baptism: "baptism", marriage: "marriage", burial: "burial", all: "any record" };
      function el(tag, text, cls) { var e = document.createElement(tag); if (text != null) e.textContent = text; if (cls) e.className = cls; return e; }
      function events() { return [].slice.call(document.querySelectorAll(".rr-ev:checked")).map(function (c) { return c.value; }); }
      function card(t) {
        var c = el("div", null, "rr-card");
        c.append(el("h3", t.forms[0]), el("p", t.means, "rr-means"));
        var meta = [EV[t.events] || t.events, t.role];
        c.append(el("p", meta.join(" · "), "cap"));
        c.append(el("p", "Also written: " + t.forms.slice(1).concat(t.abbr || []).join(", "), "cap"));
        if (t.note) c.append(el("p", t.note, "rr-note"));
        var s = el("p", "Source: ", "cap");
        t.src.forEach(function (k, i) { s.append((i ? "; " : "") + (D.sources[k] || k)); });
        c.append(s);
        return c;
      }
      function run() {
        out.textContent = "";
        var v = q.value.trim(); if (!v) return;
        var r = R.find(idx, v, { events: events() });
        if (!r.length) { out.append(el("p", "No term here matches that. That is not a finding about the word: the list is short so far. Try fewer letters, or the English.", "cap")); return; }
        if (r.partial) out.append(el("p", "No single card holds that whole phrase, so these are the cards for its words, one word at a time.", "cap"));
        r.slice(0, 12).forEach(function (x) { out.append(card(x.term)); });
        if (r.length > 12) out.append(el("p", "…and " + (r.length - 12) + " more. Type more of the word.", "cap"));
      }
      function runDate() {
        dout.textContent = "";
        var v = d.value.trim(); if (!v) return;
        var r = R.decodeDate(v), c = el("div", null, "rr-card");
        c.append(el("h3", r.text || "Nothing read"));
        if (r.working.length) { var ul = el("ul", null, "cap"); r.working.forEach(function (w) { ul.append(el("li", w)); }); c.append(ul); }
        r.warnings.forEach(function (w) { c.append(el("p", w, "rr-note")); });
        dout.append(c);
      }
      q.addEventListener("input", run);
      d.addEventListener("input", runDate);
      document.querySelectorAll(".rr-ev").forEach(function (b) { b.addEventListener("change", run); });
      document.querySelectorAll(".rr-chip").forEach(function (b) { b.addEventListener("click", function () { q.value = b.dataset.q; run(); }); });
      document.querySelectorAll(".rr-dchip").forEach(function (b) { b.addEventListener("click", function () { d.value = b.dataset.q; runDate(); }); });
      var m = location.search.match(/[?&]q=([^&]*)/); if (m) { q.value = decodeURIComponent(m[1].replace(/\+/g, " ")); run(); }
    })();
  </script>
</Base>
