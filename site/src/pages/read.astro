---
/* READING THE RECORD: a term finder and a date decoder for old church registers.
 *
 * The terms are data/record-terms.json (every one sourced, in our own words, nothing about a person); the finder and decoder are
 * public/js/record-reader.js, which only reads what is typed. Plan: docs/reading-the-record-plan.md. This is its first piece:
 * the annotated page, the line reader and the trap list come later.
 */
import Base from "../layouts/Base.astro";
import { recordTerms } from "../lib/record-terms.js";
import { u } from "../lib/url.js";
import ProgressKit from "../components/ProgressKit.astro";
const { sources, terms, seen } = recordTerms();
const langNames = { la: "Latin", it: "Italian", es: "Spanish", pt: "Portuguese", nl: "Dutch", de: "German", fr: "French", cs: "Czech", sk: "Slovak", pl: "Polish", da: "Danish", hu: "Hungarian", hr: "Croatian" };
const langCount = Object.fromEntries(Object.keys(langNames).map((l) => [l, terms.filter((t) => t.lang === l).length]));
const chips = ["uxoris", "7bris", "susceptores", "obiit", "infans", "natum"];
const dateChips = ["die 30 7bris 1671", "undecima februarii anno millesimo septingentesimo quadragesimo sexto", "xvi martii 1801"];
const eventNames = { baptism: "Baptism", marriage: "Marriage", burial: "Burial" };
---
<Base
  title="Reading the record"
  eyebrow={`${terms.length} terms · ${Object.values(langCount).filter(Boolean).length} languages · every one sourced`}
  dek="Type a word, a date or a whole line as you see it in the register, and see what it is, what it does not tell you, and where it comes from."
  description="A searchable guide to the words of old registers, in Latin and in the languages of their catalogue titles, with how often each turns up in the Atlas's own records, and a decoder for dates such as 'die 30 7bris 1671'.">

  <div slot="headtools" class="rd-tools" role="tablist" aria-label="Tools">
    <button type="button" role="tab" id="tab-read" class="rd-tab" data-title-read="A word, a date or a whole line from a register: type it and see what it means. Claude can draft a reading of a line or a photo when you ask." aria-selected="false" aria-controls="tool-read" data-tool="read" title="A word, a date or a whole line from a register: type it and see what it means. Claude can draft a reading of a line or a photo when you ask.">
      <svg class="rd-ico-read" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 3.5h7l4 4V20H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.5 12h6M9.5 15.5h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><svg class="rd-ico-story" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" hidden><path d="M4 20l1-4L16.5 4.5a2 2 0 013 3L8 19z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 7l3 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span class="rd-lbl">Interpret a record</span></button>
  </div>

  <section id="tool-story" class="rd-panel" aria-label="Your story">
    <div class="sp" id="sp" aria-label="Your story">
      <nav class="sp-rail" id="sp-rail" aria-label="On this page" hidden>
        <span class="sp-grp">Your story</span>
        <a href="#sp-told" data-go="sp-told">What you told us</a>
        <a href="#sp-family" data-go="sp-family" hidden>The family</a>
        <a href="#sp-three" data-go="sp-three" hidden>Do these three first</a>
        <a href="#sp-who" data-go="sp-who" hidden>The chosen person</a>
        <span class="sp-grp" id="sp-grp-research">Everything else</span>
        <a href="#sp-books" data-go="sp-books" hidden>Church books</a>
        <a href="#sp-web" data-go="sp-web" hidden>Family websites</a>
        <a href="#sp-arch" data-go="sp-arch" hidden>Archives</a>
        <a href="#sp-names" data-go="sp-names" hidden>Names and spellings</a>
        <a href="#sp-setting" data-go="sp-setting" hidden>Their times</a>
        <a href="#sp-plan" data-go="sp-plan" hidden>Your full plan</a>
        <a href="#sp-keep" data-go="sp-keep" hidden>Keep it</a>
      </nav>

      <div class="sp-main">
        <header id="sp-told" class="sp-head">
          <h2 class="sp-title" id="sp-title">Tell us what you know</h2>
          <p class="sp-lede" id="sp-lede">Who, from where, to where, when: in your own words. The page fills in as you write, and asks for what is missing.</p>
        </header>

        <div class="sp-doubt" id="sp-doubt" role="status" aria-live="polite" hidden></div>
        <div class="sp-drop" id="sp-drop">
          <div class="sp-edit" id="sp-edit"><div class="sp-mirror" id="sp-mirror" aria-hidden="true"></div>
          <textarea id="sp-text" rows="2" maxlength="8000" spellcheck="false" aria-label="What you know" placeholder="My great-grandfather Ivan Kosina came from Gallignana to Hamilton around 1905. All I have is this photo."></textarea></div>
          <ul class="sp-shots" id="sp-shots" hidden aria-label="Pictures you added"></ul>
          <div class="sp-gaps" id="sp-gaps" hidden aria-live="polite"></div>
        </div>
        <div class="sp-under">
          <p class="sp-row">
            <label class="sp-add"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> Photo or document<input type="file" id="sp-file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
            <button type="button" class="sp-ghost" id="sp-tidy" title="Claude rewrites your words as short plain sentences, so the page can read them. You see both before anything changes."><svg class="sp-spark" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M10 3l1.9 5.1L17 10l-5.1 1.9L10 17l-1.9-5.1L3 10l5.1-1.9z" fill="currentColor"/><path d="M18 14l.9 2.1L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-.9z" fill="currentColor"/><path d="M18.5 3l.6 1.4L20.5 5l-1.4.6-.6 1.4-.6-1.4L16.5 5l1.4-.6z" fill="currentColor"/></svg> Tidy with AI</button>
            <button type="button" class="sp-ghost" id="sp-postbtn" title="For a post that asks for help: Claude reads the words in the box as a request and drafts a reply for the group. Paste the post into the box first."><svg class="sp-spark" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M10 3l1.9 5.1L17 10l-5.1 1.9L10 17l-1.9-5.1L3 10l5.1-1.9z" fill="currentColor"/><path d="M18 14l.9 2.1L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-.9z" fill="currentColor"/><path d="M18.5 3l.6 1.4L20.5 5l-1.4.6-.6 1.4-.6-1.4L16.5 5l1.4-.6z" fill="currentColor"/></svg> Draft a reply</button>
            <button type="button" class="sp-ghost" id="sp-read" hidden>Read the writing on it with Claude</button>
            <button type="button" class="sp-ghost sp-icon" id="sp-link" hidden aria-label="Share a link" title="Share a link. It carries your words after the #, and that part is never sent to a server."><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="18" cy="5.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="6" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="18" cy="18.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8.3 10.7l7.4-3.9M8.3 13.3l7.4 3.9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
            <button type="button" class="sp-ghost sp-icon" id="sp-clear" hidden aria-label="Start a new story" title="Start a new story"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M13.5 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9l-5.5-5.5zM13.5 3.5V9H19M12 12.5v5M9.5 15h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button type="button" class="sp-ghost" id="sp-eg">Try an example</button>
          </p>
          <p class="sp-fine">Drag a picture onto this box, or paste one. It stays in this tab until you choose to have it read.</p>
          <p class="sp-status" id="sp-status" role="status" aria-live="polite"></p>
        </div>
        <section class="sp-aipanel" id="sp-aipanel" aria-labelledby="sp-aip-h" hidden>
          <header class="sp-aip-head">
            <h3 id="sp-aip-h">Tidy the story with AI</h3>
            <button type="button" class="sp-ghost sp-aip-close" id="sp-aip-x" aria-label="Close this panel">Close</button>
          </header>
          <p class="sp-aip-note" id="sp-aip-note"></p>
          <div class="sp-aip-send" id="sp-aip-send" hidden>
            <span class="sp-aip-lab">What will be sent</span>
            <blockquote class="sp-aip-quote" id="sp-aip-preview"></blockquote>
          </div>
          <label class="sp-aip-ok"><input type="checkbox" id="sp-aip-ok" /> <span id="sp-aip-consent"></span></label>
          <div class="sp-aip-act">
            <button type="button" class="sp-btn" id="sp-aip-go" disabled>Tidy it with AI</button>
            <span class="sp-aip-why" id="sp-aip-why" aria-live="polite"></span>
          </div>
          <p class="sp-status" id="sp-aip-status" role="status" aria-live="polite"></p>
          <div id="sp-aip-out"></div>
        </section>
        <div class="sp-lang" id="sp-lang" hidden aria-live="polite"></div>
        <details class="sp-read" id="sp-rewrite" hidden></details>
        <div class="sp-did" id="sp-did" hidden></div>
        <div class="sp-chips" id="sp-chips" aria-live="polite"></div>

        <section class="sp-sec sp-fam" id="sp-family" aria-labelledby="sp-family-h" hidden>
          <h2 id="sp-family-h">The family, as you told it</h2>
          <p class="sp-sublede">Tap anyone to see what to look for, where they were and which books cover their years.</p>
          <div id="sp-tree"></div>
          <div id="sp-fam-more" class="sp-fam-more"></div>
        </section>

        <section class="sp-sec sp-three" id="sp-three" aria-labelledby="sp-three-h" hidden>
          <div class="sp-three-top"><h2 id="sp-three-h">Do these three first</h2><p id="sp-three-done" class="sp-three-done" role="status"></p></div>
          <ol id="sp-three-list" class="sp-three-list"></ol>
          <p class="sp-fine">The three searches most likely to move the family on. A tick stays on this page only: it is gone if you reload or close it.</p>
        </section>

        <section class="sp-sec sp-who" id="sp-who" aria-label="The chosen person" hidden>
          <div id="sp-who-head"></div>
          <div id="sp-who-facts"></div>
          <div id="sp-life" class="sp-who-life" hidden>
            <h3 class="sp-sub-h">The person, as told</h3>
            <p class="sp-sublede">Kept as you told it. Nothing here is checked against a record.</p>
            <div id="sp-lifebox"></div>
          </div>
          <div id="sp-line"></div>
          <div class="sp-who-map" id="sp-places" role="group" aria-labelledby="sp-places-h" hidden>
            <h2 id="sp-places-h" class="sp-sr">On the map</h2>
            <div class="sp-mapmode" id="sp-mapmode" role="group" aria-label="What the map shows">
              <button type="button" class="sp-ghost" id="sp-map-person" aria-pressed="true" hidden>Their places</button>
              <button type="button" class="sp-ghost" id="sp-map-all" aria-pressed="false" hidden>The whole family</button>
              <button type="button" class="sp-ghost" id="sp-map-near" aria-pressed="false" hidden>Books near this place</button>
            </div>
            <div class="sp-mapwrap">
              <div class="sp-map" id="sp-map" role="img" aria-label="Map of the places in the story, in order"></div>
              <div class="sp-time" id="sp-time" hidden>
                <button type="button" class="sp-play" id="sp-play">▶ Play</button>
                <input type="range" id="sp-year" min="1800" max="1900" step="1" value="1800" aria-label="Year" />
                <output id="sp-yearout" class="sp-yearout" for="sp-year"></output>
              </div>
            </div>
            <p class="sp-fine" id="sp-map-say"></p>
            <div class="sp-cap lf-capbox" id="sp-cap"></div>
            <div class="lf-moments" id="sp-mapnote"></div>
            <div id="sp-near"></div>
            <div id="sp-ask"></div>
          </div>
          <div id="sp-event" aria-live="polite"></div>
        </section>

        <section class="sp-sec sp-else" id="sp-else" aria-labelledby="sp-else-h" hidden>
          <h2 id="sp-else-h">Everything else we found</h2>
          <p class="sp-sublede">Each thing is here once. Pick a shelf.</p>
          <div class="sp-tabs" id="sp-tabs" role="tablist" aria-label="Shelves">
            <button type="button" role="tab" id="sp-tab-books" aria-controls="sp-books" aria-selected="true">Church books</button>
            <button type="button" role="tab" id="sp-tab-web" aria-controls="sp-web" aria-selected="false" tabindex="-1">Family websites</button>
            <button type="button" role="tab" id="sp-tab-archives" aria-controls="sp-arch" aria-selected="false" tabindex="-1">Archives</button>
            <button type="button" role="tab" id="sp-tab-names" aria-controls="sp-names" aria-selected="false" tabindex="-1">Names and spellings</button>
            <button type="button" role="tab" id="sp-tab-times" aria-controls="sp-setting" aria-selected="false" tabindex="-1">Their times</button>
            <button type="button" role="tab" id="sp-tab-plan" aria-controls="sp-plan" aria-selected="false" tabindex="-1">Your full plan</button>
          </div>

          <div class="sp-shelf" id="sp-books" role="tabpanel" aria-labelledby="sp-tab-books" tabindex="0">
            <p class="sp-sublede">Church and civil register books for each place and its neighbours, and where the dead lie.</p>
            <div id="sp-books-desk" class="sp-plancards"></div>
            <div id="sp-stops"></div>
            <div id="sp-books-near" class="sp-plancards"></div>
            <div id="sp-books-ground" class="sp-plancards"></div>
          </div>
          <div class="sp-shelf" id="sp-web" role="tabpanel" aria-labelledby="sp-tab-web" tabindex="0" hidden>
            <p class="sp-row"><button type="button" class="sp-ghost" id="sp-free" aria-pressed="false">Free only</button> <span class="sp-fine" id="sp-free-say" role="status"></span></p>
            <p class="sp-fine">Free means free, or free with an account.</p>
            <div id="sp-web-places"></div>
          </div>
          <div class="sp-shelf" id="sp-arch" role="tabpanel" aria-labelledby="sp-tab-archives" tabindex="0" hidden>
            <p class="sp-sublede">Every archive and library the Atlas lists for these countries.</p>
            <div id="sp-arch-places"></div>
          </div>
          <div class="sp-shelf" id="sp-names" role="tabpanel" aria-labelledby="sp-tab-names" tabindex="0" hidden>
            <h3 id="sp-names-h" class="sp-sr">Names and spellings</h3>
            <div id="sp-namesbox"></div>
            <div id="sp-names-note"></div>
          </div>
          <div class="sp-shelf" id="sp-setting" role="tabpanel" aria-labelledby="sp-tab-times" tabindex="0" hidden>
            <h3 id="sp-setting-h" class="sp-sr">Their times</h3>
            <div id="sp-times-era" class="sp-plancards"></div>
            <div id="sp-times-places"></div>
            <div class="lf-moments" id="sp-moments"></div>
            <div id="sp-times-note"></div>
          </div>
          <div class="sp-shelf sp-planbox" id="sp-plan" role="tabpanel" aria-labelledby="sp-tab-plan" tabindex="0" hidden>
            <h3 id="sp-plan-h" class="sp-sr">Your full plan</h3>
            <p class="sp-sublede">Where to start, who to write to, what is next door. Worked out here, on this device, from the Atlas&rsquo;s own records.</p>
            <div id="sp-plan-notes"></div>
            <div id="sp-plan-today"></div>
            <div id="sp-plan-home" class="sp-plancards"></div>
            <div id="sp-plan-open" class="sp-plancards"></div>
            <div id="sp-plan-questions"></div>
            <div id="sp-plan-people"></div>
            <div id="sp-plan-write" class="sp-plancards"></div>
            <div id="sp-plan-village" class="sp-plancards"></div>
            <div id="sp-plan-moves" class="sp-plancards"></div>
            <div id="sp-plan-fine"></div>
            <details class="sp-method">
              <summary>The method, step by step</summary>
              <h4 class="sp-steps-h">What to do first</h4>
              <div class="sp-plan" id="sp-steps"></div>
            </details>
            <div class="sp-aiblock">
              <div class="sp-plan-h">
                <div><h4 class="sp-steps-h">A plan written by Claude</h4></div>
                <button type="button" class="sp-btn sp-btn-ai" id="sp-ai-btn"><svg class="sp-spark" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M10 3l1.9 5.1L17 10l-5.1 1.9L10 17l-1.9-5.1L3 10l5.1-1.9z" fill="currentColor"/><path d="M18 14l.9 2.1L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-.9z" fill="currentColor"/><path d="M18.5 3l.6 1.4L20.5 5l-1.4.6-.6 1.4-.6-1.4L16.5 5l1.4-.6z" fill="currentColor"/></svg> Build my research plan</button>
              </div>
              <p class="sp-ai-note" id="sp-ai-note">Nothing is sent until you press the button. Then only what the story says (places, relationships, years and the Atlas records matched to them) goes to Claude Haiku. Not the picture, not the full text, and no name.</p>
              <p class="sp-status" id="sp-ai-status" role="status" aria-live="polite"></p>
              <div id="sp-ai-out" hidden></div>
            </div>
          </div>
        </section>

        <section class="sp-sec" id="sp-keep" aria-labelledby="sp-keep-h" hidden>
          <h2 id="sp-keep-h">Keep it</h2>
          <div class="sp-fa">
            <label class="sp-fa-l"><span class="sp-sr">Which family research</span><select id="sp-fa-line"></select></label>
            <input type="text" id="sp-fa-name" maxlength="60" aria-label="Name for the new family research" placeholder="A surname" />
            <button type="button" class="sp-btn" id="sp-fa-btn">Add this family to your research</button>
            <button type="button" class="sp-btn sp-btn-ghost" id="sp-save-btn">Save the story only</button>
          </div>
          <p class="sp-fine">Adding a family starts a research list with the registers above marked as planned, and makes it your active family. Saving keeps just the words (and the names of any photos) in <a href={u("/my-research/#story")}>My research</a>, under Stories, where you can come back to add more. Either stays in this browser.</p>
          <p class="sp-fine sp-out" id="sp-fa-out" role="status"></p>
          <p class="sp-fine sp-out" id="sp-save-out" role="status"></p>
          <p class="sp-fine">Already have a tree? <a href={u("/tree-canvas/")}>Open it in the Tree Canvas</a> to see everyone on the map.</p>
        </section>

        <p class="sp-fine sp-priv">Nothing leaves your browser until you press &ldquo;Build my research plan&rdquo; or &ldquo;Read the writing on it with Claude&rdquo;. Please do not enter details of anyone who may be alive.</p>
      </div>
    </div>
  </section>

  <section id="tool-read" class="rd-panel" role="tabpanel" aria-labelledby="tab-read" hidden>
    <div class="rr-find" id="rr-find">
      <p class="rr-say">Type a word, a date or a whole line from a register. It stays in your browser.</p>
      <div class="k-search"><span class="k-ico" aria-hidden="true">🔎</span>
        <input type="search" id="rr-q" autocomplete="off" spellcheck="false" aria-label="A word, a date or a line from the register" placeholder="uxoris · die 30 7bris 1671 · natus est Joannes filius" /></div>
      <p class="rr-chips">Try {chips.concat(dateChips.slice(0, 2)).map((c, i) => <button type="button" class="k-pill rr-chip" data-q={c}>{c}</button>)}</p>
      <details class="rr-narrow"><summary>Narrow the words by kind of record or language</summary>
      <p class="rr-filters" role="group" aria-label="Kind of record">
        {Object.entries(eventNames).map(([k, v]) => <label><input type="checkbox" class="rr-ev" value={k} /> {v}</label>)}
        <label>Language <select id="rr-lang"><option value="">All</option>{Object.entries(langNames).filter(([l]) => langCount[l]).map(([l, n]) => <option value={l}>{n} ({langCount[l]})</option>)}</select></label>
      </p>
      <div id="rr-out" role="status" aria-live="polite"></div>
      </details>
      <div id="rr-dout" role="status" aria-live="polite"></div>
      <div id="rr-out" role="status" aria-live="polite"></div>
      <div id="rr-claude" class="rr-claude" hidden>
        <p><b>This looks like a whole entry.</b> The words above are what the Atlas can look up. Claude can read the line as a whole and draft what it says, which you then check against the page.</p>
        <p><button type="button" class="chip is-primary" id="rr-claude-go">Read it with Claude</button> <span class="cap">Only when you press it; nothing is sent before.</span></p>
      </div>
      <details class="rr-alldet">
      <summary><b>Browse all {terms.length} terms, A to Z</b> <span class="rr-m">the whole list the word finder searches, not only what matched</span></summary>
      <ul class="rr-all">
        {terms.map((t) => (
          <li><b>{t.forms[0]}</b> <span class="rr-m">{langNames[t.lang] || t.lang} · {t.means}</span></li>
        ))}
      </ul>
    </details>
    </div>
    <div class="one ask-card" id="ask" hidden>
      <div class="ask-head">
        <span class="ask-spark" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="currentColor"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" fill="currentColor"/></svg></span>
        <div>
          <h2 class="ask-title">Show Claude a line from a register</h2>
          <p class="ask-lead">Paste an entry, or drop up to four pictures of the page. You get a draft reading to check against the page, and what the Atlas knows about that place and year.</p>
        </div>
      </div>
      <div class="ask-drop" id="ask-drop">
        <textarea id="ask-text" rows="4" maxlength="4000" spellcheck="false" aria-label="A line from a register" placeholder="Paste or type one entry, as written"></textarea>
        <p class="ask-hint"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> or drop pictures here, up to four. You can paste them too.</p>
      </div>
      <ul class="ask-tray" id="ask-tray" aria-label="Pictures ready to read" hidden></ul>
      <div class="ask-bar">
        <input type="text" id="ask-where" maxlength="120" spellcheck="false" aria-label="Where the entry is from, if you know" placeholder="From where? A place and a year help (optional)" />
        <button type="button" id="ask-go" class="chip ask-btn ask-cta">Read this line</button>
      </div>
      <p class="ask-more">
