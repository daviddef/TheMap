      function runAll() { run(); runDate(); nudge(); }
      q.addEventListener("input", runAll);
      document.querySelectorAll(".rr-ev").forEach(function (b) { b.addEventListener("change", run); });
      document.getElementById("rr-lang").addEventListener("change", run);
      document.querySelectorAll(".rr-chip").forEach(function (b) { b.addEventListener("click", function () { q.value = b.dataset.q; runAll(); }); });
      var cg = document.getElementById("rr-claude-go");
      if (cg) cg.addEventListener("click", function () {
        var box = document.getElementById("ask"), t = document.getElementById("ask-text"); if (!box || !t) return;
        box.hidden = false; t.value = q.value.trim(); t.dispatchEvent(new Event("input", { bubbles: true })); box.scrollIntoView({ behavior: "smooth", block: "start" }); try { t.focus({ preventScroll: true }); } catch (e) { t.focus(); }
      });
      var m = location.search.match(/[?&]q=([^&]*)/); if (m) { q.value = decodeURIComponent(m[1].replace(/\+/g, " ")); runAll(); }
    })();
  </script>
