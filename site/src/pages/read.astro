  .sp .lf-moments ul { padding-left: 18px; max-width: var(--measure); } .sp .lf-moments .cap { color: var(--ink-2); font-size: 13px; }
  .sp .lf-capline { position: relative; }
  .sp li:has(> .lf-flag) { display: flow-root; }
