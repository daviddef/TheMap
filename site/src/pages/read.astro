  <script is:inline>
    (function () {
      var R = window.raReadRecord; if (!R) return;
      var D = JSON.parse(document.getElementById("rr-data").textContent), idx = R.index(D.terms);
      var q = document.getElementById("rr-q"), out = document.getElementById("rr-out");
      var dout = document.getElementById("rr-dout"), claudeBox = document.getElementById("rr-claude");
      var EV = { baptism: "baptism", marriage: "marriage", burial: "burial", all: "any record" };
      function el(tag, text, cls) { var e = document.createElement(tag); if (text != null) e.textContent = text; if (cls) e.className = cls; return e; }
      function events() { return [].slice.call(document.querySelectorAll(".rr-ev:checked")).map(function (c) { return c.value; }); }
      var LN = D.langs || {}, SEEN = D.seen || { terms: {}, concepts: {} };
      var KIND = { baptism: "baptisms and births", marriage: "marriages", banns: "marriage banns", death: "deaths and burials", confirmation: "confirmations", index: "indexes", "soul-count": "parish censuses" };
      function num(n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ","); }
      function where(x) {
        var top = x.countries.slice(0, 3).map(function (c) { return c[0] + " " + num(c[1]); }).join(", "), more = x.nCountries - Math.min(3, x.countries.length);
        return top + (more > 0 ? " and " + more + " more countr" + (more === 1 ? "y" : "ies") : "");
      }
      function when(x) { return x.mostly ? "most from " + x.mostly[0] + " to " + x.mostly[1] + (x.earliest && x.earliest < x.mostly[0] - 30 ? ", the earliest " + x.earliest : "") : (x.earliest ? "earliest " + x.earliest : ""); }
      function card(t) {
        var c = el("div", null, "rr-card");
        c.append(el("h3", t.forms[0]), el("p", t.means, "rr-means"));
        var meta = [LN[t.lang] || t.lang, EV[t.events] || t.events, t.role];
        c.append(el("p", meta.join(" · "), "cap"));
        c.append(el("p", "Also written: " + t.forms.slice(1).concat(t.abbr || []).join(", "), "cap"));
        if (t.note) c.append(el("p", t.note, "rr-note"));
        var st = SEEN.terms[t.id], sc = t.concept && SEEN.concepts[t.concept];
        if (st || sc) {
          var box = el("div", null, "rr-seen");
          box.append(el("b", "In the Atlas"));
          if (st) box.append(el("p", "The word is in the title of " + num(st.n) + " register entries the Atlas lists: " + where(st) + (when(st) ? "; " + when(st) : "") + ".", "cap"));
          if (sc && !st) box.append(el("p", "Registers of this kind (" + (KIND[t.concept] || t.concept) + ") are titled in " + sc.languages.length + " languages across " + sc.nCountries + " countries, " + num(sc.n) + " entries in all; " + where(sc) + (when(sc) ? "; " + when(sc) : "") + ". The titles do not say what language the entries inside are written in.", "cap"));
          if (t.concept) {
            var peers = D.terms.filter(function (o) { return o.concept === t.concept && o.id !== t.id && o.lang !== t.lang; });
            if (peers.length) {
              var p = el("p", "The same kind of book, in other languages: ", "cap");
              peers.slice(0, 14).forEach(function (o, i) {
                var b = el("button", o.forms[0], "rr-peer"); b.type = "button"; b.title = (LN[o.lang] || o.lang) + ": " + o.means;
                b.addEventListener("click", function () { q.value = o.forms[0]; run(); q.focus(); });
                if (i) p.append(" "); p.append(b); p.append(el("span", " " + (LN[o.lang] || o.lang), "rr-m"));
              });
              box.append(p);
            }
          }
          c.append(box);
        }
        var s = el("p", "Source: ", "cap");
        t.src.forEach(function (k, i) { s.append((i ? "; " : "") + (D.sources[k] || k)); });
        c.append(s);
        return c;
      }
      function run() {
        out.textContent = "";
        var v = q.value.trim(); if (!v) return;
        var r = R.find(idx, v, { events: events() }), lg = document.getElementById("rr-lang").value;
        if (lg) { var partial = r.partial; r = r.filter(function (x) { return x.term.lang === lg; }); r.partial = partial; }
        if (!r.length) { if (!dout.childNodes.length && !R.decodeDate(v).text) out.append(el("p", "No term here matches that. That is not a finding about the word: the list is short so far. Try fewer letters, or the English.", "cap")); return; }
        if (r.partial) out.append(el("p", "No single card holds that whole phrase, so these are the cards for its words, one word at a time.", "cap"));
        r.slice(0, 12).forEach(function (x) { out.append(card(x.term)); });
        if (r.length > 12) out.append(el("p", "…and " + (r.length - 12) + " more. Type more of the word.", "cap"));
      }
      /* ONE BOX FOR A WORD, A DATE OR A WHOLE LINE. The date reader answers when the words hold a date (a month or a day read, or the whole thing is date-sized); the word finder answers for
         the words; a line of five words or more also offers Claude, which reads it as a whole when asked and never before. */
      function runDate() {
        dout.textContent = "";
        var v = q.value.trim(); if (!v) return;
