  .sp .lf-forms-cols li { margin: 0; padding: 6px 10px; background: var(--ground); border-radius: 8px; overflow-wrap: anywhere; }
  .sp .lf-forms-cols li:last-child { grid-column: 1 / -1; }
  /* where the family names are most common: a ranked list per name, the rank in its own narrow column */
  .sp .lf-census { grid-column: 1 / -1; margin-top: 8px; padding: 4px 14px 12px; border: 1px solid var(--rule); border-radius: 12px; background: var(--panel); min-width: 0; }
  .sp .lf-cn h5 { margin: 14px 0 6px; font: 700 15px/1.3 var(--sans); color: var(--ink); }
