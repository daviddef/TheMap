  .sp .lf-leader { font-style: italic; }
  .sp .lf-now { margin-top: 5px; padding: 4px 8px; border-radius: 6px; background: var(--accent-wash); font-size: 14px; line-height: 1.35; }
  .sp .lf-now-epidemic, .sp .lf-ev-epidemic .lf-tag { --tagc: #8a3b6e; } .sp .lf-now-famine, .sp .lf-ev-famine .lf-tag { --tagc: #a8741a; }
  .sp .lf-now-war, .sp .lf-ev-war .lf-tag { --tagc: #b3452e; } .sp .lf-now-genocide, .sp .lf-ev-genocide .lf-tag, .sp .lf-ev-massacre .lf-tag, .sp .lf-ev-atrocity .lf-tag { --tagc: #7a1f1f; } .sp .lf-ev-displacement .lf-tag { --tagc: #1f5c6b; }
  .sp .lf-now { border-left: 3px solid var(--tagc, var(--accent)); }
