  <script is:inline>
    (function () {
      var tabs = [].slice.call(document.querySelectorAll(".rd-tab")), now = "story", HEAD0 = null;
      /* The story is the page; the three tools open over it and a second press (or the story link) goes back to it. */
      function pick(name, focus) {
        if (name === now && name !== "story") name = "story";
        now = name;
        tabs.forEach(function (t) {
          var on = t.dataset.tool === name;
          document.getElementById("tool-" + t.dataset.tool).hidden = !on;
          /* THE ONE BUTTON LEADS TO THE OTHER PLACE. With the story open it says «Interpret a record»; with the reader open it says «Tell a story» and goes back. David: «both show an
             "interpret a record" button? surely #read should say "tell a story"?» It is not shown as selected either way: it is where you go next, not where you are. */
          t.classList.remove("is-on"); t.setAttribute("aria-selected", "false"); t.tabIndex = 0;
          var lbl = t.querySelector(".rd-lbl"), ir = t.querySelector(".rd-ico-read"), is = t.querySelector(".rd-ico-story");
          if (lbl) lbl.textContent = on ? "Tell a story" : "Interpret a record";
          if (ir) ir.hidden = on; if (is) is.hidden = !on;
          t.title = on ? "Back to your story: tell us what you know and the page fills in as you write." : t.getAttribute("data-title-read");
          if (on && focus) t.focus();
        });
        document.getElementById("tool-story").hidden = name !== "story";
        /* THE PAGE'S OWN HEADER FOLLOWS THE VIEW. It said «Reading the record» above a box that says «Tell us what you know»: two titles for one screen. */
        var ph = document.querySelector(".pagehead");
        if (ph) {
          var h1 = ph.querySelector("h1"), dk = ph.querySelector(".dek"), lb = ph.querySelector(":scope > .lab");
          if (!HEAD0) HEAD0 = { h1: h1 && h1.textContent, dek: dk && dk.textContent, lab: lb && lb.textContent };
          if (h1) h1.textContent = name === "story" ? "Tell a story" : HEAD0.h1;
          if (dk) { dk.textContent = name === "story" ? "" : HEAD0.dek; }
          if (lb) lb.textContent = name === "story" ? "Your story · nothing leaves your browser until you ask" : HEAD0.lab;
        }
        if (!/^#story=/.test(location.hash) && !/^#[a-z]+=/.test(location.hash)) { try { history.replaceState(null, "", "#" + name); } catch (e) {} }   /* words or an old link in the address are read by the story page first, which then tidies it */
      }
      window.raReadPick = pick;
      [].forEach.call(document.querySelectorAll("[data-tool-link]"), function (a) { a.addEventListener("click", function (e) { e.preventDefault(); now = ""; pick(a.getAttribute("data-tool-link")); }); });
      tabs.forEach(function (t, i) {
        t.addEventListener("click", function () { pick(t.dataset.tool); });
        t.addEventListener("keydown", function (e) {
          var n = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (n) { e.preventDefault(); tabs[(i + n + tabs.length) % tabs.length].focus(); }
        });
      });
      /* a Tools-menu link used while the page is already open only changes the part after the #: open that tool (never toggle it off) */
      window.addEventListener("hashchange", function () {
        var n = (location.hash || "").slice(1);
        if (n === "ask" || n === "date" || n === "word") n = "read";          /* the three old tools are one now: old links and bookmarks open it */
        if ((n === "story" || n === "read") && n !== now) { now = ""; pick(n); }
      });
      var h = (location.hash || "").slice(1);
      pick(/[?&]q=/.test(location.search) || h === "date" || h === "word" || h === "ask" || h === "read" ? "read" : "story");
    })();
  </script>
