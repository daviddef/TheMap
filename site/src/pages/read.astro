  .sp .lf-capbox { display: grid; gap: 8px; max-width: var(--measure); margin: 6px 0 10px; }
  .sp .lf-capline { font: 400 16px/1.45 var(--sans); padding: 10px 14px; border-left: 4px solid var(--accent); background: var(--ground); border-radius: 0 8px 8px 0; }
  .sp .lf-filed { color: var(--ink-2); font-size: 14px; margin-top: 3px; } .sp .lf-regime { color: var(--ink-2); }
  .sp .lf-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 28px; align-items: start; } .sp .lf-duo-one { grid-template-columns: minmax(0, 1fr); } .sp .lf-duo .lf-col { min-width: 0; }
  @media (max-width: 760px) { .sp .lf-duo { grid-template-columns: minmax(0, 1fr); } }
  .sp .lf-duo ul { max-width: none; }
  /* the names cards: side by side, two to a row where there is room */
