  .sp .lf-cn-more, .sp .lf-cn-around { margin: 8px 0; font-size: 14px; } .sp .lf-cn-more summary, .sp .lf-cn-around summary { cursor: pointer; font-weight: 600; }
  .sp .lf-cn-src { margin: 8px 0 0; font-size: 12.5px; color: var(--ink-2); }
  .sp .lf-names .cap { color: var(--ink-2); font-size: 12.5px; }
  /* the "Try:" examples are buttons: without a ground of their own the browser paints them light grey, and pale text on that is unreadable in dark mode */
