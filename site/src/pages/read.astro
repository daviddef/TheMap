---
/* READING THE RECORD: a term finder and a date decoder for old church registers.
 *
 * The terms are data/record-terms.json (every one sourced, in our own words, nothing about a person); the finder and decoder are
 * public/js/record-reader.js, which only reads what is typed. Plan: docs/reading-the-record-plan.md. This is its first piece:
 * the annotated page, the line reader and the trap list come later.
 */
import Base from "../layouts/Base.astro";
import { recordTerms } from "../lib/record-terms.js";
import { u } from "../lib/url.js";
import ProgressKit from "../components/ProgressKit.astro";
const { sources, terms } = recordTerms();
const chips = ["uxoris", "7bris", "susceptores", "obiit", "infans", "natum"];
const dateChips = ["die 30 7bris 1671", "undecima februarii anno millesimo septingentesimo quadragesimo sexto", "xvi martii 1801"];
const eventNames = { baptism: "Baptism", marriage: "Marriage", burial: "Burial" };
---
<Base
  title="Reading the record"
  eyebrow={`${terms.length} terms · every one sourced · the finder and date decoder keep everything in your browser`}
  dek="Type a word as you see it in the register, or a whole date, and see what it is, what it does not tell you, and where it comes from."
  description="A searchable guide to the Latin of old church registers: look up a word, an abbreviation or an ending, and decode a date such as 'die 30 7bris 1671'.">

  <div class="rd-pick" role="tablist" aria-label="What would you like to do?">
    <button type="button" role="tab" id="tab-ask" class="rd-tab is-on" aria-selected="true" aria-controls="tool-ask" data-tool="ask">
      <span class="rd-n">1</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><b>Start with your story</b><span class="rd-d">Say who you are looking for, or drop a photo. See their journey and what to do first.</span></button>
    <button type="button" role="tab" id="tab-date" class="rd-tab" aria-selected="false" aria-controls="tool-date" data-tool="date">
      <span class="rd-n">2</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 10h16M9 3v4M15 3v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>Decode a date</b><span class="rd-d">7bris 1671, xvi martii 1801: what day it was, with the working.</span></button>
    <button type="button" role="tab" id="tab-word" class="rd-tab" aria-selected="false" aria-controls="tool-word" data-tool="word">
      <span class="rd-n">3</span><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><circle cx="10.5" cy="10.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15 15l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>Find a word</b><span class="rd-d">uxoris, obiit, susceptores: what it means and what it does not say.</span></button>
  </div>

  <section id="tool-ask" class="rd-panel" role="tabpanel" aria-labelledby="tab-ask">
    <div class="sg" id="sg" aria-label="Start with your story">
      <div class="sg-dots" id="sg-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="sg-stage" id="sg-stage">

        <section class="sg-step" data-step="0" aria-labelledby="sg-h0">
          <h2 class="sg-h" id="sg-h0">What do you have?</h2>
          <p class="sg-sub">Pick the closest. You can add more in a moment, or skip this and just tell us.</p>
          <div class="sg-tiles">
            <button type="button" class="sg-tile" data-holds="photo"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="10" r="1.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 17l5-4 3 3 3-2 5 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><b>A photo</b><span>of a person, a family or a place</span></button>
            <button type="button" class="sg-tile" data-holds="document"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M7 3.5h7l4 4V20H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3.5V8h4M9.5 12h6M9.5 15.5h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><b>A document</b><span>a certificate, passport, record or page</span></button>
            <button type="button" class="sg-tile" data-holds="letter"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 8l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><b>A letter</b><span>or a postcard, or a diary</span></button>
            <button type="button" class="sg-tile" data-holds="story"><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M5 5.5h14v10H11l-4 3.5v-3.5H5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><b>Just the story</b><span>what the family says happened</span></button>
          </div>
        </section>

        <section class="sg-step" data-step="1" aria-labelledby="sg-h1" hidden>
          <h2 class="sg-h" id="sg-h1">Tell us what you know</h2>
          <p class="sg-sub" id="sg-sub1">Type it, paste it, or say it your own way. Names, places and years are all we need.</p>
          <div class="sg-drop" id="sg-drop">
            <textarea id="sg-text" rows="4" maxlength="2000" spellcheck="false" aria-label="What you know" placeholder="My great-grandfather Ivan Kosina came from Gallignana to Hamilton around 1905. All I have is this photo."></textarea>
            <ul class="sg-shots" id="sg-shots" hidden aria-label="Pictures you added"></ul>
            <p class="sg-row">
              <label class="sg-add"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> Add a photo or document<input type="file" id="sg-file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
              <button type="button" class="sg-ghost" id="sg-eg">Try an example</button>
              <button type="button" class="sg-ghost" id="sg-read" hidden>Read the writing on it with Claude</button>
            </p>
            <p class="sg-fine">Drag a picture onto this box, or paste one. It stays in this tab until you choose to have it read.</p>
          </div>
          <div class="sg-chips" id="sg-chips" aria-live="polite"></div>
          <p class="sg-status" id="sg-status" role="status" aria-live="polite"></p>
          <p class="sg-nav"><button type="button" class="sg-back" data-go="0">Back</button> <button type="button" class="sg-next" id="sg-next1">Show me their journey</button></p>
        </section>

        <section class="sg-step" data-step="2" aria-labelledby="sg-h2" hidden>
          <h2 class="sg-h" id="sg-h2">Their journey</h2>
          <div class="sg-map" id="sg-map" role="img" aria-label="Map of the journey from the place they started to the place they arrived"></div>
          <div class="sg-time" id="sg-time" hidden>
            <button type="button" class="sg-play" id="sg-play">▶ Play</button>
            <input type="range" id="sg-year" min="1800" max="1900" step="1" value="1800" aria-label="Year" />
            <output id="sg-yearout" class="sg-yearout" for="sg-year"></output>
          </div>
          <div class="sg-cap lf-capbox" id="sg-cap"></div>
          <details class="sg-more" open><summary>What was going on, and who led</summary><div class="lf-moments" id="sg-moments"></div></details>
          <details class="sg-more" id="sg-names-box"><summary>How their names were written</summary><div id="sg-names"></div></details>
          <p class="sg-fine">The dashed line joins the places in date order. It is not the route they took: the Atlas does not know that, and neither does anyone without a ship's list.</p>
          <p class="sg-nav"><button type="button" class="sg-back" data-go="1">Back</button> <button type="button" class="sg-next" data-go="3">What should I do first?</button></p>
        </section>

        <section class="sg-step" data-step="3" aria-labelledby="sg-h3" hidden>
          <h2 class="sg-h" id="sg-h3">Your first steps</h2>
          <p class="sg-sub">Each step names registers and sources the Atlas holds. A step that says the Atlas lists none is a gap in the Atlas, not in the record.</p>
          <div class="sg-plan" id="sg-plan"></div>
          <div class="sg-family" id="sg-family">
            <p class="sg-fam-h">Ready to begin?</p>
            <p class="sg-sub">A research family adds everything above as planned, so you can mark it off as you look. It stays in this browser.</p>
            <p><button type="button" class="sg-next" id="sg-fam-btn">Start the research family</button></p>
            <p class="sg-fam-out" id="sg-fam-out" role="status"></p>
            <p class="sg-fine">Already have a tree? <a href={u("/roots/")}>Open it in Roots &amp; Routes</a> to see everyone on the map.</p>
          </div>
          <p class="sg-nav"><button type="button" class="sg-back" data-go="2">Back</button> <button type="button" class="sg-ghost" id="sg-again">Start again</button></p>
        </section>
      </div>
      <p class="sg-fine sg-priv">Nothing you type or drop is sent anywhere. Please do not enter details of anyone who may be alive.</p>
    </div>

    <details class="sg-readbox" id="sg-readbox">
      <summary>Read the writing on a photo or a register page with Claude</summary>
    <div class="one ask-card" id="ask" hidden>
      <div class="ask-head">
        <span class="ask-spark" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z" fill="currentColor"/><path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" fill="currentColor"/></svg></span>
        <div>
          <h2 class="ask-title">Show Claude a line from a register</h2>
          <p class="ask-lead">Paste an entry, or drop up to four pictures of the page. You get a draft reading to check against the page, and what the Atlas knows about that place and year.</p>
        </div>
      </div>
      <div class="ask-drop" id="ask-drop">
        <textarea id="ask-text" rows="4" maxlength="4000" spellcheck="false" aria-label="A line from a register" placeholder="Paste or type one entry, as written"></textarea>
        <p class="ask-hint"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 16V5m0 0l-4 4m4-4l4 4M5 19h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> or drop pictures here, up to four. You can paste them too.</p>
      </div>
      <ul class="ask-tray" id="ask-tray" aria-label="Pictures ready to read" hidden></ul>
      <div class="ask-bar">
        <input type="text" id="ask-where" maxlength="120" spellcheck="false" aria-label="Where the entry is from, if you know" placeholder="From where? A place and a year help (optional)" />
        <button type="button" id="ask-go" class="chip ask-btn ask-cta">Read this line</button>
      </div>
      <p class="ask-more">
        <label class="ask-file ask-link">Add pictures<input type="file" id="ask-photo" accept="image/jpeg,image/png,image/webp" multiple hidden /></label>
        <span aria-hidden="true">·</span>
        <button type="button" id="ask-atlas" class="ask-link">What the Atlas holds on this</button>
      </p>
      <div class="ask-ready" id="ask-ready" hidden>
        <p class="ask-ready-n" id="ask-ready-n"></p>
        <p class="ask-row">
          <button type="button" id="ask-read-docs" class="chip ask-btn is-primary">Read as documents</button>
          <button type="button" id="ask-read-lines" class="chip ask-btn">Read as register lines</button>
          <button type="button" id="ask-clear" class="ask-link">Remove all</button>
        </p>
        <p class="cap" id="ask-ready-cost"></p>
      </div>
      <div id="ask-ts"></div>
      <p class="cap ask-status" id="ask-status" role="status" aria-live="polite"></p>
      <div id="ask-out" aria-live="polite"></div>
      <div id="ask-hand" hidden></div>
      <div id="ask-sum" aria-live="polite" hidden></div>
      <details class="ask-priv ask-fine"><summary><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 11V8a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg> Nothing is sent until you press a button. What is sent, and what is kept</summary>
        <p>What you paste or photograph is sent over the internet to our small service and on to Claude, an AI made by
        Anthropic, which writes the draft. We keep no text, no picture and no answer, only a count of how many tries each visitor has used. Anthropic's
        <a href="https://privacy.claude.com/en/articles/7996866-how-long-do-you-store-my-organization-s-data" rel="noopener">published policy</a> says it deletes
        what is sent within 30 days, keeps content its safety systems flag for longer, and does not train on it without permission. Please do not paste or photograph details of
        people who may be alive. Cloudflare's bot check loads when you first click in the box. <a href={u("/privacy/")}>More in the privacy note.</a></p></details>
    </div>
    </details>
  </section>

  <section id="tool-date" class="rd-panel" role="tabpanel" aria-labelledby="tab-date" hidden>
    <div class="one" id="rr-date">
      <div class="lab">Decode a date</div>
      <p class="cap" style="margin-top:6px">Digits, Roman numerals or Latin words. The old signs 7bris, 8bris, 9bris and 10bris (Xbris) are
      September to December. The answer shows its working, and says what it could not read.</p>
      <p><input type="text" id="rr-d" autocomplete="off" spellcheck="false" aria-label="A date as written in the register" placeholder="die 30 7bris 1671" /></p>
      <p class="cap rr-chips">Try: {dateChips.map((c) => <button type="button" class="chip rr-dchip" data-q={c}>{c}</button>)}</p>
      <div id="rr-dout" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section id="tool-word" class="rd-panel" role="tabpanel" aria-labelledby="tab-word" hidden>
    <div class="one" id="rr-find">
      <div class="lab">Find a word</div>
      <p class="cap" style="margin-top:6px">Spell it as written. Capitals, accents, i for j and u for v do not matter, and another ending finds the same word
      (uxoris, uxorem). English works too.</p>
      <p><input type="search" id="rr-q" autocomplete="off" spellcheck="false" aria-label="A word from the register" placeholder="uxoris" /></p>
      <p class="rr-filters" role="group" aria-label="Kind of record">
        {Object.entries(eventNames).map(([k, v]) => <label><input type="checkbox" class="rr-ev" value={k} /> {v}</label>)}
      </p>
      <p class="cap rr-chips">Try: {chips.map((c) => <button type="button" class="chip rr-chip" data-q={c}>{c}</button>)}</p>
      <div id="rr-out" role="status" aria-live="polite"></div>
      <details class="rr-alldet">
      <summary><b>Browse all {terms.length} terms, A to Z</b> <span class="rr-m">the whole list the word finder searches, not only what matched</span></summary>
      <ul class="rr-all">
        {terms.map((t) => (
          <li><b>{t.forms[0]}</b> <span class="rr-m">{t.means}</span></li>
        ))}
      </ul>
    </details>
    </div>
  </section>

  <section>
    <h2 class="yn-h">Where this comes from</h2>
    <p class="cap">Each meaning is written in our own words from the pages below, and each card says which. Word meanings are facts; the guides
    themselves are not copied. Where the card gives a warning, it is a point the source makes, not a rule that always holds: registers vary by
    parish and century, so look at the page in front of you.</p>
    <ul class="cap">
      {Object.entries(sources).sort((a, b) => a[1].title.localeCompare(b[1].title, "en")).map(([k, s]) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}
    </ul>
    <p class="cap">Next on the plan: an annotated register page you can point at, a tool that reads a whole line, and a list of the misreadings that cost
    researchers time. <a href={u("/worklist/")}>The worklist</a> has it.</p>
  </section>

  <ProgressKit />
  <script type="application/json" id="rr-data" set:html={JSON.stringify({ terms, sources: Object.fromEntries(Object.entries(sources).map(([k, s]) => [k, s.title])) })}></script>
  <script is:inline>
    (function () {
      var tabs = [].slice.call(document.querySelectorAll(".rd-tab"));
      function pick(name, focus) {
        tabs.forEach(function (t) {
          var on = t.dataset.tool === name;
          t.classList.toggle("is-on", on); t.setAttribute("aria-selected", on ? "true" : "false"); t.tabIndex = on ? 0 : -1;
          document.getElementById("tool-" + t.dataset.tool).hidden = !on;
          if (on && focus) t.focus();
        });
        try { history.replaceState(null, "", "#" + name); } catch (e) {}
      }
      tabs.forEach(function (t, i) {
        t.addEventListener("click", function () { pick(t.dataset.tool); });
        t.addEventListener("keydown", function (e) {
          var n = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (n) { e.preventDefault(); pick(tabs[(i + n + tabs.length) % tabs.length].dataset.tool, true); }
        });
      });
      var h = (location.hash || "").slice(1);
      pick(/[?&]q=/.test(location.search) ? "word" : (h === "date" || h === "word" ? h : "ask"));
    })();
  </script>
  <script is:inline src={u("/js/record-reader.js")}></script>
  <script is:inline src={u("/js/ask-claude.js")} defer></script>
  <script is:inline src={u("/js/atlas-summary.js")} defer></script>
  <script is:inline src={u("/js/shard-key.js")} defer></script>
  <script is:inline src={u("/js/story-engine.js")} defer></script>
  <script is:inline src={u("/js/story-guide.js")} defer></script>
  <script is:inline src={u("/js/case-atlas.js")} defer></script>
  <script is:inline src={u("/js/handover.js")} defer></script>
  <script is:inline>
    (function () {
      var R = window.raReadRecord; if (!R) return;
      var D = JSON.parse(document.getElementById("rr-data").textContent), idx = R.index(D.terms);
      var q = document.getElementById("rr-q"), out = document.getElementById("rr-out");
      var d = document.getElementById("rr-d"), dout = document.getElementById("rr-dout");
      var EV = { baptism: "baptism", marriage: "marriage", burial: "burial", all: "any record" };
      function el(tag, text, cls) { var e = document.createElement(tag); if (text != null) e.textContent = text; if (cls) e.className = cls; return e; }
      function events() { return [].slice.call(document.querySelectorAll(".rr-ev:checked")).map(function (c) { return c.value; }); }
      function card(t) {
        var c = el("div", null, "rr-card");
        c.append(el("h3", t.forms[0]), el("p", t.means, "rr-means"));
        var meta = [EV[t.events] || t.events, t.role];
        c.append(el("p", meta.join(" · "), "cap"));
        c.append(el("p", "Also written: " + t.forms.slice(1).concat(t.abbr || []).join(", "), "cap"));
        if (t.note) c.append(el("p", t.note, "rr-note"));
        var s = el("p", "Source: ", "cap");
        t.src.forEach(function (k, i) { s.append((i ? "; " : "") + (D.sources[k] || k)); });
        c.append(s);
        return c;
      }
      function run() {
        out.textContent = "";
        var v = q.value.trim(); if (!v) return;
        var r = R.find(idx, v, { events: events() });
        if (!r.length) { out.append(el("p", "No term here matches that. That is not a finding about the word: the list is short so far. Try fewer letters, or the English.", "cap")); return; }
        if (r.partial) out.append(el("p", "No single card holds that whole phrase, so these are the cards for its words, one word at a time.", "cap"));
        r.slice(0, 12).forEach(function (x) { out.append(card(x.term)); });
        if (r.length > 12) out.append(el("p", "…and " + (r.length - 12) + " more. Type more of the word.", "cap"));
      }
      function runDate() {
        dout.textContent = "";
        var v = d.value.trim(); if (!v) return;
        var r = R.decodeDate(v), c = el("div", null, "rr-card");
        c.append(el("h3", r.text || "Nothing read"));
        if (r.working.length) { var ul = el("ul", null, "cap"); r.working.forEach(function (w) { ul.append(el("li", w)); }); c.append(ul); }
        r.warnings.forEach(function (w) { c.append(el("p", w, "rr-note")); });
        dout.append(c);
      }
      q.addEventListener("input", run);
      d.addEventListener("input", runDate);
      document.querySelectorAll(".rr-ev").forEach(function (b) { b.addEventListener("change", run); });
      document.querySelectorAll(".rr-chip").forEach(function (b) { b.addEventListener("click", function () { q.value = b.dataset.q; run(); }); });
      document.querySelectorAll(".rr-dchip").forEach(function (b) { b.addEventListener("click", function () { d.value = b.dataset.q; runDate(); }); });
      var m = location.search.match(/[?&]q=([^&]*)/); if (m) { q.value = decodeURIComponent(m[1].replace(/\+/g, " ")); run(); }
    })();
  </script>
</Base>

<style is:global>
  .sg { background: var(--panel); border: 1px solid var(--rule); border-radius: 18px; padding: 18px clamp(14px, 3vw, 28px) 12px; overflow: hidden; }
  .sg-dots { display: flex; gap: 6px; margin: 0 0 14px; }
  .sg-dots i { flex: 1; height: 4px; border-radius: 2px; background: var(--rule-strong); transition: background .4s; }
  .sg-dots i.on { background: var(--accent); }
  .sg-stage { transition: opacity .28s ease, transform .28s ease; }
  .sg-stage.out { opacity: 0; transform: translateX(-16px); }
  .sg-step[hidden] { display: none; }
  .sg-step { animation: sg-in .4s ease both; }
  @keyframes sg-in { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: none; } }
  .sg-h { font: 500 clamp(24px, 3vw, 32px)/1.2 var(--serif); margin: 4px 0 6px; }
  .sg-sub { color: var(--ink-2); font-size: 16px; line-height: 1.5; margin: 0 0 16px; max-width: var(--measure); }
  .sg-fine { font-size: 13px; line-height: 1.5; color: var(--ink-2); margin: 6px 0; max-width: var(--measure); } .sg-fine a { color: var(--accent); }
  .sg-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .sg-tile { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; padding: 22px 14px; border: 1px solid var(--rule); border-radius: 16px; background: var(--ground);
    color: var(--ink-2); font: 400 14px/1.35 var(--sans); cursor: pointer; transition: transform .2s, border-color .2s, background .2s, box-shadow .2s; }
  .sg-tile svg { color: var(--accent); transition: transform .3s; }
