---
/* Short stories about names: where they came from and what happened to them on the way. Each paragraph cites the pages it was read on. */
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { stories } from "../../lib/name-stories.js";
const S = stories();
---
<Base title="Stories of names" eyebrow="Names and journeys"
      dek="How names changed on the way, and what the records show. Every claim links the page it was read on.">
  <div class="k-bar"><h2>{S.length} stories</h2><span class="k-count">each one sourced</span></div>
  <ul class="k-grid st-list" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr))">
    {S.map((s) => (
      <li>
        <a class="k-card is-link" href={u(`/story/${s.id}/`)} style="height:100%">
          <span class="k-ico" aria-hidden="true">📜</span>
          <h3>{s.title}</h3>
          <p>{s.dek}</p>
        </a>
      </li>
    ))}
  </ul>
  <p class="k-pills" style="margin-top:22px">
    <a class="k-pill is-plain" href={u("/name/")}>All given names, A to Z</a>
    <a class="k-pill is-plain" href={u("/your-name/")}>The name finder</a>
  </p>
</Base>
