---
import { timelineFor } from "../../lib/surname-timeline.js";
import { hasCountryPage } from "../../lib/country-pages.js";
import { surnamePageRows } from "../../lib/surname-pages.js";
/* One page per surname that has something real to say.

   NOT ONE PER SURNAME. There are 480,635 of them and 449,216 are a row in a
   national register and nothing else — a name and a number. A page each for
   those would be 450,000 pages of thin content, which is the definition of a
   doorway page and is rightly punished for it.

   These are the 3,497 that carry BOTH a human-made variant link and a country:
   the ones where this dataset knows something a reader could not get from a
   phone book. */
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import { atlas as idx } from "../../lib/atlas.js";
import { sourcesFor, access as PACCESS } from "../../lib/sources-by-country.js";
import { curveFor } from "../../lib/fr-curve.js";
import { corpus } from "../../lib/surname-corpus.js";
import { surnameMap, placesMap } from "../../lib/surname-map.js";
import { belgiumFor } from "../../lib/belgium-surnames.js";
import { contextFor } from "../../lib/surname-context.js";
import regions from "../../../public/regions.json";

export async function getStaticPaths() {
  const surn = corpus();
  /* WHICH SURNAMES EARN A PAGE is entirely lib/surname-pages.js's
     question now — earnsPage for the rule, surnamePageRows for the
     deduplicated set. Three copies of that rule had drifted apart once
     already (the sitemap listed 3,577 of 17,961 live pages), and the page
     body below needs the identical answer, so there is one. */
  const { rows: pageRows } = surnamePageRows(surn.surnames || []);
  return pageRows.map(({ r, s }) => ({
    params: { name: s },
    props: { r, attestedBy: surn.attestedBy || {} } }));
}

const { r, attestedBy } = Astro.props;
/* Free after the first call: same corpus object, same Set handed back. */
const pageFor = surnamePageRows(corpus().surnames || []).slugs;
const CN = idx.countries || {};
const slugify = (x) => x.toLowerCase().normalize("NFKD")
  .replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

/* WHO TO WRITE TO, which is the only question behind looking up a surname.
   The page named the countries and stopped there, which is a quiz answer. A
   reader who has just learnt their name is attested in Croatia wants the
   Croatian archives, and this atlas holds 195 of them. The worldwide services
   are left out: covering everywhere is not a fact about this name. */


/* FRANCE DATES ITS NAMES and nothing else here does. INSEE counts births by
   surname and decade from 1891, so a name that starts at zero and climbs is an
   immigration signal with a date on it, and one that stops tells you the decade
   to stop searching. Worth saying out loud on the one page about this name. */
const frHit = curveFor(r.n);
const frRow = frHit && frHit.row;
const tl = timelineFor(r.n, r.variants);

const frCurve = frHit && frHit.curve;
const frPeak = frCurve ? frCurve.reduce((a, b) => (b.n > a.n ? b : a), frCurve[0]) : null;
const TIER = {
  curated: ["Also written", "A person linked these — Wikidata's «said to be the same as», or a family archive that worked it out from documents."],
  grammar: ["The same name, inflected", "A rule of the language rather than an opinion. Polish makes Kowalski and Kowalska of one surname."],
  spelling: ["The same name, spelt two ways", "One systematic substitution — s for z, w for v, ch for h — where BOTH spellings are independently attested surnames. Kosina and Kozina are one man in two clerks' handwriting. Stronger than sounding alike, weaker than somebody having checked."],
  sounds:  ["Only sounds alike", "An algorithm's guess. Useful for casting a net, and not evidence."],
};
const by = {};
for (const v of r.variants) (by[v.how] = by[v.how] || []).push(v.n);
/* THREE QUESTIONS, NOT ONE. «Attested» was answering «where is it borne»,
   «where does a record name it» and «where did it come from» all at once, and
   therefore none of them clearly. They take different evidence. */
const KIND_OF = {
  register: "Borne — a state counted them",
  archive: "Found in a record",
  curated: "Found in a record",
  grammar: "A grammatical form of the name",
  spelling: "The same name, spelt two ways",
  sounds: "A phonetic neighbour only",
};
const ccs = r.countries.slice().sort((a, b) => (b.n || 0) - (a.n || 0));
const total = ccs.reduce((a, c) => a + (c.n || 0), 0);
/* The same countries, drawn. Built here rather than fetched, so the
   picture is in the page before any script runs — see lib/surname-map.js
   for why nineteen thousand Leaflets was not the answer. */
const smap = surnameMap(ccs);
/* AND ONE COUNTRY CAN BE DRAWN PROPERLY. Statbel counts every surname in
   each of 565 communes, so where the other ten registers can only put a
   dot on a country, Belgium puts dots on towns. It is the only one, and
   the page has to say so rather than let a reader read a blank France as
   a fact about the name. */
const wd = contextFor(r.n);
/* PLACES THIS NAME IS ALSO THE NAME OF, drawn rather than only listed.
   The gazetteer match has always been here; its coordinates were sitting
   unused in the same file the match came from, so «Llerena is a town in
   Extremadura» was a sentence on a page about a map. Only matches on the
   name or a real spelling of it are drawn — a phonetic neighbour is an
   algorithm's guess and putting it on the ground would dress it up. */
const placePins = (r.places || [])
  .filter((p) => p.y != null && p.x != null && p.via !== "sounds")
  .map((p) => ({ y: p.y, x: p.x, c: Math.max(p.pop || 0, 1), nl: p.n }));
const placeCcs = [...new Set((r.places || [])
  .filter((p) => p.y != null && p.via !== "sounds" && p.cc)
  .map((p) => p.cc))];
const placeMap = placePins.length
  /* Three degrees of margin, so a single town is shown in its country
     rather than filling the frame with land. */
  ? placesMap(placePins, { max: 12, cc: placeCcs, minPad: 3 })
  : null;
const beRows = belgiumFor(r.n);
const bemap = beRows && placesMap(beRows, { cc: "BE" });
const beTotal = beRows ? beRows.reduce((a, x) => a + x.c, 0) : 0;
const dek = `${r.n}${by.curated ? `, also written ${by.curated.slice(0,4).join(", ")}` : ""}. `
  + `Attested in ${ccs.map((c) => CN[c.cc] || c.cc).join(", ")}`
  + (total ? `, borne by about ${total.toLocaleString()} people in the registers this map holds.` : ".");
/* THE BRIDGE BETWEEN THE TWO DATASETS. A region belongs to a country when
   its own `countries` list says so — the same rule /coverage/ and the
   country pages use, so a region whose ground lies in a country counts
   even where no place inside it has been walked. Eras are collapsed to a
   span and the distinct polities across it, because a surname page is not
   the place to reprint a region's whole timeline; the region's own page
   is one click away and has it in full. */
const attestedCcs = [...new Set(ccs.map((c) => c.cc).filter(Boolean))];
const jurisdiction = attestedCcs.map((cc) => {
  const rs = (regions.regions || [])
    .filter((rg) => (rg.countries || []).includes(cc))
    .map((rg) => {
      const eras = rg.eras || [];
      const polities = [...new Set(eras.map((e) =>
        (e.polity || "").split(" \u2014 ")[0].split(" \u00b7 ")[0].trim()).filter(Boolean))];
      /* THE SPAN WAS NOISE THAT LOOKED LIKE INFORMATION. Nearly every region
         here runs 1200 to 2026, because they all reach from the first
         surviving records to today, so seven Croatian rows said the same
         thing seven times over. The era COUNT is the honest summary of a
         timeline, and it is the idiom the country pages already use. */
      return {
        id: rg.id, label: rg.label, eras: eras.length,
        first: eras.length ? Math.min(...eras.map((e) => e.from)) : 0,
        polities: polities.slice(0, 4).join(" \u2192 ") +
                  (polities.length > 4 ? " \u2192 \u2026" : ""),
      };
    })
    .sort((a, b) => a.first - b.first);
  return { cc, regions: rs };
}).filter((g) => g.regions.length);
/* CAPPED, AND THE ORDER IS WHY IT CAN BE. `ccs` is sorted by how many people
   a register counted, so the first countries here are the ones the name
   actually belongs to. Uncapped, Peeters — a Belgian name — listed eleven
   regions across Poland, Czechia, Canada and Alsace, because a register
   somewhere counted a Peeters, and buried the countries that matter under
   the ones that do not. Five countries, then a count of the rest. */
const JUR_CAP = 5;
const jurMore = Math.max(0, jurisdiction.length - JUR_CAP);
const jurShown = jurisdiction.slice(0, JUR_CAP);
const mapped = new Set(jurisdiction.map((g) => g.cc));
const unmapped = attestedCcs.filter((cc) => !mapped.has(cc));
---
<Base
  og="surname"
  jsonld={{
    "@context": "https://schema.org", "@type": "DefinedTerm",
    name: r.n, description: dek,
    alternateName: (by.curated || []).slice(0, 20),
    inDefinedTermSet: { "@type": "DefinedTermSet", name: "Record Atlas surname dataset",
                        license: "https://creativecommons.org/publicdomain/zero/1.0/" },
  }}
  title={r.n} eyebrow={ccs.map((c) => CN[c.cc] || c.cc).join(" · ")} dek={dek}>

  {/* SPELLING WAS BUILT, LABELLED, AND NEVER RENDERED. The tier has existed
      in the data for a while and TIER above has carried its heading and its
      explanation the whole time — it simply was not in this list, so no
      surname page has ever shown a spelling variant. Kosina's page did not
      mention Kozina. Defranceschi's did not mention Defranceski. Both are
      in the data, and both are the whole point.
      Ordered by what the evidence is worth: somebody checked, then a rule
      of the language, then one systematic substitution with both forms
      attested, then an algorithm's guess. */}
  {["curated", "grammar", "spelling", "sounds"].map((how) => by[how] && (
    <section style="margin-top:24px">
      <h2>{TIER[how][0]}</h2>
      <p class="cap">{TIER[how][1]}</p>
      <p class="vars">{by[how].slice(0, 40).map((n) => (
        pageFor.has(slugify(n))
          ? <a href={u(`/surname/${slugify(n)}/`)}><b>{n}</b></a>
          : <b>{n}</b>
      ))}</p>
    </section>
  ))}

  {wd && (wd.lang || wd.kind || wd.after || wd.wiki) && (
    <section style="margin-top:30px">
      <h2>What Wikidata says this name is</h2>
      {/* ATTRIBUTED IN THE HEADING, NOT IN A FOOTNOTE.
          Every genealogy site on the web will tell you a surname's
          meaning and almost none will say who says so — «from the Latin
          Franciscus, meaning free man», the same three sentences on forty
          sites. This atlas will not join them. Nothing in this section is
          generated, inferred or paraphrased: four fields are copied from
          Wikidata and the item that said each one is linked at the end,
          so a reader who doubts it can go and look. Wikidata is
          crowd-sourced and wrong in places, and saying so is cheaper than
          being wrong quietly. */}
      <p class="cap">Copied from Wikidata, not worked out here. It is
      crowd-sourced and wrong in places, which is why the item is linked
      below rather than the claim simply repeated.</p>
      <ul class="vols" style="margin-top:12px">
        {wd.lang && (
          <li>
            <b>{wd.lang.join(" · ")}</b>
            <span class="who">the language of the name</span>
            <p class="cap" style="margin:4px 0 0">Which is not where a
            family is from. A Polish surname can be borne by people whose
            forebears never saw Poland, and often is.</p>
          </li>
        )}
        {wd.kind && (
          <li>
            <b>{wd.kind.join(" · ")}</b>
            <span class="who">kind of surname</span>
          </li>
        )}
        {wd.after && (
          <li>
            <b>Named after {wd.after.join(" · ")}</b>
            <span class="who">what the name is from</span>
          </li>
        )}
        {wd.wiki && (
          <li>
            <a href={wd.wiki} target="_blank" rel="noopener">Read about it on Wikipedia ↗</a>
            <span class="who">an article, with its own sources</span>
          </li>
        )}
      </ul>
      <p class="cap" style="margin-top:10px">
        <a href={wd.cite} target="_blank" rel="noopener">{wd.q} on Wikidata ↗</a>
        {" "}— the item every line above came from.
      </p>
    </section>
  )}

  {r.places && r.places.length > 0 ? (
    <section style="margin-top:30px">
      <h2>It is also the name of a place</h2>
      {placeMap && (
        <figure class="smap" style="margin:12px 0 4px">
          <Fragment set:html={placeMap.svg} />
          <figcaption class="cap" style="margin-top:8px">
            Where those places are. A dot is a settlement whose name is
            this surname, sized by its population — <b>not</b> a claim
            that anybody of the name lives there. Phonetic neighbours are
            listed below but not drawn: putting a machine's guess on the
            ground would dress it up as geography.
          </figcaption>
        </figure>
      )}
      <p class="cap"><b>This is as close to an origin as this map will go.</b> A surname that
      is also a place name often came from it — and often did not: plenty are occupations or
      patronymics that happen to collide with a place, and plenty of places are named after a
      family rather than the other way round. It is a fact with a source, which is more than
      an etymology page offers.</p>
      <ul class="vols" style="margin-top:12px">
        {r.places.map((pl) => (
          <li>
            <b>{pl.n}</b>
            {pl.cc && <span class="who">{CN[pl.cc] || pl.cc}</span>}
            {pl.pop > 0 && <span class="who">pop. {pl.pop.toLocaleString()}</span>}
            {pl.via === "variant" && <span class="who">a spelling of the name</span>}
            {pl.via === "sounds" && <span class="who">only a phonetic neighbour, not a spelling</span>}
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section style="margin-top:30px">
      <h2>Where it came from</h2>
      <p class="cap">No place of this name is in the gazetteer, so <b>this map says nothing
      about where the name came from</b>. Search a surname anywhere else and you will be told
      an origin — that it is Latin, or Italian, or means «joyful». That is etymology, it is
      usually unsourced, and it is a different question from the one answered here.</p>
    </section>
  )}

  <section style="margin-top:30px">
    <h2>Where it is borne, and where a record names it</h2>
    {smap && (
      <figure class="smap">
        <Fragment set:html={smap.svg} />
        <figcaption class="cap">
          {/* THE CAPTION IS PART OF THE PICTURE, not decoration under it.
              A map with two dots on it makes three claims a reader will
              believe unless told otherwise, and all three would be wrong. */}
          <b>A dot is a country, not a place.</b> It sits at the country's
          centre because a national register counts a country; nothing here
          says where in it these people are.
          {smap.counted < smap.drawn && (
            <> <b>A hollow ring is attested but not counted</b> — Denmark
            publishes which surnames exist and not how many carry each, and a
            family archive finds a name without counting heads. Sizing those
            by a number nobody published would invent it.</>
          )}
          {" "}<b>Blank is not absence.</b> This draws
          {" "}{ccs.length === 1 ? "the one country" : `the ${ccs.length} countries`}
          {" "}where the eleven registers and eight archives behind this atlas
          attest the name. Most of the world has no surname register this
          project can read, and <a href={u("/surnames/")}>the ones that do and
          will not are listed with the reason</a>.
        </figcaption>
      </figure>
    )}

    {bemap && (
      <figure class="smap" style="margin-top:22px">
        <figcaption class="cap" style="margin:0 0 8px">
          <b>Belgium, by commune.</b> {beTotal.toLocaleString()} people in
          {" "}{beRows.length} of Belgium's 565 communes, counted by Statbel.
          The biggest is <b>{beRows[0].nl}</b> with
          {" "}{beRows[0].c.toLocaleString()}.
          {bemap.omitted > 0 && (
            <> Only the {bemap.drawn} commonest are drawn; {bemap.omitted}
            {" "}more communes hold a few each.</>
          )}
          {" "}This is the only country here that can be drawn this way —
          every other register counts a country and stops, so a blank
          elsewhere is a gap in what states publish, not in the name.
        </figcaption>
        <Fragment set:html={bemap.svg} />
      </figure>
    )}

    <p class="cap">Two different claims, and they used to be one word. A <b>register</b> is a
    head-count — a state counted these people. A <b>record</b> is one document naming the
    surname on that ground, which is narrower evidence and often very much older. Neither ever
    means the name exists in that country and nowhere else.</p>
      <thead><tr><th>Country</th><th class="m">People</th><th>Kind of claim</th>
        <th>How we know</th></tr></thead>
      <tbody>
        {ccs.map((c) => (
          <tr>
            <td><a href={u(`/country/${c.cc.toLowerCase()}/`)}>{CN[c.cc] || c.cc}</a></td>
            <td class="m">{c.n ? c.n.toLocaleString() : "—"}</td>
            <td>{KIND_OF[c.how] || c.how}</td>
            <td>{(c.by || []).map((b) => attestedBy[b]?.name || b).join("; ") || c.how}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {/* WHEN A SOURCE CANNOT BE ENUMERATED, ITS SILENCE IS NOT EVIDENCE.
        Every other register in this table was downloaded whole, so a name
        missing from it is a name the state did not count. Croatia's cannot
        be downloaded at all: DZS answers one surname at a time and will not
        say which surnames exist, so this atlas asked only about names it
        already attests on Croatian ground. A reader who took a blank row
        for «not in Croatia» would be reading our question list, not the
        census. */}
    {ccs.some((c) => (c.by || []).some((b) => attestedBy[b]?.enumerable === false)) && (
      <p class="cap" style="margin-top:10px">
        One of these sources answers questions rather than publishing a list:
        {" "}{[...new Set(ccs.flatMap((c) => (c.by || [])
              .filter((b) => attestedBy[b]?.enumerable === false)
              .map((b) => attestedBy[b].name)))].join("; ")}.
        {" "}It was asked about this name because the atlas already holds it.
        A surname absent from that country's row may simply never have been
        asked about.
      </p>
    )}
  </section>

  {tl && (
    <section style="margin-top:34px">
      <h2>When and where it was being born</h2>
      <p class="cap">{tl.total.toLocaleString()} people with this name, or one of its
      variants, whose birth year and birth country are both recorded — from the
      {" "}{tl.decades[0]}s to the {tl.decades[tl.decades.length - 1]}s.
      {tl.names.length > 1 && <> Counted across {tl.names.join(", ")}, because they
      are the same name.</>}</p>
      <div class="one" style="border-left-color:var(--rule-strong)">
        <div class="lab">Read this as evidence, not as a count</div>
        <p class="cap">These are people notable enough for an encyclopaedia, which is
        not a census. It over-counts men, the recent, Europe and North America, and
        misses almost everybody. It is good evidence that the name <b>was borne</b> in
        a place at a time. It says nothing about how common it was.</p>
      </div>
      <table style="margin-top:16px">
        <thead><tr><th>Country</th><th class="m">People</th><th>Decades of birth</th></tr></thead>
        <tbody>
          {tl.rows.map((r) => (
            <tr>
              {/* Only a link where there is a page. Wikidata knows people
                  born in East Germany and Taiwan; this atlas holds nothing
                  for either, and a link to a 404 is worse than plain text. */}
              <td>{hasCountryPage(r.cc)
                ? <a href={u(`/country/${r.cc.toLowerCase()}/`)}>{CN[r.cc] || r.cc}</a>
                : <span>{CN[r.cc] || r.cc}</span>}</td>
              <td class="m">{r.tot}</td>
              <td class="cap">{Object.keys(r.d).map(Number).sort((a, b) => a - b)
                .map((dd) => `${dd}s`).join(" · ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  {frCurve && (
    <section style="margin-top:34px">
      <h2>When it was being born, in France</h2>
      <p class="cap">INSEE counts <b>births</b> by surname and decade from the état civil,
      1891 to 2000 — the only dated evidence in this dataset. A name that starts at zero and
      climbs arrived; a name that falls to nothing left, died out, or emigrated, and the
      decade it stops is the decade to stop searching. It counts births registered in France,
      so a family that emigrated in 1900 simply stops appearing, which is information rather
      than a defect.
      {frRow.from && <> This name's first French births fall in <b>{frRow.from}</b>
      {frRow.to && <> and its last in <b>{frRow.to}</b></>}.</>}</p>
      <ul class="curve">
        {frCurve.map((d) => (
          <li>
            <span class="d">{d.decade}</span>
            <span class="bar" style={`width:${frPeak.n ? Math.round(100 * d.n / frPeak.n) : 0}%`}></span>
            <span class="n">{d.n ? d.n.toLocaleString() : "—"}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section style="margin-top:34px">
    <h2>Whose archive to write to</h2>
    <p class="cap">The national and regional sources covering the countries this name is
    attested in. This is the point of knowing where a name is: <b>a country is not an
    answer, an archive is.</b></p>
    {ccs.map((c) => {
      const src = sourcesFor(c.cc);
      return src.length > 0 && (
        <div style="margin-top:16px">
          <div class="lab"><a href={u(`/country/${c.cc.toLowerCase()}/`)}>{CN[c.cc] || c.cc}</a></div>
          <ul class="vols">
            {src.slice(0, 6).map((p) => (
              <li>
                <a href={u(`/archive/${p.id}/`)}>{p.name}</a>
                <span class="who">{PACCESS[p.access] || p.access}</span>
                {p.at && <span class="who">{p.at.place}</span>}
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </section>

  {jurShown.length > 0 && (
    <section style="margin-top:34px">
      <h2>Whose archive held that ground, and when</h2>
      <p class="cap">Every surname site can tell you a name is common somewhere. This one
      also knows <b>which filing system held that ground in which years</b> — and those are
      the two halves of one question: my people were called this, they were there, so who
      has the paper, and for which century. A name in Croatia before 1881 may sit in a
      military series and not a county one; a name in the Netherlands before 1811 has no
      civil record at all, only a baptism.</p>
      <p class="cap"><b>This is about the ground, not about your family.</b> A register
      counting a name in a country says nothing about which village. And these are the
      pieces of a country this atlas has drawn, which in a large one may be a corner of
      it — Acadia reaches into Maine and is not a statement about the United States,
      and Bohemia's ground crosses into Poland. Each region's own page says which ground
      it covers. Where a country is missing below, nothing covers it yet.</p>
      {jurShown.map((g) => (
        <div style="margin-top:16px">
          <div class="lab"><a href={u(`/country/${g.cc.toLowerCase()}/`)}>{CN[g.cc] || g.cc}</a></div>
          <ul class="vols">
            {g.regions.map((rg) => (
              <li>
                <a href={u(`/region/${rg.id}/`)}>{rg.label}</a>
                <span class="y">{rg.eras} eras</span>
                <span class="who">{rg.polities}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {jurMore > 0 && (
        <p class="cap" style="margin-top:14px">Regions are also drawn in{" "}
        {jurMore} other {jurMore === 1 ? "country" : "countries"} where this name
        is attested, further down the register's own list. The order here is how
        many people a register counted, so the countries above are the ones the
        name most belongs to.</p>
      )}
      {unmapped.length > 0 && (
        <p class="cap" style="margin-top:14px">No record region is drawn yet for{" "}
        {unmapped.map((cc) => CN[cc] || cc).join(", ")} — which is a gap in this atlas
        and not a statement about {unmapped.length === 1 ? "that country" : "those countries"}.</p>
      )}
    </section>
  )}

  <p style="margin-top:28px"><a class="bigl" href={u(`/?q=${encodeURIComponent(r.n)}`)}>
    Find {r.n} on the map →</a></p>
  <p class="cap"><a href={u("/surnames/")}>The surname dataset</a> · CC0, and downloadable</p>
</Base>

<style>
  /* The surname map. Land is a wash, not a subject: it is there so a dot
     has somewhere to sit. The dot colours match the main map's grammar —
     filled means somebody counted, hollow and dashed means nobody has.

