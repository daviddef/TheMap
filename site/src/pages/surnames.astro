---
import { statSync } from "node:fs";
/* The surname dataset, as a page and as a download.

   Built because a place is not the only thing somebody arrives holding. Very
   often all they have is a name on a certificate and no idea which country to
   start in. */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { corpus } from "../lib/surname-corpus.js";
import { surnameMap } from "../lib/surname-map.js";
import { earnsPage, slugForSurname } from "../lib/surname-pages.js";
const surn = corpus();
import { atlas as idx } from "../lib/atlas.js";
import refused from "../../../data/frequencies/_refused.json";
import { flagFor } from "../lib/flags.js";
import CountryCards from "../components/CountryCards.astro";
import { countryMetrics, countryTotals } from "../lib/country-metrics.js";
/* COUNTED, NOT TYPED — like the heading below, which was fixed for exactly this
   after saying «Four» above a list of eight. The typed «Five» under it happened
   to be right, and that is the whole problem with a typed number: it is right
   until an entry moves and nobody notices. Italy moved today. */
const rechecked = refused.refused.filter((r) => r.rechecked).length;

const CN = idx.countries || {};
/* Which of the refused actually have nothing. A register marked
   `enumerable: false` is a country this atlas can ask about but not
   enumerate — some of its names are in, and saying «not here» of it is
   false. */
const partialCc = new Set(
  (surn.sources ? Object.values(surn.sources) : [])
    .filter((x) => x && x.enumerable === false)
    .map((x) => x.cc)
    .filter(Boolean));
const partial = (refused.refused || []).filter(
  (r) => partialCc.has(r.country) || r.verdict.startsWith("queryable"));
const absent = (refused.refused || []).filter((r) => !partial.includes(r));
/* One real name to draw, picked rather than hard-coded: the name with a
   page that is attested in the most countries, so the picture has
   something in it. Hard-coding «Blažević» would have been a caption that
   quietly rots the first time the corpus changes. */
const ccList = countryMetrics();
const ccT = countryTotals();
const demo = (() => {
  /* PICKED ON PEOPLE COUNTED, NOT ON COUNTRIES TOUCHED. The first rule
     took the name attested in the most countries, which is «de
     Franceschi» — one filled dot over Italy and seven dashed rings
     scattered across empty ocean. It is a true picture and a terrible
     example: the reader's first sight of this feature should show the
     thing it is good at. Most people counted, across at least three
     countries, gives a name with weight in several places. */
  let best = null, bestN = 0;
  for (const r of surn.surnames || []) {
    const ccs = r.countries || [];
    if (ccs.length < 3 || !earnsPage(r)) continue;
    const counted = ccs.filter((c) => c.n != null);
    if (counted.length < 3) continue;
    const people = counted.reduce((a, c) => a + c.n, 0);
    if (people > bestN) { best = r; bestN = people; }
  }
  if (!best) return null;
  return { r: best, slug: slugForSurname(best.n),
           map: surnameMap(best.countries.slice()
                  .sort((a, b) => (b.n || 0) - (a.n || 0))) };
})();
const c = surn.counts || {surnames: 0, withVariants: 0, withCountries: 0, curatedLinks: 0};
const withCc = surn.surnames.filter((r) => r.countries.length);
const byCc = {};
for (const r of withCc) for (const x of r.countries) byCc[x.cc] = (byCc[x.cc] || 0) + 1;
const top = Object.entries(byCc).sort((a, b) => b[1] - a[1]);
const examples = surn.surnames
  .filter((r) => r.variants.some((v) => v.how === "curated") && r.countries.length)
  .slice(0, 14);

/* Read the built artefact rather than trusting a number in the markup. */
function dlSize(name) {
  try {
    const b = statSync(new URL(`../../public/${name}`, import.meta.url)).size;
    return b > 1048576 ? `${(b / 1048576).toFixed(0)} MB` : `${(b / 1024).toFixed(0)} KB`;
  } catch (e) { return "a download"; }
}
---
<Base
  og="dataset"
  jsonld={{
    "@context": "https://schema.org", "@type": "Dataset",
    name: "Record Atlas surname dataset",
    description: "Every spelling a surname takes and the countries it is attested in, "
      + "with the evidence tier on every claim.",
    license: "https://creativecommons.org/publicdomain/zero/1.0/",
    creator: { "@type": "Person", name: "David Defranceski" },
    distribution: [
      { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: u("/surnames.csv.gz") },
      { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: u("/surnames.json.gz") },
    ],
  }}
  title="Surnames"
  eyebrow={`${c.surnames.toLocaleString()} surnames · ${c.withCountries.toLocaleString()} with a country`}
  dek="Every spelling a surname takes, where it is attested, and the evidence for each. To look one up, use Names.">

  {/* THE PAGE HAD NOWHERE TO TYPE A NAME, then it had a paragraph about it. Now the first thing is a door to the one search, then the
      countries (counted by their national registers), then what is in the data, and the downloads. The long explanations are folded,
      not removed. */}
  <a class="k-search k-door" href={u("/your-name/?kind=surname")} aria-label="Look up a surname">
    <span class="k-ico" aria-hidden="true">🔎</span>
    <span class="k-door-t">Look up a surname, a country or a place</span>
    <span class="k-pill is-solid">Names &rarr;</span>
  </a>

  <section class="cdir">
    <div class="k-bar"><h2>By country</h2><span class="k-count">{ccT.withRegister} have a national register · {ccT.archiveOnly} only a family archive · {ccT.noNames} nothing</span></div>
    <CountryCards list={ccList} totals={ccT} showFind={false} />
    <details class="about" style="margin-top:14px"><summary>How these counts work</summary>
      <p class="cap">A count here is how many surnames that country's <b>national register</b> names. It measures which registers have been
      harvested, not where a name is borne: {ccT.withRegister} countries have one, {ccT.archiveOnly} are named only by a family archive,
      and <b>{ccT.noNames} have nothing at all</b> — which is the list worth shortening.</p></details>
  </section>

  <div class="k-bar"><h2>Three kinds of fact, never mixed</h2></div>
  <ul class="k-grid kinds">
    <li class="k-card"><span class="k-pill">curated</span><p>A person linked two spellings: Wikidata's <em>said to be the same as</em>, and the clusters seven family archives worked out from documents.</p></li>
    <li class="k-card"><span class="k-pill">archive</span><p>The name appears in one of those archives, whose ground is known.</p></li>
    <li class="k-card"><span class="k-pill is-plain">sounds</span><p>An algorithm thinks they sound alike. Good for casting a net, worthless as evidence, and labelled so.</p></li>
  </ul>
  <p class="cap" style="margin-top:12px"><b>«Attested in Spain» means the name appears in a dataset held here.</b> It never means the name exists in Spain, and never that it exists nowhere else. This map's blanks are gaps in the map.</p>

  {demo && demo.map && (
    <section>
      <div class="k-bar"><h2>A name is a place, so it is drawn</h2><a class="k-pill" href={u(`/surname/${demo.slug}/`)}>{demo.r.n} &rarr;</a></div>
      <figure class="smap">
        <Fragment set:html={demo.map.svg} />
      </figure>
      <p class="cap"><b>A dot is a country, not a place</b>, and a hollow ring is a name attested without being counted. Neither says anything
      about the countries not drawn: most of the world has no register this project can read, and the {refused.refused.length} that do and will not are below.
      The <a href={u("/your-name/?kind=surname")}>Names page</a> finds a name; each surname page answers it.</p>
    </section>
  )}

  {examples.length > 0 && (
    <section>
      <div class="k-bar"><h2>What it looks like</h2></div>
      <div style="overflow-x:auto"><table class="k-table">
        <thead><tr><th>Surname</th><th>Also written</th><th class="m">Attested in</th></tr></thead>
        <tbody>
          {examples.map((r) => (
            <tr>
              <td>{r.n}</td>
              <td>{r.variants.filter((v) => v.how === "curated").map((v) => v.n).join(" · ")}</td>
              <td class="m">{r.countries.map((x) => CN[x.cc] || x.cc).join(", ")}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>
  )}

  <section>
    <div class="k-bar"><h2>Where the names are attested</h2><span class="k-count">{top.length} countries</span></div>
    <ul class="k-pills ccs">
      {/* THE FLAG OF EVERY COUNTRY A NAME IS ATTESTED IN, and the arrow opens that country's flag history. */}
      {top.map(([cc, n]) => {
        const f = flagFor(cc);
        return (
          <li>
            <a class="k-pill is-plain" href={u(`/country/${cc.toLowerCase()}/`)}>
              {f && <svg class="ccflag" viewBox="0 0 300 200" role="img" aria-label={`Flag of ${CN[cc] || cc}`} set:html={f.flag} />}
              {CN[cc] || cc} <span class="y">{n}</span></a>
            {f && <a class="ccflag-l" href={u("/" + f.url)} aria-label={`${CN[cc] || cc} in the flags atlas`}
              title={`${CN[cc] || cc} in the flags atlas — who held this ground, and when`}>&#8599;</a>}
          </li>
        );
      })}
    </ul>
  </section>

  <section>
    <div class="k-bar"><h2>Take it away</h2><span class="k-count">CC0 · no attribution</span></div>
    {/* SIZES MEASURED, NOT TYPED: a number a reader might act on has to come from the file. */}
    <ul class="k-grid">
      <li><a class="k-card" href={u("/surnames.csv.gz")}><h3>surnames.csv.gz</h3><span class="k-pill">{dlSize("surnames.csv.gz")}</span>
        <p>One row per surname × variant × country. The practical one.</p></a></li>
      <li><a class="k-card" href={u("/surnames.json.gz")}><h3>surnames.json.gz</h3><span class="k-pill">{dlSize("surnames.json.gz")}</span>
        <p>The same thing structured, with the evidence tier on every claim.</p></a></li>
    </ul>
    <details class="about" style="margin-top:14px"><summary>Licence, size and sources</summary>
      <p class="cap">CC0. No attribution required, no licence travels with it — the sources are Wikidata (CC0) and David Defranceski's own
      research, and nothing under CC BY was folded in so that this could stay true.</p>
      <p class="cap">Both are gzipped: uncompressed they are a sixth of this whole site, which has a gigabyte to live in. Every browser and every
      data tool reads a .gz without being asked. Both are large because most of the rows are a national register. If you want one country's raw
      frequencies, take it straight from the source — they are in <code>data/frequencies/</code> in the repository, one file per country, each
      carrying its own licence and harvest date.</p>
      <p class="cap">Sources: {surn.sources.map((s) => <span>{s}<br /></span>)}</p></details>
  </section>

  <details class="about">
    <summary>How thin this still is</summary>
    <p class="cap">{c.surnames.toLocaleString()} surnames is not every surname in the world, and there is no open dataset that is — the one
    commercial database claiming twenty-seven million is not redistributable and is not used here.</p>
    <p class="cap"><b>And it is lopsided, because it is the shape of which governments make it easy.</b> Five national registers are in: Poland's
    PESEL list of 270,887 — including the deceased, which is what makes it genealogical rather than a directory — the United States' 162,253
    from the 2010 Census <b>and 151,671 from 2000</b>, Spain's 86,512 from the population censuses, and Norway's 3,620, which is only names
    borne by two hundred people or more.</p>
    <p class="cap"><b>Both American censuses, and the older one earns its place.</b> 5,155 surnames appear in the 2000 list and not in 2010 — a
    name borne by a hundred people in 2000 and ninety-nine a decade later drops out of the later file entirely. Vanishing names are exactly the
    ones a researcher is chasing, and a dataset that carried only the most recent snapshot would lose them at the moment they became interesting.</p>
  </details>

  <section>
    {/* COUNTED, NOT TYPED. «NOT HERE» WAS TOO BLUNT FOR CROATIA: a country with some of its names here is a different animal from one with
        none, and the list separates them. */}
    <div class="k-bar"><h2>{absent.length} countries that are not here</h2><span class="k-count">and exactly why</span></div>
    <p class="cap">Sought and not obtained. Without this list the next person spends the same afternoon finding the same walls. {rechecked} were re-tested on {refused.checked} against
    live endpoints rather than remembered ones, and every refusal held.
    {(refused.resolved || []).length > 0 && <> But retrying is also what closed
    <b>{(refused.resolved || []).map((r) => r.name).join(", ")}</b>, which had been the
    weakest verdict here — «not found», meaning only that somebody looked once.</>}</p>
    {partial.length > 0 && (
      <div class="k-hi is-plain" style="margin:12px 0 0">
        <p><b>Partly here, which is not the same as missing</b></p>
        {partial.map((r) => (
          <p><b>{r.name}</b> — {r.verdict}. Some of its names are in the corpus and the rest are not obtainable; the entry below says exactly how far it goes.</p>
        ))}
      </div>
    )}
    <ul class="k-grid refused">
      {refused.refused.map((r) => (
        <li class="k-card">
          <h3>{r.name}</h3>
          <p><span class="k-pill is-plain">{r.verdict}</span>
          {r.rechecked && <span class="k-pill">re-tested {r.rechecked}</span>}</p>
          <p>{r.why}</p>
          <details class="tried"><summary>What was tried</summary><ul>{r.tried.map((t) => <li>{t}</li>)}</ul></details>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* The map comes through set:html and carries none of Astro's scoping attributes, so its rules are :global.
     Dark mode is written twice, once for the media query and once for the explicit toggle. */
  .smap { margin: 0 0 8px; }
  .smap :global(svg.sm) { display: block; width: 100%; height: auto; max-height: 460px;
    background: var(--panel, #EDEAE3); border: 1px solid var(--rule, #D8D3C8); border-radius: 18px; }
  .smap :global(.sm-land) { fill: #D5CFC2; stroke: #BDB6A6; stroke-width: .5; }
  .smap :global(.sm-c circle) { fill: var(--hue, var(--accent)); fill-opacity: .78; stroke: var(--panel, #fff); stroke-width: 1; }
  .smap :global(.sm-u circle) { fill: none; stroke: var(--ink-3, #7C8A91); stroke-width: 1.6; stroke-dasharray: 2 2; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .smap :global(.sm-land) { fill: #2A3841; stroke: #3F515C; }
  }
  :root[data-theme="dark"] .smap :global(.sm-land) { fill: #2A3841; stroke: #3F515C; }

  .about { margin-top: 28px; border: 1px solid var(--rule); border-radius: 18px; background: var(--panel); padding: 6px 20px; }
  .about summary { cursor: pointer; font: 600 15px/1.3 var(--sans); padding: 10px 0; }
  .k-door { text-decoration: none; color: inherit; cursor: pointer; margin-top: 6px; }
  .k-door-t { flex: 1; min-width: 0; font: 500 clamp(17px, 2.2vw, 22px)/1.3 var(--sans); color: var(--ink-3); }
  .k-door:hover { border-color: var(--hue, var(--accent)); }
  .kinds .k-card p { margin: 0; }
  code { font-family: var(--mono); font-size: 12.5px; background: var(--panel-2); padding: 1px 5px; border-radius: 6px; }
  .ccs { align-items: center; }
  .ccs li { display: inline-flex; align-items: center; gap: 4px; }
  .ccs .y { font: 11px var(--mono); color: var(--ink-3); }
  .ccflag { width: 20px; height: auto; border-radius: 3px; box-shadow: 0 0 0 1px var(--rule); }
  .ccflag-l { color: var(--ink-3); text-decoration: none; font-size: .9em; }
  .ccflag-l:hover { color: var(--hue-ink); }
  td { vertical-align: top; }
  .refused .k-pill { white-space: normal; }
  .refused .tried { margin-top: 4px; }
  .refused .tried summary { cursor: pointer; font: 500 12px var(--mono); color: var(--hue-ink); }
  .refused .tried ul { margin: 6px 0 0; padding-left: 18px; }
  .refused .tried li { font: 11px/1.6 var(--mono); color: var(--ink-3); }
</style>
