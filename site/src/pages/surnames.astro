---
/* The surname dataset, as a page and as a download.

   Built because a place is not the only thing somebody arrives holding. Very
   often all they have is a name on a certificate and no idea which country to
   start in. */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import surn from "../../public/surnames.json";
import idx from "../../public/index.json";

const CN = idx.countries || {};
const c = surn.counts;
const withCc = surn.surnames.filter((r) => r.countries.length);
const byCc = {};
for (const r of withCc) for (const x of r.countries) byCc[x.cc] = (byCc[x.cc] || 0) + 1;
const top = Object.entries(byCc).sort((a, b) => b[1] - a[1]);
const examples = surn.surnames
  .filter((r) => r.variants.some((v) => v.how === "curated") && r.countries.length)
  .slice(0, 14);
---
<Base
  title="Surnames"
  eyebrow={`${c.surnames} surnames · ${c.curatedLinks} curated variant links · ${c.withCountries} with a country`}
  dek="Every spelling a surname takes, and the countries it is attested in. Built to answer the other way in: not «where is this place» but «I have a name and nothing else».">

  <div class="one" style="border-left-color:#7A5CA8">
    <div class="lab">Three kinds of fact, never mixed</div>
    <ul class="kinds">
      <li><b>curated</b> — a person linked two spellings. Wikidata's <em>said to be the same
        as</em>, and the variant clusters seven family archives worked out from documents.</li>
      <li><b>archive</b> — the name appears in one of those archives, whose ground is known.</li>
      <li><b>sounds</b> — an algorithm thinks they sound alike. Useful for casting a net,
        worthless as evidence, and labelled so nobody mistakes it for one.</li>
    </ul>
    <p class="cap" style="margin-top:10px"><b>«Attested in Spain» means the name appears in a
    dataset held here.</b> It never means the name exists in Spain, and never that it exists
    nowhere else. This map's blanks are gaps in the map.</p>
  </div>

  <section style="margin-top:30px">
    <h2>Take it away</h2>
    <p class="cap">CC0. No attribution required, no licence travels with it — the sources are
    Wikidata (CC0) and David Defranceski's own research, and nothing under CC BY was folded
    in so that this could stay true.</p>
    <p class="dl">
      <a href={u("/surnames.json")}>surnames.json</a> — the full structured dataset<br />
      <a href={u("/surnames.csv")}>surnames.csv</a> — one row per surname × variant × country
    </p>
    <p class="cap">Sources: {surn.sources.map((s) => <span>{s}<br /></span>)}</p>
  </section>

  {examples.length > 0 && (
    <section style="margin-top:30px">
      <h2>What it looks like</h2>
      <table style="margin-top:12px">
        <thead><tr><th>Surname</th><th>Also written</th><th class="m">Attested in</th></tr></thead>
        <tbody>
          {examples.map((r) => (
            <tr>
              <td>{r.n}</td>
              <td>{r.variants.filter((v) => v.how === "curated").map((v) => v.n).join(" · ")}</td>
              <td class="m">{r.countries.map((x) => CN[x.cc] || x.cc).join(", ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section style="margin-top:30px">
    <h2>Where the names are attested</h2>
    <ul class="ccs">
      {top.map(([cc, n]) => (
        <li><a href={u(`/country/${cc.toLowerCase()}/`)}>{CN[cc] || cc}</a> <span class="y">{n}</span></li>
      ))}
    </ul>
  </section>

  <div class="one" style="margin-top:30px;border-left-color:var(--rule-strong)">
    <div class="lab">How thin this still is</div>
    <p class="cap">{c.surnames} surnames is not every surname in the world, and there is no
    open dataset that is — the one commercial database that claims twenty-seven million is
    not redistributable and is not used here. What is open is Wikidata's curated variant
    links and a handful of national frequency lists published by governments. The second of
    those is not folded in yet; when it is, the country coverage stops being thin.</p>
  </div>
</Base>

<style>
  h2 { font-family: var(--serif); font-size: 26px; font-weight: 500; margin: 0 0 6px; }
  .kinds { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 7px; }
  .kinds li { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: var(--ink-2); }
  .kinds b { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .dl { font-family: var(--mono); font-size: 14px; line-height: 2; margin-top: 10px; }
  .ccs { list-style: none; padding: 0; margin: 12px 0 0;
         display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 4px; }
  .ccs li { font-family: var(--sans); font-size: 13px; }
  .y { font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
  td { vertical-align: top; }
</style>
