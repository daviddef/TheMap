---
import { statSync } from "node:fs";
/* The surname dataset, as a page and as a download.

   Built because a place is not the only thing somebody arrives holding. Very
   often all they have is a name on a certificate and no idea which country to
   start in. */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import surn from "../data/surnames.json";
import { atlas as idx } from "../lib/atlas.js";
import refused from "../../../data/frequencies/_refused.json";
/* COUNTED, NOT TYPED — like the heading below, which was fixed for exactly this
   after saying «Four» above a list of eight. The typed «Five» under it happened
   to be right, and that is the whole problem with a typed number: it is right
   until an entry moves and nobody notices. Italy moved today. */
const rechecked = refused.refused.filter((r) => r.rechecked).length;

const CN = idx.countries || {};
const c = surn.counts || {surnames: 0, withVariants: 0, withCountries: 0, curatedLinks: 0};
const withCc = surn.surnames.filter((r) => r.countries.length);
const byCc = {};
for (const r of withCc) for (const x of r.countries) byCc[x.cc] = (byCc[x.cc] || 0) + 1;
const top = Object.entries(byCc).sort((a, b) => b[1] - a[1]);
const examples = surn.surnames
  .filter((r) => r.variants.some((v) => v.how === "curated") && r.countries.length)
  .slice(0, 14);

/* Read the built artefact rather than trusting a number in the markup. */
function dlSize(name) {
  try {
    const b = statSync(new URL(`../../public/${name}`, import.meta.url)).size;
    return b > 1048576 ? `${(b / 1048576).toFixed(0)} MB` : `${(b / 1024).toFixed(0)} KB`;
  } catch (e) { return "a download"; }
}
---
<Base
  og="dataset"
  jsonld={{
    "@context": "https://schema.org", "@type": "Dataset",
    name: "Record Atlas surname dataset",
    description: "Every spelling a surname takes and the countries it is attested in, "
      + "with the evidence tier on every claim.",
    license: "https://creativecommons.org/publicdomain/zero/1.0/",
    creator: { "@type": "Person", name: "David Defranceski" },
    distribution: [
      { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: u("/surnames.csv.gz") },
      { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: u("/surnames.json.gz") },
    ],
  }}
  title="Surnames"
  eyebrow={`${c.surnames} surnames · ${c.curatedLinks} curated variant links · ${c.withCountries} with a country`}
  dek="Every spelling a surname takes, and the countries it is attested in. Built to answer the other way in: not «where is this place» but «I have a name and nothing else».">

  <div class="one" style="border-left-color:#7A5CA8">
    <div class="lab">Three kinds of fact, never mixed</div>
    <ul class="kinds">
      <li><b>curated</b> — a person linked two spellings. Wikidata's <em>said to be the same
        as</em>, and the variant clusters seven family archives worked out from documents.</li>
      <li><b>archive</b> — the name appears in one of those archives, whose ground is known.</li>
      <li><b>sounds</b> — an algorithm thinks they sound alike. Useful for casting a net,
        worthless as evidence, and labelled so nobody mistakes it for one.</li>
    </ul>
    <p class="cap" style="margin-top:10px"><b>«Attested in Spain» means the name appears in a
    dataset held here.</b> It never means the name exists in Spain, and never that it exists
    nowhere else. This map's blanks are gaps in the map.</p>
  </div>

  <section style="margin-top:30px">
    <h2>Take it away</h2>
    <p class="cap">CC0. No attribution required, no licence travels with it — the sources are
    Wikidata (CC0) and David Defranceski's own research, and nothing under CC BY was folded
    in so that this could stay true.</p>
    {/* SIZES MEASURED, NOT TYPED. These read 21 MB and 64 MB while the files
        were 58 and 107 — written once when they were true and never touched
        again, so the page quietly understated a download by a factor of two.
        A number a reader might act on has to come from the file. */}
    <p class="dl">
      <a href={u("/surnames.csv.gz")}>surnames.csv.gz</a> — <b>{dlSize("surnames.csv.gz")}</b>,
      one row per surname × variant × country. The practical one.<br />
      <a href={u("/surnames.json.gz")}>surnames.json.gz</a> — <b>{dlSize("surnames.json.gz")}</b>,
      the same thing structured, with the evidence tier on every claim.
    </p>
    <p class="cap">Both are gzipped: uncompressed they are a sixth of this whole
    site, which has a gigabyte to live in. Every browser and every data tool
    reads a .gz without being asked.</p>
    <p class="cap">Both are large because most of the rows are a national register. If you
    want one country's raw frequencies, take it straight from the source instead — they are
    in <code>data/frequencies/</code> in the repository, one file per country, each carrying
    its own licence and harvest date.</p>
    <p class="cap">Sources: {surn.sources.map((s) => <span>{s}<br /></span>)}</p>
  </section>

  {examples.length > 0 && (
    <section style="margin-top:30px">
      <h2>What it looks like</h2>
      <table style="margin-top:12px">
        <thead><tr><th>Surname</th><th>Also written</th><th class="m">Attested in</th></tr></thead>
        <tbody>
          {examples.map((r) => (
            <tr>
              <td>{r.n}</td>
              <td>{r.variants.filter((v) => v.how === "curated").map((v) => v.n).join(" · ")}</td>
              <td class="m">{r.countries.map((x) => CN[x.cc] || x.cc).join(", ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <section style="margin-top:30px">
    <h2>Where the names are attested</h2>
    <ul class="ccs">
      {top.map(([cc, n]) => (
        <li><a href={u(`/country/${cc.toLowerCase()}/`)}>{CN[cc] || cc}</a> <span class="y">{n}</span></li>
      ))}
    </ul>
  </section>

  <div class="one" style="margin-top:30px;border-left-color:var(--rule-strong)">
    <div class="lab">How thin this still is</div>
    <p class="cap">{c.surnames.toLocaleString()} surnames is not every surname in the world,
    and there is no open dataset that is — the one commercial database claiming twenty-seven
    million is not redistributable and is not used here.</p>
    <p class="cap"><b>And it is lopsided, because it is the shape of which governments make
    it easy.</b> Five national registers are in: Poland's PESEL list of 270,887 — including
    the deceased, which is what makes it genealogical rather than a directory — the United
    States' 162,253 from the 2010 Census <b>and 151,671 from 2000</b>, Spain's 86,512 from
    the population censuses, and Norway's 3,620, which is only names borne by two hundred
    people or more.</p>
    <p class="cap"><b>Both American censuses, and the older one earns its place.</b> 5,155
    surnames appear in the 2000 list and not in 2010 — a name borne by a hundred people in
    2000 and ninety-nine a decade later drops out of the later file entirely. Vanishing names
    are exactly the ones a researcher is chasing, and a dataset that carried only the most
    recent snapshot would lose them at the moment they became interesting.</p>
  </section>

  <section style="margin-top:30px">
    {/* COUNTED, NOT TYPED. It said «Four» and listed eight — written when there
    were four and never looked at again, on the one page whose whole purpose
    is to be accurate about what is missing. */}
    <h2>{refused.refused.length} countries that are not here, and exactly why</h2>
    <p class="cap">Sought and not obtained. Without this list the next person spends the same
    afternoon finding the same walls. {rechecked} were re-tested on {refused.checked} against
    live endpoints rather than remembered ones, and every refusal held.
    {(refused.resolved || []).length > 0 && <> But retrying is also what closed
    <b>{(refused.resolved || []).map((r) => r.name).join(", ")}</b>, which had been the
    weakest verdict here — «not found», meaning only that somebody looked once.</>}</p>
    <ul class="refused">
      {refused.refused.map((r) => (
        <li>
          <b>{r.name}</b> <span class="verdict">{r.verdict}</span>
          {r.rechecked && <span class="verdict re">re-tested {r.rechecked}</span>}
          <p>{r.why}</p>
          <ul class="tried">{r.tried.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  h2 { font-family: var(--serif); font-size: 26px; font-weight: 500; margin: 0 0 6px; }
  .verdict.re { background: var(--accent-wash); color: var(--accent);
                border-color: var(--rule); }
  .kinds { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 7px; }
  .kinds li { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: var(--ink-2); }
  .kinds b { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .dl { font-family: var(--mono); font-size: 14px; line-height: 2; margin-top: 10px; }
  .refused { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 16px; }
  .refused > li > b { font-family: var(--serif); font-size: 18px; }
  .refused p { font-family: var(--sans); font-size: 12.5px; line-height: 1.6;
               color: var(--ink-2); margin: 5px 0 0; max-width: 78ch; }
  .verdict { font-family: var(--sans); font-size: 10px; text-transform: uppercase;
             letter-spacing: .07em; color: #C0392B; border: 1px solid #C0392B;
             border-radius: 999px; padding: 1px 7px; margin-left: 8px; }
  .tried { margin: 6px 0 0 0; padding-left: 18px; }
  .tried li { font-family: var(--mono); font-size: 11px; color: var(--ink-3); line-height: 1.6; }
  code { font-family: var(--mono); font-size: 12.5px; background: var(--panel-2);
         padding: 1px 5px; border-radius: 2px; }
  .ccs { list-style: none; padding: 0; margin: 12px 0 0;
         display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 4px; }
  .ccs li { font-family: var(--sans); font-size: 13px; }
  .y { font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
  td { vertical-align: top; }
</style>
