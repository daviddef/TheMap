---
import { u } from "../../lib/url.js";
/* The Tree Canvas on its own: recordatlas.org/tree-canvas/. The same canvas that is the first tab of Roots & Routes, with "brought to you by Record
   Atlas" in its title and an "Open GEDCOM" button on the right. It is not the Base layout (which carries a counter, an ad slot and Google Fonts) for
   the same reason /roots/ is not: the file never leaves the device, and the meta CSP below is the browser enforcing that. The page around the
   canvas (public/tree-canvas/app.js) reads the file with the roots page's own reader (public/roots/js/worker.js) and hands the tree to the canvas
   in memory, as /roots/ does. What is kept is where the cards sit, per tree (public/tree-canvas/work.js): in this browser, and in the six-word copy if the visitor turned it
   on at Connection & Backup. Never the file. */
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https: https://archive.defranceski.com https://booyzen.defranceski.com https://luwinski.defranceski.com https://lerena.defranceski.com https://falco.defranceski.com https://blazevic.defranceski.com https://darcy.defranceski.com https://mazza.defranceski.com; font-src 'self'; worker-src 'self'; frame-src 'self'; form-action 'none'; base-uri 'none'">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<title>Tree Canvas · Record Atlas</title>
<meta name="description" content="Draw your family tree from a GEDCOM or tree.json file on one canvas, with the Record Atlas's places, rulers and record collections for each person. Read in your browser, never uploaded.">
<link rel="icon" href="/favicon.svg">
<link rel="stylesheet" href="/tree-canvas/page.css">
<link rel="stylesheet" href="/tree-canvas/fixrows.css">
<script is:inline src="/tree-canvas/theme-boot.js"></script>
</head>
<body>
<main id="start" aria-labelledby="stTitle">
  <div class="stwrap">
    <header class="sthead">
      <svg class="sttree" viewBox="0 0 120 64" width="120" height="64" aria-hidden="true" focusable="false">
        <path class="stcon" d="M60 22 V32 M24 32 H96 M24 32 V42 M96 32 V42" pathLength="1"/>
        <rect class="stnode c0" x="42" y="2" width="36" height="20" rx="6"/>
        <rect class="stnode c1" x="6" y="42" width="36" height="20" rx="6"/>
        <rect class="stnode c2" x="78" y="42" width="36" height="20" rx="6"/>
      </svg>
      <h1 id="stTitle">Tree Canvas</h1>
      <p class="stlead">Draw a family tree on one canvas, with the Atlas's places and records for each person. Your file is read in this browser and never uploaded.</p>
    </header>

    <section id="stCur" class="stcard stcur" hidden aria-labelledby="stCurTitle">
      <h2 id="stCurTitle">Your file is open</h2>
      <p class="stsub" id="stCurWhat"></p>
      <div class="stcurbtns"><button type="button" class="stbtn primary" id="stCurBack">Back to the canvas</button><button type="button" class="stbtn" id="stCurFile">Your file: numbers, report, export</button></div>
    </section>

    <section id="stDrop" class="stcard stdrop" aria-labelledby="stDropTitle">
      <h2 id="stDropTitle">Open a file</h2>
      <p class="stsub">Drop it anywhere on this page, or choose it from your device. A <b>GEDCOM</b> (the industry standard) or a <b>tree.json</b> (our own format; <a href="/tree-canvas/publish/#format">what is in it</a>).</p>
      <button type="button" class="stbtn primary" id="stOpen">Choose a file</button>
      <input type="file" id="stFile" accept=".ged,.gedcom,.txt,.json,text/plain,application/json" hidden>
    </section>

    <section id="stLink" class="stcard" aria-labelledby="stLinkTitle">
      <h2 id="stLinkTitle">Or paste a link</h2>
      <div class="stlinkrow">
        <label for="stUrl" class="stvh">Web address of a public GEDCOM or tree.json</label>
        <input type="url" id="stUrl" class="stlinkin" inputmode="url" autocomplete="off" spellcheck="false" maxlength="2000" placeholder="https://raw.githubusercontent.com/you/family/main/tree.json">
        <button type="button" class="stbtn" id="stGo">Open link</button>
      </div>
      <p id="stLinkMsg" class="stmsg" role="status" aria-live="polite" hidden></p>
      <p class="stex">No link handy? Try an invented example:
        <button type="button" class="stlink" data-ex="/examples/example-family.ged">GEDCOM</button> or
        <button type="button" class="stlink" data-ex="/examples/example-family.tree.json">tree.json</button></p>
    </section>

    <section id="stArch" class="stplain" aria-labelledby="stArchTitle">
      <h2 id="stArchTitle">Or just look around</h2>
      <div class="starch" id="stArchBtns">
        <button type="button" class="stchip" data-k="defranceski">Defranceski</button>
        <button type="button" class="stchip" data-k="booyzen">Booyzen</button>
        <button type="button" class="stchip" data-k="luwinski">Luwinski</button>
        <button type="button" class="stchip" data-k="lerena">Lerena</button>
        <button type="button" class="stchip" data-k="falco">Falco</button>
        <button type="button" class="stchip" data-k="blazevic">Blažević</button>
        <button type="button" class="stchip" data-k="darcy">D'Arcy</button>
        <button type="button" class="stchip" data-k="mazza">Mazza</button>
      </div>
      <p class="stsub">Each family archive's published tree, with its living people left out. Or <button type="button" class="stlink" id="stDemo">draw an invented family</button> to see how it works.</p>
    </section>

    <section id="stKeep" class="stplain" aria-labelledby="stKeepTitle">
      <a id="stKeepBtn" class="stkeep" href={u("/backup/#canvas")} target="_blank" rel="noopener" aria-describedby="stKeepSt">
        <span class="stdisc" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 3h11l4 4v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M7 3v5h8V3M7 21v-7h10v7"/></svg></span>
        <span class="stkcap"><b id="stKeepTitle">Keep your work</b><small id="stKeepSt">Saved in this browser. Six words keep it on every device: no email, no account.</small></span>
      </a>
    </section>

    <section id="stFixSaved" class="stplain" hidden aria-labelledby="stFixTitle">
      <h2 id="stFixTitle">Your saved fix list</h2>
      <p id="stFixTxt"></p>
      <p class="stsub">Only counts and the place text as typed are kept, never a name. Open the file again to work on it, or <a href={u("/my-research/#fixes")}>see it in My research</a>.</p>
    </section>

    <section id="stRecent" class="stplain" hidden aria-labelledby="stRecTitle">
      <h2 id="stRecTitle">Your trees</h2>
      <p class="stsub trintro">Each tree you opened, with the views you saved of it underneath. Rename a view or add a note with the pencil, as for a file.</p>
      <ul id="stList"></ul>
      <p class="stsub">Kept in this browser only. For a view, only where the cards sit is kept, never the file. A file from your device is matched when you open it again. <button type="button" class="stlink" id="stForget">Forget the kept files</button></p>
    </section>

    <p class="stsettings"><button type="button" class="stlink" id="stSettings">Settings</button> <span class="stsub">living people, links to MyHeritage and Ancestry, the look, remembering files</span></p>

    <details class="sthelp" id="stHelp">
      <summary>About these files and links</summary>
      <p><b>GEDCOM</b> is the industry standard: almost every genealogy program and website can export one. <b>tree.json</b> is our own format, made up for Record Atlas and read by nothing else. It is what a researcher's Roots &amp; Routes site makes, and it carries page links and corrections marks a GEDCOM cannot. <a href="/tree-canvas/publish/#format">The tree.json format, field by field</a>. <a href="/examples/README.md">About the example files</a>.</p>
      <p>For a link, your browser fetches the file straight from that site, so that site can see the request. Nothing from your tree is sent to it, and nothing passes through Record Atlas. https links only, up to 100 MB. The site must allow other sites to read the file (GitHub's raw files and GitHub Pages do). For a file on GitHub, paste the page address or the Raw one.</p>
    </details>
  </div>
</main>
<iframe id="cv" title="Tree Canvas, drawn from your file" hidden></iframe>
<main id="yf" hidden aria-labelledby="yfTitle">
  <div class="yfwrap">
    <header class="yfhead">
      <button type="button" class="stbtn" id="yfBack">← Back to the canvas</button>
      <h1 id="yfTitle" tabindex="-1">Your file</h1>
      <p class="stsub" id="yfWhat"></p>
      <p class="stsub"><button type="button" class="stlink" id="yfSettings">Settings</button>: living people, links, the look, remembering files.</p>
    </header>

    <section class="yfsec" aria-labelledby="yfGlanceT">
      <h2 id="yfGlanceT">At a glance</h2>
      <div class="yfmet" id="yfMetrics"></div>
      <p class="stsub" id="yfMetNote"></p>
    </section>

    <section class="yfsec" aria-labelledby="yfRepT">
      <h2 id="yfRepT">What was read</h2>
      <div id="yfReport" class="yfreport"></div>
    </section>

    <section class="yfsec" aria-labelledby="yfKeepT">
      <h2 id="yfKeepT">Keeping your work</h2>
      <a id="yfKeepBtn" class="stkeep" href={u("/backup/#canvas")} target="_blank" rel="noopener" aria-describedby="yfKeepSt">
        <span class="stdisc" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 3h11l4 4v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M7 3v5h8V3M7 21v-7h10v7"/></svg></span>
        <span class="stkcap"><b>Keep your work</b><small id="yfKeepSt">Saved in this browser. Six words keep it on every device: no email, no account.</small></span>
      </a>
      <p class="stsub">Where the cards sit, per tree. Never the file itself.</p>
    </section>

    <section class="yfsec" aria-labelledby="yfFilesT">
      <h2 id="yfFilesT">Files and canvases on this device</h2>
      <div id="yfRecent" hidden>
        <ul id="yfList"></ul>
        <p class="stsub">Kept in this browser only. A view keeps only where the cards sit, never the file. <button type="button" class="stlink" id="yfForget">Forget the kept files</button></p>
      </div>
      <p class="stsub" id="yfNoFiles" hidden>Nothing is kept on this device yet.</p>
    </section>

    <section class="yfsec" id="yfExp" aria-labelledby="yfExpT">
      <h2 id="yfExpT">Export your GEDCOM, improved</h2>
      <div id="yfExpOn">
        <p class="stsub">Your own file, line for line, with only the changes you choose. Nothing is dropped or rewritten without being listed in a change log, and nothing leaves this page: the new file is made here and saved by your browser.</p>
        <fieldset id="yfMode" class="yfmodes">
          <legend>What to change</legend>
          <label><input type="radio" name="yfxm" value="enriched" checked> <span><b>Enriched</b> · adds coordinates and an Atlas id under each place that was matched exactly. No existing line is changed. The safest choice.</span></label>
          <label><input type="radio" name="yfxm" value="shareable"> <span><b>Shareable</b> · as enriched, and living people are reduced to a bare “Living” record, their family events removed, so you can send it to a relative. Read the change log: a living person named in a way we cannot recognise stays.</span></label>
          <label><input type="radio" name="yfxm" value="faithful"> <span><b>No changes</b> · your file again, as it was.</span></label>
        </fieldset>
        <p><button type="button" class="stbtn primary" id="yfGo">Make the file</button> <span id="yfBusy" class="stsub" hidden>Working…</span></p>
        <div id="yfOut" hidden>
          <p id="yfSum" class="stmsg" role="status"></p>
          <p class="yfdl"><a id="yfFile" class="stbtn" download>Download the GEDCOM</a> <a id="yfLog" download>Download the change log</a></p>
        </div>
      </div>
      <p class="stsub" id="yfExpOff" hidden></p>
    </section>
  </div>
</main>
<main id="fx" hidden aria-labelledby="fxTitle">
  <div class="fxwrap">
    <header class="fxhead">
      <button type="button" class="stbtn" id="fx-back">← Back to the canvas</button>
      <h1 id="fxTitle" tabindex="-1">Fix list</h1>
      <div class="fxtabs" role="tablist" aria-label="Which list">
        <button type="button" role="tab" class="fxtab" id="fxt-people" aria-selected="true" aria-controls="fxpane-people">People <span class="fxtn" id="fxt-people-n" hidden></span></button>
        <button type="button" role="tab" class="fxtab" id="fxt-places" aria-selected="false" aria-controls="fxpane-places" tabindex="-1">Places <span class="fxtn" id="fxt-places-n" hidden></span></button>
        <button type="button" role="tab" class="fxtab" id="fxt-orphans" aria-selected="false" aria-controls="fxpane-orphans" tabindex="-1">Orphans <span class="fxtn" id="fxt-orphans-n" hidden></span></button>
      </div>
    </header>

    <section class="fxkeep" id="fx-keep" aria-label="Keeping your decisions">
      <label class="fxck"><input type="checkbox" id="fx-keepon"><span><b>Remember my decisions on this device</b></span></label>
      <p class="stsub fxsaved" id="fx-saved" role="status"></p>
      <div class="fxbtns">
        <button type="button" class="stbtn" id="fx-save">Save decisions to a file</button><button type="button" class="stbtn" id="fx-load">Load decisions from a file</button><button type="button" class="stbtn" id="fx-forget">Forget them</button>
        <span class="fxbtns fxpeople-only"><button type="button" class="stbtn" id="fx-txt">Text</button><button type="button" class="stbtn" id="fx-csv">Spreadsheet</button><button type="button" class="stbtn" id="fx-pdf">PDF</button></span>
        <input type="file" id="fx-file" accept=".json,application/json" hidden>
      </div>
    </section>

    <div id="fxpane-people" class="fxpane" role="tabpanel" aria-labelledby="fxt-people">
      <header class="fxhead">
        <p class="stsub" id="fx-sub"></p>
        <div class="fxprog"><div class="fxbar" id="fx-bar" role="progressbar" aria-label="Fix list progress" aria-valuemin="0" aria-valuemax="100"><i></i></div><span id="fx-prog" role="status"></span></div>
        <p class="stsub" id="fx-hint" hidden>Names are plain text for now. Add your MyHeritage tree link in <button type="button" class="stlink" id="fx-settings">Settings</button> and each person in your file becomes a link to their profile.</p>
        <p class="stsub" id="fx-living" hidden><span></span> <button type="button" class="stlink" id="fx-living-set">Change this in Settings</button></p>
      </header>

      <section class="fxtools" aria-label="Filter the fix list">
        <label class="fxf"><span>Research name</span><select id="fx-name" aria-describedby="fx-names"><option value="">Pick a name or an archive…</option></select></label>
        <label class="fxf fxq"><span>Search by name</span><input type="search" id="fx-q" autocomplete="off" spellcheck="false" placeholder="a name, a place, a reason"></label>
        <label class="fxf"><span>Show</span><select id="fx-mode"><option value="open">Still to do</option><option value="done">Done</option><option value="asis">Left as is</option><option value="all">Everything</option></select></label>
        <label class="fxf"><span>Group</span><select id="fx-grp"><option value="">Every group</option></select></label>
        <label class="fxf"><span>Order</span><select id="fx-order"></select></label>
        <label class="fxf"><span>Rows</span><select id="fx-rows"></select></label>
        <div class="fxbtns"><button type="button" class="stbtn" id="fx-expand">Open all sections</button><button type="button" class="stbtn" id="fx-collapse">Close all</button></div>
        <label class="fxck"><input type="checkbox" id="fx-fold"><span>Fold the Atlas notes</span></label>
        <p class="fxnames" id="fx-names" role="status" hidden></p>
        <p class="fxwho" id="fx-who" hidden><span></span> <button type="button" class="stlink" id="fx-whoX">Show everyone</button></p>
      </section>

      <p class="stsub" id="fx-empty" hidden>Nothing to fix: the reader found nothing in this file that needs a correction.</p>
      <div id="fx-body"></div>
    </div>
    <div id="fxpane-places" class="fxpane" role="tabpanel" aria-labelledby="fxt-places" hidden></div>
    <div id="fxpane-orphans" class="fxpane" role="tabpanel" aria-labelledby="fxt-orphans" hidden></div>
  </div>
</main>
<aside id="sg" hidden role="dialog" aria-modal="true" aria-labelledby="sgTitle">
  <div class="sgback" id="sgBack"></div>
  <div class="sgpanel">
    <header class="sghead">
      <h2 id="sgTitle" tabindex="-1">Settings</h2>
      <button type="button" class="stbtn primary" id="sgClose">Done</button>
    </header>

    <section class="sgsec" aria-labelledby="sgLayT">
      <h3 id="sgLayT">Layout</h3>
      <div class="sglks" role="group" aria-labelledby="sgLayT">
        <button type="button" class="sglk" data-sglook="tree" aria-pressed="false" title="The family tree as cards, in the colour look chosen with the ◐ button"><svg viewBox="0 0 48 36" aria-hidden="true" focusable="false"><rect x="17" y="3" width="14" height="7" rx="2"/><rect x="4" y="26" width="14" height="7" rx="2"/><rect x="30" y="26" width="14" height="7" rx="2"/><path d="M24 10v7M11 26v-9h26v9" fill="none"/></svg><span>Tree</span></button>
        <button type="button" class="sglk" data-sglook="lanes" aria-pressed="false" title="One lane for each generation"><svg viewBox="0 0 48 36" aria-hidden="true" focusable="false"><rect x="4" y="3" width="40" height="8" rx="2" fill="none"/><rect x="4" y="14" width="40" height="8" rx="2" fill="none"/><rect x="4" y="25" width="40" height="8" rx="2" fill="none"/><circle cx="14" cy="7" r="2.2"/><circle cx="26" cy="18" r="2.2"/><circle cx="36" cy="29" r="2.2"/></svg><span>Lanes</span></button>
        <button type="button" class="sglk" data-sglook="countries" aria-pressed="false" title="One column for each country of birth, with its flag"><svg viewBox="0 0 48 36" aria-hidden="true" focusable="false"><rect x="3" y="3" width="12" height="30" rx="2" fill="none"/><rect x="18" y="3" width="12" height="30" rx="2" fill="none"/><rect x="33" y="3" width="12" height="30" rx="2" fill="none"/><circle cx="9" cy="11" r="2.2"/><circle cx="24" cy="21" r="2.2"/><circle cx="39" cy="14" r="2.2"/></svg><span>Countries</span></button>
        <button type="button" class="sglk" data-sglook="names" aria-pressed="false" title="Surnames as cards, in rings around yours"><svg viewBox="0 0 48 36" aria-hidden="true" focusable="false"><circle cx="24" cy="18" r="15" fill="none"/><circle cx="24" cy="18" r="7" fill="none"/><circle cx="24" cy="18" r="2.2"/><circle cx="24" cy="3" r="2.2"/><circle cx="37" cy="25" r="2.2"/><circle cx="11" cy="25" r="2.2"/></svg><span>Names</span></button>
      </div>
      <p class="stsub" id="sgLayNote">Pick how the tree is laid out. The colours (Sticker, Paper, Ground) are chosen with the ◐ button on the canvas, or below.</p>
    </section>

    <section class="sgsec" aria-labelledby="sgLivT">
      <h3 id="sgLivT">Living people</h3>
      <label class="sgsw"><input type="checkbox" id="sgLiv"><span><b>Hide the names of people who may be alive</b><small>When a GEDCOM is read, anyone who may be alive is drawn without a name and with a birth year rounded to the decade. They stay in the tree so it stays connected.</small></span></label>
      <p class="stsub" id="sgLivNote" role="status"></p>
      <details class="sgwhat"><summary>What “living” means here</summary>
        <p>A person counts as possibly living when the file records no death or burial for them and either gives no birth year or a birth within the last 110 years. That is the same rule as Roots &amp; Routes, and it errs towards treating someone as alive.</p>
        <p>The “Shareable” export hides living people whatever this is set to. A family archive’s published tree already leaves them out, and a tree.json already shows them by family and relationship only.</p>
        <p>If you have not chosen, they are shown as your file gives them, as before: your file is read in this browser and never uploaded.</p>
      </details>
    </section>

    <section class="sgsec" aria-labelledby="sgLinkT">
      <h3 id="sgLinkT">Links back to your tree</h3>
      <p class="stsub">Paste a profile or tree link for any one person from your MyHeritage tree. Everyone in this file then gets an “Open on MyHeritage” button. Nothing is sent.</p>
      <label class="sglab" for="sgMh">MyHeritage link</label>
      <input type="text" id="sgMh" class="sginput" autocomplete="off" spellcheck="false" placeholder="https://www.myheritage.com/profile-…">
      <p class="stsub" id="sgMhSt" role="status"></p>
      <label class="sglab" for="sgAnc">Ancestry site</label>
      <select id="sgAnc" class="sginput"><option value="com.au">ancestry.com.au</option><option value="com">ancestry.com</option><option value="co.uk">ancestry.co.uk</option><option value="ca">ancestry.ca</option></select>
      <p class="stsub" id="sgAncSt"></p>
    </section>

    <section class="sgsec" aria-labelledby="sgLookT">
      <h3 id="sgLookT">Look of the canvas</h3>
      <label class="sglab" for="sgLook">Look</label>
      <select id="sgLook" class="sginput">
        <option value="auto">Automatic: light or dark to suit this device</option>
        <option value="sticker">Sticker</option><option value="paper">Paper</option><option value="ground">Ground (dark)</option>
        <option value="lanes">Lanes</option><option value="countries">Countries</option><option value="names">Names</option>
      </select>
    </section>

    <section class="sgsec" aria-labelledby="sgFilesT">
      <h3 id="sgFilesT">Files on this device</h3>
      <label class="sgsw"><input type="checkbox" id="sgRem"><span><b>Keep the last 3 files on this device</b><small>In this browser only, so they open again in one click. Unticking forgets the ones kept now.</small></span></label>
    </section>

    <p class="stsub" id="sgStore" role="status"></p>
    <p class="stsub" id="sgSync"></p>
  </div>
</aside>
<p id="msg" role="status" aria-live="polite" hidden></p>
<div id="keepNote" class="knote" role="status" aria-live="polite" hidden><span id="knText"></span><span id="knBtns"></span><button type="button" id="knX" class="knx" aria-label="Dismiss">×</button></div>
<noscript><p class="nojs">The Tree Canvas needs JavaScript to read your file in this browser. Nothing is uploaded. <a href="/">Back to Record Atlas</a></p></noscript>
<script is:inline src="/js/load-tree.js"></script>
<script is:inline src="/js/conn.js"></script>
<script is:inline src="/tree-canvas/app.js" type="module"></script>
</body>
</html>
