---
/* /v2/ WAS THE TRIAL ADDRESS OF THE FRONT DOOR, which is now the home page. Links and shared views made while it was a trial still land here, so
   this page sends them on to the home page with their address parameters (?q=, ?at=, #...) intact. A script does it because a static
   redirect cannot carry the query; the meta refresh is for a browser that has no script. */
import { u } from "../lib/url.js";
const home = u("/");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Record Atlas</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href="https://recordatlas.org/" />
  <meta http-equiv="refresh" content={"0; url=" + home} />
  <script is:inline define:vars={{ home }}>location.replace(home + location.search + location.hash);</script>
</head>
<body><p><a href={home}>Record Atlas</a></p></body>
</html>
