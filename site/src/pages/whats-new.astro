---
/* EVERYTHING THAT HAS GOT BETTER, in the words a visitor would use.
 *
 * The home page shows the latest five of these. This is the whole list, from
 * src/data/whats-new.json, which is written by hand when a change a reader can
 * see goes live. /changelog/ is the other list: generated from git, it records
 * what a developer did, and is a different question.
 *
 * Each entry has a kind (new | better | fixed) which becomes the small badge, so
 * a reader can skim for "a new source" without reading every line. David asked
 * for this page to be «more welcoming, fun, neater»: a greeting instead of a
 * label, a timeline instead of a bare list, a badge instead of nothing.
 */
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import data from "../data/whats-new.json";
import site from "../data/site.json";
import provs from "../../public/providers.json";
import sessions from "../../public/research-sessions.json";
import { researchNews } from "../lib/research-news.js";
import { namesNews } from "../lib/names-news.js";

const KINDS = {
  new:    { label: "New",    glyph: "✦" },
  better: { label: "Better", glyph: "↑" },
  fixed:  { label: "Fixed",  glyph: "✓" },
  research: { label: "Research", glyph: "⚑" },
};
/* NEW SOURCES WRITE THEIR OWN LINE. A source added to the directory is the most common thing that happens here and the one
   nobody remembered to announce, so each day the directory grew becomes a «research» entry (data gained; «new» is for what a reader can now do), built from the arrival dates
   (data/provider-added.json, via providers.json). A small day names its sources; a big one says how many and where, and
   links to that day's list on /providers/. Only days since this page began are used: the first import is not news. */
const firstDay = data.entries.reduce((m, e) => (e.date < m ? e.date : m), "9999");
const arrivals = {};
for (const p of provs.providers) if (p.added && p.added >= firstDay) (arrivals[p.added] = arrivals[p.added] || []).push(p);
let regionName = (c) => c;
try { const dn = new Intl.DisplayNames(["en"], { type: "region" }); regionName = (c) => { try { return c === "*" ? "worldwide" : (dn.of(c) || c); } catch (e) { return c; } }; } catch (e) { /* codes shown */ }
const sourceEntries = Object.entries(arrivals).map(([date, list]) => {
  list.sort((a, b) => a.name.localeCompare(b.name));
  const short = (n) => n.replace(/\s*\(.*$/, "");
  let headline;
  if (list.length <= 4) {
    headline = `New ${list.length === 1 ? "source" : "sources"}: ${list.map((p) => short(p.name)).join("; ")}`;
  } else {
    const mix = {};
    for (const p of list) for (const c of p.countries) mix[c] = (mix[c] || 0) + 1;
    const top = Object.entries(mix).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([c]) => regionName(c));
    headline = `${list.length.toLocaleString("en")} new sources added to the directory, mostly ${top.join(", ")}`;
  }
  if (headline.length > 150) headline = headline.slice(0, 147).replace(/[;,]?\s*\S*$/, "") + "…";
  return { date, kind: "research", src: true, headline, href: `/providers/?d=${date}` };
});
/* sources first within their day: they were at the bottom of a long day and nobody scrolled to them */
/* THE FAMILY ARCHIVES' WORK, A DAY AT A TIME, from the published research sessions (never a note: see lib/research-news.js) */
const rn = researchNews(sessions);
/* NEW SPELLINGS, GIVEN-NAME FORMS AND DATED PLACE NAMES, from the dates the catalogues stamp on what is added (lib/names-news.js) */
const nn = namesNews();
const entries = sourceEntries.concat(rn.entries, nn, data.entries).sort((a, b) => b.date.localeCompare(a.date));
const byDay = {};
for (const e of entries) (byDay[e.date] = byDay[e.date] || []).push(e);
const days = Object.entries(byDay).sort((a, b) => b[0].localeCompare(a[0]));
const dt = (d) => new Date(d + "T00:00:00Z");
const part = (d, o) => dt(d).toLocaleDateString("en-GB", { ...o, timeZone: "UTC" });
const long = (d) => part(d, { day: "numeric", month: "long", year: "numeric" });
const count = (k) => entries.filter((e) => e.kind === k).length;
const email = site.contact && site.contact.email;
---
<Base
  title="What's new"
  eyebrow="Fresh from the workbench"
  dek="Thanks for stopping by. Here is what I have been tinkering with lately: new sources, fixes, and small things that make the atlas nicer to use. Newest first."
  description="Recent improvements to Record Atlas: new sources, new pages and fixes, newest first.">

  <p class="tally" aria-label="Summary and filters">
    <span><b>{entries.length}</b> things since {part(days[days.length - 1][0], { day: "numeric", month: "long" })}</span>
    {["new", "better", "fixed", "research"].map((k) => count(k) > 0 && (
      <button type="button" class={`chip ${k}`} data-f={k} aria-pressed="false"><i aria-hidden="true">{KINDS[k].glyph}</i> {count(k)} {KINDS[k].label.toLowerCase()}</button>
    ))}
    {sourceEntries.length > 0 && (
      <button type="button" class="chip src" data-f="src" aria-pressed="false" title="The days the sources directory grew"><i aria-hidden="true">▤</i> {sourceEntries.length} sources</button>
    )}
    <button type="button" class="clear" id="wn-clear" hidden>Show everything</button>
  </p>

  {rn.families.length > 0 && (
    <details class="rpanel" id="research">
      <summary>
        <b>Where the family research has been</b>
        <span>{rn.totals.families} families · {rn.totals.places} places · {rn.totals.books.toLocaleString("en")} books · {rn.totals.pages.toLocaleString("en")} pages · {rn.totals.sources} sources</span>
      </summary>
      <p class="cap">Published from the family archives: a surname, the places worked, how many books and pages were read, and which sources were used. No names of people, no notes, and nothing here is a finding. Each place links to its page and its marker on the map.</p>
      <ul class="rfam">
        {rn.families.map((f) => (
          <li>
            <b>{f.name}</b>
            <span class="rn">{f.books} book{f.books === 1 ? "" : "s"}{f.pages ? `, ${f.pages.toLocaleString("en")} pages` : ""}</span>
            <span class="rp">{f.places.length ? f.places.map((p, i) => (<>{i > 0 && ", "}{p.known ? <a href={u("/place/" + p.id + "/")}>{p.name}</a> : p.name}</>)) : "no place yet"}</span>
            <span class="rs">Used: {f.sources.join(", ")}</span>
          </li>
        ))}
      </ul>
    </details>
  )}

  <ol class="line">
    {days.map(([day, es]) => (
      <li class="day">
        <time class="when" datetime={day} title={long(day)}>
          <b>{part(day, { day: "numeric" })}</b>
          <span>{part(day, { month: "short" })}</span>
          <em>{part(day, { year: "numeric" })}</em>
        </time>
        <ul class="items">
          {es.map((e) => {
            const k = KINDS[e.kind] || KINDS.better;
            return (
              <li class="item" data-kind={e.kind || "better"} data-src={e.src ? "1" : undefined}>
                <span class={`chip ${e.kind || "better"}`}><i aria-hidden="true">{k.glyph}</i> {k.label}</span>
                {e.detail
                  ? (
                    <details class="rday">
                      <summary class="head">{e.headline}{(() => {
                        /* «2 of 3 found something»: of the rows that ended in an outcome (found, or searched with nothing found) */
                        const all = e.detail.flatMap((g) => g.rows), ended = all.filter((r) => r.state === "found" || r.state === "searched"), hit = ended.filter((r) => r.state === "found").length;
                        return ended.length ? <span class="rtally"> · {hit} of {ended.length} found something</span> : null;
                      })()}</summary>
                      {e.detail.map((g) => {
                        const hit = g.rows.filter((r) => r.state === "found").length, nil = g.rows.filter((r) => r.state === "searched").length;
                        const SHOW = 10, first = g.rows.slice(0, SHOW), rest = g.rows.slice(SHOW);
                        const rowEl = (r) => (
                          <div class="xrow">
                            <div class="xt">
                              {r.kind === "book" && r.place && r.place.known
                                ? <a href={u("/place/" + r.placeId + "/")}>{r.title}</a>
                                : r.href ? <a href={r.href} rel="noopener">{r.kind === "book" ? r.title : (r.title || r.source)}</a> : r.title}
                              {r.kind === "book" && r.place ? <span class="xw">{r.place.name}</span> : null}
                              {r.kind !== "book" && r.source && r.title && r.title !== r.source ? <span class="xw">{r.source}</span> : null}
                              {r.where ? <span class="xw">{r.where}</span> : null}
                            </div>
                            <div class="xp">{r.state ? <span class={`xs xs-${r.state}`}>{({ found: "\u2705 Found something", searched: "\u274C Nothing found", planned: "Planned", written: "Written, no reply", exhausted: "Read everything", blocked: "No access" })[r.state] || r.state}</span> : null}</div>
                            <div class="xn">{r.kind === "book" && r.pages ? `${r.pages.toLocaleString("en")} page${r.pages === 1 ? "" : "s"}` : ""}</div>
                          </div>
                        );
                        return (
                          <details class="xf" open={g.rows.length <= 12}>
                            <summary><b>{g.family}</b><span class="xfs">{g.rows.length} {g.rows.length === 1 ? "entry" : "entries"}{hit ? ` · ${hit} found something` : ""}{nil ? ` · ${nil} nothing found` : ""}</span></summary>
                            <div class="xrows">
                              {first.map(rowEl)}
                              {rest.length ? (
                                <details class="xmore"><summary>Show the other {rest.length}</summary>{rest.map(rowEl)}</details>
                              ) : null}
                            </div>
                          </details>
                        );
                      })}
                      <p class="rfoot">Recorded by the research sessions themselves. Nothing here is checked by the atlas.</p>
                    </details>
                  )
                  : e.href
                  ? <a class="head" href={u(e.href) + (e.spot ? "?spot=" + encodeURIComponent(e.spot) + (e.tip ? "&tip=" + encodeURIComponent(e.tip) : "") : "")}>{e.headline}<span class="go" aria-hidden="true"> →</span></a>
                  : <span class="head">{e.headline}</span>}
              </li>
            );
          })}
        </ul>
      </li>
    ))}
  </ol>

  <script is:inline>
    (function () {
      var pills = [].slice.call(document.querySelectorAll(".tally [data-f]")), clear = document.getElementById("wn-clear");
      var items = [].slice.call(document.querySelectorAll(".item")), daysEl = [].slice.call(document.querySelectorAll(".day"));
      var on = null;
      function apply() {
        items.forEach(function (i) {
          i.hidden = !!on && !(on === "src" ? i.getAttribute("data-src") === "1" : i.getAttribute("data-kind") === on);
        });
        daysEl.forEach(function (d) { d.hidden = !d.querySelector(".item:not([hidden])"); });
        pills.forEach(function (p) { p.setAttribute("aria-pressed", p.getAttribute("data-f") === on ? "true" : "false"); });
        clear.hidden = !on;
      }
      pills.forEach(function (p) { p.addEventListener("click", function () { var f = p.getAttribute("data-f"); on = on === f ? null : f; apply(); }); });
      clear.addEventListener("click", function () { on = null; apply(); });
      if (location.hash === "#sources") { on = "src"; apply(); }
    })();
  </script>

  <aside class="foot">
    <p class="warm">
      {email ? (
        <>Like my work? Have a suggestion? <a href={`mailto:${email}?subject=${encodeURIComponent("Record Atlas: a note")}`}>Drop me a note.</a> It is read by a person.</>
      ) : (
        <>Like my work? Have a suggestion? Tell me, and it may end up on this page.</>
      )}
    </p>
    <p class="cap">Want the developer's view, one entry per commit? That is <a href={u("/changelog/")}>What changed</a>.</p>
  </aside>
</Base>

<style>
  .tally { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 0 0 26px;
           font-size: 14px; color: var(--ink-2); }
  .tally b { color: var(--ink); }

  .chip { display: inline-flex; align-items: center; gap: 5px; font-family: var(--mono);
          font-size: 11px; letter-spacing: .06em; text-transform: uppercase; line-height: 1;
          padding: 4px 8px 4px 7px; border-radius: 999px; border: 1px solid var(--rule-strong);
          color: var(--ink-2); background: var(--panel, transparent); white-space: nowrap; }
  .chip i { font-style: normal; font-size: 12px; }
  .chip.new { color: var(--accent); border-color: var(--accent); background: var(--accent-wash); }
  .chip.fixed { color: var(--ink); }
  .chip.src { color: var(--ink); }
  .chip.research { color: #1E6B3C; border-color: #1E6B3C; }
  .rday { min-width: 0; flex: 1; } .rday summary { cursor: pointer; }
  .xf { margin: 10px 0 0; font-family: var(--sans); border-top: 1px solid var(--rule); }
  .xf > summary { list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; padding: 9px 0 6px; font-size: 14.5px; }
  .xf > summary::-webkit-details-marker { display: none; }
  .xf > summary::before { content: "\25B8"; color: var(--ink-3); width: 1em; flex: none; }
  .xf[open] > summary::before { content: "\25BE"; }
  .xf > summary b { font-weight: 700; color: var(--ink); }
  .xfs { font-size: 12.5px; color: var(--ink-3); }
  .xrows { padding: 0 0 6px 1em; }
  .xrow { display: grid; grid-template-columns: minmax(0, 1fr) 10.5rem 5.5rem; gap: 2px 12px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--rule); font-size: 14px; }
  .xrow:first-child { border-top: 0; }
  .xt { min-width: 0; overflow-wrap: anywhere; font-weight: 600; }
  .xt a { color: var(--accent); text-decoration: none; } .xt a:hover { text-decoration: underline; }
  .xw { display: inline; margin-left: 8px; font-weight: 400; font-size: 12.5px; color: var(--ink-3); }
  .xn { font-size: 12.5px; color: var(--ink-2); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .xs { display: inline-block; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--rule); font-size: 11.5px; font-weight: 600; color: var(--ink); white-space: nowrap; }
  .xs-found { background: rgba(31, 157, 85, .14); border-color: rgba(31, 157, 85, .5); }
  .xs-searched { background: var(--accent-wash, rgba(31, 92, 107, .1)); border-color: var(--accent); }
  .xs-blocked { background: rgba(192, 57, 43, .12); border-color: rgba(192, 57, 43, .5); }
  .xmore { margin: 0; border-top: 1px solid var(--rule); }
  .xmore > summary { cursor: pointer; padding: 7px 0; font-size: 13px; color: var(--accent); }
  .xfoot { margin: 8px 0 0; font: 12.5px var(--sans); color: var(--ink-3); }
  @media (max-width: 640px) { .xrow { grid-template-columns: minmax(0, 1fr) auto; } .xp { grid-column: 1; } .xn { grid-column: 2; grid-row: 2; } }
  .rtally { font: 500 13px var(--sans); color: var(--ink-2); white-space: nowrap; }
  .rpanel { margin: 0 0 24px; padding: 14px 18px; border: 1px solid var(--rule); border-radius: 10px; background: var(--panel, transparent); }
  .rpanel summary { cursor: pointer; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; font-family: var(--serif); font-size: 17px; }
  .rpanel summary span { font: 13px var(--sans); color: var(--ink-2); }
  .rfam { list-style: none; margin: 12px 0 0; padding: 0 8px 0 0; display: grid; gap: 0; max-height: 26rem; overflow-y: auto; }
  .rfam li { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 2px 14px; padding: 9px 0; border-top: 1px solid var(--rule); font: 14px/1.45 var(--sans); }
  .rfam .rn { color: var(--ink-2); grid-column: 1; }
  .rfam .rp { grid-column: 2; grid-row: 1 / span 2; }
  .rfam .rs { grid-column: 1 / -1; color: var(--ink-2); font-size: 12.5px; }
  @media (max-width: 640px) { .rfam li { grid-template-columns: 1fr; } .rfam .rp { grid-column: 1; grid-row: auto; } }

  button.chip { cursor: pointer; font: inherit; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; }
  button.chip:hover { border-color: var(--accent); }
  button.chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .clear { background: none; border: 0; padding: 0; font: 13px var(--sans); color: var(--accent); text-decoration: underline; cursor: pointer; }
  .item[hidden], .day[hidden], .clear[hidden] { display: none !important; }

  /* The timeline: a rule down the left, a date on it, a card per change. */
  .line { list-style: none; margin: 0; padding: 0; position: relative; }
  .line::before { content: ""; position: absolute; left: 41px; top: 6px; bottom: 6px;
                  width: 2px; background: var(--rule); }
  .day { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 0 18px; padding-bottom: 22px; }
  .when { position: relative; display: flex; flex-direction: column; align-items: center;
          line-height: 1.05; padding-top: 2px; background: var(--ground, var(--bg, transparent)); align-self: start; }
  .when b { font-family: var(--serif); font-size: 30px; font-weight: 700; color: var(--ink); }
  .when span { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-top: 2px; }
  .when em { font-style: normal; font-family: var(--mono); font-size: 11px; color: var(--ink-3); margin-top: 2px; }

  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .item { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px;
          background: var(--panel, transparent); border: 1px solid var(--rule); border-radius: 10px;
          transition: border-color .15s, transform .15s; }
  .item:hover { border-color: var(--accent); transform: translateX(2px); }
  .item .chip { flex: none; margin-top: 3px; min-width: 76px; justify-content: center; }
  .head { font-family: var(--serif); font-size: 17px; line-height: 1.45; color: var(--ink);
          text-decoration: none; max-width:var(--measure); }
  a.head { color: var(--ink); }
  a.head:hover { color: var(--accent); }
  .go { color: var(--accent); white-space: nowrap; }

  .foot { margin-top: 10px; padding: 18px 20px; border-radius: 12px; background: var(--accent-wash);
          border: 1px solid var(--rule); max-width:var(--measure); }
  .warm { margin: 0 0 6px; font-family: var(--serif); font-size: 18px; line-height: 1.45; color: var(--ink); }
  .foot .cap { margin: 0; }

  @media (prefers-reduced-motion: reduce) { .item { transition: none; } .item:hover { transform: none; } }

  @media (max-width: 640px) {
    .line::before { display: none; }
    .day { grid-template-columns: 1fr; gap: 8px; }
    .when { flex-direction: row; align-items: baseline; gap: 6px; padding: 0; }
    .when b { font-size: 22px; }
    .when em { margin: 0; }
    .item { flex-direction: column; gap: 8px; }
    .item .chip { margin-top: 0; }
  }
</style>
