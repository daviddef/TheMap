---
import Base from "../layouts/Base.astro";
import WorkList from "@daviddef/archive-kit/components/WorkList.astro";
import { u } from "../lib/url.js";
import work from "../data/worklist.json";
import archives from "../data/archive-worklists.json";
import "../styles/kit.css";

/* The estate keeps one work list per archive, in one shape, at one path, and
   this atlas was one of two projects with none — so its state lived in
   notes/ that nothing reads and in commit messages nobody greps. The
   component and the checker were already installed; this is wiring. */
const open = work.rows.filter((r) => ["running", "next", "blocked"].includes(r.state)).length;
const waiting = work.rows.filter((r) => r.state === "blocked").length;
const fam = archives.archives;
const famOpen = fam.reduce((a, x) => a + x.open, 0);
const asOf = new Date(archives.exported + "T00:00:00Z")
  .toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Base noindex title="Work list"
      eyebrow={`${open} open · ${waiting} waiting on someone else`}
      dek="What is being done to the Atlas itself. Each family archive keeps its own list, counted below.">

  <div class="k-bar" id="archives"><h2>Family archives</h2><span class="k-count">{fam.length} · counts as of {asOf}</span></div>
  <ul class="k-grid wl-fam">
    {fam.map((a) => (
      <li>
        <a href={a.url} class="k-card is-link">
          <h3>{a.name}</h3>
          <p class="wl-n"><b>{a.open}</b> open</p>
          <span class="k-pills">
            {a.counts.running > 0 && <span class="k-pill">{a.counts.running} running</span>}
            <span class="k-pill is-plain">{a.counts.next} next</span>
            {a.counts.blocked > 0 && <span class="k-pill is-plain">{a.counts.blocked} blocked</span>}
            <span class="k-pill is-plain">{a.counts.done} done</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="cap">Open means running, next or blocked. Each archive's own page is the live one, so a count here can lag it.</p>

  <div class="k-bar"><h2>The Atlas's own list</h2><span class="k-count">{open} open</span></div>

  <WorkList work={work} u={u} />

  <p class="cap" style="margin-top:26px">What is known lives on
  <a href={u("/")}>the map</a>, <a href={u("/countries/")}>Countries</a>,
  <a href={u("/coverage/")}>Gaps</a> and
  <a href={u("/changelog/")}>What changed</a>.</p>
</Base>

<style is:global>
  .wl-fam .k-card { gap: 8px; }
  .wl-n { font-size: 14px; color: var(--ink-2); }
  .wl-n b { font: 800 34px/1 var(--serif); color: var(--ink); margin-right: 4px; }
  .wl-fam .k-pills { gap: 6px; }
  .wl-fam .k-pill { font-size: 11.5px; padding: 3px 9px; }
</style>
