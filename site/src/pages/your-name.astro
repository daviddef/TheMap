---
/* SAY YOUR NAME: a given name or a surname, across languages and clerks, on one page with a switch.
 *
 * Read from public/given-names.json, which scripts/build-given-names.py makes from data/given-name-families.json, the one
 * catalogue (written only through scripts/given_name_variants.py). The family archives that used to keep a table of their
 * own (Defranceski, Blažević) read this file now, so a name looked up here and on a family site shows the same forms.
 */
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import SayYourName from "../components/SayYourName.astro";
import SayYourSurname from "../components/SayYourSurname.astro";
import SayYourFullName from "../components/SayYourFullName.astro";
import SmartFind from "../components/SmartFind.astro";
import { allFamilies } from "../lib/surname-families.js";
import { u } from "../lib/url.js";

const file = [path.join(process.cwd(), "public", "given-names.json"), path.join(process.cwd(), "site", "public", "given-names.json")]
  .find((p) => fs.existsSync(p));
const data = JSON.parse(fs.readFileSync(file, "utf8"));
const nFam = allFamilies().length;
const surChips = ["Defranceschi", "Lerena", "Blažević", "Kosina"];
const fullChips = ["Ivan Blažević", "Katarina Marija Kosina", "Giuseppe De Franceschi"];
const chips = ["Ivan", "Giuseppe", "Antonio", "Franciscus", "Matija", "Katarina", "Zdravko", "Maria"];
---
<Base
  title="Say your name"
  eyebrow={`${data.rows.length} given names · ${data.totalForms} forms · ${nFam} surname families`}
  dek="Type a name, or your whole name. See every way a clerk wrote it."
  description="Given names and surnames across languages: the Latin of the register, the Italian, Venetian, Croatian, German, Hungarian and English forms, which spellings are one name, and which of them a record has actually shown. Free to use, nothing you type leaves your browser."
>
  <section class="yn-find">
    <SayYourFullName chips={fullChips} />
  </section>

  <ul class="k-grid yn-why">
    <li class="k-card" style="--c:var(--h-teal)"><span class="k-ico" aria-hidden="true">🗣️</span><h3>Every language</h3>
      <p>Ivan, Johann, Giovanni, Zuane, John and Joannes are one name.</p></li>
    <li class="k-card" style="--c:var(--h-terra)"><span class="k-ico" aria-hidden="true">✍️</span><h3>Every spelling</h3>
      <p>The clerk spelt it, not the family: Defranceschi is De Franceschi.</p></li>
    <li class="k-card" style="--c:var(--h-gold)"><span class="k-ico" aria-hidden="true">🔒</span><h3>Yours alone</h3>
      <p>The lookup runs in your browser. Nothing you type is sent.</p></li>
  </ul>

  <div class="k-bar"><h2>Browse instead</h2></div>
  <ul class="k-grid yn-go">
    <li><a class="k-card is-link" style="--c:var(--h-teal)" href={u("/name/")}><h3>Given names, A to Z</h3><p>{data.rows.length} names, each with a page of its own.</p></a></li>
    <li><a class="k-card is-link" style="--c:var(--h-terra)" href={u("/surname-families/")}><h3>Surname spellings</h3><p>{nFam} families, with the evidence for each form.</p></a></li>
    <li><a class="k-card is-link" style="--c:var(--h-gold)" href={u("/story/")}><h3>Stories of names</h3><p>How names changed on the way, with sources.</p></a></li>
    <li><a class="k-card is-link" style="--c:var(--h-green)" href={u("/surnames/")}><h3>The data</h3><p>Free to reuse: given-names.json and the surname files.</p></a></li>
  </ul>

  <details id="yn-one" class="yn-more">
    <summary><span class="k-pill">More ways to look</span> One name at a time, and where a surname is found</summary>
    <div class="ynsw" role="tablist" aria-label="What are you looking up?">
      <button type="button" role="tab" id="yn-tab-given" aria-controls="yn-given" aria-selected="true">Given name</button>
      <button type="button" role="tab" id="yn-tab-sur" aria-controls="yn-sur" aria-selected="false">Surname</button>
    </div>

    <div id="yn-given" role="tabpanel" aria-labelledby="yn-tab-given">
      <SayYourName rows={data.rows} langs={data.languages} chips={chips} u={u} nameHref={u("/name/{id}/")} />
      <p class="cap">A form marked <sup>°</sup> is the right form in that language and a thing to search, never yet seen on a record. A slip, written once by mistake, is listed apart and is not a spelling.</p>
    </div>

    <div id="yn-sur" role="tabpanel" aria-labelledby="yn-tab-sur">
      <SayYourSurname u={u} chips={surChips} />
      <p class="cap">Case, spacing, hyphens and apostrophes are never counted as spellings; an accent is, because a priest's Lereña is not a clerk's Lerena.</p>
      <h3 class="yn-h">Where is a surname found?</h3>
      <SmartFind base={u("/")}
                 placesIndex={u("/index.json")} quietIndex={u("/index-quiet.json")}
                 surnameShards={u("/s/")} gazShards={u("/g/")}
                 label="Find a surname, a country or a place"
                 hint="A surname, a country or a place: Blažević · Peeters · Croatia" />
    </div>
  </details>
</Base>

<style is:global>
  .yn-find { margin: 0 0 22px; }
  .yn-why, .yn-go { margin: 0 0 8px; }
  .yn-why .k-card { gap: 8px; } .yn-why .k-ico { margin-bottom: 2px; }
  .yn-go a.k-card { height: 100%; } .yn-go li { display: flex; } .yn-go li > a { flex: 1; }
  .yn-more { margin: 30px 0 0; background: var(--panel); border: 1px solid var(--rule); border-radius: 20px; padding: 6px 22px; }
  .yn-more > summary { cursor: pointer; padding: 14px 0; font: 600 16px/1.3 var(--sans); display: flex; align-items: center; gap: 12px; flex-wrap: wrap; list-style: none; }
  .yn-more > summary::-webkit-details-marker { display: none; }
  .yn-more[open] > summary { border-bottom: 1px solid var(--rule); margin-bottom: 18px; }
  .ynsw { display: inline-flex; border: 1px solid var(--rule); border-radius: 999px; overflow: hidden; margin: 0 0 18px; background: var(--ground); }
  .ynsw button { font: inherit; font-family: var(--sans); font-size: 14px; font-weight: 600; padding: 9px 24px; border: 0; background: none; color: var(--ink-2); cursor: pointer; }
  .ynsw button + button { border-left: 1px solid var(--rule); }
  .ynsw button[aria-selected="true"] { background: var(--hue); color: var(--ground, #fff); }
  .yn-h { margin: 28px 0 8px; font-size: 22px; font-weight: 800; }
  #yn-sur label.vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ynsw button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
</style>

<script>
  /* One page, two catalogues. Without script both panels simply stack. The choice lives in the address (?kind=surname, or an ?s= or
     ?n= that was shared), so a link opens on the right half. */
  const given = document.getElementById("yn-given"), sur = document.getElementById("yn-sur");
  const tg = document.getElementById("yn-tab-given"), ts = document.getElementById("yn-tab-sur");
  if (given && sur && tg && ts) {
    const set = (kind: "given" | "surname", focus = false) => {
      const isSur = kind === "surname";
      given.hidden = isSur; sur.hidden = !isSur;
      tg.setAttribute("aria-selected", String(!isSur)); ts.setAttribute("aria-selected", String(isSur));
      try {
        const x = new URL(location.href);
        if (isSur) x.searchParams.set("kind", "surname"); else x.searchParams.delete("kind");
        x.searchParams.delete("n"); x.searchParams.delete("s");
        history.replaceState(null, "", x.toString());
      } catch (e) {}
      if (focus) (document.getElementById(isSur ? "ssn-q" : "syn-q") as HTMLInputElement | null)?.focus();
    };
    tg.addEventListener("click", () => set("given", true));
    ts.addEventListener("click", () => set("surname", true));
    const sp = new URLSearchParams(location.search);
    const wantSur = sp.get("kind") === "surname" || (sp.has("s") && !sp.has("n"));
    given.hidden = wantSur; sur.hidden = !wantSur;
    // A link that was made for one of the single-name boxes opens on it, not on the whole-name box above.
    if (sp.has("n") || sp.has("s") || sp.has("kind")) { const d = document.getElementById("yn-one") as HTMLDetailsElement | null; if (d) { d.open = true; d.scrollIntoView(); } }
    tg.setAttribute("aria-selected", String(!wantSur)); ts.setAttribute("aria-selected", String(wantSur));
  }
</script>
